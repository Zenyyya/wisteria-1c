
#Область ОбменСБанками

// Получает данные выписки банка в текстовом формате
//
// Параметры:
//  СообщениеОбмена - ДокументСсылка.СообщенияОбменСБанками - сообщение обмена с выпиской банка
//  СсылкаНаХранилище - Строка - адрес временного хранилища, куда будет помещена текстовая выписка банка
//  МассивСчетов - Массив - массив банковских счетов, находящихся в выписке
//  Организация - ОпределяемыйТип.Организация - организация, для которой получена выписка
//  НастройкаОбмена - СправочникСсылка.НастройкиОбменСБанками - действующая настройка обмена с банком.
//
Процедура ПолучитьДанныеВыпискиБанкаТекстовыйФормат(Знач СообщениеОбмена, СсылкаНаХранилище, МассивСчетов = Неопределено, Организация = Неопределено, НастройкаОбмена = Неопределено) Экспорт
	
	Перем ТекстВыписки;
	
	РеквизитыСообщения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СообщениеОбмена, "Организация, НастройкаОбмена, ВидЭД");
	
	Если НЕ РеквизитыСообщения.ВидЭД = Перечисления.ВидыЭДОбменСБанками.ВыпискаБанка Тогда
		Возврат
	КонецЕсли;
	
	Организация = РеквизитыСообщения.Организация;
	НастройкаОбмена = РеквизитыСообщения.НастройкаОбмена;
	
	ОбменСБанками.ПолучитьДанныеВыпискиБанкаТекстовыйФормат(СообщениеОбмена, СсылкаНаХранилище, МассивСчетов);
	
КонецПроцедуры

#КонецОбласти

#Область ЭПД

Функция ДанныеЗаполненияЭТрН(Основание) Экспорт
	ДанныеЗаполнения = Новый Структура;
	
	Если НЕ ЗначениеЗаполнено(Основание) 
		ИЛИ (ТипЗнч(Основание) <> Тип("ДокументСсылка.РасходнаяНакладная")
			И ТипЗнч(Основание) <> Тип("ДокументСсылка.ЗаказПокупателя")) Тогда
		
		Возврат ДанныеЗаполнения;
	КонецЕсли; 
	
	СписокРеквизитов = "Организация, Контрагент, Грузоотправитель, Грузополучатель, 
		|Перевозчик, Дата, Номер, АдресДоставки, АдресДоставкиЗначение, 
		|Организация, ЭтоУниверсальныйДокумент";
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		СписокРеквизитов = СписокРеквизитов + ", СтруктурнаяЕдиницаРезерв";
	Иначе
		СписокРеквизитов = СписокРеквизитов + ", СтруктурнаяЕдиница";
	КонецЕсли;
	
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Основание, СписокРеквизитов);
		
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		СтруктурнаяЕдиница = РеквизитыОснования.СтруктурнаяЕдиницаРезерв;
	Иначе
		СтруктурнаяЕдиница = РеквизитыОснования.СтруктурнаяЕдиница;
	КонецЕсли;
		
	АдресПогрузки = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		РеквизитыОснования.Организация,
		Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации,
		РеквизитыОснования.Дата, Ложь);
		
	ДанныеЗаполнения.Вставить("ДокументыОснования", Новый Массив);
	ДанныеЗаполнения.ДокументыОснования.Добавить(Новый Структура("ДокументОснование", Основание));
		
	ДанныеЗаполнения.Вставить("Организация", РеквизитыОснования.Организация);
	
	
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяЗаказДата", РеквизитыОснования.Дата);
	
	ДанныеЗаполнения.Вставить("СсылкаТитулГрузоотправителяГрузоотправитель", ?(ЗначениеЗаполнено(РеквизитыОснования.Грузоотправитель), 
		РеквизитыОснования.Грузоотправитель, РеквизитыОснования.Организация));
	
	ДанныеЗаполнения.Вставить("СсылкаТитулГрузоотправителяГрузополучатель", ?(ЗначениеЗаполнено(РеквизитыОснования.Грузополучатель), 
		РеквизитыОснования.Грузополучатель, РеквизитыОснования.Контрагент));
		
	ДанныеЗаполнения.Вставить("СсылкаТитулГрузоотправителяПеревозчик", РеквизитыОснования.Перевозчик);
	
	ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыУчастника(
		ДанныеЗаполнения.СсылкаТитулГрузоотправителяГрузоотправитель, "ТитулГрузоотправителяГрузоотправитель", ДанныеЗаполнения, Неопределено);
		
	ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыУчастника(
		ДанныеЗаполнения.СсылкаТитулГрузоотправителяГрузополучатель, "ТитулГрузоотправителяГрузополучатель", ДанныеЗаполнения, Неопределено);
		
	ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыУчастника(
		ДанныеЗаполнения.СсылкаТитулГрузоотправителяПеревозчик, "ТитулГрузоотправителяПеревозчик", ДанныеЗаполнения, Неопределено);
	
	ЗаполнитьАдрес(ДанныеЗаполнения, "ТитулГрузоотправителяГрузополучательАдресДоставки", РеквизитыОснования.АдресДоставкиЗначение, РеквизитыОснования.АдресДоставки);
		
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяГрузы", ДанныеОГрузе(Основание));
	
	ЗаполнитьАдрес(ДанныеЗаполнения, "ТитулГрузоотправителяАдресПогрузки", АдресПогрузки[0].Значение);
	
	ЗаполнитьСтоимостьГрузаИВалюту(ДанныеЗаполнения, Основание);
	
	ТекущаяДата = ТекущаяДатаСеанса();
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяЗаявленныеДатаВремяПодачи", ОбменСГИСЭПДКлиентСервер.ОкруглениеДатыПриИзменении(ТекущаяДата));
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяЗаявленныеДатаВремяПодачиИспользуетсяUTC", Истина);
	
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяФактическиеДатаВремяПодачи", ОбменСГИСЭПДКлиентСервер.ОкруглениеДатыПриИзменении(ТекущаяДата));
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяФактическиеДатаВремяПодачиИспользуетсяUTC", Истина);  
	
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяФактическиеДатаВремяУбытия", ОбменСГИСЭПДКлиентСервер.ОкруглениеДатыПриИзменении(ТекущаяДата));
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяФактическиеДатаВремяУбытияИспользуетсяUTC", Истина); 
	
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяЛицоОсуществляющееПогрузкуЯвляетсяГрузоотправителем", "1");
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяВладелецПунктаПогрузкиЯвляетсяГрузоотправителем", "1");
	
	МассаБруттоГруза = 0;
	Для каждого Груз Из ДанныеЗаполнения.ТитулГрузоотправителяГрузы Цикл
		МассаБруттоГруза = МассаБруттоГруза + Груз.МассаБрутто;
	КонецЦикла;
	
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяМассаБруттоГруза", МассаБруттоГруза);
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяКоличествоГрузовыхМест", 1);
		
	Возврат ДанныеЗаполнения;

КонецФункции

Функция ДанныеЗаполненияЭЗЗ(Основание) Экспорт
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.СчетНаОплату") Тогда
		Возврат ДанныеЗаполненияЭЗЗПоДаннымСчета(Основание);
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Возврат ДанныеЗаполненияЭЗЗПоДаннымЗаказа(Основание);
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		Возврат ДанныеЗаполненияЭЗЗПоДаннымРеализации(Основание);
	КонецЕсли;
КонецФункции

Функция ДанныеЗаполненияЭПЭ(Основание) Экспорт
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.СчетНаОплату") Тогда
		Возврат ДанныеЗаполненияЭПЭПоДаннымСчета(Основание);
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Возврат ДанныеЗаполненияЭПЭПоДаннымРеализации(Основание);
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		Возврат ДанныеЗаполненияЭПЭПоДаннымРеализации(Основание);
	КонецЕсли;
КонецФункции

Функция ДанныеЗаполненияЭЗЗПоДаннымСчета(Основание) 
	
	ДанныеЗаполнения = Новый Структура;
	
	СписокРеквизитов = "Организация, Контрагент, Дата, Номер, Организация"; 
	
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Основание, СписокРеквизитов);
		
	АдресПогрузки = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		РеквизитыОснования.Организация,
		Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации,
		РеквизитыОснования.Дата, Ложь);
		
	ДанныеЗаполнения.Вставить("ДокументыОснования", Новый Массив);
	ДанныеЗаполнения.ДокументыОснования.Добавить(Новый Структура("ДокументОснование", Основание));
		
	ДанныеЗаполнения.Вставить("Организация", РеквизитыОснования.Организация);
	
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяЗаказДата", РеквизитыОснования.Дата);
	
	ДанныеЗаполнения.Вставить("СсылкаТитулГрузоотправителяГрузоотправитель", РеквизитыОснования.Организация);
	
	ДанныеЗаполнения.Вставить("СсылкаТитулГрузоотправителяГрузополучатель", РеквизитыОснования.Контрагент);
		
	ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыУчастника(
		ДанныеЗаполнения.СсылкаТитулГрузоотправителяГрузоотправитель, "ТитулГрузоотправителяГрузоотправитель", ДанныеЗаполнения, Неопределено);
		
	ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыУчастника(
		ДанныеЗаполнения.СсылкаТитулГрузоотправителяГрузополучатель, "ТитулГрузоотправителяГрузополучатель", ДанныеЗаполнения, Неопределено);
		
	Если АдресПогрузки.Количество() > 0 Тогда
		
		ВладелецПунктаПогрузки = ПечатьДокументовУНФ.СведенияОЮрФизЛице(РеквизитыОснования.Организация, РеквизитыОснования.Дата);
		ЗаполнитьДанныеПунктовПогрузкиВыгрузки(ДанныеЗаполнения, АдресПогрузки[0].Значение, ВладелецПунктаПогрузки, Неопределено);
		
		ЗаполнитьАдрес(ДанныеЗаполнения, "ТитулГрузоотправителяАдресПогрузки", АдресПогрузки[0].Значение);
	
	КонецЕсли;
		
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяГрузы", ДанныеОГрузе(Основание));
	
	ЗаполнитьСтоимостьГрузаИВалюту(ДанныеЗаполнения, Основание);
		
	Возврат ДанныеЗаполнения;
	
КонецФункции

Функция ДанныеЗаполненияЭЗЗПоДаннымЗаказа(Основание) 
	
	ДанныеЗаполнения = Новый Структура;
	
	СписокРеквизитов = "Организация, Контрагент, Грузоотправитель, Грузополучатель, 
		|Перевозчик, Дата, Номер, АдресДоставки, АдресДоставкиЗначение, 
		|Организация, ЭтоУниверсальныйДокумент, Автомобиль, Водитель, ВидОперации";
	
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Основание, СписокРеквизитов);
		
	АдресПогрузки = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		РеквизитыОснования.Организация,
		Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации,
		РеквизитыОснования.Дата, Ложь);
		
	ДанныеЗаполнения.Вставить("ДокументыОснования", Новый Массив);
	ДанныеЗаполнения.ДокументыОснования.Добавить(Новый Структура("ДокументОснование", Основание));
		
	ДанныеЗаполнения.Вставить("Организация", РеквизитыОснования.Организация);
	
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяЗаказДата", РеквизитыОснования.Дата);
	
	ДанныеЗаполнения.Вставить("СсылкаТитулГрузоотправителяГрузоотправитель", ?(ЗначениеЗаполнено(РеквизитыОснования.Грузоотправитель), 
		РеквизитыОснования.Грузоотправитель, РеквизитыОснования.Организация));
	
	ДанныеЗаполнения.Вставить("СсылкаТитулГрузоотправителяГрузополучатель", ?(ЗначениеЗаполнено(РеквизитыОснования.Грузополучатель), 
		РеквизитыОснования.Грузополучатель, РеквизитыОснования.Контрагент));
		
	ДанныеЗаполнения.Вставить("СсылкаТитулГрузоотправителяПеревозчик", РеквизитыОснования.Перевозчик);
	
	ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыУчастника(
		ДанныеЗаполнения.СсылкаТитулГрузоотправителяГрузоотправитель, "ТитулГрузоотправителяГрузоотправитель", ДанныеЗаполнения, Неопределено);
		
	ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыУчастника(
		ДанныеЗаполнения.СсылкаТитулГрузоотправителяГрузополучатель, "ТитулГрузоотправителяГрузополучатель", ДанныеЗаполнения, Неопределено);
		
	ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыУчастника(
		ДанныеЗаполнения.СсылкаТитулГрузоотправителяПеревозчик, "ТитулГрузоотправителяПеревозчик", ДанныеЗаполнения, Неопределено);
	
	ЗаполнитьАдрес(ДанныеЗаполнения, "ТитулГрузоотправителяГрузополучательАдресДоставки", РеквизитыОснования.АдресДоставкиЗначение, РеквизитыОснования.АдресДоставки);
		
	Если АдресПогрузки.Количество() > 0 Тогда
		
		СсылкаГрузоотправителя = ?(ЗначениеЗаполнено(РеквизитыОснования.Грузоотправитель), 
			РеквизитыОснования.Грузоотправитель, РеквизитыОснования.Организация);
		
		ВладелецПунктаПогрузки = ПечатьДокументовУНФ.СведенияОЮрФизЛице(СсылкаГрузоотправителя, РеквизитыОснования.Дата);
		ЗаполнитьДанныеПунктовПогрузкиВыгрузки(ДанныеЗаполнения, АдресПогрузки[0].Значение, ВладелецПунктаПогрузки, РеквизитыОснования.АдресДоставкиЗначение);
		
		ЗаполнитьАдрес(ДанныеЗаполнения, "ТитулГрузоотправителяАдресПогрузки", АдресПогрузки[0].Значение);
	
	КонецЕсли;
		
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяГрузы", ДанныеОГрузе(Основание));
	
	ЗаполнитьСтоимостьГрузаИВалюту(ДанныеЗаполнения, Основание);
	
	Если РеквизитыОснования.ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд Тогда
		
		ПараметрыТранспортногоСредства = ХранимыеДанныеЭПД_ТС(РеквизитыОснования.Автомобиль, "ТитулПеревозчикаТранспортноеСредство");
		Если ЗначениеЗаполнено(ПараметрыТранспортногоСредства) Тогда
			ДанныеЗаполнения.Вставить("ХранимыеДанныеТитулГрузоотправителяПараметрыТранспортногоСредства", ПараметрыТранспортногоСредства);
			
			ГруппаДанных = "ТитулГрузоотправителяПараметрыТранспортногоСредства";
			ДанныеПоПараметрамТранспортногоСредства = ОбменСГИСЭПД.ПолучитьОписаниеХранимыхДанныхЭПДПоСсылке(ПараметрыТранспортногоСредства, ГруппаДанных);
			
			Для Каждого ПараметрТранспортногоСредства Из ДанныеПоПараметрамТранспортногоСредства.ДанныеЗаполненияРеквизитовФормы Цикл
				ДанныеЗаполнения.Вставить(ГруппаДанных + ПараметрТранспортногоСредства.Ключ, ПараметрТранспортногоСредства.Значение);
			КонецЦикла; 
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат ДанныеЗаполнения;
	
КонецФункции

Функция ДанныеЗаполненияЭЗЗПоДаннымРеализации(Основание) 
	
	ДанныеЗаполнения = Новый Структура;
	
	СписокРеквизитов = "Организация, Контрагент, Грузоотправитель, Грузополучатель, 
		|Перевозчик, Дата, Номер, АдресДоставки, АдресДоставкиЗначение, 
		|Организация, ЭтоУниверсальныйДокумент, СтруктурнаяЕдиница, Автомобиль, Водитель";
	
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Основание, СписокРеквизитов);
		
	АдресПогрузки = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		РеквизитыОснования.Организация,
		Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации,
		РеквизитыОснования.Дата, Ложь);
		
	ДанныеЗаполнения.Вставить("ДокументыОснования", Новый Массив);
	ДанныеЗаполнения.ДокументыОснования.Добавить(Новый Структура("ДокументОснование", Основание));
		
	ДанныеЗаполнения.Вставить("Организация", РеквизитыОснования.Организация);
	
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяЗаказДата", РеквизитыОснования.Дата);
	
	ДанныеЗаполнения.Вставить("СсылкаТитулГрузоотправителяГрузоотправитель", ?(ЗначениеЗаполнено(РеквизитыОснования.Грузоотправитель), 
		РеквизитыОснования.Грузоотправитель, РеквизитыОснования.Организация));
	
	ДанныеЗаполнения.Вставить("СсылкаТитулГрузоотправителяГрузополучатель", ?(ЗначениеЗаполнено(РеквизитыОснования.Грузополучатель), 
		РеквизитыОснования.Грузополучатель, РеквизитыОснования.Контрагент));
		
	ДанныеЗаполнения.Вставить("СсылкаТитулГрузоотправителяПеревозчик", РеквизитыОснования.Перевозчик);
	
	ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыУчастника(
		ДанныеЗаполнения.СсылкаТитулГрузоотправителяГрузоотправитель, "ТитулГрузоотправителяГрузоотправитель", ДанныеЗаполнения, Неопределено);
		
	ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыУчастника(
		ДанныеЗаполнения.СсылкаТитулГрузоотправителяГрузополучатель, "ТитулГрузоотправителяГрузополучатель", ДанныеЗаполнения, Неопределено);
		
	ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыУчастника(
		ДанныеЗаполнения.СсылкаТитулГрузоотправителяПеревозчик, "ТитулГрузоотправителяПеревозчик", ДанныеЗаполнения, Неопределено);
	
	ЗаполнитьАдрес(ДанныеЗаполнения, "ТитулГрузоотправителяГрузополучательАдресДоставки", РеквизитыОснования.АдресДоставкиЗначение, РеквизитыОснования.АдресДоставки);
		
	Если АдресПогрузки.Количество() > 0 Тогда
		
		СсылкаГрузоотправителя = ?(ЗначениеЗаполнено(РеквизитыОснования.Грузоотправитель), 
			РеквизитыОснования.Грузоотправитель, РеквизитыОснования.Организация);
		
		ВладелецПунктаПогрузки = ПечатьДокументовУНФ.СведенияОЮрФизЛице(СсылкаГрузоотправителя, РеквизитыОснования.Дата);
		ЗаполнитьДанныеПунктовПогрузкиВыгрузки(ДанныеЗаполнения, АдресПогрузки[0].Значение, ВладелецПунктаПогрузки, РеквизитыОснования.АдресДоставкиЗначение);
		
		ЗаполнитьАдрес(ДанныеЗаполнения, "ТитулГрузоотправителяАдресПогрузки", АдресПогрузки[0].Значение);
	
	КонецЕсли;
		
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяГрузы", ДанныеОГрузе(Основание));
	
	ЗаполнитьСтоимостьГрузаИВалюту(ДанныеЗаполнения, Основание);
	
	ПараметрыТранспортногоСредства = ХранимыеДанныеЭПД_ТС(РеквизитыОснования.Автомобиль, "ТитулПеревозчикаТранспортноеСредство");
	Если ЗначениеЗаполнено(ПараметрыТранспортногоСредства) Тогда
		ДанныеЗаполнения.Вставить("ХранимыеДанныеТитулГрузоотправителяПараметрыТранспортногоСредства", ПараметрыТранспортногоСредства);
		
		ГруппаДанных = "ТитулГрузоотправителяПараметрыТранспортногоСредства";
		ДанныеПоПараметрамТранспортногоСредства = ОбменСГИСЭПД.ПолучитьОписаниеХранимыхДанныхЭПДПоСсылке(ПараметрыТранспортногоСредства, ГруппаДанных);
		
		Для Каждого ПараметрТранспортногоСредства Из ДанныеПоПараметрамТранспортногоСредства.ДанныеЗаполненияРеквизитовФормы Цикл
			ДанныеЗаполнения.Вставить(ГруппаДанных + ПараметрТранспортногоСредства.Ключ, ПараметрТранспортногоСредства.Значение);
		КонецЦикла; 
	КонецЕсли;
		
	Возврат ДанныеЗаполнения;
	
КонецФункции

