#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоТакси = Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	ВыбранныйИнтерфейс = ЭтоТакси;
	
	ТекущийПользователь = Пользователи.АвторизованныйПользователь();
	ТекущийПользовательИБ = Пользователи.НайтиПоСсылке(ТекущийПользователь);
	Если ТекущийПользовательИБ <> Неопределено Тогда
		ИмяПользователя = ТекущийПользовательИБ.Имя;
	КонецЕсли;
	
	ВидимостьВыбораИнтерфейса = ПоказатьВыборИнтерфейса();
	Если Не ВидимостьВыбораИнтерфейса Тогда
		Элементы.ФормаЗаписатьИЗакрыть.Заголовок = НСтр("ru = 'Готово'");
		Элементы.ФормаЗаписатьИЗакрыть.Отображение = ОтображениеКнопки.Текст;
	КонецЕсли;
	
	Если ЭтоТакси Тогда
		ВысотаКартинки = 16;
	Иначе
		ВысотаКартинки = 12;
	КонецЕсли;
	Элементы.КартинкаИнтерфейса.Высота = ВысотаКартинки;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОпытДругиеСистемыУчетаПриИзменении(Элемент)
	
	ВидимостьПеречисленияПриложений = ОпытДругиеСистемыУчета = ПредопределенноеЗначение(
		"Перечисление.ОпытПользователяСДругимиСистемамиУчета.Есть");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОпытПеречислениеСистемУчета", "Видимость",
		ВидимостьПеречисленияПриложений);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныйИнтерфейсПриИзменении(Элемент)
	
	УстановитьКартинкуИнтерфейса();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	СтраницаОпрос = Элементы.СтраницаОпрос;
	
	Если Не ВидимостьВыбораИнтерфейса Тогда
		ЗавершитьРаботуОбработки();
	Иначе
		Если Элементы.Страницы.ТекущаяСтраница = СтраницаОпрос Тогда
			ПерейтиНаСтраницуВыборИнтерфейса();
		Иначе
			ЗавершитьРаботуОбработки();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗавершитьРаботуОбработки()
	
	ОбратнаяСвязьОбработатьОпытПользователя(ИмяПользователя);
	Если ВыбранныйИнтерфейс <> ЭтоТакси Тогда
		ЗавершитьРаботуСистемы(Ложь, Истина);
	Иначе
		ОбновитьИнтерфейс();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаСтраницуВыборИнтерфейса()
	
	СтраницаВыборИнтерфейса = Элементы.СтраницаВыборИнтерфейса;
	
	Ошибки = Неопределено;
	Если Не ЗначениеЗаполнено(ОпытПриложения1С) Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
			Ошибки, "ОпытПриложения1С", НСтр("ru ='Укажите опыт работы с приложениями 1С'"), "");
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
		Возврат;
	КонецЕсли;
	Элементы.ФормаЗаписатьИЗакрыть.Заголовок = НСтр("ru = 'Готово'");
	Элементы.ФормаЗаписатьИЗакрыть.Отображение = ОтображениеКнопки.Текст;
	Элементы.Пояснение.МаксимальнаяШирина = 80;
	
	ВыбранныйИнтерфейс = 0;
	УстановитьКартинкуИнтерфейса();
	Элементы.КартинкаИнтерфейса.Видимость = Истина;
	Элементы.Страницы.ТекущаяСтраница = СтраницаВыборИнтерфейса;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьКартинкуИнтерфейса()
	
	Если ВыбранныйИнтерфейс = 0 Тогда
		КартинкаИнтерфейса = БиблиотекаКартинок.Интерфейс85;
	Иначе
		КартинкаИнтерфейса = БиблиотекаКартинок.ИнтерфейсТакси;
	КонецЕсли;
	
	Элементы.КартинкаИнтерфейса.Картинка = КартинкаИнтерфейса;
	ПояснениеПриИзмененииИнтерфейса = НСтр("ru = 'После нажатия кнопки ""Готово"" приложение будет перезапущено для включения выбранного интерфейса. Сменить интерфейс при работе в приложении можно в меню Настройки - Вариант интерфейса.'");
	ПояснениеБезИзмененияИнтерфейса = НСтр("ru = 'Сменить интерфейс при работе в приложении можно в меню Настройки - Вариант интерфейса'");
	Если ВыбранныйИнтерфейс <> ЭтоТакси Тогда
		Элементы.Пояснение.Заголовок = ПояснениеПриИзмененииИнтерфейса;
	Иначе
		Элементы.Пояснение.Заголовок = ПояснениеБезИзмененияИнтерфейса;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбратнаяСвязьОбработатьОпытПользователя(ИмяПользователя)
	
	ОбратнаяСвязьСохранитьОпытРаботы(ИмяПользователя, Ложь);
	
	Если ВидимостьВыбораИнтерфейса Тогда
		НастройкиКлиентскогоПриложения = ОбщегоНазначения.ХранилищеСистемныхНастроекЗагрузить(
		"Общее/НастройкиКлиентскогоПриложения", "");

		Если ВыбранныйИнтерфейс = 0 Тогда
			НастройкиКлиентскогоПриложения.ВариантОткрытияОконКлиентскогоПриложения = ВариантОткрытияОконКлиентскогоПриложения.ОткрыватьДанныеВоВкладках;
			ВариантИнтерфейса = "Версия8_5";
		Иначе
			ВариантИнтерфейса = "Такси";
		КонецЕсли;

		НастройкиКлиентскогоПриложения.ВариантИнтерфейсаКлиентскогоПриложения = ВариантИнтерфейсаКлиентскогоПриложения[ВариантИнтерфейса];

		ОбщегоНазначения.ХранилищеСистемныхНастроекСохранить("Общее/НастройкиКлиентскогоПриложения", "",
			НастройкиКлиентскогоПриложения);
	КонецЕсли;
	
	НачалоРаботыСПрограммойСервер.УстановитьСтандартныйИнтерфейс();
	
КонецПроцедуры

&НаСервере
Процедура ОбратнаяСвязьСохранитьОпытРаботы(ИмяПользователя, РазрешеноВключениеИнтерфейса85)
	
	ДатаНачалаРаботы = ТекущаяДатаСеанса();
	
	ОпытРаботы = ОбратнаяСвязьКлиентСервер.НастройкиОпросаПользователейБезОпыта();
	ОпытРаботы.ОпытПриложения1С = Строка(ОпытПриложения1С);
	ОпытРаботы.ОпытДругиеСистемыУчета = Строка(ОпытДругиеСистемыУчета);
	ОпытРаботы.ОпытПеречислениеСистемУчета = ОпытПеречислениеСистемУчета;
	ОпытРаботы.РазрешеноВключениеИнтерфейса85 = РазрешеноВключениеИнтерфейса85;
	ОпытРаботы.ДатаНачалаРаботы = ДатаНачалаРаботы;
	ОпытРаботы.ИнтерфейсТаксиПередНачаломРаботы = ЭтоТакси;

	ЭтоПользовательБезОпыта = ОпытПриложения1С = Перечисления.ОпытПользователяС1С.НетОпытаМенееДвухНедель;
	ОпытРаботы.ЭтоПользовательБезОпыта = ЭтоПользовательБезОпыта;
	
	ОбратнаяСвязь.СохранитьНастройкуОпросаНачалоРаботы(ОпытРаботы, ИмяПользователя, "UXBeginnersStart");
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("Общее/НастройкиНовогоПользователяНачалоРаботы",
		"ПоказатьОпросНачалоРаботы", Ложь);
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("Общее/НастройкиНовогоПользователяНачалоРаботы",
		"ПоказатьВыборИнтерфейса", Ложь);
	
КонецПроцедуры

&НаСервере
Функция ПоказатьВыборИнтерфейса()
	
	Результат = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("Общее/НастройкиНовогоПользователяНачалоРаботы",
			"ПоказатьВыборИнтерфейса", Ложь, , ИмяПользователя);
	Возврат Результат;
	
КонецФункции

#КонецОбласти