#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура maxma_ПриСозданииНаСервере()
	
	maxma_ИнтеграцияССервисомВызовСервера.ПриСозданииНаСервере(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
&После("СоздатьНовыйНабор")
Процедура maxma_СоздатьНовыйНабор(ПараметрыЗавершения)
	
	Объект.maxma_СтруктураПолей = Неопределено;
	
	maxma_ИнтеграцияССервисомВызовСервера.ИнициализироватьПоля(Объект.maxma_СтруктураПолей, Объект.ТорговыйОбъект);
	
	maxma_ИнтеграцияССервисомКлиентСервер.ОбновитьФорму(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура maxma_ИнициализироватьЧек()
	
	Объект.maxma_СтруктураПолей = Неопределено;
	
	Объект.ДисконтнаяКарта = "";
	
	maxma_ИнтеграцияССервисомВызовСервера.ИнициализироватьПоля(Объект.maxma_СтруктураПолей, Объект.ТорговыйОбъект, ЧекККМПродажа);
	
	maxma_ИнтеграцияССервисомКлиентСервер.ОбновитьФорму(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
&После("ПробитьЧекНаКлиентеЗавершение")
Процедура maxma_ПробитьЧекНаКлиентеЗавершение(РезультатВыполнения, Параметры)
	
	maxma_ИнициализироватьЧек();
	
КонецПроцедуры

&НаКлиенте
&После("ВыборЧекаЗавершение")
Процедура maxma_ВыборЧекаЗавершение(Результат, ДополнительныеПараметры)
	
	maxma_ИнициализироватьЧек();
	
КонецПроцедуры

&НаКлиенте
&После("УдалитьЧекКлиент")
Процедура maxma_УдалитьЧекКлиент(ОтменитьРежимПлитки = Ложь)
	
	maxma_ИнициализироватьЧек();
	
КонецПроцедуры

&НаКлиенте
&После("ОтложитьЧекКлиент")
Процедура maxma_ОтложитьЧекКлиент()
	
	maxma_ИнициализироватьЧек();
	
КонецПроцедуры

