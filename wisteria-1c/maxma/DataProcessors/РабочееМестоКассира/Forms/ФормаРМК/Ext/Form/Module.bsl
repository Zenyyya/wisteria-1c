
#Область СлужебныеПрограммныйИнтерфейс

&НаКлиенте
Процедура maxma_НазначитьАвтоматическиеСкидкиКлиент() Экспорт
	
	Если Не maxma_ИнтеграцияССервисомКлиентСервер.ИспользоватьПрограммуЛояльности(Объект.maxma_СтруктураПолей) Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьСкидкиКлиент();
	
	maxma_ИнтеграцияССервисомКлиент.ВывестиСообщения(Объект.maxma_СтруктураПолей.СообщенияПользователю);
	
	maxma_ИнтеграцияССервисомКлиент.ОбработатьКодыОшибок(ЭтаФорма);
	
	maxma_ИнтеграцияССервисомКлиентСервер.ОбновитьФорму(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
&После("ПриСозданииНаСервере")
Процедура maxma_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	maxma_ПриСозданииНаСервере();
	
КонецПроцедуры

&НаКлиенте
&После("ОбработкаОповещения")
Процедура maxma_ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	maxma_ИнтеграцияССервисомКлиент.ОбработкаОповещения(ЭтаФорма, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

#КонецОбласти

