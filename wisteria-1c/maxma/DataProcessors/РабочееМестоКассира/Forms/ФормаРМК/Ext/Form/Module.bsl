&После("ЦенаИзКарточкиПриИзмененииПродолжение")
Процедура maxma_ЦенаИзКарточкиПриИзмененииПродолжение(ОбнулитьПодарочныеСертификаты = Истина)
	
	maxma_НазначитьАвтоматическиеСкидкиКлиент();
	
КонецПроцедуры

&НаКлиенте
&После("ПересчитатьДанныеПриИзмененииКоличества")
Процедура maxma_ПересчитатьДанныеПриИзмененииКоличества(УвеличитьКоличество)
	
	maxma_НазначитьАвтоматическиеСкидкиКлиент();
	
КонецПроцедуры

&НаКлиенте
&После("ПересчитатьДанныеПриИзмененииКоличестваЗавершение")
Процедура maxma_ПересчитатьДанныеПриИзмененииКоличестваЗавершение(Результат, ДополнительныеПараметры)
	
	maxma_НазначитьАвтоматическиеСкидкиКлиент();
	
КонецПроцедуры

&НаКлиенте
&После("ОбработатьИзменениеКоличестваТовара")
Процедура maxma_ОбработатьИзменениеКоличестваТовара(ТекущаяСтрокаРедактирования)
	
	maxma_НазначитьАвтоматическиеСкидкиКлиент();
	
КонецПроцедуры

&НаКлиенте
&Перед("ОткрытьКаталогЗавершение")
Процедура maxma_ОткрытьКаталогЗавершение(Результат, ДополнительныеПараметры)
	
	Если Не maxma_ИнтеграцияССервисомКлиентСервер.ИспользоватьПрограммуЛояльности(Объект.maxma_СтруктураПолей) Тогда
		maxma_ИнициализироватьЧек();
	Иначе
		maxma_ИнтеграцияССервисомКлиентСервер.ОбновитьФорму(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
&После("ФискализироватьЧек")
Процедура maxma_ФискализироватьЧек(Контекст, ДополнительныеДанные, ОповещениеПриЗавершении, СистемаНалогообложения)
	
	Если Не ДополнительныеДанные.Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДополнительныеДанные.РеквизитыФормы.Объект, "maxma_СтруктураПолей") Тогда
		maxma_ИнтеграцияССервисомКлиент.ВывестиСообщения(ДополнительныеДанные.РеквизитыФормы.Объект.maxma_СтруктураПолей.СообщенияПользователю);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
