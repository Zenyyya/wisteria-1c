#КонецОбласти

#Область ОбработчикиСобытийПодключаемогоОборудования

&НаКлиенте
Процедура ПодключитьОборудованиеЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если Не РезультатВыполнения.Результат Тогда
		
		ПараметрыИнформации = maxma_ИнтеграцияССервисомВызовСервера.ПолучитьСтруктуруВыводимойВРМКИнформации();
		ПараметрыИнформации.ЗаголовокИнформации = НСтр("ru = 'При подключении оборудования произошла ошибка:'");
		ПараметрыИнформации.ТекстИнформации     = РезультатВыполнения.ОписаниеОшибки;
		
		maxma_ИнтеграцияССервисомКлиент.ОткрытьФормуИнформации(ПараметрыИнформации);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПоискШтрихкода(Штрихкод)
	
	Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат;
	КонецЕсли;

	ВводимоеЧисло = Штрихкод;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПоискМагнитнойКарты(МагнитныйКод)
	
	Если НЕ ЗначениеЗаполнено(МагнитныйКод) Тогда
		Возврат;
	КонецЕсли;

	ВводимоеЧисло = МагнитныйКод;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ОбновитьИнформациюОКлиенте(ДополнительныеПараметры)
		
	Если НЕ ДополнительныеПараметры.СетеваяОшибка Тогда
		
		Если ОбновитьИнформациюОКлиентеНаСервере(ДополнительныеПараметры) Тогда
			
			ДополнительныеПараметры.Вставить("РежимПоиска", РежимПоискаКартыСтрока);
			
			Если РежимПоискаКартыСтрока = "НомерТелефона" Тогда
				ДополнительныеПараметры.Вставить("НомерКартыТелефон", МобильныйТелефон);
			ИначеЕсли РежимПоискаКартыСтрока = "КодКарты" Тогда
				ДополнительныеПараметры.Вставить("НомерКартыТелефон", ВводимоеЧисло);
			КонецЕсли;
								
			ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуИнформацииРедактированиеКартыЛояльности", ЭтотОбъект, ДополнительныеПараметры);
			
			maxma_ИнтеграцияССервисомКлиент.ОткрытьФормуИнформации(ДополнительныеПараметры, ОбработчикОповещения);
			
		Иначе
			
			Если ДополнительныеПараметры.СетеваяОшибка = Ложь Тогда
				maxma_ИнтеграцияССервисомКлиент.ОткрытьФормуИнформации(ДополнительныеПараметры);	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура ОповещениеОткрытьФормуИнформацииРедактированиеКартыЛояльности(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт

	Оповестить("ОтредактированаКартаЛояльности", ДополнительныеПараметры, ЭтотОбъект);
	
	Закрыть(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Функция КартаЛояльностиСуществует(ДополнительныеПараметры)
	
	ШаблонСообщения = Нстр("ru = '%1 %2.'");
	
	Результат = Ложь;
	
	Если ПолучитьБалансНаСервереРедактированиеКарты(РежимПоискаКартыСтрока, НомерКартыТелефон, ДополнительныеПараметры) Тогда
		
		Если РежимПоискаКартыСтрока = "НомерТелефона" Тогда
			ЧастьШаблона = НСтр("ru = 'номеру телефона'");
		ИначеЕсли РежимПоискаКартыСтрока = "КодКарты" Тогда
			ЧастьШаблона = НСтр("ru = 'номеру карты'");
		КонецЕсли;

		ДополнительныеПараметры.Вставить("ЗаголовокИнформации", НСтр("ru = 'Редактирование карты лояльности'"));
		ДополнительныеПараметры.Вставить("ТекстИнформации"	  , СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения,
																	НСтр("ru = 'Уже существует карта лояльности, привязанная к введенному'"), 
																	ЧастьШаблона));
	
		maxma_ИнтеграцияССервисомКлиент.ОткрытьФормуИнформации(ДополнительныеПараметры);
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьЦифру(ВведеннаяЦифраСтрокой)	
	
	ТекущийЭлемент = Элементы.ГруппаСтраницаОсновная;
	
	Если ПервыйВвод Тогда
		ВводимоеЧисло 		= "";
		КодТелефона 		= "";
		НомерТелефонаЧасть1 = "";
		НомерТелефонаЧасть2 = "";
		НомерТелефонаЧасть3 = "";
		ПервыйВвод 			= Ложь;
	КонецЕсли;
	
	Если РежимПоискаКарты = 1 Тогда
		
		Если СтрДлина(КодТелефона) = СтрДлина(СтруктураМаски.КодТелефона) Тогда
			
			Если СтрДлина(НомерТелефонаЧасть1) = СтрДлина(СтруктураМаски.НомерТелефонаЧасть1) Тогда
				
				Если СтрДлина(НомерТелефонаЧасть2) = СтрДлина(СтруктураМаски.НомерТелефонаЧасть2) Тогда
					НомерТелефонаЧасть3 = НомерТелефонаЧасть3 + ВведеннаяЦифраСтрокой;
					Если СтрДлина(НомерТелефонаЧасть3) = СтрДлина(СтруктураМаски.НомерТелефонаЧасть3) Тогда
						ТекущийЭлемент = Элементы.КомандаEnterПраваяКлавиатура;
					КонецЕсли;
				Иначе
					НомерТелефонаЧасть2 = НомерТелефонаЧасть2 + ВведеннаяЦифраСтрокой;
				КонецЕсли;
				
			Иначе
				НомерТелефонаЧасть1 = НомерТелефонаЧасть1 + ВведеннаяЦифраСтрокой;
			КонецЕсли;
			
		Иначе
			КодТелефона = КодТелефона + ВведеннаяЦифраСтрокой;
		КонецЕсли;
		
		ВводимоеЧисло = КодСтраны + КодТелефона + НомерТелефонаЧасть1 + НомерТелефонаЧасть2 + НомерТелефонаЧасть3;

	Иначе
		ВводимоеЧисло = ВводимоеЧисло + ВведеннаяЦифраСтрокой;
	КонецЕсли;

	ТекущийЭлемент = Элементы.ГруппаСтраницаОсновная;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьСПередачейРезультата()
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("ВведенноеЧисло", ВводимоеЧисло);
	Если РежимПоискаКарты = 1 Тогда
		СтруктураОтвета.Вставить("РежимПоискаКарты", "НомерТелефона");
	ИначеЕсли РежимПоискаКарты = 2 Тогда
		СтруктураОтвета.Вставить("РежимПоискаКарты", "ФИО");
	ИначеЕсли РежимПоискаКарты = 3 Тогда
		СтруктураОтвета.Вставить("РежимПоискаКарты", "Email");
	Иначе
		СтруктураОтвета.Вставить("РежимПоискаКарты", "КодКарты");
	КонецЕсли;
	
	Закрыть(СтруктураОтвета);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФокусВвода()
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаПраваяКлавиатура;
	Если РежимПоискаКарты =1 Тогда
		ТекущийЭлемент = Элементы.Команда9ПраваяКлавиатура;
		Элементы.СтраницыВвода.ТекущаяСтраница = Элементы.СтраницаТелефон;
	Иначе
		Элементы.СтраницыВвода.ТекущаяСтраница = Элементы.СтраницаВводимоеЧисло;
		ТекущийЭлемент = Элементы.ПолеВводимоеЧисло;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаТипПоиска(Команда)
	
	КомандаСтереть(Неопределено);
	Если РежимПоискаКарты >= 3 Тогда
		РежимПоискаКарты = 0;
	Иначе
		РежимПоискаКарты = РежимПоискаКарты + 1;
	КонецЕсли;
	
	УстановитьФокусВвода();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЦветТекстаПол()
	
	Если Не ЗначениеЗаполнено(Пол) Тогда
		Элементы.Пол.ЦветТекста = WebЦвета.Красный;
	Иначе
		Элементы.Пол.ЦветТекста = Новый Цвет();
	КонецЕсли;
	
КонецПроцедуры
 
&НаКлиенте
Функция ПроверкаЗаполнения()
	
	ОчиститьСообщения();

	НомерКарты = ВводимоеЧисло;
	
	МобильныйТелефонБезКодаСтраны = КодТелефона + НомерТелефонаЧасть1 + НомерТелефонаЧасть2 + НомерТелефонаЧасть3;	
	МобильныйТелефон			  = КодСтраны + МобильныйТелефонБезКодаСтраны;	
	
	ФИО = "";
	
	Если ЗначениеЗаполнено(Имя) Тогда
		ФИО = ФИО + Имя;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отчество) Тогда
		ФИО = ФИО + " " + Отчество;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Фамилия) Тогда
		ФИО = ФИО + " " + Фамилия;
	КонецЕсли;
	
	ШаблонСообщения = НСтр("ru = 'Не заполнены обязательные поля: ""%1"".'");
	
	Поля = "";
	
	Если ВыдачаЗаменаКарты_ОбязательныеПоля.Количество() Тогда
		
		Для Каждого ЭлементМассива Из ВыдачаЗаменаКарты_ОбязательныеПоля Цикл
			
			Если ЭлементМассива.Значение = "ПодтверждениеПоСМС" 
				ИЛИ ЭлементМассива.Значение = "СогласенНаРассылку" Тогда
				
				Если ЭтотОбъект[ЭлементМассива.Значение] = Ложь Тогда
					Поля = Поля + "," + ЭлементМассива.Значение;
				КонецЕсли;
				
			ИначеЕсли ЭлементМассива.Значение = "МобильныйТелефон" Тогда
				
				Если НЕ ЗначениеЗаполнено(ЭтотОбъект["МобильныйТелефонБезКодаСтраны"]) Тогда
					Поля = Поля + "," + ЭлементМассива.Значение;
				КонецЕсли;
				
			Иначе
				
				Если НЕ ЗначениеЗаполнено(ЭтотОбъект[ЭлементМассива.Значение]) Тогда
					Поля = Поля + "," + ЭлементМассива.Значение;
				КонецЕсли;
				
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЕсли;
	
	Поля = Сред(Поля, 2);
	
	Если ЗначениеЗаполнено(Поля) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, Поля));
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыИнформации = maxma_ИнтеграцияССервисомВызовСервера.ПолучитьСтруктуруВыводимойВРМКИнформации();
	
	// Проверка считанных данных
	Если ЗначениеЗаполнено(МобильныйТелефонБезКодаСтраны) И НЕ ДанныеКорректны(МобильныйТелефон, Истина) Тогда
		
		ПараметрыИнформации.ЗаголовокИнформации = НСтр("ru = 'Введен некорректный номер телефона'");
		ПараметрыИнформации.ТекстИнформации 	= МобильныйТелефон;
		
		maxma_ИнтеграцияССервисомКлиент.ОткрытьФормуИнформации(ПараметрыИнформации);
				
		Возврат Ложь;
		
	КонецЕсли;
	
	// Проверка считанных данных
	Если ЗначениеЗаполнено(НомерКарты) И НЕ ДанныеКорректны(НомерКарты) Тогда
		
		ПараметрыИнформации.ЗаголовокИнформации = НСтр("ru = 'Введен некорректный номер карты'");
		ПараметрыИнформации.ТекстИнформации 	= НомерКарты;
		
		maxma_ИнтеграцияССервисомКлиент.ОткрытьФормуИнформации(ПараметрыИнформации);
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Email) Тогда
		
		Если Не ОбщегоНазначенияКлиентСервер.АдресЭлектроннойПочтыСоответствуетТребованиям(Email) Тогда
			
			ТекстОшибки = НСтр("ru = 'Необходимо ввести корректный адрес электронной почты.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьЦветТекстаПол(); 
	
	Элементы.СогласенНаРассылку.Доступность = Истина;
	Элементы.ВыдатьКарту.Доступность 		= Истина;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция СоздатьБонусныйСчетНаСервере(ДополнительныеПараметры)
	
	ПараметрыКлиента = Новый Структура;
	
	Если ЗначениеЗаполнено(МобильныйТелефонБезКодаСтраны) Тогда
		ПараметрыКлиента.Вставить("phoneNumber", МобильныйТелефон);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерКарты) Тогда
		ПараметрыКлиента.Вставить("card", НомерКарты);
	КонецЕсли;
	
	ФИО = maxma_ИнтеграцияССервисомВызовСервера.ПолучитьФИО(Имя, Фамилия, Отчество);
	
	Если ЗначениеЗаполнено(ФИО) Тогда
		ПараметрыКлиента.Вставить("fullName", ФИО);
		Если ЗначениеЗаполнено(Имя) Тогда
			ПараметрыКлиента.Вставить("name", Имя);
		КонецЕсли;
		Если ЗначениеЗаполнено(Отчество) Тогда
			ПараметрыКлиента.Вставить("patronymicName", Отчество);
		КонецЕсли;
		Если ЗначениеЗаполнено(Фамилия) Тогда
			ПараметрыКлиента.Вставить("surname", Фамилия);
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыКлиента.Вставить("gender", Пол);
	
	Если ЗначениеЗаполнено(ДатаРождения) Тогда
		ПараметрыКлиента.Вставить("birthdate", ДатаРождения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(email) Тогда
		ПараметрыКлиента.Вставить("email", email);
	КонецЕсли;
	
	ПараметрыКлиента.Вставить("isEmailSubscribed", СогласенНаРассылку);
	ПараметрыКлиента.Вставить("isPhoneSubscribed", СогласенНаРассылку);
	
	ПараметрыМагазина = Новый Структура;
	ПараметрыМагазина.Вставить("code", XMLСтрока(НастройкиМодуля.Магазин));
	ПараметрыМагазина.Вставить("name", Строка(НастройкиМодуля.Магазин));
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("client", ПараметрыКлиента);
	ПараметрыЗапроса.Вставить("shop",   ПараметрыМагазина);
	
	МетодNewClient = maxma_ИнтеграцияССервисомВызовСервера.МетодNewClient();
	
	ОтветСервера = maxma_ИнтеграцияССервисомВызовСервера.ОтветСервера(ПараметрыЗапроса, МетодNewClient, НастройкиМодуля);
	
	maxma_ИнтеграцияССервисомВызовСервера.ДополнитьДанныеКлиента(ОтветСервера);
	
	ТекстИнформации = "";
	ДисконтнаяКартаСсылка = Справочники.ДисконтныеКарты.ПустаяСсылка();
	
	Если ОтветСервера.ЕстьОшибки И ОтветСервера.Свойство("ТекстОшибки", ТекстИнформации) Тогда
		
		Результат = Ложь;
		
		maxma_ИнтеграцияССервисомВызовСервера.ЗаписатьДанныеВЖурналРегистрации(ТекстИнформации, УровеньЖурналаРегистрации.Ошибка);
		
	Иначе
		
		Результат = Истина;
		
		ДополнительныеПараметры.Вставить("Клиент", ОтветСервера.Данные.client);
		
		Если НастройкиМодуля.ДублироватьКлиентовВ1С Тогда
			
			Попытка
				
				НачатьТранзакцию();
				
				РеквизитыКлиента = Новый Структура();
				РеквизитыКлиента.Вставить("ФИО", 			  	 maxma_ИнтеграцияССервисомВызовСервера.ПолучитьФИО(Имя, Фамилия, Отчество));
				РеквизитыКлиента.Вставить("Фамилия", 		  	 Фамилия);
				РеквизитыКлиента.Вставить("Имя", 			  	 Имя);
				РеквизитыКлиента.Вставить("Отчество", 		  	 Отчество);
				РеквизитыКлиента.Вставить("КодСтраны", 			 КодСтраны);
				РеквизитыКлиента.Вставить("КодТелефона", 		 КодТелефона);
				РеквизитыКлиента.Вставить("НомерТелефонаЧасть1", НомерТелефонаЧасть1);
				РеквизитыКлиента.Вставить("НомерТелефонаЧасть2", НомерТелефонаЧасть2);
				РеквизитыКлиента.Вставить("НомерТелефонаЧасть3", НомерТелефонаЧасть3);
				РеквизитыКлиента.Вставить("НомерКарты", 	  	 НомерКарты);
				РеквизитыКлиента.Вставить("Email", 			  	 Email);
				РеквизитыКлиента.Вставить("ДатаРождения",     	 ДатаРождения);
				РеквизитыКлиента.Вставить("Пол", 			  	 Пол);
				
				ВладелецКартыСсылка   = maxma_ИнтеграцияССервисомВызовСервера.НайтиОбновитьКонтактноеЛицоВ1С(РеквизитыКлиента);
				ДисконтнаяКартаСсылка = maxma_ИнтеграцияССервисомВызовСервера.НайтиОбновитьИнформационнуюКартуВ1С(ВладелецКартыСсылка, НомерКарты);
				
				ЗафиксироватьТранзакцию();
				
			Исключение
				
				ОтменитьТранзакцию();
				
				ДополнительныеПараметры.Вставить("ЗаголовокИнформации", НСтр("ru = 'Не удалось создать бонусную карту в 1С'"));
				ТекстИнформации     = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				
			КонецПопытки;
			
		Иначе
			ДисконтнаяКартаСсылка = Справочники.ДисконтныеКарты.ПолучитьСсылку(Новый УникальныйИдентификатор(НастройкиМодуля.ДисконтнаяКартаИдентификатор));
		КонецЕсли;
		
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ДисконтнаяКарта", ДисконтнаяКартаСсылка);
	ДополнительныеПараметры.Вставить("СетеваяОшибка", ОтветСервера.СетеваяОшибка);
	ДополнительныеПараметры.Вставить("ТекстИнформации", ТекстИнформации);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОбновитьИнформациюОКлиентеНаСервере(ДополнительныеПараметры)
	
	Результат 			  = Ложь;
	ДисконтнаяКартаСсылка = Справочники.ДисконтныеКарты.ПустаяСсылка();
	ЗаголовокИнформации   = "";
	ТекстИнформации 	  = "";
	ПараметрыЗапроса 	  = Новый Структура;
	
	Если ЗначениеЗаполнено(РеквизитыКлиентаДо.МобильныйТелефонДо) Тогда
		ПараметрыЗапроса.Вставить("phoneNumber", РеквизитыКлиентаДо.МобильныйТелефонДо);
	ИначеЕсли ЗначениеЗаполнено(РеквизитыКлиентаДо.НомерКартыДо) Тогда
		ПараметрыЗапроса.Вставить("card", РеквизитыКлиентаДо.НомерКартыДо);
	Иначе
		Возврат Результат;
	КонецЕсли;
			
	ОбновляемыеПоля = Новый Структура;
	
	Если НЕ МобильныйТелефонБезКодаСтраны = РеквизитыКлиентаДо.МобильныйТелефонДо Тогда
		ОбновляемыеПоля.Вставить("phoneNumber", МобильныйТелефон);	
	КонецЕсли;

	Если НЕ НомерКарты = РеквизитыКлиентаДо.НомерКартыДо Тогда
		ОбновляемыеПоля.Вставить("card", НомерКарты);	
	КонецЕсли;
	
	ОбновляемыеПоля.Вставить("name", Имя);
	ОбновляемыеПоля.Вставить("surname", Фамилия);
	ОбновляемыеПоля.Вставить("patronymicName", Отчество);
	
	ОбновляемыеПоля.Вставить("gender", Пол);
	
	Если НЕ ДатаРождения = РеквизитыКлиентаДо.ДатаРожденияДо Тогда
		ОбновляемыеПоля.Вставить("birthdate", ДатаРождения);
	КонецЕсли;

	Если НЕ email = РеквизитыКлиентаДо.emailДо Тогда
		ОбновляемыеПоля.Вставить("email", email);
	КонецЕсли;

	ОбновляемыеПоля.Вставить("isEmailSubscribed", СогласенНаРассылку);
	ОбновляемыеПоля.Вставить("isPhoneSubscribed", СогласенНаРассылку);

	ПараметрыЗапроса.Вставить("client", ОбновляемыеПоля);
	
	МетодUpdateClient = maxma_ИнтеграцияССервисомВызовСервера.МетодUpdateClient();
	
	ОтветСервера = maxma_ИнтеграцияССервисомВызовСервера.ОтветСервера(ПараметрыЗапроса, МетодUpdateClient, НастройкиМодуля);
	
	maxma_ИнтеграцияССервисомВызовСервера.ДополнитьДанныеКлиента(ОтветСервера);
		
	Если ОтветСервера.ЕстьОшибки И ОтветСервера.Свойство("ТекстОшибки", ТекстИнформации) Тогда
		maxma_ИнтеграцияССервисомВызовСервера.ЗаписатьДанныеВЖурналРегистрации(ТекстИнформации, УровеньЖурналаРегистрации.Ошибка);
	Иначе
		
		ДополнительныеПараметры.Вставить("Клиент", ОтветСервера.Данные.client);
		
		Результат = Истина;
		
		ЗаголовокИнформации	= НСтр("ru = 'Редактирование карты лояльности'");
		ТекстИнформации	  	= НСтр("ru = 'Карта лояльности успешно отредактирована'");
		
		Если НастройкиМодуля.ДублироватьКлиентовВ1С Тогда
			
			Попытка
				
				НачатьТранзакцию();
				
				РеквизитыНовые = Новый Структура();
				РеквизитыНовые.Вставить("ФИО", 			  	   maxma_ИнтеграцияССервисомВызовСервера.ПолучитьФИО(Имя, Фамилия, Отчество));
				РеквизитыНовые.Вставить("Фамилия", 		  	   Фамилия);
				РеквизитыНовые.Вставить("Имя", 			  	   Имя);
				РеквизитыНовые.Вставить("Отчество", 		   Отчество);
				РеквизитыНовые.Вставить("КодСтраны", 		   КодСтраны);
				РеквизитыНовые.Вставить("КодТелефона", 		   КодТелефона);
				РеквизитыНовые.Вставить("НомерТелефонаЧасть1", НомерТелефонаЧасть1);
				РеквизитыНовые.Вставить("НомерТелефонаЧасть2", НомерТелефонаЧасть2);
				РеквизитыНовые.Вставить("НомерТелефонаЧасть3", НомерТелефонаЧасть3);
				РеквизитыНовые.Вставить("НомерКарты", 	  	   НомерКарты);
				РеквизитыНовые.Вставить("Email", 			   Email);
				РеквизитыНовые.Вставить("ДатаРождения",        ДатаРождения);
				РеквизитыНовые.Вставить("Пол", 			  	   Пол);
				
				РеквизитыСтарые = Новый Структура();
				РеквизитыСтарые.Вставить("ФИО", 			    maxma_ИнтеграцияССервисомВызовСервера.ПолучитьФИО(РеквизитыКлиентаДо.ИмяДо, РеквизитыКлиентаДо.ФамилияДо, РеквизитыКлиентаДо.ОтчествоДо));
				РеквизитыСтарые.Вставить("Фамилия", 		  	РеквизитыКлиентаДо.ФамилияДо);
				РеквизитыСтарые.Вставить("Имя", 			  	РеквизитыКлиентаДо.ИмяДо);
				РеквизитыСтарые.Вставить("Отчество", 		    РеквизитыКлиентаДо.ОтчествоДо);
				РеквизитыСтарые.Вставить("КодСтраны", 		    РеквизитыКлиентаДо.КодСтраны);
				РеквизитыСтарые.Вставить("КодТелефона", 		РеквизитыКлиентаДо.КодТелефона);
				РеквизитыСтарые.Вставить("НомерТелефонаЧасть1", РеквизитыКлиентаДо.НомерТелефонаЧасть1);
				РеквизитыСтарые.Вставить("НомерТелефонаЧасть2", РеквизитыКлиентаДо.НомерТелефонаЧасть2);
				РеквизитыСтарые.Вставить("НомерТелефонаЧасть3", РеквизитыКлиентаДо.НомерТелефонаЧасть3);
				РеквизитыСтарые.Вставить("НомерКарты", 	  	    РеквизитыКлиентаДо.НомерКартыДо);
				РеквизитыСтарые.Вставить("Email", 			    РеквизитыКлиентаДо.EmailДо);
				РеквизитыСтарые.Вставить("ДатаРождения",        РеквизитыКлиентаДо.ДатаРожденияДо);
				РеквизитыСтарые.Вставить("Пол", 			  	РеквизитыКлиентаДо.ПолДо);	
				
				ВладелецКартыСсылка   = maxma_ИнтеграцияССервисомВызовСервера.НайтиОбновитьКонтактноеЛицоВ1С(РеквизитыНовые, РеквизитыСтарые);
				ДисконтнаяКартаСсылка = maxma_ИнтеграцияССервисомВызовСервера.НайтиОбновитьИнформационнуюКартуВ1С(ВладелецКартыСсылка, НомерКарты);
				
				ЗафиксироватьТранзакцию();
				
			Исключение
				
				ОтменитьТранзакцию();
				
				ЗаголовокИнформации = НСтр("ru = 'Не удалось обновить бонусную карту в 1С'");
				ТекстИнформации		= ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				
			КонецПопытки;
			
		Иначе
			ДисконтнаяКартаСсылка = Справочники.ДисконтныеКарты.ПолучитьСсылку(Новый УникальныйИдентификатор(НастройкиМодуля.ДисконтнаяКартаИдентификатор));
		КонецЕсли;
		
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("СетеваяОшибка", 		ОтветСервера.СетеваяОшибка);
	ДополнительныеПараметры.Вставить("ЗаголовокИнформации", ЗаголовокИнформации);
	ДополнительныеПараметры.Вставить("ТекстИнформации", 	ТекстИнформации);
	ДополнительныеПараметры.Вставить("ДисконтнаяКарта",		ДисконтнаяКартаСсылка);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОповещениеОткрытьФормуИнформацииВыдачаКартыЛояльности(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
		
	Оповестить("ВыданаКартаЛояльности", ДополнительныеПараметры, ЭтотОбъект);
		
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Функция ДанныеКорректны(Данные, ЭтоТелефон = Ложь)
	
	Если Не ЗначениеЗаполнено(Данные) Тогда
		Возврат Ложь
	КонецЕсли;
	
	ДлинаСтроки = СтрДлина(Данные);
	
	Если ЭтоТелефон Тогда
		Если НЕ ДлинаСтроки = СтрДлина(КодСтраны + СтруктураМаски.КодТелефона + СтруктураМаски.НомерТелефонаЧасть1 + СтруктураМаски.НомерТелефонаЧасть2 + СтруктураМаски.НомерТелефонаЧасть3) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	СтрокаСимволовЦифр = "1234567890";
	Для Индекс = 1 По 10 Цикл
		Символ = Сред(Данные, Индекс, 1);
		Если Найти(СтрокаСимволовЦифр, Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПолучитьБалансНаСервереВыдачаКарты(РежимПоискаКарты, ВведенныеДанные, ДополнительныеПараметры)
		
	Результат 			= Ложь;
	ЗаголовокИнформации = "";
	ТекстИнформации 	= "";
	
	ПараметрыЗапроса = Новый Структура;
	
	Если РежимПоискаКарты = "НомерТелефона" Тогда
		ПараметрыЗапроса.Вставить("phoneNumber", ВведенныеДанные);
	ИначеЕсли РежимПоискаКарты = "КодКарты" Тогда 
		ПараметрыЗапроса.Вставить("card", ВведенныеДанные);
	КонецЕсли; 
	
	МетодGetBalance = maxma_ИнтеграцияССервисомВызовСервера.МетодGetBalance();
	
	ОтветСервера = maxma_ИнтеграцияССервисомВызовСервера.ОтветСервера(ПараметрыЗапроса, МетодGetBalance, НастройкиМодуля);
	
	maxma_ИнтеграцияССервисомВызовСервера.ДополнитьДанныеКлиента(ОтветСервера);
		
	Если ОтветСервера.ЕстьОшибки И ОтветСервера.Свойство("ТекстОшибки", ТекстИнформации) Тогда
		maxma_ИнтеграцияССервисомВызовСервера.ЗаписатьДанныеВЖурналРегистрации(ТекстИнформации, УровеньЖурналаРегистрации.Ошибка);
	Иначе	
		Результат = Истина;	
	КонецЕсли;
		
	ДополнительныеПараметры.Вставить("СетеваяОшибка"	  , ОтветСервера.СетеваяОшибка);
	ДополнительныеПараметры.Вставить("ЗаголовокИнформации", ЗаголовокИнформации);
	ДополнительныеПараметры.Вставить("ТекстИнформации"	  , ТекстИнформации);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьБалансНаСервереРедактированиеКарты(РежимПоискаКартыСтрока, ВведенныеДанные, ДополнительныеПараметры, ПриОткрытии = Ложь)
		
	Результат 			= Ложь;
	ЗаголовокИнформации = "";
	ТекстИнформации 	= "";
		
	ПараметрыЗапроса = Новый Структура;
	
	Если РежимПоискаКартыСтрока = "НомерТелефона" Тогда
		ПараметрыЗапроса.Вставить("phoneNumber", ВведенныеДанные);
	ИначеЕсли РежимПоискаКартыСтрока = "КодКарты" Тогда 
		ПараметрыЗапроса.Вставить("card", ВведенныеДанные);
	КонецЕсли; 
	
	МетодGetBalance = maxma_ИнтеграцияССервисомВызовСервера.МетодGetBalance();
	
	ОтветСервера = maxma_ИнтеграцияССервисомВызовСервера.ОтветСервера(ПараметрыЗапроса, МетодGetBalance, НастройкиМодуля);
	
	maxma_ИнтеграцияССервисомВызовСервера.ДополнитьДанныеКлиента(ОтветСервера);
		
	Если ОтветСервера.ЕстьОшибки И ОтветСервера.Свойство("ТекстОшибки", ТекстИнформации) Тогда
		maxma_ИнтеграцияССервисомВызовСервера.ЗаписатьДанныеВЖурналРегистрации(ТекстИнформации, УровеньЖурналаРегистрации.Ошибка);
	Иначе
		
		Результат = Истина;
		
		Если ПриОткрытии Тогда
			
			Если ОтветСервера.Данные.client.Свойство("name") Тогда
				Имя = ОтветСервера.Данные.client.name;
				РеквизитыКлиентаДо.Вставить("ИмяДо", Имя);
			Иначе
				Имя = "";
			КонецЕсли;
			
			Если ОтветСервера.Данные.client.Свойство("surname") Тогда
				Фамилия = ОтветСервера.Данные.client.surname;
				РеквизитыКлиентаДо.Вставить("ФамилияДо", Фамилия);
			Иначе
				Фамилия = "";
			КонецЕсли;
			
			Если ОтветСервера.Данные.client.Свойство("patronymicName") Тогда
				Отчество = ОтветСервера.Данные.client.patronymicName;
				РеквизитыКлиентаДо.Вставить("ОтчествоДо", Отчество);
			Иначе
				Отчество = "";
			КонецЕсли;
			
			Если ОтветСервера.Данные.client.Свойство("phoneNumber") Тогда
				
				МобильныйТелефон = СтрЗаменить(СокрЛП(ОтветСервера.Данные.client.phoneNumber), "+", "");
				
				ЗаполнитьЗначенияСвойств(ЭтотОбъект, maxma_ИнтеграцияССервисомВызовСервера.РаспарситьНомерТелефона(МобильныйТелефон, КодСтраны));
				
				РеквизитыКлиентаДо.Вставить("МобильныйТелефонДо",  МобильныйТелефонБезКодаСтраны);
				РеквизитыКлиентаДо.Вставить("КодСтраны", 		   КодСтраны);
				РеквизитыКлиентаДо.Вставить("КодТелефона"	  	 , КодТелефона);
				РеквизитыКлиентаДо.Вставить("НомерТелефонаЧасть1", НомерТелефонаЧасть1);
				РеквизитыКлиентаДо.Вставить("НомерТелефонаЧасть2", НомерТелефонаЧасть2);
				РеквизитыКлиентаДо.Вставить("НомерТелефонаЧасть3", НомерТелефонаЧасть3);
				
			Иначе
				МобильныйТелефон = "";
			КонецЕсли;
			
			Если ОтветСервера.Данные.client.Свойство("cardString") Тогда
				НомерКарты = Формат(ОтветСервера.Данные.client.cardString, "ЧГ=");
				ВводимоеЧисло = НомерКарты;
				РеквизитыКлиентаДо.Вставить("НомерКартыДо", НомерКарты);
			Иначе
				НомерКарты = "";
			КонецЕсли;
			
			Если ОтветСервера.Данные.client.Свойство("gender") Тогда
				Пол = ОтветСервера.Данные.client.gender;
				РеквизитыКлиентаДо.Вставить("ПолДо", Пол);
			КонецЕсли;
			
			Если ОтветСервера.Данные.client.Свойство("birthdate") Тогда
				ДатаРождения = Дата(СтрЗаменить(ОтветСервера.Данные.client.birthdate, "-", ""));
				РеквизитыКлиентаДо.Вставить("ДатаРожденияДо", ДатаРождения);
			КонецЕсли;
			
			Если ОтветСервера.Данные.client.Свойство("email") Тогда
				email = ОтветСервера.Данные.client.email;
				РеквизитыКлиентаДо.Вставить("emailДо", email);
			КонецЕсли;
			
			Если ОтветСервера.Данные.client.Свойство("isEmailSubscribed") Тогда
				СогласенНаРассылку = ОтветСервера.Данные.client.isEmailSubscribed;
				РеквизитыКлиентаДо.Вставить("СогласенНаРассылкуДо", СогласенНаРассылку);
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("СетеваяОшибка"	  , ОтветСервера.СетеваяОшибка);
	ДополнительныеПараметры.Вставить("ЗаголовокИнформации", ЗаголовокИнформации);
	ДополнительныеПараметры.Вставить("ТекстИнформации"	  , ТекстИнформации);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ТаймерОтправкиСМС()
	
	ОставшеесяВремя = Макс(ВремяПовторнойОтправкиСМСКода-ТекущаяДата(), 0);
	Если ОставшеесяВремя <= 0 Тогда
		ОтключитьОбработчикОжидания("ТаймерОтправкиСМС");
		НадписьПовторитьОтправку = "";
		Элементы.ОтправитьКодСМС.Доступность = Истина;
		Элементы.СтраницаТелефон.Доступность = Истина;		
		Элементы.ОтправитьКодСМС.Заголовок = "Отправить код СМС";
		Возврат;
	КонецЕсли; 
	
	НадписьПовторитьОтправку = "Повторить отправку через "+ОставшеесяВремя+" сек.";
		
КонецПроцедуры
 
&НаСервере
Функция ОтправитьКодСМСНаСервере(НомерТелефона, ДополнительныеПараметры)
	
	Результат 			= Ложь;
	ЗаголовокИнформации = "";
	ТекстИнформации 	= "";
	
	ПараметрыЗапроса = Новый Структура;
	
	Если Операция = "ВыдачаКарты" Тогда
		ПараметрыЗапроса.Вставить("isAnonymousClient", Истина);
		ПараметрыЗапроса.Вставить("to"		 		 , НомерТелефона);
	ИначеЕсли Операция = "РедактированиеКарты" Тогда
		
		Если ЗначениеЗаполнено(РеквизитыКлиентаДо.МобильныйТелефонДо) Тогда
			ПараметрыЗапроса.Вставить("phoneNumber", РеквизитыКлиентаДо.МобильныйТелефонДо);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РеквизитыКлиентаДо.НомерКартыДо) Тогда
			ПараметрыЗапроса.Вставить("card", РеквизитыКлиентаДо.НомерКартыДо);
		КонецЕсли;
		
		ПараметрыЗапроса.Вставить("to", НомерТелефона);
		
	КонецЕсли;
	
	МетодSendConfirmationCode = maxma_ИнтеграцияССервисомВызовСервера.МетодSendConfirmationCode();
	
	ОтветСервера = maxma_ИнтеграцияССервисомВызовСервера.ОтветСервера(ПараметрыЗапроса, МетодSendConfirmationCode, НастройкиМодуля);
		
	Если ОтветСервера.ЕстьОшибки И ОтветСервера.Свойство("ТекстОшибки", ТекстИнформации) Тогда
		maxma_ИнтеграцияССервисомВызовСервера.ЗаписатьДанныеВЖурналРегистрации(ТекстИнформации, УровеньЖурналаРегистрации.Ошибка);
	Иначе
		Результат 		 = Истина; 
		КодПодтверждения = ОтветСервера.Данные.code;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("СетеваяОшибка"	  , ОтветСервера.СетеваяОшибка);
	ДополнительныеПараметры.Вставить("ЗаголовокИнформации", ЗаголовокИнформации);
	ДополнительныеПараметры.Вставить("ТекстИнформации"	  , ТекстИнформации);
	
	Возврат Результат;

КонецФункции

