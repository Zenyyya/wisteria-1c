
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаПраваяКлавиатура;
	Элементы.СтраницыВвода.ТекущаяСтраница  = Элементы.СтраницаВводимоеЧисло;
	
	ТекущийЭлемент = Элементы.ПолеВводимоеЧисло;
	
	НастройкиМодуля = Параметры.НастройкиМодуля;
	
	Если Не НастройкиМодуля.ИспользоватьПрограммыЛояльности Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Параметры.Свойство("РежимПоискаКарты", РежимПоискаКартыСтрока);
	Параметры.Свойство("Операция", 		   Операция);
	Параметры.Свойство("КодСтраны", 	   КодСтраны);
	Параметры.Свойство("КассаККМ", 		   КассаККМ);
	Параметры.Свойство("Организация", 	   Организация);
	
	Если РежимПоискаКартыСтрока = "НомерТелефона" Тогда
		МобильныйТелефон = Параметры.ВведенноеЧисло;
		РежимПоискаКарты = 1;
	ИначеЕсли РежимПоискаКартыСтрока = "КодКарты" Тогда
		ВводимоеЧисло 	 = Параметры.ВведенноеЧисло;
		РежимПоискаКарты = 0;
	Иначе
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	РеквизитыКлиентаДо = Новый Структура;
	РеквизитыКлиентаДо.Вставить("МобильныйТелефонДо", 	"");
	РеквизитыКлиентаДо.Вставить("НомерКартыДо", 	  	"");
	РеквизитыКлиентаДо.Вставить("ИмяДо", 			  	"");
	РеквизитыКлиентаДо.Вставить("ФамилияДо", 		  	"");
	РеквизитыКлиентаДо.Вставить("ОтчествоДо", 		  	"");
	РеквизитыКлиентаДо.Вставить("ПолДо", 			  	"");
	РеквизитыКлиентаДо.Вставить("ДатаРожденияДо", 	  	Дата(1,1,1));
	РеквизитыКлиентаДо.Вставить("EmailДо", 			  	"");
	РеквизитыКлиентаДо.Вставить("СогласенНаРассылкуДо", Ложь);
	РеквизитыКлиентаДо.Вставить("КодСтраны", 			"");
	РеквизитыКлиентаДо.Вставить("КодТелефона"	  	 ,  "");
	РеквизитыКлиентаДо.Вставить("НомерТелефонаЧасть1",  "");
	РеквизитыКлиентаДо.Вставить("НомерТелефонаЧасть2",  "");
	РеквизитыКлиентаДо.Вставить("НомерТелефонаЧасть3",  "");
		
	Если Операция = "ВыдачаКарты" Тогда
		
		Элементы.ВыдатьКарту.Заголовок = "Выдать карту";
		Элементы.ГруппаШапка.Заголовок = "Выдача карты лояльности";	
		
		СогласенНаРассылку = Истина;
		
		Если ЗначениеЗаполнено(МобильныйТелефон) Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, maxma_ИнтеграцияССервисомВызовСервера.РаспарситьНомерТелефона(МобильныйТелефон, КодСтраны));
		КонецЕсли;

	ИначеЕсли Операция = "РедактированиеКарты" Тогда	
		
		Элементы.ВыдатьКарту.Заголовок = "Редактировать карту";
		Элементы.ГруппаШапка.Заголовок = "Редактирование карты лояльности";
				
		Если НЕ (РежимПоискаКартыСтрока = "НомерТелефона"
			ИЛИ РежимПоискаКартыСтрока = "КодКарты") Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура;
		
		ПолучитьБалансНаСервереРедактированиеКарты(РежимПоискаКартыСтрока, Параметры.ВведенноеЧисло, ДополнительныеПараметры, Истина);

		Если ЗначениеЗаполнено(МобильныйТелефон) Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, maxma_ИнтеграцияССервисомВызовСервера.РаспарситьНомерТелефона(МобильныйТелефон, КодСтраны));
		КонецЕсли;
		
	Иначе
		Элементы.ВыдатьКарту.Заголовок = "Неизвестный режим";
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(НастройкиМодуля.ВыдачаЗаменаКарты_ОбязательныеПоляХранилище) Тогда	
		ВыдачаЗаменаКарты_ОбязательныеПоля.ЗагрузитьЗначения(СтрРазделить(НастройкиМодуля.ВыдачаЗаменаКарты_ОбязательныеПоляХранилище, ","));	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// ПодключаемоеОборудование
	ОповещенияПриПодключении = Новый ОписаниеОповещения("ПодключитьОборудованиеЗавершение", ЭтотОбъект);
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(ОповещенияПриПодключении, ЭтотОбъект, "СканерШтрихкода, СчитывательМагнитныхКарт");
	// Конец ПодключаемоеОборудование
	АктивироватьКнопкуОтправитьСМС();
	ОбновитьЦветТекстаПол();
	
	maxma_ИнтеграцияССервисомКлиент.УстановитьМаскуНомераТелефона(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	// ПодключаемоеОборудование
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(Неопределено, ЭтотОбъект);
	// Конец ПодключаемоеОборудование

КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если ВводДоступен() Тогда
		
		Если Событие = "Штрихкод" Или Событие = "ПолученШтрихкод" Или Событие = "ScanData" Тогда
			ВыполнитьПоискШтрихкода(Данные);
		ИначеЕсли Событие = "TracksData" Или Событие = "ДанныеКарты" Тогда
			ВыполнитьПоискМагнитнойКарты(Данные);
		Иначе
			Возврат;
		КонецЕсли; 
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

