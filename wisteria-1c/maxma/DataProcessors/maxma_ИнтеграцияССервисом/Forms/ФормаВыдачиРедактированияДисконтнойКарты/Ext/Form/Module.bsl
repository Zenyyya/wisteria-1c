&НаКлиенте
Процедура КомандаСтереть(Команда)
	ВводимоеЧисло = "";
	КодТелефона = "";
	НомерТелефонаЧасть1 = "";
	НомерТелефонаЧасть2 = "";
	НомерТелефонаЧасть3 = "";
	Если РежимПоискаКарты = 1 Тогда
		ПервыйВвод = Истина;
	Иначе
		ПервыйВвод = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаEnter(Команда)
	
	ЗакрытьСПередачейРезультата();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыдатьКарту(Команда)
		
	Если ПроверкаЗаполнения() Тогда
		
		Если Операция = "ВыдачаКарты" Тогда
			
			ДополнительныеПараметры = Новый Структура;
			
			Если РежимПоискаКартыСтрока = "КодКарты" И ЗначениеЗаполнено(НомерКарты) Тогда
				РежимПоискаКартыСтрока = "КодКарты";
				НомерКартыТелефон 	   = НомерКарты;
			ИначеЕсли РежимПоискаКартыСтрока = "КодКарты" И Не ЗначениеЗаполнено(НомерКарты) И ЗначениеЗаполнено(МобильныйТелефонБезКодаСтраны) Тогда
				РежимПоискаКартыСтрока = "НомерТелефона";
				НомерКартыТелефон 	   = МобильныйТелефон;
			ИначеЕсли РежимПоискаКартыСтрока = "НомерТелефона" И ЗначениеЗаполнено(МобильныйТелефонБезКодаСтраны) Тогда
				РежимПоискаКартыСтрока = "НомерТелефона";
				НомерКартыТелефон 	   = МобильныйТелефон;
			ИначеЕсли РежимПоискаКартыСтрока = "НомерТелефона" И Не ЗначениеЗаполнено(МобильныйТелефонБезКодаСтраны) И ЗначениеЗаполнено(НомерКарты) Тогда
				РежимПоискаКартыСтрока = "КодКарты";
				НомерКартыТелефон 	   = НомерКарты;
			Иначе
				Возврат;
			КонецЕсли;
				
			ШаблонСообщения = Нстр("ru = '%1.
			|%2.'");
			
			Если ПолучитьБалансНаСервереВыдачаКарты(РежимПоискаКартыСтрока, НомерКартыТелефон, ДополнительныеПараметры) = Истина Тогда
				
				ДополнительныеПараметры.Вставить("ЗаголовокИнформации", НСтр("ru = 'Выдача карты лояльности'"));
				ДополнительныеПараметры.Вставить("ТекстИнформации", 	НСтр("ru = 'Уже существует карта лояльности, привязанная к введенному номеру карты/телефона.'"));
				
				maxma_ИнтеграцияССервисомКлиент.ОткрытьФормуИнформации(ДополнительныеПараметры);
				
			Иначе
				
				Если НЕ ДополнительныеПараметры.СетеваяОшибка Тогда
					
					Если СоздатьБонусныйСчетНаСервере(ДополнительныеПараметры) Тогда
						
						ДополнительныеПараметры.Вставить("ЗаголовокИнформации", НСтр("ru = 'Выдача карты лояльности'"));
						ДополнительныеПараметры.Вставить("ТекстИнформации", 	НСтр("ru = 'Карта успешно создана'"));
						ДополнительныеПараметры.Вставить("РежимПоиска", 	  	РежимПоискаКартыСтрока);
						ДополнительныеПараметры.Вставить("НомерКартыТелефон", 	НомерКартыТелефон);
						ДополнительныеПараметры.Вставить("КодСтраны",           КодСтраны);
						
						ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуИнформацииВыдачаКартыЛояльности", ЭтотОбъект, ДополнительныеПараметры);
						
						maxma_ИнтеграцияССервисомКлиент.ОткрытьФормуИнформации(ДополнительныеПараметры, ОбработчикОповещения);
						
					Иначе
						
						Если ДополнительныеПараметры.СетеваяОшибка = Ложь Тогда
							maxma_ИнтеграцияССервисомКлиент.ОткрытьФормуИнформации(ДополнительныеПараметры);
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли Операция = "РедактированиеКарты" Тогда 
			
			Если НЕ ЗначениеЗаполнено(МобильныйТелефонБезКодаСтраны) 
				И НЕ ЗначениеЗаполнено(НомерКарты) Тогда
				Возврат;
			КонецЕсли;
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("СетеваяОшибка", Ложь);
			
			ИзменилиТелефон    	   	   = СтрДлина(МобильныйТелефонБезКодаСтраны) = 10 И НЕ МобильныйТелефонБезКодаСтраны = РеквизитыКлиентаДо.МобильныйТелефонДо;
			ИзменилиНомерКарты 	   	   = НЕ НомерКарты = РеквизитыКлиентаДо.НомерКартыДо;
			ИзменилиИмя 	   	   	   = НЕ Имя = РеквизитыКлиентаДо.ИмяДо;
			ИзменилиФамилию 	   	   = НЕ Фамилия = РеквизитыКлиентаДо.ФамилияДо;
			ИзменилиОтчество 	   	   = НЕ Отчество = РеквизитыКлиентаДо.ОтчествоДо;
			ИзменилиПол    	   	   	   = НЕ Пол = РеквизитыКлиентаДо.ПолДо;
			ИзменилиДатуРождения   	   = НЕ ДатаРождения = РеквизитыКлиентаДо.ДатаРожденияДо;
			ИзменилиEmail 	  	   	   = НЕ Email = РеквизитыКлиентаДо.EmailДо;
			ИзменилиСогласенНаРассылку = НЕ СогласенНаРассылку = РеквизитыКлиентаДо.СогласенНаРассылкуДо;
			
			Если НЕ (ИзменилиТелефон ИЛИ ИзменилиНомерКарты ИЛИ ИзменилиИмя ИЛИ ИзменилиФамилию ИЛИ ИзменилиОтчество ИЛИ ИзменилиПол 
				ИЛИ ИзменилиДатуРождения ИЛИ ИзменилиEmail ИЛИ ИзменилиСогласенНаРассылку) Тогда
				
				ДополнительныеПараметры.Вставить("ЗаголовокИнформации", НСтр("ru = 'Редактирование карты лояльности'"));
				ДополнительныеПараметры.Вставить("ТекстИнформации"	  , НСтр("ru = 'Не изменено ни одного поля.'"));
				
				maxma_ИнтеграцияССервисомКлиент.ОткрытьФормуИнформации(ДополнительныеПараметры);
				
				Возврат;

			КонецЕсли;
			
			Если (ИзменилиТелефон И ЗначениеЗаполнено(МобильныйТелефонБезКодаСтраны))
				И (ИзменилиНомерКарты И ЗначениеЗаполнено(НомерКарты)) Тогда
				
				РежимПоискаКартыСтрока = "КодКарты";
				НомерКартыТелефон  = НомерКарты;
				
				Если НЕ КартаЛояльностиСуществует(ДополнительныеПараметры) Тогда
					
					РежимПоискаКартыСтрока = "НомерТелефона";
					НомерКартыТелефон  = МобильныйТелефон;
					
					Если НЕ КартаЛояльностиСуществует(ДополнительныеПараметры) Тогда
						ОбновитьИнформациюОКлиенте(ДополнительныеПараметры);
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли ИзменилиТелефон И ЗначениеЗаполнено(МобильныйТелефонБезКодаСтраны) Тогда
				
				РежимПоискаКартыСтрока = "НомерТелефона";
				НомерКартыТелефон  = МобильныйТелефон;
				
				Если НЕ КартаЛояльностиСуществует(ДополнительныеПараметры) Тогда
					ОбновитьИнформациюОКлиенте(ДополнительныеПараметры);
				КонецЕсли;
				
			ИначеЕсли ИзменилиНомерКарты И ЗначениеЗаполнено(НомерКарты) Тогда
				
				РежимПоискаКартыСтрока = "КодКарты";
				НомерКартыТелефон  = НомерКарты;
				
				Если НЕ КартаЛояльностиСуществует(ДополнительныеПараметры) Тогда
					ОбновитьИнформациюОКлиенте(ДополнительныеПараметры);
				КонецЕсли;
				
			ИначеЕсли ИзменилиИмя ИЛИ ИзменилиФамилию ИЛИ ИзменилиОтчество ИЛИ ИзменилиПол ИЛИ ИзменилиДатуРождения 
				ИЛИ ИзменилиEmail ИЛИ ИзменилиСогласенНаРассылку Тогда
				
				Если РежимПоискаКартыСтрока = "КодКарты" И ЗначениеЗаполнено(НомерКарты) Тогда
					РежимПоискаКартыСтрока = "КодКарты";
					НомерКартыТелефон 	   = НомерКарты;
				ИначеЕсли РежимПоискаКартыСтрока = "КодКарты" И Не ЗначениеЗаполнено(НомерКарты) И ЗначениеЗаполнено(МобильныйТелефонБезКодаСтраны) Тогда
					РежимПоискаКартыСтрока = "НомерТелефона";
					НомерКартыТелефон 	   = МобильныйТелефон;
				ИначеЕсли РежимПоискаКартыСтрока = "НомерТелефона" И ЗначениеЗаполнено(МобильныйТелефонБезКодаСтраны) Тогда
					РежимПоискаКартыСтрока = "НомерТелефона";
					НомерКартыТелефон 	   = МобильныйТелефон;
				ИначеЕсли РежимПоискаКартыСтрока = "НомерТелефона" И Не ЗначениеЗаполнено(МобильныйТелефонБезКодаСтраны) И ЗначениеЗаполнено(НомерКарты) Тогда
					РежимПоискаКартыСтрока = "КодКарты";
					НомерКартыТелефон 	   = НомерКарты;
				Иначе
					Возврат;
				КонецЕсли;
				
				ОбновитьИнформациюОКлиенте(ДополнительныеПараметры);
				
			Иначе
				Возврат;
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтправитьКодСМС(Команда)
	
	МобильныйТелефон = КодСтраны + КодТелефона + НомерТелефонаЧасть1 + НомерТелефонаЧасть2 + НомерТелефонаЧасть3;
	
	ДополнительныеПараметры = Новый Структура;
	ШаблонСообщения = Нстр("ru = '%1.
		|%2.'");
	Если ОтправитьКодСМСНаСервере(МобильныйТелефон, ДополнительныеПараметры) Тогда
		
		ДополнительныеПараметры.Вставить("ЗаголовокИнформации", НСтр("ru = 'Отправка код подтверждения'"));
		ДополнительныеПараметры.Вставить("ТекстИнформации"	  , НСтр("ru = 'Успешно отправлено'"));
		
		Элементы.СтраницаТелефон.Доступность   = Ложь;		
		Элементы.ОтправитьКодСМС.Доступность   = Ложь; 
		Элементы.ОтправитьКодСМС.Заголовок 	   = "Код отправлен";
		Элементы.КодИзСМС.Доступность 		   = Истина;
		Элементы.ПодтвердитьСМСКод.Доступность = Истина;
		
		maxma_ИнтеграцияССервисомКлиент.ОткрытьФормуИнформации(ДополнительныеПараметры);
		ВремяПовторнойОтправкиСМСКода = ТекущаяДата()+90;
		ПодключитьОбработчикОжидания("ТаймерОтправкиСМС", 5, Ложь);
		
	Иначе
		
		Если НЕ ДополнительныеПараметры.СетеваяОшибка Тогда
			
			Если ДополнительныеПараметры.СетеваяОшибка = Ложь Тогда
				maxma_ИнтеграцияССервисомКлиент.ОткрытьФормуИнформации(ДополнительныеПараметры);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодтвердитьСМСКод(Команда)
	
	Если КодИзСМС = КодПодтверждения Тогда
		Элементы.ПодтвердитьСМСКод.Заголовок = "Телефон подтвержден";
		ПодтверждениеПоСМС = Истина;
		ОтключитьОбработчикОжидания("ТаймерОтправкиСМС");
		НадписьПовторитьОтправку = "";
		Элементы.ПодтвердитьСМСКод.ЦветТекста = WebЦвета.Зеленый;
	Иначе
		Элементы.ПодтвердитьСМСКод.Заголовок = "Подтвердить";
		ПодтверждениеПоСМС = Ложь;
		Элементы.ПодтвердитьСМСКод.ЦветТекста = Новый Цвет();
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура КодСтраныПриИзменении(Элемент)
	
	СтруктураМаски = maxma_ИнтеграцияССервисомВызовСервера.ПолучитьМаскуНомераТелефона(КодСтраны);
	
	Элементы.КодТелефона.Маска 		   = СтруктураМаски.КодТелефона;
	Элементы.НомерТелефонаЧасть1.Маска = СтруктураМаски.НомерТелефонаЧасть1;
	Элементы.НомерТелефонаЧасть2.Маска = СтруктураМаски.НомерТелефонаЧасть2;
	Элементы.НомерТелефонаЧасть3.Маска = СтруктураМаски.НомерТелефонаЧасть3;
	
КонецПроцедуры

&НаКлиенте
Процедура РежимПоискаКартыПриИзменении(Элемент)
	КомандаСтереть(Неопределено);
	УстановитьФокусВвода();
КонецПроцедуры

&НаКлиенте
Процедура КодТелефонаИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	
