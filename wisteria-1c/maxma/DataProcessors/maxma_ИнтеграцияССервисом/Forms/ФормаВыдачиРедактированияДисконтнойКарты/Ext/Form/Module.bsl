		ТекущийЭлемент = Элементы.НомерТелефонаЧасть1;
	КонецЕсли; 
	
	АктивироватьКнопкуОтправитьСМС(); 
	
КонецПроцедуры

&НаКлиенте
Процедура НомерТелефонаЧасть1ИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	
	Если СтрДлина(СокрЛП(Текст)) = СтрДлина(СтруктураМаски.НомерТелефонаЧасть1) Тогда
		ТекущийЭлемент = Элементы.НомерТелефонаЧасть2;
	КонецЕсли;
	
	АктивироватьКнопкуОтправитьСМС();
	
КонецПроцедуры

&НаКлиенте
Процедура НомерТелефонаЧасть2ИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	
	Если СтрДлина(СокрЛП(Текст)) = СтрДлина(СтруктураМаски.НомерТелефонаЧасть2) Тогда
		ТекущийЭлемент = Элементы.НомерТелефонаЧасть3;
	КонецЕсли;
	
	АктивироватьКнопкуОтправитьСМС();
	
КонецПроцедуры

&НаКлиенте
Процедура КодСтраныИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	АктивироватьКнопкуОтправитьСМС();
КонецПроцедуры

&НаКлиенте
Процедура НомерТелефонаЧасть3ПриИзменении(Элемент)
	АктивироватьКнопкуОтправитьСМС();
КонецПроцедуры

&НаКлиенте
Процедура НомерТелефонаЧасть3ОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	АктивироватьКнопкуОтправитьСМС();
КонецПроцедуры

