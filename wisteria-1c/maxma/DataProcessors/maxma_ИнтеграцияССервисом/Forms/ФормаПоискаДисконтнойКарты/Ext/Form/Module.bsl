
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраница1;
	Элементы.СтраницыВвода.ТекущаяСтраница = Элементы.СтраницаВводимоеЧисло;
	
	ТекущийЭлемент = Элементы.ПолеВводимоеЧисло;
	
	ОбщегоНазначенияИСПереопределяемый.НастроитьПодключаемоеОборудование(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	КодСтраны = "7";
	РежимПоискаКарты = 1;
	
	КомандаСтереть(Неопределено);
	УстановитьФокусВвода();
	
	maxma_ИнтеграцияССервисомКлиент.УстановитьМаскуНомераТелефона(ЭтаФорма);
	
	// ПодключаемоеОборудование
	ОповещенияПриПодключении = Новый ОписаниеОповещения("ПодключитьОборудованиеЗавершение", ЭтотОбъект);
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(ОповещенияПриПодключении, ЭтотОбъект, "СканерШтрихкода, СчитывательМагнитныхКарт");
	// Конец ПодключаемоеОборудование
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	// ПодключаемоеОборудование
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(Неопределено, ЭтотОбъект);
	// Конец ПодключаемоеОборудование

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = "ПодключаемоеОборудование"
		И ВводДоступен() Тогда
		Если ИмяСобытия = "TracksData" Тогда
			ВводимоеЧисло = Параметр[0];
		ИначеЕсли ИмяСобытия = "ScanData" Тогда
			Если Параметр[1] = Неопределено Тогда
				ВводимоеЧисло = Параметр[0];
			Иначе
				ВводимоеЧисло = Параметр[1][1];
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если ВводДоступен() Тогда
		
		ОписаниеСобытия = Новый Структура;
		ОписаниеСобытия.Вставить("Источник", Источник);
		ОписаниеСобытия.Вставить("Событие",  Событие);
		ОписаниеСобытия.Вставить("Данные",   Данные);
		
		ОписаниеОшибки  = "";
		
		Результат = МенеджерОборудованияКлиент.ПолучитьСобытиеОтУстройства(ОписаниеСобытия, ОписаниеОшибки);  
		
		Если Результат = Неопределено Тогда 
			ЗаголовокСообщения = НСтр("ru = 'При обработке внешнего события от устройства произошла ошибка:'");
			Сообщить(ЗаголовокСообщения);
		Иначе
			ОбработкаОповещения(Результат.ИмяСобытия, Результат.Параметр, Результат.Источник);
		КонецЕсли;
		
	Иначе
		ОписаниеОшибки  = "Ошибка. Ввод не доступен";
		ЗаголовокСообщения = НСтр("ru = 'При обработке внешнего события от устройства произошла ошибка:'");
		Сообщить(ЗаголовокСообщения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура КодСтраныПриИзменении(Элемент)
	
	СтруктураМаски = maxma_ИнтеграцияССервисомВызовСервера.ПолучитьМаскуНомераТелефона(КодСтраны);
	
	Элементы.КодТелефона.Маска         = СтруктураМаски.КодТелефона;
	Элементы.НомерТелефонаЧасть1.Маска = СтруктураМаски.НомерТелефонаЧасть1;
	Элементы.НомерТелефонаЧасть2.Маска = СтруктураМаски.НомерТелефонаЧасть2;
	Элементы.НомерТелефонаЧасть3.Маска = СтруктураМаски.НомерТелефонаЧасть3;
	
КонецПроцедуры

#КонецОбласти

