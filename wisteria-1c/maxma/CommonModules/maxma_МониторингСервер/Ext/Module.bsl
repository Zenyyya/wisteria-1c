#Область ПрограммныйИнтерфейс

Процедура ОтправитьВТелеграм(Текст) Экспорт
	
	ТокенБота = "8686371955:AAG1B-8XBD-G_2LLCP2Lb-lRmKjbESdIqdg"; // Токен вашего бота
	IDЧата    = "-5372104530"; // ID чата/группы
	
	Если Не ЗначениеЗаполнено(ТокенБота) Или Не ЗначениеЗаполнено(IDЧата) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Тело = Новый Структура;
		Тело.Вставить("chat_id",    IDЧата);
		Тело.Вставить("text",       Текст);
		Тело.Вставить("parse_mode", "Markdown");
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Тело);
		ТелоЗапроса = ЗаписьJSON.Закрыть();
		
		Заг = Новый Соответствие;
		Заг.Вставить("Content-Type", "application/json");
		
		ssl        = Новый ЗащищенноеСоединениеOpenSSL();
		Соединение = Новый HTTPСоединение("api.telegram.org",,,,, 10, ssl);
		Запрос     = Новый HTTPЗапрос("/bot" + ТокенБота + "/sendMessage", Заг);
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8",
			ИспользованиеByteOrderMark.НеИспользовать);
		
		Соединение.ОтправитьДляОбработки(Запрос);
		
	Исключение
		// Молча игнорируем — не мешаем основному процессу
	КонецПопытки;
	
КонецПроцедуры

Процедура СформироватьИОтправить(ТипЗапроса, ТекстОшибки, ПустойОтвет = Ложь) Экспорт
	
	Если ПустойОтвет Тогда
		Заголовок = "⚠️ *Пустой ответ MAXMA*";
	Иначе
		Заголовок = " *Ошибка интеграции MAXMA*";
	КонецЕсли;
	
	Текст = Заголовок + Символы.ПС
		+ "Метод: `" + ТипЗапроса + "`" + Символы.ПС
		+ "Время: " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy ЧЧ:мм:сс") + Символы.ПС
		+ "Сервер: " + ИмяКомпьютера() + Символы.ПС
		+ "─────────────────" + Символы.ПС
		+ ТекстОшибки;
	
	ОтправитьВТелеграм(Текст);
	
КонецПроцедуры

#КонецОбласти