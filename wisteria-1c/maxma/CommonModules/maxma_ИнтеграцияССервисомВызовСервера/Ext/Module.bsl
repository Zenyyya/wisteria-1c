Функция ПолучитьФИО(ЗначИмя, ЗначФамилия, ЗначОтчество) Экспорт
	
	МассивПодстрок = Новый Массив;
	
	Если ЗначениеЗаполнено(ЗначИмя) Тогда
		МассивПодстрок.Добавить(ЗначИмя);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначОтчество) Тогда
		МассивПодстрок.Добавить(ЗначОтчество);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначФамилия) Тогда
		МассивПодстрок.Добавить(ЗначФамилия);
	КонецЕсли;
	
	ФИО = СтрСоединить(МассивПодстрок, " ");
	
	Возврат ФИО;
	
