#Область ПроцедурыФункцииРаботыСПроцессингом

Функция ОтветСервера(ПараметрыЗапроса, ТипЗапроса, НастройкиМодуля) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьОшибки",    Истина);
	Результат.Вставить("Данные",        Неопределено);
	Результат.Вставить("СетеваяОшибка", Ложь);
	Результат.Вставить("ТекстОшибки",   "");
	Результат.Вставить("КодОшибки",     0);
	
	ТекстЗапросаHTTP = ТекстЗапросаHTTP(ПараметрыЗапроса);
	
	ПараметрыHTTPЗапроса = ПараметрыHTTPЗапроса(ТипЗапроса, ТекстЗапросаHTTP, НастройкиМодуля);
	
	Попытка
		
		ОтветСервера = ОтветОтПроцессинга(ПараметрыHTTPЗапроса);
		
		Если ОтветСервера.КодСостояния = 200 Тогда
			
			Результат.Данные = ДанныеОтвета(ОтветСервера);
			Результат.ЕстьОшибки = Результат.Данные.Свойство("errorCode");
			
			Если Результат.ЕстьОшибки Тогда
				Результат.ТекстОшибки = ТекстОшибкиПроцессинга(Результат.Данные);
				Результат.КодОшибки = Результат.Данные.errorCode;
			КонецЕсли;
			
		Иначе
			Результат.ТекстОшибки = ТекстОшибкиПоКодуСостоянияОтветаСервера(ОтветСервера.КодСостояния);
		КонецЕсли;
		
	Исключение
		Результат.СетеваяОшибка = Истина;
		Результат.ТекстОшибки   = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	//Евгений Отправка ошибки в ТГ
	Если Результат.ЕстьОшибки Тогда
		maxma_МониторингСервер.СформироватьИОтправить(
        ТипЗапроса,
        "Ошибка: " + Результат.ТекстОшибки + Символы.ПС
        + "─────────────────" + Символы.ПС
        + "Запрос: " + ТекстЗапросаHTTP,
        Ложь);
	ИначеЕсли Результат.Данные = Неопределено Тогда
	    maxma_МониторингСервер.СформироватьИОтправить(
	        ТипЗапроса,
	        "Пустой ответ сервера" + Символы.ПС
	        + "─────────────────" + Символы.ПС
	        + "Запрос: " + ТекстЗапросаHTTP,
	        Истина);
	КонецЕсли;

	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьДанныеКлиента(ОтветСервера) Экспорт
	
	Если Не ОтветСервера.СетеваяОшибка И ОтветСервера.Данные.Свойство("client") Тогда
		
		Если Не ОтветСервера.Данные.client.Свойство("cardString") Тогда
			ОтветСервера.Данные.client.Вставить("cardString", "");
		КонецЕсли;
		
		Если Не ОтветСервера.Данные.client.Свойство("phoneNumber") Тогда
			ОтветСервера.Данные.client.Вставить("phoneNumber", "");
		КонецЕсли;
		
		Если Не ОтветСервера.Данные.client.Свойство("email") Тогда
			ОтветСервера.Данные.client.Вставить("email", "");
		КонецЕсли;
		
		Если Не ОтветСервера.Данные.client.Свойство("birthdate") Тогда
			ОтветСервера.Данные.client.Вставить("birthdate", Дата(1, 1, 1));
		КонецЕсли;
		
		Если Не ОтветСервера.Данные.client.Свойство("gender") Тогда
			ОтветСервера.Данные.client.Вставить("gender", "");
		КонецЕсли;
		
		Если Не ОтветСервера.Данные.client.Свойство("name") Тогда
			ОтветСервера.Данные.client.Вставить("name", "");
		КонецЕсли;
		
		Если Не ОтветСервера.Данные.client.Свойство("surname") Тогда
			ОтветСервера.Данные.client.Вставить("surname", "");
		КонецЕсли;
		
		Если Не ОтветСервера.Данные.client.Свойство("patronymicName") Тогда
			ОтветСервера.Данные.client.Вставить("patronymicName", "");
		КонецЕсли;
		
		Если Не ОтветСервера.Данные.client.Свойство("fullName") Тогда
			ОтветСервера.Данные.client.Вставить("fullName", "");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

