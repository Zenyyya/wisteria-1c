Функция НайтиОбновитьКонтактноеЛицоВ1С(РеквизитыНовые, РеквизитыСтарые = Неопределено) Экспорт
	
	ОписаниеНовойКонтактнойИнформацииТелефон = УправлениеКонтактнойИнформацией.ОписаниеНовойКонтактнойИнформации(Перечисления.ТипыКонтактнойИнформации.Телефон);
	
	Если ЗначениеЗаполнено(РеквизитыНовые.КодТелефона) Тогда
		
		ОписаниеНовойКонтактнойИнформацииТелефон.countryCode = РеквизитыНовые.КодСтраны;
		ОписаниеНовойКонтактнойИнформацииТелефон.areaCode 	 = РеквизитыНовые.КодТелефона;
		ОписаниеНовойКонтактнойИнформацииТелефон.number 	 = РеквизитыНовые.НомерТелефонаЧасть1 + РеквизитыНовые.НомерТелефонаЧасть2 + РеквизитыНовые.НомерТелефонаЧасть3;
		ОписаниеНовойКонтактнойИнформацииТелефон.value 	  	 = ПредставлениеТелефона(ОписаниеНовойКонтактнойИнформацииТелефон);
		
		МобильныйТелефонНовыйJSON = УправлениеКонтактнойИнформациейСлужебный.СтруктураВСтрокуJSON(ОписаниеНовойКонтактнойИнформацииТелефон);
		МобильныйТелефонНовый 	  = ОписаниеНовойКонтактнойИнформацииТелефон.value;
		
	Иначе
		
		МобильныйТелефонНовыйJSON = "";
		МобильныйТелефонНовый	  = "";
		
	КонецЕсли;

	ФИОНовое 		= РеквизитыНовые.ФИО;
	ПолНовый 		= ?(РеквизитыНовые.Пол = 2, Перечисления.ПолФизическогоЛица.Женский, Перечисления.ПолФизическогоЛица.Мужской);
	НомерКартыНовый = РеквизитыНовые.НомерКарты;
	EmailНовый		= РеквизитыНовые.Email;
	
	Если ЗначениеЗаполнено(РеквизитыНовые.ДатаРождения) Тогда
		
		Если ТипЗнч(РеквизитыНовые.ДатаРождения) = Тип("Строка") Тогда 
			ДатаРожденияНовая = XMLЗначение(Тип("Дата"), РеквизитыНовые.ДатаРождения);
		Иначе
			ДатаРожденияНовая = РеквизитыНовые.ДатаРождения;
		КонецЕсли;
		
	Иначе
		ДатаРожденияНовая = Дата(1, 1, 1);
	КонецЕсли;

	Если РеквизитыСтарые = Неопределено Тогда
		
		РеквизитыСтарые 	   = Новый Структура("ФИО, МобильныйТелефон, НомерКарты, Email, ДатаРождения, Пол", "", "", "", "", "", "");
		МобильныйТелефонСтарый = МобильныйТелефонНовый;
		ФИОСтарое			   = ФИОНовое;
		ДатаРожденияСтарая	   = ДатаРожденияНовая;
		НомерКартыСтарый	   = НомерКартыНовый;
		EmailСтарый			   = EmailНовый;
		
	Иначе
		
		Если ЗначениеЗаполнено(РеквизитыСтарые.КодСтраны) Тогда
			
			ОписаниеНовойКонтактнойИнформацииТелефон.countryCode = РеквизитыСтарые.КодСтраны;
			ОписаниеНовойКонтактнойИнформацииТелефон.areaCode 	 = РеквизитыСтарые.КодТелефона;
			ОписаниеНовойКонтактнойИнформацииТелефон.number 	 = РеквизитыСтарые.НомерТелефонаЧасть1 + РеквизитыСтарые.НомерТелефонаЧасть2 + РеквизитыСтарые.НомерТелефонаЧасть3;
			
			МобильныйТелефонСтарый = ПредставлениеТелефона(ОписаниеНовойКонтактнойИнформацииТелефон);
			
		Иначе
			МобильныйТелефонСтарый = "";
		КонецЕсли;
	
		ФИОСтарое		   = РеквизитыСтарые.ФИО;
		ДатаРожденияСтарая = РеквизитыСтарые.ДатаРождения;
		НомерКартыСтарый   = РеквизитыСтарые.НомерКарты;
		EmailСтарый		   = РеквизитыСтарые.Email;
		
	КонецЕсли;
	
	ОбновлятьКонтактноеЛицо = Ложь;
	СоздаватьКонтактноеЛицо = Ложь;
	
	Если ЗначениеЗаполнено(МобильныйТелефонСтарый) Тогда
		КонтактноеЛицоСсылка = ПолучитьКонтактноеЛицоПоНомеруТелефона(МобильныйТелефонСтарый);
	ИначеЕсли ЗначениеЗаполнено(НомерКартыСтарый) Тогда
		КонтактноеЛицоСсылка = ПолучитьКонтактноеЛицоПоНомеруКарты(НомерКартыСтарый);
	Иначе
		КонтактноеЛицоСсылка = Справочники.Контрагенты.СоздатьЭлемент();
	КонецЕсли;
	
	ИменаРеквизитовКонтактногоЛица = "Наименование, ПометкаУдаления";
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ДатаРождения", КонтактноеЛицоСсылка.Метаданные()) Тогда
		ИменаРеквизитовКонтактногоЛица = ИменаРеквизитовКонтактногоЛица + ", ДатаРождения";
	КонецЕсли;

	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Пол", КонтактноеЛицоСсылка.Метаданные()) Тогда
		ИменаРеквизитовКонтактногоЛица = ИменаРеквизитовКонтактногоЛица + ", Пол";
	КонецЕсли;
	
	РеквизитыКонтактногоЛица = Новый Структура;
	
	Если Не КонтактноеЛицоСсылка.Ссылка.Пустая() Тогда
		
		РеквизитыКонтактногоЛица = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КонтактноеЛицоСсылка, ИменаРеквизитовКонтактногоЛица);
		
		Если РеквизитыКонтактногоЛица.Свойство("Пол") И Не РеквизитыКонтактногоЛица.Пол = ПолНовый Тогда
			ОбновлятьКонтактноеЛицо = Истина;	
		КонецЕсли;
		
		Если Не МобильныйТелефонСтарый = МобильныйТелефонНовый Тогда
			ОбновлятьКонтактноеЛицо = Истина;	
		КонецЕсли;
		
		Если Не НомерКартыСтарый = НомерКартыНовый Тогда
			ОбновлятьКонтактноеЛицо = Истина;	
		КонецЕсли;
		
		Если Не РеквизитыСтарые.Email = РеквизитыНовые.Email Тогда
			ОбновлятьКонтактноеЛицо = Истина;	
		КонецЕсли;
		
		Если РеквизитыКонтактногоЛица.Свойство("ДатаРождения") Тогда
			
			Если Не (РеквизитыКонтактногоЛица.Наименование = ФИОНовое И День(РеквизитыКонтактногоЛица.ДатаРождения) = День(ДатаРожденияНовая) 
				И Месяц(РеквизитыКонтактногоЛица.ДатаРождения) = Месяц(ДатаРожденияНовая))
				Или РеквизитыКонтактногоЛица.ПометкаУдаления Тогда
				ОбновлятьКонтактноеЛицо = Истина;
			КонецЕсли;
			
		Иначе
			
			Если Не РеквизитыКонтактногоЛица.Наименование = ФИОНовое
				Или РеквизитыКонтактногоЛица.ПометкаУдаления Тогда
				ОбновлятьКонтактноеЛицо = Истина;
			КонецЕсли;
		
		КонецЕсли;
		
	Иначе
		
		КонтактноеЛицоСсылка = Справочники.Контрагенты.НайтиПоНаименованию(ФИОСтарое, Истина);
		
		Если Не КонтактноеЛицоСсылка.Пустая() Тогда
			
			Если Не МобильныйТелефонСтарый = МобильныйТелефонНовый Тогда
				ОбновлятьКонтактноеЛицо = Истина;	
			КонецЕсли;
			
			Если Не НомерКартыСтарый = НомерКартыНовый Тогда
				ОбновлятьКонтактноеЛицо = Истина;	
			КонецЕсли;
			
			Если Не РеквизитыСтарые.Email = РеквизитыНовые.Email Тогда
				ОбновлятьКонтактноеЛицо = Истина;	
			КонецЕсли;

			РеквизитыКонтактногоЛица = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КонтактноеЛицоСсылка, ИменаРеквизитовКонтактногоЛица);
			
			Если РеквизитыКонтактногоЛица.Свойство("ДатаРождения") Тогда
				
				Если День(РеквизитыКонтактногоЛица.ДатаРождения) = День(ДатаРожденияСтарая) И Месяц(РеквизитыКонтактногоЛица.ДатаРождения) = Месяц(ДатаРожденияСтарая) Тогда
					
					Если РеквизитыКонтактногоЛица.Свойство("Пол") И Не РеквизитыКонтактногоЛица.Пол = ПолНовый Тогда
						ОбновлятьКонтактноеЛицо = Истина;	
					КонецЕсли;
					
					Если Не (День(РеквизитыКонтактногоЛица.ДатаРождения) = День(ДатаРожденияНовая)
						И Месяц(РеквизитыКонтактногоЛица.ДатаРождения) = Месяц(ДатаРожденияНовая))
						Или РеквизитыКонтактногоЛица.ПометкаУдаления Тогда
						ОбновлятьКонтактноеЛицо = Истина;
					КонецЕсли;
					
				Иначе
					СоздаватьКонтактноеЛицо = Истина;
				КонецЕсли;
				
			Иначе
				
				Если (РеквизитыКонтактногоЛица.Свойство("Пол") И Не РеквизитыКонтактногоЛица.Пол = ПолНовый)
					Или РеквизитыКонтактногоЛица.ПометкаУдаления Тогда
					ОбновлятьКонтактноеЛицо = Истина;	
				КонецЕсли;
				
			КонецЕсли;

		Иначе
			РеквизитыКонтактногоЛица = Новый Структура(ИменаРеквизитовКонтактногоЛица);
			СоздаватьКонтактноеЛицо  = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СоздаватьКонтактноеЛицо ИЛИ ОбновлятьКонтактноеЛицо Тогда
		
		Если СоздаватьКонтактноеЛицо Тогда
			
			КонтактноеЛицоОбъект = Справочники.Контрагенты.СоздатьЭлемент();
			
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ДатаСоздания", КонтактноеЛицоСсылка.Метаданные()) Тогда
				КонтактноеЛицоОбъект.ДатаСоздания = ТекущаяДата();
			КонецЕсли;
			
		ИначеЕсли ОбновлятьКонтактноеЛицо Тогда
			КонтактноеЛицоОбъект = КонтактноеЛицоСсылка.ПолучитьОбъект();
		КонецЕсли;
		
		КонтактноеЛицоОбъект.Наименование = ФИОНовое;
		КонтактноеЛицоОбъект.Покупатель = Истина;
		КонтактноеЛицоОбъект.ПометкаУдаления = Ложь;
		КонтактноеЛицоОбъект.ОбменДанными.Загрузка = Истина;
		КонтактноеЛицоОбъект.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
		КонтактноеЛицоОбъект.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ФизическоеЛицо;
		
		Если РеквизитыКонтактногоЛица.Свойство("ДатаРождения") Тогда
			КонтактноеЛицоОбъект.ДатаРождения = ДатаРожденияНовая;
		КонецЕсли;
		
		Если РеквизитыКонтактногоЛица.Свойство("Пол") Тогда
			КонтактноеЛицоОбъект.Пол = ПолНовый;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(КонтактноеЛицоОбъект.Код) Тогда
			КонтактноеЛицоОбъект.УстановитьНовыйКод();
		КонецЕсли;
		
		ВидКИТелефон = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
		ВидКИПочта   = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
		
		Если ЗначениеЗаполнено(МобильныйТелефонСтарый) Тогда
			
			НайденныеСтроки = КонтактноеЛицоОбъект.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид, Тип, Представление", ВидКИТелефон, Перечисления.ТипыКонтактнойИнформации.Телефон, МобильныйТелефонСтарый));
			
			Для Каждого СтрокаТЧ Из НайденныеСтроки Цикл
				КонтактноеЛицоОбъект.КонтактнаяИнформация.Удалить(СтрокаТЧ);
			КонецЦикла;
			
		КонецЕсли;
		
		УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(КонтактноеЛицоОбъект, МобильныйТелефонНовыйJSON, 
		ВидКИТелефон, Перечисления.ТипыКонтактнойИнформации.Телефон);
		
		ОписаниеНовойКонтактнойИнформации 		= УправлениеКонтактнойИнформацией.ОписаниеНовойКонтактнойИнформации(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
		ОписаниеНовойКонтактнойИнформации.value = EmailНовый;
		
		ОбъектКИJSON = УправлениеКонтактнойИнформациейСлужебный.СтруктураВСтрокуJSON(ОписаниеНовойКонтактнойИнформации);
		
		Если ЗначениеЗаполнено(РеквизитыНовые.Email) Тогда
			
			НайденныеСтроки = КонтактноеЛицоОбъект.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид, Тип, Представление", ВидКИПочта, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты, EmailСтарый));
			
			Для Каждого СтрокаТЧ Из НайденныеСтроки Цикл
				КонтактноеЛицоОбъект.КонтактнаяИнформация.Удалить(СтрокаТЧ);
			КонецЦикла;
			
		КонецЕсли;
	
		УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(КонтактноеЛицоОбъект,
			ОбъектКИJSON, ВидКИПочта, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
		
		КонтактноеЛицоОбъект.Записать();
		
		КонтактноеЛицоСсылка = КонтактноеЛицоОбъект.Ссылка;
		
	КонецЕсли;
	
	Возврат КонтактноеЛицоСсылка;
	
КонецФункции

Функция НайтиОбновитьИнформационнуюКартуВ1С(ВладелецКартыСсылка, НомерКарты) Экспорт
	
	ОбновлятьКарту = Ложь;
	ВладелецКартыНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВладелецКартыСсылка, "Наименование");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВладелецКарты", ВладелецКартыСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДисконтныеКарты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДисконтныеКарты КАК ДисконтныеКарты
	|ГДЕ
	|	ДисконтныеКарты.ВладелецКарты = &ВладелецКарты";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		ИнформационнаяКартаСсылка = Выборка.Ссылка;
		
		ИменаРеквизитов = "ВладелецКарты, Наименование, КодКартыШтрихкод, ПометкаУдаления";
		РеквизитыКарты  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИнформационнаяКартаСсылка, ИменаРеквизитов);
		
		Если Не (РеквизитыКарты.ВладелецКарты = ВладелецКартыСсылка И РеквизитыКарты.Наименование = ВладелецКартыНаименование
			И РеквизитыКарты.КодКартыШтрихкод = НомерКарты)
			Или РеквизитыКарты.ПометкаУдаления = Истина Тогда
			ОбновлятьКарту = Истина;
			ИнформационнаяКартаОбъект = ИнформационнаяКартаСсылка.ПолучитьОбъект();
		КонецЕсли;
		
	Иначе
		ОбновлятьКарту = Истина;
		ИнформационнаяКартаОбъект = Справочники.ДисконтныеКарты.СоздатьЭлемент();
	КонецЕсли;
	
	Если ОбновлятьКарту Тогда
		
		ИнформационнаяКартаОбъект.Владелец				= ВидДисконтнойКарты();
		ИнформационнаяКартаОбъект.Наименование  	 	= ВладелецКартыНаименование;
		ИнформационнаяКартаОбъект.ВладелецКарты 	 	= ВладелецКартыСсылка;
		ИнформационнаяКартаОбъект.КодКартыШтрихкод      = НомерКарты;
		ИнформационнаяКартаОбъект.ПометкаУдаления		= Ложь;
		ИнформационнаяКартаОбъект.ОбменДанными.Загрузка = Истина;
		
		Если Не ЗначениеЗаполнено(ИнформационнаяКартаОбъект.Код) Тогда
			ИнформационнаяКартаОбъект.УстановитьНовыйКод();
		КонецЕсли;
		
		ИнформационнаяКартаОбъект.Записать();
		
		ИнформационнаяКартаСсылка = ИнформационнаяКартаОбъект.Ссылка;
		
	КонецЕсли;
	
	Возврат ИнформационнаяКартаСсылка;
	
КонецФункции

Функция ПредставлениеТелефона(ДанныеТелефон)
	
	Если ТипЗнч(ДанныеТелефон) = Тип("Структура") Тогда
		
		ПредставлениеТелефона = УправлениеКонтактнойИнформациейКлиентСервер.СформироватьПредставлениеТелефона(
			СократитьНеЦифры(ДанныеТелефон.countryCode),
			ДанныеТелефон.areaCode,
			ДанныеТелефон.number,
			ДанныеТелефон.extNumber,
			"");
			
	Иначе
		
		ПредставлениеТелефона = УправлениеКонтактнойИнформациейКлиентСервер.СформироватьПредставлениеТелефона(
			СократитьНеЦифры(ДанныеТелефон.КодСтраны), 
			ДанныеТелефон.КодГорода,
			ДанныеТелефон.Номер,
			ДанныеТелефон.Добавочный,
			"");
		
	КонецЕсли;
	
	Возврат ПредставлениеТелефона;
	
КонецФункции

Функция ПолучитьКонтактноеЛицоПоНомеруТелефона(НомерТелефона) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);
	Запрос.УстановитьПараметр("НомерТелефона", НомерТелефона);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтактнаяИнформация.Ссылка КАК Ссылка,
	|	КонтактнаяИнформация.Тип КАК Тип,
	|	КонтактнаяИнформация.Вид КАК Вид,
	|	КонтактнаяИнформация.Представление КАК Представление
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Тип = &Тип
	|	И КонтактнаяИнформация.Вид = &Вид
	|	И КонтактнаяИнформация.Представление ПОДОБНО &НомерТелефона";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции

