Функция ПолучитьЗначениеНастройки(Объект, НаименованиеНастройки, ЗначениеПоУмолчанию = Неопределено)
	
	Если ПустаяСтрока(НаименованиеНастройки) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	НастройкаСсылка = НайтиНастройку(НаименованиеНастройки);
	Если НЕ ЗначениеЗаполнено(НастройкаСсылка) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект",   Объект);
	Запрос.УстановитьПараметр("Свойство", НастройкаСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДополнительныеСведения.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Объект = &Объект
	|	И ДополнительныеСведения.Свойство = &Свойство";	
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Если Выборка.Значение = Неопределено Тогда
			Возврат ЗначениеПоУмолчанию;
		Иначе
			Возврат Выборка.Значение;
		КонецЕсли;
		
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
КонецФункции

Функция НайтиНастройку(НаименованиеНастройки, ПроверятьУникальность = Ложь)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения ГДЕ Наименование = &НаименованиеСвойства");
	Запрос.УстановитьПараметр("НаименованиеСвойства", "maxma_" + НаименованиеНастройки);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Если ПроверятьУникальность И Выборка.Количество() = 2 Тогда
			Возврат "СвойствоНеУникально";
		Иначе
			
			Выборка.Следующий();			
			Возврат Выборка.Ссылка;
			
		КонецЕсли;
			
	КонецЕсли;
	
КонецФункции

Процедура ЗаписатьПараметрыПродажи(ДокументСсылка, ПараметрыПродажи)
	
	НенайденныеНастройки = ПроверитьНаличиеНастроек(ПараметрыПродажи);
	СоздатьНастройки(НенайденныеНастройки);
	
	Для Каждого КлючИЗначение Из ПараметрыПродажи Цикл
		УстановитьЗначениеНастройки(ДокументСсылка, КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьЗначениеНастройки(Объект, НаименованиеНастройки, ЗначениеНастройки) Экспорт
	
	Если ПустаяСтрока(НаименованиеНастройки) Или Не ЗначениеЗаполнено(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	Настройка = НайтиНастройку(НаименованиеНастройки);
	
	Если Не ЗначениеЗаполнено(Настройка) Тогда
		
		Если Не ЗначениеЗаполнено(ЗначениеНастройки) Тогда
			Возврат;
		КонецЕсли;
		
		ВызватьИсключение "Запись свойства объекта: """ + НаименованиеНастройки + """ невозможна. Свойство не создано";
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(Объект);
	НаборЗаписей.Отбор.Свойство.Установить(Настройка);
	
	НаборЗаписей.Прочитать();
	
	ЗаписыватьНабор = Ложь;
	
	Если НаборЗаписей.Количество() Тогда
		
		Для Каждого Запись Из НаборЗаписей Цикл
			
			Если Запись.Значение = ЗначениеНастройки Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаписыватьНабор = Истина;
			Запись.Значение = ЗначениеНастройки;
			
		КонецЦикла;
		
	Иначе
		ЗаписыватьНабор = Истина;
		Запись          = НаборЗаписей.Добавить();
		Запись.Объект   = Объект;
		Запись.Свойство = Настройка;
		Запись.Значение = ЗначениеНастройки;
	КонецЕсли;
	
	Если ЗаписыватьНабор Тогда
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры

