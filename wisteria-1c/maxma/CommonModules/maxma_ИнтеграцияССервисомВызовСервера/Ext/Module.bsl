Функция НужноОткрытьФормуУказанияКодаКарты(Товары, ПодарочныеКарты, Номенклатура) Экспорт
	
	Результат = Ложь;
	
	Номенклатура_ПодарочныеКарты = ПолучитьМассивПодарочныхКарт();

	Если Номенклатура_ПодарочныеКарты.Найти(Номенклатура) <> Неопределено Тогда
		
		ТаблицаТоваров = Товары.Выгрузить(Новый Структура("Номенклатура", Номенклатура));
		
		НайденныеСтроки = ПодарочныеКарты.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
		
		Если ТаблицаТоваров.Итог("КоличествоУпаковок") > НайденныеСтроки.Количество() Тогда
			Результат = Истина;	
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НужноОткрытьФормуУказанияКодаКартыПослеОбработкиШтрихкода(ПараметрыОбработкиШтрихкодов, ФормаДокумента) Экспорт
	
	Если ПараметрыОбработкиШтрихкодов.ТекущаяСтрока <> Неопределено Тогда
		
		ТекущиеДанные = ФормаДокумента.Объект.Товары.НайтиПоИдентификатору(ПараметрыОбработкиШтрихкодов.ТекущаяСтрока);
		
		Возврат ПолучитьМассивПодарочныхКарт().Найти(ТекущиеДанные.Номенклатура) <> Неопределено;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьМассивПодарочныхКарт() Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Набор.Ссылка КАК Ссылка
	|ИЗ
	|	(ВЫБРАТЬ
	|		Номенклатура.Ссылка КАК Ссылка
	|	ИЗ
	|		Справочник.Номенклатура КАК Номенклатура
	|	ГДЕ
	|		Номенклатура.Код ПОДОБНО &Шаблон
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Номенклатура.Ссылка
	|	ИЗ
	|		Справочник.Номенклатура КАК Номенклатура
	|	ГДЕ
	|		Номенклатура.Артикул ПОДОБНО &Шаблон
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Номенклатура.Ссылка
	|	ИЗ
	|		Справочник.Номенклатура КАК Номенклатура
	|	ГДЕ
	|		Номенклатура.Наименование ПОДОБНО &ШаблонНаименования1
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Номенклатура.Ссылка
	|	ИЗ
	|		Справочник.Номенклатура КАК Номенклатура
	|	ГДЕ
	|		Номенклатура.Наименование ПОДОБНО &ШаблонНаименования2) КАК Набор";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Запрос.УстановитьПараметр("Шаблон", 			 "MXGC%");
	Запрос.УстановитьПараметр("ШаблонНаименования1", "%Подарочная карта MX%");
	Запрос.УстановитьПараметр("ШаблонНаименования2", "%Подарочный сертификат MX%");
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ОбработатьКодПодарочнойКартыНаСервере(ВходящиеПараметры, НастройкиОбмена) Экспорт
	
	ПараметрыКарты = Новый Структура;
	ПараметрыКарты.Вставить("sku",  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВходящиеПараметры.Номенклатура, "Артикул"));
	ПараметрыКарты.Вставить("code", ВходящиеПараметры.КодКарты);
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("txid", 	  ВходящиеПараметры.ИдентификаторПродажи);
	ПараметрыЗапроса.Вставить("giftCard", ПараметрыКарты);
	
	ОтветСервера = ОтветСервера(ПараметрыЗапроса, МетодActiveGiftCard(), НастройкиОбмена);
	
	ТекстИнформации = "";
	ДанныеКарты 	= Неопределено;
	
	Если ОтветСервера.ЕстьОшибки И ОтветСервера.Свойство("ТекстОшибки", ТекстИнформации) Тогда
		ЗаписатьДанныеВЖурналРегистрации(ТекстИнформации, УровеньЖурналаРегистрации.Ошибка);		
	Иначе
		
		Если ОтветСервера.Данные.Свойство("giftCard") Тогда
			
			ДанныеКарты 			 = Новый Структура("Номенклатура, СекретныйКод, НомерКарты, Номинал, СрокДействия");
			ДанныеКарты.Номенклатура = ВходящиеПараметры.Номенклатура;
			ДанныеКарты.СекретныйКод = ВходящиеПараметры.КодКарты; 
			
			ОтветСервера.Данные.giftCard.Свойство("number",     ДанныеКарты.НомерКарты);
			ОтветСервера.Данные.giftCard.Свойство("initAmount", ДанныеКарты.Номинал);
			ОтветСервера.Данные.giftCard.Свойство("validUntil", ДанныеКарты.СрокДействия);
			
		КонецЕсли;
		
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ЕстьОшибки", 	 ОтветСервера.ЕстьОшибки);
	Результат.Вставить("ОписаниеОшибки", ТекстИнформации);
	Результат.Вставить("ДанныеКарты", 	 ДанныеКарты);
	
	Возврат Результат;
	
КонецФункции

Функция ДеактивироватьПодарочнуюКартуНаСервере(ВходящиеПараметры, НастройкиОбмена) Экспорт
	
	ПараметрыКарты = Новый Структура;
	ПараметрыКарты.Вставить("sku",  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВходящиеПараметры.Номенклатура, "Артикул"));
	ПараметрыКарты.Вставить("code", ВходящиеПараметры.КодКарты);
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("txid", 	  ВходящиеПараметры.ИдентификаторПродажи);
	ПараметрыЗапроса.Вставить("giftCard", ПараметрыКарты);
	
	ОтветСервера = ОтветСервера(ПараметрыЗапроса, МетодDiscardGiftCard(), НастройкиОбмена);
	
	ТекстИнформации = "";
	ДанныеКарты = Неопределено;
	Если ОтветСервера.ЕстьОшибки И ОтветСервера.Свойство("ТекстОшибки", ТекстИнформации) Тогда
		ЗаписатьДанныеВЖурналРегистрации(ТекстИнформации, УровеньЖурналаРегистрации.Ошибка);		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьОшибки", 	 ОтветСервера.ЕстьОшибки);
	Результат.Вставить("ОписаниеОшибки", ТекстИнформации);
	Результат.Вставить("ДанныеКарты", 	 ДанныеКарты);
	
	Возврат Результат;
	
КонецФункции

