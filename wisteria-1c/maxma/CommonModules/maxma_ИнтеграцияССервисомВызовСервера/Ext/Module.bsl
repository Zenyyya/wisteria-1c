Функция ПолучитьНастройкиМодуля(Магазин) Экспорт
	
	НастройкиМодуля = Новый Структура;
	НастройкиМодуля.Вставить("XProcessingKey",                              ПолучитьЗначениеНастройки(Магазин, "XProcessingKey", ""));
	НастройкиМодуля.Вставить("АдресСервера",                                ПолучитьЗначениеНастройки(Магазин, "АдресСервера", "api.maxma.com"));
	НастройкиМодуля.Вставить("ВыдачаЗаменаКарты_ОбязательныеПоляХранилище", ПолучитьЗначениеНастройки(Магазин, "ВыдачаЗаменаКарты_ОбязательныеПоляХранилище", ""));
	НастройкиМодуля.Вставить("ДисконтнаяКартаИдентификатор",                ПолучитьЗначениеНастройки(Магазин, "ДисконтнаяКартаИдентификатор", ""));
	НастройкиМодуля.Вставить("ДублироватьКлиентовВ1С",                      ПолучитьЗначениеНастройки(Магазин, "ДублироватьКлиентовВ1С", Ложь));
	НастройкиМодуля.Вставить("ИспользоватьПрограммыЛояльности",             ПолучитьЗначениеНастройки(Магазин, "ИспользоватьПрограммыЛояльности", Ложь));
	НастройкиМодуля.Вставить("Магазин",                                     Магазин);
	НастройкиМодуля.Вставить("ПодтверждатьСписаниеБалловПоСМС",             ПолучитьЗначениеНастройки(Магазин, "ПодтверждатьСписаниеБалловПоСМС", Ложь));
	
	Возврат НастройкиМодуля;
	
КонецФункции

Функция ПроверитьНаличиеНастроек(НастройкиМодуля) Экспорт
	
	НенайденныеНастройки = Новый Массив;
	
	Для каждого ОписаниеНастройки Из НастройкиМодуля цикл 
		Если НайтиНастройку(ОписаниеНастройки.Ключ) = Неопределено Тогда
			НенайденныеНастройки.Добавить(ОписаниеНастройки.ключ);
		КонецЕсли;
	КонецЦикла;
	
	Возврат НенайденныеНастройки;
	
КонецФункции

Функция СоздатьНастройки(МассивНастроек) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СозданныеНастройки = Новый Массив;
	
	Для каждого НаименованиеНастройки Из МассивНастроек Цикл
		
		Настройка = НайтиНастройку(НаименованиеНастройки);
		
		Если Не ЗначениеЗаполнено(Настройка) Тогда
			
			НастройкаОбъект = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
			НастройкаОбъект.Наименование = "maxma_" + НаименованиеНастройки;
			НастройкаОбъект.Заголовок    = НастройкаОбъект.Наименование;
			НастройкаОбъект.ТипЗначения  = ПолучитьТипЗначенияПоСвойству(НаименованиеНастройки);
			
			НастройкаОбъект.УстановитьНовыйКод();
			
			НастройкаОбъект.Записать();
			
			СозданныеНастройки.Добавить(НаименованиеНастройки);
		
		ИначеЕсли Настройка.ПометкаУдаления Тогда
			
			НастройкаОбъект = Настройка.ПолучитьОбъект();
			НастройкаОбъект.Заголовок   = НастройкаОбъект.Наименование;
			НастройкаОбъект.ТипЗначения = ПолучитьТипЗначенияПоСвойству(НаименованиеНастройки);
			НастройкаОбъект.УстановитьПометкуУдаления(Ложь);
		
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СозданныеНастройки;
	
КонецФункции

