Процедура ДобавитьТовары(ПараметрыРассчета, Товары)
	
	МассивТоваров = Новый Массив;
	
	Для каждого СтрокаТЧ Из Товары Цикл
		
		ПараметрыСтрокиТЧ = Новый Структура;
		ПараметрыТовара   = Новый Структура;
		
		РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТЧ.Номенклатура, "Артикул, Наименование, Родитель");
		
		Артикул = РеквизитыНоменклатуры.Артикул;
		
		Если Не ЗначениеЗаполнено(Артикул) Тогда
			Артикул = XMLСтрока(СтрокаТЧ.Номенклатура);
		КонецЕсли;
		
		ПараметрыТовара.Вставить("externalId", XMLСтрока(СтрокаТЧ.Номенклатура));
		ПараметрыТовара.Вставить("sku", Артикул);
		ПараметрыТовара.Вставить("title", РеквизитыНоменклатуры.Наименование);
		
		Если ЗначениеЗаполнено(РеквизитыНоменклатуры.Родитель) Тогда
			ПараметрыТовара.Вставить("categoryExternalId", XMLСтрока(РеквизитыНоменклатуры.Родитель));
			ПараметрыТовара.Вставить("category", Строка(РеквизитыНоменклатуры.Родитель));
		КонецЕсли;
		
		ПараметрыТовара.Вставить("blackPrice", СтрокаТЧ.Цена);
		ПараметрыТовара.Вставить("vatPercent", ПолучитьСтавкуНДС(СтрокаТЧ.СтавкаНДС));
		
		ПараметрыСтрокиТЧ.Вставить("product", ПараметрыТовара);
		ПараметрыСтрокиТЧ.Вставить("qty", СтрокаТЧ.Количество);
		ПараметрыСтрокиТЧ.Вставить("autoDiscount", СтрокаТЧ.СуммаАвтоматическойСкидки);
		ПараметрыСтрокиТЧ.Вставить("manualDiscount", СтрокаТЧ.СуммаСкидкиНаценки);
		
		МассивТоваров.Добавить(ПараметрыСтрокиТЧ);
		
	КонецЦикла;
	
	ПараметрыРассчета.Вставить("rows", МассивТоваров);
	
КонецПроцедуры

