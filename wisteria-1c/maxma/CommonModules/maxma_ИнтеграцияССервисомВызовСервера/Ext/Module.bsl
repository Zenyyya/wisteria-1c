Функция ОтветОтПроцессинга(ПараметрыHTTPЗапроса)
	
	ssl = Новый ЗащищенноеСоединениеOpenSSL(); 
	
	Соединение = Новый HTTPСоединение(ПараметрыHTTPЗапроса.АдресСервера,,,,, 30, ssl);
	
	Запрос = Новый HTTPЗапрос(ПараметрыHTTPЗапроса.Метод, ПараметрыHTTPЗапроса.Заголовки);
	Запрос.УстановитьТелоИзСтроки(ПараметрыHTTPЗапроса.ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Соединение.ОтправитьДляОбработки(Запрос);
	
КонецФункции

