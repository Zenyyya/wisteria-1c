Функция ТекстОшибкиПроцессинга(ДанныеПроцессинга)
	
	Результат = "";
	
	Если ДанныеПроцессинга.Свойство("description") Тогда
		Результат = ДанныеПроцессинга.description;
	КонецЕсли;
	
	Если ДанныеПроцессинга.Свойство("hint") Тогда
		Расшифровка = ДанныеПроцессинга.hint;
		Результат = ?(Результат = "", Расшифровка, Результат + Символы.ПС + Расшифровка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстОшибкиПоКодуСостоянияОтветаСервера(КодСостояния)
	
	Если КодСостояния = 403 Тогда
		
		ТекстОшибки = "Ключ аутентификации не передан или некорректен.";
		
	ИначеЕсли КодСостояния = 404 Тогда
		
		ТекстОшибки = "Неверный адрес для отправки запроса.";
		
	ИначеЕсли КодСостояния = 405 Тогда
		
		ТекстОшибки = "Неверный тип запроса (например, GET вместо POST).";
		
	ИначеЕсли КодСостояния = 429 Тогда
		
		ТекстОшибки = "Превышена допустимая частота запросов.";
		
	ИначеЕсли КодСостояния = 429 Тогда
		
		ТекстОшибки = "Сервер не выполнил запрос из-за внутренней ошибки.";
		
	Иначе
		
		ТекстОшибки = "Код состояния ответа HTTP запроса " + КодСостояния;
		
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

