#Область ПереопределениеПечатиЧека

Процедура ДобавитьДанныеДляПечатиЧека(maxma_СтруктураПолей, ДанныеДляПробитияЧека) Экспорт
	
	Если Не maxma_ИнтеграцияССервисомКлиентСервер.ИспользоватьПрограммуЛояльности(maxma_СтруктураПолей) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПродажи = maxma_СтруктураПолей.ПараметрыПродажи;
	СтруктураБаллов  = maxma_СтруктураПолей.СтруктураБаллов;
	
	Если ЗначениеЗаполнено(ПараметрыПродажи.КодКартыНомерТелефона) И СтруктураБаллов.receiptInfo.Количество() Тогда
		
		НовыйНефискальныйДокумент = Новый Структура;
		НовыйНефискальныйДокумент.Вставить("ПозицииЧека", Новый Массив);
		
		Для Каждого ПараметрыПечатиБонусов Из СтруктураБаллов.receiptInfo Цикл
			
			Если ПараметрыПечатиБонусов.Значение.type = "text" Тогда
				СтрокаПозицииЧека = ПараметрыТекстовойСтрокиЧека(ПараметрыПечатиБонусов.Значение.text.value);
				СтрокаПозицииЧека.Выравнивание = ВыравниваниеТекста(ПараметрыПечатиБонусов.Значение.text.align);
			ИначеЕсли ПараметрыПечатиБонусов.Значение.type = "table" Тогда
				СтрокаПозицииЧека = ПараметрыТекстовойСтрокиЧека(ПараметрыПечатиБонусов.Значение.table.left + ": " + ПараметрыПечатиБонусов.Значение.table.right);
			ИначеЕсли ПараметрыПечатиБонусов.Значение.type = "divider" Тогда
				Разделитель = ПостроитьПоле("", 32, "*");
				СтрокаПозицииЧека = ПараметрыТекстовойСтрокиЧека(Разделитель);
			Иначе
				Продолжить;
			КонецЕсли;
			
			НовыйНефискальныйДокумент.ПозицииЧека.Добавить(СтрокаПозицииЧека);
			
		КонецЦикла;
		
		ДанныеДляПробитияЧека.НефискальныеДокументы.Добавить(НовыйНефискальныйДокумент.ПозицииЧека);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПостроитьПоле(Знач Текст, Знач ДлинаПоля, ДобСимвол = "", ДобавлятьСправа = Истина)
	
	ДобСимвол = ?(ПустаяСтрока(ДобСимвол), " ", ДобСимвол);
	
	ТекстПолный = Лев(Текст, ДлинаПоля);
	Пока СтрДлина(ТекстПолный) < ДлинаПоля Цикл
		Если ДобавлятьСправа Тогда
			ТекстПолный = ТекстПолный + ДобСимвол;
		Иначе
			ТекстПолный = ДобСимвол + ТекстПолный;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТекстПолный;
	
КонецФункции

Функция ПараметрыТекстовойСтрокиЧека(Текст = Неопределено)
	
	ПараметрыСтроки = Новый Структура;
	
	ПараметрыСтроки.Вставить("ТекстоваяСтрока");       // Тип строки. Исходящий служебный параметр. 
	ПараметрыСтроки.Вставить("Текст", Текст);          // Строка,Обязательно   - Текстовая строка
	ПараметрыСтроки.Вставить("ПереносСтроки", Ложь);   // Булево,Необязательно - Перенос строки, устанавливается значение по умолчанию.  
	ПараметрыСтроки.Вставить("Выравнивание" , "Лево"); // Строка,Необязательно - Выравнивание текста, Значения: "Лево", "Право", "Центр".
	
	Возврат ПараметрыСтроки; 
	
КонецФункции

Функция ВыравниваниеТекста(ВыравниваниеEng)
	
	ВыравниваниеRu = "Лево";
	
	Если ВыравниваниеEng = "left" Тогда
		ВыравниваниеRu = "Лево";
	ИначеЕсли ВыравниваниеEng = "center" Тогда
		ВыравниваниеRu = "Центр";
	ИначеЕсли ВыравниваниеEng = "right" Тогда
		ВыравниваниеRu = "Право";
	КонецЕсли;
	
	Возврат ВыравниваниеRu;
	
КонецФункции

#КонецОбласти
