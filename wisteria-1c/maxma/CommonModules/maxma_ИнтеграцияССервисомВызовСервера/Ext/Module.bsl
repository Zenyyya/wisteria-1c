КонецФункции

Функция СократитьНеЦифры(Текст, ДопустимоКромеЦифр = "", Направление = Истина)
	
	Длина = СтрДлина(Текст);
	Если Направление Тогда
		// Сокращение слева
		Индекс = 1;
		Конец  = 1 + Длина;
		Шаг    = 1;
	Иначе
		// Сокращение справа    
		Индекс = Длина;
		Конец  = 0;
		Шаг    = -1;
	КонецЕсли;
	
	Пока Индекс <> Конец Цикл
		Символ = Сред(Текст, Индекс, 1);
		ЭтоЦифра = (Символ >= "0" И Символ <= "9") Или СтрНайти(ДопустимоКромеЦифр, Символ) = 0;
		Если ЭтоЦифра Тогда
			Прервать;
		КонецЕсли;
		Индекс = Индекс + Шаг;
	КонецЦикла;
	
	Если Направление Тогда
		// Сокращение слева
		Возврат Прав(Текст, Длина - Индекс + 1);
	КонецЕсли;
	
	// Сокращение справа
	Возврат Лев(Текст, Индекс);
	
КонецФункции

Процедура ПриЗаписиЧекККМ(ДокументСсылка, ВходящиеПараметры, Отказ)
	
	Если ВходящиеПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не maxma_ИнтеграцияССервисомКлиентСервер.ИспользоватьПрограммуЛояльности(ВходящиеПараметры) Тогда
		Возврат;
	КонецЕсли;
	
	ПодтвердитьПродажу(ДокументСсылка, ВходящиеПараметры, Отказ);
	
	ЗафиксироватьСостояниеДокумента(ДокументСсылка, ВходящиеПараметры.ПараметрыПродажи);
	
КонецПроцедуры

Процедура ПриЗаписиЧекККМВозврат(ДокументСсылка, ВходящиеПараметры)
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "СтруктурнаяЕдиница, ЧекККМ");
	
	ИнициализироватьПоля(ВходящиеПараметры, РеквизитыДокумента.СтруктурнаяЕдиница, РеквизитыДокумента.ЧекККМ);
	
	Если Не maxma_ИнтеграцияССервисомКлиентСервер.ИспользоватьПрограммуЛояльности(ВходящиеПараметры) Тогда
		Возврат;
	КонецЕсли;
	
	ВозвратПодтвержден = ПолучитьЗначениеНастройки(ДокументСсылка, "ПродажаПодтверждена", Ложь);
	
	Если ВходящиеПараметры.ПараметрыПродажи.ПродажаПодтверждена И Не ВозвратПодтвержден Тогда
		
		Результат = ВозвратВыполнен(ВходящиеПараметры, ДокументСсылка);
		
		УстановитьЗначениеНастройки(ДокументСсылка, "ПродажаПодтверждена", Результат);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодтвердитьПродажу(ДокументСсылка, ВходящиеПараметры, Отказ)
	
	ПараметрыПродажи = ВходящиеПараметры.ПараметрыПродажи;
	
	Если ПараметрыПродажи.ПродажаПодтверждена Тогда
		Возврат;
	КонецЕсли;
	
	Статус = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Статус");
	
	Если Статус = Перечисления.СтатусыЧековККМ.Пробит Тогда
		ПараметрыПродажи.ПродажаПодтверждена = ПродажаПодтверждена(ВходящиеПараметры, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗафиксироватьСостояниеДокумента(ДокументСсылка, ПараметрыПродажи)
	
	ПараметрыПродажиДляЗаписи = Новый Структура;
	
	ЗаполнитьПараметрыПродажиДляЗаписи(ПараметрыПродажиДляЗаписи, ПараметрыПродажи);
	
	ЗаписатьПараметрыПродажи(ДокументСсылка, ПараметрыПродажиДляЗаписи);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыПродажиДляЗаписи(ПараметрыПродажиДляЗаписи, ПараметрыПродажи)
	
	ПараметрыПродажиДляЗаписи.Вставить("ticket", ПараметрыПродажи.ticket);
	ПараметрыПродажиДляЗаписи.Вставить("ИдентификаторПродажи", ПараметрыПродажи.ИдентификаторПродажи);
	ПараметрыПродажиДляЗаписи.Вставить("ПродажаПодтверждена", ПараметрыПродажи.ПродажаПодтверждена);
	
КонецПроцедуры

Функция ПустыеПараметрыРасчета()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Акции", Новый Массив);
	Результат.Вставить("Скидки", Новый Массив);
	
