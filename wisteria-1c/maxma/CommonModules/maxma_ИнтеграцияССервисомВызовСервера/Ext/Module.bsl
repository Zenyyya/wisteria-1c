
#Область СлужебныйПрограммныйИнтерфейс

Процедура ПриСозданииНаСервере(Форма) Экспорт
	
	ИнициализироватьПоля(Форма.Объект.maxma_СтруктураПолей, Форма.Объект.ТорговыйОбъект);
	
	ПереопределитьЭлементыФормы(Форма);
	
	Если maxma_ИнтеграцияССервисомКлиентСервер.ИспользоватьПрограммуЛояльности(Форма.Объект.maxma_СтруктураПолей) Тогда
		
		РежимПоискаКарты      = Форма.Объект.maxma_СтруктураПолей.ПараметрыПродажи.РежимПоискаКарты;
		КодКартыНомерТелефона = Форма.Объект.maxma_СтруктураПолей.ПараметрыПродажи.КодКартыНомерТелефона;
		
		Если ЗначениеЗаполнено(КодКартыНомерТелефона) Тогда
			
			ДанныеКлиента = ДанныеКлиента(
				РежимПоискаКарты,
				КодКартыНомерТелефона,
				"",
				Форма.Объект.maxma_СтруктураПолей.НастройкиМодуля,
				Форма.Объект.maxma_СтруктураПолей.СообщенияПользователю);
			
			Если ДанныеКлиента.КартаНайдена Тогда
				
				РезультатПоискаКарты = Новый Структура;
				РезультатПоискаКарты.Вставить("РежимПоиска",       РежимПоискаКарты);
				РезультатПоискаКарты.Вставить("НомерКартыТелефон", КодКартыНомерТелефона);
				РезультатПоискаКарты.Вставить("Клиент",            ДанныеКлиента.Клиент);
				РезультатПоискаКарты.Вставить("ДисконтнаяКарта",   ДанныеКлиента.ДисконтнаяКарта);
				
				ОбработатьСчитываниеКарты(РезультатПоискаКарты, Форма.Объект.maxma_СтруктураПолей);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализироватьПоля(ВходящиеПараметры, Магазин, Ссылка = Неопределено) Экспорт
	
	Если ВходящиеПараметры = Неопределено Тогда
		ВходящиеПараметры = Новый Структура("НастройкиМодуля,
		| ПараметрыПродажи,
		| ПараметрыРасчета,
		| СтруктураБаллов,
		| СтруктураСкидок,
		| СообщенияПользователю");
	КонецЕсли;
	
	ВходящиеПараметры.НастройкиМодуля       = ПолучитьНастройкиМодуля(Магазин);
	ВходящиеПараметры.ПараметрыПродажи      = ПараметрыПродажи(Ссылка);
	ВходящиеПараметры.ПараметрыРасчета      = ПустыеПараметрыРасчета();
	ВходящиеПараметры.СтруктураБаллов       = СтруктураБаллов(ВходящиеПараметры.ПараметрыПродажи);
	ВходящиеПараметры.СтруктураСкидок       = СтруктураСкидок();
	ВходящиеПараметры.СообщенияПользователю = ПолучитьСтруктуруВыводимойВРМКИнформации();
	
КонецПроцедуры

Процедура ПриЗаписи(ДокументСсылка, ВходящиеПараметры, Отказ = Ложь) Экспорт
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.ЧекККМ") Тогда
		
		ПриЗаписиЧекККМ(ДокументСсылка, ВходящиеПараметры, Отказ);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЧекККМВозврат") Тогда
		
		ПриЗаписиЧекККМВозврат(ДокументСсылка, ВходящиеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьСчитываниеКарты(РезультатПоискаКарты = Неопределено, СтруктураПолей) Экспорт
	
	ЗаполнитьСтруктуруБаллов(РезультатПоискаКарты, СтруктураПолей);
	ЗаполнитьПараметрыПродажи(РезультатПоискаКарты, СтруктураПолей);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПереопределитьЭлементыФормы(Форма)
	
	ГруппаОперации = Форма.Элементы.Найти("maxma_ГруппаОперации");
	
	Если ГруппаОперации <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Форма.Элементы.ВвестиДанныеПокупателя.Видимость = Ложь;
	
	ЭлементРодитель = Форма.Элементы.ГруппаКнопокЛояльности;
	
	ГруппаОперации = Форма.Элементы.Вставить("maxma_ГруппаОперации", Тип("ГруппаФормы"), ЭлементРодитель);
	ГруппаОперации.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОперации.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаОперации.Заголовок = "Операции MAXMA";
	ГруппаОперации.ШрифтЗаголовка = Новый Шрифт("Шрифт диалогов и меню", 16, Истина);
	
	НадписьКарта = Форма.Элементы.Вставить("maxma_НадписьБонуснаяКарта", Тип("ДекорацияФормы"), ГруппаОперации);
	НадписьКарта.Вид = ВидДекорацииФормы.Надпись;
	НадписьКарта.РастягиватьПоГоризонтали = Истина;
	НадписьКарта.АвтоМаксимальнаяШирина = Ложь;
	НадписьКарта.АвтоМаксимальнаяВысота = Ложь;
	НадписьКарта.Заголовок = НСтр("ru = 'Бонусная карта: не предъявлена'");
	НадписьКарта.ЦветТекста = WebЦвета.Красный;
	НадписьКарта.Шрифт = Новый Шрифт("Шрифт диалогов и меню", 12, Истина);
	
	НадписьДоступно = Форма.Элементы.Вставить("maxma_НадписьДоступно", Тип("ДекорацияФормы"), ГруппаОперации);
	НадписьДоступно.Вид = ВидДекорацииФормы.Надпись;
	НадписьДоступно.РастягиватьПоГоризонтали = Истина;
	НадписьДоступно.АвтоМаксимальнаяШирина = Ложь;
	НадписьДоступно.АвтоМаксимальнаяВысота = Ложь;
	НадписьДоступно.Заголовок = "";
	НадписьДоступно.ЦветТекста = WebЦвета.Зеленый;
	НадписьДоступно.Шрифт = Новый Шрифт("Шрифт диалогов и меню", 12, Истина);
	
	НадписьДоступноДляОплаты = Форма.Элементы.Вставить("maxma_НадписьДоступноДляОплаты", Тип("ДекорацияФормы"), ГруппаОперации);
	НадписьДоступноДляОплаты.Вид = ВидДекорацииФормы.Надпись;
	НадписьДоступноДляОплаты.РастягиватьПоГоризонтали = Истина;
	НадписьДоступноДляОплаты.АвтоМаксимальнаяШирина = Ложь;
	НадписьДоступноДляОплаты.АвтоМаксимальнаяВысота = Ложь;
	НадписьДоступноДляОплаты.Заголовок = "";
	НадписьДоступноДляОплаты.ЦветТекста = WebЦвета.Зеленый;
	НадписьДоступноДляОплаты.Шрифт = Новый Шрифт("Шрифт диалогов и меню", 12, Истина);
	
	НадписьНачислено = Форма.Элементы.Вставить("maxma_НадписьНачислено", Тип("ДекорацияФормы"), ГруппаОперации);
	НадписьНачислено.Вид = ВидДекорацииФормы.Надпись;
	НадписьНачислено.РастягиватьПоГоризонтали = Истина;
	НадписьНачислено.АвтоМаксимальнаяШирина = Ложь;
	НадписьНачислено.АвтоМаксимальнаяВысота = Ложь;
	НадписьНачислено.Заголовок = "";
	НадписьНачислено.ЦветТекста = WebЦвета.Зеленый;
	НадписьНачислено.Шрифт = Новый Шрифт("Шрифт диалогов и меню", 12, Истина);
	
	ГруппаКомандыРяд1 = Форма.Элементы.Вставить("maxma_ГруппаКомандыРяд1", Тип("ГруппаФормы"), ГруппаОперации);
	ГруппаКомандыРяд1.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКомандыРяд1.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаКомандыРяд1.ОтображатьЗаголовок = Ложь;
	
	ДобавитьКоманду("БонуснаяКарта", "Бонусная карта", ГруппаКомандыРяд1, Форма);
	ДобавитьКоманду("ЗаменаКарты", "Замена карты", ГруппаКомандыРяд1, Форма);
	
	ГруппаКомандыРяд2 = Форма.Элементы.Вставить("maxma_ГруппаКомандыРяд2", Тип("ГруппаФормы"), ГруппаОперации);
	ГруппаКомандыРяд2.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКомандыРяд2.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаКомандыРяд2.ОтображатьЗаголовок = Ложь;
	
	ДобавитьКоманду("Промокод", "Промокод", ГруппаКомандыРяд2, Форма);
	ДобавитьКоманду("Бонусы", "Бонусы", ГруппаКомандыРяд2, Форма);
	
	ГруппаКомандыРяд3 = Форма.Элементы.Вставить("maxma_ГруппаКомандыРяд3", Тип("ГруппаФормы"), ГруппаОперации);
	ГруппаКомандыРяд3.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКомандыРяд3.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаКомандыРяд3.ОтображатьЗаголовок = Ложь;
	
	ДобавитьКоманду("ПодарочныеКарты", "Подарочные карты", ГруппаКомандыРяд3, Форма);
	
	ГруппаКомандыРяд4 = Форма.Элементы.Вставить("maxma_ГруппаКомандыРяд4", Тип("ГруппаФормы"), ГруппаОперации);
	ГруппаКомандыРяд4.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКомандыРяд4.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаКомандыРяд4.ОтображатьЗаголовок = Ложь;
	
	ДобавитьКоманду("ФормулаРасчета", "Скидки MAXMA", ГруппаКомандыРяд4, Форма);
	
	ГруппаОперации.Видимость = maxma_ИнтеграцияССервисомКлиентСервер.ИспользоватьПрограммуЛояльности(Форма.Объект.maxma_СтруктураПолей);
	
КонецПроцедуры

Процедура ДобавитьКоманду(Имя, Синоним, РодительЭлемента, Форма)
	
	ИмяКоманды  = "maxma_Команда" + Имя;
	ИмяЭлемента = "maxma_Элемент" + Имя;
	
	НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие  = ИмяКоманды;
	НоваяКоманда.Заголовок = Синоним;
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("КнопкаФормы"), РодительЭлемента);
	НовыйЭлемент.ИмяКоманды = ИмяКоманды;
	НовыйЭлемент.РастягиватьПоГоризонтали = Истина;
	
КонецПроцедуры

Функция ПараметрыПоискаКарты(РежимПоискаКарты, КодКартыТелефон)
	
	Если РежимПоискаКарты = "НомерТелефона" Тогда
		ИмяТэга = "phoneNumber";
	ИначеЕсли РежимПоискаКарты = "КодКарты" Тогда 
		ИмяТэга = "card";
	Иначе
		ВызватьИсключение "Данный поиск карты не поддерживается";
	КонецЕсли;
	
	ПараметрыПоискаКарты = Новый Структура;
	ПараметрыПоискаКарты.Вставить(ИмяТэга);
	
	ПараметрыПоискаКарты[ИмяТэга] = КодКартыТелефон;
	
	Возврат ПараметрыПоискаКарты;
	
КонецФункции

Процедура ВставитьДопПоляКлиента(РеквизитыКлиента, ДанныеКлиента)
	
	СогласиеНаОбработку = 0;
	Если ДанныеКлиента.Клиент.Свойство("extraFields") Тогда
		Если ДанныеКлиента.Клиент.extraFields.Свойство("Soglasie") Тогда
			СогласиеНаОбработку = ДанныеКлиента.Клиент.extraFields.Soglasie;
		КонецЕсли;
	КонецЕсли;
	РеквизитыКлиента.Вставить("СогласиеНаОбработку", СогласиеНаОбработку);
	
КонецПроцедуры

Процедура ЗаполнитьСтруктуруБаллов(РезультатПоискаКарты = Неопределено, СтруктураПолей)
	
	Если РезультатПоискаКарты = Неопределено Тогда
		СтруктураПолей.СтруктураБаллов  = ПустаяСтруктураБаллов();
	Иначе
		СтруктураПолей.СтруктураБаллов.Доступно = РезультатПоискаКарты.Клиент.bonuses;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыПродажи(РезультатПоискаКарты = Неопределено, СтруктураПолей)
	
	Если РезультатПоискаКарты = Неопределено Тогда
		СтруктураПолей.ПараметрыПродажи = ПустыеПараметрыПродажи();
		Возврат;
	КонецЕсли;
	
	ИнформацияОКлиенте = РезультатПоискаКарты.Клиент;
	
	Если ЗначениеЗаполнено(ИнформацияОКлиенте.phoneNumber) И РезультатПоискаКарты.Свойство("КодСтраны") Тогда
		СтруктураНомераТелефона = РаспарситьНомерТелефона(ИнформацияОКлиенте.phoneNumber, РезультатПоискаКарты.КодСтраны);
		СтруктураПолей.ПараметрыПродажи.СтруктураНомераТелефона = СтруктураНомераТелефона;
	КонецЕсли;
	
	ВладелецБонуснойКарты = ПолучитьФИО(ИнформацияОКлиенте.name, ИнформацияОКлиенте.surname, ИнформацияОКлиенте.patronymicName);
	
	СтруктураПолей.ПараметрыПродажи.ВладелецБонуснойКарты = ВладелецБонуснойКарты;
	СтруктураПолей.ПараметрыПродажи.БонусовДоступно       = ИнформацияОКлиенте.bonuses;
	СтруктураПолей.ПараметрыПродажи.РежимПоискаКарты      = РезультатПоискаКарты.РежимПоиска;
	СтруктураПолей.ПараметрыПродажи.КодКартыНомерТелефона = РезультатПоискаКарты.НомерКартыТелефон;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыПродажиПоДокументу(ПараметрыПродажи, ДокументСсылка)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект",  ДокументСсылка);
	Запрос.УстановитьПараметр("Префикс", "maxma_%");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДополнительныеСведения.Значение КАК Значение,
	|	ДополнительныеСведения.Свойство.Наименование КАК Ключ
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Объект = &Объект
	|	И ДополнительныеСведения.Свойство.Наименование ПОДОБНО &Префикс";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ПараметрыПродажи.Свойство(СтрЗаменить(Выборка.Ключ, "maxma_", "")) Тогда
			ПараметрыПродажи[СтрЗаменить(Выборка.Ключ, "maxma_", "")] = Выборка.Значение;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПараметрыПродажи(ДокументСсылка)
	
	ПараметрыПродажи = ПустыеПараметрыПродажи();
	
	Если ДокументСсылка <> Неопределено Тогда
		ЗаполнитьПараметрыПродажиПоДокументу(ПараметрыПродажи, ДокументСсылка);
	КонецЕсли;
	
	Возврат ПараметрыПродажи;
	
КонецФункции

Функция ПустыеПараметрыПродажи()
	
	ПараметрыПродажи = Новый Структура;
	
	ПараметрыПродажи.Вставить("РежимПоискаКарты",          "");
	ПараметрыПродажи.Вставить("КодКартыНомерТелефона",     "");
	ПараметрыПродажи.Вставить("ВладелецБонуснойКарты",     "");
	ПараметрыПродажи.Вставить("Промокод",                  "");
	ПараметрыПродажи.Вставить("ПромокодСкидка",            0);
	ПараметрыПродажи.Вставить("ИдентификаторПродажи",      Строка(Новый УникальныйИдентификатор()));
	ПараметрыПродажи.Вставить("ticket",                    "");
	ПараметрыПродажи.Вставить("ПродажаПодтверждена",       Ложь);
	ПараметрыПродажи.Вставить("АдресРассчитанныхСкидок",   "");
	ПараметрыПродажи.Вставить("БонусовНачислено",          0);
	ПараметрыПродажи.Вставить("БонусовСписано",            0);
	ПараметрыПродажи.Вставить("БонусовДоступно",           0);
	ПараметрыПродажи.Вставить("СтруктураБаллов",           ПустаяСтруктураБаллов());
	ПараметрыПродажи.Вставить("СтруктураНомераТелефона",   ПустаяСтруктураНомераТелефона());
	ПараметрыПродажи.Вставить("ОшибкаПримененияБонусов",   Ложь);
	ПараметрыПродажи.Вставить("КодОшибки",                 0);
	
	Возврат ПараметрыПродажи;
	
КонецФункции

Функция ПустаяСтруктураНомераТелефона()
	
	Результат = Новый Структура;
	
	Результат.Вставить("КодСтраны", "");
	Результат.Вставить("КодТелефона", "");
