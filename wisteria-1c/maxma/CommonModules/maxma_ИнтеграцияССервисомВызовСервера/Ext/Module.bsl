КонецФункции

#КонецОбласти

#Область ФункцииAPI

Функция ДанныеКлиента(РежимПоискаКарты, КодКартыТелефон, КодСтраны, НастройкиМодуля, СообщенияПользователю) Экспорт
	
	ПараметрыЗапроса = ПараметрыПоискаКарты(РежимПоискаКарты, КодКартыТелефон);
	
	ОтветСервера = ОтветСервера(ПараметрыЗапроса, МетодGetBalance(), НастройкиМодуля);
	
	ДанныеКлиента = Новый Структура;
	
	ТекстИнформации = "";
	
	Если ОтветСервера.ЕстьОшибки И ОтветСервера.Свойство("ТекстОшибки", ТекстИнформации) Тогда
		
		ДанныеКлиента.Вставить("КартаНайдена",    Ложь);
		ДанныеКлиента.Вставить("ДисконтнаяКарта", Справочники.ДисконтныеКарты.ПустаяСсылка());
		ДанныеКлиента.Вставить("СетеваяОшибка",   ОтветСервера.СетеваяОшибка);
		
		ЗаписатьДанныеВЖурналРегистрации(ТекстИнформации, УровеньЖурналаРегистрации.Ошибка);
		
		СообщенияПользователю.ТекстИнформации = ТекстИнформации;
		
	Иначе
		
		ДополнитьДанныеКлиента(ОтветСервера);
		
		ДанныеКлиента.Вставить("КартаНайдена",  Истина);
		ДанныеКлиента.Вставить("Клиент",        ОтветСервера.Данные.client);
		ДанныеКлиента.Вставить("СетеваяОшибка", ОтветСервера.СетеваяОшибка);
		
		//ВставитьДопПоляКлиента(РеквизитыКлиента, ДанныеКлиента);
		
		ДисконтнаяКартаСсылка = КартаЛояльности(ДанныеКлиента, КодСтраны, НастройкиМодуля, СообщенияПользователю);
		
		ДанныеКлиента.Вставить("ДисконтнаяКарта", ДисконтнаяКартаСсылка);
		
	КонецЕсли;
	
	ДанныеКлиента.Вставить("ТекстОшибки", ТекстИнформации);
	ДанныеКлиента.Вставить("КодОшибки", ОтветСервера.КодОшибки);
	
	Возврат ДанныеКлиента;
	
КонецФункции

Функция ПречекСоздан(ВходящиеПараметры, Документ) Экспорт
	
	Если Не НоменклатураЗаполнена(Документ.Товары) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыПродажи = ВходящиеПараметры.ПараметрыПродажи;
	
	ПараметрыРасчета = Новый Структура;
	
	ДобавитьБонусы(ПараметрыРасчета, ПараметрыПродажи.БонусовСписано);
	ДобавитьПромокод(ПараметрыРасчета, ПараметрыПродажи.Промокод);
	ДобавитьКлиента(ПараметрыРасчета, ПараметрыПродажи.РежимПоискаКарты, ПараметрыПродажи.КодКартыНомерТелефона);
	ДобавитьМагазин(ПараметрыРасчета, ВходящиеПараметры.НастройкиМодуля.Магазин);
	ДобавитьКассира(ПараметрыРасчета, Документ.Кассир);
	ДобавитьТовары(ПараметрыРасчета, Документ.Товары);
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("txid", ПараметрыПродажи.ИдентификаторПродажи);
	ПараметрыЗапроса.Вставить("calculationQuery", ПараметрыРасчета);
	
	ОтветСервера = ОтветСервера(ПараметрыЗапроса, МетодSetPurchase(), ВходящиеПараметры.НастройкиМодуля);
	
	ТекстИнформации = "";
	
	Если ОтветСервера.ЕстьОшибки И ОтветСервера.Свойство("ТекстОшибки", ТекстИнформации) Тогда
		
		Результат = Ложь;
		
		ЗаголовокИнформации = НСтр("ru = 'Не удалось создать пречек'");
		
		ЗаписатьДанныеВЖурналРегистрации(ТекстИнформации, УровеньЖурналаРегистрации.Ошибка);
		
		Если ОтветСервера.Данные.Свойство("errorCode") Тогда
			ПараметрыПродажи.КодОшибки = ОтветСервера.Данные.errorCode;
		КонецЕсли;
		
	Иначе
		
		Результат = Истина;
		ЗаголовокИнформации = "";
		
		ПараметрыПродажи.АдресРассчитанныхСкидок = ПоместитьВоВременноеХранилище(ОтветСервера.Данные.calculationResult.rows,
			Новый УникальныйИдентификатор);
		
		Если ОтветСервера.Данные.calculationResult.Свойство("promocode") Тогда
			
			ОтменитьОплатуПромокодом = (ОтветСервера.Данные.calculationResult.promocode.applied = 0);
			
			Если ОтменитьОплатуПромокодом Тогда
				
				ПараметрыПродажи.Промокод = "";
				ПараметрыПродажи.ПромокодСкидка = 0;
				
			КонецЕсли;
			
			Если ОтветСервера.Данные.calculationResult.promocode.Свойство("error") Тогда
				
				ЗаголовокИнформации = "Ошибка применения промокода:";
				ТекстИнформации = ОтветСервера.Данные.calculationResult.promocode.error.description;
				
			КонецЕсли; 
			
		КонецЕсли;
		
		Если ОтветСервера.Данные.calculationResult.Свойство("bonuses") Тогда
				
			Если ОтветСервера.Данные.calculationResult.bonuses.Свойство("error") Тогда
				
				ЗаголовокИнформации = ОтветСервера.Данные.calculationResult.bonuses.error.description;
				
				Если ОтветСервера.Данные.calculationResult.bonuses.error.Свойство("hint") Тогда
					ТекстИнформации = ОтветСервера.Данные.calculationResult.bonuses.error.hint;
				Иначе
					ТекстИнформации = ЗаголовокИнформации;
				КонецЕсли; 
				
				ПараметрыПродажи.ОшибкаПримененияБонусов = Истина;
				
			КонецЕсли;
			
			ВходящиеПараметры.СтруктураБаллов.ДоступноДляОплаты = ОтветСервера.Данные.calculationResult.bonuses.maxToApply;
			ВходящиеПараметры.СтруктураБаллов.Начислено         = ОтветСервера.Данные.calculationResult.bonuses.collected;
			ВходящиеПараметры.СтруктураБаллов.Списано           = ОтветСервера.Данные.calculationResult.bonuses.applied;
			ПараметрыПродажи.БонусовНачислено = ОтветСервера.Данные.calculationResult.bonuses.collected;
			ПараметрыПродажи.БонусовСписано   = ОтветСервера.Данные.calculationResult.bonuses.applied;
			
			Если ОтветСервера.Данные.Свойство("receiptInfo") Тогда
				ВходящиеПараметры.СтруктураБаллов.receiptInfo.ЗагрузитьЗначения(ОтветСервера.Данные.receiptInfo);
			КонецЕсли;
			
		КонецЕсли;
		
		ПараметрыПродажи.ticket = ОтветСервера.Данные.ticket;
		
	КонецЕсли;
	
	ВходящиеПараметры.СообщенияПользователю.ЗаголовокИнформации = ЗаголовокИнформации;
	ВходящиеПараметры.СообщенияПользователю.ТекстИнформации = ТекстИнформации;
	
	Возврат Результат;
	
КонецФункции

Функция ПродажаПодтверждена(ВходящиеПараметры, Отказ)
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("txid",   ВходящиеПараметры.ПараметрыПродажи.ИдентификаторПродажи);
	ПараметрыЗапроса.Вставить("ticket", ВходящиеПараметры.ПараметрыПродажи.ticket);
	
	ОтветСервера = ОтветСервера(ПараметрыЗапроса, МетодConfirmTicket(), ВходящиеПараметры.НастройкиМодуля);
	
	ТекстИнформации = "";
	Если ОтветСервера.ЕстьОшибки И ОтветСервера.Свойство("ТекстОшибки", ТекстИнформации) Тогда
		ЗаголовокИнформации = НСтр("ru = 'Не удалось подтвердить пречек'");
		ЗаписатьДанныеВЖурналРегистрации(ТекстИнформации, УровеньЖурналаРегистрации.Ошибка);
		Отказ = Истина;
		Результат = Ложь;
	Иначе
		ЗаголовокИнформации = "";
		Результат = Истина;
	КонецЕсли;
	
	ВходящиеПараметры.СообщенияПользователю.ЗаголовокИнформации = ЗаголовокИнформации;
	ВходящиеПараметры.СообщенияПользователю.ТекстИнформации = ТекстИнформации;
	
	Возврат Результат;
	
КонецФункции

Функция ВозвратВыполнен(ВходящиеПараметры, ДокументПродажи)
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПродажи, "Автор, ЧекККМ, Дата, СуммаДокумента");
	
	ПродажаПодтверждена = ПолучитьЗначениеНастройки(РеквизитыДокумента.ЧекККМ, "ПродажаПодтверждена", Ложь);
	
	Если Не ПродажаПодтверждена Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("id",           XMLСтрока(ДокументПродажи));
	ПараметрыЗапроса.Вставить("executedAt",   РеквизитыДокумента.Дата);
	ПараметрыЗапроса.Вставить("purchaseId",   ПолучитьЗначениеНастройки(РеквизитыДокумента.ЧекККМ, "ИдентификаторПродажи"));
	ПараметрыЗапроса.Вставить("shopCode",     XMLСтрока(ВходящиеПараметры.НастройкиМодуля.Магазин));
	ПараметрыЗапроса.Вставить("shopName",     Строка(ВходящиеПараметры.НастройкиМодуля.Магазин));
	ПараметрыЗапроса.Вставить("cashierId",    XMLСтрока(РеквизитыДокумента.Автор));
	ПараметрыЗапроса.Вставить("cashier",      Строка(РеквизитыДокумента.Автор));
	ПараметрыЗапроса.Вставить("refundAmount", РеквизитыДокумента.СуммаДокумента);
	
	МассивТоваров = Новый Массив;
	
	Для каждого СтрокаТЧ Из ДокументПродажи.Запасы Цикл
		
		Артикул = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.Номенклатура, "Артикул");
		
		Если Не ЗначениеЗаполнено(Артикул) Тогда
			Артикул = XMLСтрока(СтрокаТЧ.Номенклатура);
		КонецЕсли;
		
		ПараметрыТовара = Новый Структура;
		ПараметрыТовара.Вставить("sku", Артикул);
		ПараметрыТовара.Вставить("itemCount", СтрокаТЧ.Количество);
		
		МассивТоваров.Добавить(ПараметрыТовара);
		
	КонецЦикла;
	
	ПараметрыЗапроса.Вставить("items", МассивТоваров);
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("transaction", ПараметрыЗапроса);
	
	ОтветСервера = ОтветСервера(ПараметрыРасчета, МетодApplyReturn(), ВходящиеПараметры.НастройкиМодуля);
	
	ТекстИнформации = "";
	
	Если ОтветСервера.ЕстьОшибки И ОтветСервера.Свойство("ТекстОшибки", ТекстИнформации) Тогда
		
		ЗаписатьДанныеВЖурналРегистрации(ТекстИнформации, УровеньЖурналаРегистрации.Ошибка);
		
		ВходящиеПараметры.СообщенияПользователю.ЗаголовокИнформации = НСтр("ru = 'Не удалось выполнить возврат'");
		ВходящиеПараметры.СообщенияПользователю.ТекстИнформации = ТекстИнформации;
		
		Результат = Ложь;
		
	Иначе
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
