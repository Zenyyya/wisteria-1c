#Область ОбработчикиСобытийЭлементовТаблицыФормыЗапасы

&НаКлиенте
Процедура СписокЗапасыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.СписокЗапасы.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьВыборДействияАсинх(Поле, ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыполнитьВыборДействияАсинх(Поле, ДанныеСтроки)

	#Если МобильныйКлиент Тогда
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("ОткрытьКарточку", "Открыть карточку");
		Кнопки.Добавить("ДобавитьВКорзину", "Добавить в корзину");
		Кнопки.Добавить("УдалитьИзКорзины", "Удалить из корзины");
		Кнопки.Добавить("ПосмотретьДругиеРазмеры", "Посмотреть другие размеры");
		Кнопки.Добавить("Отмена", "Отмена");
		
		Ответ = Ждать ВопросАсинх("Выберите действие", Кнопки);
		
		Если Ответ = "ОткрытьКарточку" Тогда
			ОткрытьКарточкуТовара(ДанныеСтроки.Ссылка);
		ИначеЕсли Ответ = "ДобавитьВКорзину" Тогда
			ДобавитьТоварВКорзину(ДанныеСтроки);
			ПараметрыСписка = Новый Структура("ТоварыКорзины", ТоварыКорзины);
			УстановитьСвойстваСписка(ПараметрыСписка); 
		ИначеЕсли Ответ = "УдалитьИзКорзины" Тогда
			УдалитьТоварИзКорзины(ДанныеСтроки);
			ПараметрыСписка = Новый Структура("ТоварыКорзины", ТоварыКорзины);
			УстановитьСвойстваСписка(ПараметрыСписка);
		ИначеЕсли Ответ = "ПосмотретьДругиеРазмеры" Тогда
			ДобавитьВыбранныйТовар(ДанныеСтроки);
			ПараметрыСписка = Новый Структура("Номенклатура, спАртикулПоставщика", ДанныеСтроки.Ссылка, ЗначениеРеквизитаНаСервере(ДанныеСтроки.Ссылка, "спАртикулПоставщика"));
			УстановитьСвойстваСписка(ПараметрыСписка);
		Иначе
			Возврат;
		КонецЕсли;

	#Иначе 
		
		Если Поле.Имя = "Добавить" Тогда
			
			ДобавитьТоварВКорзину(ДанныеСтроки);
			
			ПараметрыСписка = Новый Структура("ТоварыКорзины", ТоварыКорзины);
			УстановитьСвойстваСписка(ПараметрыСписка);
			
		ИначеЕсли Поле.Имя = "Удалить" Тогда
			
			УдалитьТоварИзКорзины(ДанныеСтроки);
			
			ПараметрыСписка = Новый Структура("ТоварыКорзины", ТоварыКорзины);
			УстановитьСвойстваСписка(ПараметрыСписка);
			
		Иначе
			
			ОткрытьКарточкуТовара(ДанныеСтроки.Ссылка);
			
		КонецЕсли; 
		
	#КонецЕсли

	УправлениеСвойствамиЭлементовФормы();

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВыбранныйТовар(ДанныеСтроки)
	
	ДанныеВыбраннойНоменклатуры.Очистить();
	
	НоваяСтрока = ДанныеВыбраннойНоменклатуры.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДанныеВыбраннойНоменклатуры

&НаКлиенте
Процедура ДанныеВыбраннойНоменклатурыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.ДанныеВыбраннойНоменклатуры.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьВыборДействияВыбраннойНоменклатурыАсинх(Поле, ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыполнитьВыборДействияВыбраннойНоменклатурыАсинх(Поле, ДанныеСтроки)

	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("ОткрытьКарточку", "Открыть карточку");
	Кнопки.Добавить("ОтменитьВыбраннуюНоменклатуру", "Очистить выбранный товар");
	Кнопки.Добавить("Отмена", "Отмена");
	
	Ответ = Ждать ВопросАсинх("Выберите действие", Кнопки);
	
	Если Ответ = "ОткрытьКарточку" Тогда
		ОткрытьКарточкуТовара(ДанныеСтроки.Ссылка);
	ИначеЕсли Ответ = "ОтменитьВыбраннуюНоменклатуру" Тогда
		
		ТекСтрока = ДанныеСтроки.ПолучитьИдентификатор();
		УдаляемаяСтрока = ДанныеВыбраннойНоменклатуры.НайтиПоИдентификатору(ТекСтрока);
		ДанныеВыбраннойНоменклатуры.Удалить(УдаляемаяСтрока);
		
		ПараметрыСписка = Новый Структура("Номенклатура, спАртикулПоставщика", Неопределено, Неопределено);
		УстановитьСвойстваСписка(ПараметрыСписка);
		
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДанныеВыбраннойНоменклатурыПередУдалением(Элемент, Отказ)
	
	ПараметрыСписка = Новый Структура("Номенклатура, спАртикулПоставщика", Неопределено, Неопределено);
	УстановитьСвойстваСписка(ПараметрыСписка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКорзина

&НаКлиенте
Процедура КорзинаТаблицаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "КорзинаУдалить" Тогда
		
		СтандартнаяОбработка = Ложь;
	
		ТекущаяСтрока = Элементы.КорзинаТаблица.ТекущиеДанные;
		
		Если ТекущаяСтрока = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Идентификатор = ТекущаяСтрока.ПолучитьИдентификатор();
		УдаляемаяСтрока = Корзина.НайтиПоИдентификатору(Идентификатор);
		Корзина.Удалить(УдаляемаяСтрока);
		
		Индекс = ТоварыКорзины.Найти(ТекущаяСтрока.Ссылка);
		
		Если Индекс <> Неопределено Тогда
			ТоварыКорзины.Удалить(Индекс);
		КонецЕсли;    
		
		ПараметрыСписка = Новый Структура("ТоварыКорзины", ТоварыКорзины);
		УстановитьСвойстваСписка(ПараметрыСписка);
		
		УправлениеСвойствамиЭлементовФормы();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КорзинаТаблицаПередУдалением(Элемент, Отказ)
	
	ТекущаяСтрока = Элементы.КорзинаТаблица.ТекущиеДанные;
	
	Индекс = ТоварыКорзины.Найти(ТекущаяСтрока.Ссылка);
	
	Если Индекс <> Неопределено Тогда
		ТоварыКорзины.Удалить(Индекс);
	КонецЕсли;    
	
	ПараметрыСписка = Новый Структура("ТоварыКорзины", ТоварыКорзины);
	УстановитьСвойстваСписка(ПараметрыСписка);
	
КонецПроцедуры

&НаКлиенте
Процедура КорзинаТаблицаПослеУдаления(Элемент)
	
	УправлениеСвойствамиЭлементовФормы();
	
КонецПроцедуры
             
#КонецОбласти

