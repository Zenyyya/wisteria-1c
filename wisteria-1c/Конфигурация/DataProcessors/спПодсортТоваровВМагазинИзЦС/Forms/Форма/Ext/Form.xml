			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	СкладыМагазинов.Ссылка КАК СкладМагазина
ПОМЕСТИТЬ ВТ_СкладыМагазина
ИЗ
	Справочник.СтруктурныеЕдиницы КАК СкладыМагазинов
ГДЕ
	НЕ(СкладыМагазинов.ТипСтруктурнойЕдиницы &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ТипыСтруктурныхЕдиниц.Склад)
				И СкладыМагазинов.ТипСтруктурнойЕдиницы &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ТипыСтруктурныхЕдиниц.Розница))
	И СкладыМагазинов.Родитель = &amp;ГруппаСкладов

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СтруктурныеЕдиницы.Ссылка
ИЗ
	Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
ГДЕ
	СтруктурныеЕдиницы.Ссылка = &amp;Отправитель

ИНДЕКСИРОВАТЬ ПО
	СкладМагазина
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗапасыНаСкладахОстатки.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	ЗапасыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	СУММА(ЗапасыНаСкладахОстатки.КоличествоОстаток) КАК КоличествоОстаток,
	ЗапасыНаСкладахОстатки.Номенклатура.Артикул КАК НоменклатураАртикул,
	ЗапасыНаСкладахОстатки.Номенклатура.Штрихкод КАК НоменклатураШтрихкод
ПОМЕСТИТЬ ВТ_Остатки
ИЗ
	РегистрНакопления.ЗапасыНаСкладах.Остатки(
			&amp;Период,
			Организация = &amp;Организация
				И СтруктурнаяЕдиница В
					(ВЫБРАТЬ
						ВТ_СкладыМагазина.СкладМагазина КАК СкладМагазина
					ИЗ
						ВТ_СкладыМагазина КАК ВТ_СкладыМагазина)) КАК ЗапасыНаСкладахОстатки

СГРУППИРОВАТЬ ПО
	ЗапасыНаСкладахОстатки.Номенклатура,
	ЗапасыНаСкладахОстатки.Номенклатура.Артикул,
	ЗапасыНаСкладахОстатки.Номенклатура.Штрихкод,
	ЗапасыНаСкладахОстатки.СтруктурнаяЕдиница

ИНДЕКСИРОВАТЬ ПО
	Номенклатура,
	НоменклатураАртикул,
	НоменклатураШтрихкод
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Остатки.Номенклатура КАК Номенклатура,
	СУММА(ВТ_Остатки.КоличествоОстаток) КАК КоличествоОстаток,
	ВТ_Остатки.НоменклатураАртикул КАК НоменклатураАртикул,
	ВТ_Остатки.НоменклатураШтрихкод КАК НоменклатураШтрихкод
ПОМЕСТИТЬ ВТ_ОстаткиОтправителя
ИЗ
	ВТ_Остатки КАК ВТ_Остатки
ГДЕ
	ВТ_Остатки.СтруктурнаяЕдиница = &amp;Отправитель

СГРУППИРОВАТЬ ПО
	ВТ_Остатки.Номенклатура,
	ВТ_Остатки.НоменклатураАртикул,
	ВТ_Остатки.НоменклатураШтрихкод
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Остатки.Номенклатура КАК Номенклатура,
	СУММА(ВТ_Остатки.КоличествоОстаток) КАК КоличествоОстаток,
	ВТ_Остатки.НоменклатураАртикул КАК НоменклатураАртикул,
	ВТ_Остатки.НоменклатураШтрихкод КАК НоменклатураШтрихкод
ПОМЕСТИТЬ ВТ_ОстаткиПолучателя
ИЗ
	ВТ_Остатки КАК ВТ_Остатки
ГДЕ
	ВТ_Остатки.СтруктурнаяЕдиница &lt;&gt; &amp;Отправитель

СГРУППИРОВАТЬ ПО
	ВТ_Остатки.Номенклатура,
	ВТ_Остатки.НоменклатураАртикул,
	ВТ_Остатки.НоменклатураШтрихкод
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ОстаткиОтправителя.Номенклатура КАК Номенклатура,
	ВТ_ОстаткиОтправителя.Номенклатура.Артикул КАК НоменклатураАртикул,
	ВТ_ОстаткиОтправителя.Номенклатура.спБренд КАК НоменклатураспБренд,
	СУММА(ВТ_ОстаткиОтправителя.КоличествоОстаток) КАК ДоступноеКоличество,
	СУММА(ВЫБОР
			КОГДА ВТ_ОстаткиОтправителя.КоличествоОстаток &lt;= &amp;КоличествоКЗаказу
				ТОГДА ВТ_ОстаткиОтправителя.КоличествоОстаток
			ИНАЧЕ &amp;КоличествоКЗаказу
		КОНЕЦ) КАК Количество,
	ВТ_ОстаткиОтправителя.Номенклатура В (&amp;ВыделенныеСтроки) КАК Пометка,
	ВТ_ОстаткиОтправителя.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
ИЗ
	ВТ_ОстаткиОтправителя КАК ВТ_ОстаткиОтправителя
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОстаткиПолучателя КАК ВТ_ОстаткиПолучателя
		ПО (НЕ(ВТ_ОстаткиОтправителя.НоменклатураАртикул &lt;&gt; ВТ_ОстаткиПолучателя.НоменклатураАртикул
					И ВТ_ОстаткиОтправителя.НоменклатураШтрихкод &lt;&gt; ВТ_ОстаткиПолучателя.НоменклатураШтрихкод
					И НЕ ВТ_ОстаткиПолучателя.Номенклатура ЕСТЬ NULL))
ГДЕ
	ВТ_ОстаткиПолучателя.КоличествоОстаток &lt; &amp;НаименьшееКоличество

СГРУППИРОВАТЬ ПО
	ВТ_ОстаткиОтправителя.Номенклатура,
	ВТ_ОстаткиОтправителя.Номенклатура.Артикул,
	ВТ_ОстаткиОтправителя.Номенклатура.спБренд,
	ВТ_ОстаткиОтправителя.Номенклатура.ЕдиницаИзмерения,
	ВТ_ОстаткиОтправителя.Номенклатура В (&amp;ВыделенныеСтроки)</QueryText>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Номенклатура</dcssch:dataPath>
					<dcssch:field>Номенклатура</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Организация</dcssch:dataPath>
					<dcssch:field>Организация</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Характеристика</dcssch:dataPath>
					<dcssch:field>Характеристика</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Партия</dcssch:dataPath>
					<dcssch:field>Партия</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>СтруктурнаяЕдиница</dcssch:dataPath>
					<dcssch:field>СтруктурнаяЕдиница</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Ячейка</dcssch:dataPath>
					<dcssch:field>Ячейка</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>НоменклатураспБренд</dcssch:dataPath>
					<dcssch:field>НоменклатураспБренд</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>ДоступноеКоличество</dcssch:dataPath>
					<dcssch:field>ДоступноеКоличество</dcssch:field>
					<dcssch:title xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Доступное количество</v8:content>
						</v8:item>
					</dcssch:title>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>НоменклатураАртикул</dcssch:dataPath>
					<dcssch:field>НоменклатураАртикул</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Пометка</dcssch:dataPath>
					<dcssch:field>Пометка</dcssch:field>
					<dcssch:title xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Пометка</v8:content>
						</v8:item>
					</dcssch:title>
					<dcssch:useRestriction>
						<dcssch:group>true</dcssch:group>
						<dcssch:order>true</dcssch:order>
					</dcssch:useRestriction>
