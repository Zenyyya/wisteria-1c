&НаКлиенте
Процедура ОтправитьСообщениеТаблицаПодчиненныеСообщения(Команда)
	Состояние("Подождите. Идет обработка"); 
	
	СообщеняДляОтправки = ПолучитьДанныеДляОтправкиИзТаблицыПодчиненныеСообщения(); 
	Для каждого СтрокаСообщеняДляОтправки Из СообщеняДляОтправки Цикл
		
		Если ТипЗнч(СтрокаСообщеняДляОтправки.НоменклатураОтправки) = Тип("Массив") И СтрокаСообщеняДляОтправки.НоменклатураОтправки.Количество() > 0 Тогда	
			спСервисИнтеграцииКлиент.ОтправитьСообщениеНоменклатурыПоsFTP(СтрокаСообщеняДляОтправки.НоменклатураОтправки);
		КонецЕсли;
	КонецЦикла;

	
	ОбновитьДанныеТаблицаПодчиненныеСообщения();
КонецПроцедуры  

&НаСервере
Функция ПолучитьДанныеДляОтправкиИзТаблицыПодчиненныеСообщения() 
	
	ТаблицаПодчиненные = ТаблицаПодчиненныеСообщения.Выгрузить(, "СсылкаНаОбъект"); 
	ТаблицаПодчиненные.Очистить(); 
	
	Для каждого СтрокаТаблицаПодчиненныеСообщения Из ТаблицаПодчиненныеСообщения Цикл
		Если СтрокаТаблицаПодчиненныеСообщения.Флажок Тогда  
			 НоваяСтрока = ТаблицаПодчиненные.Добавить();
			 НоваяСтрока.СсылкаНаОбъект = СтрокаТаблицаПодчиненныеСообщения.СсылкаНаОбъект;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаПодчиненные.СсылкаНаОбъект КАК СсылкаНаОбъект
		|ПОМЕСТИТЬ ВнутренняяТаблицаПодчиненныеСообщения
		|ИЗ
		|	&ТаблицаПодчиненные КАК ТаблицаПодчиненные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
		|	тбОчередь.ФорматСообщения КАК ФорматСообщения,
		|	тбОчередь.МетодХранения КАК МетодХранения,
		|	тбОчередь.ОбъектСобытия КАК ОбъектСобытия,
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбОчередь.СпособПередачи КАК СпособПередачи,
		|	тбОчередь.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект,
		|	тбСостояние.СтатусСообщения КАК СтатусСообщения,
		|	тбСостояние.ОписаниеДанных КАК ОписаниеДанных,
		|	тбОчередь.Хранилище КАК Хранилище
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|ГДЕ
		|	тбОчередь.СсылкаНаОбъект В
		|			(ВЫБРАТЬ
		|				ВнутренняяТаблицаПодчиненныеСообщения.СсылкаНаОбъект КАК СсылкаНаОбъект
		|			ИЗ
		|				ВнутренняяТаблицаПодчиненныеСообщения КАК ВнутренняяТаблицаПодчиненныеСообщения)
		|	И тбОчередь.СпособПередачи = &СпособПередачи";

	
	Запрос.УстановитьПараметр("ТаблицаПодчиненные", ТаблицаПодчиненные); 
	Запрос.УстановитьПараметр("СпособПередачи", Перечисления.спСпособПередачи.FTP); 
	
	ВыгрузкаНоменклатура = Запрос.Выполнить().Выгрузить(); 
	
	СписокСтатусовДляОтправки = спКэшируемыеФункцииВызовСервера.ПоучитьСписокСтатусовДляОтправки(); 
	
	ВыгрузкаНоменклатураПоДокументуСвертка = ВыгрузкаНоменклатура.Скопировать();
	ВыгрузкаНоменклатураПоДокументуСвертка.Свернуть("ИнициаторОтправкиСсылкаНаОбъект", );
	
	ВыгрузкаНоменклатураСвертка = ВыгрузкаНоменклатура.Скопировать();	
	ВыгрузкаНоменклатураСвертка.Свернуть("ИдентификаторСобытия, ФорматСообщения, МетодХранения, ОбъектСобытия, СсылкаНаОбъект, СпособПередачи, ИнициаторОтправкиСсылкаНаОбъект, СтатусСообщения",);
	
	НоменклатураДляОтправки = Новый Массив;
	
	Для каждого СверткаДокумент Из ВыгрузкаНоменклатураПоДокументуСвертка Цикл
		
		НайденыеСтроки = ВыгрузкаНоменклатура.НайтиСтроки(Новый Структура("ИнициаторОтправкиСсылкаНаОбъект", СверткаДокумент.ИнициаторОтправкиСсылкаНаОбъект));
		ОтменаОтправки = Ложь;
		Если НайденыеСтроки.Количество() > 0 Тогда  
			Для каждого НайденаяСтрока Из НайденыеСтроки Цикл  
				
				Если НайденаяСтрока.СтатусСообщения = Перечисления.спСтатусыСообщений.ВОбработке Тогда 	
					ВремяСНачалаОбработки = ТекущаяДатаСеанса() - НайденаяСтрока.ДатаРегистрации;
					Если ВремяСНачалаОбработки < 3 * 60 Тогда  
						ОтменаОтправки = Истина;
					КонецЕсли;
				КонецЕсли;	
				
				Если СписокСтатусовДляОтправки.Найти(НайденаяСтрока.СтатусСообщения) = Неопределено Тогда 
					ОтменаОтправки = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если Не ОтменаОтправки Тогда 
			НайденыеСтроки = ВыгрузкаНоменклатураСвертка.НайтиСтроки(Новый Структура("ИнициаторОтправкиСсылкаНаОбъект", СверткаДокумент.ИнициаторОтправкиСсылкаНаОбъект));
			Если НайденыеСтроки.Количество() > 0 Тогда
				
				СообщеняСоСтатусамиДляОтправкиНоменклатура = Новый Массив;
				
				Для каждого НайденаяСтрока Из НайденыеСтроки Цикл
					
					СообщениеОтправки = Новый Структура;
					СообщениеОтправки.Вставить("ИдентификаторСобытия", НайденаяСтрока.ИдентификаторСобытия);
					СообщениеОтправки.Вставить("ФорматСообщения", НайденаяСтрока.ФорматСообщения);
					СообщениеОтправки.Вставить("МетодХранения", НайденаяСтрока.МетодХранения);
					СообщениеОтправки.Вставить("ОбъектСобытия",  НайденаяСтрока.ОбъектСобытия);
					СообщениеОтправки.Вставить("СсылкаНаОбъект", НайденаяСтрока.СсылкаНаОбъект);
					СообщениеОтправки.Вставить("СпособПередачи", НайденаяСтрока.СпособПередачи);
					СообщениеОтправки.Вставить("ИнициаторОтправкиСсылкаНаОбъект", НайденаяСтрока.ИнициаторОтправкиСсылкаНаОбъект);
					СообщениеОтправки.Вставить("СтатусСообщения", НайденаяСтрока.СтатусСообщения); 
					
					
					СтрокиНайденые = ВыгрузкаНоменклатура.НайтиСтроки(Новый Структура("ИдентификаторСобытия", НайденаяСтрока.ИдентификаторСобытия));
					Если СтрокиНайденые.Количество() > 0 Тогда
						СообщениеОтправки.Вставить("ДатаРегистрации", 	СтрокиНайденые[0].ДатаРегистрации);
						СообщениеОтправки.Вставить("ОписаниеДанных", 	СтрокиНайденые[0].ОписаниеДанных); 
						СообщениеОтправки.Вставить("Хранилище",      	СтрокиНайденые[0].Хранилище);
						
					КонецЕсли;
					
					СообщеняСоСтатусамиДляОтправкиНоменклатура.Добавить(СообщениеОтправки);
					
				КонецЦикла;
				
				СообщенияНоменклатуры = Новый Структура("ИнициаторОтправки, НоменклатураОтправки");
				СообщенияНоменклатуры.Вставить("ИнициаторОтправки", СверткаДокумент.ИнициаторОтправкиСсылкаНаОбъект);
				СообщенияНоменклатуры.Вставить("НоменклатураОтправки", СообщеняСоСтатусамиДляОтправкиНоменклатура); 
				НоменклатураДляОтправки.Добавить(СообщенияНоменклатуры);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НоменклатураДляОтправки;
КонецФункции

&НаСервере
Процедура ПолучитьДанныеТаблицаПодчиненныеСообщенияНаСервере()
	Для каждого СтрокаТаблицаПодчиненныеСообщения Из ТаблицаПодчиненныеСообщения Цикл
		Если СтрокаТаблицаПодчиненныеСообщения.Флажок Тогда
			ОчиститьРегистрОтправленныеСообщения(СтрокаТаблицаПодчиненныеСообщения.СсылкаНаОбъект, СтрокаТаблицаПодчиненныеСообщения.СпособПередачи); 
			ОчиститьРегистрОчередьИсходящихСообщений(СтрокаТаблицаПодчиненныеСообщения.ИдентификаторСобытия); 
			ОчиститьРегистрСостояниеСообщений(СтрокаТаблицаПодчиненныеСообщения.ИдентификаторСобытия);
			Если СтрокаТаблицаПодчиненныеСообщения.СпособПередачи = Перечисления.спСпособПередачи.FTP Тогда 
				спОбработкаСобытийВызовСервера.СериализоватьИЗаписатьДанныеВРегистрСообщений(СтрокаТаблицаПодчиненныеСообщения.СсылкаНаОбъект, СтрокаТаблицаПодчиненныеСообщения.ИнициаторОтправкиСсылкаНаОбъект);
			КонецЕсли;	
		КонецЕсли;
		
		Если СтрокаТаблицаПодчиненныеСообщения.Флажок Тогда
			Если СтрокаТаблицаПодчиненныеСообщения.СпособПередачи = Перечисления.спСпособПередачи.FTP Тогда 
				спОбработкаСобытийВызовСервера.СериализоватьИЗаписатьДанныеВРегистрСообщений(СтрокаТаблицаПодчиненныеСообщения.СсылкаНаОбъект, СтрокаТаблицаПодчиненныеСообщения.ИнициаторОтправкиСсылкаНаОбъект);	
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла; 
	
	ОбновитьДанныеТаблицаПодчиненныеСообщения();
	
КонецПроцедуры  

&НаСервере
Процедура ОбновитьДанныеТаблицаПодчиненныеСообщения() 
	
	ПараметрСпособПередачи = Перечисления.спСпособПередачи.FTP;	

	ТаблицаПодчиненные = ТаблицаПодчиненныеСообщения.Выгрузить(, "СсылкаНаОбъект"); 
	ТаблицаПодчиненныеСообщения.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаПодчиненные.СсылкаНаОбъект КАК СсылкаНаОбъект
		|ПОМЕСТИТЬ ВнутренняяТаблицаПодчиненныеСообщения
		|ИЗ
		|	&ТаблицаПодчиненные КАК ТаблицаПодчиненные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
		|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	ПРЕДСТАВЛЕНИЕ(тбОчередь.ИдентификаторСобытия) КАК ИдентификаторСобытияСтрока,
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбОчередь.СпособПередачи КАК СпособПередачи,
		|	тбСостояние.СтатусСообщения КАК СтатусСообщения,
		|	тбОчередь.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|ГДЕ
		|	тбОчередь.СсылкаНаОбъект В
		|			(ВЫБРАТЬ
		|				ВнутренняяТаблицаПодчиненныеСообщения.СсылкаНаОбъект КАК СсылкаНаОбъект
		|			ИЗ
		|				ВнутренняяТаблицаПодчиненныеСообщения КАК ВнутренняяТаблицаПодчиненныеСообщения)
		|	И тбОчередь.СпособПередачи = &СпособПередачи";
	
	Запрос.УстановитьПараметр("ТаблицаПодчиненные", ТаблицаПодчиненные); 
	Запрос.УстановитьПараметр("СпособПередачи", ПараметрСпособПередачи);

	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаПодчиненныеСообщения.Загрузить(РезультатЗапроса);
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанныеТаблицаПодчиненныеСообщения(Команда)
	ПолучитьДанныеТаблицаПодчиненныеСообщенияНаСервере();
КонецПроцедуры

&НаСервере
Функция ТаблицаПодчиненныеСообщенияПриИзмененииНаСервере(СсылкаНаОбъект)
	ПараметрСпособПередачи = Перечисления.спСпособПередачи.FTP;	
	
	ТекущиеДанные = Новый Структура("ДатаРегистрации, ИдентификаторСобытия, ИдентификаторСобытияСтрока, СсылкаНаОбъект, СпособПередачи, СтатусСообщения, ИнициаторОтправкиСсылкаНаОбъект");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
		|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	ПРЕДСТАВЛЕНИЕ(тбОчередь.ИдентификаторСобытия) КАК ИдентификаторСобытияСтрока,
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбОчередь.СпособПередачи КАК СпособПередачи,
		|	тбСостояние.СтатусСообщения КАК СтатусСообщения,
		|	тбОчередь.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|ГДЕ
		|	тбОчередь.СсылкаНаОбъект = &СсылкаНаОбъект
		|	И тбОчередь.СпособПередачи = &СпособПередачи";
	
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект); 
	Запрос.УстановитьПараметр("СпособПередачи", ПараметрСпособПередачи);

	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекущиеДанные.Вставить("ДатаРегистрации", ВыборкаДетальныеЗаписи.ДатаРегистрации);
		ТекущиеДанные.Вставить("ИдентификаторСобытия", ВыборкаДетальныеЗаписи.ИдентификаторСобытия);
		ТекущиеДанные.Вставить("ИдентификаторСобытияСтрока", ВыборкаДетальныеЗаписи.ИдентификаторСобытияСтрока);
		ТекущиеДанные.Вставить("СсылкаНаОбъект", ВыборкаДетальныеЗаписи.СсылкаНаОбъект);
		ТекущиеДанные.Вставить("СпособПередачи", ВыборкаДетальныеЗаписи.СпособПередачи);
		ТекущиеДанные.Вставить("СтатусСообщения", ВыборкаДетальныеЗаписи.СтатусСообщения); 
		ТекущиеДанные.Вставить("ИнициаторОтправкиСсылкаНаОбъект", ВыборкаДетальныеЗаписи.ИнициаторОтправкиСсылкаНаОбъект);
	КонецЦикла;
	
	Возврат ТекущиеДанные;

КонецФункции

&НаКлиенте
Процедура ТаблицаПодчиненныеСообщенияПриИзменении(Элемент) 
	ТекущиеДанныеТаблицаПодчиненныеСообщения = Элементы.ТаблицаПодчиненныеСообщения.ТекущиеДанные;
	Если ТекущиеДанныеТаблицаПодчиненныеСообщения <> Неопределено И ЗначениеЗаполнено(ТекущиеДанныеТаблицаПодчиненныеСообщения.СсылкаНаОбъект) Тогда 
		ТекущиеДанныеИзЗапроса = ТаблицаПодчиненныеСообщенияПриИзмененииНаСервере(ТекущиеДанныеТаблицаПодчиненныеСообщения.СсылкаНаОбъект); 
		ТекущиеДанныеТаблицаПодчиненныеСообщения.ДатаРегистрации 				= ТекущиеДанныеИзЗапроса.ДатаРегистрации;
        ТекущиеДанныеТаблицаПодчиненныеСообщения.ИдентификаторСобытия 			= ТекущиеДанныеИзЗапроса.ИдентификаторСобытия;
		ТекущиеДанныеТаблицаПодчиненныеСообщения.ИдентификаторСобытияСтрока 	= ТекущиеДанныеИзЗапроса.ИдентификаторСобытияСтрока;
		ТекущиеДанныеТаблицаПодчиненныеСообщения.СпособПередачи 				= ТекущиеДанныеИзЗапроса.СпособПередачи;
		ТекущиеДанныеТаблицаПодчиненныеСообщения.СтатусСообщения 				= ТекущиеДанныеИзЗапроса.СтатусСообщения;
		ТекущиеДанныеТаблицаПодчиненныеСообщения.ИнициаторОтправкиСсылкаНаОбъект 				= ТекущиеДанныеИзЗапроса.ИнициаторОтправкиСсылкаНаОбъект;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПолучитьДанныеТаблицаИнициаторыОтправкиНаСервере()
	Для каждого СтрокаТаблицаИнициаторыОтправки Из ТаблицаИнициаторыОтправки Цикл
		Если СтрокаТаблицаИнициаторыОтправки.Флажок Тогда
			ОчиститьРегистрОтправленныеСообщения(СтрокаТаблицаИнициаторыОтправки.СсылкаНаОбъект, СтрокаТаблицаИнициаторыОтправки.СпособПередачи); 
			ОчиститьРегистрОчередьИсходящихСообщений(СтрокаТаблицаИнициаторыОтправки.ИдентификаторСобытия); 
			ОчиститьРегистрСостояниеСообщений(СтрокаТаблицаИнициаторыОтправки.ИдентификаторСобытия);
			
			Если СтрокаТаблицаИнициаторыОтправки.СпособПередачи = Перечисления.спСпособПередачи.FTP Тогда 
				спОбработкаСобытийВызовСервера.СериализоватьИЗаписатьДанныеВРегистрСообщений(СтрокаТаблицаИнициаторыОтправки.СсылкаНаОбъект);
			КонецЕсли;	
		КонецЕсли;		
	КонецЦикла; 
	
	ОбновитьДанныеТаблицаИнициаторыОтправки();
	ПроверитьВозможностьОтправкиТаблицаИнициаторыОтправкиНаСервере();
КонецПроцедуры


&НаСервере
Процедура ОбновитьДанныеТаблицаИнициаторыОтправки() 
	ПараметрСпособПередачи = Перечисления.спСпособПередачи.FTP;	
	
	ТаблицаИнициаторы = ТаблицаИнициаторыОтправки.Выгрузить(, "СсылкаНаОбъект"); 
	ТаблицаИнициаторыОтправки.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаИнициаторы.СсылкаНаОбъект КАК СсылкаНаОбъект
		|ПОМЕСТИТЬ ВнутренняяТаблицаИнициаторыОтправки
		|ИЗ
		|	&ТаблицаИнициаторы КАК ТаблицаИнициаторы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
		|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	ПРЕДСТАВЛЕНИЕ(тбОчередь.ИдентификаторСобытия) КАК ИдентификаторСобытияСтрока,
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбОчередь.СпособПередачи КАК СпособПередачи,
		|	тбСостояние.СтатусСообщения КАК СтатусСообщения
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|ГДЕ
		|	тбОчередь.СсылкаНаОбъект В
		|			(ВЫБРАТЬ
		|				ВнутренняяТаблицаИнициаторыОтправки.СсылкаНаОбъект КАК СсылкаНаОбъект
		|			ИЗ
		|				ВнутренняяТаблицаИнициаторыОтправки КАК ВнутренняяТаблицаИнициаторыОтправки)
		|	И тбОчередь.СпособПередачи = &СпособПередачи";
	
	Запрос.УстановитьПараметр("ТаблицаИнициаторы", ТаблицаИнициаторы); 
	Запрос.УстановитьПараметр("СпособПередачи", ПараметрСпособПередачи);

	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаИнициаторыОтправки.Загрузить(РезультатЗапроса);
КонецПроцедуры


&НаКлиенте
Процедура ПолучитьДанныеТаблицаИнициаторыОтправки(Команда)
	ПолучитьДанныеТаблицаИнициаторыОтправкиНаСервере();
