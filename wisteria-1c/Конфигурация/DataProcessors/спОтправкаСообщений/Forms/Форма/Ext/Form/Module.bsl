&НаСервере
Процедура ПроверитьВозможностьОтправкиТаблицаИнициаторыОтправкиНаСервере()
	
    ТаблицаИнициаторы = ТаблицаИнициаторыОтправки.Выгрузить(, "СсылкаНаОбъект");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаИнициаторы.СсылкаНаОбъект КАК СсылкаНаОбъект
		|ПОМЕСТИТЬ ВнутренняяТаблицаИнициаторыОтправки
		|ИЗ
		|	&ТаблицаИнициаторы КАК ТаблицаИнициаторы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбСостояние.СтатусСообщения КАК СтатусСообщения,
		|	тбОчередь.СпособПередачи КАК СпособПередачи
		|ПОМЕСТИТЬ ВТОтправленныеСообщенияДокумент
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|			И (тбСостояние.ЗадержкаЧисло <= &ЗадержкаЧисло)
		|			И (тбОчередь.СпособПередачи = &СпособПередачи)
		|ГДЕ
		|	тбОчередь.СсылкаНаОбъект В
		|			(ВЫБРАТЬ
		|				ВнутренняяТаблицаИнициаторыОтправки.СсылкаНаОбъект КАК СсылкаНаОбъект
		|			ИЗ
		|				ВнутренняяТаблицаИнициаторыОтправки КАК ВнутренняяТаблицаИнициаторыОтправки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбОчередь.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект
		|ПОМЕСТИТЬ ВТНеПодтвержденныеОтправленныеСообщения
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|			И (тбСостояние.ЗадержкаЧисло <= &ЗадержкаЧисло)
		|			И (тбСостояние.СтатусСообщения <> &СписокСтатусовИсходящихСообщений)
		|			И (тбОчередь.СпособПередачи = &СпособПередачи)
		|ГДЕ
		|	тбОчередь.ИнициаторОтправкиСсылкаНаОбъект В
		|			(ВЫБРАТЬ
		|				ВнутренняяТаблицаИнициаторыОтправки.СсылкаНаОбъект КАК СсылкаНаОбъект
		|			ИЗ
		|				ВнутренняяТаблицаИнициаторыОтправки КАК ВнутренняяТаблицаИнициаторыОтправки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТНеПодтвержденныеОтправленныеСообщения.СсылкаНаОбъект), 0) КАК КоличествоСообщений,
		|	ВТНеПодтвержденныеОтправленныеСообщения.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправки
		|ПОМЕСТИТЬ ВТКоличествоНеподтвержденныхСообщений
		|ИЗ
		|	ВТНеПодтвержденныеОтправленныеСообщения КАК ВТНеПодтвержденныеОтправленныеСообщения
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТНеПодтвержденныеОтправленныеСообщения.ИнициаторОтправкиСсылкаНаОбъект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТОтправленныеСообщенияДокумент.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТКоличествоНеподтвержденныхСообщений.КоличествоСообщений, 0) = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОтправкаПодтверждена
		|ИЗ
		|	ВТОтправленныеСообщенияДокумент КАК ВТОтправленныеСообщенияДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКоличествоНеподтвержденныхСообщений КАК ВТКоличествоНеподтвержденныхСообщений
		|		ПО ВТОтправленныеСообщенияДокумент.СсылкаНаОбъект = ВТКоличествоНеподтвержденныхСообщений.ИнициаторОтправки";
	
	
	Запрос.УстановитьПараметр("СпособПередачи", Перечисления.спСпособПередачи.FTP);
	Запрос.УстановитьПараметр("ЗадержкаЧисло", спОбщегоНазначенияВызовСервера.ПеревестиДатуВЧисло(ТекущаяДатаСеанса())); 
	Запрос.УстановитьПараметр("СписокСтатусовИсходящихСообщений", Перечисления.спСтатусыСообщений.ОтправкаПодтверждена);
	Запрос.УстановитьПараметр("ТаблицаИнициаторы", ТаблицаИнициаторы); 

	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтруктураПоиска = Новый Структура("СсылкаНаОбъект", ВыборкаДетальныеЗаписи.СсылкаНаОбъект);
		НайденныеСтроки = ТаблицаИнициаторыОтправки.НайтиСтроки(СтруктураПоиска); 
		Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.ОтправкаНоменклатурыПодтверждена = ВыборкаДетальныеЗаписи.ОтправкаПодтверждена; 
		КонецЦикла;
	КонецЦикла;

	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВозможностьОтправкиТаблицаИнициаторыОтправки(Команда)
	ПроверитьВозможностьОтправкиТаблицаИнициаторыОтправкиНаСервере();
