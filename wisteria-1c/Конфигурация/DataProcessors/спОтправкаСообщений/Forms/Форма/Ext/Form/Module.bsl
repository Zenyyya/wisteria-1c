	Параметр1 = "";
    Параметр2 = ""; 
	Параметр3 = ""; 
	
	Если ТипЗнч(СтатусПодчиненныхСообщений) = Тип("ПеречислениеСсылка.спСтатусыСообщений") ИЛИ СтатусПодчиненныхСообщений = Перечисления.спСтатусыСообщений.ПустаяСсылка() Тогда 
