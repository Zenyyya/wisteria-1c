
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТребуютОтправки = Истина;
	ИнтервалОбновления = спОбщегоНазначенияВызовСервера.ПолучитьЗначениеКонстанты("спОтправкаСообщенийИнтервалОбновленияСтатусов");
	ИнтервалОбновленияСтатусов = ?(ЗначениеЗаполнено(ИнтервалОбновления), ИнтервалОбновления, 5);    
	АвтоматическоеОбновление = спОбщегоНазначенияВызовСервера.ПолучитьЗначениеКонстанты("спОтправкаСообщенийАвтоматическоеОбновление");  
	
	ТипОбъекта.Добавить(Тип("ДокументСсылка.ПриходнаяНакладная"),"Приходная накладная");
	ТипОбъекта.Добавить(Тип("ДокументСсылка.ПеремещениеЗапасов"),"Перемещение запасов"); 
	
	СообщеняОтправки = ОбновитьСтатусыНаСервере(); 
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
 	ПодключитьОбработкуСообщений();
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОбработкуСообщений() 
	Интервал = ИнтервалОбновленияСтатусов * 60;
	ПодключитьОбработчикОжидания("ОбновитьСтатусыПроверитьОбработкуСообщений", Интервал); 	
КонецПроцедуры

&НаСервере
Функция ОбновитьСтатусыНаСервере()  
	
    СтатусПодчиненныхСообщений = Перечисления.спСтатусыСообщений.ПустаяСсылка();
	СтатусСообщенийИнициаторовОтправки = Перечисления.спСтатусыСообщений.ПустаяСсылка(); 
	
	Если ЗначениеЗаполнено(СтатусСообщенияДокумент) Тогда 
		
		Если  СтатусСообщенияДокумент = "ОжидаетОтправкиНоменклатуры" Тогда 
			СтатусПодчиненныхСообщений = Перечисления.спСтатусыСообщений.Новое;
			СтатусСообщенийИнициаторовОтправки = Перечисления.спСтатусыСообщений.Новое;
			
		ИначеЕсли СтатусСообщенияДокумент = "ОжидаетПодтвержденияНоменклатуры" Тогда 
			СтатусПодчиненныхСообщений = Перечисления.спСтатусыСообщений.Отправлено;
			СтатусСообщенийИнициаторовОтправки = Перечисления.спСтатусыСообщений.Новое;
			
		ИначеЕсли СтатусСообщенияДокумент = "НоменклатураПодтверждена" Тогда 
			СтатусПодчиненныхСообщений = Перечисления.спСтатусыСообщений.ОтправкаПодтверждена;
			СтатусСообщенийИнициаторовОтправки = Перечисления.спСтатусыСообщений.Новое;
			
		ИначеЕсли СтатусСообщенияДокумент = "ОшибкаДанныхСообшенияНоменклатуры" Тогда 
			СтатусПодчиненныхСообщений = Перечисления.спСтатусыСообщений.НеВалидно;
			СтатусСообщенийИнициаторовОтправки = Перечисления.спСтатусыСообщений.Новое;
			
		ИначеЕсли СтатусСообщенияДокумент = "ОшибкаОтправкиНоменклатуры" Тогда 
			
			СтатусПодчиненныхСообщений = Новый Массив;
			СтатусПодчиненныхСообщений.Добавить(Перечисления.спСтатусыСообщений.ОшибкаОтправки); 
			СтатусПодчиненныхСообщений.Добавить(Перечисления.спСтатусыСообщений.ОшибкаОбработки);
			
			СтатусСообщенийИнициаторовОтправки = Перечисления.спСтатусыСообщений.Новое;  
			
		ИначеЕсли СтатусСообщенияДокумент = "ОжидаетОтправки" Тогда 
			СтатусПодчиненныхСообщений = Перечисления.спСтатусыСообщений.ОтправкаПодтверждена;
			СтатусСообщенийИнициаторовОтправки = Перечисления.спСтатусыСообщений.Новое;  
			
		ИначеЕсли СтатусСообщенияДокумент = "Отправлена" Тогда 
			СтатусПодчиненныхСообщений = Перечисления.спСтатусыСообщений.ОтправкаПодтверждена;
			СтатусСообщенийИнициаторовОтправки = Перечисления.спСтатусыСообщений.Отправлено;
			
		ИначеЕсли СтатусСообщенияДокумент = "Подтверждена" Тогда 
			СтатусПодчиненныхСообщений = Перечисления.спСтатусыСообщений.ОтправкаПодтверждена;
			СтатусСообщенийИнициаторовОтправки = Перечисления.спСтатусыСообщений.ОтправкаПодтверждена;
			
		ИначеЕсли СтатусСообщенияДокумент = "ОшибкаДанныхСообшения" Тогда 
			
			СтатусПодчиненныхСообщений = Перечисления.спСтатусыСообщений.ОтправкаПодтверждена;
			СтатусСообщенийИнициаторовОтправки = Перечисления.спСтатусыСообщений.НеВалидно;	
			
		ИначеЕсли СтатусСообщенияДокумент = "ОшибкаОтправки" Тогда
			
			СтатусПодчиненныхСообщений = Перечисления.спСтатусыСообщений.ОтправкаПодтверждена;
			
			СтатусСообщенийИнициаторовОтправки = Новый Массив;
			СтатусСообщенийИнициаторовОтправки.Добавить(Перечисления.спСтатусыСообщений.ОшибкаОтправки); 
			СтатусСообщенийИнициаторовОтправки.Добавить(Перечисления.спСтатусыСообщений.ОшибкаОбработки);
			
		КонецЕсли;
	КонецЕсли;
	
	ДокументыДоОбновления = Объект.Документы.Выгрузить();
			
	СтатусыОтправки = Новый Структура;
	СтатусыОтправки.Вставить("ОжидаетОтправкиНоменклатуры", 		"Ожидает отправки номенклатуры"); 
	СтатусыОтправки.Вставить("ОжидаетПодтвержденияНоменклатуры", 	"Ожидает подтверждения номенклатуры");
	СтатусыОтправки.Вставить("НоменклатураПодтверждена",       		"Номенклатура подтверждена");
	
	СтатусыОтправки.Вставить("ОшибкаОтправкиНоменклатуры", 			"Ошибка загрузки номенклатуры");
	СтатусыОтправки.Вставить("ОшибкаДанныхСообшенияНоменклатуры", 	"Ошибка данных сообшения номенклатуры"); 


	СтатусыОтправки.Вставить("ОшибкаДанныхСообшения", 				"Ошибка данных сообщения");
	
	СтатусыОтправки.Вставить("ОжидаетОтправки", 					"Ожидает отправки");
	СтатусыОтправки.Вставить("Отправлена", 							"Отправлен"); 
	СтатусыОтправки.Вставить("ОжидаетПодтверждения",                "Ожидает подтверждения"); 
	СтатусыОтправки.Вставить("Подтверждена", 						"Подтверждена"); 
	
	СтатусыОтправки.Вставить("ОшибкаОтправки", 						"Ошибка отправки");


	Объект.Сообщения.Очистить();
	Объект.Документы.Очистить();

	Запрос = Новый Запрос;
	МВТ = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МВТ; 
	Запрос.Текст = 
	
		//   %1
		//   %2
        //|   И %3  
		
		"ВЫБРАТЬ
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбОчередь.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект
		|ПОМЕСТИТЬ ВТПодчиненныеСообщения
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|			И (тбСостояние.ЗадержкаЧисло <= &ЗадержкаЧисло)
		|			И (ТИПЗНАЧЕНИЯ(тбОчередь.СсылкаНаОбъект) В (&ТипОбъектаПодчиненные))
		|			И (тбОчередь.СпособПередачи = &СпособПередачи)
		|			И (тбСостояние.СтатусСообщения %1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект
		|ПОМЕСТИТЬ ВТСообщенияИнициаторОтправки
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|			И (тбСостояние.ЗадержкаЧисло <= &ЗадержкаЧисло)
		|			И (ТИПЗНАЧЕНИЯ(тбОчередь.СсылкаНаОбъект) В (&ТипОбъекта))
		|			И (тбОчередь.СпособПередачи = &СпособПередачи)
		|			И (тбСостояние.СтатусСообщения %2)
		|			И (тбОчередь.СсылкаНаОбъект В
		|				(ВЫБРАТЬ
		|					ВТПодчиненныеСообщения.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект
		|				ИЗ
		|					ВТПодчиненныеСообщения КАК ВТПодчиненныеСообщения))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|
		|ВЫБРАТЬ
		|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбСостояние.СтатусСообщения КАК СтатусСообщения,
		|	тбОчередь.СпособПередачи КАК СпособПередачи
		|ПОМЕСТИТЬ ВТОтправленныеСообщенияДокумент
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|			И (тбСостояние.ЗадержкаЧисло <= &ЗадержкаЧисло)
		|			И (ТИПЗНАЧЕНИЯ(тбОчередь.СсылкаНаОбъект) В (&ТипОбъекта))
		|			И (тбОчередь.СпособПередачи = &СпособПередачи)
		|           И %3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбСостояние.СтатусСообщения КАК СтатусСообщения,
		|	тбОчередь.СпособПередачи КАК СпособПередачи
		|ПОМЕСТИТЬ ВТОтправленныеСообщения
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|			И (тбСостояние.ЗадержкаЧисло <= &ЗадержкаЧисло)
		|			И (тбСостояние.СтатусСообщения В (&СписокСтатусовИсходящихСообщений))
		|			И (тбОчередь.СпособПередачи = &СпособПередачи)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПриходнаяНакладнаяЗапасы.Номенклатура КАК Номенклатура,
		|	ПриходнаяНакладнаяЗапасы.Ссылка КАК Документ
		|ПОМЕСТИТЬ ВТЗапасы
		|ИЗ
		|	ВТОтправленныеСообщенияДокумент КАК ВТОтправленныеСообщенияДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходнаяНакладная.Запасы КАК ПриходнаяНакладнаяЗапасы
		|		ПО ВТОтправленныеСообщенияДокумент.СсылкаНаОбъект = ПриходнаяНакладнаяЗапасы.Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПеремещениеЗапасовЗапасы.Номенклатура,
		|	ПеремещениеЗапасовЗапасы.Ссылка
		|ИЗ
		|	ВТОтправленныеСообщенияДокумент КАК ВТОтправленныеСообщенияДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПеремещениеЗапасов.Запасы КАК ПеремещениеЗапасовЗапасы
		|		ПО ВТОтправленныеСообщенияДокумент.СсылкаНаОбъект = ПеремещениеЗапасовЗапасы.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТЗапасы.Номенклатура КАК Номенклатура,
		|	ВТЗапасы.Документ КАК Документ
		|ПОМЕСТИТЬ ВТДокументНоменклатура
		|ИЗ
		|	ВТЗапасы КАК ВТЗапасы
		|ГДЕ
		|	ВТЗапасы.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	И НЕ ВТЗапасы.Номенклатура ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТЗапасы.Документ,
		|	ВТЗапасы.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
		|	тбОчередь.ФорматСообщения КАК ФорматСообщения,
		|	тбОчередь.МетодХранения КАК МетодХранения,
		|	тбОчередь.ОбъектСобытия КАК ОбъектСобытия,
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбОчередь.СпособПередачи КАК СпособПередачи,
		|	тбОчередь.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект,
		|	тбСостояние.СтатусСообщения КАК СтатусСообщения,
		|	тбСостояние.ОписаниеДанных КАК ОписаниеДанных,
		|	тбОчередь.Хранилище КАК Хранилище
		|ПОМЕСТИТЬ ВТ_ОчередьИсходящихСообщений
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|			И (тбСостояние.ЗадержкаЧисло <= &ЗадержкаЧисло)
		|ГДЕ
		|	НЕ тбОчередь.ЭтоУдаление
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТДокументНоменклатура.Документ КАК Документ,
		|	ЕСТЬNULL(ВТОтправленныеСообщения.СсылкаНаОбъект, ВТ_ОчередьИсходящихСообщений.СсылкаНаОбъект) КАК СсылкаНаОбъект,
		|	ЕСТЬNULL(ВТОтправленныеСообщения.ДатаРегистрации, ВТ_ОчередьИсходящихСообщений.ДатаРегистрации) КАК ДатаРегистрации,
		|	ЕСТЬNULL(ВТОтправленныеСообщения.СтатусСообщения, ВТ_ОчередьИсходящихСообщений.СтатусСообщения) КАК СтатусСообщения,
		|	ВТ_ОчередьИсходящихСообщений.ОписаниеДанных КАК ОписаниеДанных
		|ИЗ
		|	ВТДокументНоменклатура КАК ВТДокументНоменклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОчередьИсходящихСообщений КАК ВТ_ОчередьИсходящихСообщений
		|		ПО ВТДокументНоменклатура.Номенклатура = ВТ_ОчередьИсходящихСообщений.СсылкаНаОбъект
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОтправленныеСообщения КАК ВТОтправленныеСообщения
		|		ПО ВТДокументНоменклатура.Номенклатура = ВТОтправленныеСообщения.СсылкаНаОбъект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ВТОтправленныеСообщения.ДатаРегистрации, ВТ_ОчередьИсходящихСообщений.ДатаРегистрации) КАК ДатаРегистрации,
		|	ЕСТЬNULL(ВТОтправленныеСообщения.СсылкаНаОбъект, ВТ_ОчередьИсходящихСообщений.СсылкаНаОбъект) КАК СсылкаНаОбъект,
		|	ЕСТЬNULL(ВТОтправленныеСообщения.СтатусСообщения, ВТ_ОчередьИсходящихСообщений.СтатусСообщения) КАК СтатусСообщения,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТДокументНоменклатура.Номенклатура) КАК Номенклатура
		|ПОМЕСТИТЬ ВТДокументНоменклатураДанные
		|ИЗ
		|	ВТДокументНоменклатура КАК ВТДокументНоменклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОчередьИсходящихСообщений КАК ВТ_ОчередьИсходящихСообщений
		|		ПО ВТДокументНоменклатура.Документ = ВТ_ОчередьИсходящихСообщений.СсылкаНаОбъект
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОтправленныеСообщения КАК ВТОтправленныеСообщения
		|		ПО ВТДокументНоменклатура.Документ = ВТОтправленныеСообщения.СсылкаНаОбъект
		|
