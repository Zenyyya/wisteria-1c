&НаСервере
Процедура ПолучитьСтатусНаСервере()
	ТаблицаСтатусовСообщений.Очистить();
	
	Запрос = Новый Запрос;

	Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда    
			
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
			|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
			|	ПРЕДСТАВЛЕНИЕ(тбОчередь.ИдентификаторСобытия) КАК ИдентификаторСобытияСтрока,
			|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
			|	тбОчередь.СпособПередачи КАК СпособПередачи,
			|	тбСостояние.СтатусСообщения КАК СтатусСообщения,
			|	0 КАК Приоритет,
			|	тбОчередь.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект
			|ПОМЕСТИТЬ ВТИсходящихСообщений
			|ИЗ
			|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
			|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
			|ГДЕ
			|	тбОчередь.СсылкаНаОбъект = &СсылкаНаОбъект
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
			|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
			|	ПРЕДСТАВЛЕНИЕ(тбОчередь.ИдентификаторСобытия) КАК ИдентификаторСобытияСтрока,
			|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
			|	тбОчередь.СпособПередачи КАК СпособПередачи,
			|	тбСостояние.СтатусСообщения КАК СтатусСообщения,
			|	1 КАК Приоритет,
			|	тбОчередь.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект
			|ПОМЕСТИТЬ ВТСообщения
			|ИЗ
			|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
			|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
			|			И (тбОчередь.ИнициаторОтправкиСсылкаНаОбъект В
			|				(ВЫБРАТЬ
			|					ВТИсходящихСообщений.СсылкаНаОбъект КАК СсылкаНаОбъект
			|				ИЗ
			|					ВТИсходящихСообщений КАК ВТИсходящихСообщений))
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ВТИсходящихСообщений.ДатаРегистрации,
			|	ВТИсходящихСообщений.ИдентификаторСобытия,
			|	ВТИсходящихСообщений.ИдентификаторСобытияСтрока,
			|	ВТИсходящихСообщений.СсылкаНаОбъект,
			|	ВТИсходящихСообщений.СпособПередачи,
			|	ВТИсходящихСообщений.СтатусСообщения,
			|	ВТИсходящихСообщений.Приоритет,
			|	ВТИсходящихСообщений.ИнициаторОтправкиСсылкаНаОбъект
			|ИЗ
			|	ВТИсходящихСообщений КАК ВТИсходящихСообщений
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТСообщения.ДатаРегистрации КАК ДатаРегистрации,
			|	ВТСообщения.ИдентификаторСобытия КАК ИдентификаторСобытия,
			|	ВТСообщения.ИдентификаторСобытияСтрока КАК ИдентификаторСобытияСтрока,
			|	ВТСообщения.СсылкаНаОбъект КАК СсылкаНаОбъект,
			|	ВТСообщения.СпособПередачи КАК СпособПередачи,
			|	ВТСообщения.СтатусСообщения КАК СтатусСообщения,
			|	ВТСообщения.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект
			|ИЗ
			|	ВТСообщения КАК ВТСообщения
			|
			|УПОРЯДОЧИТЬ ПО
			|	ВТСообщения.Приоритет,
			|	ИнициаторОтправкиСсылкаНаОбъект"; 
			
			Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
			
			
		Иначе 
			Запрос.Текст = 	
			"ВЫБРАТЬ
			|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
			|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
			|	ПРЕДСТАВЛЕНИЕ(тбОчередь.ИдентификаторСобытия) КАК ИдентификаторСобытияСтрока,
			|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
			|	тбОчередь.СпособПередачи КАК СпособПередачи,
			|	тбСостояние.СтатусСообщения КАК СтатусСообщения,
			|	тбОчередь.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект
			|ИЗ
			|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
			|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
			|
			|УПОРЯДОЧИТЬ ПО
			|	ИнициаторОтправкиСсылкаНаОбъект"; 
			
		КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока = ТаблицаСтатусовСообщений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи); 
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ПолучитьСтатус(Команда)
	ПолучитьСтатусНаСервере();
КонецПроцедуры 

&НаСервере
Процедура ОбработатьСообщенияНаСервере() 
	Если ЗначениеЗаполнено(СтатусОтправкиСообщения) Тогда 
		ИзменитьСтатус(); 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСообщения(Команда) 
	Если ТаблицаСтатусовСообщений.Количество() = 0 Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Таблица сообщений не заполнена'"), , , , );  
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтатусОтправкиСообщения) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Заполните статус сообщения'"), , , , );  
		Возврат;
	КонецЕсли;
	ОбработатьСообщенияНаСервере();
КонецПроцедуры 

&НаСервере
Процедура ИзменитьСтатус()  
	
	СтруктураПоиска = Новый Структура("Флажок", Истина); 
	НайденнаяСтрока = ТаблицаСтатусовСообщений.НайтиСтроки(СтруктураПоиска); 
	Если НайденнаяСтрока.Количество() > 0 Тогда 
		ИдентификаторОтбор = Новый Массив;
		Для каждого СтрокаНайденнаяСтрока Из НайденнаяСтрока Цикл  
			ИдентификаторОтбор.Добавить(СтрокаНайденнаяСтрока.ИдентификаторСобытия);
		КонецЦикла; 
		
		ИзменитьСтатусСообщения(ИдентификаторОтбор); 
		ПолучитьСтатусНаСервере();
	КонецЕсли;
КонецПроцедуры   

&НаСервере
Процедура ИзменитьСтатусСообщения(ИдентификаторОтбор)
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	спСостояниеСообщений.ИдентификаторСобытия КАК ИдентификаторСобытия,
	               |	спСостояниеСообщений.ИдентификаторСообщения КАК ИдентификаторСообщения,
	               |	спСостояниеСообщений.СтатусСообщения КАК СтатусСообщения,
	               |	спСостояниеСообщений.ДатаИзменения КАК ДатаИзменения,
	               |	спСостояниеСообщений.Задержка КАК Задержка,
	               |	спСостояниеСообщений.ЗадержкаЧисло КАК ЗадержкаЧисло,
	               |	спСостояниеСообщений.ИндексПотока КАК ИндексПотока,
	               |	спСостояниеСообщений.НачалоСеанса КАК НачалоСеанса,
	               |	спСостояниеСообщений.НомерСеанса КАК НомерСеанса,
	               |	спСостояниеСообщений.ОписаниеДанных КАК ОписаниеДанных,
	               |	спОчередьИсходящихСообщений.СсылкаНаОбъект КАК СсылкаНаОбъект,
	               |	спОчередьИсходящихСообщений.СпособПередачи КАК СпособПередачи
	               |ИЗ
	               |	РегистрСведений.спСостояниеСообщений КАК спСостояниеСообщений
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спОчередьИсходящихСообщений КАК спОчередьИсходящихСообщений
	               |		ПО спСостояниеСообщений.ИдентификаторСобытия = спОчередьИсходящихСообщений.ИдентификаторСобытия
	               |ГДЕ
	               |	спСостояниеСообщений.ИдентификаторСобытия В(&ИдентификаторОтбор)";  
	Запрос.УстановитьПараметр("ИдентификаторОтбор", ИдентификаторОтбор); 
	Выгрузка = Запрос.Выполнить().Выгрузить();  
	Для каждого СтрокаВыгрузки Из Выгрузка Цикл
	   	МенеджерЗаписи = РегистрыСведений.спСостояниеСообщений.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтрокаВыгрузки); 
		МенеджерЗаписи.СтатусСообщения = СтатусОтправкиСообщения; 
		МенеджерЗаписи.Записать();   
		
		СписокСтатусовОчередиИсходящих = спКэшируемыеФункцииВызовСервера.ПоучитьСписокСтатусовОчередиИсходящихСообщений(); 
		Если ОчиститьРегистрОтправленныеСообщения И СписокСтатусовОчередиИсходящих.Найти(СтатусОтправкиСообщения) = Неопределено Тогда 
			 ОчиститьРегистрОтправленныеСообщения(СтрокаВыгрузки.СсылкаНаОбъект, СтрокаВыгрузки.СпособПередачи); 
		 Иначе
			 спРаботаСДаннымиВызовСервера.ПоместитьВОтправленныеСообщения(СтрокаВыгрузки.СсылкаНаОбъект, СтрокаВыгрузки.СпособПередачи);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры   

&НаСервере
