&НаСервере
Процедура УдалениеСообщенийНаСервере()   
	
	ТаблицаИдентификаторСобытия = ТаблицаСтатусовСообщений.Выгрузить(, "ИдентификаторСобытия");
	
	 Для каждого СтрокаТаблицаСтатусовСообщений Из ТаблицаСтатусовСообщений Цикл
		 Если СтрокаТаблицаСтатусовСообщений.Флажок Тогда  
			 УдалитьЗаписиСообщенийИзРегистров(СтрокаТаблицаСтатусовСообщений.СсылкаНаОбъект, СтрокаТаблицаСтатусовСообщений.СпособПередачи, СтрокаТаблицаСтатусовСообщений.ИдентификаторСобытия)
		 КонецЕсли;
	 КонецЦикла;
	 
	 ТаблицаСтатусовСообщений.Очистить();
	 ЗаполнитьТаблицуТаблицаСтатусовСообщений(ТаблицаИдентификаторСобытия);
КонецПроцедуры

&НаСервере
Процедура УдалитьЗаписиСообщенийИзРегистров(СсылкаНаОбъект, СпособПередачи, ИдентификаторСобытия)  
	Если ОчиститьРегистрОтправленныеСообщенияПриУдалении Тогда 
		ОчиститьРегистрОтправленныеСообщения(СсылкаНаОбъект, СпособПередачи);  
	КонецЕсли;
	
	ОчиститьРегистрОчередьИсходящихСообщений(ИдентификаторСобытия);  
	
	ОчиститьРегистрСостояниеСообщений(ИдентификаторСобытия);  
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьТаблицуТаблицаСтатусовСообщений(ТаблицаИдентификаторСобытия)
	Запрос = Новый Запрос();
	Запрос.Текст = 
	
	"ВЫБРАТЬ
	|	ТаблицаИдентификаторСобытия.ИдентификаторСобытия КАК ИдентификаторСобытия
	|ПОМЕСТИТЬ ВнутренняяТаблицаТаблицаИдентификаторСобытияИдентификаторСобытия
	|ИЗ
	|	&ТаблицаИдентификаторСобытия КАК ТаблицаИдентификаторСобытия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	спСостояниеСообщений.ИдентификаторСобытия КАК ИдентификаторСобытия,
	|	ПРЕДСТАВЛЕНИЕ(спОчередьИсходящихСообщений.ИдентификаторСобытия) КАК ИдентификаторСобытияСтрока,
	|	спСостояниеСообщений.СтатусСообщения КАК СтатусСообщения,
	|	спОчередьИсходящихСообщений.СсылкаНаОбъект КАК СсылкаНаОбъект,
	|	спОчередьИсходящихСообщений.СпособПередачи КАК СпособПередачи,
	|	спОчередьИсходящихСообщений.ДатаРегистрации КАК ДатаРегистрации,
	|	спОчередьИсходящихСообщений.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект
	|ИЗ
	|	РегистрСведений.спСостояниеСообщений КАК спСостояниеСообщений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спОчередьИсходящихСообщений КАК спОчередьИсходящихСообщений
	|		ПО спСостояниеСообщений.ИдентификаторСобытия = спОчередьИсходящихСообщений.ИдентификаторСобытия
	|ГДЕ
	|	спСостояниеСообщений.ИдентификаторСобытия В
	|			(ВЫБРАТЬ
	|				ВнутренняяТаблицаТаблицаИдентификаторСобытияИдентификаторСобытия.ИдентификаторСобытия КАК ИдентификаторСобытия
	|			ИЗ
	|				ВнутренняяТаблицаТаблицаИдентификаторСобытияИдентификаторСобытия КАК ВнутренняяТаблицаТаблицаИдентификаторСобытияИдентификаторСобытия)";  
	
	Запрос.УстановитьПараметр("ТаблицаИдентификаторСобытия", ТаблицаИдентификаторСобытия); 
	
	Выгрузка = Запрос.Выполнить().Выгрузить();  
	ТаблицаСтатусовСообщений.Загрузить(Выгрузка);
КонецПроцедуры

&НаКлиенте
Процедура УдалениеСообщений(Команда)
	УдалениеСообщенийНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСтатусовСообщенийПриИзменении(Элемент)
	ТекущиеДанныеТаблицаСтатусовСообщений = Элементы.ТаблицаСтатусовСообщений.ТекущиеДанные;
	Если ТекущиеДанныеТаблицаСтатусовСообщений <> Неопределено И ЗначениеЗаполнено(ТекущиеДанныеТаблицаСтатусовСообщений.СсылкаНаОбъект) Тогда 
		ТекущиеДанныеИзЗапроса = ТаблицаСтатусовСообщенийПриИзмененииПриИзмененииНаСервере(ТекущиеДанныеТаблицаСтатусовСообщений.СсылкаНаОбъект); 
		ТекущиеДанныеТаблицаСтатусовСообщений.ДатаРегистрации 					= ТекущиеДанныеИзЗапроса.ДатаРегистрации;
        ТекущиеДанныеТаблицаСтатусовСообщений.ИдентификаторСобытия 				= ТекущиеДанныеИзЗапроса.ИдентификаторСобытия;
		ТекущиеДанныеТаблицаСтатусовСообщений.ИдентификаторСобытияСтрока 		= ТекущиеДанныеИзЗапроса.ИдентификаторСобытияСтрока;
		ТекущиеДанныеТаблицаСтатусовСообщений.СпособПередачи 					= ТекущиеДанныеИзЗапроса.СпособПередачи;
		ТекущиеДанныеТаблицаСтатусовСообщений.СтатусСообщения 					= ТекущиеДанныеИзЗапроса.СтатусСообщения;
		ТекущиеДанныеТаблицаСтатусовСообщений.ИнициаторОтправкиСсылкаНаОбъект   = ТекущиеДанныеИзЗапроса.ИнициаторОтправкиСсылкаНаОбъект;

	КонецЕсли;

КонецПроцедуры

Функция ТаблицаСтатусовСообщенийПриИзмененииПриИзмененииНаСервере(СсылкаНаОбъект) 
	ПараметрСпособПередачи = Перечисления.спСпособПередачи.FTP;	
	
	ТекущиеДанные = Новый Структура("ДатаРегистрации, ИдентификаторСобытия, ИдентификаторСобытияСтрока, СсылкаНаОбъект, СпособПередачи, СтатусСообщения, ИнициаторОтправкиСсылкаНаОбъект");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
		|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	ПРЕДСТАВЛЕНИЕ(тбОчередь.ИдентификаторСобытия) КАК ИдентификаторСобытияСтрока,
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбОчередь.СпособПередачи КАК СпособПередачи,
		|	тбСостояние.СтатусСообщения КАК СтатусСообщения,
		|	тбОчередь.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|ГДЕ
		|	тбОчередь.СсылкаНаОбъект = &СсылкаНаОбъект
		|	И тбОчередь.СпособПередачи = &СпособПередачи";
	
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект); 
	Запрос.УстановитьПараметр("СпособПередачи", ПараметрСпособПередачи);

	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекущиеДанные.Вставить("ДатаРегистрации", ВыборкаДетальныеЗаписи.ДатаРегистрации);
		ТекущиеДанные.Вставить("ИдентификаторСобытия", ВыборкаДетальныеЗаписи.ИдентификаторСобытия );
		ТекущиеДанные.Вставить("ИдентификаторСобытияСтрока", ВыборкаДетальныеЗаписи.ИдентификаторСобытияСтрока );
		ТекущиеДанные.Вставить("СсылкаНаОбъект", ВыборкаДетальныеЗаписи.СсылкаНаОбъект );
		ТекущиеДанные.Вставить("СпособПередачи", ВыборкаДетальныеЗаписи.СпособПередачи );
		ТекущиеДанные.Вставить("СтатусСообщения", ВыборкаДетальныеЗаписи.СтатусСообщения );  
		ТекущиеДанные.Вставить("ИнициаторОтправкиСсылкаНаОбъект", ВыборкаДетальныеЗаписи.ИнициаторОтправкиСсылкаНаОбъект );

	КонецЦикла;
	
	Возврат ТекущиеДанные;	
КонецФункции

