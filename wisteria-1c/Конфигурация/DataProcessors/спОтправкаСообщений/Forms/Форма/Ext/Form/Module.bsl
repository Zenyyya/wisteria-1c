&НаСервере
Функция ТаблицаИнициаторыОтправкиПриИзмененииНаСервере(СсылкаНаОбъект) 
	
	ПараметрСпособПередачи = Перечисления.спСпособПередачи.FTP;	
	
	ТекущиеДанные = Новый Структура("ДатаРегистрации, ИдентификаторСобытия, ИдентификаторСобытияСтрока, СсылкаНаОбъект, СпособПередачи, СтатусСообщения");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
		|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	ПРЕДСТАВЛЕНИЕ(тбОчередь.ИдентификаторСобытия) КАК ИдентификаторСобытияСтрока,
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбОчередь.СпособПередачи КАК СпособПередачи,
		|	тбСостояние.СтатусСообщения КАК СтатусСообщения
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|ГДЕ
		|	тбОчередь.СсылкаНаОбъект = &СсылкаНаОбъект
		|	И тбОчередь.СпособПередачи = &СпособПередачи";
	
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект); 
	Запрос.УстановитьПараметр("СпособПередачи", ПараметрСпособПередачи);

	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекущиеДанные.Вставить("ДатаРегистрации", ВыборкаДетальныеЗаписи.ДатаРегистрации);
		ТекущиеДанные.Вставить("ИдентификаторСобытия", ВыборкаДетальныеЗаписи.ИдентификаторСобытия );
		ТекущиеДанные.Вставить("ИдентификаторСобытияСтрока", ВыборкаДетальныеЗаписи.ИдентификаторСобытияСтрока );
		ТекущиеДанные.Вставить("СсылкаНаОбъект", ВыборкаДетальныеЗаписи.СсылкаНаОбъект );
		ТекущиеДанные.Вставить("СпособПередачи", ВыборкаДетальныеЗаписи.СпособПередачи );
		ТекущиеДанные.Вставить("СтатусСообщения", ВыборкаДетальныеЗаписи.СтатусСообщения );
	КонецЦикла;
	
	Возврат ТекущиеДанные;
КонецФункции

&НаКлиенте
Процедура ТаблицаИнициаторыОтправкиПриИзменении(Элемент)
	ТекущиеДанныеТаблицаИнициаторыОтправки = Элементы.ТаблицаИнициаторыОтправки.ТекущиеДанные;
	Если ТекущиеДанныеТаблицаИнициаторыОтправки <> Неопределено И ЗначениеЗаполнено(ТекущиеДанныеТаблицаИнициаторыОтправки.СсылкаНаОбъект) Тогда 
		ТекущиеДанныеИзЗапроса = ТаблицаИнициаторыОтправкиПриИзмененииНаСервере(ТекущиеДанныеТаблицаИнициаторыОтправки.СсылкаНаОбъект); 
		ТекущиеДанныеТаблицаИнициаторыОтправки.ДатаРегистрации 				= ТекущиеДанныеИзЗапроса.ДатаРегистрации;
        ТекущиеДанныеТаблицаИнициаторыОтправки.ИдентификаторСобытия 		= ТекущиеДанныеИзЗапроса.ИдентификаторСобытия;
		ТекущиеДанныеТаблицаИнициаторыОтправки.ИдентификаторСобытияСтрока 	= ТекущиеДанныеИзЗапроса.ИдентификаторСобытияСтрока;
		ТекущиеДанныеТаблицаИнициаторыОтправки.СпособПередачи 				= ТекущиеДанныеИзЗапроса.СпособПередачи;
		ТекущиеДанныеТаблицаИнициаторыОтправки.СтатусСообщения 				= ТекущиеДанныеИзЗапроса.СтатусСообщения;
	КонецЕсли;
	
	ПроверитьВозможностьОтправкиТаблицаИнициаторыОтправкиНаСервере();
КонецПроцедуры

&НаСервере
Процедура КонтекстноеПодменюЗаполнитьТаблицуПодчиненныеНаОснованииНаСервере(СсылкаНаОбъект)

	ПараметрСпособПередачи = Перечисления.спСпособПередачи.FTP;		
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект) И ЗначениеЗаполнено(ПараметрСпособПередачи) Тогда  
		
		НоваяТаблицаПодчиненныеСообщения = ТаблицаПодчиненныеСообщения.Выгрузить(, "ДатаРегистрации, ИдентификаторСобытия, ИдентификаторСобытияСтрока, СсылкаНаОбъект, СпособПередачи, СтатусСообщения, ИнициаторОтправкиСсылкаНаОбъект"); 
		
		Для каждого СтрокаТаблицаПодчиненныеСообщения Из ТаблицаПодчиненныеСообщения Цикл
		    Если СтрокаТаблицаПодчиненныеСообщения.СсылкаНаОбъект <> СсылкаНаОбъект Тогда   
				НоваяСтрока = НоваяТаблицаПодчиненныеСообщения.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицаПодчиненныеСообщения); 
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаПодчиненныеСообщения.Очистить(); 
		ТаблицаПодчиненныеСообщения.Загрузить(НоваяТаблицаПодчиненныеСообщения);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
		|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	ПРЕДСТАВЛЕНИЕ(тбОчередь.ИдентификаторСобытия) КАК ИдентификаторСобытияСтрока,
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбОчередь.СпособПередачи КАК СпособПередачи,
		|	тбСостояние.СтатусСообщения КАК СтатусСообщения,
		|	тбОчередь.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|			И (тбОчередь.ИнициаторОтправкиСсылкаНаОбъект = &СсылкаНаОбъект)"; 
		
		Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
		Запрос.УстановитьПараметр("СпособПередачи", ПараметрСпособПередачи);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НоваяСтрока = ТаблицаПодчиненныеСообщения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи); 
		КонецЦикла; 
		
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура КонтекстноеПодменюЗаполнитьТаблицуПодчиненныеНаОсновании(Команда)  
	ТекущиеДанныеТаблицаИнициаторыОтправки = Элементы.ТаблицаИнициаторыОтправки.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанныеТаблицаИнициаторыОтправки.СсылкаНаОбъект) Тогда 
		КонтекстноеПодменюЗаполнитьТаблицуПодчиненныеНаОснованииНаСервере(ТекущиеДанныеТаблицаИнициаторыОтправки.СсылкаНаОбъект);  
	КонецЕсли;
КонецПроцедуры

