		ИначеЕсли ИсходящиеСообщеняСоСтатусамиДокумент.СтатусСообщения = Перечисления.спСтатусыСообщений.НеВалидно Тогда 
			НоваяСтрока.Статус = СтатусыОтправки.ОшибкаДанныхСообшения; 
							
		ИначеЕсли СтатусыСообщенийНоменклатуры = Перечисления.спСтатусыСообщений.НеВалидно Тогда 
			НоваяСтрока.Статус = СтатусыОтправки.ОшибкаДанныхСообшенияНоменклатуры;  
			
		ИначеЕсли ИсходящиеСообщеняСоСтатусамиДокумент.СтатусСообщения = Перечисления.спСтатусыСообщений.ОшибкаПодтверждения Тогда 
			НоваяСтрока.Статус = СтатусыОтправки.ОшибкаДанныхСообшения; 	
						
		ИначеЕсли СтатусыСообщенийНоменклатуры = Перечисления.спСтатусыСообщений.ОшибкаПодтверждения Тогда 
			НоваяСтрока.Статус = СтатусыОтправки.ОшибкаДанныхСообшенияНоменклатуры; 
			
		ИначеЕсли ИсходящиеСообщеняСоСтатусамиДокумент.СтатусСообщения = Перечисления.спСтатусыСообщений.ОшибкаОтправки 
			ИЛИ ИсходящиеСообщеняСоСтатусамиДокумент.СтатусСообщения = Перечисления.спСтатусыСообщений.ОшибкаОбработки Тогда
			НоваяСтрока.Статус = СтатусыОтправки.ОшибкаОтправки;

		
		ИначеЕсли ИсходящиеСообщеняСоСтатусамиДокумент.СтатусСообщения = Перечисления.спСтатусыСообщений.ОжиданиеОбработки
			ИЛИ ИсходящиеСообщеняСоСтатусамиДокумент.СтатусСообщения = Перечисления.спСтатусыСообщений.ВОбработке Тогда 
			
			ВремяСНачалаОбработки = ТекущаяДатаСеанса() - ИсходящиеСообщеняСоСтатусамиДокумент.ДатаРегистрации;
			Если ВремяСНачалаОбработки > 3 * 60 Тогда  
				НоваяСтрока.Статус = СтатусыОтправки.ОшибкаОтправки;
			Иначе  
				НоваяСтрока.Статус = СтатусыОтправки.ОжидаетОтправки;
			КонецЕсли;
			
		ИначеЕсли СтатусыСообщенийНоменклатуры = Перечисления.спСтатусыСообщений.ОшибкаОбработки 
			ИЛИ СтатусыСообщенийНоменклатуры = Перечисления.спСтатусыСообщений.ОшибкаОтправки 
			ИЛИ СтатусыСообщенийНоменклатуры = Перечисления.спСтатусыСообщений.ОжиданиеОбработки 
			ИЛИ СтатусыСообщенийНоменклатуры = Перечисления.спСтатусыСообщений.ВОбработке Тогда
			НоваяСтрока.Статус = СтатусыОтправки.ОжидаетОтправкиНоменклатуры;

				
		КонецЕсли;

	КонецЦикла;
	
	ЗапросДляОтправкиНоменклатура = Новый Запрос;  
	ЗапросДляОтправкиНоменклатура.МенеджерВременныхТаблиц = МВТ;
	ЗапросДляОтправкиНоменклатура.Текст = 
		"ВЫБРАТЬ
		|	ОчередьИсходящихСообщений.Документ КАК Документ,
		|	ОчередьИсходящихСообщений.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	ОчередьИсходящихСообщений.ДатаРегистрации КАК ДатаРегистрации,
		|	ОчередьИсходящихСообщений.ФорматСообщения КАК ФорматСообщения,
		|	ОчередьИсходящихСообщений.МетодХранения КАК МетодХранения,
		|	ОчередьИсходящихСообщений.ОбъектСобытия КАК ОбъектСобытия,
		|	ОчередьИсходящихСообщений.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	ОчередьИсходящихСообщений.СпособПередачи КАК СпособПередачи,
		|	ОчередьИсходящихСообщений.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект,
		|	ОчередьИсходящихСообщений.СтатусСообщения КАК СтатусСообщения,
		|	ОчередьИсходящихСообщений.ОписаниеДанных КАК ОписаниеДанных,
		|	ОчередьИсходящихСообщений.Хранилище КАК Хранилище
		|ПОМЕСТИТЬ ВТ_ИсходящииСообщения
		|ИЗ
		|	ВТСообщеняСоСтатусамиДляОтправкиНоменклатура КАК ОчередьИсходящихСообщений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ИсходящииСообщения.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	МАКСИМУМ(ВТ_ИсходящииСообщения.Документ) КАК Документ
		|ПОМЕСТИТЬ ВТ_ИнициаторОтправкиСсылкаНаОбъектМаксимум
		|ИЗ
		|	ВТ_ИсходящииСообщения КАК ВТ_ИсходящииСообщения
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ИсходящииСообщения.СсылкаНаОбъект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ИсходящииСообщения.Документ КАК Документ,
		|	ВТ_ИсходящииСообщения.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	ВТ_ИсходящииСообщения.ДатаРегистрации КАК ДатаРегистрации,
		|	ВТ_ИсходящииСообщения.ФорматСообщения КАК ФорматСообщения,
		|	ВТ_ИсходящииСообщения.МетодХранения КАК МетодХранения,
		|	ВТ_ИсходящииСообщения.ОбъектСобытия КАК ОбъектСобытия,
		|	ВТ_ИсходящииСообщения.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	ВТ_ИсходящииСообщения.СпособПередачи КАК СпособПередачи,
		|	ВТ_ИсходящииСообщения.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект,
		|	ВТ_ИсходящииСообщения.СтатусСообщения КАК СтатусСообщения,
		|	ВТ_ИсходящииСообщения.ОписаниеДанных КАК ОписаниеДанных,
		|	ВТ_ИсходящииСообщения.Хранилище КАК Хранилище
		|ИЗ
		|	ВТ_ИнициаторОтправкиСсылкаНаОбъектМаксимум КАК ИнициаторОтправкиСсылкаНаОбъектМаксимум
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ИсходящииСообщения КАК ВТ_ИсходящииСообщения
		|		ПО ИнициаторОтправкиСсылкаНаОбъектМаксимум.СсылкаНаОбъект = ВТ_ИсходящииСообщения.СсылкаНаОбъект
		|			И ИнициаторОтправкиСсылкаНаОбъектМаксимум.Документ = ВТ_ИсходящииСообщения.Документ";
			
	ВыгрузкаНоменклатура = ЗапросДляОтправкиНоменклатура.Выполнить().Выгрузить(); 
	
	СписокСтатусовДляОтправки = спКэшируемыеФункцииВызовСервера.ПоучитьСписокСтатусовДляОтправки(); 
	
	ВыгрузкаНоменклатураПоДокументуСвертка = ВыгрузкаНоменклатура.Скопировать();
	ВыгрузкаНоменклатураПоДокументуСвертка.Свернуть("Документ", );
	
	ВыгрузкаНоменклатураСвертка = ВыгрузкаНоменклатура.Скопировать();	
	ВыгрузкаНоменклатураСвертка.Свернуть("ИдентификаторСобытия, Документ, ФорматСообщения, МетодХранения, ОбъектСобытия, СсылкаНаОбъект, СпособПередачи, ИнициаторОтправкиСсылкаНаОбъект, СтатусСообщения",);	
	ВыгрузкаНоменклатураСвертка.Колонки.Добавить("ОтправкаСообщения", Новый ОписаниеТипов("Булево"));
	
	
	НоменклатураДляОтправки = Новый Массив;
	
	Для каждого СверткаДокумент Из ВыгрузкаНоменклатураПоДокументуСвертка Цикл
	
		НайденыеСтроки = ВыгрузкаНоменклатура.НайтиСтроки(Новый Структура("Документ", СверткаДокумент.Документ));
		ОтменаОтправки = Ложь;
		Если НайденыеСтроки.Количество() > 0 Тогда  
			Для каждого НайденаяСтрока Из НайденыеСтроки Цикл  
				
				Если НайденаяСтрока.СтатусСообщения = Перечисления.спСтатусыСообщений.ВОбработке Тогда 	
					ВремяСНачалаОбработки = ТекущаяДатаСеанса() - НайденаяСтрока.ДатаРегистрации;
					Если ВремяСНачалаОбработки < 3 * 60 Тогда  
						ОтменаОтправки = Истина;
					КонецЕсли;
				КонецЕсли;	
				
				Если СписокСтатусовДляОтправки.Найти(НайденаяСтрока.СтатусСообщения) = Неопределено Тогда 
					ОтменаОтправки = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если Не ОтменаОтправки Тогда 
			НайденыеСтроки = ВыгрузкаНоменклатураСвертка.НайтиСтроки(Новый Структура("Документ", СверткаДокумент.Документ));
			Если НайденыеСтроки.Количество() > 0 Тогда
				
				СообщеняСоСтатусамиДляОтправкиНоменклатура = Новый Массив;
				
				Для каждого НайденаяСтрока Из НайденыеСтроки Цикл
					
					СообщениеОтправки = Новый Структура;
					СообщениеОтправки.Вставить("ОтправкаСообщения", Истина);
					СообщениеОтправки.Вставить("Документ", НайденаяСтрока.Документ);
					СообщениеОтправки.Вставить("ИдентификаторСобытия", НайденаяСтрока.ИдентификаторСобытия);
					СообщениеОтправки.Вставить("ФорматСообщения", НайденаяСтрока.ФорматСообщения);
					СообщениеОтправки.Вставить("МетодХранения", НайденаяСтрока.МетодХранения);
					СообщениеОтправки.Вставить("ОбъектСобытия",  НайденаяСтрока.ОбъектСобытия);
					СообщениеОтправки.Вставить("СсылкаНаОбъект", НайденаяСтрока.СсылкаНаОбъект);
					СообщениеОтправки.Вставить("СпособПередачи", НайденаяСтрока.СпособПередачи);
					СообщениеОтправки.Вставить("ИнициаторОтправкиСсылкаНаОбъект", НайденаяСтрока.ИнициаторОтправкиСсылкаНаОбъект);
					СообщениеОтправки.Вставить("СтатусСообщения", НайденаяСтрока.СтатусСообщения); 
					
					
					СтрокиНайденые = ВыгрузкаНоменклатура.НайтиСтроки(Новый Структура("ИдентификаторСобытия", НайденаяСтрока.ИдентификаторСобытия));
					Если СтрокиНайденые.Количество() > 0 Тогда
						СообщениеОтправки.Вставить("ДатаРегистрации", 	СтрокиНайденые[0].ДатаРегистрации);
						СообщениеОтправки.Вставить("ОписаниеДанных", 	СтрокиНайденые[0].ОписаниеДанных); 
						СообщениеОтправки.Вставить("Хранилище",      	СтрокиНайденые[0].Хранилище);
						
					КонецЕсли;
					
					СообщеняСоСтатусамиДляОтправкиНоменклатура.Добавить(СообщениеОтправки);
					
				КонецЦикла;
				
				СообщенияНоменклатуры = Новый Структура("ИнициаторОтправки, НоменклатураОтправки");
				СообщенияНоменклатуры.Вставить("ИнициаторОтправки", СверткаДокумент.Документ);
				СообщенияНоменклатуры.Вставить("НоменклатураОтправки", СообщеняСоСтатусамиДляОтправкиНоменклатура); 
				НоменклатураДляОтправки.Добавить(СообщенияНоменклатуры);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЗапросДляОтправкиНоменклатура = Новый Запрос("ВЫБРАТЬ * ИЗ ВТСообщеняСоСтатусамиДляОтправкиНоменклатура"); 
	ЗапросДляОтправкиНоменклатура.МенеджерВременныхТаблиц = МВТ;
	НоменклатураСтатус = ЗапросДляОтправкиНоменклатура.Выполнить().Выгрузить();

	ЗапросДляОтправкиДокументов = Новый Запрос("ВЫБРАТЬ * ИЗ ВТСообщеняСоСтатусамиДляОтправкиДокументов");
	
	ЗапросДляОтправкиДокументов.МенеджерВременныхТаблиц = МВТ;
	
	ВыгрузкаДокументы = ЗапросДляОтправкиДокументов.Выполнить().Выгрузить();
	
	СообщеняСоСтатусамиДляОтправкиДокументов = Новый Массив;
	
	Для каждого СтрокаВыгрузки Из ВыгрузкаДокументы Цикл
		
		ОтправкаПодтверждена = Истина;
		НайденыеСтроки = НоменклатураСтатус.НайтиСтроки(Новый Структура("Документ", СтрокаВыгрузки.СсылкаНаОбъект));
		Если НайденыеСтроки.Количество() > 0 Тогда
			Для каждого НайденаяСтрока Из НайденыеСтроки Цикл  				
				Если НайденаяСтрока.СтатусСообщения <> ПредопределенноеЗначение("Перечисление.спСтатусыСообщений.ОтправкаПодтверждена") Тогда  
					ОтправкаПодтверждена = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;  
					
		Если СтрокаВыгрузки.СтатусСообщения = Перечисления.спСтатусыСообщений.ВОбработке Тогда 	
			ВремяСНачалаОбработки = ТекущаяДатаСеанса() - СтрокаВыгрузки.ДатаРегистрации;
			Если ВремяСНачалаОбработки < 3 * 60 Тогда  
				ОтправкаПодтверждена = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ОтправкаПодтверждена Тогда 
			Продолжить;
		КонецЕсли;
		
		СообщениеОтправки = Новый Структура;
		СообщениеОтправки.Вставить("ИдентификаторСобытия", СтрокаВыгрузки.ИдентификаторСобытия);
		СообщениеОтправки.Вставить("ДатаРегистрации", СтрокаВыгрузки.ДатаРегистрации);
		СообщениеОтправки.Вставить("ФорматСообщения", СтрокаВыгрузки.ФорматСообщения);
		СообщениеОтправки.Вставить("МетодХранения", СтрокаВыгрузки.МетодХранения);
		СообщениеОтправки.Вставить("ОбъектСобытия",  СтрокаВыгрузки.ОбъектСобытия);
		СообщениеОтправки.Вставить("СсылкаНаОбъект", СтрокаВыгрузки.СсылкаНаОбъект);
		СообщениеОтправки.Вставить("СпособПередачи", СтрокаВыгрузки.СпособПередачи);
		СообщениеОтправки.Вставить("ИнициаторОтправкиСсылкаНаОбъект", СтрокаВыгрузки.ИнициаторОтправкиСсылкаНаОбъект);
		СообщениеОтправки.Вставить("СтатусСообщения", СтрокаВыгрузки.СтатусСообщения);
		СообщениеОтправки.Вставить("ОписаниеДанных", СтрокаВыгрузки.ОписаниеДанных); 
		СообщениеОтправки.Вставить("Хранилище",      СтрокаВыгрузки.Хранилище);  

		СообщеняСоСтатусамиДляОтправкиДокументов.Добавить(СообщениеОтправки);
		
	КонецЦикла;
	
	СообщеняОтправки = Новый Структура("СообщеняНоменклатура, СообщеняДокументов");
	СообщеняОтправки.Вставить("СообщеняНоменклатура", НоменклатураДляОтправки);
	СообщеняОтправки.Вставить("СообщеняДокументов", СообщеняСоСтатусамиДляОтправкиДокументов);
 	Возврат СообщеняОтправки;
	
КонецФункции 

&НаСервере
Функция СериализоватьВJSON(Значение)
    
    Настройки = Новый НастройкиСериализацииJSON();
    Настройки.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
    Настройки.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДата;
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Значение, Настройки);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    
    Возврат СтрокаJSON;
    
КонецФункции

&НаСервере
Функция ПроверитьСтатусНоменклатуры(ТекущийДокумент)
	СтатусыСообщений = Неопределено; 
	
	СообщенияВыгрузка = Объект.Сообщения.Выгрузить(,"СсылкаНаОбъектДокумент, СтатусСообщенияНоменклатура");
	СообщенияВыгрузка.Свернуть("СсылкаНаОбъектДокумент, СтатусСообщенияНоменклатура");
	
	ПоискСтатусаОшибкаОтправки = Новый Структура(); 
	ПоискСтатусаОшибкаОтправки.Вставить("СсылкаНаОбъектДокумент", ТекущийДокумент);
	ПоискСтатусаОшибкаОтправки.Вставить("СтатусСообщенияНоменклатура", Перечисления.спСтатусыСообщений.ОшибкаОтправки);  

	ПоискСтатусаОшибкаОбработки = Новый Структура(); 
	ПоискСтатусаОшибкаОбработки.Вставить("СсылкаНаОбъектДокумент", ТекущийДокумент);
	ПоискСтатусаОшибкаОбработки.Вставить("СтатусСообщенияНоменклатура", Перечисления.спСтатусыСообщений.ОшибкаОбработки);

	ПоискСтатусаНовое = Новый Структура(); 
	ПоискСтатусаНовое.Вставить("СсылкаНаОбъектДокумент", ТекущийДокумент);
	ПоискСтатусаНовое.Вставить("СтатусСообщенияНоменклатура", Перечисления.спСтатусыСообщений.Новое);  

	ПоискСтатусаОтправлено = Новый Структура(); 
	ПоискСтатусаОтправлено.Вставить("СсылкаНаОбъектДокумент", ТекущийДокумент);
	ПоискСтатусаОтправлено.Вставить("СтатусСообщенияНоменклатура", Перечисления.спСтатусыСообщений.Отправлено);   
	
	ПоискСтатусаОтправкаПодтверждена = Новый Структура(); 
	ПоискСтатусаОтправкаПодтверждена.Вставить("СсылкаНаОбъектДокумент", ТекущийДокумент);
	ПоискСтатусаОтправкаПодтверждена.Вставить("СтатусСообщенияНоменклатура", Перечисления.спСтатусыСообщений.ОтправкаПодтверждена);  
	
	ПоискСтатусаНеВалидно = Новый Структура(); 
	ПоискСтатусаНеВалидно.Вставить("СсылкаНаОбъектДокумент", ТекущийДокумент);
	ПоискСтатусаНеВалидно.Вставить("СтатусСообщенияНоменклатура", Перечисления.спСтатусыСообщений.НеВалидно); 
	
	ПоискСтатусаОшибкаПодтверждения = Новый Структура(); 
	ПоискСтатусаОшибкаПодтверждения.Вставить("СсылкаНаОбъектДокумент", ТекущийДокумент);
	ПоискСтатусаОшибкаПодтверждения.Вставить("СтатусСообщенияНоменклатура", Перечисления.спСтатусыСообщений.ОшибкаПодтверждения);  
	
	ПоискСтатусаОжиданиеОбработки = Новый Структура(); 
	ПоискСтатусаОжиданиеОбработки.Вставить("СсылкаНаОбъектДокумент", ТекущийДокумент);
	ПоискСтатусаОжиданиеОбработки.Вставить("СтатусСообщенияНоменклатура", Перечисления.спСтатусыСообщений.ОжиданиеОбработки); 
	
	ПоискСтатусаВОбработке = Новый Структура(); 
	ПоискСтатусаВОбработке.Вставить("СсылкаНаОбъектДокумент", ТекущийДокумент);
	ПоискСтатусаВОбработке.Вставить("СтатусСообщенияНоменклатура", Перечисления.спСтатусыСообщений.ВОбработке);
	
	НайденыеСтрокиСтатусаОжиданиеОбработки = СообщенияВыгрузка.НайтиСтроки(ПоискСтатусаОжиданиеОбработки);
	Если НайденыеСтрокиСтатусаОжиданиеОбработки.Количество() > 0 Тогда
		Возврат Перечисления.спСтатусыСообщений.ОшибкаОбработки; 
	КонецЕсли; 
	
	НайденыеСтрокиСтатусаВОбработке = СообщенияВыгрузка.НайтиСтроки(ПоискСтатусаВОбработке);
	Если НайденыеСтрокиСтатусаВОбработке.Количество() > 0 Тогда
		Возврат Перечисления.спСтатусыСообщений.ВОбработке; 
	КонецЕсли; 

	
	НайденыеСтрокиСтатусОшибкаОтправки = СообщенияВыгрузка.НайтиСтроки(ПоискСтатусаОшибкаОтправки);
	Если НайденыеСтрокиСтатусОшибкаОтправки.Количество() > 0 Тогда
		Возврат Перечисления.спСтатусыСообщений.ОшибкаОтправки; 
	КонецЕсли; 
	
	НайденыеСтрокиСтатусОшибкаОбработки = СообщенияВыгрузка.НайтиСтроки(ПоискСтатусаОшибкаОбработки);
	Если НайденыеСтрокиСтатусОшибкаОбработки.Количество() > 0 Тогда
		Возврат Перечисления.спСтатусыСообщений.ОшибкаОбработки; 
	КонецЕсли;  
	
	НайденыеСтрокиСтатусНовое = СообщенияВыгрузка.НайтиСтроки(ПоискСтатусаНовое);
	Если НайденыеСтрокиСтатусНовое.Количество() > 0 Тогда
		Возврат Перечисления.спСтатусыСообщений.Новое; 
	КонецЕсли; 
	
	НайденыеСтрокиСтатусОтправлено = СообщенияВыгрузка.НайтиСтроки(ПоискСтатусаОтправлено);
	Если НайденыеСтрокиСтатусОтправлено.Количество() > 0 Тогда
		Возврат Перечисления.спСтатусыСообщений.Отправлено;
	КонецЕсли; 
	
	НайденыеСтрокиСтатусОтправкаПодтверждена = СообщенияВыгрузка.НайтиСтроки(ПоискСтатусаОтправкаПодтверждена);
	Если НайденыеСтрокиСтатусОтправкаПодтверждена.Количество() > 0 Тогда
		Возврат Перечисления.спСтатусыСообщений.ОтправкаПодтверждена; 
	КонецЕсли;  
	
	НайденыеСтрокиСтатусНеВалидно = СообщенияВыгрузка.НайтиСтроки(ПоискСтатусаНеВалидно);
	Если НайденыеСтрокиСтатусНеВалидно.Количество() > 0 Тогда
		Возврат Перечисления.спСтатусыСообщений.НеВалидно; 
	КонецЕсли; 

	НайденыеСтрокиСтатусОшибкаПодтверждения = СообщенияВыгрузка.НайтиСтроки(ПоискСтатусаОшибкаПодтверждения);
	Если НайденыеСтрокиСтатусОшибкаПодтверждения.Количество() > 0 Тогда
		Возврат Перечисления.спСтатусыСообщений.ОшибкаПодтверждения; 
	КонецЕсли;
	
	Возврат СтатусыСообщений;
КонецФункции

&НаКлиенте
Процедура ОбновитьСтатусы(Команда)
	Состояние("Подождите. Идет обработка");  
	ИменаФайлов = ПолучитьИменаФайловДляПодтверждения();
	спСервисИнтеграцииКлиент.ПроверитьОбработкуСообщенийНоменклатуры(ИменаФайлов);
	СообщеняОтправки = ОбновитьСтатусыНаСервере(); 
	
	ЭтаФорма.ТекущийЭлемент = ЭтаФорма.Элементы.ДокументыНомерСтроки;
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьСтатусыПроверитьОбработкуСообщений()  
	Если АвтоматическоеОбновление Тогда
		
		Состояние("Подождите. Идет обработка");
		
		Если Элементы.ГруппаОбновления.ЦветФона = WebЦвета.Красный Тогда 
			Элементы.ГруппаОбновления.ЦветФона = Новый Цвет();
		Иначе 
			Элементы.ГруппаОбновления.ЦветФона = WebЦвета.Красный; 
		КонецЕсли;
		ИменаФайлов = ПолучитьИменаФайловДляПодтверждения();
		спСервисИнтеграцииКлиент.ПроверитьОбработкуСообщенийНоменклатуры(ИменаФайлов);
		
		СообщеняОтправки = ОбновитьСтатусыНаСервере(); 
		АвтоматическаяОтправкаСообщенийНоменклатурыДокументов(СообщеняОтправки); 
		
		ЭтаФорма.ТекущийЭлемент = ЭтаФорма.Элементы.ДокументыНомерСтроки;
	КонецЕсли; 	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСообщенияНоменклатура(Команда) 
	
	Состояние("Подождите. Идет обработка"); 

	Если ТипЗнч(СообщеняОтправки.СообщеняНоменклатура) = Тип("Массив") И СообщеняОтправки.СообщеняНоменклатура.Количество() > 0 Тогда
		
		Для каждого СтрокаСообщения Из СообщеняОтправки.СообщеняНоменклатура Цикл
			
			СтрокиПоиска = Объект.Документы.НайтиСтроки(Новый Структура("СсылкаНаОбъектДокумент", СтрокаСообщения.ИнициаторОтправки));
			Если СтрокиПоиска.Количество() > 0 Тогда  
				Если НЕ СтрокиПоиска[0].Флажек Тогда  
					Продолжить;
				КонецЕсли; 
			Иначе 
				Продолжить;
			КонецЕсли;
			спСервисИнтеграцииКлиент.ОтправитьСообщениеНоменклатурыПоsFTP(СтрокаСообщения.НоменклатураОтправки);
		КонецЦикла;
	КонецЕсли;
	
	СообщеняОтправки = ОбновитьСтатусыНаСервере(); 
	
	ЭтаФорма.ТекущийЭлемент = ЭтаФорма.Элементы.ДокументыНомерСтроки;
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСообщенияДокумент(Команда)  	
	СообщеняДокументов = Новый Массив;
	
	Состояние("Подождите. Идет обработка"); 
	
	Если ТипЗнч(СообщеняОтправки.СообщеняДокументов) = Тип("Массив") И СообщеняОтправки.СообщеняДокументов.Количество() > 0 Тогда  
		
		Для каждого СтрокаСообщения Из СообщеняОтправки.СообщеняДокументов Цикл
			
			СтрокиПоиска = Объект.Документы.НайтиСтроки(Новый Структура("СсылкаНаОбъектДокумент", СтрокаСообщения.СсылкаНаОбъект));
			Если СтрокиПоиска.Количество() > 0 Тогда  
				Если НЕ СтрокиПоиска[0].Флажек Тогда  
					Продолжить;  
				Иначе 
					СообщеняДокументов.Добавить(СтрокаСообщения);	
				КонецЕсли; 
			Иначе 
				Продолжить;
			КонецЕсли;
		КонецЦикла;    
		спСервисИнтеграцииКлиент.ОтправитьСообщениеДокументовПоsFTP(СообщеняДокументов);
	КонецЕсли;

	СообщеняОтправки = ОбновитьСтатусыНаСервере(); 
	
	ЭтаФорма.ТекущийЭлемент = ЭтаФорма.Элементы.ДокументыНомерСтроки;
КонецПроцедуры

&НаКлиенте
Процедура ТипОбъектаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = ЛОЖЬ;
	ДанныеВыбора = Новый СписокЗначений;
	ДанныеВыбора.Добавить(Тип("ДокументСсылка.ПриходнаяНакладная"),"Приходная накладная");
	ДанныеВыбора.Добавить(Тип("ДокументСсылка.ПеремещениеЗапасов"),"Перемещение запасов");	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)  
	Если Элемент.ТекущийЭлемент <> Неопределено И Элемент.ТекущийЭлемент.Имя = "ДокументыФлажек" Тогда  
		Возврат;
		
	ИначеЕсли  Элемент.ТекущийЭлемент <> Неопределено И Элемент.ТекущийЭлемент.Имя = "ДокументыТекстоваяИнформацияОшибки" Тогда 
		
		Информация = Элементы.Документы.ТекущиеДанные.Информация;
		ПараметрыВвода = Новый Структура("Информация, Документ");
		ПараметрыВвода.Вставить("Информация", Информация); 
		ПараметрыВвода.Вставить("Документ", Истина);
		
		ОткрытьФорму("Обработка.спОтправкаСообщений.Форма.ОтображениеИнформации", ПараметрыВвода,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе 
		
		СтандартнаяОбработка = Ложь;
		ТекущаяСтрока = Элементы.Документы.ТекущиеДанные;
		Если ТипЗнч(ТекущаяСтрока) = Тип("ДанныеФормыЭлементКоллекции") Тогда 
			
			ТекущийДокумент = ТекущаяСтрока.СсылкаНаОбъектДокумент; 
			СообщенийНоменклатуры = ТекущаяСтрока.СообщенийНоменклатуры;
			
			Если СообщенийНоменклатуры > 0 И ЗначениеЗаполнено(ТекущийДокумент) Тогда 
				Номенклатура = ПолучитьНоменклатуруПоТекущемуДокументу(ТекущийДокумент);
				ПараметрыВвода = Новый Структура("Номенклатура", Номенклатура);
				ОткрытьФорму("Обработка.спОтправкаСообщений.Форма.НоменклатурыДокумента", ПараметрыВвода,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьНоменклатуруПоТекущемуДокументу(ТекущийДокумент) 
	Номенклатура = Новый Массив;
	НайденыеСтроки = Объект.Сообщения.НайтиСтроки(Новый Структура("СсылкаНаОбъектДокумент", ТекущийДокумент));
	Если НайденыеСтроки.Количество() > 0 Тогда
		Для каждого НайденаяСтрока  Из НайденыеСтроки Цикл 
			Строка = Новый Структура;
			Строка.Вставить("СсылкаНаОбъектДокумент", 					НайденаяСтрока.СсылкаНаОбъектДокумент); 
			Строка.Вставить("ДатаИзмененияСтатусСообщенияНоменклатура",	НайденаяСтрока.ДатаРегистрацииНоменклатура);
			Строка.Вставить("СсылкаНаОбъектНоменклатура", 				НайденаяСтрока.СсылкаНаОбъектНоменклатура);
			Строка.Вставить("СтатусСообщенияНоменклатура",				НайденаяСтрока.СтатусСообщенияНоменклатура);
			Строка.Вставить("Статус",									НайденаяСтрока.Статус);
			Строка.Вставить("Информация",                               НайденаяСтрока.Информация);
		
			Номенклатура.Добавить(Строка);
		КонецЦикла;	
	КонецЕсли; 
	Возврат Номенклатура;
КонецФункции	

&НаСервере
Функция ПолучитьИменаФайловДляПодтверждения()
    ИменаФайлов = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тбОчередь.ИмяФайла КАК ИмяФайла,
		|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	тбОчередь.ОбъектСобытия КАК ОбъектСобытия,
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|			И (тбСостояние.ЗадержкаЧисло <= &ЗадержкаЧисло)
		|			И (тбСостояние.СтатусСообщения = &СтатусСообщения)
		|			И (тбОчередь.СпособПередачи = &СпособПередачи)
		|ГДЕ
		|	НЕ тбОчередь.ЭтоУдаление";
	
	Запрос.УстановитьПараметр("ЗадержкаЧисло", спОбщегоНазначенияВызовСервера.ПеревестиДатуВЧисло(ТекущаяДатаСеанса())); 
	Запрос.УстановитьПараметр("СтатусСообщения", Перечисления.спСтатусыСообщений.Отправлено);
	Запрос.УстановитьПараметр("СпособПередачи", Перечисления.спСпособПередачи.FTP);

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ИмяФайла) ИЛИ НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ИдентификаторСобытия) 
			ИЛИ НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СсылкаНаОбъект) Тогда  
			Продолжить; 
		КонецЕсли;
		СообщенияДляПодтверждения = Новый Структура;  
		СообщенияДляПодтверждения.Вставить("ИмяФайла", ВыборкаДетальныеЗаписи.ИмяФайла);
        СообщенияДляПодтверждения.Вставить("ИдентификаторСобытия", ВыборкаДетальныеЗаписи.ИдентификаторСобытия);
		СообщенияДляПодтверждения.Вставить("ОбъектСобытия", ВыборкаДетальныеЗаписи.ОбъектСобытия);
		СообщенияДляПодтверждения.Вставить("СсылкаНаОбъект", ВыборкаДетальныеЗаписи.СсылкаНаОбъект);
		ИменаФайлов.Добавить(СообщенияДляПодтверждения);
	КонецЦикла;

	Возврат ИменаФайлов;
КонецФункции

&НаКлиенте
Процедура ИнтервалОбновленияСтатусовПриИзменении(Элемент)
	Если ИнтервалОбновленияСтатусов < 1 Тогда 
		ИнтервалОбновленияСтатусов = 1;	
	КонецЕсли;  	
	ИзменитьЗначениеКонстантыИнтервалОбновленияСтатусов(ИнтервалОбновленияСтатусов); 
	
	ПодключитьОбработкуСообщений();
КонецПроцедуры

&НаСервере
Процедура ИзменитьЗначениеКонстантыИнтервалОбновленияСтатусов(Интервал)	
	Константы.спОтправкаСообщенийИнтервалОбновленияСтатусов.Установить(Интервал);
КонецПроцедуры
	
&НаСервере
Функция ПолучитьИнформациюОшибки(Информация) 
	СообщенииеОшибки = "";
	СерилизированаяИнформация = ДесериализоватьИзJSON(Информация);  
	Если ТипЗнч(СерилизированаяИнформация) = Тип("Структура") Тогда 	
		СообщенииеОшибки = ПолучитьДанные(СерилизированаяИнформация);
	КонецЕсли; 
	Возврат СообщенииеОшибки;
КонецФункции 

&НаСервере
Функция ПолучитьДанные(ИнформацияСообщения)
	
	СообщенииеОшибки = "";
	ОшибкиВФайле = Новый Массив;
	
	Если ИнформацияСообщения.Сервис.messageDate = Ложь Тогда 
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Дата сообщения»"));
	КонецЕсли;
	
	Если ИнформацияСообщения.Сервис.messageId = Ложь Тогда 
		ОшибкиВФайле.Добавить( СтрШаблон("%1", "Не задано значение реквизита «Id сообщения»"));
	КонецЕсли;
	
	Если ИнформацияСообщения.Сервис.shop = Ложь Тогда 
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «shop»"));
	КонецЕсли;
	
	Если ИнформацияСообщения.Сервис.token = Ложь Тогда 
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «token»"));
	КонецЕсли;
	
	
	Товары = Новый Массив;
	Для каждого ЭлементТовара Из ИнформацияСообщения.Товары Цикл 
		Ошибка = Ложь;
		Товар = Новый Структура("Гуид, Ean, Количество, Размер, Цена");
		
		Если ЭлементТовара.Гуид = Ложь ИЛИ ЭлементТовара.Ean = Ложь ИЛИ ЭлементТовара.Количество = Ложь 
			ИЛИ ЭлементТовара.Размер = Ложь ИЛИ ЭлементТовара.Цена = Ложь Тогда 
			
			Товар.Вставить("Гуид", 			ЭлементТовара.Гуид);
			Товар.Вставить("Ean", 			ЭлементТовара.Ean); 
			Товар.Вставить("Количество", 	ЭлементТовара.Количество); 
			Товар.Вставить("Размер", 		ЭлементТовара.Размер);
			Товар.Вставить("Цена", 			ЭлементТовара.Цена);
			Ошибка = Истина;
		КонецЕсли;  
		
		Если Ошибка Тогда 
			Товары.Добавить(Товар);
			ОшибкаФайла = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Товары.Количество() > 0 Тогда
		
		Для каждого ЭлементТовары Из Товары Цикл
			Если ЭлементТовары.Гуид = Ложь ИЛИ ЭлементТовары.Ean = Ложь ИЛИ ЭлементТовары.Количество = Ложь ИЛИ ЭлементТовары.Размер = Ложь ИЛИ ЭлементТовары.Цена = Ложь Тогда				
				
				Если ЭлементТовары.Гуид = Ложь Тогда 
					ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Номенклатура»"));
				КонецЕсли;
				
				Если ЭлементТовары.Ean  = Ложь Тогда 
					ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Ean"));
				КонецЕсли;
				
				Если ЭлементТовары.Количество = Ложь Тогда 
					ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Количество»"));
				КонецЕсли;
				
				Если ЭлементТовары.Размер = Ложь Тогда 
					ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Размер»"));
				КонецЕсли;
				
				Если ЭлементТовары.Цена = Ложь Тогда 
					ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Цена»"));
				КонецЕсли;
				
			КонецЕсли;
						
		КонецЦикла;	
	КонецЕсли;
	
	Если ОшибкиВФайле.Количество() > 0 Тогда 
		ОшибкиВФайлеБезДублей = УдалитьПовторяющиесяЭлементыМассива(ОшибкиВФайле);
		СообщенииеОшибки = ВывестиЭлементыМассиваВСтроку(ОшибкиВФайлеБезДублей);
	КонецЕсли; 
	
    Возврат СообщенииеОшибки;
КонецФункции

&НаСервере
Функция УдалитьПовторяющиесяЭлементыМассива(Массив) 
	ТекущийИндекс = 0; 
	ВсегоЭлементов = Массив.Количество(); 
	Пока ТекущийИндекс < ВсегоЭлементов Цикл 
		Индекс2 = ТекущийИндекс + 1; 
		Пока Индекс2 < ВсегоЭлементов Цикл 
			Если Массив[Индекс2] = Массив[ТекущийИндекс] Тогда 
				Массив.Удалить(Индекс2); 
				ВсегоЭлементов = ВсегоЭлементов - 1; 
			Иначе 
				Индекс2 = Индекс2 + 1; 
			КонецЕсли; 
		КонецЦикла; 
		ТекущийИндекс = ТекущийИндекс + 1; 
	КонецЦикла;
	
	Возврат Массив; 
КонецФункции 

Функция ВывестиЭлементыМассиваВСтроку(Массив)
	ВыходнаяСтрока = "";
	Разделитель = "; ";
	Для каждого ЭлементМассива Из Массив Цикл
		ВыходнаяСтрока = ВыходнаяСтрока + ?(ПустаяСтрока(ВыходнаяСтрока), "", Разделитель);
		ВыходнаяСтрока = ВыходнаяСтрока + ЭлементМассива;
	КонецЦикла;
	Возврат ВыходнаяСтрока;
КонецФункции

&НаСервере
Функция ДесериализоватьИзJSON(СтрокаJSON, ПоляДата = "")
    
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
    Значение = ПрочитатьJSON(ЧтениеJSON,, ПоляДата, ФорматДатыJSON.ISO);          
    ЧтениеJSON.Закрыть();
    Возврат Значение;
    
КонецФункции 

