	ВыгрузкаТаблицаПодчиненныеСообщения =  ТаблицаПодчиненныеСообщения.Выгрузить(,СсылкаНаОбъект);
	
	Если ВыгрузкаТаблицаПодчиненныеСообщения.Количество() > 0 Тогда 
		
		ТаблицаПодчиненныеСообщения.Очистить();	
		ТекущиеДанныеИзЗапроса = ТаблицаПодчиненныеСообщения(ВыгрузкаТаблицаПодчиненныеСообщения);
		
		Для каждого СтрокаТекущиеДанныеИзЗапроса Из ТекущиеДанныеИзЗапроса Цикл
			
			ТекущиеДанныеТаблицаПодчиненныеСообщения = ТаблицаПодчиненныеСообщения.Добавить();	
			ТекущиеДанныеТаблицаПодчиненныеСообщения.ДатаРегистрации 					= СтрокаТекущиеДанныеИзЗапроса.ДатаРегистрации;
	        ТекущиеДанныеТаблицаПодчиненныеСообщения.ИдентификаторСобытия 				= СтрокаТекущиеДанныеИзЗапроса.ИдентификаторСобытия;
			ТекущиеДанныеТаблицаПодчиненныеСообщения.ИдентификаторСобытияСтрока 		= СтрокаТекущиеДанныеИзЗапроса.ИдентификаторСобытияСтрока; 
			ТекущиеДанныеТаблицаПодчиненныеСообщения.СсылкаНаОбъект 					= СтрокаТекущиеДанныеИзЗапроса.СсылкаНаОбъект;
			ТекущиеДанныеТаблицаПодчиненныеСообщения.СпособПередачи 					= СтрокаТекущиеДанныеИзЗапроса.СпособПередачи;
			ТекущиеДанныеТаблицаПодчиненныеСообщения.СтатусСообщения 					= СтрокаТекущиеДанныеИзЗапроса.СтатусСообщения;
			ТекущиеДанныеТаблицаПодчиненныеСообщения.ИнициаторОтправкиСсылкаНаОбъект 	= СтрокаТекущиеДанныеИзЗапроса.ИнициаторОтправкиСсылкаНаОбъект;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

