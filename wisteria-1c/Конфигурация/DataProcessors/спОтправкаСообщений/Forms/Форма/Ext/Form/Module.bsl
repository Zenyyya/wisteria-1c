&НаСервере
Функция ПолучитьДанныеДляОтправкиИзТаблицаИнициаторыОтправки() 
	 	
	ТаблицаЗапросаИнициаторовОтправки = ТаблицаИнициаторыОтправки.Выгрузить(, "СсылкаНаОбъект"); 
	ТаблицаЗапросаИнициаторовОтправки.Очистить(); 
	
	Для каждого СтрокаТаблицаИнициаторыОтправки Из ТаблицаИнициаторыОтправки Цикл
		Если СтрокаТаблицаИнициаторыОтправки.Флажок Тогда  
			 НоваяСтрока = ТаблицаЗапросаИнициаторовОтправки.Добавить();
			 НоваяСтрока.СсылкаНаОбъект = СтрокаТаблицаИнициаторыОтправки.СсылкаНаОбъект;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаЗапросаИнициаторовОтправки.СсылкаНаОбъект КАК СсылкаНаОбъект
		|ПОМЕСТИТЬ ВнутренняяТаблицаИнициаторовОтправкиСообщения
		|ИЗ
		|	&ТаблицаЗапросаИнициаторовОтправки КАК ТаблицаЗапросаИнициаторовОтправки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
		|	тбОчередь.ФорматСообщения КАК ФорматСообщения,
		|	тбОчередь.МетодХранения КАК МетодХранения,
		|	тбОчередь.ОбъектСобытия КАК ОбъектСобытия,
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбОчередь.СпособПередачи КАК СпособПередачи,
		|	тбСостояние.СтатусСообщения КАК СтатусСообщения,
		|	тбСостояние.ОписаниеДанных КАК ОписаниеДанных,
		|	тбОчередь.Хранилище КАК Хранилище
		|ПОМЕСТИТЬ ВТОтправленныеСообщенияИнициаторОтправки
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|ГДЕ
		|	тбОчередь.СсылкаНаОбъект В
		|			(ВЫБРАТЬ
		|				ВнутренняяТаблицаИнициаторовОтправкиСообщения.СсылкаНаОбъект КАК СсылкаНаОбъект
		|			ИЗ
		|				ВнутренняяТаблицаИнициаторовОтправкиСообщения КАК ВнутренняяТаблицаИнициаторовОтправкиСообщения)
		|	И тбОчередь.СпособПередачи = &СпособПередачи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбОчередь.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект
		|ПОМЕСТИТЬ ВТНеПодтвержденныеОтправленныеСообщения
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|			И (тбСостояние.ЗадержкаЧисло <= &ЗадержкаЧисло)
		|			И (тбСостояние.СтатусСообщения <> &СписокСтатусовИсходящихСообщений)
		|			И (тбОчередь.СпособПередачи = &СпособПередачи)
		|ГДЕ
		|	тбОчередь.ИнициаторОтправкиСсылкаНаОбъект В
		|			(ВЫБРАТЬ
		|				ВнутренняяТаблицаИнициаторовОтправкиСообщения.СсылкаНаОбъект КАК СсылкаНаОбъект
		|			ИЗ
		|				ВнутренняяТаблицаИнициаторовОтправкиСообщения КАК ВнутренняяТаблицаИнициаторовОтправкиСообщения)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТНеПодтвержденныеОтправленныеСообщения.СсылкаНаОбъект) КАК КоличествоСообщений,
		|	ВТНеПодтвержденныеОтправленныеСообщения.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправки
		|ПОМЕСТИТЬ ВТКоличествоНеподтвержденныхСообщений
		|ИЗ
		|	ВТНеПодтвержденныеОтправленныеСообщения КАК ВТНеПодтвержденныеОтправленныеСообщения
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТНеПодтвержденныеОтправленныеСообщения.ИнициаторОтправкиСсылкаНаОбъект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТОтправленныеСообщенияИнициаторОтправки.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТКоличествоНеподтвержденныхСообщений.КоличествоСообщений, 0) = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОтправкаПодтверждена
		|ПОМЕСТИТЬ ВТИнициаторОтправкиСоСтатусомОтправки
		|ИЗ
		|	ВТОтправленныеСообщенияИнициаторОтправки КАК ВТОтправленныеСообщенияИнициаторОтправки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКоличествоНеподтвержденныхСообщений КАК ВТКоличествоНеподтвержденныхСообщений
		|		ПО ВТОтправленныеСообщенияИнициаторОтправки.СсылкаНаОбъект = ВТКоличествоНеподтвержденныхСообщений.ИнициаторОтправки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТОтправленныеСообщенияИнициаторОтправки.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	ВТОтправленныеСообщенияИнициаторОтправки.ДатаРегистрации КАК ДатаРегистрации,
		|	ВТОтправленныеСообщенияИнициаторОтправки.ФорматСообщения КАК ФорматСообщения,
		|	ВТОтправленныеСообщенияИнициаторОтправки.МетодХранения КАК МетодХранения,
		|	ВТОтправленныеСообщенияИнициаторОтправки.ОбъектСобытия КАК ОбъектСобытия,
		|	ВТОтправленныеСообщенияИнициаторОтправки.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	ВТОтправленныеСообщенияИнициаторОтправки.СпособПередачи КАК СпособПередачи,
		|	ВТОтправленныеСообщенияИнициаторОтправки.СтатусСообщения КАК СтатусСообщения,
		|	ВТОтправленныеСообщенияИнициаторОтправки.ОписаниеДанных КАК ОписаниеДанных,
		|	ВТОтправленныеСообщенияИнициаторОтправки.Хранилище КАК Хранилище,
		|	ВТИнициаторОтправкиСоСтатусомОтправки.ОтправкаПодтверждена КАК ОтправкаПодтверждена
		|ИЗ
		|	ВТОтправленныеСообщенияИнициаторОтправки КАК ВТОтправленныеСообщенияИнициаторОтправки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТИнициаторОтправкиСоСтатусомОтправки КАК ВТИнициаторОтправкиСоСтатусомОтправки
		|		ПО ВТОтправленныеСообщенияИнициаторОтправки.СсылкаНаОбъект = ВТИнициаторОтправкиСоСтатусомОтправки.СсылкаНаОбъект";
	

	Запрос.УстановитьПараметр("ТаблицаЗапросаИнициаторовОтправки", ТаблицаЗапросаИнициаторовОтправки); 
	Запрос.УстановитьПараметр("СпособПередачи", Перечисления.спСпособПередачи.FTP);
	Запрос.УстановитьПараметр("ЗадержкаЧисло", спОбщегоНазначенияВызовСервера.ПеревестиДатуВЧисло(ТекущаяДатаСеанса())); 
	Запрос.УстановитьПараметр("СписокСтатусовИсходящихСообщений", Перечисления.спСтатусыСообщений.ОтправкаПодтверждена);

	
	ВыгрузкаИнициаторовОтправки = Запрос.Выполнить().Выгрузить(); 
	
	СписокСтатусовДляОтправки = спКэшируемыеФункцииВызовСервера.ПоучитьСписокСтатусовДляОтправки(); 
	ИнициаторыДляОтправкиСообщеня = Новый Массив;
	
	Для каждого СтрокаИнициаторовОтправки Из ВыгрузкаИнициаторовОтправки Цикл 
		ОтменаОтправки = Ложь;
		
		Если СтрокаИнициаторовОтправки.СтатусСообщения = Перечисления.спСтатусыСообщений.ВОбработке Тогда 	
			ВремяСНачалаОбработки = ТекущаяДатаСеанса() - СтрокаИнициаторовОтправки.ДатаРегистрации;
			Если ВремяСНачалаОбработки < 3 * 60 Тогда  
				ОтменаОтправки = Истина;
			КонецЕсли;
		КонецЕсли;	
		
		Если СписокСтатусовДляОтправки.Найти(СтрокаИнициаторовОтправки.СтатусСообщения) = Неопределено Тогда 
			ОтменаОтправки = Истина;
		КонецЕсли; 
		
		Если НЕ СтрокаИнициаторовОтправки.ОтправкаПодтверждена Тогда
			ОтменаОтправки = Истина;
		КонецЕсли;
			
		Если Не ОтменаОтправки Тогда 
			
			СообщениеОтправки = Новый Структура;
			СообщениеОтправки.Вставить("ИдентификаторСобытия", 		СтрокаИнициаторовОтправки.ИдентификаторСобытия);
			СообщениеОтправки.Вставить("ФорматСообщения", 			СтрокаИнициаторовОтправки.ФорматСообщения);
			СообщениеОтправки.Вставить("МетодХранения", 			СтрокаИнициаторовОтправки.МетодХранения);
			СообщениеОтправки.Вставить("ОбъектСобытия", 			СтрокаИнициаторовОтправки.ОбъектСобытия);
			СообщениеОтправки.Вставить("СсылкаНаОбъект", 			СтрокаИнициаторовОтправки.СсылкаНаОбъект);
			СообщениеОтправки.Вставить("СпособПередачи", 			СтрокаИнициаторовОтправки.СпособПередачи);
			СообщениеОтправки.Вставить("СтатусСообщения", 			СтрокаИнициаторовОтправки.СтатусСообщения); 
			СообщениеОтправки.Вставить("ДатаРегистрации", 			СтрокаИнициаторовОтправки.ДатаРегистрации);
			СообщениеОтправки.Вставить("ОписаниеДанных", 			СтрокаИнициаторовОтправки.ОписаниеДанных); 
			СообщениеОтправки.Вставить("Хранилище",      			СтрокаИнициаторовОтправки.Хранилище);
			
			ИнициаторыДляОтправкиСообщеня.Добавить(СообщениеОтправки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИнициаторыДляОтправкиСообщеня;

КонецФункции

&НаКлиенте
Процедура ОтправитьСообщенияТаблицаИнициаторыОтправки(Команда)
	Состояние("Подождите. Идет обработка"); 
	
	СообщеняДляОтправки = ПолучитьДанныеДляОтправкиИзТаблицаИнициаторыОтправки(); 	
	Если ТипЗнч(СообщеняДляОтправки) = Тип("Массив") И СообщеняДляОтправки.Количество() > 0 Тогда	
		спСервисИнтеграцииКлиент.ОтправитьСообщениеДокументовПоsFTP(СообщеняДляОтправки);
	КонецЕсли;
	
	ОбновитьДанныеТаблицаПодчиненныеСообщения();
	ПроверитьВозможностьОтправкиТаблицаИнициаторыОтправкиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицаИнициаторыОтправкиНаСервере()
	
	ВыгрузкаТаблицанициаторыОтправки =  ТаблицаИнициаторыОтправки.Выгрузить(, "СсылкаНаОбъект");
	
	Если ВыгрузкаТаблицанициаторыОтправки.Количество() > 0 Тогда 
		
		ТаблицаИнициаторыОтправки.Очистить();	
		ТекущиеДанныеИзЗапроса = ТаблицаИнициаторыСообщения(ВыгрузкаТаблицанициаторыОтправки);
		
		Для каждого СтрокаТекущиеДанныеИзЗапроса Из ТекущиеДанныеИзЗапроса Цикл
			
			ТекущиеДанныеТаблицаПодчиненныеСообщения = ТаблицаИнициаторыОтправки.Добавить();	
			ТекущиеДанныеТаблицаПодчиненныеСообщения.ДатаРегистрации 					= СтрокаТекущиеДанныеИзЗапроса.ДатаРегистрации;
	        ТекущиеДанныеТаблицаПодчиненныеСообщения.ИдентификаторСобытия 				= СтрокаТекущиеДанныеИзЗапроса.ИдентификаторСобытия;
			ТекущиеДанныеТаблицаПодчиненныеСообщения.ИдентификаторСобытияСтрока 		= СтрокаТекущиеДанныеИзЗапроса.ИдентификаторСобытияСтрока; 
			ТекущиеДанныеТаблицаПодчиненныеСообщения.СсылкаНаОбъект 					= СтрокаТекущиеДанныеИзЗапроса.СсылкаНаОбъект;
			ТекущиеДанныеТаблицаПодчиненныеСообщения.СпособПередачи 					= СтрокаТекущиеДанныеИзЗапроса.СпособПередачи;
			ТекущиеДанныеТаблицаПодчиненныеСообщения.СтатусСообщения 					= СтрокаТекущиеДанныеИзЗапроса.СтатусСообщения;
		КонецЦикла;
	КонецЕсли;
	
	ПроверитьВозможностьОтправкиТаблицаИнициаторыОтправкиНаСервере();
КонецПроцедуры 

&НаСервере
Функция ТаблицаИнициаторыСообщения(ВыгрузкаТаблицаСообщения) 
	ДанныеВыборка = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВыгрузкаТаблицаСообщения.СсылкаНаОбъект КАК СсылкаНаОбъект
		|ПОМЕСТИТЬ ВнутренняяТаблицаСообщений
		|ИЗ
		|	&ВыгрузкаТаблицаСообщения КАК ВыгрузкаТаблицаСообщения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
		|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	ПРЕДСТАВЛЕНИЕ(тбОчередь.ИдентификаторСобытия) КАК ИдентификаторСобытияСтрока,
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбОчередь.СпособПередачи КАК СпособПередачи,
		|	тбСостояние.СтатусСообщения КАК СтатусСообщения
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|ГДЕ
		|	тбОчередь.СсылкаНаОбъект В
		|			(ВЫБРАТЬ
		|				ВнутренняяТаблицаСообщений.СсылкаНаОбъект КАК СсылкаНаОбъект
		|			ИЗ
		|				ВнутренняяТаблицаСообщений КАК ВнутренняяТаблицаСообщений)
		|	И тбОчередь.СпособПередачи = &СпособПередачи";
	
	Запрос.УстановитьПараметр("ВыгрузкаТаблицаСообщения", ВыгрузкаТаблицаСообщения); 
	Запрос.УстановитьПараметр("СпособПередачи", Перечисления.спСпособПередачи.FTP);

	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл  
		ТекущиеДанные = Новый Структура("ДатаРегистрации, ИдентификаторСобытия, ИдентификаторСобытияСтрока, СсылкаНаОбъект, СпособПередачи, СтатусСообщения");
		ТекущиеДанные.Вставить("ДатаРегистрации", ВыборкаДетальныеЗаписи.ДатаРегистрации);
		ТекущиеДанные.Вставить("ИдентификаторСобытия", ВыборкаДетальныеЗаписи.ИдентификаторСобытия);
		ТекущиеДанные.Вставить("ИдентификаторСобытияСтрока", ВыборкаДетальныеЗаписи.ИдентификаторСобытияСтрока);
		ТекущиеДанные.Вставить("СсылкаНаОбъект", ВыборкаДетальныеЗаписи.СсылкаНаОбъект);
		ТекущиеДанные.Вставить("СпособПередачи", ВыборкаДетальныеЗаписи.СпособПередачи);
		ТекущиеДанные.Вставить("СтатусСообщения", ВыборкаДетальныеЗаписи.СтатусСообщения);   
		
		ДанныеВыборка.Добавить(ТекущиеДанные);
	КонецЦикла;
	
	Возврат ДанныеВыборка;

КонецФункции

&НаКлиенте
Процедура ОбновитьТаблицаИнициаторыОтправки(Команда)
	ОбновитьТаблицаИнициаторыОтправкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицаПодчиненныеСообщения(Команда)
	ОбновитьТаблицаПодчиненныеСообщенияНаСервере();
КонецПроцедуры

&НаСервере
