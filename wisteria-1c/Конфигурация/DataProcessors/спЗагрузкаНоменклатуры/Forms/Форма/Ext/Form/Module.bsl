	ОформляемоеПоле.Использование = Истина;

    // КодТНВЭД
    ЭлементУОКодТНВЭД = УсловноеОформление.Элементы.Добавить();				
	ЭлементУОКодТНВЭД.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Красный);
	ЭлементУОКодТНВЭД.Использование = Истина;
	
	ЭлементУсловия = ЭлементУОКодТНВЭД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ТабличнаяЗагрузки.ОшибкаЗаполненияКодТНВЭД");
	ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение = Истина;
	
	ОформляемоеПоле = ЭлементУОКодТНВЭД.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТабличнаяЗагрузкиКодТНВЭД");
	ОформляемоеПоле.Использование = Истина;  
	
	// ШтрихКод
    ЭлементШтрихКод = УсловноеОформление.Элементы.Добавить();				
	ЭлементШтрихКод.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Красный);
	ЭлементШтрихКод.Использование = Истина;
	
	ЭлементУсловия = ЭлементШтрихКод.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ТабличнаяЗагрузки.ОшибкаШтрихКода");
	ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение = Истина;
	
	ЭлементУсловия = ЭлементШтрихКод.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("БезПроверкиШтрихкодов");
	ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение = Ложь;
	
	ОформляемоеПоле = ЭлементШтрихКод.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТабличнаяЗагрузкиШтрихКод");
