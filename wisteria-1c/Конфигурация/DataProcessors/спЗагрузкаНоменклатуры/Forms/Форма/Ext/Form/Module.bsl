&НаСервере
Функция НайтиТНВЭД(КодТНВЭД)
	
	КодТНВЭДСсылка = Справочники.КлассификаторТНВЭД.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(КодТНВЭД) Тогда 
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлассификаторТНВЭД.Ссылка КАК Ссылка,
		|	КлассификаторТНВЭД.Код КАК Код,
		|	КлассификаторТНВЭД.Наименование КАК Наименование
		|ИЗ
		|	Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
		|ГДЕ
		|	КлассификаторТНВЭД.Код = &Код";
	
	Запрос.УстановитьПараметр("Код", КодТНВЭД);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		КодТНВЭДСсылка = ВыборкаДетальныеЗаписи.Ссылка;
		Прервать;
	КонецЦикла;
	КонецЕсли;

    Возврат КодТНВЭДСсылка;

КонецФункции

&НаСервере
Процедура ЗаполнитьНоменклатуру(СтрокаТабличнаяЗагрузки)
	
	Если ЗначениеЗаполнено(СтрокаТабличнаяЗагрузки.Штрихкод) 
		Или (БезПроверкиШтрихкодов И ЗначениеЗаполнено(СтрокаТабличнаяЗагрузки.Артикул1С)) Тогда
		
		// { Иванов С.С. (TNext) - 02.06.2025 - Задача №2502 
		// Добавлен поиск по артикулу 1С для перезаписи существующих товаров
		// }
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод,
		|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
		|	ШтрихкодыНоменклатуры.Партия КАК Партия,
		|	ШтрихкодыНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения
		|ПОМЕСТИТЬ ВТ_Результат
		|ИЗ
		|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		|ГДЕ
		|	ШтрихкодыНоменклатуры.Штрихкод ПОДОБНО &Штрихкод
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Номенклатура.Штрихкод,
		|	Номенклатура.Ссылка,
		|	НЕОПРЕДЕЛЕНО,
		|	Номенклатура.ЕдиницаИзмерения
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Артикул = &Артикул1С
		|	И Номенклатура.Артикул <> """"
		|	И НЕ Номенклатура.ПометкаУдаления
		|	И НЕ Номенклатура.ЭтоГруппа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Результат.Номенклатура КАК Номенклатура
		|ИЗ
		|	ВТ_Результат КАК ВТ_Результат
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Результат.Номенклатура";
		
		Запрос.УстановитьПараметр("Штрихкод", СтрокаТабличнаяЗагрузки.Штрихкод); 
		Запрос.УстановитьПараметр("Артикул1С", ?(Дозагрузка, СтрокаТабличнаяЗагрузки.Артикул1С, ""));
		                   
		Результат = Запрос.Выполнить();  
		ВыборкаРезультата = Результат.Выбрать(); 
		Пока ВыборкаРезультата.Следующий() Цикл 
			СтрокаТабличнаяЗагрузки.Номенклатура = ВыборкаРезультата.Номенклатура;
			Прервать;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура СоздатьНоменклатуруХарактеристикуНаСервере() 
	
	Для каждого СтрокаОбъектТабличнаяЗагрузки Из Объект.ТабличнаяЗагрузки Цикл
	    ЗаполнитьНоменклатуру(СтрокаОбъектТабличнаяЗагрузки);  
		Если Дозагрузка Или (ЗначениеЗаполнено(СтрокаОбъектТабличнаяЗагрузки.Артикль)
			И ЗначениеЗаполнено(СтрокаОбъектТабличнаяЗагрузки.ДопКомментарии)
			И НЕ ЗначениеЗаполнено(СтрокаОбъектТабличнаяЗагрузки.Номенклатура)) Тогда
			СоздатьПерезаполнитьНоменклатуру(СтрокаОбъектТабличнаяЗагрузки);
		КонецЕсли;
		
	КонецЦикла;    
	
	УсловноеОформлениеТаблицыЗагрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуруХарактеристику(Команда)
	СоздатьНоменклатуруХарактеристикуНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЧитатьСоСтроки = 2;
	
	// dimedrol 25.01.2025
	// Установим отборы для реквизитов заполнения
	ДополнительнйРеквизитПокупатель = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Покупатель", Истина);
	
	Если ЗначениеЗаполнено(ДополнительнйРеквизитПокупатель) Тогда
		ПараметрыВыбора = Новый Массив;
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Владелец", ДополнительнйРеквизитПокупатель));
		Элементы.РеквизитПодстановкиПокупатель.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
	КонецЕсли;
	
	ДополнительнйРеквизитСезон = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Сезон", Истина);
	
	Если ЗначениеЗаполнено(ДополнительнйРеквизитСезон) Тогда
		ПараметрыВыбора = Новый Массив;
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Владелец", ДополнительнйРеквизитСезон));
		Элементы.РеквизитПодстановкиСезон.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
	КонецЕсли;
	// end of dimedrol 25.01.2025
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличнаяЗагрузкиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	УсловноеОформлениеТаблицыЗагрузки(); 
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыПоКатегории(НоваяНоменклатура)  
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КатегорииНоменклатуры.МетодОценки КАК МетодОценки,
		|	КатегорииНоменклатуры.НаправлениеДеятельности КАК НаправлениеДеятельности,
		|	КатегорииНоменклатуры.СпособПополнения КАК СпособПополнения,
		|	КатегорииНоменклатуры.СчетУчетаЗапасов КАК СчетУчетаЗапасов,
		|	КатегорииНоменклатуры.СчетУчетаЗатрат КАК СчетУчетаЗатрат,
		|	КатегорииНоменклатуры.УдалитьВидПродукцииИС КАК ВидПродукцииИС
		|ИЗ
		|	Справочник.КатегорииНоменклатуры КАК КатегорииНоменклатуры
		|ГДЕ
		|	КатегорииНоменклатуры.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", НоваяНоменклатура.КатегорияНоменклатуры);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		 НоваяНоменклатура.МетодОценки 				= ВыборкаДетальныеЗаписи.МетодОценки; 
		 НоваяНоменклатура.НаправлениеДеятельности 	= ВыборкаДетальныеЗаписи.НаправлениеДеятельности; 
		 НоваяНоменклатура.СпособПополнения 		= ВыборкаДетальныеЗаписи.СпособПополнения; 
		 НоваяНоменклатура.СчетУчетаЗапасов 		= ВыборкаДетальныеЗаписи.СчетУчетаЗапасов;
		 НоваяНоменклатура.СчетУчетаЗатрат  		= ВыборкаДетальныеЗаписи.СчетУчетаЗатрат;
		 НоваяНоменклатура.ВидПродукцииИС  			= ВыборкаДетальныеЗаписи.ВидПродукцииИС;
		 НоваяНоменклатура.Записать();
		 Прервать;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
