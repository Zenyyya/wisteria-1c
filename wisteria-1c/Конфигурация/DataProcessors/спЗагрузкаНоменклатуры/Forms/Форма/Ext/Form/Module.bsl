Процедура ЗаполнитьШтрихКодНоменклатуры(НоваяНоменклатура, СтрокаТабличнаяЗагрузки) 
	НоваяНоменклатураСсылка = НоваяНоменклатура.Ссылка; // ++ Терлецкий АВ 25.01.22
	
	Если ЗначениеЗаполнено(СтрокаТабличнаяЗагрузки.Штрихкод) И НоваяНоменклатураСсылка <> Справочники.Номенклатура.ПустаяСсылка() Тогда // ++ Терлецкий АВ 25.01.22 
	
	НаборЗаписей = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьНаборЗаписей();
	Отбор = НаборЗаписей.Отбор;
	Отбор.Штрихкод.Установить(СтрокаТабличнаяЗагрузки.Штрихкод); 
	Отбор.Номенклатура.Установить(НоваяНоменклатураСсылка); // ++ Терлецкий АВ 25.01.22
	
	НаборЗаписей.Прочитать(); 
	
	Если НаборЗаписей.Количество() = 0 Тогда	
		НоваяЗапись = НаборЗаписей.Добавить(); 
		НоваяЗапись.Штрихкод			= СтрокаТабличнаяЗагрузки.Штрихкод; 
		НоваяЗапись.Номенклатура 		= НоваяНоменклатураСсылка; 	
	КонецЕсли; 
   	НаборЗаписей.Записать();  
	
	// dimedrol 30.01.2025
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() > 0 Тогда
		НоваяНоменклатураОбъект = НоваяНоменклатураСсылка.ПолучитьОбъект();
		НоваяНоменклатураОбъект.Штрихкод = СтрокаТабличнаяЗагрузки.Штрихкод;
		Попытка	
			НоваяНоменклатураОбъект.Записать();
		Исключение
			ТекстСообщения = НСтр("ru = 'Ошибка заполнения реквизита штрихкод номенклатуры: %ИнформацияОбОшибке%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ИнформацияОбОшибке%", ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецПопытки;
	КонецЕсли;
	// end of dimedrol 30.01.2022
	
	КонецЕсли;
КонецПроцедуры

// dimedrol 30.01.2025
&НаСервере
Процедура ЗаполнитьGTINНоменклатуры(НоваяНоменклатура, СтрокаТабличнаяЗагрузки) 
	
	НоваяНоменклатураСсылка = НоваяНоменклатура.Ссылка;
	
	GTIN = ШтрихкодEANИзGTIN(СтрокаТабличнаяЗагрузки.GTIN);
	
	Если ЗначениеЗаполнено(GTIN) И НоваяНоменклатураСсылка <> Справочники.Номенклатура.ПустаяСсылка() Тогда
		
		НаборЗаписей = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьНаборЗаписей();
		Отбор = НаборЗаписей.Отбор;
		Отбор.Штрихкод.Установить(GTIN);
		Отбор.Номенклатура.Установить(НоваяНоменклатураСсылка);
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Штрихкод			= GTIN;
			НоваяЗапись.Номенклатура 		= НоваяНоменклатураСсылка;
		КонецЕсли; 
		НаборЗаписей.Записать();
	КонецЕсли;
	
КонецПроцедуры

// Вычисляет штрихкод EAN из GTIN.
// 
// Параметры:
//  Штрихкод - Строка - GTIN.
// Возвращаемое значение:
//  Строка - Вычисленное значение EAN.
&НаСервере
Функция ШтрихкодEANИзGTIN(Знач Штрихкод) Экспорт
	
	Если Лев(Штрихкод, 1) = "0" Тогда
		Штрихкод = Сред(Штрихкод, 2); //EAN13
		Если Лев(Штрихкод, 5) = "00000" Тогда
			Штрихкод = Сред(Штрихкод, 6); //EAN8
		КонецЕсли;
	КонецЕсли;
	
	Возврат Штрихкод;
	
КонецФункции

&НаСервере
Функция НайтиЦветПоНаименованию(ПредставлениеЦвета)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	спЦвета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.спЦвета КАК спЦвета
	|ГДЕ
	|	спЦвета.Наименование = &Наименование
	|	И НЕ спЦвета.ЭтоГруппа";
	
	Запрос.УстановитьПараметр("Наименование", ПредставлениеЦвета);
	Результат = Запрос.Выполнить();
	ВыборкаРезультата = Результат.Выбрать();
	
	Если ВыборкаРезультата.Следующий() Тогда
		ЦветСсылка = ВыборкаРезультата.Ссылка;
	Иначе
		ЦветСсылка = Справочники.спЦвета.ПустаяСсылка();
	КонецЕсли;
		
	Возврат ЦветСсылка;
	
КонецФункции

&НаСервере
Функция НайтиСоздатьКонтрагента(ПредставлениеКонтрагента, ПредставлениеАдреса)
	
	Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(ПредставлениеКонтрагента, Истина);
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Контрагент;
	КонецЕсли;
	
	КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
	КонтрагентОбъект.Наименование = ПредставлениеКонтрагента;
	КонтрагентОбъект.Заполнить(Неопределено);
	КонтрагентОбъект.Поставщик = Истина;
	Если ЗначениеЗаполнено(ПредставлениеАдреса) Тогда
		
		ВидКИ = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
		ТипКИ = Перечисления.ТипыКонтактнойИнформации.Адрес;
		
		Значение = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияПоПредставлению(СокрЛП(ПредставлениеАдреса), ВидКИ);
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(КонтрагентОбъект, Значение, ВидКИ, , Ложь);
		
	КонецЕсли;
	КонтрагентОбъект.Записать();
	
	Возврат КонтрагентОбъект.Ссылка;
	
КонецФункции

&НаСервере
Функция ОбработатьСтрокуПоискаПола(СтрокаПоискаПола)
	
	Если СтрокаПоискаПола = "дев" Тогда
		Возврат "девочки";
	ИначеЕсли СтрокаПоискаПола = "мал" Тогда
		Возврат "мальчики";
	Иначе
		Возврат СтрокаПоискаПола;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПроверитьЗаполнениеДанных()
	
	ОшибокНет = Истина;
	
	НомерСтроки = 0;
	Для Каждого СтрокаОбъектТабличнаяЗагрузки Из Объект.ТабличнаяЗагрузки Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		Если НЕ ЗначениеЗаполнено(СтрокаОбъектТабличнаяЗагрузки.Номенклатура) Тогда
			
			ТекстСообщения = НСтр("ru = 'В строке %НомерСтроки% не указана номенклатура.'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", НомерСтроки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "ТабличнаяЗагрузки");
			
			ОшибокНет = Ложь;
			
		КонецЕсли
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ВидЦены) Тогда
		
		ТекстСообщения = НСтр("ru = 'Не указан вид цены для установки.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "ВидЦены");
		
		ОшибокНет = Ложь;
		
	КонецЕсли;
	
	Возврат ОшибокНет;
	
КонецФункции

&НаСервере
Процедура СоздатьУстановкуЦенНоменклатурыНаСервере()
	
	Если НЕ ПроверитьЗаполнениеДанных() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ДокументУстановкаЦенНоменклатурыОбъект = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	
	ДокументУстановкаЦенНоменклатурыОбъект.Дата        = ТекущаяДатаСеанса();
	ДокументУстановкаЦенНоменклатурыОбъект.Автор       = Пользователи.АвторизованныйПользователь();
	ДокументУстановкаЦенНоменклатурыОбъект.Комментарий = "Документ цен создан программно";
	
	ДокументУстановкаЦенНоменклатурыОбъект.ПоказыватьДействующуюЦену  = Истина;
	ДокументУстановкаЦенНоменклатурыОбъект.ПоказыватьЕдиницыИзмерения = Истина;
	ДокументУстановкаЦенНоменклатурыОбъект.ПоказыватьХарактеристики   = Истина;
	ДокументУстановкаЦенНоменклатурыОбъект.ПоказыватьОтклонениеЦен    = Истина;
	ДокументУстановкаЦенНоменклатурыОбъект.ПоказыватьНовуюЦену        = Истина;
	
	ЗаписатьДокумент = Ложь;
	
	ТЧЗапасы = ДокументУстановкаЦенНоменклатурыОбъект.Запасы;
	Отбор = Новый Структура( "Номенклатура, Характеристика, ЕдиницаИзмерения, ВидЦены, Валюта" );
	Для Каждого ТоварыСтрока Из Объект.ТабличнаяЗагрузки Цикл
	
		Отбор.Номенклатура     = ТоварыСтрока.Номенклатура;
		Отбор.Номенклатура     = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		Отбор.ЕдиницаИзмерения = ТоварыСтрока.Номенклатура.ЕдиницаИзмерения;
		Отбор.ВидЦены          = ВидЦены;
		Отбор.Валюта           = ВидЦены.ВалютаЦены;
		
		ТЧЗапасыСтроки = ТЧЗапасы.НайтиСтроки(Отбор);
		Если ТЧЗапасыСтроки.Количество() = 0 Тогда
		
			ТЧЗапасыСтрока = ТЧЗапасы.Добавить();
			
			ТЧЗапасыСтрока.Номенклатура     = ТоварыСтрока.Номенклатура;
			ТЧЗапасыСтрока.Характеристика   = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
			ТЧЗапасыСтрока.ЕдиницаИзмерения = ТоварыСтрока.Номенклатура.ЕдиницаИзмерения;
			ТЧЗапасыСтрока.ВидЦены          = ВидЦены;
			ТЧЗапасыСтрока.Валюта           = ВидЦены.ВалютаЦены;
			
		Иначе
			ТЧЗапасыСтрока = ТЧЗапасыСтроки[0];
		КонецЕсли;
		
		Если ТЧЗапасыСтрока.Цена <> ТоварыСтрока.Цена Тогда
			ТЧЗапасыСтрока.Цена = ТоварыСтрока.Цена;
			ЗаписатьДокумент = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗаписатьДокумент = Истина Тогда
		ДокументУстановкаЦенНоменклатурыОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Комментарий = "Заполнен и записан документ: " + ДокументУстановкаЦенНоменклатурыОбъект;
		ОбщегоНазначения.СообщитьПользователю(Комментарий);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьУстановкуЦенНоменклатуры(Команда)
	СоздатьУстановкуЦенНоменклатурыНаСервере();
КонецПроцедуры
