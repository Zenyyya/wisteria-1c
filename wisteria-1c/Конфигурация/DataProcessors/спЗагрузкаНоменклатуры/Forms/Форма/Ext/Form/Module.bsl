&НаСервере
Процедура ПрочитатьExcel_ТабличныйДокумент(ПутьКФайлу)
	
	Объект.ТабличнаяЗагрузки.Очистить();
	ТабДок.Очистить();
	
	Попытка
		ТабДок.Прочитать(ПутьКФайлу);
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось прочитать файл по причине: " + ОписаниеОшибки();
		Сообщение.Сообщить();                                                        
		Возврат;
	КонецПопытки;
	
	КоличествоСтрок = ТабДок.ВысотаТаблицы;
	КоличествоКолонок = ТабДок.ШиринаТаблицы;
	
	Для НомерСтроки = 1 По КоличествоСтрок Цикл
		
		Если НомерСтроки < ЧитатьСоСтроки Тогда
			Продолжить;			
		КонецЕсли;
		
		СтрокаТаблицы = Объект.ТабличнаяЗагрузки.Добавить();  
		
		АдресКартинки = "";
		КартинкаДобавлена = Ложь;	
		АдресОбластиРисунка = "R" + НомерСтроки + "C1:R" + НомерСтроки + "C" + 1;
		Для Каждого РисунокТД ИЗ ТабДок.ПолучитьОбласть(АдресОбластиРисунка).Рисунки Цикл  
			КартинкаДобавлена = Истина;
			Прервать;
		КонецЦикла;

		СтрокаТаблицы.Картинка					= АдресКартинки;
		СтрокаТаблицы.КартинкаДобавлена			= КартинкаДобавлена;
		СтрокаТаблицы.Покупатель				= ОчиститьСтроку(ТабДок.Область(НомерСтроки, 2).Текст);
		СтрокаТаблицы.Сезон						= ОчиститьСтроку(ТабДок.Область(НомерСтроки, 3).Текст);
		
		Попытка
			ДатаСтрокой = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 4).Текст);
			ДатаОтгрузки = ОбщегоНазначенияКлиентСервер.СтрокаВДату(ДатаСтрокой);
		Исключение
			ДатаОтгрузки = Дата("00010101");
		КонецПопытки;
		СтрокаТаблицы.ДатаОтгрузки				= ДатаОтгрузки;  
		
		Попытка
			ДатаСтрокой = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 5).Текст);
			ДатаПрибытия  = ОбщегоНазначенияКлиентСервер.СтрокаВДату(ДатаСтрокой);
		Исключение
			ДатаПрибытия  = Дата("00010101");
		КонецПопытки;
		СтрокаТаблицы.ДатаПрибытия				= ДатаПрибытия;   
		
		// dimedrol 15.05.2025 Переименовал реквизит, был "Призводитель"
		ПроизводительСтрокой 						= ОчиститьСтроку(СокрЛП(ТабДок.Область(НомерСтроки, 6).Текст));
		Если ЗначениеЗаполнено(ПроизводительСтрокой) Тогда
			Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(ПроизводительСтрокой); 
			Если ЗначениеЗаполнено(Контрагент) Тогда
				СтрокаТаблицы.Производитель = Контрагент;
			Иначе
				СтрокаТаблицы.Производитель = ПроизводительСтрокой;
			КонецЕсли;  
		КонецЕсли;
		СтрокаТаблицы.АдресПроизводителя        = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 7).Текст);
		
		СтранаПроисхожденияСтрокой				= ОчиститьСтроку(СокрЛП(ТабДок.Область(НомерСтроки, 8).Текст)); 
		Если ЗначениеЗаполнено(СтранаПроисхожденияСтрокой) Тогда
			СтранаПроисхождения = Справочники.СтраныМира.НайтиПоНаименованию(СтранаПроисхожденияСтрокой);
			Если ЗначениеЗаполнено(СтранаПроисхождения) Тогда
				СтрокаТаблицы.СтранаПроисхождения = СтранаПроисхождения;
			Иначе
				СтрокаТаблицы.СтранаПроисхождения = СтранаПроисхожденияСтрокой;
			КонецЕсли;
		КонецЕсли;
	
		СтрокаТаблицы.Бренд                     = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 9).Текст);
		СтрокаТаблицы.Артикль                   = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 10).Текст);
		СтрокаТаблицы.Пол                       = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 11).Текст);
		СтрокаТаблицы.Возраст                   = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 12).Текст);
		СтрокаТаблицы.Коллекция                 = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 13).Текст);
		СтрокаТаблицы.Описание                  = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 14).Текст);
		
		ИмяТипаСтрокой                      	= ОчиститьСтроку(ТабДок.Область(НомерСтроки, 15).Текст);  
		Если ЗначениеЗаполнено(ИмяТипаСтрокой) Тогда
			ТипНоменклатуры = НайтиРодителя(ИмяТипаСтрокой); 
			Если ЗначениеЗаполнено(ТипНоменклатуры) Тогда
				СтрокаТаблицы.Тип = ТипНоменклатуры;
			Иначе
				СтрокаТаблицы.Тип = ИмяТипаСтрокой;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаТаблицы.Состав                    = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 16).Текст); 
		СтрокаТаблицы.ТипМатериала              = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 17).Текст);
		СтрокаТаблицы.Масса                     = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 18).Текст);
		СтрокаТаблицы.Прокладка                 = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 19).Текст);
		СтрокаТаблицы.Подкладка                 = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 20).Текст);
	    СтрокаТаблицы.ВидУпаковки               = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 21).Текст);
			
		Цена 									= ПривестиСтрокуКЧислу(СокрЛП(ТабДок.Область(НомерСтроки, 22).Текст));
		Если ЗначениеЗаполнено(Цена) Тогда
			СтрокаТаблицы.Цена = Цена;
		Иначе
			СтрокаТаблицы.Цена             		= ОчиститьСтроку(ТабДок.Область(НомерСтроки, 22).Текст);
		КонецЕсли;	
		
		СтрокаТаблицы.ДопКомментарии            = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 23).Текст);
		//СтрокаТаблицы.Характеристика            = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 24).Текст);
		
		ЕдИзмСтрокой                     		= ОчиститьСтроку(ТабДок.Область(НомерСтроки, 25).Текст); 
		Если ЗначениеЗаполнено(ЕдИзмСтрокой) Тогда
			ЕдИзмСтрокой = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(ЕдИзмСтрокой);
			Если ЗначениеЗаполнено(ЕдИзмСтрокой) Тогда
				СтрокаТаблицы.ЕдИзм = ЕдИзмСтрокой;
			Иначе
				СтрокаТаблицы.ЕдИзм             = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 25).Текст)
			КонецЕсли;
		КонецЕсли;
 
		
		СтрокаТаблицы.ГлавныйЦвет               = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 26).Текст);
		СтрокаТаблицы.КОД                       = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 27).Текст);  
		
		DDP                       				= ПривестиСтрокуКЧислу(ОчиститьСтроку(ТабДок.Область(НомерСтроки, 28).Текст));
		Если ЗначениеЗаполнено(DDP) Тогда
			СтрокаТаблицы.DDP = DDP;
		Иначе
			СтрокаТаблицы.DDP                   = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 28).Текст);
		КонецЕсли;
		
		Всего                       			= ПривестиСтрокуКЧислу(ОчиститьСтроку(ТабДок.Область(НомерСтроки, 29).Текст));
		Если ЗначениеЗаполнено(Всего) Тогда
			СтрокаТаблицы.Всего = Всего;
		Иначе
			СтрокаТаблицы.Всего                 = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 29).Текст);
		КонецЕсли; 
		
		НДС                       				= ОчиститьСтроку(ТабДок.Область(НомерСтроки, 30).Текст);
		Если ЗначениеЗаполнено(НДС) Тогда
			СтрокаТаблицы.НДС = НайтиСтавкуНДС(НДС);
		Иначе
			СтрокаТаблицы.НДС                   = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 30).Текст);
		КонецЕсли;
		
		СтрокаТаблицы.Штрихкод                  = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 31).Текст);
				
		КодТНВЭД                  				= НайтиТНВЭД(ОчиститьСтроку(ТабДок.Область(НомерСтроки, 32).Текст));
		Если ЗначениеЗаполнено(КодТНВЭД) Тогда
			СтрокаТаблицы.КодТНВЭД = КодТНВЭД;
		Иначе
			СтрокаТаблицы.КодТНВЭД              = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 32).Текст);
		КонецЕсли;
		
		СтрокаТаблицы.КодОКПД2                  = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 33).Текст);
		СтрокаТаблицы.GPCБлок                   = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 34).Текст);
		
		КатегорииНоменклатуры                   = НайтиКатегорииНоменклатуры(ОчиститьСтроку(ТабДок.Область(НомерСтроки, 35).Текст));
		Если ЗначениеЗаполнено(КатегорииНоменклатуры) Тогда
			СтрокаТаблицы.ВидНоменклатуры = КатегорииНоменклатуры;
		Иначе
			СтрокаТаблицы.ВидНоменклатуры       = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 35).Текст);
		КонецЕсли;
		
		Стирка                   				= НайтиЗнакУхода(ОчиститьСтроку(ТабДок.Область(НомерСтроки, 36).Текст));
		Если ЗначениеЗаполнено(Стирка) Тогда
			СтрокаТаблицы.Стирка = Стирка;
		Иначе
			СтрокаТаблицы.Стирка                = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 36).Текст);
		КонецЕсли;
		
		Отбеливание                   			= НайтиЗнакУхода(ОчиститьСтроку(ТабДок.Область(НомерСтроки, 37).Текст));
		Если ЗначениеЗаполнено(Отбеливание) Тогда
			СтрокаТаблицы.Отбеливание = Отбеливание;
		Иначе
			СтрокаТаблицы.Отбеливание           = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 37).Текст);
		КонецЕсли;
		
		Глажженье                   		    = НайтиЗнакУхода(ОчиститьСтроку(ТабДок.Область(НомерСтроки, 38).Текст));
		Если ЗначениеЗаполнено(Глажженье) Тогда
			СтрокаТаблицы.Глажженье = Глажженье;
		Иначе
			СтрокаТаблицы.Глажженье             = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 38).Текст);
		КонецЕсли;

		
		Сушка                   				= НайтиЗнакУхода(ОчиститьСтроку(ТабДок.Область(НомерСтроки, 39).Текст));
		Если ЗначениеЗаполнено(Сушка) Тогда
			СтрокаТаблицы.Сушка = Сушка;
		Иначе
			СтрокаТаблицы.Сушка                 = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 39).Текст);
		КонецЕсли;


		УходЗаТекстилем                   	    = НайтиЗнакУхода(ОчиститьСтроку(ТабДок.Область(НомерСтроки, 40).Текст));
		Если ЗначениеЗаполнено(УходЗаТекстилем) Тогда
			СтрокаТаблицы.УходЗаТекстилем = УходЗаТекстилем;
		Иначе
			СтрокаТаблицы.УходЗаТекстилем       = ОчиститьСтроку(ТабДок.Область(НомерСтроки, 40).Текст);
		КонецЕсли;

	КонецЦикла;
	
	ПроверитьДублиШтрихКодов();
	
	НайтиНоменклатуруХарактеристику();
КонецПроцедуры // ПрочитатьExcel_ТабличныйДокумент()

