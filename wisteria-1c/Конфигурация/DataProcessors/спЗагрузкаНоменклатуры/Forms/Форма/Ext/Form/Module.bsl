&НаСервере
Процедура ПроверитьДублиШтрихКодов() 
	
	ШтрихкодыДляПроверки = Объект.ТабличнаяЗагрузки.Выгрузить(,"Штрихкод");
	ШтрихкодыДляПроверки.Колонки.Добавить("КоличествоДублей", Новый ОписаниеТипов("Число"));
	Для каждого СтрокаШтрихкод Из ШтрихкодыДляПроверки Цикл
		СтрокаШтрихкод.КоличествоДублей = 1;
	КонецЦикла; 
	ШтрихкодыДляПроверки.Свернуть("Штрихкод", "КоличествоДублей");  
	Для каждого СтрокаШтрихкод Из ШтрихкодыДляПроверки Цикл
	     Если СтрокаШтрихкод.КоличествоДублей > 1 Тогда
		 	 НайденыеСтроки = Объект.ТабличнаяЗагрузки.НайтиСтроки(Новый Структура("Штрихкод", СтрокаШтрихкод.Штрихкод));
			 Если НайденыеСтроки.Количество() > 1 Тогда 
				  Для каждого НайденаяСтрока Из НайденыеСтроки Цикл
				  	НайденаяСтрока.ОшибкаШтрихКода = Не БезПроверкиШтрихкодов;
				  КонецЦикла;	 
			 КонецЕсли;
		 КонецЕсли;
	 КонецЦикла;
	 
КонецПроцедуры 

&НаСервере
Процедура НайтиНоменклатуруХарактеристику()
	
	Для каждого СтрокаТабличнаяЗагрузки Из Объект.ТабличнаяЗагрузки Цикл 
		
		ЗаполнитьНоменклатуру(СтрокаТабличнаяЗагрузки); 
		
		Если (Дозагрузка Или НЕ ЗначениеЗаполнено(СтрокаТабличнаяЗагрузки.Номенклатура)) 
			И СоздатьНоменклатуруХарактеристикуПослеПрочтенияExcel Тогда
			СоздатьПерезаполнитьНоменклатуру(СтрокаТабличнаяЗагрузки)
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Процедура СоздатьПерезаполнитьНоменклатуру(СтрокаТабличнаяЗагрузки) 
	Перем НоваяНоменклатура;  
	
	Если Не Дозагрузка И ТипЗнч(СтрокаТабличнаяЗагрузки.Номенклатура) = Тип("СправочникСсылка.Номенклатура") И СтрокаТабличнаяЗагрузки.Номенклатура <> Справочники.Номенклатура.ПустаяСсылка() Тогда 
		Возврат;
	КонецЕсли;
	
	// { Иванов С.С. (TNext) - 04.06.2025 - Задача №2502 
	Если Не ЗначениеЗаполнено(СтрокаТабличнаяЗагрузки.Штрихкод) И Не БезПроверкиШтрихкодов Тогда
		
		ОбщегоНазначения.СообщитьПользователю("Не заполнены обязательные данные реквизита ""Штрихкод"" в строке №" + СтрокаТабличнаяЗагрузки.НомерСтроки );
		Возврат;
		
	КонецЕсли;
	// }
	
	// dimedrol 25.01.2025
	Если ТипЗнч(СтрокаТабличнаяЗагрузки.Производитель) <> Тип("СправочникСсылка.Контрагенты") // dimedrol 15.05.2025 Вернул проверку на заполнение ссылки
		ИЛИ СтрокаТабличнаяЗагрузки.Производитель = Справочники.Контрагенты.ПустаяСсылка() Тогда // dimedrol 15.05.2025
	//Если НЕ ЗначениеЗаполнено(СтрокаТабличнаяЗагрузки.Призводитель) Тогда // dimedrol 15.05.2025
	// end of dimedrol 25.01.2025
		ОбщегоНазначения.СообщитьПользователю("Не заполнены обязательные данные реквизита ""Производитель"" в строке №" + СтрокаТабличнаяЗагрузки.НомерСтроки );
		Возврат;
	КонецЕсли;	
	
	Если ТипЗнч(СтрокаТабличнаяЗагрузки.СтранаПроисхождения) <> Тип("СправочникСсылка.СтраныМира") 
		ИЛИ СтрокаТабличнаяЗагрузки.ОшибкаЗаполненияСтранаПроисхождения = Справочники.СтраныМира.ПустаяСсылка() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнены обязательные данные реквизита страна происхождения в строке №" + СтрокаТабличнаяЗагрузки.НомерСтроки );
		Возврат;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(СтрокаТабличнаяЗагрузки.Артикль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнены обязательные данные реквизита артикль в строке №" + СтрокаТабличнаяЗагрузки.НомерСтроки );
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТабличнаяЗагрузки.Описание) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнены обязательные данные реквизита описание в строке №" + СтрокаТабличнаяЗагрузки.НомерСтроки );
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(СтрокаТабличнаяЗагрузки.ВидНоменклатуры) <> Тип("СправочникСсылка.КатегорииНоменклатуры") 
		ИЛИ СтрокаТабличнаяЗагрузки.ВидНоменклатуры = Справочники.КатегорииНоменклатуры.ПустаяСсылка() Тогда 
		ОбщегоНазначения.СообщитьПользователю("Не заполнены обязательные данные реквизита вид номенклатуры в строке №" + СтрокаТабличнаяЗагрузки.НомерСтроки );
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(СтрокаТабличнаяЗагрузки.КодТНВЭД) <> Тип("СправочникСсылка.КлассификаторТНВЭД") 
		ИЛИ СтрокаТабличнаяЗагрузки.КодТНВЭД = Справочники.КлассификаторТНВЭД.ПустаяСсылка() Тогда 
		ОбщегоНазначения.СообщитьПользователю("Не заполнены обязательные данные реквизита вид номенклатуры в строке №" + СтрокаТабличнаяЗагрузки.НомерСтроки );
		Возврат;
	КонецЕсли;  
	
	Если СтрокаТабличнаяЗагрузки.ОшибкаШтрихКода Тогда 
		ОбщегоНазначения.СообщитьПользователю("Значение штрихкода не уникально в строке №" + СтрокаТабличнаяЗагрузки.НомерСтроки );
		Возврат;
	КонецЕсли;
	
	// dimedrol 31.01.2025
	Если ТипЗнч(СтрокаТабличнаяЗагрузки.Цвет1С) <> Тип("СправочникСсылка.спЦвета") 
		ИЛИ СтрокаТабличнаяЗагрузки.Цвет1С = Справочники.спЦвета.ПустаяСсылка() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнены обязательные данные реквизита цвет 1С в строке №" + СтрокаТабличнаяЗагрузки.НомерСтроки);
		Возврат;
	КонецЕсли;

	Если ТипЗнч(СтрокаТабличнаяЗагрузки.Размер1С) <> Тип("СправочникСсылка.спРазмеры") 
		ИЛИ СтрокаТабличнаяЗагрузки.Размер1С = Справочники.спРазмеры.ПустаяСсылка() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнены обязательные данные реквизита размер 1С в строке №" + СтрокаТабличнаяЗагрузки.НомерСтроки);
		Возврат;
	КонецЕсли;
	// end of dimedrol 31.01.2025
	
	Попытка    
		
		Если Дозагрузка И ЗначениеЗаполнено(СтрокаТабличнаяЗагрузки.Номенклатура) Тогда
			НоваяНоменклатура = СтрокаТабличнаяЗагрузки.Номенклатура.ПолучитьОбъект();
		Иначе
			НоваяНоменклатура = Справочники.Номенклатура.СоздатьЭлемент();
			// Артикул
			НоваяНоменклатура.Артикул = СтрШаблон("%1_%2_%3", СтрокаТабличнаяЗагрузки.Артикул1С, СтрокаТабличнаяЗагрузки.Цвет1С.Значение, СтрокаТабличнаяЗагрузки.Размер1С.Наименование);
		КонецЕсли;
		
		// dimedrol 30.01.2025
		//НоваяНоменклатура.Наименование = СтрШаблон("%1 %2", СтрокаТабличнаяЗагрузки.Описание, СтрокаТабличнаяЗагрузки.Артикль); 
		//НоваяНоменклатура.НаименованиеПолное = СтрШаблон("%1 %2", СтрокаТабличнаяЗагрузки.Описание, СтрокаТабличнаяЗагрузки.Артикль);
		НоваяНоменклатура.Наименование       = СтрокаТабличнаяЗагрузки.Описание;
		НоваяНоменклатура.НаименованиеПолное = СтрокаТабличнаяЗагрузки.Описание;
		// end of dimedrol 30.01.2025
		
		// dimedrol 30.01.2025
		//Если ЗначениеЗаполнено(СтрокаТабличнаяЗагрузки.ГлавныйЦвет) Тогда 
		//	НоваяНоменклатура.Артикул = СтрШаблон("%1-%2-%3", СтрокаТабличнаяЗагрузки.Артикль, СтрокаТабличнаяЗагрузки.ДопКомментарии, СтрокаТабличнаяЗагрузки.ГлавныйЦвет); 
		//Иначе
		//	НоваяНоменклатура.Артикул = СтрШаблон("%1-%2", СтрокаТабличнаяЗагрузки.Артикль, СтрокаТабличнаяЗагрузки.ДопКомментарии);
		//КонецЕсли;
		
		// Цвет
		НоваяНоменклатура.спЦвет   = СтрокаТабличнаяЗагрузки.Цвет1С;
		
		// Размер
		НоваяНоменклатура.спРазмер = СтрокаТабличнаяЗагрузки.Размер1С;
		// end of dimedrol
	
		НоваяНоменклатура.спАртикулПоставщика = СтрокаТабличнаяЗагрузки.Артикль;

		НоваяНоменклатура.ЕдиницаИзмерения = ?(ТипЗнч(СтрокаТабличнаяЗагрузки.ЕдИзм) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения"), СтрокаТабличнаяЗагрузки.ЕдИзм, Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка());
		// dimedrol 25.01.2025
		//НоваяНоменклатура.Производитель = ?(ТипЗнч(СтрокаТабличнаяЗагрузки.Производитель) = Тип("СправочникСсылка.Контрагенты"), СтрокаТабличнаяЗагрузки.Призводитель, Справочники.Контрагенты.ПустаяСсылка()); 
		Если  ТипЗнч(СтрокаТабличнаяЗагрузки.Производитель) = Тип("СправочникСсылка.Контрагенты")
			И СтрокаТабличнаяЗагрузки.Производитель <> Справочники.Контрагенты.ПустаяСсылка() Тогда
			ПроизводительСсылка = СтрокаТабличнаяЗагрузки.Производитель;
		// dimedrol 15.05.2025
		// Алена:Добавить проверку при загрузке реквизита Номенклатура.Производитель - искать по наименованию в справочнике Контрагенты, если такого нет, 
		// то не загружать номенклатуру, подсвечивать красным в табличной части товаров после чтения внешнего файла (например, как страна или код тн вэд)
			
		// Закомментировал создание, вернул проверку в условном оформлении, переименовал реквизит табличной части бал "Призводитель"
		//Иначе
		//	ПроизводительСсылка = НайтиСоздатьКонтрагента(СтрокаТабличнаяЗагрузки.Призводитель, СтрокаТабличнаяЗагрузки.АдресПроизводителя);
		// end of dimedrol 15.05.2025
			
			НоваяНоменклатура.Производитель = ПроизводительСсылка;
		КонецЕсли;
		
		// end of dimedrol 25.01.2025
		НоваяНоменклатура.Родитель = ?(ТипЗнч(СтрокаТабличнаяЗагрузки.Тип) = Тип("СправочникСсылка.Номенклатура"), СтрокаТабличнаяЗагрузки.Тип, Справочники.Номенклатура.ПустаяСсылка());                                                                                                               
		НоваяНоменклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас;  
		НоваяНоменклатура.КатегорияНоменклатуры = ?(ТипЗнч(СтрокаТабличнаяЗагрузки.ВидНоменклатуры) = Тип("СправочникСсылка.КатегорииНоменклатуры"), СтрокаТабличнаяЗагрузки.ВидНоменклатуры, Справочники.КатегорииНоменклатуры.ПустаяСсылка()); 
		// dimedrol 30.01.2025
		ОбновитьРеквизиты = Истина;
		КатегорииНоменклатурыСервер.ЗаполнитьСвойстваНоменклатурыПоКатегории(НоваяНоменклатура, ОбновитьРеквизиты);
		// end of dimedrol 30.01.2025
		
		НоваяНоменклатура.СтранаПроисхождения = ?(ТипЗнч(СтрокаТабличнаяЗагрузки.СтранаПроисхождения) = Тип("СправочникСсылка.СтраныМира"), СтрокаТабличнаяЗагрузки.СтранаПроисхождения, Справочники.СтраныМира.ПустаяСсылка()); 
		
		Если ТипЗнч(СтрокаТабличнаяЗагрузки.НДС) = Тип("СправочникСсылка.СтавкиНДС") Тогда  
			НоваяНоменклатура.ВидСтавкиНДС = СтрокаТабличнаяЗагрузки.НДС.ВидСтавкиНДС;
		КонецЕсли;
		
		НоваяНоменклатура.ТоварнаяНоменклатураВЭД = ?(ТипЗнч(СтрокаТабличнаяЗагрузки.КодТНВЭД) = Тип("СправочникСсылка.КлассификаторТНВЭД"), 
														СтрокаТабличнаяЗагрузки.КодТНВЭД, Справочники.КлассификаторТНВЭД.ПустаяСсылка());
		
		// dimedrol 24.02.2025
		// Алена Коваль: Переделать бренд в реквизит со справочником коэффициента цен - загрузка номенклатуры чтобы грузилось и то то, 
		// сделать справочник, скрыть доп реквизит, добавить в расширение заполнение реквизита (как цвет и размер), в справчоник подготовить таблицу для загрузки.
		//
		// Реквизит "Бренд" табличной части обработки - строка. Для единообразия его нужно переделать в справочник "спБренды" и заполнять при чтении Excel.
		// Но нужно созранить и доп. реквизит. Пока будем искать элемент тут.
		Если ЗначениеЗаполнено(СтрокаТабличнаяЗагрузки["Бренд"]) Тогда
			БрендСтрокой = СтрокаТабличнаяЗагрузки["Бренд"];
			БрендСсылка  = Справочники.спБренды.НайтиПоНаименованию(БрендСтрокой, Истина);
			Если НЕ ЗначениеЗаполнено(БрендСсылка) Тогда
				БрендОбъект = Справочники.спБренды.СоздатьЭлемент();
				БрендОбъект.Наименование = БрендСтрокой;
				БрендОбъект.Записать();
				БрендСсылка = БрендОбъект.Ссылка;
			КонецЕсли;
			НоваяНоменклатура.спБренд = БрендСсылка;
		КонецЕсли;
		// end of dimedrol 24.02.202
		
		// dimedrol 15.05.2025
		Если ЗначениеЗаполнено(СтрокаТабличнаяЗагрузки["Поставщик"]) Тогда
			НоваяНоменклатура.Поставщик = СтрокаТабличнаяЗагрузки["Поставщик"];
		КонецЕсли;
		// end of dimedrol 15.05.2025
		
		НоваяНоменклатура.Записать();
	Исключение
		// dimedrol 30.01.2025
		//ОбщегоНазначения.СообщитьПользователю("Ошибка создания номенклатуры");
		ТекстСообщения = НСтр("ru = 'Ошибка создания номенклатуры: %ИнформацияОбОшибке%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ИнформацияОбОшибке%", ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		// end of dimedrol 30.01.2025
		Возврат;
	КонецПопытки;  
	
	Если ТипЗнч(НоваяНоменклатура) = Тип("СправочникОбъект.Номенклатура") Тогда 
		   
		// dimedrol 30.01.2025
		// Заполнил ревизиты выше "КатегорииНоменклатурыСервер.ЗаполнитьСвойстваНоменклатурыПоКатегории"
		//Попытка
		//	ЗаполнитьРеквизитыПоКатегории(НоваяНоменклатура); 
		//Исключение
		//	ОбщегоНазначения.СообщитьПользователю("Ошибка заполнения реквизитов заполняемых из категории");
		//	Возврат;
		//КонецПопытки;
		// end of dimedrol 30.01.2025
		
		Попытка
			ЗаполнитьДополнительныеРеквизитыНоменклатуры(НоваяНоменклатура, СтрокаТабличнаяЗагрузки); 
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Ошибка заполнения дополнительных свойств номенклатуры");
			Возврат;
		КонецПопытки;  
		
		Попытка
			ЗагрузитьИзображениеНаСервере(НоваяНоменклатура, СтрокаТабличнаяЗагрузки); 
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Ошибка добавления изображения номенклатуры");
			Возврат;
		КонецПопытки; 
		
		Попытка
			ЗагрузитьЗнакиУхода(НоваяНоменклатура, СтрокаТабличнаяЗагрузки); 
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Ошибка добавления знаков ухода номенклатуры");
			Возврат;
		КонецПопытки; 
		
		Попытка
			Если Не БезПроверкиШтрихкодов Тогда
				ЗаполнитьШтрихКодНоменклатуры(НоваяНоменклатура, СтрокаТабличнаяЗагрузки);
			КонецЕсли;
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Ошибка заполнения штрихкода номенклатуры");
		КонецПопытки; 
		
		// dimedrol 30.01.2025
		Попытка
			ЗаполнитьGTINНоменклатуры(НоваяНоменклатура, СтрокаТабличнаяЗагрузки);
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Ошибка заполнения GTIN номенклатуры");
		КонецПопытки;
		// end of dimedrol 30.01.2025
		
	КонецЕсли;
	
	Если ТипЗнч(НоваяНоменклатура) = Тип("СправочникОбъект.Номенклатура") И НоваяНоменклатура.Ссылка <> Справочники.Номенклатура.ПустаяСсылка() Тогда 
		СтрокаТабличнаяЗагрузки.Номенклатура = НоваяНоменклатура.Ссылка; 
	КонецЕсли;
КонецПроцедуры 

&НаСервере
Процедура ЗагрузитьИзображениеНаСервере(Номенклатура, СтрокаТабличнаяЗагрузки)  
	ИмяФайла = ""; 
	НомерСтроки = СтрокаТабличнаяЗагрузки.НомерСтроки;
	НомерСтроки = НомерСтроки + 2;
	
	АдресОбластиРисунка = "R" + НомерСтроки + "C1:R" + НомерСтроки + "C" + 1;
	Для Каждого РисунокТД ИЗ ТабДок.ПолучитьОбласть(АдресОбластиРисунка).Рисунки Цикл  
		ИмяФайла = КаталогВременныхФайлов() + Новый УникальныйИдентификатор() + ".jpg";
		РисунокТД.Картинка.Записать(ИмяФайла); 
		Прервать;
	КонецЦикла;
	
	
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		
		Файл = Новый Файл(ИмяФайла);
		Если Файл.Существует() Тогда
			
			ПрисоединенныйФайлНайден = Ложь;
			
			Если Не Номенклатура.Ссылка.Пустая() Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ
				|    НоменклатураПрисоединенныеФайлы.Ссылка КАК Ссылка
				|ИЗ
				|    Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
				|ГДЕ
				|    НоменклатураПрисоединенныеФайлы.ВладелецФайла = &Номенклатура
				|    И НоменклатураПрисоединенныеФайлы.Наименование = &ИмяБезРасширения
				|    И НЕ НоменклатураПрисоединенныеФайлы.ПометкаУдаления";
				
				Запрос.УстановитьПараметр("Номенклатура", Номенклатура.Ссылка);
				Запрос.УстановитьПараметр("ИмяБезРасширения", Файл.ИмяБезРасширения);
				
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					
					ПрисоединенныйФайлНайден = Истина;
					ПрисоединенныйФайл = Выборка.Ссылка;
					
					Если ПрисоединенныйФайл.ДатаМодификацииУниверсальная <> Файл.ПолучитьУниверсальноеВремяИзменения() Тогда
						
						ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайла);
						
						ИнформацияОФайле = Новый Структура;
						ИнформацияОФайле.Вставить("АдресФайлаВоВременномХранилище", ПоместитьВоВременноеХранилище(ДвоичныеДанные));
						ИнформацияОФайле.Вставить("АдресВременногоХранилищаТекста", "");
						
						РаботаСФайлами.ОбновитьФайл(ПрисоединенныйФайл, ИнформацияОФайле);
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если Не ПрисоединенныйФайлНайден Тогда
				
				СсылкаНаОбъект = Номенклатура.Ссылка;
				Если СсылкаНаОбъект.Пустая() Тогда
					СсылкаНаОбъект = Номенклатура.ПолучитьСсылкуНового();
					Если СсылкаНаОбъект.Пустая() Тогда
						СсылкаНаОбъект = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Номенклатура.Ссылка).ПолучитьСсылку();
						Номенклатура.УстановитьСсылкуНового(СсылкаНаОбъект);
					КонецЕсли;
				КонецЕсли;
				
				ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
				ПараметрыФайла.ВладелецФайлов = СсылкаНаОбъект;
				ПараметрыФайла.ВремяИзмененияУниверсальное = Файл.ПолучитьУниверсальноеВремяИзменения();
				ПараметрыФайла.ИмяБезРасширения = Файл.ИмяБезРасширения;
				ПараметрыФайла.РасширениеБезТочки = ОбщегоНазначенияКлиентСервер.РасширениеБезТочки(Файл.Расширение);
				
				ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайла);
				АдресФайлаВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
				
				ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресФайлаВоВременномХранилище, "");
				
