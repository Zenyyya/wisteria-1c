&НаСервере
Процедура ЗагрузитьЗнакиУхода(Знач Номенклатура, СтрокаТабличнаяЗагрузки) 
	Если ТипЗнч(Номенклатура) = Тип("СправочникОбъект.Номенклатура") Тогда 
		Номенклатура = Номенклатура.Ссылка;
	КонецЕсли;
	Стирка           = СтрокаТабличнаяЗагрузки["Стирка"]; 
	Отбеливание      = СтрокаТабличнаяЗагрузки["Отбеливание"];
	Глажженье        = СтрокаТабличнаяЗагрузки["Глажженье"];
	Сушка            = СтрокаТабличнаяЗагрузки["Сушка"];
	УходЗаТекстилем  = СтрокаТабличнаяЗагрузки["УходЗаТекстилем"];
	
	Если ТипЗнч(Стирка) = Тип("СправочникСсылка.спЗнакиУхода") И Стирка <> Справочники.спЗнакиУхода.ПустаяСсылка() Тогда 
		ЗаполнитьРегистрЗнакиУходаВНоменклатуре(Номенклатура, Стирка);
	КонецЕсли;  
	
	Если ТипЗнч(Отбеливание) = Тип("СправочникСсылка.спЗнакиУхода") И Отбеливание <> Справочники.спЗнакиУхода.ПустаяСсылка() Тогда 
		ЗаполнитьРегистрЗнакиУходаВНоменклатуре(Номенклатура, Отбеливание);
	КонецЕсли;
	
	Если ТипЗнч(Глажженье) = Тип("СправочникСсылка.спЗнакиУхода") И Глажженье <> Справочники.спЗнакиУхода.ПустаяСсылка() Тогда 
		ЗаполнитьРегистрЗнакиУходаВНоменклатуре(Номенклатура, Глажженье);
	КонецЕсли;
	
	Если ТипЗнч(Сушка) = Тип("СправочникСсылка.спЗнакиУхода") И Сушка <> Справочники.спЗнакиУхода.ПустаяСсылка() Тогда 
		ЗаполнитьРегистрЗнакиУходаВНоменклатуре(Номенклатура, Сушка);
	КонецЕсли;
	
	Если ТипЗнч(УходЗаТекстилем) = Тип("СправочникСсылка.спЗнакиУхода") И УходЗаТекстилем <> Справочники.спЗнакиУхода.ПустаяСсылка() Тогда 
		ЗаполнитьРегистрЗнакиУходаВНоменклатуре(Номенклатура, УходЗаТекстилем);
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Функция НайтиЗнакУхода(ЗнакУхода)   
	ЗнакУходаСсылка = Справочники.спЗнакиУхода.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ЗнакУхода) Тогда 
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	спЗнакиУхода.Ссылка КАК Ссылка,
		|	спЗнакиУхода.Наименование КАК Наименование
		|ИЗ
		|	Справочник.спЗнакиУхода КАК спЗнакиУхода
		|ГДЕ
		|	спЗнакиУхода.Наименование ПОДОБНО &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", ЗнакУхода);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗнакУходаСсылка = ВыборкаДетальныеЗаписи.Ссылка;
		Прервать;
	КонецЦикла;
	КонецЕсли;

    Возврат ЗнакУходаСсылка;
КонецФункции

&НаСервере
Процедура ЗаполнитьРегистрЗнакиУходаВНоменклатуре(Номенклатура, ЗнакУхода) 
	НаборЗаписей = РегистрыСведений.спЗнакиУходаВНоменклатуре.СоздатьНаборЗаписей();
	Отбор = НаборЗаписей.Отбор;
	Отбор.Номенклатура.Установить(Номенклатура); 
	Отбор.ЗнакиУхода.Установить(ЗнакУхода);
	
	НаборЗаписей.Прочитать(); 
	
	Если НаборЗаписей.Количество() = 0 Тогда	
		НоваяЗапись = НаборЗаписей.Добавить(); 
		НоваяЗапись.Номенклатура 	= Номенклатура; 
		НоваяЗапись.ЗнакиУхода 		= ЗнакУхода; 
		НоваяЗапись.Использование 	= Истина; 
	ИначеЕсли НаборЗаписей.Количество() = 1 Тогда
		НоваяЗапись = НаборЗаписей[0];
		НоваяЗапись.ЗнакиУхода 		= ЗнакУхода;	
	КонецЕсли; 
   	НаборЗаписей.Записать(); 	
КонецПроцедуры

