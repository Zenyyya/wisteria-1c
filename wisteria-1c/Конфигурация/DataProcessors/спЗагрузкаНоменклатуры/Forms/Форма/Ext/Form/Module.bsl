	ЭлементУсловия.ПравоеЗначение = Истина;
	
	ОформляемоеПоле = ЭлементРазмер1С.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТабличнаяЗагрузкиРазмер1С");
	ОформляемоеПоле.Использование = Истина;
	// end of dimedrol 03.02.2025
	
КонецПроцедуры

