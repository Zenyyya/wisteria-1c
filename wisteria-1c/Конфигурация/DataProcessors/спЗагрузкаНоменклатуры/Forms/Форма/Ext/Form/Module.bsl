#Область ПроцедурыЧтенияФайлаExcel  

&НаСервере
Процедура УсловноеОформлениеТаблицыЗагрузки() 
	
	Для каждого СтрокаОбъектТабличнаяЗагрузки Из Объект.ТабличнаяЗагрузки Цикл  
		Если ЗначениеЗаполнено(СтрокаОбъектТабличнаяЗагрузки.Артикль) И НЕ ЗначениеЗаполнено(СтрокаОбъектТабличнаяЗагрузки.Номенклатура) Тогда
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияНоменклатуры = Истина; 
		Иначе 
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияНоменклатуры = Ложь;
		КонецЕсли;
		
		// dimedrol 25.01.2025
		Если ТипЗнч(СтрокаОбъектТабличнаяЗагрузки.Производитель) <> Тип("СправочникСсылка.Контрагенты") // dimedrol 15.05.2025 вернул проверку на ссылку, переименовал реквизит, был "Призводитель"
			ИЛИ СтрокаОбъектТабличнаяЗагрузки.Производитель = Справочники.Контрагенты.ПустаяСсылка() Тогда // dimedrol 15.05.2025 вернул проверку на ссылку, переименовал реквизит, был "Призводитель"
		//Если НЕ ЗначениеЗаполнено(СтрокаОбъектТабличнаяЗагрузки.Призводитель) Тогда // dimedrol 15.05.2025 вернул проверку.
		// end of dimedrol 25.01.2025
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияПроизводитель = Истина;
		Иначе 
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияПроизводитель = Ложь;
		КонецЕсли;	
		
		Если ТипЗнч(СтрокаОбъектТабличнаяЗагрузки.СтранаПроисхождения) <> Тип("СправочникСсылка.СтраныМира") 
			ИЛИ СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияСтранаПроисхождения = Справочники.СтраныМира.ПустаяСсылка() Тогда
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияСтранаПроисхождения = Истина;
		Иначе 
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияСтранаПроисхождения = Ложь;
		КонецЕсли;	
		
		// dimedrol 03.02.2025
		Если ТипЗнч(СтрокаОбъектТабличнаяЗагрузки.Цвет1С) <> Тип("СправочникСсылка.спЦвета")
			ИЛИ СтрокаОбъектТабличнаяЗагрузки.Цвет1С = Справочники.спЦвета.ПустаяСсылка() Тогда
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияЦвет1С = Истина;
		Иначе
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияЦвет1С = Ложь;
		КонецЕсли;
		
		Если ТипЗнч(СтрокаОбъектТабличнаяЗагрузки.Размер1С) <> Тип("СправочникСсылка.спРазмеры")
			ИЛИ СтрокаОбъектТабличнаяЗагрузки.Размер1С = Справочники.спРазмеры.ПустаяСсылка() Тогда
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияРазмер1С = Истина;
		Иначе
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияРазмер1С = Ложь;
		КонецЕсли;
		// end of dimedrol 03.02.2025
		
		Если НЕ ЗначениеЗаполнено(СтрокаОбъектТабличнаяЗагрузки.Артикль) Тогда
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияАртикль = Истина;
		Иначе 
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияАртикль = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаОбъектТабличнаяЗагрузки.Описание) Тогда
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияОписание = Истина;
		Иначе 
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияОписание = Ложь;
		КонецЕсли;
		
		Если ТипЗнч(СтрокаОбъектТабличнаяЗагрузки.ВидНоменклатуры) <> Тип("СправочникСсылка.КатегорииНоменклатуры") 
			ИЛИ СтрокаОбъектТабличнаяЗагрузки.ВидНоменклатуры = Справочники.КатегорииНоменклатуры.ПустаяСсылка() Тогда
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияВидНоменклатуры = Истина;
		Иначе 
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияВидНоменклатуры = Ложь;
		КонецЕсли;	
		
				
		Если ТипЗнч(СтрокаОбъектТабличнаяЗагрузки.КодТНВЭД) <> Тип("СправочникСсылка.КлассификаторТНВЭД") 
			ИЛИ СтрокаОбъектТабличнаяЗагрузки.КодТНВЭД = Справочники.КлассификаторТНВЭД.ПустаяСсылка() Тогда
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияКодТНВЭД = Истина; 
		Иначе 
			СтрокаОбъектТабличнаяЗагрузки.ОшибкаЗаполненияКодТНВЭД = Ложь;
		КонецЕсли;

		
	КонецЦикла; 
	
	// Номенклатура
	ЭлементУОНоменклатура = УсловноеОформление.Элементы.Добавить();				
	ЭлементУОНоменклатура.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Красный);
	ЭлементУОНоменклатура.Использование = Истина;
	
	ЭлементУсловия = ЭлементУОНоменклатура.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ТабличнаяЗагрузки.ОшибкаЗаполненияНоменклатуры");
	ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение = Истина; 

	ОформляемоеПоле = ЭлементУОНоменклатура.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТабличнаяЗагрузкиНоменклатура");
	ОформляемоеПоле.Использование = Истина;	

	// Производитель 	
	ЭлементУОПроизводитель = УсловноеОформление.Элементы.Добавить();				
	ЭлементУОПроизводитель.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Красный);
	ЭлементУОПроизводитель.Использование = Истина;
	
	ЭлементУсловия = ЭлементУОПроизводитель.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ТабличнаяЗагрузки.ОшибкаЗаполненияПроизводитель");
	ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение = Истина;
	
	ОформляемоеПоле = ЭлементУОПроизводитель.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТабличнаяЗагрузкиПроизводитель");
	ОформляемоеПоле.Использование = Истина;	
	
	// Страна происхождения 	
	ЭлементУОСтранаПроисхождения = УсловноеОформление.Элементы.Добавить();				
	ЭлементУОСтранаПроисхождения.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Красный);
	ЭлементУОСтранаПроисхождения.Использование = Истина;
	
	ЭлементУсловия = ЭлементУОСтранаПроисхождения.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ТабличнаяЗагрузки.ОшибкаЗаполненияСтранаПроисхождения");
	ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение = Истина;
	
	ОформляемоеПоле = ЭлементУОСтранаПроисхождения.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТабличнаяЗагрузкиСтранаПроисхождения");
	ОформляемоеПоле.Использование = Истина;   
	
	// Артикль 	
	ЭлементУОАртикль = УсловноеОформление.Элементы.Добавить();				
	ЭлементУОАртикль.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Красный);
	ЭлементУОАртикль.Использование = Истина;
	
	ЭлементУсловия = ЭлементУОАртикль.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ТабличнаяЗагрузки.ОшибкаЗаполненияАртикль");
	ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение = Истина;
	
	ОформляемоеПоле = ЭлементУОАртикль.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТабличнаяЗагрузкиАртикль");
	ОформляемоеПоле.Использование = Истина;
	
	// Описание 	
	ЭлементУООписание = УсловноеОформление.Элементы.Добавить();				
	ЭлементУООписание.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Красный);
	ЭлементУООписание.Использование = Истина;
	
	ЭлементУсловия = ЭлементУООписание.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ТабличнаяЗагрузки.ОшибкаЗаполненияОписание");
	ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение = Истина;
	
	ОформляемоеПоле = ЭлементУООписание.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТабличнаяЗагрузкиОписание");
	ОформляемоеПоле.Использование = Истина;  
	
    // Вид номенклатуры	
	ЭлементУОВидНоменклатуры = УсловноеОформление.Элементы.Добавить();				
	ЭлементУОВидНоменклатуры.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Красный);
