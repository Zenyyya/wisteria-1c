&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы) 
	ТаблицаЗагрузкиНоменклатураХарактеристика = Новый Массив;
	Если Объект.ТабличнаяЗагрузки.Количество() > 0 Тогда 
		Для каждого СтрокаТаблицы Из Объект.ТабличнаяЗагрузки Цикл
			Если ТипЗнч(СтрокаТаблицы.Номенклатура) = Тип("СправочникСсылка.Номенклатура") 
				И СтрокаТаблицы.Номенклатура <> ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка") Тогда 
				РезультатПодбора = Новый Структура;
				РезультатПодбора.Вставить("Номенклатура", СтрокаТаблицы.Номенклатура);
				РезультатПодбора.Вставить("Количество", СтрокаТаблицы.Всего);  
				РезультатПодбора.Вставить("Цена", СтрокаТаблицы.Цена); 
				ТаблицаЗагрузкиНоменклатураХарактеристика.Добавить(РезультатПодбора);  
			КонецЕсли;
		КонецЦикла;
		ОповеститьОВыборе(ТаблицаЗагрузкиНоменклатураХарактеристика); 
	КонецЕсли;
КонецПроцедуры

