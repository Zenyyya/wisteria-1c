	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.СтатусСообщения <> Перечисления.спСтатусыСообщений.ОтправкаПодтверждена Тогда 
			Ошибка = Истина; 
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ошибка;	
КонецФункции

// Получить сообщение. 
Функция ПолучитьДанныеФайлаXML(Сообщение, Идентификатор, ДатаРегистрации, ФорматСообщения, ТипОбъекта, СпособПередачи, ТипОчередей) Экспорт	
	
	СообщениеXML = Неопределено; 
	
	Если СпособПередачи = Перечисления.спСпособПередачи.FTP И ТипОбъекта = "Справочник.Номенклатура" 
		И ФорматСообщения = Перечисления.спФорматыСообщений.XML Тогда 

		Попытка
			СообщениеXML = ЧтениеXML(Сообщение);
		Исключение 
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации("Чтение XML для исходящего сообщения", УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке)); 
		КонецПопытки; 
	
	КонецЕсли;   
	Возврат СообщениеXML;
 КонецФункции

Функция ЧтениеXML(Сообщение)  
	
	Чтение = Новый ЧтениеXML(); 
	Чтение.УстановитьСтроку(Сообщение);  
	
	СтруктураСообщения = Новый Структура();
	СтекУзлов = Новый Массив;
	ТекущийПуть = "";
	
	Пока Чтение.Прочитать() Цикл    
		
		// Прочитать "структурные части" элементов. 
		// Проверить, какая часть элемента - текущая. 
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			
			Если Чтение.Имя = "productMasterDataRequest" Тогда 
				Продолжить;
			КонецЕсли;
			
			СтекУзлов.Добавить(Чтение.Имя);
			ТекущийПуть = МассивВСтроку(СтекУзлов); 
			
			// Атрибуты элементов можно читать только если текущая часть - 
			// начало элемента  
			Если Чтение.Имя = "prices" И ТекущийПуть = "main/prices" Тогда 
				prices = Новый Массив; 
			ИначеЕсли Чтение.Имя = "price" И ТекущийПуть = "main/prices/price" Тогда 
				price = Новый Структура("id, name, currency");
			ИначеЕсли Чтение.Имя = "items" И ТекущийПуть = "items" Тогда 
				items = Новый Массив;
			ИначеЕсли Чтение.Имя = "item" И ТекущийПуть = "items/item" Тогда 
				item = Новый Структура("uuid, active, parentId, typeItemId, article, name, images, fullDescr, shortDescr, materialDescr, vatCode, color, packingUnit, sizesInfo, stateCodes");
			ИначеЕсли Чтение.Имя = "packingUnit" И ТекущийПуть = "items/item/packingUnit" Тогда
				packingUnit = Новый Структура("length, width, height, volume, weight");
			ИначеЕсли Чтение.Имя = "sizesInfo" И ТекущийПуть = "items/item/sizesInfo" Тогда
				sizesInfo = Новый Массив;
			ИначеЕсли Чтение.Имя = "sizeInfo" И ТекущийПуть = "items/item/sizesInfo/sizeInfo" Тогда
				sizeInfo = Новый Структура("size, sizeText, ean, prices, addFieldValues");
			ИначеЕсли Чтение.Имя = "prices" И ТекущийПуть = "items/item/sizesInfo/sizeInfo/prices" Тогда
				sizeInfoPrices = Новый Массив;
			ИначеЕсли Чтение.Имя = "price" И ТекущийПуть = "items/item/sizesInfo/sizeInfo/prices/price" Тогда
				sizeInfoPrice = Новый Структура("price, id"); 
				
			ИначеЕсли Чтение.Имя = "stateCodes" И ТекущийПуть = "items/item/stateCodes" Тогда
				stateCodes = Новый Структура("tnved, okpd2");

			КонецЕсли;  
			
				
			Пока Чтение.ПрочитатьАтрибут() Цикл 
				
				Если НЕ ЗначениеЗаполнено(ТекущийПуть) Тогда 
					Продолжить;
				КонецЕсли;
				
				// Прочитать данные узла атрибута. 
				ТипУзла = Чтение.ТипУзла; 
				Имя = Чтение.Имя; 
				Значение = Чтение.Значение; 
				
				// Обработать полученные значения.
				Если Чтение.Имя = "id" И ТекущийПуть = "main/prices/price" Тогда
					price.Вставить("id", XMLСтрока(Значение));
				ИначеЕсли Чтение.Имя = "uuid" И ТекущийПуть = "items/item" Тогда
					item.Вставить("uuid", XMLСтрока(Значение)); 
				ИначеЕсли Чтение.Имя = "size" И ТекущийПуть = "items/item/sizesInfo/sizeInfo" Тогда	
					sizeInfo.Вставить("size", XMLСтрока(Значение));
				ИначеЕсли Чтение.Имя = "id" И ТекущийПуть = "items/item/sizesInfo/sizeInfo/prices/price" Тогда
					sizeInfoPrice.Вставить("id", XMLСтрока(Значение));
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
			Если НЕ ЗначениеЗаполнено(ТекущийПуть) Тогда 
				Продолжить;
			КонецЕсли;
			
			// Обработать полученные значения.			
			Если  ТекущийПуть = "main/prices/price/name" Тогда  
				price.Вставить("name", XMLСтрока(Чтение.Значение)); 
			ИначеЕсли ТекущийПуть = "main/prices/price/currency" Тогда 
				price.Вставить("currency", XMLСтрока(Чтение.Значение));
				
			ИначеЕсли ТекущийПуть = "items/item/active" Тогда 
				item.Вставить("active", XMLСтрока(Чтение.Значение));   
			ИначеЕсли ТекущийПуть = "items/item/parentId" Тогда 
				item.Вставить("parentId", XMLСтрока(Чтение.Значение));
			ИначеЕсли ТекущийПуть = "items/item/typeItemId" Тогда 
				item.Вставить("typeItemId", XMLСтрока(Чтение.Значение));
			ИначеЕсли ТекущийПуть = "items/item/article" Тогда 
				item.Вставить("article", XMLСтрока(Чтение.Значение));
			ИначеЕсли ТекущийПуть = "items/item/name" Тогда 
				item.Вставить("name", XMLСтрока(Чтение.Значение));  
				
			ИначеЕсли ТекущийПуть = "items/item/images" Тогда 
				item.Вставить("images", XMLСтрока(Чтение.Значение)); 
			ИначеЕсли ТекущийПуть = "items/item/fullDescr" Тогда 
				item.Вставить("fullDescr", XMLСтрока(Чтение.Значение)); 
			ИначеЕсли ТекущийПуть = "items/item/shortDescr" Тогда 
				item.Вставить("shortDescr", XMLСтрока(Чтение.Значение)); 
			ИначеЕсли ТекущийПуть = "items/item/materialDescr" Тогда 
				item.Вставить("materialDescr", XMLСтрока(Чтение.Значение)); 
			ИначеЕсли ТекущийПуть = "items/item/vatCode" Тогда 
				item.Вставить("vatCode", XMLСтрока(Чтение.Значение)); 
			ИначеЕсли ТекущийПуть = "items/item/color" Тогда 
				item.Вставить("color", XMLСтрока(Чтение.Значение)); 
				
				
			ИначеЕсли ТекущийПуть = "items/item/packingUnit/length" Тогда 
				packingUnit.Вставить("length", XMLСтрока(Чтение.Значение));
			ИначеЕсли ТекущийПуть = "items/item/packingUnit/width" Тогда 
				packingUnit.Вставить("width", XMLСтрока(Чтение.Значение));
			ИначеЕсли ТекущийПуть = "items/item/packingUnit/height" Тогда 
				packingUnit.Вставить("height", XMLСтрока(Чтение.Значение));
			ИначеЕсли ТекущийПуть = "items/item/packingUnit/volume" Тогда 
				packingUnit.Вставить("volume", XMLСтрока(Чтение.Значение));
			ИначеЕсли ТекущийПуть = "items/item/packingUnit/weight" Тогда 
				packingUnit.Вставить("weight", XMLСтрока(Чтение.Значение));
				
			ИначеЕсли ТекущийПуть = "items/item/sizesInfo/sizeInfo/sizeText" Тогда 
				sizeInfo.Вставить("sizeText", XMLСтрока(Чтение.Значение));
			ИначеЕсли ТекущийПуть = "items/item/sizesInfo/sizeInfo/sizeText" Тогда 
				sizeInfo.Вставить("sizeText", XMLСтрока(Чтение.Значение));
			ИначеЕсли ТекущийПуть = "items/item/sizesInfo/sizeInfo/ean" Тогда 
				sizeInfo.Вставить("ean", XMLСтрока(Чтение.Значение));
				
			ИначеЕсли ТекущийПуть = "items/item/sizesInfo/sizeInfo/prices/price" Тогда
				sizeInfoPrice.Вставить("price", XMLСтрока(Чтение.Значение)); 
				
			ИначеЕсли ТекущийПуть = "items/item/stateCodes/tnved" Тогда
                 stateCodes.Вставить("tnved", XMLСтрока(Чтение.Значение));  
			ИначеЕсли ТекущийПуть = "items/item/stateCodes/okpd2" Тогда
                 stateCodes.Вставить("okpd2", XMLСтрока(Чтение.Значение));
			КонецЕсли; 

			
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если НЕ ЗначениеЗаполнено(ТекущийПуть) Тогда 
				Продолжить;
			КонецЕсли;
			// Обработать полученные значения.
			Если ТекущийПуть = "main/prices/price" И Чтение.Имя = "price" Тогда   
				prices.Добавить(price);
			ИначеЕсли ТекущийПуть = "items/item/packingUnit" И Чтение.Имя = "packingUnit" Тогда   
				item.Вставить("packingUnit", packingUnit); 
			ИначеЕсли ТекущийПуть = "items/item/sizesInfo/sizeInfo/prices/price" И Чтение.Имя = "price" Тогда   
				sizeInfoPrices.Добавить(sizeInfoPrice);  
			ИначеЕсли ТекущийПуть = "items/item/sizesInfo/sizeInfo/prices" И Чтение.Имя = "prices" Тогда   
				sizeInfo.Вставить("prices", sizeInfoPrices);   
			ИначеЕсли ТекущийПуть = "items/item/sizesInfo/sizeInfo" И Чтение.Имя = "sizeInfo" Тогда   
				sizesInfo.Добавить(sizeInfo); 
			ИначеЕсли ТекущийПуть = "items/item/sizesInfo" И Чтение.Имя = "sizesInfo" Тогда   
				item.Вставить("sizesInfo", sizesInfo);
			ИначеЕсли ТекущийПуть = "items/item/stateCodes" И Чтение.Имя = "stateCodes" Тогда   
				item.Вставить("stateCodes", stateCodes);
			ИначеЕсли ТекущийПуть = "items/item" И Чтение.Имя = "item" Тогда   
				items.Добавить(item);
				
			КонецЕсли;  
			
			Если СтекУзлов.Количество() = 0 Тогда
				Прервать;
			КонецЕсли;
			СтекУзлов.Удалить(СтекУзлов.Количество() - 1);
			ТекущийПуть = МассивВСтроку(СтекУзлов);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	СтруктураСообщения.Вставить("prices", prices); 
	СтруктураСообщения.Вставить("items", items);
	
	Возврат СтруктураСообщения; 
КонецФункции

Функция МассивВСтроку(Массив)
	Возврат СтрСоединить(Массив, "/");
КонецФункции 

Функция ЧтениеИЗаписьXMLИзПодготовленныхДанных(ДанныеДляФайла) Экспорт 
	ПрочтенноеСообщение = Новый Структура;
	ВременныйФайл = ПолучитьИмяВременногоФайла("xml");
	Попытка
		ПолучитьФайлXML(ВременныйФайл, ДанныеДляФайла);
	Исключение 
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации("Чтение и запись XML в исходящее сообщение", УровеньЖурналаРегистрации.Ошибка, , ,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке)); 
	КонецПопытки; 
			
	Двоичное = Новый ДвоичныеДанные(ВременныйФайл); 
	
	ПрочтенноеСообщение.Вставить("ДвоичныеДанные", ПоместитьВоВременноеХранилище(Двоичное)); 
	ПрочтенноеСообщение.Вставить("Префикс", "FE714");	

	Возврат ПрочтенноеСообщение;
КонецФункции

Функция ПолучитьФайлXML(ИмяВременногоФайла, ДанныеДляФайла)
	prices  = Новый ТаблицаЗначений;
	prices.Колонки.Добавить("id", Новый ОписаниеТипов("Строка"));
	prices.Колонки.Добавить("name", Новый ОписаниеТипов("Строка"));
	prices.Колонки.Добавить("currency", Новый ОписаниеТипов("Строка"));
	
	Для каждого Данные Из ДанныеДляФайла Цикл
		
		Для каждого pricе Из Данные.prices Цикл 
			НоваяСтрока =  prices.Добавить();
			НоваяСтрока.id = pricе.id;  
			НоваяСтрока.name = pricе.name;
			НоваяСтрока.currency = pricе.currency;
		КонецЦикла;	
	КонецЦикла; 
	
	pricesДляЗаполнения =  prices.СкопироватьКолонки();
	
	pricеСвертка = prices.Скопировать(, "id");
	pricеСвертка.Свернуть("id");   
	
	Для каждого Строкаpricе Из pricеСвертка Цикл
		
		Отбор = Новый Структура();
		Отбор.Вставить("id", Строкаpricе.id);
		НайденыеСтроки = prices.НайтиСтроки(Отбор);
		Если НайденыеСтроки.Количество() > 0 Тогда
			НоваяСтрока =  pricesДляЗаполнения.Добавить();
			НоваяСтрока.id 			= НайденыеСтроки[0].id;  
			НоваяСтрока.name 		= НайденыеСтроки[0].name;
			НоваяСтрока.currency 	= НайденыеСтроки[0].currency;
		КонецЕсли; 
	КонецЦикла; 
	
			
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайла,"UTF-8"); 
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("productMasterDataRequest");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xs", "http://www.w3.org/2001/XMLSchema");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("", "http://service.profashionsolutions.ru/fe714_r002");
	ЗаписьXML.ЗаписатьНачалоЭлемента("main");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("parents");
	ЗаписьXML.ЗаписатьКонецЭлемента(); 
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("typesItems");
	ЗаписьXML.ЗаписатьКонецЭлемента(); 
	
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("prices"); 
	Если pricesДляЗаполнения.Количество() > 0 И ЗначениеЗаполнено(pricesДляЗаполнения[0].id) Тогда 
		Для каждого ТипЦены Из pricesДляЗаполнения Цикл
			ЗаписьXML.ЗаписатьНачалоЭлемента("price"); 	
			ЗаписьXML.ЗаписатьАтрибут("id", XMLСтрока(ТипЦены.id));
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("name"); 
			ЗаписьXML.ЗаписатьТекст(XMLСтрока(ТипЦены.name));
			ЗаписьXML.ЗаписатьКонецЭлемента();  
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("currency"); 
			ЗаписьXML.ЗаписатьТекст(XMLСтрока(ТипЦены.currency));
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЦикла;  
	Иначе 
		ЗаписьXML.ЗаписатьНачалоЭлемента("price");
		ЗаписьXML.ЗаписатьАтрибут("id", XMLСтрока(""));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("name"); 
		ЗаписьXML.ЗаписатьТекст(XMLСтрока(""));
		ЗаписьXML.ЗаписатьКонецЭлемента();  
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("currency"); 
		ЗаписьXML.ЗаписатьТекст(XMLСтрока(""));
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЕсли;
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("commonAddFieldsItem");
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("commonAddFieldsSize");
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); 
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("items");  
	
	Для каждого Данные Из ДанныеДляФайла Цикл
		
		Для каждого item Из Данные.items Цикл  
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("item");
			
			ЗаписьXML.ЗаписатьАтрибут("uuid", XMLСтрока(item.uuid)); 
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("active");
			ЗаписьXML.ЗаписатьТекст(XMLСтрока(item.active));
			ЗаписьXML.ЗаписатьКонецЭлемента(); 
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("parentId");
			ЗаписьXML.ЗаписатьТекст(XMLСтрока(item.parentId));
			ЗаписьXML.ЗаписатьКонецЭлемента(); 
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("typeItemId");
			ЗаписьXML.ЗаписатьТекст(XMLСтрока(item.typeItemId));
			ЗаписьXML.ЗаписатьКонецЭлемента(); 
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("article");
			ЗаписьXML.ЗаписатьТекст(XMLСтрока(item.article));
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("name");
			ЗаписьXML.ЗаписатьТекст(XMLСтрока(item.name));
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("images");
			ЗаписьXML.ЗаписатьТекст(XMLСтрока(""));
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("fullDescr");
			ЗаписьXML.ЗаписатьТекст(XMLСтрока(item.fullDescr));
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("shortDescr");
			ЗаписьXML.ЗаписатьТекст(XMLСтрока(""));
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("materialDescr");
			ЗаписьXML.ЗаписатьТекст(XMLСтрока(""));
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("vatCode");
            ЗаписьXML.ЗаписатьТекст(XMLСтрока(XMLСтрока(item.vatCode)));
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("color");
            ЗаписьXML.ЗаписатьТекст(XMLСтрока(XMLСтрока(item.color)));
			ЗаписьXML.ЗаписатьКонецЭлемента();
			

			ЗаписьXML.ЗаписатьНачалоЭлемента("packingUnit"); 
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("length");
			ЗаписьXML.ЗаписатьТекст(XMLСтрока(item.packingUnit.height));
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("width");
