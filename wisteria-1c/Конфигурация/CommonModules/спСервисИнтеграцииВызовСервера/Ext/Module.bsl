Процедура ЗаписьВЖурнала(СсылкаНаОбъект, Ошибка)
	Если Ошибка Тогда 
		
		ИдентификаторСообщения = спОбщегоНазначенияВызовСервера.ПолучитьИдентификаторСообщенияПоСсылке(СсылкаНаОбъект, ПредопределенноеЗначение("Перечисление.спСпособПередачи.SOAP"));
		ЗаписьЖурнала = Новый Структура; 
		ЗаписьЖурнала.Вставить("Ошибка", Истина);
		ЗаписьЖурнала.Вставить("СтатусСообщения", ПредопределенноеЗначение("Перечисление.спСтатусыСообщений.ОшибкаОтправки"));
		ЗаписьЖурнала.Вставить("Идентификатор", ИдентификаторСообщения);
		ЗаписьЖурнала.Вставить("СпособПередачи", ПредопределенноеЗначение("Перечисление.спСпособПередачи.SOAP"));
		ЗаписьЖурнала.Вставить("Ссылка", СсылкаНаОбъект);
		ЗаписьЖурнала.Вставить("ИмяФайла", Неопределено);
		ЗаписьЖурнала.Вставить("ТипИнтеграции", ПредопределенноеЗначение("Перечисление.спТипыИнтеграции.Исходящая"));
		ЗаписьЖурнала.Вставить("ЗаписатьВОчередьИсходящих", Ложь);	
		спРаботаСДаннымиВызовСервера.ЗаписьВЖурнал(ЗаписьЖурнала);
	Иначе  
		
		ИдентификаторСообщения = спОбщегоНазначенияВызовСервера.ПолучитьИдентификаторСообщенияПоСсылке(СсылкаНаОбъект, ПредопределенноеЗначение("Перечисление.спСпособПередачи.SOAP"));
		ЗаписьЖурнала = Новый Структура; 
		ЗаписьЖурнала.Вставить("Ошибка", Ложь);
		ЗаписьЖурнала.Вставить("СтатусСообщения", ПредопределенноеЗначение("Перечисление.спСтатусыСообщений.Отправлено"));
		ЗаписьЖурнала.Вставить("Идентификатор", ИдентификаторСообщения);
		ЗаписьЖурнала.Вставить("СпособПередачи", ПредопределенноеЗначение("Перечисление.спСпособПередачи.SOAP"));
		ЗаписьЖурнала.Вставить("Ссылка", СсылкаНаОбъект);
		ЗаписьЖурнала.Вставить("ИмяФайла", Неопределено);
		ЗаписьЖурнала.Вставить("ТипИнтеграции", ПредопределенноеЗначение("Перечисление.спТипыИнтеграции.Исходящая"));
		ЗаписьЖурнала.Вставить("ЗаписатьВОчередьИсходящих", Истина);	
		спРаботаСДаннымиВызовСервера.ЗаписьВЖурнал(ЗаписьЖурнала);
		
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьИнформациюОшибки(Информация) 
	СообщенииеОшибки = "";
	Если ТипЗнч(Информация) = Тип("Структура") Тогда 
		СообщенииеОшибки = ПолучитьДанные(Информация);
	Иначе 	
		СерилизированаяИнформация = ДесериализоватьИзJSON(Информация);  
		Если ТипЗнч(СерилизированаяИнформация) = Тип("Структура") Тогда 	
			СообщенииеОшибки = ПолучитьДанные(СерилизированаяИнформация);
		КонецЕсли; 
	КонецЕсли;
	Возврат СообщенииеОшибки;
КонецФункции

Функция ПолучитьДанные(ИнформацияСообщения)
	
	СообщенииеОшибки = "";
	ОшибкиВФайле = Новый Массив;
	
	Если ИнформацияСообщения.Service.MessageDate = Ложь Тогда 
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Дата сообщения»"));
	КонецЕсли;
	
	Если ИнформацияСообщения.Service.MessageID = Ложь Тогда 
		ОшибкиВФайле.Добавить( СтрШаблон("%1", "Не задано значение реквизита «Id сообщения»"));
	КонецЕсли;
	
	Если ИнформацияСообщения.Service.Shop = Ложь Тогда 
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «shop»"));
	КонецЕсли;
	
	Если ИнформацияСообщения.Service.Token = Ложь Тогда 
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «token»"));
	КонецЕсли;  
	
	Если ИнформацияСообщения.AddFields.LegalReciever = Ложь Тогда  
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Наименование грузополучателя»"));
	КонецЕсли;
	
	Если ИнформацияСообщения.AddFields.legalRecieverAddress = Ложь Тогда  
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Юридический адрес грузополучателя"));
	КонецЕсли; 
	
	Если ИнформацияСообщения.AddFields.legalRecieverINN = Ложь Тогда  
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «ИНН грузополучателя»"));
	КонецЕсли; 
	
	Если ИнформацияСообщения.AddFields.legalRecieverKPP = Ложь Тогда  
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «КПП грузополучателя»"));
	КонецЕсли;
	
	Если ИнформацияСообщения.Order.CarrierId = Ложь Тогда  
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «ID доставщика»"));
	КонецЕсли;  
	
	Если ИнформацияСообщения.Order.Client.Phone = Ложь Тогда  
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Телефон получателя заказа»"));
	КонецЕсли;

	Если ИнформацияСообщения.Order.Client.СustomerFingerprint.Email = Ложь Тогда  
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «E-mail клиента»"));
	КонецЕсли;

	Если ИнформацияСообщения.Order.DeliveryAddress = Ложь Тогда  
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Адрес доставки заказа»"));
	КонецЕсли;
	
	Если ТипЗнч(ИнформацияСообщения.Order.DeliveryAddress) = Тип("Структура") Тогда 
		Если ИнформацияСообщения.Order.DeliveryAddress.zip = Ложь Тогда 
			ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Индекс адреса доставки заказа»"));
		КонецЕсли;
		
		Если ИнформацияСообщения.Order.DeliveryAddress.region = Ложь Тогда 
			ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Регион адреса доставки заказа»"));
		КонецЕсли;
		
		Если ИнформацияСообщения.Order.DeliveryAddress.city = Ложь Тогда 
			ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Город адреса доставки заказа»"));
		КонецЕсли;
		
		Если ИнформацияСообщения.Order.DeliveryAddress.street = Ложь Тогда 
			ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Улица адреса доставки заказа»"));
		КонецЕсли;
		
		Если ИнформацияСообщения.Order.DeliveryAddress.building = Ложь Тогда 
			ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Здание адреса доставки заказа»"));
		КонецЕсли;
	КонецЕсли;


	Если ИнформацияСообщения.Order.PaymentMode = Ложь Тогда  
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Код способа оплаты»"));
	КонецЕсли;

	
	Если ИнформацияСообщения.Param.OrderType = Ложь Тогда  
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Тип заказа»"));
	КонецЕсли; 
	
	Если ИнформацияСообщения.Version = Ложь Тогда  
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Версия операции»"));
	КонецЕсли;
	
	Если ИнформацияСообщения.WSПрокси = Ложь Тогда  
		ОшибкиВФайле.Добавить(СтрШаблон("%1", "Ошибка «WS прокси»"));
	КонецЕсли;

	
	Товары = Новый Массив;
	Для каждого ЭлементТовара Из ИнформацияСообщения.Order.Items Цикл 
		Ошибка = Ложь;
		Товар = Новый Структура("Гуид, Ean, Quantity, Размер, Price");
		
		Если ЭлементТовара.Uuid = Ложь ИЛИ ЭлементТовара.Ean = Ложь ИЛИ ЭлементТовара.Quantity = Ложь 
			ИЛИ ЭлементТовара.Size = Ложь ИЛИ ЭлементТовара.Price = Ложь Тогда 
			
			Товар.Вставить("Гуид", 			ЭлементТовара.Uuid);
			Товар.Вставить("Ean", 			ЭлементТовара.Ean); 
			Товар.Вставить("Количество", 	ЭлементТовара.Quantity); 
			Товар.Вставить("Размер", 		ЭлементТовара.Size);
			Товар.Вставить("Цена", 			ЭлементТовара.Price);
			Ошибка = Истина;
		КонецЕсли;  
		
		Если Ошибка Тогда 
			Товары.Добавить(Товар);
			ОшибкаФайла = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Товары.Количество() > 0 Тогда
		
		Для каждого ЭлементТовары Из Товары Цикл
			Если ЭлементТовары.Гуид = Ложь ИЛИ ЭлементТовары.Ean = Ложь ИЛИ ЭлементТовары.Количество = Ложь ИЛИ ЭлементТовары.Размер = Ложь ИЛИ ЭлементТовары.Цена = Ложь Тогда				
				
				Если ЭлементТовары.Гуид = Ложь Тогда 
					ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Номенклатура»"));
				КонецЕсли;
				
				Если ЭлементТовары.Ean  = Ложь Тогда 
					ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Ean"));
				КонецЕсли;
				
				Если ЭлементТовары.Количество = Ложь Тогда 
					ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Количество»"));
				КонецЕсли;
				
				Если ЭлементТовары.Размер = Ложь Тогда 
					ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Размер»"));
				КонецЕсли;
				
				Если ЭлементТовары.Цена = Ложь Тогда 
					ОшибкиВФайле.Добавить(СтрШаблон("%1", "Не задано значение реквизита «Цена»"));
				КонецЕсли;
				
			КонецЕсли;
						
		КонецЦикла;	
	КонецЕсли;
	
	Если ОшибкиВФайле.Количество() > 0 Тогда 
		ОшибкиВФайлеБезДублей = УдалитьПовторяющиесяЭлементыМассива(ОшибкиВФайле);
		СообщенииеОшибки = ВывестиЭлементыМассиваВСтроку(ОшибкиВФайлеБезДублей);
	КонецЕсли; 
	
    Возврат СообщенииеОшибки;
КонецФункции

Функция ДесериализоватьИзJSON(СтрокаJSON, ПоляДата = "")
    
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
    Значение = ПрочитатьJSON(ЧтениеJSON,, ПоляДата, ФорматДатыJSON.ISO);          
    ЧтениеJSON.Закрыть();
    Возврат Значение;
    
КонецФункции 

Функция УдалитьПовторяющиесяЭлементыМассива(Массив) 
	ТекущийИндекс = 0; 
	ВсегоЭлементов = Массив.Количество(); 
	Пока ТекущийИндекс < ВсегоЭлементов Цикл 
		Индекс2 = ТекущийИндекс + 1; 
		Пока Индекс2 < ВсегоЭлементов Цикл 
			Если Массив[Индекс2] = Массив[ТекущийИндекс] Тогда 
				Массив.Удалить(Индекс2); 
				ВсегоЭлементов = ВсегоЭлементов - 1; 
			Иначе 
				Индекс2 = Индекс2 + 1; 
			КонецЕсли; 
		КонецЦикла; 
		ТекущийИндекс = ТекущийИндекс + 1; 
	КонецЦикла;
	
	Возврат Массив; 
КонецФункции 

Функция ВывестиЭлементыМассиваВСтроку(Массив)
	ВыходнаяСтрока = "";
	Разделитель = "; ";
	Для каждого ЭлементМассива Из Массив Цикл
		ВыходнаяСтрока = ВыходнаяСтрока + ?(ПустаяСтрока(ВыходнаяСтрока), "", Разделитель);
		ВыходнаяСтрока = ВыходнаяСтрока + ЭлементМассива;
	КонецЦикла;
	Возврат ВыходнаяСтрока;
КонецФункции

