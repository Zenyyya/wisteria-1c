// Отправить сообщение.
// 
// Параметры:
//  Сообщение - - Сообщение
//  Идентификатор - - Идентификатор
//  ДатаРегистрации - - Дата регистрации
//  ТипОчередей - - Тип очередей
Процедура ОтправитьСообщение(Сообщение, Идентификатор, ДатаРегистрации, ФорматСообщения, ТипОбъекта, СпособПередачи, ТипОчередей) Экспорт	
	
	Если СпособПередачи = Перечисления.спСпособПередачи.FTP Тогда 
		
		Каталог = ФайловаяСистема.СоздатьВременныйКаталог("спsFTP");
		
		ЧтениеСообщение(Сообщение, ТипОбъекта, ФорматСообщения, Каталог);
		
		sFTPСервер = спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спsFTPСервер"); 
		sFTPЛогин = спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спsFTPЛогин");
		sFTPПароль = спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спsFTPПароль");
		sFTPПорт = спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спsFTPПорт");
		спsFTPSHHКлюч = спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спsFTPSHHКлюч"); 
		спsFTPПутьНаFTPPending = спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спsFTPПутьНаFTPPending");

		
		Попытка 
			//Создаем объект Session
			Сессия = Новый COMОбъект("WinSCP.Session");   
			
			//Создаем объект SessionOptions
			Настройки = Новый COMОбъект("WinSCP.SessionOptions");   
			Настройки.HostName = sFTPСервер;
			Настройки.UserName = sFTPЛогин;
			Настройки.Password = sFTPПароль;
			Настройки.PortNumber = sFTPПорт; 
			Настройки.SshHostKeyFingerprint = спsFTPSHHКлюч; 
			
			// Подключаемся
			Сессия.Open(Настройки);
		Исключение
			ЗаписьЖурналаРегистрации("sFTP", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
		КонецПопытки; 
		
		Попытка 
			ПутьВыгрузки = Каталог + "*";
			Результат = Сессия.PutFiles(ПутьВыгрузки, спsFTPПутьНаFTPPending);
			
			//Проверяем результат на возможные ошибки
			Результат.Check();
		Исключение
			ЗаписьЖурналаРегистрации("sFTP",УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
		КонецПопытки; 
		
		//Обрабатываем результат выгрузки
		Для каждого ВыгруженныйФайл Из Результат.Transfers Цикл
			ОбщегоНазначения.СообщитьПользователю("Выгружен файл: " + ВыгруженныйФайл.FileName);
			//ПереместитьФайл(ВыгруженныйФайл.FileName, ХранилищеВыгруженныхФайлов);
		КонецЦикла; 
		
		Сессия.Dispose();  
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЧтениеСообщение(Сообщение, ТипОбъекта, ФорматСообщения, ПрочтенноеСообщение, Каталог = Неопределено)
 
	Если ТипОбъекта = "Документ.ПеремещениеЗапасов" ИЛИ ТипОбъекта = "Документ.ПриходнаяНакладная" 
		И ФорматСообщения = Перечисления.спФорматыСообщений.XML Тогда
		
		ВременныйФайл = ПолучитьИмяВременногоФайла("xml");
		Попытка
			ЧтениеИЗаписьXML(ВременныйФайл, Сообщение); 
		Исключение 
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации("Чтение и запись XML в исходящее сообщение", УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецПопытки; 
		
		Двоичное = Новый ДвоичныеДанные(ВременныйФайл); 
		
		ПрочтенноеСообщение.Вставить("ДвоичныеДанные", ПоместитьВоВременноеХранилище(Двоичное)); 
		ПрочтенноеСообщение.Вставить("Префикс", "FE720");  
		
	ИначеЕсли ТипОбъекта = "Справочник.Номенклатура" И ФорматСообщения = Перечисления.спФорматыСообщений.XML Тогда 
	
		ВременныйФайл = ПолучитьИмяВременногоФайла("xml");
		Попытка
			ЧтениеИЗаписьXML(ВременныйФайл, Сообщение);
		Исключение 
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации("Чтение и запись XML в исходящее сообщение", УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке)); 
		КонецПопытки; 
		
		Двоичное = Новый ДвоичныеДанные(ВременныйФайл); 
		
		ПрочтенноеСообщение.Вставить("ДвоичныеДанные", ПоместитьВоВременноеХранилище(Двоичное)); 
		ПрочтенноеСообщение.Вставить("Префикс", "FE714");	
	КонецЕсли;   

	Возврат ПрочтенноеСообщение; 

КонецФункции  

Процедура ЧтениеИЗаписьXML(ИмяВременногоФайла, Сообщение)
	
	ИмяПромежуточногоФайла = ПолучитьИмяВременногоФайла("xml");
	
	Чтение = Новый ЧтениеXML(); 
	Чтение.УстановитьСтроку(Сообщение);  
		
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяПромежуточногоФайла ,"UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();

	Пока Чтение.Прочитать() Цикл  
				
		// Прочитать "структурные части" элементов. 
		// Проверить, какая часть элемента - текущая. 
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 			
			
			// Атрибуты элементов можно читать только если текущая часть - 
			// начало элемента    
			ЗаписьXML.ЗаписатьНачалоЭлемента(Чтение.Имя);
			
			Пока Чтение.ПрочитатьАтрибут() Цикл 
				
				// Прочитать данные узла атрибута. 
				ТипУзла = Чтение.ТипУзла; 
				Имя = Чтение.Имя; 
				Значение = Чтение.Значение; 
				
				// Обработать полученные значения.
				ЗаписьXML.ЗаписатьАтрибут(Имя, XMLСтрока(Значение));

			КонецЦикла;
			
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда 
			
			// Обработать полученные значения.
			ЗаписьXML.ЗаписатьТекст(XMLСтрока(Чтение.Значение));   
			
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда 
			
			// Обработать полученные значения.
			ЗаписьXML.ЗаписатьКонецЭлемента();

		КонецЕсли; 
		
	КонецЦикла; 
	
	ЗаписьXML.Закрыть();  
	
					
					
	ТекстФайла = Новый ЧтениеТекста(ИмяПромежуточногоФайла, КодировкаТекста.UTF8);  
	СтрокаДляЗамены = "<shipmentAnnouncementRequest xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" xmlns=""http://service.profashionsolutions.ru/fe720_r002"">";
	СтрокаЗамены = "<shipmentAnnouncementRequest xmlns=""http://service.profashionsolutions.ru/fe720_r002"" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"">";
	Текст = ТекстФайла.Прочитать(); 
	
	Если Найти(Текст, СтрокаДляЗамены) > 0 Тогда
		Текст = СтрЗаменить(Текст, СтрокаДляЗамены, СтрокаЗамены);
	КонецЕсли;
	
	НовыйТекст = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
	НовыйТекст.Записать(Текст); 
	НовыйТекст.Закрыть();
	
	Попытка
		УдалитьФайлы(ИмяПромежуточногоФайла);
	Исключение

	КонецПопытки;
	
КонецПроцедуры

// Получить сообщение. 
Функция ПолучитьДанныеФайла(Сообщение, Идентификатор, ДатаРегистрации, ФорматСообщения, ТипОбъекта, СпособПередачи, ТипОчередей) Экспорт	
	
	ПрочтенноеСообщение = Новый Структура("ДвоичныеДанные, Префикс");  
	
	Если СпособПередачи = Перечисления.спСпособПередачи.FTP Тогда 
		ПрочтенноеСообщение = ЧтениеСообщение(Сообщение, ТипОбъекта, ФорматСообщения, ПрочтенноеСообщение);
	КонецЕсли;  
	
	Возврат ПрочтенноеСообщение;
КонецФункции
 
Функция ПроверкаДокументаПриходнаяНакладная(Ссылка) Экспорт 
    Ошибка = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПриходнаяНакладнаяЗапасы.Номенклатура КАК Номенклатура,
		|	ПриходнаяНакладнаяЗапасы.Ссылка КАК Документ
		|ПОМЕСТИТЬ ВТЗапасы
		|ИЗ
		|	Документ.ПриходнаяНакладная.Запасы КАК ПриходнаяНакладнаяЗапасы
		|ГДЕ
		|	ПриходнаяНакладнаяЗапасы.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТЗапасы.Номенклатура КАК Номенклатура,
		|	ВТЗапасы.Документ КАК Документ
		|ПОМЕСТИТЬ ВТДокументНоменклатура
		|ИЗ
		|	ВТЗапасы КАК ВТЗапасы
		|ГДЕ
		|	ВТЗапасы.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	И НЕ ВТЗапасы.Номенклатура ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТЗапасы.Документ,
		|	ВТЗапасы.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
		|	тбОчередь.ОбъектСобытия КАК ОбъектСобытия,
		|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	тбОчередь.ИнициаторОтправкиСсылкаНаОбъект КАК ИнициаторОтправкиСсылкаНаОбъект,
		|	тбСостояние.СтатусСообщения КАК СтатусСообщения
		|ПОМЕСТИТЬ ВТ_ОчередьИсходящихСообщений
		|ИЗ
		|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
		|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
		|		И (тбСостояние.ЗадержкаЧисло <= &ЗадержкаЧисло)
		|ГДЕ
		|	НЕ тбОчередь.ЭтоУдаление
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТДокументНоменклатура.Документ КАК Документ,
		|	ВТ_ОчередьИсходящихСообщений.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	ВТ_ОчередьИсходящихСообщений.ДатаРегистрации КАК ДатаРегистрации,
		|	ВТ_ОчередьИсходящихСообщений.СтатусСообщения КАК СтатусСообщения
		|ИЗ
		|	ВТДокументНоменклатура КАК ВТДокументНоменклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОчередьИсходящихСообщений КАК ВТ_ОчередьИсходящихСообщений
		|		ПО ВТДокументНоменклатура.Номенклатура = ВТ_ОчередьИсходящихСообщений.СсылкаНаОбъект";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ЗадержкаЧисло", спОбщегоНазначенияВызовСервера.ПеревестиДатуВЧисло(ТекущаяДатаСеанса())); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.СтатусСообщения <> Перечисления.спСтатусыСообщений.ОтправкаПодтверждена Тогда 
			Ошибка = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ошибка;	
КонецФункции

