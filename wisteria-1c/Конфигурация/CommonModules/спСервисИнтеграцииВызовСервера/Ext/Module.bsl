Функция ОтправитьСообщениеДокументовПоSOAP(ОтправкаДокументов = Неопределено) Экспорт 
	
	ОтправитьСообщение = Новый Структура("ОшибкаДанных, Результат");  
	
	Если спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спОтключитьПотокиОбработкиДанных") Тогда
		ОтправитьСообщение.Вставить("Результат", Ложь); 
		ОтправитьСообщение.Вставить("ОшибкаДанных", "Отправка сообщений по Web серверу отключена");
		Возврат ОтправитьСообщение;
	КонецЕсли; 
	
	// ++ Терлецкий АВ 25.01.15
	ТаблицаПроверки = Новый ТаблицаЗначений;
	ТаблицаПроверки.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.ЗаказНаПеремещение"));
	
	Для каждого СсылкаНаОбъект Из ОтправкаДокументов Цикл
		НоваяСтрока = ТаблицаПроверки.Добавить();
		НоваяСтрока.Ссылка = СсылкаНаОбъект; 
	КонецЦикла;
	ОтправленныеСообщения = спОбработкаСобытийВызовСервера.ИсключитьПовторнуюОтправку(ТаблицаПроверки, Перечисления.спСпособПередачи.SOAP);
	
	Если ТипЗнч(ОтправленныеСообщения) = Тип("ТаблицаЗначений") И ОтправленныеСообщения.Количество() > 0 Тогда 
		ОтправитьСообщение.Вставить("Результат", Ложь); 
		ОтправитьСообщение.Вставить("СостояниеДанных", "Заказ с этим номером уже был оформлен магазином");
		Возврат ОтправитьСообщение;
	КонецЕсли; 	
	// -- Терлецкий АВ 25.01.15

	
	Если ТипЗнч(ОтправкаДокументов) <> Тип("Массив") ИЛИ ОтправкаДокументов.Количество() = 0 Тогда 
		ОтправитьСообщение.Вставить("Результат", Ложь);
		Возврат ОтправитьСообщение;
	КонецЕсли; 
	
	Попытка
		WSПрокси = спВзаимодействиеСПодключением.ПодключитьКоннектор(ПредопределенноеЗначение("Перечисление.спТипыКоннекторов.SOAP")); 
	Исключение   
		
		Для каждого СсылкаНаОбъект Из ОтправкаДокументов Цикл
			ЗаписьВЖурнала(СсылкаНаОбъект, Истина);
		КонецЦикла;									
		
		ОтправитьСообщение.Вставить("ОшибкаДанных", "Ошибка подключения к Web серверу");
		ОтправитьСообщение.Вставить("Результат", Ложь);

		Возврат ОтправитьСообщение;
	КонецПопытки;
	
	Для каждого СсылкаНаОбъект Из ОтправкаДокументов Цикл   
		Попытка
			ИсходящееСообщение = спОбслуживаниеОчередей.ОбработкаОчередиИсходящегоСообщения(СсылкаНаОбъект);
		Исключение 
			ЗаписьВЖурнала(СсылкаНаОбъект, Истина);
	
			ОтправитьСообщение.Вставить("ОшибкаДанных", "Ошибка получения данных для отправки сообщения по Web серверу");
			ОтправитьСообщение.Вставить("Результат", Ложь);
			
			Продолжить;
		КонецПопытки; 
		
		Если ИсходящееСообщение.Сообщение <> Неопределено Тогда 
			ЧтениеXML = Новый ЧтениеXML; 
			ЧтениеXML.УстановитьСтроку(ИсходящееСообщение.Сообщение);  
		Иначе
			Если ТипЗнч(ИсходящееСообщение.ОписаниеДанных) = Тип("ХранилищеЗначения") 
				И ЗначениеЗаполнено(ИсходящееСообщение.ОписаниеДанных) Тогда 
				
				Попытка
					Данные 				= ИсходящееСообщение.ОписаниеДанных.Получить();
					Информация 			= ПолучитьИнформациюОшибки(Данные); 
				Исключение
				КонецПопытки; 
								
			КонецЕсли;
			
			ЗаписьВЖурнала(СсылкаНаОбъект, Истина);
			Если ЗначениеЗаполнено(Информация) Тогда 
				ОтправитьСообщение.Вставить("ОшибкаДанных", Информация); 
			Иначе 
				ОтправитьСообщение.Вставить("ОшибкаДанных", "Ошибка получения данных для отправки сообщения по Web серверу");
			КонецЕсли; 
			ОтправитьСообщение.Вставить("Результат", Ложь);
			
			Продолжить;
		КонецЕсли;
		
		Если ЧтениеXML <> Неопределено Тогда
			Попытка
				СвояФабрикаXDTO = WSПрокси.ФабрикаXDTO;
				СвояФабрикаXDTO = СвояФабрикаXDTO.ПрочитатьXML(ЧтениеXML); 
				Результат = WSПрокси.createOrder(СвояФабрикаXDTO.service, СвояФабрикаXDTO.param, СвояФабрикаXDTO.version, СвояФабрикаXDTO.order); 
			Исключение 
				ЗаписьВЖурнала(СсылкаНаОбъект, Истина);
				
				ОтправитьСообщение.Вставить("ОшибкаДанных", "Ошибка отправки сообщения по Web серверу");
				ОтправитьСообщение.Вставить("Результат", Ложь);
			КонецПопытки;

		Иначе 
            ЗаписьВЖурнала(СсылкаНаОбъект, Истина);
			
			ОтправитьСообщение.Вставить("ОшибкаДанных", "Ошибка получения данных для отправки сообщения по Web серверу");
			ОтправитьСообщение.Вставить("Результат", Ложь);
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Результат) = Тип("ОбъектXDTO") Тогда 
			СвойствоОбъектаXDTO = Результат.Свойства();  
			
			ОтправитьСообщение.Вставить("Результат", ?(СвойствоОбъектаXDTO.Получить("successful") <> Неопределено, Результат.successful, Ложь)); 
			Если Не Результат.successful Тогда 
				СообщениеОшибки = ПолучитьРасшифровкуОшибки(Результат.faultHandler.errorCode);
				ОтправитьСообщение.Вставить("СостояниеДанных", СообщениеОшибки);
				ОтправитьСообщение.Вставить("КодОшибки", Результат.faultHandler.errorCode); 
			Иначе
				
				ОтправитьСообщение.Вставить("СостояниеДанных", "Отправка исходящего сообщения Web-серверу успешна");
			КонецЕсли;
			
			Если Результат.successful Тогда  
				ЗаписьВЖурнала(СсылкаНаОбъект, Ложь);
			Иначе 
				ЗаписьВЖурнала(СсылкаНаОбъект, Истина);
			КонецЕсли;
		КонецЕсли;
		
    КонецЦикла;
	
	Возврат ОтправитьСообщение;
КонецФункции

