				Данные.Вставить("ЭтоУдаление", 		Ложь);
				Данные.Вставить("СсылкаНаОбъект", 	СсылкаНаОбъект.СсылкаНаОбъект);
				Данные.Вставить("СпособПередачи", 	СсылкаНаОбъект.СпособПередачи);
				Данные.Вставить("ТочкаОбмена", 		ТочкаОбмена);
				
				Попытка
					ПрочтенноеСообщение = СформироватьИсходящееСообщениеСКлиента(Данные);
					Если ТипЗнч(ПрочтенноеСообщение) = Тип("Структура") Тогда
						Значение = Неопределено;
						Если ПрочтенноеСообщение.Свойство("ДвоичныеДанные", Значение) Тогда 
							ИсходящееСообщение.Вставить("ДвоичныеДанные", Значение); 
						КонецЕсли; 
						Значение = Неопределено;
						Если ПрочтенноеСообщение.Свойство("Префикс", Значение) Тогда 
							ИсходящееСообщение.Вставить("Префикс", Значение);
						КонецЕсли;
					КонецЕсли;
					ИсходящееСообщение.Вставить("Идентификатор", ТекИдентификатор);
					
				Исключение
					
					// Запускаем фоновое задание со статическим ключем. Запуск других экземпляров должен заканчиваться ошибкой (паттерн синглтон).
					ИнформацияОбОшибке = ИнформацияОбОшибке();
					ЗаписьЖурналаРегистрации("Сформировать исходящее сообщение", УровеньЖурналаРегистрации.Ошибка
												, , , ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке)); 

				КонецПопытки            			
		Исключение
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации("Обработка очереди исходящих сообщений", УровеньЖурналаРегистрации.Ошибка
										, , ТекИдентификатор, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));

		КонецПопытки;

	
	Возврат ИсходящееСообщение;	
КонецФункции

#КонецОбласти