// Процедура - Обработка очереди исходящих сообщений
Функция ОбработкаОчередиИсходящегоСообщенияПоСсылкамИСтатусу(СсылкиНаОбъект, Статусы) Экспорт 
		
	ИсходящееСообщение = Новый Структура("ДвоичныеДанные, Префикс, Идентификатор");
	ТочкаОбмена = Неопределено;

	Если ТипЗнч(СсылкиНаОбъект) <> Тип("Массив") И СсылкиНаОбъект.Количество = 0 Тогда  
		Возврат ИсходящееСообщение;
	КонецЕсли;    
	
	Если ПолучитьФункциональнуюОпцию("спОтключитьПотоки") Тогда	
		Возврат ИсходящееСообщение;		
	КонецЕсли;
	
	Запрос = Новый Запрос;	
	Запрос.Текст = 
				"ВЫБРАТЬ
				|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
				|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
				|	тбОчередь.ФорматСообщения КАК ФорматСообщения,
				|	тбОчередь.МетодХранения КАК МетодХранения,
				|	тбОчередь.ЭтоУдаление КАК ЭтоУдаление,
				|	тбОчередь.ОбъектСобытия КАК ОбъектСобытия,
				|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
				|	тбОчередь.СпособПередачи КАК СпособПередачи,
				|	тбОчередь.Хранилище КАК Хранилище
				|ИЗ
				|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
				|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
				|			И (тбСостояние.СтатусСообщения В (&СписокСтатусов))
				|			И (тбСостояние.ЗадержкаЧисло <= &ЗадержкаЧисло)
				|			И (тбОчередь.СсылкаНаОбъект В (&СсылкиНаОбъект))
				|
				|УПОРЯДОЧИТЬ ПО
				|	тбСостояние.ДатаИзменения";
	
	Запрос.УстановитьПараметр("СписокСтатусов", Статусы); 
	Запрос.УстановитьПараметр("ЗадержкаЧисло", спОбщегоНазначенияВызовСервера.ПеревестиДатуВЧисло(ТекущаяДатаСеанса()));  
	Запрос.УстановитьПараметр("СсылкиНаОбъект", СсылкиНаОбъект);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		ТекИдентификатор = "Идентификатор не определен";
		
		Попытка
			
			Выборка = Результат.Выбрать();
			
			ПакетДанных = Новый Массив;
			Пока Выборка.Следующий() Цикл
				
				ТекИдентификатор = Выборка.ИдентификаторСобытия;
				спРаботаСДаннымиВызовСервера.УстановитьСостояниеСообщения(ТекИдентификатор, Перечисления.спСтатусыСообщений.ВОбработке, , , , , Перечисления.спТипыИнтеграции.Исходящая);
				
				Данные = Новый Структура;
				Данные.Вставить("ТекИдентификатор", ТекИдентификатор); 
				Данные.Вставить("ФорматСообщения", 	Выборка.ФорматСообщения);
				Данные.Вставить("ОбъектСобытия", 	Выборка.ОбъектСобытия);
				Данные.Вставить("МетодХранения", 	Выборка.МетодХранения);
				Данные.Вставить("ДатаРегистрации", 	Выборка.ДатаРегистрации);
				Данные.Вставить("ЭтоУдаление", 		Выборка.ЭтоУдаление);
				Данные.Вставить("СсылкаНаОбъект", 	Выборка.СсылкаНаОбъект);
				Данные.Вставить("СпособПередачи", 	Выборка.СпособПередачи);
				Данные.Вставить("ТочкаОбмена", 		ТочкаОбмена);
				Данные.Вставить("Хранилище", 		Выборка.Хранилище);
				ПакетДанных.Добавить(Данные);
			КонецЦикла;  
			
			Попытка 
			    			
				Если ПакетДанных.Количество() = 0 Тогда 
					Возврат ИсходящееСообщение;
				КонецЕсли;
				
				ПрочтенноеСообщение = СформироватьИсходящееСообщениеСКлиентаИзМассиваДанных(ПакетДанных);
				
				Если ТипЗнч(ПрочтенноеСообщение) = Тип("Структура") Тогда
					Значение = Неопределено;
					Если ПрочтенноеСообщение.Свойство("ДвоичныеДанные", Значение) Тогда 
						ИсходящееСообщение.Вставить("ДвоичныеДанные", Значение); 
					КонецЕсли; 
					Значение = Неопределено;
					Если ПрочтенноеСообщение.Свойство("Префикс", Значение) Тогда 
						ИсходящееСообщение.Вставить("Префикс", Значение);
					КонецЕсли;
				КонецЕсли;
				ИсходящееСообщение.Вставить("Идентификатор", ТекИдентификатор);
				
			Исключение
				
				// Запускаем фоновое задание со статическим ключем. Запуск других экземпляров должен заканчиваться ошибкой (паттерн синглтон).
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ЗаписьЖурналаРегистрации("Сформировать исходящее сообщение", УровеньЖурналаРегистрации.Ошибка
				, , , ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке)); 
				
			КонецПопытки 
			
		Исключение
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации("Обработка очереди исходящих сообщений", УровеньЖурналаРегистрации.Ошибка
										, , ТекИдентификатор, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));

		КонецПопытки;
		
	КонецЕсли;	
	
	Возврат ИсходящееСообщение;	
КонецФункции 

// Процедура - Отправить исходящее сообщение 
//
// Параметры:
//  Идентификатор - УникальныйИдентификатор - Идентификатор сообщения
//  ФорматСообщения - ПеречислениеСсылка.спФорматыСообщений - Формат отправляемого сообщения
//	ТипОбъекта - Строка - Строковое представление имени метаданных объекта
//  МетодХранения - ПеречислениеСсылка.спМетодХранения - Метод хранения сообщения
//  ДатаРегистрации - Дата - Дата регистрации сообщения
//	ЭтоУдаление - Булево - Обозначение удаления
//	СсылкаНаОбъект - ЛюбаяСсылка - Ссылка на объект исходящего сообщения
//  ТочкаОбмена - Неопределено - Точка обмена
//
Функция СформироватьИсходящееСообщениеСКлиента(Данные) 
	
	Перем ПрочтенноеСообщение;
	Идентификатор = Данные.ТекИдентификатор; 
	ФорматСообщения = Данные.ФорматСообщения; 
	ТипОбъекта = Данные.ОбъектСобытия; 
	МетодХранения = Данные.МетодХранения; 
	ДатаРегистрации = Данные.ДатаРегистрации; 
	ЭтоУдаление = Данные.ЭтоУдаление;
	СсылкаНаОбъект = Данные.СсылкаНаОбъект; 
	СпособПередачи = Данные.СпособПередачи;
	ОписаниеДанных = ?(Данные.Свойство("ОписаниеДанных") ,Данные.ОписаниеДанных, Неопределено);
	ТочкаОбмена = Неопределено;
	
	Задержка = 0;
	ТекЗаголовокЖурнала = "Получение объекта события";
	ТекстОшибки = "";
	
	ОбъектСобытия = ПолучитьОбъектСобытия(Перечисления.спТипыИнтеграции.Исходящая, Идентификатор);
	
	ТекЗаголовокЖурнала = "Формирование сообщения";
	
	Попытка
		
		СостояниеСообщения = Перечисления.спСтатусыСообщений.ОжиданиеОтправки;
		
		ТекЗаголовокЖурнала = "Отправка сообщения";
		
		спРаботаСДаннымиВызовСервера.УстановитьСостояниеСообщения(Идентификатор, СостояниеСообщения, , , , , Перечисления.спТипыИнтеграции.Исходящая);
		
		Если СпособПередачи = Перечисления.спСпособПередачи.FTP Тогда
			ПрочтенноеСообщение = спСервисИнтеграцииВызовСервера.ПолучитьДанныеФайла(ОбъектСобытия, Идентификатор, ДатаРегистрации, ФорматСообщения, ТипОбъекта, 
																						СпособПередачи, Перечисления.спТипыОчередей.Отправки);
		ИначеЕсли СпособПередачи = Перечисления.спСпособПередачи.SOAP Тогда
			ПрочтенноеСообщение = Новый Структура;
			ПрочтенноеСообщение.Вставить("Сообщение", ОбъектСобытия);
		КонецЕсли;																			
		ЗаписатьВОчередьИсходящих(Идентификатор, ОбъектСобытия); 
		
	Исключение
		
		Пока ТранзакцияАктивна() Цикл
			ОтменитьТранзакцию();
		КонецЦикла;   
		
		СостояниеСообщения = Перечисления.спСтатусыСообщений.ОшибкаОбработки;
		
		ТекстОшибки = спОбщегоНазначенияВызовСервера.ПолучитьТекстОшибкиОбработчика(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(текЗаголовокЖурнала, УровеньЖурналаРегистрации.Ошибка, , Идентификатор, ТекстОшибки);  
		
		СткОбработчик = "";
		ТекстОшибки = спОбщегоНазначенияВызовСервера.ДополнитьТекстОшибки(ТекстОшибки, СткОбработчик, СсылкаНаОбъект);
		спРаботаСДаннымиВызовСервера.УстановитьСостояниеСообщения(Идентификатор, СостояниеСообщения, Задержка, ТекстОшибки, , , Перечисления.спТипыИнтеграции.Исходящая);
			
	КонецПопытки;
	
	Возврат ПрочтенноеСообщение;
КонецФункции


// Процедура - Отправить исходящее сообщение 
//
// Параметры:
//  Идентификатор - УникальныйИдентификатор - Идентификатор сообщения
//  ФорматСообщения - ПеречислениеСсылка.спФорматыСообщений - Формат отправляемого сообщения
//	ТипОбъекта - Строка - Строковое представление имени метаданных объекта
//  МетодХранения - ПеречислениеСсылка.спМетодХранения - Метод хранения сообщения
//  ДатаРегистрации - Дата - Дата регистрации сообщения
//	ЭтоУдаление - Булево - Обозначение удаления
//	СсылкаНаОбъект - ЛюбаяСсылка - Ссылка на объект исходящего сообщения
//  ТочкаОбмена - Неопределено - Точка обмена
//
Функция СформироватьИсходящееСообщениеСКлиентаИзМассиваДанных(ПакетДанных) 
	Перем ПрочтенноеСообщение; 
	ДанныеДляФайла = Новый Массив;
	Для каждого Данные Из ПакетДанных Цикл
		
		Идентификатор = Данные.ТекИдентификатор; 
		ФорматСообщения = Данные.ФорматСообщения; 
		ТипОбъекта = Данные.ОбъектСобытия; 
		МетодХранения = Данные.МетодХранения; 
		ДатаРегистрации = Данные.ДатаРегистрации; 
		ЭтоУдаление = Данные.ЭтоУдаление;
		СсылкаНаОбъект = Данные.СсылкаНаОбъект; 
		СпособПередачи = Данные.СпособПередачи; 
		Сообщение = Данные.Хранилище.Получить();

		ТочкаОбмена = Неопределено;
		
		Задержка = 0;
		ТекЗаголовокЖурнала = "Получение объекта события";
		ТекстОшибки = "";
		
		ТекЗаголовокЖурнала = "Формирование сообщения";
		
		Попытка
			
			СостояниеСообщения = Перечисления.спСтатусыСообщений.ОжиданиеОбработки;
			
			спРаботаСДаннымиВызовСервера.УстановитьСостояниеСообщения(Идентификатор, СостояниеСообщения, , , , , Перечисления.спТипыИнтеграции.Исходящая);
			
			ПрочтенныеДанныеФайлаXML = спСервисИнтеграцииВызовСервера.ПолучитьДанныеФайлаXML(Сообщение, Идентификатор, ДатаРегистрации, ФорматСообщения, ТипОбъекта, 
			СпособПередачи, Перечисления.спТипыОчередей.Отправки);
			
			Если ТипЗнч(ПрочтенныеДанныеФайлаXML) = Тип("Структура") Тогда
				ДанныеДляФайла.Добавить(ПрочтенныеДанныеФайлаXML);
				ЗаписатьВОчередьИсходящих(Идентификатор, Сообщение); 
			КонецЕсли;
				
		Исключение
			
			Пока ТранзакцияАктивна() Цикл
				ОтменитьТранзакцию();
			КонецЦикла;   
			
			СостояниеСообщения = Перечисления.спСтатусыСообщений.ОшибкаОбработки;
			
			ТекстОшибки = спОбщегоНазначенияВызовСервера.ПолучитьТекстОшибкиОбработчика(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(текЗаголовокЖурнала, УровеньЖурналаРегистрации.Ошибка, , Идентификатор, ТекстОшибки);  
			
			СткОбработчик = "";
			ТекстОшибки = спОбщегоНазначенияВызовСервера.ДополнитьТекстОшибки(ТекстОшибки, СткОбработчик, СсылкаНаОбъект);
			спРаботаСДаннымиВызовСервера.УстановитьСостояниеСообщения(Идентификатор, СостояниеСообщения, Задержка, ТекстОшибки, , , Перечисления.спТипыИнтеграции.Исходящая);
			
		КонецПопытки;
	КонецЦикла; 
	
	Если ДанныеДляФайла.Количество() > 0 Тогда 
		 ПрочтенноеСообщение = спСервисИнтеграцииВызовСервера.ЧтениеИЗаписьXMLИзПодготовленныхДанных(ДанныеДляФайла);
	КонецЕсли;

	Возврат ПрочтенноеСообщение;
КонецФункции
 
// Процедура - Обработка очереди исходящих сообщений
Функция ПолучитьДанныеИсходящихСообщенийПоСсылкеИСтатусу(СсылкиНаОбъект, Статусы) Экспорт 
	ПакетДанных = Новый Массив;
	
	Если ТипЗнч(СсылкиНаОбъект) <> Тип("Массив") И СсылкиНаОбъект.Количество = 0 Тогда  
		Возврат ПакетДанных;
	КонецЕсли;    
	
	Запрос = Новый Запрос;	
	Запрос.Текст = 
				"ВЫБРАТЬ
				|	тбОчередь.ИдентификаторСобытия КАК ИдентификаторСобытия,
				|	тбОчередь.ДатаРегистрации КАК ДатаРегистрации,
				|	тбОчередь.ФорматСообщения КАК ФорматСообщения,
				|	тбОчередь.МетодХранения КАК МетодХранения,
				|	тбОчередь.ЭтоУдаление КАК ЭтоУдаление,
				|	тбОчередь.ОбъектСобытия КАК ОбъектСобытия,
				|	тбОчередь.СсылкаНаОбъект КАК СсылкаНаОбъект,
				|	тбОчередь.СпособПередачи КАК СпособПередачи,
				|	тбОчередь.Хранилище КАК Хранилище
				|ИЗ
				|	РегистрСведений.спОчередьИсходящихСообщений КАК тбОчередь
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.спСостояниеСообщений КАК тбСостояние
				|		ПО тбОчередь.ИдентификаторСобытия = тбСостояние.ИдентификаторСобытия
				|			И (тбСостояние.СтатусСообщения В (&СписокСтатусов))
				|			И (тбСостояние.ЗадержкаЧисло <= &ЗадержкаЧисло)
				|			И (тбОчередь.СсылкаНаОбъект В (&СсылкиНаОбъект))
				|
				|УПОРЯДОЧИТЬ ПО
				|	тбСостояние.ДатаИзменения";
	
	Запрос.УстановитьПараметр("СписокСтатусов", Статусы); 
	Запрос.УстановитьПараметр("ЗадержкаЧисло", спОбщегоНазначенияВызовСервера.ПеревестиДатуВЧисло(ТекущаяДатаСеанса()));  
	Запрос.УстановитьПараметр("СсылкиНаОбъект", СсылкиНаОбъект);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		ТекИдентификатор = "Идентификатор не определен";
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл					
			Данные = Новый Структура;
			Данные.Вставить("Идентификатор", 	Выборка.ИдентификаторСобытия); 
			Данные.Вставить("ФорматСообщения", 	Выборка.ФорматСообщения);
			Данные.Вставить("ОбъектСобытия", 	Выборка.ОбъектСобытия);
			Данные.Вставить("МетодХранения", 	Выборка.МетодХранения);
			Данные.Вставить("ДатаРегистрации", 	Выборка.ДатаРегистрации);
			Данные.Вставить("ЭтоУдаление", 		Выборка.ЭтоУдаление);
			Данные.Вставить("СсылкаНаОбъект", 	Выборка.СсылкаНаОбъект);
			Данные.Вставить("СпособПередачи", 	Выборка.СпособПередачи);
			Данные.Вставить("Хранилище", 		Выборка.Хранилище);
			ПакетДанных.Добавить(Данные);
		КонецЦикла;  
		
	КонецЕсли;	
	
	Возврат ПакетДанных;	
КонецФункции 

// Процедура - Обработка очереди исходящих сообщений
Функция ОбработкаИсходящихСообщения(СообщенияДляОтправки) Экспорт 
		
	ИсходящееСообщение = Новый Структура("ДвоичныеДанные, Префикс, Идентификатор");
	ТочкаОбмена = Неопределено;

	Если ТипЗнч(СообщенияДляОтправки) <> Тип("Массив") И СообщенияДляОтправки.Количество = 0 Тогда  
		Возврат ИсходящееСообщение;
	КонецЕсли;    
	
	Если ПолучитьФункциональнуюОпцию("спОтключитьПотоки") Тогда	
		Возврат ИсходящееСообщение;		
	КонецЕсли;
			
		ТекИдентификатор = "Идентификатор не определен";
		
		Попытка
			
			ПакетДанных = Новый Массив;
			
			 Для каждого Выборка Из СообщенияДляОтправки Цикл
				
				ТекИдентификатор = Выборка.ИдентификаторСобытия;
				спРаботаСДаннымиВызовСервера.УстановитьСостояниеСообщения(ТекИдентификатор, Перечисления.спСтатусыСообщений.ВОбработке, , , , , Перечисления.спТипыИнтеграции.Исходящая);
				
				Данные = Новый Структура;
				Данные.Вставить("ТекИдентификатор", ТекИдентификатор); 
				Данные.Вставить("ФорматСообщения", 	Выборка.ФорматСообщения);
				Данные.Вставить("ОбъектСобытия", 	Выборка.ОбъектСобытия);
				Данные.Вставить("МетодХранения", 	Выборка.МетодХранения);
				Данные.Вставить("ДатаРегистрации", 	Выборка.ДатаРегистрации);
				Данные.Вставить("ЭтоУдаление", 		Ложь);
				Данные.Вставить("СсылкаНаОбъект", 	Выборка.СсылкаНаОбъект);
				Данные.Вставить("СпособПередачи", 	Выборка.СпособПередачи);
				Данные.Вставить("ТочкаОбмена", 		ТочкаОбмена);
				Данные.Вставить("Хранилище", 		Выборка.Хранилище);
				ПакетДанных.Добавить(Данные);
			КонецЦикла;  
			
			Попытка 
			    			
				Если ПакетДанных.Количество() = 0 Тогда 
					Возврат ИсходящееСообщение;
				КонецЕсли;
				
				ПрочтенноеСообщение = СформироватьИсходящееСообщениеСКлиентаИзМассиваДанных(ПакетДанных);
				
				Если ТипЗнч(ПрочтенноеСообщение) = Тип("Структура") Тогда
					Значение = Неопределено;
					Если ПрочтенноеСообщение.Свойство("ДвоичныеДанные", Значение) Тогда 
						ИсходящееСообщение.Вставить("ДвоичныеДанные", Значение); 
					КонецЕсли; 
					Значение = Неопределено;
					Если ПрочтенноеСообщение.Свойство("Префикс", Значение) Тогда 
						ИсходящееСообщение.Вставить("Префикс", Значение);
					КонецЕсли;
				КонецЕсли;
				ИсходящееСообщение.Вставить("Идентификатор", ТекИдентификатор);
				
			Исключение
				
				// Запускаем фоновое задание со статическим ключем. Запуск других экземпляров должен заканчиваться ошибкой (паттерн синглтон).
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ЗаписьЖурналаРегистрации("Сформировать исходящее сообщение", УровеньЖурналаРегистрации.Ошибка
				, , , ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке)); 
				
			КонецПопытки 
			
		Исключение
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации("Обработка очереди исходящих сообщений", УровеньЖурналаРегистрации.Ошибка
										, , ТекИдентификатор, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));

		КонецПопытки;
	
	Возврат ИсходящееСообщение;	
КонецФункции 

