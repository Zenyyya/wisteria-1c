	Запрос.УстановитьПараметр("КонецПериода", ДатаОбработки);
	Запрос.УстановитьПараметр("Организация", Справочники.Организации.ОрганизацияПоУмолчанию());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДокумент = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДокумент.Следующий() Цикл
		
		Заказ = Документы.ЗаказНаПеремещение.СоздатьДокумент();
		Заказ.Заполнить(Неопределено);
		ЗаполнитьЗначенияСвойств(Заказ, ВыборкаДокумент);  
		Заказ.Дата = ДатаОбработки;
		Заказ.ДатаПеремещения = ДатаОбработки;
		Заказ.Автор = Автор;
		Заказ.Комментарий = Комментарий;
		Заказ.Ответственный = Неопределено;
		
		ВыборкаТовар = ВыборкаДокумент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаТовар.Следующий() Цикл
			
			КРаспределению = ВыборкаТовар.КоличествоРасход;
		
			ВыборкаПодобранныеТовары = ВыборкаТовар.Выбрать();
			Пока ВыборкаПодобранныеТовары.Следующий() И КРаспределению > 0 Цикл
				
				Если Не ЗначениеЗаполнено(ВыборкаПодобранныеТовары.Номенклатура) Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = Заказ.Запасы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПодобранныеТовары);
				
				НоваяСтрока.Количество 	= Мин(КРаспределению, ВыборкаПодобранныеТовары.ОстатокНаСкладе);
				
				КРаспределению = КРаспределению - НоваяСтрока.Количество;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если Заказ.Запасы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Заказ.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			спЛогированиеСобытийИБ.ЛогироватьСобытиеИБ("РегламентныеЗадания.АвтоподсортТоваровВТорговыйЗал", "Ошибка",,, Ошибка);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

