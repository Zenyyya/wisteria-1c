	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.спФормированиеДереваСайта);
	
	РегистрыСведений.спНастройкиФормированияДереваСайта.СформироватьДеревоСайта();
	
