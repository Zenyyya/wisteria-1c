Процедура Документ_ЗаказНаПеремещение_Форма_ФормаДокумента_ПриСозданииНаСервере(Форма)  
	РезультатОтправкиСообщения = Неопределено;  
	
	// ++ Терлецкий АВ 25.02.18
	ИмяКоманды  = "спОтправитьСообщение";
	ИмяЭлемента = "спОтправитьСообщение";
	
	Подключаемый_ДействиеКоманды = "Подключаемый_ВыполнитьКоманду";

	НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие  = Подключаемый_ДействиеКоманды;
	НоваяКоманда.Заголовок = НСтр("ru = 'Отправить сообщение'");
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("КнопкаФормы"), Форма.Элементы.ФормаКоманднаяПанель);
	НовыйЭлемент.ИмяКоманды = ИмяКоманды;
    // -- Терлецкий АВ 25.02.18
	
	// { Иванов С.С. (TNext) - 26.03.2025 - Задача №1096 
	ИмяКоманды  = "спОтгрузкаТоваров";
	Подключаемый_ДействиеКоманды = "Подключаемый_ВыполнитьКоманду";

	НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие  = Подключаемый_ДействиеКоманды;
	НоваяКоманда.Заголовок = НСтр("ru = 'Отгрузка товаров'");
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Форма.Элементы.ФормаКоманднаяПанель);
	НовыйЭлемент.ИмяКоманды = ИмяКоманды;
	// } 
	// { Иванов С.С. (TNext) - 26.03.2025 - Задача №1412 
	ИмяКоманды  = "спПодсортСЦС";
	Подключаемый_ДействиеКоманды = "Подключаемый_ВыполнитьКоманду";

	НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие  = Подключаемый_ДействиеКоманды;
	НоваяКоманда.Заголовок = НСтр("ru = 'Подсорт с ЦС'");
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Форма.Элементы.Запасы.КоманднаяПанель);
	НовыйЭлемент.ИмяКоманды = ИмяКоманды;
	// } 
	
	СтруктурнаяЕдиницаРезерв = спОбщегоНазначенияВызовСервера.ПолучитьЗначениеКонстанты("спОтправлятьСообщениеДляПодсортировкиМагазина");
	Если ЗначениеЗаполнено(СтруктурнаяЕдиницаРезерв) И Форма.Объект.СтруктурнаяЕдиницаРезерв = СтруктурнаяЕдиницаРезерв Тогда 
		Если Форма.Объект.Ссылка <> Документы.ЗаказНаПеремещение.ПустаяСсылка() Тогда  
			РезультатОтправкиСообщения = спПодключаемыеКомандыСервер.ПроверкаИсходящегоСообщенияНаВебСервер(Форма.Объект.Ссылка);
		КонецЕсли;
		
		//Обращение к командной панели в форме
		ПолеПраваяКолонка = Форма.Элементы.ПраваяКолонка;
		
		Если РезультатОтправкиСообщения = Истина Тогда 
			НовыйЭлемент = Форма.Элементы.Добавить("ОтправкаСообщения", Тип("ДекорацияФормы"), ПолеПраваяКолонка);
			НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
			НовыйЭлемент.Заголовок = "Сообщение отправлено";
			НовыйЭлемент.ЦветТекста = WebЦвета.Зеленый;
			
		ИначеЕсли РезультатОтправкиСообщения = Ложь Тогда
			НовыйЭлемент = Форма.Элементы.Добавить("ОтправкаСообщения", Тип("ДекорацияФормы"), ПолеПраваяКолонка);
			НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
			НовыйЭлемент.Заголовок = "Ошибка отправки";
			НовыйЭлемент.ЦветТекста = WebЦвета.Красный;
			
		Иначе
			НовыйЭлемент = Форма.Элементы.Добавить("ОтправкаСообщения", Тип("ДекорацияФормы"), ПолеПраваяКолонка);
			НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
			НовыйЭлемент.Заголовок = "Сообщение не отправлялось";
			НовыйЭлемент.ЦветТекста = WebЦвета.Синий;
			
		КонецЕсли; 
		
	Иначе
		ДекорацияФормыОтправкаСообщения = Форма.Элементы.Найти("ОтправкаСообщения");
		
		Если Не ТипЗнч(ДекорацияФормыОтправкаСообщения) = Тип("ДекорацияФормы") Тогда 
			ПолеПраваяКолонка = Форма.Элементы.ПраваяКолонка;
			ДекорацияФормыОтправкаСообщения = Форма.Элементы.Добавить("ОтправкаСообщения", Тип("ДекорацияФормы"), ПолеПраваяКолонка);
			ДекорацияФормыОтправкаСообщения.Вид = ВидДекорацииФормы.Надпись;
		КонецЕсли;
		ДекорацияФормыОтправкаСообщения.Заголовок = "";
		
		
	КонецЕсли;
	
	
КонецПроцедуры

Процедура Документ_ЗаказНаПеремещение_Форма_ФормаСписка_ПриСозданииНаСервере(Форма)
       СуществующийДС = Форма["Список"]; 
	   
	   СуществующийДС.ТекстЗапроса = "ВЫБРАТЬ
	                                 |	спОтправленныеСообщения.СсылкаНаОбъект КАК СсылкаНаОбъект,
