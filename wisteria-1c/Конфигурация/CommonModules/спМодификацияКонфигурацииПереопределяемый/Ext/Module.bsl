Процедура СкрытьЭлементыФормыРекурсивно(РеквизитыКОтображению, Элементы)
	
	Для каждого ЭлементФормы Из Элементы Цикл
		
		Если ТипЗнч(ЭлементФормы) = Тип("ПолеФормы") Тогда
			
			Если РеквизитыКОтображению.Найти(ЭлементФормы.Имя) = Неопределено Тогда
				
				ЭлементФормы.Видимость = Ложь;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ЭлементФормы) = Тип("ГруппаФормы") Тогда
			
			ПодчиненныеЭлементы = ЭлементФормы.ПодчиненныеЭлементы;
			
			Если ПодчиненныеЭлементы.Количество() > 0 Тогда
				
				СкрытьЭлементыФормыРекурсивно(РеквизитыКОтображению, ПодчиненныеЭлементы);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

#Область ВнешниеКартинки

Процедура ПереопределитьВыводКартинокНаВнешние(Форма)

	// {  Иванов С.С. (TNext) - 20.02.2025  
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	Изображения = Форма.Изображения;
	УникальныйИдентификатор = Форма.УникальныйИдентификатор;
	ТекущееИзображение = Форма.ТекущееИзображение;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	спВнешниеКартинкиТовара.ВнешняяСсылка КАК ВнешняяСсылка
		|ИЗ
		|	РегистрСведений.спВнешниеКартинкиТовара КАК спВнешниеКартинкиТовара
		|ГДЕ
		|	спВнешниеКартинкиТовара.АртикулПоставщика = &АртикулПоставщика";
	
	Запрос.УстановитьПараметр("АртикулПоставщика", Форма.Объект.спАртикулПоставщика);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВнешниеСсылки = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ВнешняяСсылка");
	Изображения.Очистить();
	
	Для каждого ВнешняяСсылка Из ВнешниеСсылки Цикл
		
		ДвоичныеДанныеКартинки = СсылкаНаДвоичныеДанныеКартинки(ВнешняяСсылка,, УникальныйИдентификатор);
		Если ДвоичныеДанныеКартинки <> Неопределено Тогда
			НоваяСтрока = Изображения.Вставить(0);
			НоваяСтрока.Адрес = ДвоичныеДанныеКартинки;
		КонецЕсли;
		
	КонецЦикла;
	
	КоличествоИзображений = Элементы.Изображение.ПодчиненныеЭлементы.Количество();
	ОтображаемоеИзображение = Элементы.Изображение.ПодчиненныеЭлементы[КоличествоИзображений - 1];
	ОтображаемоеИзображение.ТекстНевыбраннойКартинки = Элементы.АдресКартинки.ТекстНевыбраннойКартинки;
	Если Изображения.Количество() = 0 Тогда
		ТекущееИзображение = 0;
		ОтображаемоеИзображение.Рамка = Новый Рамка(ТипРамкиЭлементаУправления.Одинарная);
	Иначе
		ТекущееИзображение = 0;
		ОтображаемоеИзображение.Рамка = Новый Рамка(ТипРамкиЭлементаУправления.БезРамки);
	КонецЕсли;
	
	УстановитьПрокруткуИзображения(Форма);
	ИзображениеВидимостьКоманднойПанели(Форма);
	
	// Убираем неиспользуемый функционал
	Форма.РазрешеноРедактированиеНоменклатуры = Ложь;
	
	КомандыИзображения = Элементы.Найти("КомандыИзображения");
	КомандыИзображения.Доступность = Ложь;
	
КонецПроцедуры

Функция СсылкаНаДвоичныеДанныеКартинки(ВнешняяСсылка, Размер = 0, УникальныйИдентификатор = Неопределено, Напрямую = Ложь) Экспорт
	
	Если УникальныйИдентификатор = Неопределено Тогда
		УникальныйИдентификатор = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	СтруктураУРЛ = ОбщегоНазначенияКлиентСервер.СтруктураURI(ВнешняяСсылка);
	
	Если СтруктураУРЛ.Схема = "https" Тогда
		ТипСоединения = Новый ЗащищенноеСоединениеOpenSSL() 
	Иначе
		ТипСоединения = Неопределено;
	КонецЕсли;
	
	АдресСервера 	= СтруктураУРЛ.ИмяСервера; 
	СсылкаКартинки 	= СтруктураУРЛ.ПутьНаСервере; 
	ЭтоЯндекс 		= СтрНайти(АдресСервера, "disk.360.yandex.ru") > 0;
	ИспользоватьАПИ = Не Напрямую И ЭтоЯндекс;
	
	Если ИспользоватьАПИ Тогда 
		// используется API
		АдресСервера 	= "cloud-api.yandex.net"; 
		Разделитель 	= "/";
		РазделительРесурса = "&path=";
		Части 			= СтрРазделить(ВнешняяСсылка, Разделитель, Ложь);
		Части[0] 		= Части[0] + Разделитель;
		Части[3] 		= ?(СтрЗаканчиваетсяНа(Части[3], РазделительРесурса), Части[3], Части[3] + РазделительРесурса);
		ПубличныйКлюч 	= СтрСоединить(Части, Разделитель); 
		СсылкаКартинки 	= СтрШаблон("/v1/disk/public/resources/download?public_key=%1", ПубличныйКлюч);
	КонецЕсли;              
	    
	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
		Соединение = Новый HTTPСоединение(АдресСервера,,,,,, ТипСоединения);
		Запрос = Новый HTTPЗапрос(СсылкаКартинки);
		Ответ = Соединение.Получить(Запрос);
		УстановитьПривилегированныйРежим(Ложь);
		
		Если Ответ.КодСостояния = 200 Тогда
			
			Если ИспользоватьАПИ Тогда 
				
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
				СсылкаНаСкачиваниеФайла = ПрочитатьJSON(ЧтениеJSON);
				Если ЗначениеЗаполнено(СсылкаНаСкачиваниеФайла.href) тогда 
					АдресКартинки =  СсылкаНаДвоичныеДанныеКартинки(СсылкаНаСкачиваниеФайла.href, Размер, УникальныйИдентификатор, Истина);
				Иначе
					Возврат Неопределено;
				КонецЕсли;
				
			Иначе
				
				ДвоичныеДанныеКартинки = Ответ.ПолучитьТелоКакДвоичныеДанные();
				
				Если Размер <> 0 Тогда
					Картинка = Новый Картинка(ДвоичныеДанныеКартинки);
					ОбрабатываемаяКартинка = Новый ОбрабатываемаяКартинка(Картинка);
					ОбрабатываемаяКартинка.УстановитьРазмер(Размер, );
					ОбрабатываемаяКартинка.ПреобразоватьВОттенкиСерого();
					Картинка = ОбрабатываемаяКартинка.ПолучитьКартинку();
					ДвоичныеДанныеКартинки = Картинка.ПолучитьДвоичныеДанные();
				КонецЕсли;
				
				АдресКартинки = ПоместитьВоВременноеХранилище(ДвоичныеДанныеКартинки, УникальныйИдентификатор);
				
			КонецЕсли;
			
		ИначеЕсли СтрНачинаетсяС(Ответ.КодСостояния, "3") Тогда
			
			Ссылка = Ответ.Заголовки.Получить("Location");
			АдресКартинки =  СсылкаНаДвоичныеДанныеКартинки(Ссылка, Размер, УникальныйИдентификатор, Истина);
			
		Иначе
			
			ТекстИсключения = СтрШаблон(НСтр("ru = 'Не удалось получить картинку. Код ответа: %1'"), Ответ.КодСостояния);
			ВызватьИсключение ТекстИсключения;

		КонецЕсли;
		
		Возврат АдресКартинки;
	
	Исключение
		
		Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		спЛогированиеСобытийИБ.ЛогироватьСобытиеИБ("Tnext.ПолучениеВнешнейКартинки", "Ошибка",,,Ошибка);
		Возврат Неопределено;
		
	КонецПопытки;

КонецФункции

// Устанавливает видимость и доступность кнопок перелистывания изображения.
//
Процедура УстановитьПрокруткуИзображения(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	Изображения = Форма.Изображения;
	ТекущееИзображение = Форма.ТекущееИзображение;
	
	Если Изображения.Количество() <= 1 Тогда
		Элементы.ДекорацияПрокруткаИзображенийВлево.Видимость = Ложь;
		Элементы.ДекорацияПрокруткаИзображенийВправо.Видимость = Ложь;
		Элементы.ДекорацияПрокруткаИзображенийВлевоОтступ.Видимость = Истина;
		Элементы.ДекорацияПрокруткаИзображенийВправоОтступ.Видимость = Истина;
		Возврат;
	КонецЕсли;
	
	Если ТекущееИзображение = 0 Тогда
		Элементы.ДекорацияПрокруткаИзображенийВлево.Видимость = Ложь;
		Элементы.ДекорацияПрокруткаИзображенийВправо.Видимость = Истина;
	ИначеЕсли ТекущееИзображение = Изображения.Количество() - 1 Тогда
		Элементы.ДекорацияПрокруткаИзображенийВлево.Видимость = Истина;
		Элементы.ДекорацияПрокруткаИзображенийВправо.Видимость = Ложь;
	Иначе
		Элементы.ДекорацияПрокруткаИзображенийВлево.Видимость = Истина;
		Элементы.ДекорацияПрокруткаИзображенийВправо.Видимость = Истина
	КонецЕсли;
	
	Элементы.ДекорацияПрокруткаИзображенийВлево.Видимость = Ложь;
	Элементы.ДекорацияПрокруткаИзображенийВправо.Видимость = Истина;
	
	Элементы.ДекорацияПрокруткаИзображенийВлевоОтступ.Видимость = Не Элементы.ДекорацияПрокруткаИзображенийВлево.Видимость;
	Элементы.ДекорацияПрокруткаИзображенийВправоОтступ.Видимость = Не Элементы.ДекорацияПрокруткаИзображенийВправо.Видимость;
	
	ЭлементАдресКартинки = Элементы.Найти("АдресКартинки1");
	Если ЭлементАдресКартинки <> Неопределено Тогда
		ТекущийЭлемент = ЭлементАдресКартинки;
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает видимость кнопок контекстного меню изображения.
//
Процедура ИзображениеВидимостьКоманднойПанели(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	Изображения = Форма.Изображения;
	ТекущееИзображение = Форма.ТекущееИзображение;
	ОтображатьКнопкуСортировкиНаФорме = Форма.ОтображатьКнопкуСортировкиНаФорме;
	
	ЕстьИзображения = Изображения.Количество();
	
	ЭтоОсновноеИзображение = Ложь;
	Если ЕстьИзображения Тогда
		ЭтоОсновноеИзображение = (ТекущееИзображение = 0);
	КонецЕсли;
	
	Элементы.ДекорацияИндикацияОсновнойКартинки.Видимость = ЭтоОсновноеИзображение;
	Элементы.ДекорацияИндикацияНеОсновнойКартинки.Видимость = Не ЭтоОсновноеИзображение;
	
	
	Элементы.ГруппаИндикацияОсновнойКартинки.Видимость = ЕстьИзображения;
	Элементы.АдресКартинкиКонтекстноеМенюУстановитьИзображениеОсновнымДоп.Видимость = Ложь;
	Элементы.АдресКартинкиКонтекстноеМенюПросмотретьИзображениеДоп.Видимость = Ложь;
	Элементы.АдресКартинкиКонтекстноеМенюУдалитьИзображениеДоп.Видимость = Ложь;
	Элементы.АдресКартинкиКонтекстноеМенюУстановитьИзображениеОсновным.Видимость = Ложь;
	Элементы.АдресКартинкиКонтекстноеМенюУдалитьИзображение.Видимость = Ложь;
	Элементы.АдресКартинкиКонтекстноеМенюПросмотретьИзображение.Видимость = Ложь;
	Элементы.АдресКартинкиКонтекстноеМенюКнопкаСортировкаФайловНаСайте.Видимость = Ложь;
	
	Элементы.АдресКартинкиКонтекстноеМенюУстановитьИзображениеОсновнымДоп.Доступность = Ложь;
	Элементы.АдресКартинкиКонтекстноеМенюПросмотретьИзображениеДоп.Доступность = Ложь;
	Элементы.АдресКартинкиКонтекстноеМенюУдалитьИзображениеДоп.Доступность = Ложь;
	Элементы.АдресКартинкиКонтекстноеМенюУстановитьИзображениеОсновным.Доступность = Ложь;
	Элементы.АдресКартинкиКонтекстноеМенюУдалитьИзображение.Доступность = Ложь;
	Элементы.АдресКартинкиКонтекстноеМенюПросмотретьИзображение.Доступность = Ложь;
	Элементы.АдресКартинкиКонтекстноеМенюКнопкаСортировкаФайловНаСайте.Доступность = Ложь;

КонецПроцедуры

#КонецОбласти

Процедура ПереопределитьЭлементФормы(Элементы, КопируемыйЭлемент, Родитель, Префикс = "сп")

	// Скрываем типовые картинки
	Если КопируемыйЭлемент = Неопределено Тогда
		 Возврат;
	КонецЕсли;
	
	// Создаем новую группу с картинками копированием
	СкопироватьЭлементРекурсивно(Элементы, КопируемыйЭлемент, Родитель, Префикс);
	
	КопируемыйЭлемент.Видимость = Ложь;

КонецПроцедуры

Процедура СкопироватьЭлементРекурсивно(Элементы, КопируемыйЭлемент, Родитель, Префикс, Вставить = Истина)
	
	Если Вставить Тогда
		ЭлементПеред = КопируемыйЭлемент;
	Иначе
		ЭлементПеред = Неопределено;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(КопируемыйЭлемент);
	ЭтоГруппаФормы = ТипЗначения = Тип("ГруппаФормы");
	ЕстьПутьКДаннымЗаголовка = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(КопируемыйЭлемент, "ПутьКДаннымЗаголовка");
	ИмяНовогоЭлементы = Префикс + КопируемыйЭлемент.Имя;
	
	НовыйЭлемент = Элементы.Найти(ИмяНовогоЭлементы);
	Если НовыйЭлемент <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НовыйЭлемент = Элементы.Вставить(ИмяНовогоЭлементы, ТипЗначения, Родитель, ЭлементПеред); 
	
	ИсключаемыеПоля = ?(ЕстьПутьКДаннымЗаголовка, "Имя, ПутьКДаннымЗаголовка", "Имя");
	
	ЗаполнитьЗначенияСвойств(НовыйЭлемент, КопируемыйЭлемент,, ИсключаемыеПоля); 
	
	Если ЭтоГруппаФормы Тогда
		
		Для каждого Элемент Из КопируемыйЭлемент.ПодчиненныеЭлементы Цикл 
			СкопироватьЭлементРекурсивно(Элементы, Элемент, НовыйЭлемент, Префикс, Ложь);
		КонецЦикла;
		
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(КопируемыйЭлемент, "КонтекстноеМеню") Тогда
		
		Для каждого Элемент Из КопируемыйЭлемент.КонтекстноеМеню.ПодчиненныеЭлементы Цикл
			СкопироватьЭлементРекурсивно(Элементы, Элемент, НовыйЭлемент.КонтекстноеМеню, Префикс, Ложь);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТипЗначения = Тип("КнопкаФормы") Тогда
		Возврат;
	КонецЕсли;
	
	// копируем основные действия
	ДействияСтрокой = "ПриИзменении, Нажатие";
	Действия = СтрРазделить(ДействияСтрокой, ", ", Ложь);
	
	Для каждого Действие Из Действия Цикл
		
		МетодДействия = КопируемыйЭлемент.ПолучитьДействие(Действие);
		Если ЗначениеЗаполнено(МетодДействия) Тогда
			НовыйЭлемент.УстановитьДействие(Действие, МетодДействия);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

