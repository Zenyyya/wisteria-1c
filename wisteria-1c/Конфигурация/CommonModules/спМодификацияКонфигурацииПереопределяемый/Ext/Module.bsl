#Область ПрограммныйИнтерфейс

Процедура ПриСозданииНаСервере(Форма) Экспорт

	Если Форма.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда
		Справочник_Номенклатура_Форма_ФормаЭлемента_ПриСозданииНаСервере(Форма);
	ИначеЕсли Форма.ИмяФормы = "Справочник.ХранилищеШаблонов.Форма.ФормаРедактированияШаблона" Тогда   
		Справочник_ХранилищеШаблонов_Форма_ФормаРедактированияШаблона_ПриСозданииНаСервере(Форма);
	ИначеЕсли Форма.ИмяФормы = "Документ.ЗаказПоставщику.Форма.ФормаДокумента" Тогда   
		Документ_ЗаказПоставщику_Форма_ФормаДокумента_ПриСозданииНаСервере(Форма);
	ИначеЕсли Форма.ИмяФормы = "Документ.ЗаказПоставщику.Форма.ФормаСписка" Тогда   
		Документ_ЗаказПоставщику_Форма_ФормаСписка_ПриСозданииНаСервере(Форма); 
		
	// ++ Терлецкий АВ 25.01.15
	ИначеЕсли Форма.ИмяФормы = "Документ.ЗаказНаПеремещение.Форма.ФормаДокумента" Тогда   
		Документ_ЗаказНаПеремещение_Форма_ФормаДокумента_ПриСозданииНаСервере(Форма); 
	
	ИначеЕсли Форма.ИмяФормы = "Документ.ЗаказНаПеремещение.Форма.ФормаСписка" Тогда   
		Документ_ЗаказНаПеремещение_Форма_ФормаСписка_ПриСозданииНаСервере(Форма);
	// -- Терлецкий АВ 25.01.15 
	    Документ_ЗаказНаПеремещение_ФормаСписка_УстановкаИнтервалаОбновленияСписка(Форма);
		 
	// ++ Терлецкий АВ 25.01.19
	ИначеЕсли Форма.ИмяФормы = "Документ.ЗаказПокупателя.Форма.ФормаДокумента" Тогда   
		Документ_ЗаказПокупателя_Форма_ФормаДокумента_ПриСозданииНаСервере(Форма);
	// -- Терлецкий АВ 25.01.19

	
	// { Иванов С.С. (TNext) - 23.01.2025 
	ИначеЕсли Форма.ИмяФормы = "Документ.ПеремещениеЗапасов.Форма.ФормаДокумента" Тогда   
		Документ_ПеремещениеЗапасов_Форма_ФормаДокумента_ПриСозданииНаСервере(Форма); 
	// }
	
	// dimedrol 23.02.2025
	ИначеЕсли Форма.ИмяФормы = "Справочник.Контрагенты.Форма.ФормаЭлемента" Тогда
		Справочник_Контрагенты_Форма_ФормаЭлемента_ПриСозданииНаСервере(Форма);
	// end of dimedrol 23.02.2025
	
	ИначеЕсли Форма.ИмяФормы = "Документ.ЧекККМ.Форма.ФормаДокумента"  Тогда
	   	Справочник_ШтрихкодыУпаковокТоваров_Форма_ПеренестиКнопку(Форма);
	ИначеЕсли Форма.ИмяФормы = "Справочник.ШтрихкодыУпаковокТоваров.Форма.ФормаСписка"  Тогда
	   	Справочник_ШтрихкодыУпаковокТоваров_Форма_ПеренестиКнопку(Форма);
	ИначеЕсли Форма.ИмяФормы = "Справочник.ШтрихкодыУпаковокТоваров.Форма.ФормаЭлемента"  Тогда
	   	Справочник_ШтрихкодыУпаковокТоваров_Форма_ПеренестиКнопку(Форма);
	ИначеЕсли Форма.ИмяФормы = "Справочник.Сотрудники.Форма.ФормаЭлемента"  Тогда
	   	Справочник_Сотрудники_ФормаЭлемента_ПриСоздании(Форма);
	ИначеЕсли Форма.ИмяФормы = "Документ.ЗаказНаЭмиссиюКодовМаркировкиСУЗ.Форма.ФормаДокумента"  Тогда
	   	Документ_ЗаказНаЭмиссиюКодовМаркировкиСУЗ_Форма_ПриСоздании(Форма);
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры

Процедура АРМРаботникаЗалаНоменклатураПриСоздании(Форма) Экспорт
	
	Если Форма.ИмяФормы <> "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Элементы	= Форма.Элементы;
	Параметры	= Форма.Параметры;
	
	// {  Иванов С.С. (TNext) - 20.02.2025
	ПереопределитьВыводКартинокНаВнешние(Форма);
	// }  
	
	// {  Иванов С.С. (TNext) - 13.02.2025
	// используется ограничение отображения реквизитов формы при работе в "АРМ Работника зала"
	Если Параметры.Свойство("НомерВерсииПереходаНаВерсиюИсторииДанных") И ЗначениеЗаполнено(Параметры.НомерВерсииПереходаНаВерсиюИсторииДанных) Тогда
		
		РеквизитыКОтображению = Параметры.НомерВерсииПереходаНаВерсиюИсторииДанных;
		
		Если ТипЗнч(РеквизитыКОтображению) = Тип("СписокЗначений") Тогда
			
			Форма.ТолькоПросмотр = Истина;
			
			СкрытьЭлементыФормыРекурсивно(РеквизитыКОтображению.ВыгрузитьЗначения(), Элементы);
			
		КонецЕсли;
	
	Иначе
		
		Возврат;
		
	КонецЕсли; 
	// }
	
КонецПроцедуры

Процедура Номенклатура_ВыводКартинок(Форма) Экспорт
	
	Если Форма.ИмяФормы <> "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда
		Возврат;
	КонецЕсли;
	
	// {  Иванов С.С. (TNext) - 20.02.2025
	ПереопределитьВыводКартинокНаВнешние(Форма);
	// }  
	
КонецПроцедуры

#КонецОбласти  

#Область СлужебныеПроцедурыИФункции 

Процедура Справочник_Номенклатура_Форма_ФормаЭлемента_ПриСозданииНаСервере(Форма)
	
	Элементы = Форма.Элементы;
	
	// элемент формы спАртикулПоставщика
	Родитель = Элементы.Найти("ГруппаСгруппированныеРеквизиты");
	ИмяЭлемента = "спАртикулПоставщика";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
	 	НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);		
		НовыйЭлемент.ПутьКДанным = "Объект.спАртикулПоставщика";
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.Заголовок = "Артикул поставщика";
	КонецЕсли;
	
	// dimedrol 24.01.2025
	// элементы формы Размер и Цвет
	Родитель = Элементы.Найти("ГруппаСгруппированныеРеквизиты");
	ИмяЭлемента = "спГруппаДобавленныеРеквизиты";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		НовыйЭлементГруппа = Элементы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), Родитель);
		НовыйЭлементГруппа.Вид                    = ВидГруппыФормы.ОбычнаяГруппа;
		НовыйЭлементГруппа.Отображение            = ОтображениеОбычнойГруппы.Нет;
		НовыйЭлементГруппа.ОтображатьЗаголовок    = Ложь;
		НовыйЭлементГруппа.Группировка            = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		НовыйЭлементГруппа.Заголовок              = "(Вистерия) Добавленные реквизиты";
	КонецЕсли;
	
	Родитель = Элементы.Найти("спГруппаДобавленныеРеквизиты");
	ИмяЭлемента = "спРазмер";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
		НовыйЭлемент.ПутьКДанным              = "Объект.спРазмер";
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
		НовыйЭлемент.Заголовок                = "Размер";
	КонецЕсли;
	
	Родитель = Элементы.Найти("спГруппаДобавленныеРеквизиты");
	ИмяЭлемента = "спЦвет";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
		НовыйЭлемент.ПутьКДанным              = "Объект.спЦвет";
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.Заголовок                = "Цвет";
	КонецЕсли;
	// end of dimedrol 24.01.2025
	
	// dimedrol 23.02.2025
	Родитель = Элементы.Найти("спГруппаДобавленныеРеквизиты");
	ИмяЭлемента = "спБренд";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
		НовыйЭлемент.ПутьКДанным              = "Объект.спБренд";
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.Заголовок                = "Бренд";
	КонецЕсли;
	// end of dimedrol 23.02.2025
	
	// { Иванов С.С. (TNext) - 06.08.2025 - Задача №3342 
	Родитель = Элементы.Найти("ГруппаПрайсЛист");
	ЭлементПеред = Элементы.Найти("ГруппаНовинка");
	
	ИмяЭлемента = "спАтрибутРаздела";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		НовыйЭлемент = Элементы.Вставить(ИмяЭлемента, Тип("ПолеФормы"), Родитель, ЭлементПеред);
		НовыйЭлемент.ПутьКДанным              = "Объект.спАтрибутРаздела";
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
	КонецЕсли;
	
	ИмяЭлемента = "спМаркетинговаяКатегория";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		НовыйЭлемент = Элементы.Вставить(ИмяЭлемента, Тип("ПолеФормы"), Родитель, ЭлементПеред);
		НовыйЭлемент.ПутьКДанным              = "Объект.спМаркетинговаяКатегория";
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Форма.Объект.Ссылка) И Не ЗначениеЗаполнено(Форма.Объект.спМаркетинговаяКатегория) Тогда
		Форма.Объект.спМаркетинговаяКатегория = Перечисления.спМаркетинговыеКатегории.RARE;
	КонецЕсли;
	
	ИмяЭлемента = "спПодборка";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		НовыйЭлемент = Элементы.Вставить(ИмяЭлемента, Тип("ПолеФормы"), Родитель, ЭлементПеред);
		НовыйЭлемент.ПутьКДанным              = "Объект.спПодборка";
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
	КонецЕсли;
	
	ИмяЭлемента = "спЯндексБизнес";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		НовыйЭлемент = Элементы.Вставить(ИмяЭлемента, Тип("ПолеФормы"), Родитель, ЭлементПеред);
		НовыйЭлемент.ПутьКДанным              = "Объект.спЯндексБизнес";
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеФлажка;
		НовыйЭлемент.ПоложениеЗаголовка		  = ПоложениеЗаголовкаЭлементаФормы.Право;
	КонецЕсли;
	// } 
	
КонецПроцедуры

Процедура Справочник_ХранилищеШаблонов_Форма_ФормаРедактированияШаблона_ПриСозданииНаСервере(Форма)
	
	Элементы = Форма.Элементы;
	Команды = Форма.Команды;
	Подключаемый_ДействиеКоманды = "Подключаемый_ВыполнитьКоманду";
	
	//Добавляем новую команду
	НоваяКоманда = Команды.Добавить("спЗнакиУхода");
	НоваяКоманда.Действие = Подключаемый_ДействиеКоманды;
	НоваяКоманда.Заголовок = "Добавить ЗУ";
	  
	//Обращение к командной панели в форме
	КоманднаяПанельПоле = Элементы.Шапка.ПодчиненныеЭлементы.ДеревоНастроек.ПодчиненныеЭлементы.ДоступныеПоля.КоманднаяПанель;
	//Добавляем новую кнопку
	Элемент2 = Элементы.Добавить("спЗнакиУхода", Тип("КнопкаФормы"),КоманднаяПанельПоле);
	Элемент2.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	Элемент2.ИмяКоманды = "спЗнакиУхода";	 
	
	//Добавляем новую команду
	НоваяКоманда = Команды.Добавить("спЗнакиУходаКартинка");
	НоваяКоманда.Действие = Подключаемый_ДействиеКоманды;
	НоваяКоманда.Заголовок = "Добавить ЗУК";
	  
	//Добавляем новую кнопку
	Элемент2 = Элементы.Добавить("спЗнакиУходаКартинка", Тип("КнопкаФормы"),КоманднаяПанельПоле);
	Элемент2.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	Элемент2.ИмяКоманды = "спЗнакиУходаКартинка";	
	
КонецПроцедуры

