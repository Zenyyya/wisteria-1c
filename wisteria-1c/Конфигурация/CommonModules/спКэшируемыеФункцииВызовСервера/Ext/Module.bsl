// Функция - Получить список рабочих статусов
//
// Возвращаемое значение:
//  Массив - массив, сождержащий элементы перечисления "Статусы сообщений" (См. Перечисления.спСтатусыСообщений)
//
Функция ПоучитьСписокРабочихСтатусов() Экспорт
	
	МассивСтатусы = Новый Массив;
	МассивСтатусы.Добавить(Перечисления.спСтатусыСообщений.Новое);
	МассивСтатусы.Добавить(Перечисления.спСтатусыСообщений.ОжиданиеОбработки); 
	
	Возврат МассивСтатусы;
	
КонецФункции

// Функция - Получить список статусов очереди исходящих сообщений
//
// Возвращаемое значение:
//  Массив - массив, сождержащий элементы перечисления "Статусы сообщений" (См. Перечисления.спСтатусыСообщений)
//
Функция ПоучитьСписокСтатусовОчередиИсходящихСообщений() Экспорт
	
	МассивСтатусы = Новый Массив;
	МассивСтатусы.Добавить(Перечисления.спСтатусыСообщений.Отправлено);
	МассивСтатусы.Добавить(Перечисления.спСтатусыСообщений.ОтправкаПодтверждена);
	Возврат МассивСтатусы;
	
КонецФункции  

// Функция - Получить список статусов для избежания повторной отправки
//
// Возвращаемое значение:
//  Массив - массив, сождержащий элементы перечисления "Статусы сообщений" (См. Перечисления.спСтатусыСообщений)
//
Функция ПоучитьСписокСтатусовДляОтправки() Экспорт
	
	МассивСтатусы = Новый Массив;
	МассивСтатусы.Добавить(Перечисления.спСтатусыСообщений.Новое);
	МассивСтатусы.Добавить(Перечисления.спСтатусыСообщений.ОжиданиеОбработки);
	МассивСтатусы.Добавить(Перечисления.спСтатусыСообщений.ВОбработке);
	МассивСтатусы.Добавить(Перечисления.спСтатусыСообщений.ОшибкаОтправки);
	Возврат МассивСтатусы;	
КонецФункции

