Функция ЗаполнитьСписокНоменклатурыШтрихкод(Источник)  
	// ++ Терлецкий АВ 25.02.04
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НоменклатураДополнительныеРеквизиты.Ссылка КАК Номенклатура,
	|	НоменклатураДополнительныеРеквизиты.Значение КАК Размер
	|ПОМЕСТИТЬ ВТРазмер
	|ИЗ
	|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	|ГДЕ
	|	НоменклатураДополнительныеРеквизиты.Ссылка = &Номенклатура
	|	И НоменклатураДополнительныеРеквизиты.Свойство.Наименование ПОДОБНО ""Размер поставщика""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НоменклатураДополнительныеРеквизиты.Ссылка КАК Номенклатура,
	|	НоменклатураДополнительныеРеквизиты.Значение КАК SizeId
	|ПОМЕСТИТЬ ВТSizeId
	|ИЗ
	|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	|ГДЕ
	|	НоменклатураДополнительныеРеквизиты.Ссылка = &Номенклатура
	|	И НоменклатураДополнительныеРеквизиты.Свойство.Наименование ПОДОБНО ""SizeId""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРазмер.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТНоменклатура
	|ИЗ
	|	ВТРазмер КАК ВТРазмер
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТSizeId.Номенклатура
	|ИЗ
	|	ВТSizeId КАК ВТSizeId
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНоменклатура.Номенклатура КАК Номенклатура,
	|	ВТSizeId.SizeId КАК SizeId,
	|	ВТРазмер.Размер КАК Размер,
	|	ВТНоменклатура.Номенклатура.Штрихкод КАК Штрихкод
	|ИЗ
	|	ВТНоменклатура КАК ВТНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТРазмер КАК ВТРазмер
	|		ПО ВТНоменклатура.Номенклатура = ВТРазмер.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТSizeId КАК ВТSizeId
	|		ПО ВТНоменклатура.Номенклатура = ВТSizeId.Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", Источник);
	Результат = Запрос.Выполнить().Выгрузить();  
	
	Возврат Результат;
	// ++ Терлецкий АВ 25.02.04
	
КонецФункции

Функция ПолучитьЗначенияКонстант() Экспорт 
	СтруктураКонстантПодключения = Новый Структура;
	СтруктураКонстантПодключения.Вставить("sFTPСервер", спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спsFTPСервер")); 
	СтруктураКонстантПодключения.Вставить("sFTPЛогин", спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спsFTPЛогин"));
	СтруктураКонстантПодключения.Вставить("sFTPПароль", спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спsFTPПароль"));
	СтруктураКонстантПодключения.Вставить("sFTPПорт", спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спsFTPПорт"));
	СтруктураКонстантПодключения.Вставить("спsFTPSHHКлюч", спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спsFTPSHHКлюч")); 
	СтруктураКонстантПодключения.Вставить("sFTPПутьНаFTPPending", спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спsFTPПутьНаFTPPending"));
	СтруктураКонстантПодключения.Вставить("sFTPПутьНаFTPProcessed", спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спsFTPПутьНаFTPProcessed"));
	СтруктураКонстантПодключения.Вставить("sFTPПутьНаFTPErrors", спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спsFTPПутьНаFTPErrors"));
	Возврат СтруктураКонстантПодключения;
