Функция ПолучитьЦеныПоИнициаторОтправки(ИнициаторОтправки)  
	Ссылка = Неопределено;
	Если ТипЗнч(ИнициаторОтправки) = Тип("ДокументСсылка.ПеремещениеЗапасов") 
		И ТипЗнч(ИнициаторОтправки.ДокументОснование) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда 
		   Ссылка = ИнициаторОтправки.ДокументОснование;   
	   Иначе 
		   Ссылка = ИнициаторОтправки;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПриходнаяНакладнаяЗапасы.Номенклатура КАК Номенклатура,
		//|	ПриходнаяНакладнаяЗапасы.Характеристика КАК Характеристика, // ++ Терлецкий АВ 25.01.20
		|	ПриходнаяНакладнаяЗапасы.Цена КАК Цена
		|ИЗ
		|	Документ.ПриходнаяНакладная.Запасы КАК ПриходнаяНакладнаяЗапасы
		|ГДЕ
		|	ПриходнаяНакладнаяЗапасы.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат; 
КонецФункции

Функция СериализоватьFE720(Источник)
