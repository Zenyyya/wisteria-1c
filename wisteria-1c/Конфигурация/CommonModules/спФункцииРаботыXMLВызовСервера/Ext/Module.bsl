	Сериализация.Вставить("ОшибкаДанных", ОшибкаДанных); 
	
	Если ОшибкаДанных Тогда
		Сериализация.Вставить("СтатусСообщения", Перечисления.спСтатусыСообщений.НеВалидно);	
	КонецЕсли;
	
	Возврат Сериализация;
	
