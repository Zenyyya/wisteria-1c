Функция ЗаполнитьCписокТоваров(Знач Источник) 
	// ++ Терлецкий АВ 25.02.04
	
	Запасы = Источник.Запасы.Выгрузить(,"Номенклатура, Количество, Цена");
	Запасы.Свернуть("Номенклатура, Цена", "Количество");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Запасы.Номенклатура КАК НоменклатураСсылка
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	&Запасы КАК Запасы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НоменклатураДополнительныеРеквизиты.Ссылка КАК Ссылка,
	|	НоменклатураДополнительныеРеквизиты.Значение КАК Размер
	|ПОМЕСТИТЬ ВТРазмер
	|ИЗ
	|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	|ГДЕ
	|	НоменклатураДополнительныеРеквизиты.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТТовары.НоменклатураСсылка КАК Номенклатура
	|			ИЗ
	|				ВТТовары КАК ВТТовары)
	|	И НоменклатураДополнительныеРеквизиты.Свойство.Наименование ПОДОБНО ""Размер поставщика""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НоменклатураДополнительныеРеквизиты.Ссылка КАК Ссылка,
	|	НоменклатураДополнительныеРеквизиты.Значение КАК SizeId
	|ПОМЕСТИТЬ ВТSizeId
	|ИЗ
	|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	|ГДЕ
	|	НоменклатураДополнительныеРеквизиты.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТТовары.НоменклатураСсылка КАК Номенклатура
	|			ИЗ
	|				ВТТовары КАК ВТТовары)
	|	И НоменклатураДополнительныеРеквизиты.Свойство.Наименование ПОДОБНО ""SizeId""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.НоменклатураСсылка КАК Номенклатура,
	|	ВТРазмер.Размер КАК Размер,
	|	ВТSizeId.SizeId КАК SizeId,
	|	Номенклатура.Штрихкод КАК Штрихкод
	|ИЗ
	|	ВТТовары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТРазмер КАК ВТРазмер
	|		ПО Товары.НоменклатураСсылка = ВТРазмер.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТSizeId КАК ВТSizeId
	|		ПО Товары.НоменклатураСсылка = ВТSizeId.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО Товары.НоменклатураСсылка = Номенклатура.Ссылка";
	
	Запрос.УстановитьПараметр("Запасы", Запасы);	
	ШтрихкодыНоменклатуры = Запрос.Выполнить().Выгрузить();

	Товары = Новый ТаблицаЗначений;
	Товары.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Товары.Колонки.Добавить("uuid",  Новый ОписаниеТипов("УникальныйИдентификатор")); 
	Товары.Колонки.Добавить("size",  Новый ОписаниеТипов("Строка")); 
	Товары.Колонки.Добавить("ean",  Новый ОписаниеТипов("Строка"));
    Товары.Колонки.Добавить("quantity",  Новый ОписаниеТипов("Число")); 
	Товары.Колонки.Добавить("price",  Новый ОписаниеТипов("Число"));
	
	Для каждого СтрЗапасы Из Запасы Цикл 
		СтрокаТовары = Товары.Добавить();  
		СтрокаТовары.Номенклатура = СтрЗапасы.Номенклатура;
	    СтрокаТовары.uuid = СтрЗапасы.Номенклатура.УникальныйИдентификатор();
		
		Отбор = Новый Структура();
		Отбор.Вставить("Номенклатура", СтрЗапасы.Номенклатура);  

		Строки = ШтрихкодыНоменклатуры.НайтиСтроки(Отбор);
		Если Строки.Количество() > 0 Тогда
			СтрокаТовары.ean  	= Строки[0].Штрихкод;
			СтрокаТовары.size  	= Строки[0].Размер;
		КонецЕсли;
		
		СтрокаТовары.quantity = СтрЗапасы.Количество;
		Если ТипЗнч(Источник) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда 
			СтрокаТовары.price = СтрЗапасы.Цена; 
		Иначе
			СписокЦен = ПолучитьЦеныПоИнициаторОтправки(Источник);
			
			Отбор = Новый Структура();
			Отбор.Вставить("Номенклатура", СтрЗапасы.Номенклатура);  
			
			Строки = СписокЦен.НайтиСтроки(Отбор);
			Если Строки.Количество() > 0 Тогда
				СтрокаТовары.price  = Строки[0].Цена;
			КонецЕсли;
			
        КонецЕсли;
	КонецЦикла;
	Возврат Товары; 
	// ++ Терлецкий АВ 25.02.04
КонецФункции

Функция ЗаполнитьCписокТоваровРазмерРазмерИД(Запасы) 
	// ++ Терлецкий АВ 25.02.04
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	Запасы.Номенклатура КАК Номенклатура
			|ПОМЕСТИТЬ ВТТовары
			|ИЗ
			|	&Запасы КАК Запасы
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	НоменклатураДополнительныеРеквизиты.Ссылка КАК Ссылка,
			|	НоменклатураДополнительныеРеквизиты.Значение КАК Размер
			|ПОМЕСТИТЬ ВТРазмер
