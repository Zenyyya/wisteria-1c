#Область ПрограммныйИнтерфейс 

 // Функция - Сериализовать объект
 // 
 // Параметры:
 //  Источник Источник
 // 
 // Возвращаемое значение:
 //  Строка - Результат сериализации объекта.
 // Результат сериализации объекта.
Функция СериализоватьОбъект(Источник, ИнициаторОтправки) Экспорт 
	 ЗаписьXML = Неопределено;
	 
	 Если ТипЗнч(Источник) = Тип("СправочникСсылка.Номенклатура") Тогда   		 
		 ЗаписьXML = СериализоватьFE714(Источник, ИнициаторОтправки); 
	 ИначеЕсли ТипЗнч(Источник) = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда 
		 ЗаписьXML = СериализоватьFE720(Источник);
	 ИначеЕсли ТипЗнч(Источник) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда 
		 ЗаписьXML = СериализоватьFE720(Источник);
	 ИначеЕсли ТипЗнч(Источник) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда 
		 ЗаписьXML = СериализоватьWS_CreateOrder_b2b(Источник);

	 КонецЕсли;
	 
	 Возврат ЗаписьXML;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СериализоватьWS_CreateOrder_b2b(Источник) 
	Сериализация = Новый Структура("Строка, ОписаниеДанных, ОшибкаДанных, СтатусСообщения");
	Сериализация.Вставить("ОшибкаДанных", Ложь);
	ДанныеСериализации = Новый Структура;
    ОшибкаДанных = Ложь;
	
	Если ТипЗнч(Источник) <> Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда  
		Сериализация.Вставить("ОшибкаДанных", Истина);
		Возврат Сериализация;
	КонецЕсли;
	
	WSПрокси = спВзаимодействиеСПодключением.ПолучитьКоннектор(Перечисления.спТипыКоннекторов.SOAP);  
	
	ДанныеСериализации.Вставить("WSПрокси", WSПрокси); 
	Если WSПрокси = Неопределено Тогда 
		ДанныеСериализации.Вставить("WSПрокси", Ложь); 
		
		Сериализация.Вставить("ОшибкаДанных", Истина);
		Сериализация.Вставить("СтатусСообщения", Перечисления.спСтатусыСообщений.ОшибкаОбработки);	
		Сериализация.Вставить("ОписаниеДанных",  ДанныеСериализации); 
		Сериализация.Вставить("Строка",  Неопределено); 
		Возврат Сериализация;
    КонецЕсли;
	
	Попытка 
		ИнформацияОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Источник.Организация, , ТекущаяДатаСеанса(), Ложь);
		
		ДанныеСериализации.Вставить("WSПрокси", Истина);
		
		СвояФабрикаXDTO = WSПрокси.ФабрикаXDTO;  
		
		КорневойОбъект = СвояФабрикаXDTO.Создать(СвояФабрикаXDTO.Тип(ПространствоИмен(), "createOrder"));
		
		Service = Новый Структура;
		
		ТипЭлементаService = КорневойОбъект.Свойства().Получить("service").Тип; 	
		ServiceОбъект = СвояФабрикаXDTO.Создать(ТипЭлементаService);
		
		shopОбъект = СвояФабрикаXDTO.Создать(ServiceОбъект.Свойства().Получить("shop").Тип);
		shop = спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спshop");		
		shopОбъект = shop; 
		
		Если ЗначениеЗаполнено(XMLСтрока(shop)) Тогда 
			Service.Вставить("Shop", XMLСтрока(shop)); 
		Иначе 
			Service.Вставить("Shop", Ложь);
			ОшибкаДанных = Истина;
		КонецЕсли;
		
		tokenОбъект = СвояФабрикаXDTO.Создать(ServiceОбъект.Свойства().Получить("token").Тип);
		token = спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спtoken");
		tokenОбъект = token; 
		
		Если ЗначениеЗаполнено(XMLСтрока(token)) Тогда 
			Service.Вставить("Token", XMLСтрока(token)); 
		Иначе 
			Service.Вставить("Token", Ложь);
			ОшибкаДанных = Истина;
		КонецЕсли;

		
		ТДата = ТекущаяДатаСеанса();
		ТГод = Формат(ТДата, "ДФ=гггг");
		ТМесяц = Месяц(ТДата);
		ТДень =  День(ТДата);
		ТЧас =  Час(ТДата);
		ТМинута = Минута(ТДата);
		ТСекунда =  Секунда(ТДата); 
		
		МДата = СтрШаблон("P%1Y%2M%3DT%4H%5M%6S", ТГод, ТМесяц, ТДень, ТЧас, ТМинута, ТСекунда);
		
		messageDateОбъект = СвояФабрикаXDTO.Создать(ServiceОбъект.Свойства().Получить("messageDate").Тип);
		messageDateОбъект = МДата; 
		
		Если ЗначениеЗаполнено(XMLСтрока(МДата)) Тогда 
			Service.Вставить("MessageDate", XMLСтрока(МДата)); 
		Иначе 
			Service.Вставить("MessageDate", Ложь);
			ОшибкаДанных = Истина;
		КонецЕсли;

		
		УИД = Строка(Новый УникальныйИдентификатор());
		messageIDОбъект = СвояФабрикаXDTO.Создать(ServiceОбъект.Свойства().Получить("messageID").Тип);
		messageIDОбъект = УИД;
		
		Если ЗначениеЗаполнено(XMLСтрока(УИД)) Тогда 
			Service.Вставить("MessageID", XMLСтрока(УИД)); 
		Иначе 
			Service.Вставить("MessageID", Ложь);
			ОшибкаДанных = Истина;
		КонецЕсли;
		
		ServiceОбъект.shop = shopОбъект; 
		ServiceОбъект.token = tokenОбъект;
		ServiceОбъект.messageDate = messageDateОбъект;
		ServiceОбъект.messageID = messageIDОбъект;
		КорневойОбъект.service = ServiceОбъект;
		
		ДанныеСериализации.Вставить("Service", Service);
		
		Param = Новый Структура; 
		
		ТипЭлементаParam = КорневойОбъект.Свойства().Получить("param").Тип; 	
		ParamОбъект = СвояФабрикаXDTO.Создать(ТипЭлементаParam);
		
		orderTypeОбъект = СвояФабрикаXDTO.Создать(ParamОбъект.Свойства().Получить("orderType").Тип);
		orderType = ParamОбъект.Свойства().Получить("orderType").Тип.Фасеты.Получить(6); 
        ParamОбъект.Установить("orderType", orderType.Значение);  
		КорневойОбъект.param = ParamОбъект; 
		
		Если ЗначениеЗаполнено(XMLСтрока(orderType.Значение)) Тогда 
			Param.Вставить("OrderType", XMLСтрока(orderType.Значение)); 
		Иначе 
			Param.Вставить("OrderType", Ложь);	
			ОшибкаДанных = Истина;
		КонецЕсли;
		ДанныеСериализации.Вставить("Param", Param);
		
		ТипЭлементаVersion = КорневойОбъект.Свойства().Получить("version").Тип; 
		VersionType = ТипЭлементаVersion.Фасеты.Получить(0);
		VersionОбъект = СвояФабрикаXDTO.Создать(ТипЭлементаVersion);
		VersionОбъект = VersionType;
		КорневойОбъект.version = VersionОбъект.Значение; 
		

		Если ЗначениеЗаполнено(XMLСтрока(VersionType.Значение)) Тогда 
			ДанныеСериализации.Вставить("Version", XMLСтрока(VersionType.Значение)); 
		Иначе 
			ДанныеСериализации.Вставить("Version", Ложь);
			ОшибкаДанных = Истина;
		КонецЕсли;

		
		ТипЭлементаOrder = КорневойОбъект.Свойства().Получить("order").Тип; 	
		OrderОбъект = СвояФабрикаXDTO.Создать(ТипЭлементаOrder);
		
		paymentModeОбъект = СвояФабрикаXDTO.Создать(OrderОбъект.Свойства().Получить("paymentMode").Тип);
		paymentModeType = OrderОбъект.Свойства().Получить("paymentMode").Тип.Фасеты.Получить(0);
		paymentModeОбъект = paymentModeType;  
		OrderОбъект.Установить("paymentMode", paymentModeОбъект.Значение); 
		
		Order = Новый Структура;
		
		Если ЗначениеЗаполнено(XMLСтрока(paymentModeType.Значение)) Тогда 
			Order.Вставить("PaymentMode", XMLСтрока(paymentModeType.Значение)); 
		Иначе 
			Order.Вставить("PaymentMode", Ложь);
			ОшибкаДанных = Истина;
		КонецЕсли;
		
		// для тестовой среды:2501 
		carrierId = спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спSOAPУИДДоставщика");
		OrderОбъект.Установить("carrierId", carrierId);
		
		Если ЗначениеЗаполнено(XMLСтрока(carrierId)) Тогда 
			Order.Вставить("CarrierId", XMLСтрока(carrierId)); 
		Иначе 
			Order.Вставить("CarrierId", Ложь);
			ОшибкаДанных = Истина;
		КонецЕсли;
		

		
		Client = Новый Структура;
		
		EmailОрганизации = "";
		ТелефонОрганизации = ""; 
		Если ТипЗнч(ИнформацияОрганизации) = тиП("ТаблицаЗначений") Тогда 
			Для каждого Строка  Из ИнформацияОрганизации Цикл
				Если Строка.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации Тогда
					ТелефонОрганизации = СтрШаблон("%1", Строка.Представление);
				ИначеЕсли Строка.Вид = Справочники.ВидыКонтактнойИнформации.EmailОрганизации Тогда  
					EmailОрганизации = СтрШаблон("%1", Строка.Представление);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		clientОбъект = СвояФабрикаXDTO.Создать(OrderОбъект.Свойства().Получить("client").Тип);  
		customerFingerprintОбъект = СвояФабрикаXDTO.Создать(clientОбъект.Свойства().Получить("customerFingerprint").Тип);
		customerFingerprintОбъект.email 	= EmailОрганизации;
		customerFingerprintОбъект.id     	= "1"; 
		clientОбъект.customerFingerprint  	= customerFingerprintОбъект;  
		
		СustomerFingerprint = Новый Структура;
		Если ЗначениеЗаполнено(XMLСтрока(EmailОрганизации)) Тогда 
			СustomerFingerprint.Вставить("Email", XMLСтрока(EmailОрганизации)); 
		Иначе 
			СustomerFingerprint.Вставить("Email", Ложь);
			ОшибкаДанных = Истина;
		КонецЕсли;
        Client.Вставить("СustomerFingerprint", СustomerFingerprint);
		
		clientОбъект.phone              			= ТелефонОрганизации;
		clientОбъект.firstName          			= "администратор магазина";
		clientОбъект.secondName        				= "администратор магазина";
		clientОбъект.lastName           			= "администратор магазина";  
		OrderОбъект.Установить("client", clientОбъект);
		
		Если ЗначениеЗаполнено(XMLСтрока(ТелефонОрганизации)) Тогда 
			Client.Вставить("Phone", XMLСтрока(ТелефонОрганизации)); 
		Иначе 
			Client.Вставить("Phone", Ложь);
			ОшибкаДанных = Истина;
		КонецЕсли;
		Order.Вставить("Client", Client);
		
		ИнформацияСклад = Неопределено;
		ИнформацияОрганизацииСклад = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Источник.СтруктурнаяЕдиницаПолучатель, , ТекущаяДатаСеанса(), Ложь);
		Если ТипЗнч(ИнформацияОрганизацииСклад) = Тип("ТаблицаЗначений") И ИнформацияОрганизацииСклад.Количество() > 0 Тогда  
			ИнформацияСклад = _ПрочитатьJSON(ИнформацияОрганизацииСклад[0].Значение);
		КонецЕсли;
		ВидАдреса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Справочники.ВидыКонтактнойИнформации["ЮрАдресОрганизации"], "Ссылка");
		
		streetType = Неопределено;
		street = Неопределено;   
		
		Если ТипЗнч(ИнформацияСклад) = Тип("Структура") Тогда 
			
			deliveryAddressОбъект = СвояФабрикаXDTO.Создать(OrderОбъект.Свойства().Получить("deliveryAddress").Тип); 
			deliveryAddressОбъект.country = "RU";
			deliveryAddressОбъект.zip = ?(ИнформацияСклад.Свойство("ZIPcode"), ИнформацияСклад.ZIPcode, ""); 
			deliveryAddressОбъект.region = ?(ИнформацияСклад.Свойство("areaValue"), СокрЛП(СтрЗаменить(ИнформацияСклад.areaValue, "Город", "")), "");
			deliveryAddressОбъект.area   = "";
			deliveryAddressОбъект.city   = ?(ИнформацияСклад.Свойство("area"), ИнформацияСклад.area, ""); 
			
			streetType = ?(ИнформацияСклад.Свойство("streetType"),ИнформацияСклад.streetType, "");
			street = ?(ИнформацияСклад.Свойство("street"), ИнформацияСклад.street, "");
			
			deliveryAddressОбъект.street = СтрШаблон("%1 %2", streetType, street); 
			deliveryAddressОбъект.building = ?(ИнформацияСклад.Свойство("houseNumber"), ИнформацияСклад.houseNumber, "");
			deliveryAddressОбъект.frame = "";
			deliveryAddressОбъект.construction = "";
			deliveryAddressОбъект.flat = ""; 
			
			OrderОбъект.Установить("deliveryAddress", deliveryAddressОбъект); 
		КонецЕсли;
	 
		
		Если ТипЗнч(ИнформацияСклад) = Тип("Структура") Тогда
			DeliveryAddress = Новый Структура;
			DeliveryAddress.Вставить("country", "RU");  
			
			AddressZip = ?(ИнформацияСклад.Свойство("ZIPcode") И ЗначениеЗаполнено(ИнформацияСклад.ZIPcode), ИнформацияСклад.ZIPcode, Ложь);
			DeliveryAddress.Вставить("zip", AddressZip);  
			
			AddressAreaValue = ?(ИнформацияСклад.Свойство("areaValue") И ЗначениеЗаполнено(ИнформацияСклад.areaValue), ИнформацияСклад.areaValue, Ложь);
			DeliveryAddress.Вставить("region", AddressAreaValue); 
			
			DeliveryAddress.Вставить("area", "");  
			
			AddressCity = ?(ИнформацияСклад.Свойство("area") И ЗначениеЗаполнено(ИнформацияСклад.area), ИнформацияСклад.area, Ложь);
			DeliveryAddress.Вставить("city", AddressCity);
			
			AddressStreet = СтрШаблон("%1 %2", streetType, street); 
			AddressStreet = ?(ЗначениеЗаполнено(AddressStreet), AddressStreet, Ложь);
			DeliveryAddress.Вставить("street", AddressStreet);
			
			AddressBuilding = ?(ИнформацияСклад.Свойство("houseNumber") И ЗначениеЗаполнено(ИнформацияСклад.houseNumber), ИнформацияСклад.houseNumber, Ложь);
			DeliveryAddress.Вставить("building", AddressBuilding); 
			
			DeliveryAddress.Вставить("frame", "");
			DeliveryAddress.Вставить("construction", "");
			DeliveryAddress.Вставить("flat", "");

			
			Order.Вставить("DeliveryAddress", DeliveryAddress); 
			
			Если AddressZip = Ложь ИЛИ AddressAreaValue = Ложь ИЛИ AddressCity = Ложь ИЛИ AddressStreet = Ложь 
				ИЛИ AddressBuilding = Ложь Тогда
				ОшибкаДанных = Истина;
			КонецЕсли;
		Иначе 
			Order.Вставить("DeliveryAddress", Ложь);
			ОшибкаДанных = Истина;
		КонецЕсли; 
		
		Items = Новый Массив;
		
		
		itemsОбъект = СвояФабрикаXDTO.Создать(OrderОбъект.Свойства().Получить("items").Тип);
		ТипЭлементаСписка = itemsОбъект.Свойства().Получить("item").Тип; 
		
		РезультатЗапросаЦеныШтрихкодНоменклатуры = ПолучитьЦеныШтрихкодаНоменклатурыХарактеристики(Источник.Запасы.Выгрузить(,"Номенклатура")); // ++ Терлецкий АВ 25.01.21 
		
		РезультатЗапросаРазмер = ЗаполнитьCписокТоваровРазмерРазмерИД(Источник.Запасы.Выгрузить(,"Номенклатура")); // Терлецкий АВ 25.02.04
				
		Для Каждого ЭлементЗапас Из Источник.Запасы Цикл
			Item = Новый Структура("Uuid, Size, Quantity, Price, Ean");  // ++ Терлецкий АВ 25.01.30
			
			itemОбъект =  itemsОбъект.item.Добавить(СвояФабрикаXDTO.Создать(ТипЭлементаСписка));
			
			ГУИДНоменклатура = ЭлементЗапас.Номенклатура.УникальныйИдентификатор(); 
			itemОбъект.uuid  = Строка(ГУИДНоменклатура);
			
			itemОбъект.quantity = ЭлементЗапас.Количество;   
			itemОбъект.customerCompany = shop; 
			
			// ++ Терлецкий АВ 25.01.30
			ГУИДХарактеристика = Неопределено;
			ПараметрыПоиска = Новый Структура("Номенклатура", ЭлементЗапас.Номенклатура);
			МассивСтрок = РезультатЗапросаРазмер.НайтиСтроки(ПараметрыПоиска);
			Если МассивСтрок.Количество() > 0 Тогда
				ГУИДХарактеристика = XMLСтрока(МассивСтрок[0].SizeId);   
				Если ЗначениеЗаполнено(ГУИДХарактеристика) Тогда
					itemОбъект.size = XMLСтрока(ГУИДХарактеристика);
				Иначе 
					ГУИДХарактеристика = XMLСтрока(ГУИДНоменклатура); 
					itemОбъект.size = ГУИДХарактеристика; 
				КонецЕсли;		
			КонецЕсли;
            // -- Терлецкий АВ 25.01.30
			
			Если ЗначениеЗаполнено(XMLСтрока(ГУИДНоменклатура)) Тогда 
				Item.Вставить("Uuid", XMLСтрока(ГУИДНоменклатура)); // ++ Терлецкий АВ 25.01.21 
			Иначе 
				Item.Вставить("Uuid", Ложь);
				ОшибкаДанных = Истина;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(XMLСтрока(ГУИДХарактеристика)) Тогда 
				Item.Вставить("Size", XMLСтрока(ГУИДХарактеристика)); 
			Иначе 
				Item.Вставить("Size", Ложь);
				ОшибкаДанных = Истина;
			КонецЕсли;
			
			Если ЭлементЗапас.Количество > 0 Тогда 
				Item.Вставить("Quantity", ЭлементЗапас.Количество); 
			Иначе 
				Item.Вставить("Quantity", Ложь);
				ОшибкаДанных = Истина;
			КонецЕсли;
			
			
			// ++ Терлецкий АВ 25.01.21
			PriceItem = 0;
			Если РезультатЗапросаЦеныШтрихкодНоменклатуры.Свойство("Цены") Тогда 
				Отбор = Новый Структура();
				Отбор.Вставить("Номенклатура", ЭлементЗапас.Номенклатура);
				Строки = РезультатЗапросаЦеныШтрихкодНоменклатуры.Цены.НайтиСтроки(Отбор);
				
				Если Строки.Количество() > 0 Тогда
					itemОбъект.price = Строки[0].Цена;
					PriceItem = Строки[0].Цена;
				Иначе
					itemОбъект.price = 0;
				КонецЕсли;
			Иначе 
				itemОбъект.price = 0; 
			КонецЕсли; 
			
			Если PriceItem > 0 Тогда 
				Item.Вставить("Price", XMLСтрока(PriceItem)); 
			Иначе 
				Item.Вставить("Price", Ложь);
				ОшибкаДанных = Истина;
			КонецЕсли;

			EanItem = "";
			Если РезультатЗапросаЦеныШтрихкодНоменклатуры.Свойство("Штрихкода") Тогда 
				Отбор = Новый Структура();
				Отбор.Вставить("Номенклатура", ЭлементЗапас.Номенклатура);
				Строки = РезультатЗапросаЦеныШтрихкодНоменклатуры.Штрихкода.НайтиСтроки(Отбор);
				
				Если Строки.Количество() > 0 Тогда
					itemОбъект.ean = Строка(Строки[0].Штрихкод);
					EanItem = Строка(Строки[0].Штрихкод);
				Иначе
					itemОбъект.ean = "";	
				КонецЕсли;
			Иначе 
				itemОбъект.ean = "";
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(EanItem) Тогда 
				Item.Вставить("Ean", XMLСтрока(EanItem)); 
			Иначе 
				Item.Вставить("Ean", Ложь);
				ОшибкаДанных = Истина;
			КонецЕсли;
			
			Items.Добавить(Item); 
			// -- Терлецкий АВ 25.01.21
		КонецЦикла;
		
		Order.Вставить("Items", Items);
        ДанныеСериализации.Вставить("Order", Order);
		
		OrderОбъект.Установить("items", itemsОбъект); 
				
		orderFingerprintОбъект = СвояФабрикаXDTO.Создать(OrderОбъект.Свойства().Получить("orderFingerprint").Тип);
		orderFingerprintОбъект.orderId = Строка(Источник.УникальныйИдентификатор());
		orderFingerprintОбъект.orderNumber = Источник.Номер;
		
		OrderОбъект.Установить("orderFingerprint", orderFingerprintОбъект);  
		
		commentОбъект = СвояФабрикаXDTO.Создать(OrderОбъект.Свойства().Получить("comment").Тип);
		commentОбъект = "";
		
		OrderОбъект.Установить("comment", commentОбъект);  
		
		AddFields = Новый Структура("legalReciever, legalRecieverAddress, legalRecieverINN, legalRecieverKPP");
		
		addFieldsОбъект = СвояФабрикаXDTO.Создать(OrderОбъект.Свойства().Получить("addFields").Тип);
		ТипЭлементаСписка = addFieldsОбъект.Свойства().Получить("field").Тип; 
		 
		ФактическаяИнформация = "";
		ЮридическийАдрес      = "";

		Для каждого Строка  Из ИнформацияОрганизации Цикл
			Если Строка.Вид = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации Тогда
				ЮридическийАдрес = Строка.Представление;
			ИначеЕсли Строка.Вид = Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации Тогда  
				ФактическаяИнформация = СтрШаблон("%1 / %2", Источник.Организация.Наименование, Строка.Представление);
			КонецЕсли;
		КонецЦикла; 
		
		addFieldОбъект =  addFieldsОбъект.field.Добавить(СвояФабрикаXDTO.Создать(ТипЭлементаСписка)); 
		addFieldОбъект.name  = "legalReciever";
		addFieldОбъект.value = Источник.Организация.НаименованиеСокращенное; 
		
		Если ЗначениеЗаполнено(Источник.Организация.НаименованиеСокращенное) Тогда 
			AddFields.Вставить("LegalReciever", Источник.Организация.НаименованиеСокращенное); 
		Иначе 
			AddFields.Вставить("LegalReciever", Ложь);
			ОшибкаДанных = Истина;
		КонецЕсли;

		addFieldОбъект =  addFieldsОбъект.field.Добавить(СвояФабрикаXDTO.Создать(ТипЭлементаСписка)); 
		addFieldОбъект.name  = "legalRecieverAddress";
        addFieldОбъект.value = ЮридическийАдрес; 
		
		Если ЗначениеЗаполнено(ЮридическийАдрес) Тогда 
			AddFields.Вставить("legalRecieverAddress", ЮридическийАдрес); 
		Иначе 
			AddFields.Вставить("legalRecieverAddress", Ложь);
			ОшибкаДанных = Истина;
		КонецЕсли;

		
		addFieldОбъект =  addFieldsОбъект.field.Добавить(СвояФабрикаXDTO.Создать(ТипЭлементаСписка)); 
		addFieldОбъект.name  = "legalRecieverINN";
        addFieldОбъект.value = Строка(Источник.Организация.ИНН); 
		
		Если ЗначениеЗаполнено(XMLСтрока(Источник.Организация.ИНН)) Тогда 
			AddFields.Вставить("legalRecieverINN", XMLСтрока(Источник.Организация.ИНН)); 
		Иначе 
			AddFields.Вставить("legalRecieverINN", Ложь);
			ОшибкаДанных = Истина;
		КонецЕсли;

		addFieldОбъект =  addFieldsОбъект.field.Добавить(СвояФабрикаXDTO.Создать(ТипЭлементаСписка)); 
		addFieldОбъект.name  = "legalRecieverKPP";
        addFieldОбъект.value = Строка(Источник.Организация.КПП); 
		
		Если ЗначениеЗаполнено(XMLСтрока(Источник.Организация.КПП)) Тогда 
			AddFields.Вставить("legalRecieverKPP", XMLСтрока(Источник.Организация.КПП)); 
		Иначе 
			AddFields.Вставить("legalRecieverKPP", Ложь);
			ОшибкаДанных = Истина;
		КонецЕсли;
		
		ДанныеСериализации.Вставить("AddFields", AddFields);
		
		OrderОбъект.Установить("addFields", addFieldsОбъект);
		
		КорневойОбъект.order = OrderОбъект; 
		
		Сериализация.Вставить("ОписаниеДанных",  ДанныеСериализации); 
		Сериализация.Вставить("СтатусСообщения", ПредопределенноеЗначение("Перечисление.спСтатусыСообщений.Новое")); 
		Сериализация.Вставить("ОшибкаДанных", ОшибкаДанных);

	Исключение
		Сериализация.Вставить("ОшибкаДанных", ОшибкаДанных);
		Сериализация.Вставить("СтатусСообщения", Перечисления.спСтатусыСообщений.НеВалидно);	

		Возврат Сериализация;
	КонецПопытки;

	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку(); 
	
	СвояФабрикаXDTO.ЗаписатьXML(Запись, КорневойОбъект);
	СтрокаXML = Запись.Закрыть(); 
	
	Сериализация.Вставить("Строка", СтрокаXML);

	Возврат Сериализация;
КонецФункции

Функция ПолучитьЦеныШтрихкодаНоменклатурыХарактеристики(СтписокНоменклатуры) 
	// ++ Терлецкий АВ 25.01.21
	ВидЦеныПоступления = спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спВидЦеныПоступления");
	
	ЦеныНоменклатуры = Новый ТаблицаЗначений;
	ЦеныНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	КвалификаторыЧисла = Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный);
	ЦеныНоменклатуры.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", КвалификаторыЧисла));  
	
	ШтрихКодНоменклатуры = Новый ТаблицаЗначений;
	ШтрихКодНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	КвалификаторыСтроки = Новый КвалификаторыСтроки(200);
	ШтрихКодНоменклатуры.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка", КвалификаторыСтроки));
	
	РезультатЗапроса = Новый Структура("Цены, Штрихкода");
	
	Запрос = Новый Запрос; 
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоменклатураХарактеристика.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ ВТ_НоменклатураХарактеристика
		|ИЗ
		|	&НоменклатураХарактеристика КАК НоменклатураХарактеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
		|ПОМЕСТИТЬ ВТ_ЦеныНоменклатурыСрезПоследних
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			&ТекущаяДата,
		|			Номенклатура В
		|					(ВЫБРАТЬ
		|						ВТ.Номенклатура КАК Номенклатура
		|					ИЗ
		|						ВТ_НоменклатураХарактеристика КАК ВТ)
		|				И %1) КАК ЦеныНоменклатурыСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_НоменклатураХарактеристика.Номенклатура КАК Номенклатура,
		|	ВТ_ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
		|ИЗ
		|	ВТ_НоменклатураХарактеристика КАК ВТ_НоменклатураХарактеристика
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ЦеныНоменклатурыСрезПоследних КАК ВТ_ЦеныНоменклатурыСрезПоследних
		|		ПО ВТ_НоменклатураХарактеристика.Номенклатура = ВТ_ЦеныНоменклатурыСрезПоследних.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_НоменклатураХарактеристика.Номенклатура КАК Номенклатура,
		|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод
		|ИЗ
		|	ВТ_НоменклатураХарактеристика КАК ВТ_НоменклатураХарактеристика
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		|		ПО ВТ_НоменклатураХарактеристика.Номенклатура = ШтрихкодыНоменклатуры.Номенклатура";
	
	Запрос.УстановитьПараметр("НоменклатураХарактеристика", СтписокНоменклатуры);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	Если ЗначениеЗаполнено(ВидЦеныПоступления) Тогда
		Запрос.Текст = СтрШаблон(Запрос.Текст, "ВидЦен = &ВидЦен");
		Запрос.УстановитьПараметр("ВидЦен", ВидЦеныПоступления);
	Иначе 
		Запрос.Текст = СтрШаблон(Запрос.Текст, "ИСТИНА = ИСТИНА");
	КонецЕсли;


	
	Пакет = Запрос.ВыполнитьПакет();
	
	ВыборкаПакетЦены = Пакет[2].Выбрать();
	Если ЗначениеЗаполнено(ВидЦеныПоступления) Тогда
		Пока ВыборкаПакетЦены.Следующий() Цикл
			НоваяСтрока = ЦеныНоменклатуры.Добавить();
			НоваяСтрока.Номенклатура 	= ВыборкаПакетЦены.Номенклатура;
			НоваяСтрока.Цена            = ВыборкаПакетЦены.Цена;
			
		КонецЦикла;
	КонецЕсли;

	ВыборкаПакетШтрихкод = Пакет[3].Выбрать();
	Пока ВыборкаПакетШтрихкод.Следующий() Цикл
		НоваяСтрока = ШтрихКодНоменклатуры.Добавить();
		НоваяСтрока.Номенклатура 	= ВыборкаПакетШтрихкод.Номенклатура;
		НоваяСтрока.Штрихкод        = ВыборкаПакетШтрихкод.Штрихкод;
	КонецЦикла;
	
	РезультатЗапроса.Вставить("Цены", ЦеныНоменклатуры);
	РезультатЗапроса.Вставить("Штрихкода", ШтрихКодНоменклатуры);
	
	Возврат РезультатЗапроса;  
	// -- Терлецкий АВ 25.01.21
КонецФункции

Функция _ПрочитатьJSON(ТекстJSON) Экспорт
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Структура = ЗаполнитьСтруктуруИзОтветаJSON(Чтение);	
	Чтение.Закрыть();
	Возврат Структура;
КонецФункции 

Функция ЗаполнитьСтруктуруИзОтветаJSON(Знач Чтение) Экспорт
	Результат = Новый Структура;

	ПоследнееИмяРеквизита = Неопределено;
	
	Пока Чтение.Прочитать() Цикл
		Тип = Чтение.ТипТекущегоЗначения;
		Если Тип = ТипЗначенияJSON.НачалоОбъекта И ПоследнееИмяРеквизита<>Неопределено Тогда 
			Результат[ПоследнееИмяРеквизита] = ЗаполнитьСтруктуруИзОтветаJSON(Чтение);
		ИначеЕсли Тип = ТипЗначенияJSON.КонецОбъекта Тогда 
			Возврат Результат;
			ПоследнееИмяРеквизита = Неопределено;
		ИначеЕсли Тип = ТипЗначенияJSON.ИмяСвойства Тогда 
			Результат.Вставить(Чтение.ТекущееЗначение, Неопределено);
			ПоследнееИмяРеквизита = Чтение.ТекущееЗначение;
		ИначеЕсли Тип = ТипЗначенияJSON.Булево или Тип = ТипЗначенияJSON.Строка
			или Тип = ТипЗначенияJSON.Число или Тип = ТипЗначенияJSON.Null Тогда 
			Результат[ПоследнееИмяРеквизита] = Чтение.ТекущееЗначение;
		ИначеЕсли Тип = ТипЗначенияJSON.НачалоМассива Тогда 
			Результат[ПоследнееИмяРеквизита] = ЗаполнитьМассивИзОтветаJSON(Чтение);
		КонецЕсли;
	КонецЦикла;  
		
	Возврат Результат;
КонецФункции 

Функция ЗаполнитьМассивИзОтветаJSON(Знач Чтение)
	Результат = Новый Массив;
	
	Пока Чтение.Прочитать() Цикл
		Тип = Чтение.ТипТекущегоЗначения;
		Если Тип = ТипЗначенияJSON.НачалоОбъекта Тогда 
			Результат.Добавить(ЗаполнитьСтруктуруИзОтветаJSON(Чтение));
		ИначеЕсли Тип = ТипЗначенияJSON.КонецМассива Тогда 
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;  
	
	Возврат Результат;
КонецФункции

Функция ПространствоИмен()
    Возврат спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спSOAPПространстваИменСервиса")
