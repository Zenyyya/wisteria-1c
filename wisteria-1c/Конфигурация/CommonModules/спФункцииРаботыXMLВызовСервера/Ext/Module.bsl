Функция СериализоватьFE714(Источник, ИнициаторОтправки)  

	Если ТипЗнч(Источник) <> Тип("СправочникСсылка.Номенклатура") Тогда  
		Возврат "";
	КонецЕсли;
	
	ОшибкаДанных = Ложь;
	
	Сериализация = Новый Структура("Строка, ОписаниеДанных, ОшибкаДанных, СтатусСообщения");
	
	ДанныеСериализации = Новый Структура;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("UTF-8"); 
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("productMasterDataRequest");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xs", "http://www.w3.org/2001/XMLSchema");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("", "http://service.profashionsolutions.ru/fe714_r002");
	ЗаписьXML.ЗаписатьНачалоЭлемента("main");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("parents");
	ЗаписьXML.ЗаписатьКонецЭлемента(); 
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("typesItems");
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	Цены = Новый Массив;
	
	ВидЦеныПоступления = спРаботаСКонстантами.ПолучитьЗначениеКонстанты("спВидЦеныПоступления"); 
		
	ТипЦены = Новый Структура("ГУИД, Наименование, Валюта, ВалютаКод, ВалютаНаименование");
	ТипЦены.Вставить("ГУИД", ВидЦеныПоступления.УникальныйИдентификатор());
	ТипЦены.Вставить("Наименование", ВидЦеныПоступления.Наименование);
	ТипЦены.Вставить("Валюта", ВидЦеныПоступления.ВалютаЦены);
	ТипЦены.Вставить("КодВалюты", ВидЦеныПоступления.ВалютаЦены.Код);
	ТипЦены.Вставить("НаименованиеВалюты", ВидЦеныПоступления.ВалютаЦены.Наименование);

	ЗаписьXML.ЗаписатьНачалоЭлемента("prices"); 

	Если ЗначениеЗаполнено(ВидЦеныПоступления) И ТипЗнч(ВидЦеныПоступления) = Тип("СправочникСсылка.ВидыЦен") Тогда 
			ЗаписьXML.ЗаписатьНачалоЭлемента("price"); 
			
			Цена = Новый Структура;
			Если ЗначениеЗаполнено(ТипЦены.ГУИД) Тогда 
				ЗаписьXML.ЗаписатьАтрибут("id", XMLСтрока(ТипЦены.ГУИД));
				Цена.Вставить("Гуид", XMLСтрока(ТипЦены.ГУИД))
			Иначе 
				Цена.Вставить("Гуид", Ложь);
				ОшибкаДанных = Истина;
			КонецЕсли;
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("name"); 
			Если ЗначениеЗаполнено(ТипЦены.Наименование) Тогда 
				ЗаписьXML.ЗаписатьТекст(XMLСтрока(ТипЦены.Наименование)); 
				Цена.Вставить("Наименование", XMLСтрока(ТипЦены.Наименование));
			Иначе 
				Цена.Вставить("Наименование", Ложь);
				ОшибкаДанных = Истина;
			КонецЕсли;
			ЗаписьXML.ЗаписатьКонецЭлемента();  
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("currency"); 
			Если ТипЦены.КодВалюты = "643" Тогда
				ЗаписьXML.ЗаписатьТекст(XMLСтрока("RUB")); 
				currency = XMLСтрока("RUB");
			Иначе 
