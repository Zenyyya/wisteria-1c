Функция ПрефиксШтрихкодаЯчейки() Экспорт

	Возврат "CE-";

КонецФункции

Процедура ЗаполнитьЯчейкиВТЧПоОстаткам(Запасы, Организация, Склад, ТипДокумента = Неопределено) Экспорт
	
	// { Иванов С.С. (TNext) - 04.03.2025 - Задача №1000 
	РаспределяемыеЗапасы = Запасы.СкопироватьКолонки();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса(ТипДокумента);
	
	Запрос.УстановитьПараметр("ТаблицаЗапасы", Запасы);
	Запрос.УстановитьПараметр("ДатаПолученияОстатков", ТекущаяДатаСеанса()); // Возможно, надо переделать на дату документа?
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСтроки = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСтроки.Следующий() Цикл
		
		Индекс = ИндексСтроки(РаспределяемыеЗапасы, ВыборкаСтроки);
				
		КоличествоКРаспределению = ВыборкаСтроки.Количество;
			
		Выборка = ВыборкаСтроки.Выбрать();
		
		ДобавитьВТекущую = Истина;
		
		Пока Выборка.Следующий() И КоличествоКРаспределению > 0 Цикл
			
			Если Не ЗначениеЗаполнено(Выборка.Ячейка) Тогда
				Продолжить;
			КонецЕсли;
			
			КоличествоРаспределено = Мин(КоличествоКРаспределению, Выборка.ОстатокВЯчейке);
			
			Строка = ДобавитьСтроку(РаспределяемыеЗапасы, ВыборкаСтроки, Индекс, ТипДокумента);
			
			ПересчитатьСтроку(Строка, ВыборкаСтроки, Выборка.Ячейка, КоличествоРаспределено, ТипДокумента);
			
			КоличествоКРаспределению = КоличествоКРаспределению - КоличествоРаспределено;
			
		КонецЦикла;
		
		Если КоличествоКРаспределению > 0 Тогда
			
			Строка = ДобавитьСтроку(РаспределяемыеЗапасы, ВыборкаСтроки, Индекс, ТипДокумента);
				
			ПересчитатьСтроку(Строка, ВыборкаСтроки, Справочники.Ячейки.ПустаяСсылка(), КоличествоКРаспределению, ТипДокумента);
		
		КонецЕсли;
		             
	КонецЦикла;
	
	Запасы = РаспределяемыеЗапасы; 
	// }
	
КонецПроцедуры

Функция ЕстьЯчейки(СтруктурнаяЕдиница) Экспорт

	// { Иванов С.С. (TNext) - 04.03.2025 - Задача №1000 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Ячейки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Ячейки КАК Ячейки
		|ГДЕ
		|	Ячейки.Владелец = &Склад";
	
	Запрос.УстановитьПараметр("Склад", СтруктурнаяЕдиница);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат Ложь;
		
	Иначе
		
		Возврат Истина;
		
	КонецЕсли; 
	// }
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИндексСтроки(РаспределяемыеЗапасы, ВыборкаСтроки)

	// { Иванов С.С. (TNext) - 04.03.2025 - Задача №1000 
	Фильтр = Новый Структура("НомерСтроки", ВыборкаСтроки.НомерСтроки);
	НайденныеСтроки = РаспределяемыеЗапасы.НайтиСтроки(Фильтр);
	
	Если НайденныеСтроки.Количество() = 0 Тогда 
		Индекс = Неопределено;
	Иначе
		НайденнаяСтрока = НайденныеСтроки[0]; // Может быть найдена только одна строка
		Индекс = РаспределяемыеЗапасы.Индекс(НайденнаяСтрока);
	КонецЕсли;
	
	Возврат Индекс;
	// }
	
КонецФункции

Функция ДобавитьСтроку(РаспределяемыеЗапасы, ВыборкаСтроки, Индекс, ТипДокумента)
	
	// { Иванов С.С. (TNext) - 04.03.2025 - Задача №1000 
	Если Индекс = Неопределено Тогда
		Строка = РаспределяемыеЗапасы.Добавить();
	Иначе
		Строка = РаспределяемыеЗапасы.Вставить(Индекс); 
	КонецЕсли;
	
	Если ТипДокумента = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
		ИсключаемыеКолонки = "НомерСтроки, Количество, Сумма, СуммаНДС, Всего, СуммаСкидкиНаценки, Ячейка, Вес, Объем";
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПеремещениеПоЯчейкам") Тогда
		ИсключаемыеКолонки = "НомерСтроки, Количество, Ячейка,";
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Строка, ВыборкаСтроки,, ИсключаемыеКолонки); 
	
    Возврат Строка;
	// }
	
КонецФункции

Процедура ПересчитатьСтроку(Строка, ВыборкаСтроки, Ячейка, Количество, ТипДокумента)
	
	// { Иванов С.С. (TNext) - 04.03.2025 - Задача №1000 
	Строка.Количество = Количество;
	Строка.Ячейка = Ячейка; 
	
	Если ТипДокумента = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
		
		Строка.Сумма = Строка.Цена * Строка.Количество;
		Строка.СуммаНДС = Строка.Сумма * ВыборкаСтроки.Ставка / (100 + ВыборкаСтроки.Ставка); // Сумма включает НДС
		Строка.Всего = Строка.Сумма; // Сумма включает НДС
		Строка.СуммаСкидкиНаценки = Строка.Сумма * ВыборкаСтроки.ПроцентСкидкиНаценки / 100;
		Строка.Вес = Строка.Количество * ВыборкаСтроки.Вес / ВыборкаСтроки.Количество; 
		Строка.Объем = Строка.Количество * ВыборкаСтроки.Объем / ВыборкаСтроки.Количество;  
		
	КонецЕсли;
	// }

КонецПроцедуры

Функция ТекстЗапроса(ТипДокумента)
	
	ТекстЗапроса = "";
	
	Если ТипДокумента = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
		
		ТекстЗапроса = ТекстЗапросаДляПеремещенияЗапасов();
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПеремещениеПоЯчейкам") Тогда
		
		ТекстЗапроса = ТекстЗапросаДляПеремещенияПоЯчейкам();
		
	Иначе
		
		ВызватьИсключение НСтр("ru = 'Функционал не адаптирован под данный тип документа.'");
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;

КонецФункции

