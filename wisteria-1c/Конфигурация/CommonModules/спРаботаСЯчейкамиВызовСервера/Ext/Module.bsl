	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиНаЯчейках КАК ВТ_ОстаткиНаЯчейках
	|		ПО ВТ_СгруппированныеЗапасы.Номенклатура = ВТ_ОстаткиНаЯчейках.Номенклатура
	|			И ВТ_СгруппированныеЗапасы.Характеристика = ВТ_ОстаткиНаЯчейках.Характеристика
	|			И ВТ_СгруппированныеЗапасы.Партия = ВТ_ОстаткиНаЯчейках.Партия
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки,
	|	Ячейка УБЫВ
	|ИТОГИ
	|	МАКСИМУМ(Номенклатура),
	|	МАКСИМУМ(Характеристика),
	|	МАКСИМУМ(Партия),
	|	МАКСИМУМ(СерииНоменклатуры),
	|	МАКСИМУМ(Количество),
	|	МАКСИМУМ(Резерв),
	|	МАКСИМУМ(ЕдиницаИзмерения),
	|	МАКСИМУМ(ЗаказПокупателя),
	|	МАКСИМУМ(Себестоимость),
	|	МАКСИМУМ(Сумма),
	|	МАКСИМУМ(КлючСвязи),
	|	МАКСИМУМ(СтранаПроисхождения),
	|	МАКСИМУМ(НомерГТД),
	|	МАКСИМУМ(Проект),
	|	МАКСИМУМ(ПрослеживаемыйТовар),
	|	МАКСИМУМ(ПрослеживаемыйКомплект),
	|	МАКСИМУМ(УчитыватьВНУ),
	|	МАКСИМУМ(ЯчейкаДокумента),
	|	МАКСИМУМ(ЯчейкаПолучатель),
	|	МАКСИМУМ(Вес),
	|	МАКСИМУМ(Объем),
	|	МАКСИМУМ(Цена),
	|	МАКСИМУМ(СтавкаНДС),
	|	МАКСИМУМ(СуммаНДС),
	|	МАКСИМУМ(Всего),
	|	МАКСИМУМ(ПроцентСкидкиНаценки),
	|	МАКСИМУМ(СуммаСкидкиНаценки),
	|	МАКСИМУМ(Ставка)
	|ПО
	|	НомерСтроки";
	#КонецОбласти	

	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаДляПеремещенияПоЯчейкам()
	
	ТекстЗапроса = 
	
	#Область ТекстЗапроса
	"ВЫБРАТЬ
	|	ПеремещениеЗапасовЗапасы.НомерСтроки КАК НомерСтроки,
	|	ПеремещениеЗапасовЗапасы.Номенклатура КАК Номенклатура,
	|	ПеремещениеЗапасовЗапасы.Характеристика КАК Характеристика,
	|	ПеремещениеЗапасовЗапасы.Партия КАК Партия,
	|	ПеремещениеЗапасовЗапасы.СерииНоменклатуры КАК СерииНоменклатуры,
	|	ПеремещениеЗапасовЗапасы.Количество КАК Количество,
	|	ПеремещениеЗапасовЗапасы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ПеремещениеЗапасовЗапасы.КлючСвязи КАК КлючСвязи,
	|	ПеремещениеЗапасовЗапасы.Ячейка КАК Ячейка
	|ПОМЕСТИТЬ ВТ_Запасы
	|ИЗ
	|	&ТаблицаЗапасы КАК ПеремещениеЗапасовЗапасы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Запасы.Номенклатура КАК Номенклатура,
	|	ВТ_Запасы.Характеристика КАК Характеристика,
	|	ВТ_Запасы.Партия КАК Партия,
	|	ВТ_Запасы.СерииНоменклатуры КАК СерииНоменклатуры,
	|	СУММА(ВТ_Запасы.Количество) КАК Количество,
	|	ВТ_Запасы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_Запасы.КлючСвязи КАК КлючСвязи,
	|	МАКСИМУМ(ВТ_Запасы.Ячейка) КАК Ячейка,
	|	МИНИМУМ(ВТ_Запасы.НомерСтроки) КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_СгруппированныеЗапасы
	|ИЗ
	|	ВТ_Запасы КАК ВТ_Запасы
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Запасы.Номенклатура,
	|	ВТ_Запасы.Характеристика,
	|	ВТ_Запасы.Партия,
	|	ВТ_Запасы.СерииНоменклатуры,
	|	ВТ_Запасы.ЕдиницаИзмерения,
	|	ВТ_Запасы.КлючСвязи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗапасыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ЗапасыНаСкладахОстатки.Характеристика КАК Характеристика,
	|	ЗапасыНаСкладахОстатки.Партия КАК Партия,
	|	ЗапасыНаСкладахОстатки.Ячейка КАК Ячейка,
	|	ЗапасыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТ_ОстаткиНаЯчейках
	|ИЗ
	|	РегистрНакопления.ЗапасыНаСкладах.Остатки(
	|			&ДатаПолученияОстатков,
	|			Организация = &Организация
	|				И СтруктурнаяЕдиница = &СтруктурнаяЕдиница
	|				И (Номенклатура, Характеристика, Партия) В
	|					(ВЫБРАТЬ
	|						ВТ_Запасы.Номенклатура КАК Номенклатура,
	|						ВТ_Запасы.Характеристика КАК Характеристика,
	|						ВТ_Запасы.Партия КАК Партия
	|					ИЗ
	|						ВТ_Запасы КАК ВТ_Запасы)) КАК ЗапасыНаСкладахОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СгруппированныеЗапасы.Номенклатура КАК Номенклатура,
	|	ВТ_СгруппированныеЗапасы.Характеристика КАК Характеристика,
	|	ВТ_СгруппированныеЗапасы.Партия КАК Партия,
	|	ВТ_СгруппированныеЗапасы.СерииНоменклатуры КАК СерииНоменклатуры,
	|	ВТ_СгруппированныеЗапасы.Количество КАК Количество,
	|	ВТ_СгруппированныеЗапасы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_СгруппированныеЗапасы.КлючСвязи КАК КлючСвязи,
	|	ВТ_СгруппированныеЗапасы.Ячейка КАК ЯчейкаДокумента,
	|	ЕСТЬNULL(ВТ_ОстаткиНаЯчейках.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) КАК Ячейка,
	|	ЕСТЬNULL(ВТ_ОстаткиНаЯчейках.КоличествоОстаток, 0) КАК ОстатокВЯчейке,
	|	ВТ_СгруппированныеЗапасы.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ВТ_СгруппированныеЗапасы КАК ВТ_СгруппированныеЗапасы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиНаЯчейках КАК ВТ_ОстаткиНаЯчейках
	|		ПО ВТ_СгруппированныеЗапасы.Номенклатура = ВТ_ОстаткиНаЯчейках.Номенклатура
	|			И ВТ_СгруппированныеЗапасы.Характеристика = ВТ_ОстаткиНаЯчейках.Характеристика
	|			И ВТ_СгруппированныеЗапасы.Партия = ВТ_ОстаткиНаЯчейках.Партия
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки,
	|	Ячейка УБЫВ
	|ИТОГИ
	|	МАКСИМУМ(Номенклатура),
	|	МАКСИМУМ(Характеристика),
	|	МАКСИМУМ(Партия),
	|	МАКСИМУМ(СерииНоменклатуры),
	|	МАКСИМУМ(Количество),
	|	МАКСИМУМ(ЕдиницаИзмерения),
	|	МАКСИМУМ(КлючСвязи),
	|	МАКСИМУМ(ЯчейкаДокумента)
	|ПО
	|	НомерСтроки";
	#КонецОбласти	

	Возврат ТекстЗапроса;

КонецФункции

#КонецОбласти

