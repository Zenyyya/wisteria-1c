Процедура ОчиститьДополнительныйРеквизит(Источник, Наименование)  
	
	ДополнительнйРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(Наименование, Истина);
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Свойство", ДополнительнйРеквизит);
	
	Массив = Источник.ДополнительныеРеквизиты.НайтиСтроки(ПараметрыОтбора);
	Для Каждого ЭлементМассива из Массив Цикл 
		ЭлементМассива.Значение = Справочники.ЗначенияСвойствОбъектов.ПустаяСсылка();
	КонецЦикла;  
	
КонецПроцедуры 

Процедура ЗаписатьСвойстваУОбъекта(Источник, ТЗДополнительныеРеквизиты) 
	
	ТаблицаДопРеквизитов = Новый ТаблицаЗначений;
	ТаблицаДопРеквизитов.Колонки.Добавить("Свойство", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"));
	ТаблицаДопРеквизитов.Колонки.Добавить("Значение");
	ТаблицаДопРеквизитов.Колонки.Добавить("ТекстоваяСтрока");
	
	Свойства = ТЗДополнительныеРеквизиты.ВыгрузитьКолонку("Свойство");
	
	ТаблицаДопСведений = ТаблицаДопРеквизитов.СкопироватьКолонки();
	
	Для Каждого СтрокаТаблицыСвойств Из ТЗДополнительныеРеквизиты Цикл
		НоваяСтрока = ТаблицаДопРеквизитов.Добавить();
		
		Если ТипЗнч(СтрокаТаблицыСвойств.Значение) = Тип("Строка")
			И СтрДлина(СтрокаТаблицыСвойств.Значение) > 1024 Тогда
			НоваяСтрока.ТекстоваяСтрока = СтрокаТаблицыСвойств.Значение;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыСвойств, "Свойство,Значение");
	КонецЦикла;
	
	
	МассивСвойств = УправлениеСвойствами.СвойстваОбъекта(Источник.Ссылка);
	МассивДопРеквизитов = Новый Массив;
	
	Для Каждого ДопСвойство Из МассивСвойств Цикл
		Если НЕ ДопСвойство.ЭтоДополнительноеСведение Тогда
			МассивДопРеквизитов.Добавить(ДопСвойство);
		КонецЕсли;
	КонецЦикла;
	
	
	Для Каждого ДопРеквизит Из ТаблицаДопРеквизитов Цикл
		Если МассивДопРеквизитов.Найти(ДопРеквизит.Свойство) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МассивСтрок = Источник.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", ДопРеквизит.Свойство));
		Если МассивСтрок.Количество() Тогда
			СтрокаСвойства = МассивСтрок[0];
		Иначе
			СтрокаСвойства = Источник.ДополнительныеРеквизиты.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрокаСвойства, ДопРеквизит, "Свойство,Значение,ТекстоваяСтрока");
	КонецЦикла; 
	
КонецПроцедуры
