Процедура ЗаполнитьГруппаЦветИсправление(Источник) 
	
	ОчиститьДополнительныйРеквизит(Источник, "Группа цвета");
	ОчиститьДополнительныйРеквизит(Источник, "Цвет для сайта");

	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	спЦвета.Родитель КАК ГруппаЦвет,
		|	спЦвета.Наименование КАК Цвет
		|ИЗ
		|	Справочник.спЦвета КАК спЦвета
		|ГДЕ
		|	спЦвета.Родитель.ЭтоГруппа
		|	И НЕ спЦвета.Родитель.ПометкаУдаления
		|	И спЦвета.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Источник.спЦвет);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ТЗДополнительныеРеквизиты = Новый ТаблицаЗначений;
		ТЗДополнительныеРеквизиты.Колонки.Добавить("Свойство", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"));
		ТЗДополнительныеРеквизиты.Колонки.Добавить("Значение"); 
		
		ДополнительнйРеквизитГруппаЦвет = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Группа цвета", Истина);
		
		Если ЗначениеЗаполнено(ДополнительнйРеквизитГруппаЦвет) И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ГруппаЦвет)Тогда 
			ТЗРеквизитНоваяСтрока = ТЗДополнительныеРеквизиты.Добавить();
			ТЗРеквизитНоваяСтрока.Свойство = ДополнительнйРеквизитГруппаЦвет;
			
			Значение = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию(ВыборкаДетальныеЗаписи.ГруппаЦвет,,, ТЗРеквизитНоваяСтрока.Свойство);
			
			Если ТипЗнч(Значение) = Тип("СправочникСсылка.ЗначенияСвойствОбъектов") И ЗначениеЗаполнено(Значение) Тогда 	
				ТЗРеквизитНоваяСтрока.Значение = Значение;    
			Иначе  
				Попытка
					НовоеЗначение = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент(); 
					НовоеЗначение.Владелец = ДополнительнйРеквизитГруппаЦвет;
					НовоеЗначение.Наименование = ВыборкаДетальныеЗаписи.ГруппаЦвет;
					НовоеЗначение.Записать();  
				Исключение
				КонецПопытки;    
				ТЗРеквизитНоваяСтрока.Значение = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию(ВыборкаДетальныеЗаписи.ГруппаЦвет,,, ТЗРеквизитНоваяСтрока.Свойство);	
			КонецЕсли;
			
		КонецЕсли;  
		
		ДополнительнйРеквизитЦветДляСайта = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Цвет для сайта", Истина);
		
		Если ЗначениеЗаполнено(ДополнительнйРеквизитЦветДляСайта) И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Цвет) Тогда 
			ТЗРеквизитНоваяСтрока = ТЗДополнительныеРеквизиты.Добавить();
			ТЗРеквизитНоваяСтрока.Свойство = ДополнительнйРеквизитЦветДляСайта;
			
			Значение = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию(ВыборкаДетальныеЗаписи.Цвет,,, ТЗРеквизитНоваяСтрока.Свойство);
			
			Если ТипЗнч(Значение) = Тип("СправочникСсылка.ЗначенияСвойствОбъектов") И ЗначениеЗаполнено(Значение) Тогда 	
				ТЗРеквизитНоваяСтрока.Значение = Значение;    
			Иначе  
				Попытка
					НовоеЗначение = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент(); 
					НовоеЗначение.Владелец = ДополнительнйРеквизитЦветДляСайта;
					НовоеЗначение.Наименование = ВыборкаДетальныеЗаписи.Цвет;
					НовоеЗначение.Записать();  
				Исключение
				КонецПопытки;    
				ТЗРеквизитНоваяСтрока.Значение = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию(ВыборкаДетальныеЗаписи.Цвет,,, ТЗРеквизитНоваяСтрока.Свойство);	
			КонецЕсли;
			
			
		КонецЕсли;
		
		
		ЗаписатьСвойстваУОбъекта(Источник, ТЗДополнительныеРеквизиты); 
	КонецЦикла;  
	
КонецПроцедуры

