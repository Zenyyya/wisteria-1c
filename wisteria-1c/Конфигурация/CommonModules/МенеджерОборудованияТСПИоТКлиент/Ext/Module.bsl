#Область ПрограммныйИнтерфейс

// Открытие формы списка событий эксплуатации ТС ПИоТ
//
// Параметры:
//  ПодключаемоеОборудование - СправочникСсылка.ПодключаемоеОборудование
//
Процедура ОткрытьСобытияЭксплуатацииТСПИоТ(ПодключаемоеОборудование) Экспорт
	
	Если ОбщегоНазначенияБПОКлиент.ИспользуетсяПодсистемаЛогирования() Тогда
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("Отбор", Новый Структура("Оборудование", ПодключаемоеОборудование));
		ОткрытьФорму("РегистрСведений.СобытияЭксплуатацииТСПИоТ.ФормаСписка", ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры

// Сохранить cобытия эксплуатации ТС ПИоТ
// 
// Параметры:
//  ПодключаемоеОборудование - СправочникСсылка.ПодключаемоеОборудование
// 
Процедура ЗаписатьСобытиеЭксплуатацииТСПИоТ(ПодключаемоеОборудование, ВременнаяМетка, СобытиеЭксплуатации) Экспорт
	
	МенеджерОборудованияТСПИоТВызовСервера.ЗаписатьСобытиеЭксплуатацииТСПИоТ(ПодключаемоеОборудование, ВременнаяМетка, СобытиеЭксплуатации);
	
КонецПроцедуры

// Очищает cобытия эксплуатации ТС ПИоТ для указанного подключаемого оборудования.
//
// Параметры:
//   ПодключаемоеОборудование - СправочникСсылка.ПодключаемоеОборудование - 
//     ссылка на подключаемое оборудование, для которого необходимо очистить архив логов
//
Процедура ОчиститьСобытияЭксплуатацииТСПИоТ(ПодключаемоеОборудование) Экспорт
	
	МенеджерОборудованияТСПИоТВызовСервера.ОчиститьСобытияЭксплуатацииТСПИоТ(ПодключаемоеОборудование);
	
КонецПроцедуры   

#КонецОбласти
