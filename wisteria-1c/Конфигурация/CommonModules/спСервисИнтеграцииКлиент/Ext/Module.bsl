Процедура ЗавершитьСессию(Сессия)
	Если ТипЗнч(Сессия) = Тип("COMОбъект") Тогда
		Сессия.Dispose();
	КонецЕсли;	
КонецПроцедуры	

Функция СоздатьУникальноеИмяФайла(ИсходящееСообщение) 
	Префикс = "";
	ИмяДата = "";
	ИмяВремя = "";
	УИД = Новый УникальныйИдентификатор();
	
	Если ИсходящееСообщение.Префикс = "FE714" Тогда  
		Префикс = "FE714"; 
		ИмяДата = Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=yyyy-MM-dd");
		ИмяВремя = Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=ЧЧ:мм:сс"); 
		
	ИначеЕсли ИсходящееСообщение.Префикс = "FE720" Тогда 	
		Префикс = "FE720"; 
		ИмяДата = Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=yyyy-MM-dd");
		ИмяВремя = Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=ЧЧ:мм:сс"); 
		
	КонецЕсли;
	
	МоеУникальноеИмяФайла = Префикс + "_" + СтрЗаменить(ИмяДата,"-","") + "_" + СтрЗаменить(ИмяВремя,":","") + "_" + УИД; 
	Возврат МоеУникальноеИмяФайла;
КонецФункции 

Функция СоздатьКаталогВыгрузки()
	Каталог = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПолучитьИмяВременногоФайла(""));
	СоздатьКаталог(Каталог);   
	Возврат Каталог;
КонецФункции

Процедура ПоместитьВАрхив(Каталог, МоеУникальноеИмяФайла, ФайлыОтправки = Неопределено)  
	Если ФайлыОтправки = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	ИмяАрхивногоФайла = Каталог + Строка(МоеУникальноеИмяФайла) + ".zip"; 
	
	// Создадим объект записи ZIP-архива
	ЗаписьZIP = Новый ЗаписьZipФайла(ИмяАрхивногоФайла,
	,
	,
	МетодСжатияZIP.Сжатие,
	УровеньСжатияZIP.Максимальный,
	МетодШифрованияZIP.Zip20); 
	
	// Добавим необходимые файлы в архив 
	
	Если ТипЗнч(ФайлыОтправки) = Тип("Массив") Тогда
		Для каждого Файл Из ФайлыОтправки Цикл
			ЗаписьZIP.Добавить(Файл.ИмяФайла, РежимСохраненияПутейZIP.НеСохранятьПути);
		КонецЦикла;   
		
	ИначеЕсли ТипЗнч(ФайлыОтправки) = Тип("Структура") И ФайлыОтправки.Свойство("ИмяФайла") Тогда
		ЗаписьZIP.Добавить(ФайлыОтправки.ИмяФайла, РежимСохраненияПутейZIP.НеСохранятьПути);
	Иначе 
		ЗаписьZIP.Добавить(ФайлыОтправки, РежимСохраненияПутейZIP.НеСохранятьПути);
	КонецЕсли;

	// Запишем архив на диск
	ЗаписьZIP.Записать(); 
	
КонецПроцедуры  

#КонецОбласти
