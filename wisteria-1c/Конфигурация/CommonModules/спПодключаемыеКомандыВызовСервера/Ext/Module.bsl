Функция ПроверитьСообщениеНаОтправкуВебСерверу(Ссылка) Экспорт
	
	ТаблицаПроверки = Новый ТаблицаЗначений;
	ТаблицаПроверки.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.ЗаказНаПеремещение"));
	
	НоваяСтрока = ТаблицаПроверки.Добавить();
	НоваяСтрока.Ссылка = Ссылка;
	ОтправленныеСообщения = спОбработкаСобытийВызовСервера.ИсключитьПовторнуюОтправку(ТаблицаПроверки, Перечисления.спСпособПередачи.SOAP);
	
	Если ТипЗнч(ОтправленныеСообщения) = Тип("ТаблицаЗначений") И ОтправленныеСообщения.Количество() > 0 Тогда 
		Возврат Истина;
	Иначе 
		Возврат Ложь;	
	КонецЕсли; 
КонецФункции
