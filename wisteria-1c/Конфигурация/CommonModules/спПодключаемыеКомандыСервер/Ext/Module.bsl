// dimedrol 23.02.2025
Функция СоздатьУстановкуЦенПоАлгоритму(Знач Объект) Экспорт
	
	Алгоритм = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "спАлгоритмРасчетаУстановкиЦен");
	Если Не ЗначениеЗаполнено(Алгоритм) Тогда
		ОбщегоНазначения.СообщитьПользователю("Для контрагента не указан алгоритм формирования цен");
		Возврат Неопределено;
	КонецЕсли;
	
	ТЧНоменклатура = Объект.Запасы.Выгрузить(, "Номенклатура, Характеристика, Цена");
	ТЧНоменклатура.Колонки.Добавить("ЦенаНовая", ОбщегоНазначения.ОписаниеТипаЧисло(10, 3));
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТЧНоменклатура", ТЧНоменклатура);
	
	ТаблицаРезультат = Справочники.спАлгоритмыРасчетаЦен.Вызвать(Алгоритм.КлючДляВызова, СтруктураПараметров);
	
	ДокументУстановкаЦенНоменклатурыОбъект = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	
	ДокументУстановкаЦенНоменклатурыОбъект.Дата        = ТекущаяДатаСеанса();
	ДокументУстановкаЦенНоменклатурыОбъект.Автор       = Пользователи.АвторизованныйПользователь();
	ДокументУстановкаЦенНоменклатурыОбъект.Комментарий = СтрШаблон("Документ цен создан программно по алгоритму %1", Алгоритм.Наименование);
	
	ДокументУстановкаЦенНоменклатурыОбъект.ПоказыватьДействующуюЦену  = Истина;
	ДокументУстановкаЦенНоменклатурыОбъект.ПоказыватьЕдиницыИзмерения = Истина;
	ДокументУстановкаЦенНоменклатурыОбъект.ПоказыватьХарактеристики   = Истина;
	ДокументУстановкаЦенНоменклатурыОбъект.ПоказыватьОтклонениеЦен    = Истина;
	ДокументУстановкаЦенНоменклатурыОбъект.ПоказыватьНовуюЦену        = Истина;
	ДокументУстановкаЦенНоменклатурыОбъект.ДокументОснование          = Объект.Ссылка;
	
	ВидЦены = Справочники.ВидыЦен.Оптовая; // Розничная цена, ₽
	
	ЗаписатьДокумент = Ложь;
	
	ТЧЗапасы = ДокументУстановкаЦенНоменклатурыОбъект.Запасы;
	Отбор = Новый Структура( "Номенклатура, Характеристика, ЕдиницаИзмерения, ВидЦены, Валюта" );
	Для Каждого ТоварыСтрока Из ТЧНоменклатура Цикл
	
		Отбор.Номенклатура     = ТоварыСтрока.Номенклатура;
		Отбор.Характеристика   = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		Отбор.ЕдиницаИзмерения = ТоварыСтрока.Номенклатура.ЕдиницаИзмерения;
		Отбор.ВидЦены          = ВидЦены;
		Отбор.Валюта           = ВидЦены.ВалютаЦены;
		
		ТЧЗапасыСтроки = ТЧЗапасы.НайтиСтроки(Отбор);
		Если ТЧЗапасыСтроки.Количество() = 0 Тогда
		
			ТЧЗапасыСтрока = ТЧЗапасы.Добавить();
			
			ТЧЗапасыСтрока.Номенклатура     = ТоварыСтрока.Номенклатура;
			ТЧЗапасыСтрока.Характеристика   = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
			ТЧЗапасыСтрока.ЕдиницаИзмерения = ТоварыСтрока.Номенклатура.ЕдиницаИзмерения;
			ТЧЗапасыСтрока.ВидЦены          = ВидЦены;
			ТЧЗапасыСтрока.Валюта           = ВидЦены.ВалютаЦены;
			
		Иначе
			ТЧЗапасыСтрока = ТЧЗапасыСтроки[0];
		КонецЕсли;
		
		Если ТЧЗапасыСтрока.Цена <> ТоварыСтрока.ЦенаНовая Тогда
			ТЧЗапасыСтрока.Цена = ТоварыСтрока.ЦенаНовая;
			ЗаписатьДокумент = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗаписатьДокумент = Истина Тогда
		ДокументУстановкаЦенНоменклатурыОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
	Возврат ДокументУстановкаЦенНоменклатурыОбъект.Ссылка;
	
КонецФункции
