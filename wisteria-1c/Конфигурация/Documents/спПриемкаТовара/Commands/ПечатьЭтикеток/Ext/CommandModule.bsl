
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПечатьИзДокументаПриемки", Истина);
	ПараметрыФормы.Вставить("ДокументПриемки", ПараметрКоманды);
	ПараметрыФормы.Вставить("РежимПечати", "ПечатьЭтикеток");
	ОткрытьФорму("Обработка.ПечатьЭтикетокИЦенниковБПО.Форма.Форма", ПараметрыФормы);
	
КонецПроцедуры
