		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ПродажиОбороты.Номенклатура КАК Номенклатура,
	ПродажиОбороты.Характеристика КАК Характеристика,
	СУММА(ПродажиОбороты.КоличествоОборот) КАК КоличествоОборот,
	СУММА(ПродажиОбороты.СуммаОборот) КАК СуммаОборот
ПОМЕСТИТЬ ВТ_Продажи
ИЗ
	РегистрНакопления.Продажи.Обороты(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			Период,
			Организация = &amp;Организация
				И Склад = &amp;Склад) КАК ПродажиОбороты

СГРУППИРОВАТЬ ПО
	ПродажиОбороты.Номенклатура,
	ПродажиОбороты.Характеристика
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗапасыОстаткиИОбороты.Номенклатура КАК Номенклатура,
	ЗапасыОстаткиИОбороты.Характеристика КАК Характеристика,
	СУММА(ЗапасыОстаткиИОбороты.КоличествоНачальныйОстаток) КАК КоличествоНачальныйОстаток,
	СУММА(ЗапасыОстаткиИОбороты.КоличествоКонечныйОстаток) КАК КоличествоКонечныйОстаток,
	СУММА(ЗапасыОстаткиИОбороты.КоличествоРасход) КАК КоличествоРасход,
	СУММА(ЗапасыОстаткиИОбороты.СуммаРасход) КАК СуммаРасход
ПОМЕСТИТЬ ВТ_Обороты
ИЗ
	РегистрНакопления.Запасы.ОстаткиИОбороты(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			Период,
			ДвиженияИГраницыПериода,
			Организация = &amp;Организация
				И СтруктурнаяЕдиница = &amp;Склад
				И (Номенклатура, Характеристика) В
					(ВЫБРАТЬ
						ВТ_Продажи.Номенклатура КАК Номенклатура,
						ВТ_Продажи.Характеристика КАК Характеристика
					ИЗ
						ВТ_Продажи КАК ВТ_Продажи)) КАК ЗапасыОстаткиИОбороты

СГРУППИРОВАТЬ ПО
	ЗапасыОстаткиИОбороты.Номенклатура,
	ЗапасыОстаткиИОбороты.Характеристика
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	ЦеныНоменклатурыСрезПоследних.Характеристика КАК Характеристика,
	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
ПОМЕСТИТЬ ВТ_ЗакупочныеЦены
ИЗ
	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
			{(&amp;КонецПериода)},
			ВидЦен = &amp;ВидЦен
				И (Номенклатура, Характеристика) В
					(ВЫБРАТЬ
						ВТ_Продажи.Номенклатура КАК Номенклатура,
						ВТ_Продажи.Характеристика КАК Характеристика
					ИЗ
						ВТ_Продажи КАК ВТ_Продажи)) КАК ЦеныНоменклатурыСрезПоследних
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Продажи.Номенклатура КАК Номенклатура,
	ВТ_Продажи.Характеристика КАК Характеристика,
	ЕСТЬNULL(ВТ_Обороты.КоличествоНачальныйОстаток, 0) КАК КоличествоНачальныйОстаток,
	ЕСТЬNULL(ВТ_Обороты.КоличествоКонечныйОстаток, 0) КАК КоличествоКонечныйОстаток,
	ЕСТЬNULL(ВТ_Обороты.КоличествоРасход, 0) КАК КоличествоРасход,
	ЕСТЬNULL(ВТ_Обороты.СуммаРасход, 0) КАК СуммаРасход,
	ВТ_Продажи.КоличествоОборот КАК КоличествоОборот,
	ВТ_Продажи.СуммаОборот КАК СуммаОборот,
	ЕСТЬNULL(ВТ_ЗакупочныеЦены.Цена, 0) КАК Себестоимость
ПОМЕСТИТЬ ВТ_ДанныеКРасчету
ИЗ
	ВТ_Продажи КАК ВТ_Продажи
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Обороты КАК ВТ_Обороты
		ПО ВТ_Продажи.Номенклатура = ВТ_Обороты.Номенклатура
			И ВТ_Продажи.Характеристика = ВТ_Обороты.Характеристика
			И ВТ_Продажи.КоличествоОборот = ВТ_Обороты.КоличествоРасход
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗакупочныеЦены КАК ВТ_ЗакупочныеЦены
		ПО ВТ_Продажи.Номенклатура = ВТ_ЗакупочныеЦены.Номенклатура
			И ВТ_Продажи.Характеристика = ВТ_ЗакупочныеЦены.Характеристика
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ДанныеКРасчету.Номенклатура КАК Номенклатура,
	ВТ_ДанныеКРасчету.Характеристика КАК Характеристика,
	ВТ_ДанныеКРасчету.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
	ВТ_ДанныеКРасчету.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток,
	ВТ_ДанныеКРасчету.КоличествоРасход КАК КоличествоРасход,
	ВТ_ДанныеКРасчету.Себестоимость * ВТ_ДанныеКРасчету.КоличествоОборот КАК СуммаСебестоимости,
	ВТ_ДанныеКРасчету.КоличествоОборот КАК КоличествоПродажи,
	ВТ_ДанныеКРасчету.СуммаОборот КАК СуммаПродажи,
	ВТ_ДанныеКРасчету.Себестоимость КАК Себестоимость,
	ВЫБОР
		КОГДА ВТ_ДанныеКРасчету.КоличествоОборот = 0
			ТОГДА ВТ_ДанныеКРасчету.СуммаОборот
		ИНАЧЕ ВТ_ДанныеКРасчету.СуммаОборот / ВТ_ДанныеКРасчету.КоличествоОборот
	КОНЕЦ КАК ЦенаПродажи
ИЗ
	ВТ_ДанныеКРасчету КАК ВТ_ДанныеКРасчету</query>
	</dataSet>
	<calculatedField>
		<dataPath>MRG</dataPath>
		<expression>(ЦенаПродажи - Себестоимость) / Себестоимость * 100</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>MRG%</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Формат</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>ЧДЦ=2</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>STR</dataPath>
		<expression>ВЫБОР КОГДА КоличествоНачальныйОстаток = 0 ТОГДА 0 ИНАЧЕ КоличествоПродажи / КоличествоНачальныйОстаток * 100 КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>STR</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Формат</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>ЧДЦ=2</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
