////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(ВТ_Продажи.СуммаПродажи, 0) КАК СуммаПродажи,
	0 КАК ПродажиПерсонально,
	ЕСТЬNULL(ВТ_Возвраты.СуммаВозвратов, 0) КАК СуммаВозвратов,
	ЕСТЬNULL(ВТ_Продажи.СуммаПродажи, 0) - ЕСТЬNULL(ВТ_Возвраты.СуммаВозвратов, 0) КАК ИтогПродажи,
	ЕСТЬNULL(ВТ_Продажи.КоличествоЧеков, 0) КАК КоличествоЧеков,
	ЕСТЬNULL(ВТ_Продажи.КоличествоПродажи, 0) КАК КоличествоПродажи,
	1 КАК Соединение,
	ЕСТЬNULL(ВТ_Продажи.Ответственный, ВТ_Возвраты.Ответственный) КАК Ответственный,
	ЕСТЬNULL(ВТ_Возвраты.ПорядокОтветственного, ВТ_Продажи.ПорядокОтветственного) КАК ПорядокОтветственного
ПОМЕСТИТЬ ВТ_СводныеДанные
ИЗ
	ВТ_Продажи КАК ВТ_Продажи
		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Возвраты КАК ВТ_Возвраты
		ПО ВТ_Продажи.Организация = ВТ_Возвраты.Организация
			И ВТ_Продажи.Ответственный = ВТ_Возвраты.Ответственный
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПосетителиОбороты.КоличествоОборот КАК КоличествоВходящих,
	1 КАК Соединение
ПОМЕСТИТЬ ВТ_Посетители
ИЗ
	РегистрНакопления.Посетители.Обороты(&amp;НачалоДня, &amp;КонецДня, , СчетчикПодсчетаПосетителей.Магазин = &amp;Магазин) КАК ПосетителиОбороты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_СводныеДанные.СуммаПродажи КАК СуммаПродажи,
	ВТ_СводныеДанные.ПродажиПерсонально КАК ПродажиПерсонально,
	ВТ_СводныеДанные.СуммаВозвратов КАК СуммаВозвратов,
	ВТ_СводныеДанные.ИтогПродажи КАК ИтогПродажи,
	ВТ_СводныеДанные.КоличествоЧеков КАК КоличествоЧеков,
	ВТ_СводныеДанные.КоличествоПродажи КАК КоличествоПродажи,
	ВТ_СводныеДанные.Ответственный КАК Ответственный,
	ЕСТЬNULL(ВТ_Посетители.КоличествоВходящих, 0) КАК Траффик,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВТ_Посетители.КоличествоВходящих, 0) = 0
			ТОГДА ВТ_СводныеДанные.КоличествоЧеков
		ИНАЧЕ ВТ_СводныеДанные.КоличествоЧеков / ЕСТЬNULL(ВТ_Посетители.КоличествоВходящих, 0)
	КОНЕЦ * 100 КАК ПокупательскаяСпособность,
	ВЫБОР
		КОГДА ВТ_СводныеДанные.КоличествоЧеков = 0
			ТОГДА ВТ_СводныеДанные.СуммаПродажи
		ИНАЧЕ ВТ_СводныеДанные.СуммаПродажи / ВТ_СводныеДанные.КоличествоЧеков
	КОНЕЦ КАК СреднийЧек,
	ВЫБОР
		КОГДА ВТ_СводныеДанные.КоличествоПродажи = 0
			ТОГДА ВТ_СводныеДанные.СуммаПродажи
		ИНАЧЕ ВТ_СводныеДанные.СуммаПродажи / ВТ_СводныеДанные.КоличествоПродажи
	КОНЕЦ КАК СредняяЦенаВЧеке,
	ВЫБОР
		КОГДА ВТ_СводныеДанные.КоличествоЧеков = 0
			ТОГДА ВТ_СводныеДанные.КоличествоПродажи
		ИНАЧЕ ВТ_СводныеДанные.КоличествоПродажи / ВТ_СводныеДанные.КоличествоЧеков
	КОНЕЦ КАК СреднееКоличествоВЧеке,
	ВТ_СводныеДанные.ПорядокОтветственного КАК ПорядокОтветственного
ПОМЕСТИТЬ ВТ_ПеревернутыйОтчет
ИЗ
	ВТ_СводныеДанные КАК ВТ_СводныеДанные
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Посетители КАК ВТ_Посетители
		ПО ВТ_СводныеДанные.Соединение = ВТ_Посетители.Соединение
;

