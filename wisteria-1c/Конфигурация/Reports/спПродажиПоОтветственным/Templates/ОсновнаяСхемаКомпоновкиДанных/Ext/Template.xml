	ВТ_Обороты.Организация КАК Организация,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Обороты.Регистратор) КАК КоличествоЧеков,
	СУММА(ВТ_Обороты.СуммаОборот) КАК СуммаПродажи,
	СУММА(ВТ_Обороты.КоличествоОборот) КАК КоличествоПродажи,
	ВТ_Обороты.Ответственный КАК Ответственный,
	1 КАК ПорядокОтветственного
ПОМЕСТИТЬ ВТ_Продажи
ИЗ
	ВТ_Обороты КАК ВТ_Обороты
ГДЕ
	ВТ_Обороты.Регистратор ССЫЛКА Документ.ЧекККМ

СГРУППИРОВАТЬ ПО
	ВТ_Обороты.Организация,
	ВТ_Обороты.Ответственный

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТ_Обороты.Организация,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Обороты.Регистратор),
	СУММА(ВТ_Обороты.СуммаОборот),
	СУММА(ВТ_Обороты.КоличествоОборот),
	"Итого",
	2
ИЗ
	ВТ_Обороты КАК ВТ_Обороты
ГДЕ
	ВТ_Обороты.Регистратор ССЫЛКА Документ.ЧекККМ

СГРУППИРОВАТЬ ПО
	ВТ_Обороты.Организация
;

