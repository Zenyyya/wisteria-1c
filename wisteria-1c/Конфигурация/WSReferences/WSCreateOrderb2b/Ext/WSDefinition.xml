				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType name="stVatCode">
				<xs:restriction base="xs:string">
					<xs:enumeration value="vc_18"/>
					<xs:enumeration value="vc_18_118"/>
					<xs:enumeration value="vc_10"/>
					<xs:enumeration value="vc_10_110"/>
					<xs:enumeration value="vc_20"/>
					<xs:enumeration value="vc_20_120"/>
					<xs:enumeration value="vc_0"/>
					<xs:enumeration value="vc_NoVAT"/>
