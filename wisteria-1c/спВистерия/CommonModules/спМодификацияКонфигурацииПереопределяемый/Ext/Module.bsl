&Вместо("Справочник_Номенклатура_Форма_ФормаЭлемента_ПриСозданииНаСервере")
Процедура спСправочник_Номенклатура_Форма_ФормаЭлемента_ПриСозданииНаСервере(Форма)

	Элементы = Форма.Элементы;
	
	// dimedrol 24.01.2025
	// элементы формы Размер и Цвет
	Родитель = Элементы.Найти("ГруппаСгруппированныеРеквизиты");
	ИмяЭлемента = "спГруппаДобавленныеРеквизиты";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		НовыйЭлементГруппа = Элементы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), Родитель);
		НовыйЭлементГруппа.Вид                    = ВидГруппыФормы.ОбычнаяГруппа;
		НовыйЭлементГруппа.Отображение            = ОтображениеОбычнойГруппы.Нет;
		НовыйЭлементГруппа.ОтображатьЗаголовок    = Ложь;
		НовыйЭлементГруппа.Группировка            = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		НовыйЭлементГруппа.Заголовок              = "(Вистерия) Добавленные реквизиты";
	КонецЕсли;

	Родитель = Элементы.Найти("спГруппаДобавленныеРеквизиты");
	
	ИмяЭлемента = "спРазмер";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
		НовыйЭлемент.ПутьКДанным              = "Объект.спРазмер";
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
		НовыйЭлемент.Заголовок                = "Размер";
	КонецЕсли;

	ИмяЭлемента = "спЦвет";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
		НовыйЭлемент.ПутьКДанным              = "Объект.спЦвет";
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.Заголовок                = "Цвет";
	КонецЕсли;
	// end of dimedrol 24.01.2025

	// dimedrol 23.02.2025
	ИмяЭлемента = "спБренд";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
		НовыйЭлемент.ПутьКДанным              = "Объект.спБренд";
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.Заголовок                = "Бренд";
	КонецЕсли;
	// end of dimedrol 23.02.2025

	// { Иванов С.С. (TNext) - 06.08.2025 - Задача №3342 
	Родитель = Элементы.Найти("ГруппаПрайсЛист");
	Если Родитель = Неопределено Тогда
		Родитель = Элементы.Найти("спГруппаДобавленныеРеквизиты");
	КонецЕсли;

	ИмяЭлемента = "спМаркетинговаяКатегория";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
		НовыйЭлемент.ПутьКДанным = "Объект.спМаркетинговаяКатегория";
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Форма.Объект.Ссылка) И Не ЗначениеЗаполнено(Форма.Объект.спМаркетинговаяКатегория) Тогда
		Форма.Объект.спМаркетинговаяКатегория = Перечисления.спМаркетинговыеКатегории.RARE;
	КонецЕсли;

	ИмяЭлемента = "спПодборка";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
		НовыйЭлемент.ПутьКДанным = "Объект.спПодборка";
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	КонецЕсли;

	ИмяЭлемента = "спЯндексБизнес";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
		НовыйЭлемент.ПутьКДанным = "Объект.спЯндексБизнес";
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
		НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	КонецЕсли;
	// } 

КонецПроцедуры

&Вместо("УстановитьПрокруткуИзображения")
Процедура спУстановитьПрокруткуИзображения(Форма)
	
	Элементы = Форма.Элементы;
	Изображения = Форма.Изображения;
	ТекущееИзображение = Форма.ТекущееИзображение;
	
	ДекорацияВлево = Элементы.Найти("ДекорацияПрокруткаИзображенийВлево");
	ДекорацияВправо = Элементы.Найти("ДекорацияПрокруткаИзображенийВправо");
	ДекорацияВлевоОтступ = Элементы.Найти("ДекорацияПрокруткаИзображенийВлевоОтступ");
	ДекорацияВправоОтступ = Элементы.Найти("ДекорацияПрокруткаИзображенийВправоОтступ");
	
	Если Изображения.Количество() <= 1 Тогда
		
		Если ДекорацияВлево <> Неопределено Тогда
			ДекорацияВлево.Видимость = Ложь;
		КонецЕсли;
		
		Если ДекорацияВправо <> Неопределено Тогда
			ДекорацияВправо.Видимость = Ложь;
		КонецЕсли;
		
		Если ДекорацияВлевоОтступ <> Неопределено Тогда
			ДекорацияВлевоОтступ.Видимость = Истина;
		КонецЕсли;
		
		Если ДекорацияВправоОтступ <> Неопределено Тогда
			ДекорацияВправоОтступ.Видимость = Истина;
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если ТекущееИзображение = 0 Тогда
		
		Если ДекорацияВлево <> Неопределено Тогда
			ДекорацияВлево.Видимость = Ложь;
		КонецЕсли;
		
		Если ДекорацияВправо <> Неопределено Тогда
			ДекорацияВправо.Видимость = Истина;
		КонецЕсли;
		
	ИначеЕсли ТекущееИзображение = Изображения.Количество() - 1 Тогда
		
		Если ДекорацияВлево <> Неопределено Тогда
			ДекорацияВлево.Видимость = Истина;
		КонецЕсли;
		
		Если ДекорацияВправо <> Неопределено Тогда
			ДекорацияВправо.Видимость = Ложь;
		КонецЕсли;
		
	Иначе
		
		Если ДекорацияВлево <> Неопределено Тогда
			ДекорацияВлево.Видимость = Истина;
		КонецЕсли;
		
		Если ДекорацияВправо <> Неопределено Тогда
			ДекорацияВправо.Видимость = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДекорацияВлево <> Неопределено Тогда
		ДекорацияВлево.Видимость = Ложь;
	КонецЕсли;
	
	Если ДекорацияВправо <> Неопределено Тогда
		ДекорацияВправо.Видимость = Истина;
	КонецЕсли;
	
	Если ДекорацияВлевоОтступ <> Неопределено И ДекорацияВлево <> Неопределено Тогда
		ДекорацияВлевоОтступ.Видимость = Не ДекорацияВлево.Видимость;
	КонецЕсли;
	
	Если ДекорацияВправоОтступ <> Неопределено И ДекорацияВправо <> Неопределено Тогда
		ДекорацияВправоОтступ.Видимость = Не ДекорацияВправо.Видимость;
	КонецЕсли;
	
	ЭлементАдресКартинки = Элементы.Найти("АдресКартинки1");
	Если ЭлементАдресКартинки <> Неопределено Тогда
		ТекущийЭлемент = ЭлементАдресКартинки;
	КонецЕсли;
	
КонецПроцедуры //--->>> Tnext Козык К.А. 26.03.2026

//+++ Tnext Козык К.А. - Вистерия - 23.06.2026
// Блок &Вместо("Номенклатура_ВыводКартинок") отключен.
// После обновления УНФ он полностью глушил типовой вывод изображений,
// из-за чего в карточке номенклатуры не отображались картинки.
// Типовой механизм вывода картинок должен выполняться из основной конфигурации.
//--- Tnext Козык К.А. - Вистерия - 23.06.2026

//+++ Tnext Козык К.А. - Вистерия - 24.06.2026
// Адаптация нетипового вывода картинок после обновления УНФ.
// Как и до обновления, картинки не пишем в ФайлКартинки и не создаем присоединенные файлы.
// Источник остается прежний: РегистрСведений.спВнешниеКартинкиТовара.
// В форму возвращаем прямую внешнюю ссылку. Сервером 1С картинку не скачиваем,
// т.к. HTTPСоединение на api.wisteriakids.ru уходит в таймаут, а в рабочей базе
// вывод выполнялся через прямой URL.
Процедура сп_Номенклатура_ВыводКартинокБыстро(Форма) Экспорт
	
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Если Форма.ИмяФормы <> "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда
			Возврат;
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;
	
	Номенклатура = Неопределено;
	
	Попытка
		Номенклатура = Форма.Объект.Ссылка;
	Исключение
		Номенклатура = Неопределено;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	АдресКартинки = сп_АдресКартинкиНоменклатурыБыстро(Номенклатура);
	
	Если Не ЗначениеЗаполнено(АдресКартинки) Тогда
		Возврат;
	КонецЕсли;
	
	// Заполняем несколько возможных реквизитов формы. В разных релизах УНФ
	// имя реквизита/коллекции изображений может отличаться.
	Попытка
		Форма.АдресКартинки = АдресКартинки;
	Исключение
	КонецПопытки;
	
	Попытка
		Форма.АдресКартинки1 = АдресКартинки;
	Исключение
	КонецПопытки;
	
	Попытка
		Форма.ТекущаяКартинка = АдресКартинки;
	Исключение
	КонецПопытки;
	
	Попытка
		Форма.ТекущееИзображение = 0;
	Исключение
	КонецПопытки;
	
	Попытка
		Если Форма.Изображения <> Неопределено Тогда
			Форма.Изображения.Очистить();
			НовоеИзображение = Форма.Изображения.Добавить();
			
			Попытка
				НовоеИзображение.Адрес = АдресКартинки;
			Исключение
			КонецПопытки;
			
			Попытка
				НовоеИзображение.Ссылка = Номенклатура;
			Исключение
			КонецПопытки;
			
			Попытка
				НовоеИзображение.АдресКартинки = АдресКартинки;
			Исключение
			КонецПопытки;
			
			Попытка
				НовоеИзображение.Картинка = АдресКартинки;
			Исключение
			КонецПопытки;
			
			Попытка
				НовоеИзображение.Представление = "Изображение";
			Исключение
			КонецПопытки;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Функция сп_АдресКартинкиНоменклатурыБыстро(Номенклатура)
	
	АдресКартинки = сп_АдресКартинкиИзВнешнегоРегистраНоменклатуры(Номенклатура);
	Если ЗначениеЗаполнено(АдресКартинки) Тогда
		Возврат АдресКартинки;
	КонецЕсли;
	
	АдресКартинки = сп_АдресКартинкиИзФайлаКартинкиНоменклатуры(Номенклатура);
	Если ЗначениеЗаполнено(АдресКартинки) Тогда
		Возврат АдресКартинки;
	КонецЕсли;
	
	АдресКартинки = сп_АдресКартинкиИзПрисоединенногоФайлаНоменклатуры(Номенклатура);
	Если ЗначениеЗаполнено(АдресКартинки) Тогда
		Возврат АдресКартинки;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция сп_АдресКартинкиИзВнешнегоРегистраНоменклатуры(Номенклатура)
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;
	
	АртикулПоставщика = "";
	
	Попытка
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "спАртикулПоставщика, Артикул");
		Если Реквизиты <> Неопределено Тогда
			Если Реквизиты.Свойство("спАртикулПоставщика")
				И ЗначениеЗаполнено(Реквизиты.спАртикулПоставщика) Тогда
				АртикулПоставщика = СокрЛП(Строка(Реквизиты.спАртикулПоставщика));
			ИначеЕсли Реквизиты.Свойство("Артикул")
				И ЗначениеЗаполнено(Реквизиты.Артикул) Тогда
				АртикулПоставщика = СокрЛП(Строка(Реквизиты.Артикул));
			КонецЕсли;
		КонецЕсли;
	Исключение
		АртикулПоставщика = "";
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(АртикулПоставщика) Тогда
		Возврат "";
	КонецЕсли;
	
	ВнешняяСсылка = "";
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|   Картинки.ВнешняяСсылка КАК ВнешняяСсылка
		|ИЗ
		|   РегистрСведений.спВнешниеКартинкиТовара КАК Картинки
		|ГДЕ
		|   Картинки.АртикулПоставщика = &АртикулПоставщика
		|   И Картинки.ВнешняяСсылка <> """"
		|
		|УПОРЯДОЧИТЬ ПО
		|   Картинки.ВнешняяСсылка";
		Запрос.УстановитьПараметр("АртикулПоставщика", АртикулПоставщика);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ВнешняяСсылка = Выборка.ВнешняяСсылка;
		КонецЕсли;
	Исключение
		ВнешняяСсылка = "";
	КонецПопытки;
	
	Возврат сп_СсылкаНаДвоичныеДанныеКартинки(ВнешняяСсылка, Новый УникальныйИдентификатор);
	
КонецФункции

Функция сп_НормализованнаяВнешняяСсылкаКартинки(ВнешняяСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ВнешняяСсылка) Тогда
		Возврат "";
	КонецЕсли;
	
	Адрес = СокрЛП(Строка(ВнешняяСсылка));
	АдресНРег = НРег(Адрес);
	
	ПрефиксHTTPSAPI = "https://api.wisteriakids.ru/";
	ПрефиксHTTPAPI = "http://api.wisteriakids.ru/";
	
	Если Лев(АдресНРег, СтрДлина(ПрефиксHTTPSAPI)) = ПрефиксHTTPSAPI Тогда
		Адрес = "https://wisteriakids.ru/" + Сред(Адрес, СтрДлина(ПрефиксHTTPSAPI) + 1);
	ИначеЕсли Лев(АдресНРег, СтрДлина(ПрефиксHTTPAPI)) = ПрефиксHTTPAPI Тогда
		Адрес = "https://wisteriakids.ru/" + Сред(Адрес, СтрДлина(ПрефиксHTTPAPI) + 1);
	КонецЕсли;
	
	Возврат Адрес;
	
КонецФункции


Функция сп_СсылкаНаДвоичныеДанныеКартинки(ВнешняяСсылка, ИдентификаторФормы = Неопределено) Экспорт
	
	//+++ Tnext Козык К.А. - Вистерия - 24.06.2026
	// PictureField не отображает прямую внешнюю URL-строку как картинку.
	// Поэтому возвращаем адрес временного хранилища с объектом Картинка,
	// как работало до обновления. Перед загрузкой нормализуем api.wisteriakids.ru
	// в wisteriakids.ru, т.к. в рабочей базе ссылки идут без api.
	Если Не ЗначениеЗаполнено(ВнешняяСсылка) Тогда
		Возврат "";
	КонецЕсли;
	
	АдресURL = сп_НормализованнаяВнешняяСсылкаКартинки(ВнешняяСсылка);
	АдресURL = СокрЛП(Строка(АдресURL));
	
	Если ПустаяСтрока(АдресURL) Тогда
		Возврат "";
	КонецЕсли;
	
	АдресНРег = НРег(АдресURL);
	ЭтоHTTPS = Лев(АдресНРег, 8) = "https://";
	ЭтоHTTP = Лев(АдресНРег, 7) = "http://";
	
	Если Не ЭтоHTTPS И Не ЭтоHTTP Тогда
		Возврат "";
	КонецЕсли;
	
	Если ЭтоHTTPS Тогда
		АдресБезПротокола = Сред(АдресURL, 9);
		Порт = 443;
	Иначе
		АдресБезПротокола = Сред(АдресURL, 8);
		Порт = 80;
	КонецЕсли;
	
	ПозицияСлеша = Найти(АдресБезПротокола, "/");
	
	Если ПозицияСлеша = 0 Тогда
		Хост = АдресБезПротокола;
		Путь = "/";
	Иначе
		Хост = Лев(АдресБезПротокола, ПозицияСлеша - 1);
		Путь = Сред(АдресБезПротокола, ПозицияСлеша);
	КонецЕсли;
	
	Если Лев(Путь, 1) <> "/" Тогда
		Путь = "/" + Путь;
	КонецЕсли;
	
	Попытка
		
		Если ЭтоHTTPS Тогда
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
			Соединение = Новый HTTPСоединение(Хост, Порт, , , , 12, ЗащищенноеСоединение);
		Иначе
			Соединение = Новый HTTPСоединение(Хост, Порт, , , , 12);
		КонецЕсли;
		
		HTTPЗапрос = Новый HTTPЗапрос(Путь);
		HTTPЗапрос.Заголовки.Вставить("User-Agent", "1C:Enterprise");
		HTTPЗапрос.Заголовки.Вставить("Accept", "image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8");
		
		HTTPОтвет = Соединение.Получить(HTTPЗапрос);
		
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			Возврат "";
		КонецЕсли;
		
		ДвоичныеДанные = HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
		
		Если ДвоичныеДанные = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		Картинка = Новый Картинка(ДвоичныеДанные);
		
		Попытка
			ОбрабатываемаяКартинка = Новый ОбрабатываемаяКартинка(Картинка);
			ОбрабатываемаяКартинка.УстановитьРазмер(260, );
			Картинка = ОбрабатываемаяКартинка.ПолучитьКартинку();
		Исключение
		КонецПопытки;
		
		Если ИдентификаторФормы = Неопределено Тогда
			ИдентификаторФормы = Новый УникальныйИдентификатор;
		КонецЕсли;
		
		Возврат ПоместитьВоВременноеХранилище(Картинка, ИдентификаторФормы);
		
	Исключение
		Возврат "";
	КонецПопытки;
	//--- Tnext Козык К.А. - Вистерия - 24.06.2026
	
КонецФункции

Функция сп_АдресКартинкиИзФайлаКартинкиНоменклатуры(Номенклатура)
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;
	
	ФайлКартинки = Неопределено;
	
	Попытка
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "ФайлКартинки");
		Если Реквизиты <> Неопределено
			И Реквизиты.Свойство("ФайлКартинки")
			И ЗначениеЗаполнено(Реквизиты.ФайлКартинки) Тогда
			ФайлКартинки = Реквизиты.ФайлКартинки;
		КонецЕсли;
	Исключение
		ФайлКартинки = Неопределено;
	КонецПопытки;
	
	Возврат сп_АдресДвоичныхДанныхФайлаКартинкиНоменклатуры(ФайлКартинки);
	
КонецФункции

Функция сп_АдресКартинкиИзПрисоединенногоФайлаНоменклатуры(Номенклатура)
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;
	
	ФайлКартинки = Неопределено;
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|   Файлы.Ссылка КАК Файл
		|ИЗ
		|   Справочник.НоменклатураПрисоединенныеФайлы КАК Файлы
		|ГДЕ
		|   Файлы.ВладелецФайла = &ВладелецФайла
		|   И НЕ Файлы.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|   Файлы.ИндексКартинки,
		|   Файлы.Наименование";
		Запрос.УстановитьПараметр("ВладелецФайла", Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ФайлКартинки = Выборка.Файл;
		КонецЕсли;
	Исключение
		ФайлКартинки = Неопределено;
	КонецПопытки;
	
	Возврат сп_АдресДвоичныхДанныхФайлаКартинкиНоменклатуры(ФайлКартинки);
	
КонецФункции

Функция сп_АдресДвоичныхДанныхФайлаКартинкиНоменклатуры(ФайлКартинки)
	
	Если Не ЗначениеЗаполнено(ФайлКартинки) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		АдресКартинки = РаботаСФайламиУНФ.СсылкаНаДвоичныеДанныеФайла(
			ФайлКартинки,
			Новый УникальныйИдентификатор);
		Если ЗначениеЗаполнено(АдресКартинки) Тогда
			Возврат АдресКартинки;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Попытка
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(ФайлКартинки);
		Если ДанныеФайла <> Неопределено
			И ДанныеФайла.Свойство("СсылкаНаДвоичныеДанныеФайла")
			И ЗначениеЗаполнено(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла) Тогда
			Возврат ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат "";
	
КонецФункции
