&Вместо("АРМРаботникаЗалаНоменклатураПриСоздании")
Процедура спАРМРаботникаЗалаНоменклатураПриСоздании(Форма) Экспорт
	
	Если Форма.ИмяФормы <> "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда
		Возврат;
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	Параметры = Форма.Параметры;
	
	Если Не Параметры.Свойство("НомерВерсииПереходаНаВерсиюИсторииДанных") 
		Или Не ЗначениеЗаполнено(Параметры.НомерВерсииПереходаНаВерсиюИсторииДанных) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	РеквизитыКОтображению = Параметры.НомерВерсииПереходаНаВерсиюИсторииДанных;
	
	Если ТипЗнч(РеквизитыКОтображению) = Тип("СписокЗначений") Тогда
		
		Форма.ТолькоПросмотр = Истина;
		СкрытьЭлементыФормыРекурсивно(РеквизитыКОтображению.ВыгрузитьЗначения(), Элементы);
		
	КонецЕсли;
	
КонецПроцедуры

