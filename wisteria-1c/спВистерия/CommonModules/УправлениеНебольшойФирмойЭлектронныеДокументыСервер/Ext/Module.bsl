#Область ПрограммныйИнтерфейс

// Возвращает постоянные параметры для отправки приходной накладной по ЭДО
// 
// Параметры:
//  Основание - ДокументСсылка.ПриходнаяНакладная - ссылка на приходную накладную 
// 
// Возвращаемое значение:
//   - Структура - параметры отпрвка ПН по ЭДО:
//		* Организация 	- СправочникСсылка.Организации - отправитель для ПН по ЭДО
//      * Контрагент 	- СправочникСсылка.Контрагенты - получатель для ПН по ЭДО 
//		* Договор 		- СправочникСсылка.ДоговорыКонтрагентов - договор с покупателем для ПН по ЭДО
//                    
Функция Т_ПараметрыОтправкиПриходнойЭДО() Экспорт

	КлючОбъекта = "Обработка.Т_ОтправкаПриходнойНакладнойЭДО";
	ПараметрыОтправки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КлючОбъекта, КлючОбъекта, Новый Структура,, ИмяПользователя());
	
	Возврат ПараметрыОтправки;
	
КонецФункции 

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

&ИзменениеИКонтроль("ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_2019")
Процедура спЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_2019(СсылкаНаОбъект, Настройки, ДеревоДанных, Отказ)

	Если Не ИнтеграцияМОТПУНФ.ПроверитьМаркируемуюПродукциюДокумента(СсылкаНаОбъект) Тогда
		ВидОперации          = НСтр("ru = 'Формирование ЭД';
		|en = 'ED generation'");
		ПодробныйТекстОшибки = НСтр("ru = 'Ошибка при формирование ЭД: Неверное указание маркированной продукции.';
		|en = 'An error occurred when generating an electronic document: Marked manufactured products are specified incorrectly.'");
		ТекстСообщения       = НСтр("ru = 'Проверьте указание кодов маркировки.';
		|en = 'Check labeling codes.'");
		ЭлектронноеВзаимодействие.ОбработатьОшибку(ВидОперации, ПодробныйТекстОшибки, ТекстСообщения,, СсылкаНаОбъект);
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РасходнаяНакладная")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.КорректировкаРеализации")
		ИЛИ (ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказПокупателя")
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "ВидОперации") = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд) Тогда
		ДанныеДляФормированияЭД = ПолучитьДанныеРеализацииТоваровИУслуг(СсылкаНаОбъект);
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПередачаТоваровМеждуОрганизациями") Тогда
		ДанныеДляФормированияЭД = ПолучитьДанныеПередачаТоваровМеждуОрганизациями(СсылкаНаОбъект);
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ОтчетОПереработке") Тогда
		ДанныеДляФормированияЭД = ПолучитьДанныеОтчетОПереработке(СсылкаНаОбъект);
	#Вставка
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПриходнаяНакладная") 
	    ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументОбъект.ПриходнаяНакладная") Тогда
		ДанныеДляФормированияЭД = Т_ДанныеДляФормированияЭД_ЭмуляцияРасходной(СсылкаНаОбъект, Настройки);
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПеремещениеЗапасов") 
	    ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументОбъект.ПеремещениеЗапасов") Тогда
		ДанныеДляФормированияЭД = Т_ДанныеДляФормированияЭД_ЭмуляцияРасходной(СсылкаНаОбъект, Настройки);
	#КонецВставки
	Иначе
		ДанныеДляФормированияЭД = ПолучитьДанныеАктВыполненныхРабот(СсылкаНаОбъект);
		ДанныеДляФормированияЭД.Вставить("ТаблицаТоваров", ДанныеДляФормированияЭД.ТаблицаРабот);
	КонецЕсли;

	ДокументыОснования = Новый Массив;
	ДокументыОснования.Добавить(СсылкаНаОбъект);
	ДанныеДляФормированияЭД.Вставить("ДокументыОснования", ДокументыОснования);


	ЗаполнитьДанныеПервичногоДокументаУПД_2019(ДанныеДляФормированияЭД, Настройки, ДеревоДанных, Отказ);

КонецПроцедуры

