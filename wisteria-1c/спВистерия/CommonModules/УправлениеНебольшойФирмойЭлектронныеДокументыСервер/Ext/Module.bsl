// Поиск в системе договора по заданным параметрам поиска
//
// Параметры:
//  Организация	 - СправочникСсылка.Организации - организация для поиска договора
//  Контрагент	 - СправочникСсылка.Контрагенты	- владелец договора
//  Основание	 - ДокументСсылка.ПриходнаяНакладная - используется для получения валюты поиска договора
// 
// Возвращаемое значение:
//   - СправчоникСсылка.ДоговорыКонтрагентов - ссылка на договор
//
Функция Т_ДоговорПродажи(Организация, Контрагент, Основание)
	
	Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Организация = &Организация
		|	И ДоговорыКонтрагентов.Владелец = &Контрагент
		|	И ДоговорыКонтрагентов.ВалютаРасчетов = &ВалютаРасчетов
		|	И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СПокупателем)";
	
	Запрос.УстановитьПараметр("ВалютаРасчетов", Основание.ВалютаДокумента);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Договор = Выборка.Ссылка;

	КонецЕсли;
	
	Возврат Договор;
	
КонецФункции

Процедура Т_ЗаполнитьДокументПеремещенияЗапасов(Документ, ДанныеДляЗагрузки) Экспорт
	
	Если ДанныеДляЗагрузки.Свойство("Шапка") Тогда 
		ДанныеЗаполнения = ДанныеДляЗагрузки.Шапка;
	КонецЕсли; 
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	
	Попытка
		
		Если ЗначениеЗаполнено(Документ) Тогда // получены изменения по существующему документу
			
			Если Документ.Проведен Тогда 
				ВызватьИсключение НСтр("ru = 'Заполнение на основании ЭД возможно только для непроведенного документа'");
			КонецЕсли;
			
			ДокументОбъект = Документ.ПолучитьОбъект();
			
		Иначе // создаем новый
			
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.ПеремещениеЗапасов.СоздатьДокумент();
			
			ДокументОбъект.Заполнить(ДанныеЗаполнения);
			
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
			
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			
		КонецЕсли;
		
		// Заполним реквизиты шапки на основании структуры данных заполнения
		ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
		
		// Загрузим табличные части
		ДокументОбъект.Запасы.Загрузить(ДанныеДляЗагрузки.Запасы);
		Если ДанныеДляЗагрузки.Свойство("ШтрихкодыУпаковок") Тогда
			//ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ДанныеДляЗагрузки.ШтрихкодыУпаковок);
		КонецЕсли;
		
		Если ДокументОбъект.ЭтоНовый() Тогда
			ДокументОбъект.УстановитьНовыйНомер();
		КонецЕсли;
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.Записать(РежимЗаписи);
		
		Документ = ДокументОбъект.Ссылка;
	Исключение
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Заполнение на основании ЭД'"),
			УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.Документы.ПеремещениеЗапасов, 
			Документ, 
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Функция Т_ПодготовитьСтруктуруПеремещенияЗапасов(ДеревоДанных) Экспорт
	
	ДанныеЭД = ДанныеВходящегоЭД(ДеревоДанных);
	
	ДанныеОбъекта  = Новый Структура;
	Запасы = Документы.ПеремещениеЗапасов.ПустаяСсылка().Запасы.ВыгрузитьКолонки();
	
	ДанныеОбъекта.Вставить("ВидОперации", Перечисления.ВидыОперацийПеремещениеЗапасов.Перемещение);
	
	СведенияОбУчастнике = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОПокупателе");
	Если ТипЗнч(СведенияОбУчастнике) = Тип("Число") Тогда
		ОпределитьУчастниковПоДаннымЭД_2019(ДеревоДанных, ДанныеОбъекта);
	Иначе
		ДанныеОбъекта.Вставить("Организация", ОрганизацияПоДаннымЭД(ДеревоДанных, "СведенияОПокупателе"));
		ДанныеОбъекта.Вставить("Контрагент",  КонтрагентПоДаннымЭД(ДеревоДанных, "СведенияОПродавце"));
	КонецЕсли;
	
	ДанныеОбъекта.Вставить("СтруктурнаяЕдиница", УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеКонстанты("спСкладОтправитель"));
	ДанныеОбъекта.Вставить("СтруктурнаяЕдиницаПолучатель", УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеКонстанты("спСкладПолучатель"));
		
	ДанныеОбъекта.Вставить("ХозяйственнаяОперация", Справочники.ХозяйственныеОперации.Перемещение);
	
	Пользователь = Пользователи.ТекущийПользователь();
	
	ДанныеОбъекта.Вставить("Автор", Пользователь);

	// Товары
	СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
	Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
		
		Номенклатура = НоменклатураИБ(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.Сопоставление");
		Характеристика = ХарактеристикаИБ(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.Сопоставление");
		Упаковка = УпаковкаИБ(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.Сопоставление");
		
		НоваяСтрока = Запасы.Добавить();
		НоваяСтрока.ЕдиницаИзмерения = НайтиСсылкуНаОбъект("ЕдиницыИзмерения",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод"));
		
		НоваяСтрока.Количество = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.Количество");
		НоваяСтрока.Себестоимость = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмерения");
		НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Количество) Тогда
			НоваяСтрока.Количество = 1;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Сумма) Тогда
			НоваяСтрока.Сумма = ?(ЗначениеЗаполнено(НоваяСтрока.Всего), НоваяСтрока.Всего, НоваяСтрока.Цена);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Себестоимость) Тогда
			НоваяСтрока.Себестоимость = НоваяСтрока.Сумма / НоваяСтрока.Количество;
		КонецЕсли;
		
		НоваяСтрока.Номенклатура = Номенклатура;
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
			НоваяСтрока.ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.Номенклатура, "ЕдиницаИзмерения");
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеДляЗаполнения = Новый Структура();
	ДанныеДляЗаполнения.Вставить("Шапка", ДанныеОбъекта);
	ДанныеДляЗаполнения.Вставить("Запасы", Запасы);
	
	Возврат ДанныеДляЗаполнения;
	
КонецФункции

Функция Т_ЭтоПеремещениеЗапасов(СпособОбработки) Экспорт
	
	Результат = Ложь;
	СпособОбработкиПоступлениеДопРасходов = ВРег("ПеремещениеЗапасов");
	Если ТипЗнч(СпособОбработки) = Тип("Структура") Тогда
		Результат = (ВРег(СпособОбработки.ПервичныйДокумент) = СпособОбработкиПоступлениеДопРасходов);
	Иначе
		Результат = (ВРег(СпособОбработки) = СпособОбработкиПоступлениеДопРасходов);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

