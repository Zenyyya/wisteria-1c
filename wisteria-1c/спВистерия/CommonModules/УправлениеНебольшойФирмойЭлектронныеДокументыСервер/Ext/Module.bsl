		|ВЫБРАТЬ
		|	ВТ_КодыМаркироки.Номенклатура.Представление КАК Номенклатура,
		|	ВТ_КодыМаркироки.Номенклатура.Артикул КАК Артикул,
		|	ВТ_КодыМаркироки.Характеристика КАК Характеристика,
		|	ВЫБОР
		|		КОГДА МИНИМУМ(ВТ_КодыМаркироки.ШтрихкодУпаковки) = НЕОПРЕДЕЛЕНО
		|			ТОГДА МАКСИМУМ(ВТ_КодыМаркироки.Количество)
		|		ИНАЧЕ МАКСИМУМ(ВТ_КодыМаркироки.Количество) - КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_КодыМаркироки.ШтрихкодУпаковки)
		|	КОНЕЦ КАК НедостающееКоличество
		|ИЗ
		|	ВТ_КодыМаркироки КАК ВТ_КодыМаркироки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_КодыМаркироки.Номенклатура.Представление,
		|	ВТ_КодыМаркироки.Номенклатура.Артикул,
		|	ВТ_КодыМаркироки.Характеристика
		|
		|ИМЕЮЩИЕ
		|	НЕ(МИНИМУМ(ВТ_КодыМаркироки.ШтрихкодУпаковки) <> НЕОПРЕДЕЛЕНО
		|			И НЕ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_КодыМаркироки.ШтрихкодУпаковки) < МАКСИМУМ(ВТ_КодыМаркироки.Количество))";
	
	Запрос.УстановитьПараметр("Запасы", 	Запасы);
	Запрос.УстановитьПараметр("Приходная", 	Приходная);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	// Проверка нахождения в приходной всех кодов маркировки
	НенайденныеКодыМаркировки = РезультатыЗапроса[РезультатыЗапроса.ВГраница()];
	Если Не НенайденныеКодыМаркировки.Пустой() Тогда 
		
		ВыборкаНенайденных = НенайденныеКодыМаркировки.Выбрать();
		МассивНеНайденныхКодов = Новый Массив;
		
		Пока ВыборкаНенайденных.Следующий() Цикл
			
			Шаблон = НСтр("ru = 'Для товара %1, %2, %3 недостаточно кодов маркировки для отправки: %4 шт.'");
			
			ТекстОшибкиПоСтроке = СтрШаблон(Шаблон, ВыборкаНенайденных.Номенклатура, ВыборкаНенайденных.Артикул, 
									ВыборкаНенайденных.Характеристика, ВыборкаНенайденных.НедостающееКоличество);
			
			МассивНеНайденныхКодов.Добавить(ТекстОшибкиПоСтроке);
			
		КонецЦикла; 
		
		ТекстИсключения = СтрСоединить(МассивНеНайденныхКодов, Символы.ПС);
		
		ВызватьИсключение ТекстИсключения; 
	// Конец проверки	
	Иначе
	
		ШтрихкодыУпаковок = РезультатыЗапроса[РезультатыЗапроса.ВГраница() - 1].Выгрузить();
		
		Возврат ШтрихкодыУпаковок;
		
	КонецЕсли;

КонецФункции

