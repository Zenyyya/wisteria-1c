// Возвращает данные для формирования электронного документа,
// Эмулируя создание Расходной накладной на основании Приходной накладной
//
// Параметры:
//  СсылкаНаОбъект	 - ДокументСсылка.ПриходнаяНакладная - приходная накладная
// 
// Возвращаемое значение:
//   - Струткура - данные для формирования элемктронного документа.
//
Функция Т_ДанныеДляФормированияЭД_ЭмуляцияРасходной(СсылкаНаОбъект, Настройки)
	
	ДанныеДляФормированияЭД = Новый Структура;
	
	НачатьТранзакцию();
	
	Попытка
		
		// Создаем на основании Приходной Расходную
		РасходнаяНакладная = Документы.РасходнаяНакладная.СоздатьДокумент();
		
		// Заполняем Расходную
		//РасходнаяНакладная.Заполнить(СсылкаНаОбъект); 
		Т_ЗаполнитьОбязательныеРеквизиты(РасходнаяНакладная, СсылкаНаОбъект);
		
		// При эмуляции учет остатков не нужен.	Возврат контроля произойдет при отмене транзации.
		Константы.КонтролироватьОстаткиПриПроведении.Установить(Ложь);
		
		// Записываем Расходную накладную
		РасходнаяНакладная.Записать(РежимЗаписиДокумента.Проведение); 
		
		// Создаем счет-фактуру 
		ДанныеСчетФактуры = СчетаФактурыУНФ.СоздатьСчетФактуру(РасходнаяНакладная.Ссылка, РасходнаяНакладная.Дата);
		//
		
		// Вызывываем исключение
		ВызватьИсключение "Эмуляция прошла успешно."; 
		
		// До этого места не дойдет никогда, но фиксирующая скобка нужна
		ЗафиксироватьТранзакцию();
		
	Исключение     
		
		Если ЗначениеЗаполнено(РасходнаяНакладная.Ссылка) Тогда
			
			// Если эмуляция прошла успешно.
			ДанныеДляФормированияЭД = ПолучитьДанныеРеализацииТоваровИУслуг(РасходнаяНакладная.Ссылка);
			Т_РедактироватьДанные(ДанныеДляФормированияЭД, Настройки);
			ОтменитьТранзакцию();
			
		Иначе                           
			
			// Если при эмуляции возникли ошибки
			ОтменитьТранзакцию();         
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			
			ВызватьИсключение ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке); 
			
		КонецЕсли;

	КонецПопытки;

	Возврат ДанныеДляФормированияЭД;
	
КонецФункции 

Процедура Т_РедактироватьДанные(ДанныеДляФормированияЭД, Настройки)

	Настройки.Вставить("ВидОперацииЭД", 	Перечисления.ВидыОперацийЭД.ПустаяСсылка());
	Настройки.Вставить("ОснованиеПечати", 	"Договор № ПФС-012/2024 от 18.09.2024");
	
КонецПроцедуры

// Заполняет Расходную накладную необходимыми данными
//
// Параметры:
//  ДокументОбъект	 - ДокументОбъект.РасходнаяНакладная - объект заполняемого документа 
//  Основание		 - ДокументСсылка.ПриходнаяНакладная - ссылка на приходную накладную
//
Процедура Т_ЗаполнитьОбязательныеРеквизиты(ДокументОбъект, Основание) Экспорт // добавлен Экспорт  Разумов А.А. (TNEXT) 30.08.2025 Задача № 3950 Передача документов на склад Просто
	
	НеЗаполняемыеСвойства = "Номер";
    ДанныеЗаполнения = Новый Структура;
	
	ПараметрыОтправкиПН = Т_ПараметрыОтправкиПриходнойЭДО();
	
	ДанныеЗаполнения.Вставить("ЭтоУниверсальныйДокумент", 	Истина);
	ДанныеЗаполнения.Вставить("Грузоотправитель", 			ПараметрыОтправкиПН.Организация);
	ДанныеЗаполнения.Вставить("Организация", 				ПараметрыОтправкиПН.Организация);
	ДанныеЗаполнения.Вставить("Грузополучатель",  			ПараметрыОтправкиПН.Контрагент);
	ДанныеЗаполнения.Вставить("Контрагент",  	  			ПараметрыОтправкиПН.Контрагент);
	ДанныеЗаполнения.Вставить("Договор",  	  	  			ПараметрыОтправкиПН.ДоговорКонтрагента);
	ДанныеЗаполнения.Вставить("АдресДоставки",  	  	  	ПараметрыОтправкиПН.АдресДоставки);
	ДанныеЗаполнения.Вставить("ВалютаДокумента",  	  	  	ПараметрыОтправкиПН.ВалютаДокумента);
	ДанныеЗаполнения.Вставить("Кратность",  	  	  		1);
	
    ЗаполнитьЗначенияСвойств(ДокументОбъект, Основание,, НеЗаполняемыеСвойства);
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеЗаполнения);
	
	// Заполнение ТЧ   
	// Запасы        
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
		
		Если ЗначениеЗаполнено(Основание.ДокументОснование) И ТипЗнч(Основание.ДокументОснование) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
			
			Запасы = Т_ЗапасыСЦенамиОснования(Основание, Основание.ДокументОснование);
			
		Иначе
			
			Запасы = Т_ЗапасыСЦенамиПродажи(Основание);
			
		КонецЕсли;
		
	Иначе
		
		Запасы = Основание.Запасы.Выгрузить();
		
	КонецЕсли;
	
	Для Каждого Строка Из Запасы Цикл
		
		НоваяСтрока = ДокументОбъект.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
	КонецЦикла;
	
	// Штрихкоды упаковок 
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
		
		Если ЗначениеЗаполнено(Основание.ДокументОснование) И ТипЗнч(Основание.ДокументОснование) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
			
			ШтрихкодыУпаковок = Т_ШтрихкодыУпаковокИзДокументаОснования(Запасы, Основание.ДокументОснование);
			
		Иначе
			
			ВызватьИсключение 
			НСтр("ru = 'Предусмотрена отправка ""Товарной накладной"" по документу ""Перемещение запасов"", созданному только на основании ""Приходной накладной""'");
			
		КонецЕсли;
		
	Иначе   
		
		ШтрихкодыУпаковок = Основание.ШтрихкодыУпаковок.Выгрузить();
		
	КонецЕсли;	
	
	Для Каждого Строка Из ШтрихкодыУпаковок Цикл
		
		Если ЗначениеЗаполнено(Строка.ШтрихкодУпаковки) Тогда
			НоваяСтрока = ДокументОбъект.ШтрихкодыУпаковок.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЕсли;
		
	КонецЦикла; 

	// Серии
	Для Каждого Строка Из Основание.СерииНоменклатуры Цикл
		
		НоваяСтрока = ДокументОбъект.СерииНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
	КонецЦикла;
	
КонецПроцедуры

Функция Т_ЗапасыСЦенамиОснования(Основание, Приходная)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПеремещениеЗапасовЗапасы.Ссылка КАК Ссылка,
		|	ПеремещениеЗапасовЗапасы.НомерСтроки КАК НомерСтроки,
		|	ПеремещениеЗапасовЗапасы.Номенклатура КАК Номенклатура,
		|	ПеремещениеЗапасовЗапасы.Характеристика КАК Характеристика,
		|	ПеремещениеЗапасовЗапасы.Партия КАК Партия,
		|	ПеремещениеЗапасовЗапасы.СерииНоменклатуры КАК СерииНоменклатуры,
		|	ПеремещениеЗапасовЗапасы.Количество КАК Количество,
		|	ПеремещениеЗапасовЗапасы.Резерв КАК Резерв,
		|	ПеремещениеЗапасовЗапасы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ПеремещениеЗапасовЗапасы.ЗаказПокупателя КАК ЗаказПокупателя,
		|	ПеремещениеЗапасовЗапасы.Себестоимость КАК Себестоимость,
		|	ПеремещениеЗапасовЗапасы.Сумма КАК Сумма,
		|	ПеремещениеЗапасовЗапасы.КлючСвязи КАК КлючСвязи,
		|	ПеремещениеЗапасовЗапасы.СтранаПроисхождения КАК СтранаПроисхождения,
		|	ПеремещениеЗапасовЗапасы.НомерГТД КАК НомерГТД,
