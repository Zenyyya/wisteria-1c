&ИзменениеИКонтроль("ВидЭлектронногоДокументаРеализации")
Функция T_ВидЭлектронногоДокументаРеализации(Источник)

	Если ТипЗнч(Источник) = Тип("ДокументСсылка.РасходнаяНакладная")
		ИЛИ ТипЗнч(Источник) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ВидЭД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "ВидЭлектронногоДокумента");
		Если Не ЗначениеЗаполнено(ВидЭД) Тогда
			ВидЭД = Перечисления.ТипыДокументовЭДО.ТоварнаяНакладная;
		КонецЕсли;
		Возврат ВидЭД;
	#Вставка
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументСсылка.ПриходнаяНакладная") 
		Или ТипЗнч(Источник) = Тип("ДокументОбъект.ПриходнаяНакладная") Тогда
		ВидЭД = Перечисления.ТипыДокументовЭДО.ТоварнаяНакладная;
		Возврат ВидЭД;
	#КонецВставки
	Иначе
		ВидЭД = Источник.ВидЭлектронногоДокумента;
		Если Не ЗначениеЗаполнено(ВидЭД) Тогда
			ВидЭД = Перечисления.ТипыДокументовЭДО.ТоварнаяНакладная;
		КонецЕсли;
		Возврат ВидЭД;
	КонецЕсли;

КонецФункции

&ИзменениеИКонтроль("ЗаполнитьДанныеПервичногоДокументаУПД_2019")
Процедура спЗаполнитьДанныеПервичногоДокументаУПД_2019(ДанныеДляФормированияЭД, Настройки, ДеревоДанных, Отказ)

	ДанныеШапки = ДанныеДляФормированияЭД.РеквизитыШапки;

	Если ДанныеШапки.Исправление = Истина Тогда
		ВидОперацииЭД = Перечисления.ВидыОперацийЭД.Исправление;
	ИначеЕсли Настройки.Свойство("ВидОперацииЭД") Тогда
		ВидОперацииЭД = Настройки.ВидОперацииЭД;
	Иначе
		ВидОперацииЭД = Перечисления.ВидыОперацийЭД.ПродажаКомиссия;
	КонецЕсли;

	ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации", ВидОперацииЭД);

	ЕстьТовары = Ложь;
	ЕстьУслуги = Ложь;
	Для Каждого Строка Из ДанныеДляФормированияЭД.ТаблицаТоваров Цикл
		ПризнакТовара = ПризнакТовара(Строка.Номенклатура);
		Если ПризнакТовара = "1" Тогда
			ЕстьТовары = Истина;
		Иначе
			ЕстьУслуги = Истина;
		КонецЕсли;
	КонецЦикла;

	СоставСодержания = Новый Массив;
	Если ЕстьТовары Тогда
		СоставСодержания.Добавить(НСтр("ru = 'Товары переданы.'"));
	КонецЕсли;
	Если ЕстьУслуги Тогда
		СоставСодержания.Добавить(НСтр("ru = 'Услуги оказаны в полном объеме.'"));
	КонецЕсли;
	СодержаниеОперации = СтрСоединить(СоставСодержания, " ");
	ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", СодержаниеОперации);

	ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаОтгрузкиТоваров", ДанныеШапки.Дата);
	ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки", ДанныеДляФормированияЭД.ДокументыОснования);

	Если ДанныеШапки.Исправление = Истина Тогда
		Если ДанныеДляФормированияЭД.Свойство("ТаблицаДанныхДокумента") 
			И ДанныеДляФормированияЭД.ТаблицаДанныхДокумента <> Неопределено
			И ДанныеДляФормированияЭД.ТаблицаДанныхДокумента.Количество() > 0 Тогда

			Если ЗначениеЗаполнено(ДанныеДляФормированияЭД.ТаблицаДанныхДокумента[0].ДатаДокумента) Тогда
				ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаОтгрузкиТоваров", ДанныеДляФормированияЭД.ТаблицаДанныхДокумента[0].ДатаДокумента);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ОснованиеПечати = "";
	Если ДанныеШапки.Ссылка.Метаданные().Реквизиты.Найти("ОснованиеПечати") <> Неопределено Тогда
		ОснованиеПечати = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеШапки.Ссылка, "ОснованиеПечати");
	КонецЕсли;
     #Вставка
	Если Настройки.Свойство("ОснованиеПечати") Тогда
		ОснованиеПечати = Настройки.ОснованиеПечати;
	КонецЕсли;
	#КонецВставки
	
	ОснованиеОтгрузкиТоваров = Новый ТаблицаЗначений;
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНаименование");
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНомер");
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДата", Новый ОписаниеТипов("Дата"));
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДопСведения");

	Если ЗначениеЗаполнено(ОснованиеПечати) Тогда

		СтрокаНаименование = "";
		НомерОснования = "";
		ДатаОснования = Дата(1,1,1);

		Если СтрНайти(ОснованиеПечати, "№") > 0 
			И СтрНайти(ОснованиеПечати, "от") > 0 Тогда

			Поз = СтрНайти(ОснованиеПечати, "№");
			СтрокаНаименование = Сред(ОснованиеПечати, 1, Поз-1);
			СтрокаНаименование = СокрЛП(СтрокаНаименование);

			Поз2 = СтрНайти(ОснованиеПечати, "от");
			Поз2 = Поз2-1;

			СтрокаНомер = Сред(ОснованиеПечати, Поз+1, Поз2-Поз);
			СтрокаНомер = СокрЛП(СтрокаНомер);

			СтрокаДата = Сред(ОснованиеПечати, Поз2+3);
			Если СтрНайти(СтрокаДата, ",") > 0 Тогда
				Поз = СтрНайти(СтрокаДата, ",");
				СтрокаДата = Сред(СтрокаДата, 1, Поз-1);
			КонецЕсли;
			СтрокаДата = СокрЛП(СтрокаДата);

			НомерОснования = СтрокаНомер;
			Попытка
				ДатаОснования = СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрокаДата);
			Исключение
			КонецПопытки;

		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(НомерОснования)
			И НЕ ЗначениеЗаполнено(ДатаОснования) Тогда

			Если СтрНайти(ОснованиеПечати, "№") > 0 Тогда
				Поз = СтрНайти(ОснованиеПечати, "№");
				СтрокаНаименование = Сред(ОснованиеПечати, 1, Поз-1);
				СтрокаНаименование = СокрЛП(СтрокаНаименование);

				Если ПустаяСтрока(СтрокаНаименование) Тогда
					СтрокаНаименование = НСтр("ru = 'Договор'");
				КонецЕсли;
			КонецЕсли;

			НомерОснования = ДанныеШапки.НомерДоговора;
			ДатаОснования = НачалоДня(ДанныеШапки.ДатаДоговора);

		КонецЕсли; 

		Если НЕ ЗначениеЗаполнено(СтрокаНаименование) Тогда
			СтрокаНаименование = НСтр("ru = 'Договор'");
		КонецЕсли;

		Если ЗначениеЗаполнено(ДатаОснования) Тогда

			НоваяСтрока = ОснованиеОтгрузкиТоваров.Добавить();

			НоваяСтрока.ДокументНаименование = СтрокаНаименование;
			НоваяСтрока.ДокументНомер = НомерОснования;
			НоваяСтрока.ДокументДата = ДатаОснования;

			Если СтрНайти(ОснованиеПечати, ",") > 0 Тогда
				Поз = СтрНайти(ОснованиеПечати, ",");
				СтрокаДопСведения = Сред(ОснованиеПечати, Поз+1);
				СтрокаДопСведения = СокрЛП(СтрокаДопСведения);

				Если НЕ ПустаяСтрока(СтрокаДопСведения) Тогда
					НоваяСтрока.ДокументДопСведения = СтрокаДопСведения;
				КонецЕсли;
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	// Дополним таблицу оснований параметрами обработки ошибок.
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ОснованиеОтгрузкиТоваров, "ДокументДата",,,
	НСтр("ru = 'Необходимо указать дату в реквизитах печати для основания.'"));

	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ОснованиеОтгрузкиТоваров, "ОснованиеОтгрузкиТоваров");


	ТранспортнаяНакладная = Новый ТаблицаЗначений;
	ТранспортнаяНакладная.Колонки.Добавить("ТранспортнаяНакладнаяНомер");
	ТранспортнаяНакладная.Колонки.Добавить("ТранспортнаяНакладнаяДата");

	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТранспортнаяНакладная, "ТранспортнаяНакладная");

	Если ЗначениеЗаполнено(ДанныеШапки.Перевозчик) Тогда
		СведенияОПеревозчике = ПолучитьДанныеЮрФизЛица(ДанныеШапки.Перевозчик);
		ЗаполнитьДанныеУчастникаУПД(ДеревоДанных, СведенияОПеревозчике, "СведенияОПеревозчике");
	КонецЕсли;

	ДокументОснование = Неопределено;
	Если ТипЗнч(ДанныеШапки.Ссылка) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		ДокументОснование = ДанныеШапки.Ссылка;
	Иначе
		Для каждого Эл Из ДанныеДляФормированияЭД.ДокументыОснования Цикл
			Если ЗначениеЗаполнено(Эл) Тогда
				ДокументОснование = Эл;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДокументОснование) Тогда

		МетаданныеОснования = ДокументОснование.Метаданные();
		Если МетаданныеОснования.Реквизиты.Найти("ДанныеОТранспортировке") <> Неопределено
			И МетаданныеОснования.Реквизиты.Найти("СопроводительныеДокументы") <> Неопределено Тогда

			РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "ДанныеОТранспортировке,СопроводительныеДокументы", Истина);
			Если ЗначениеЗаполнено(РеквизитыОснования.ДанныеОТранспортировке) Тогда
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОТранспортировке", СокрЛП(РеквизитыОснования.ДанныеОТранспортировке));
			КонецЕсли;
			Если ЗначениеЗаполнено(РеквизитыОснования.СопроводительныеДокументы) Тогда
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ИныеСведенияОбОтгрузке", СокрЛП(РеквизитыОснования.СопроводительныеДокументы));
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	Если ЗначениеЗаполнено(ДанныеШапки.РасшифровкаПодписиКладовщика) Тогда

		КладовщикФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(ДанныеШапки.РасшифровкаПодписиКладовщика);

		Если ЗначениеЗаполнено(ДанныеШапки.ДолжностьКладовщика) Тогда
			// Кладовщик работает в организации
			ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СведенияОЛицеПередавшемТовары.РаботникОрганизацииПродавца.Должность", Строка(ДанныеШапки.ДолжностьКладовщика));

			ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СведенияОЛицеПередавшемТовары.РаботникОрганизацииПродавца.Фамилия", КладовщикФИО.Фамилия);
			ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СведенияОЛицеПередавшемТовары.РаботникОрганизацииПродавца.Имя", КладовщикФИО.Имя);
			ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СведенияОЛицеПередавшемТовары.РаботникОрганизацииПродавца.Отчество", КладовщикФИО.Отчество);
		Иначе
			// Кладовщик не работает в организации
			ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СведенияОЛицеПередавшемТовары.ИноеЛицо.ФЛ.Фамилия", КладовщикФИО.Фамилия);
			ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СведенияОЛицеПередавшемТовары.ИноеЛицо.ФЛ.Имя", КладовщикФИО.Имя);
			ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СведенияОЛицеПередавшемТовары.ИноеЛицо.ФЛ.Отчество", КладовщикФИО.Отчество);
		КонецЕсли;
	КонецЕсли;

	Если Настройки.Функция = "ДОП" // УПД первичка
		ИЛИ ВидОперацииЭД = Перечисления.ВидыОперацийЭД.Комиссия Тогда // передача товаров комиссионеру

		ЗаполнитьДеревоДанныхУПД_2019(ДанныеДляФормированияЭД, Настройки, ДеревоДанных, Отказ);

	КонецЕсли;

КонецПроцедуры

// Сохраняет данные из электронного документа в объекты ИБ (УПД-ДОП версии 2019).
//
// Параметры:
//  ДеревоДанных - ДеревоЗначений - структура параметров документа ИБ.
//  СсылкаНаВладельца - Ссылка - ссылка на объект ИБ, владельца электронного документа.
//  Записывать - Булево - признак необходимости записывать объект ИБ.
//  СпособОбработки - Строка - способ сохранения данных в информационной базе.
//  ОписаниеОшибки - Строка - описание ошибки создания учетного документа.
//
&ИзменениеИКонтроль("НайтиСоздатьУПДДокументОПередаче_2019")
Процедура T_НайтиСоздатьУПДДокументОПередаче_2019(ДеревоДанных, СсылкаНаВладельца, Записывать, СпособОбработки, ОписаниеОшибки) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если ЭтоПоступлениеДопРасходов(СпособОбработки) Тогда

		ДанныеУПД = ПодготовитьСтруктуруДляПоступленияДопРасходовУПД_2019(ДеревоДанных);

		ЗаполнитьДокументПоступленияДопРасходов(СсылкаНаВладельца, ДанныеУПД);

	ИначеЕсли ЭтоПоступлениеИзПереработки(СпособОбработки, ДеревоДанных, "УПД") Тогда

		ДанныеУПД = ПодготовитьСтруктуруДляПоступленияИзПереработкиУПД_2019(ДеревоДанных);

		ЗаполнитьДокументПоступленияИзПереработки(СсылкаНаВладельца, ДанныеУПД);

	#Вставка
	ИначеЕсли Т_ЭтоПеремещениеЗапасов(СпособОбработки) Тогда

		ДанныеУПД = Т_ПодготовитьСтруктуруПеремещенияЗапасов(ДеревоДанных);

		Т_ЗаполнитьДокументПеремещенияЗапасов(СсылкаНаВладельца, ДанныеУПД);
		
	#КонецВставки
	Иначе

		ДанныеУПД = ПодготовитьСтруктуруДляУПД(ДеревоДанных, Истина);

		Если ДанныеУПД.Шапка.Исправление Тогда
			ЗаполнитьДокументКорректировкиПоступления(СсылкаНаВладельца, ДанныеУПД);
		Иначе
			ЗаполнитьДокументПоступленияТоваровУслуг(СсылкаНаВладельца, ДанныеУПД);
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&ИзменениеИКонтроль("ЗаполнитьДеревоДанныхУПД_2019")
Процедура спЗаполнитьДеревоДанныхУПД_2019(ДанныеДляФормированияЭД, Настройки, ДеревоДанных, Отказ)

	ДанныеШапки 	   = ДанныеДляФормированияЭД.РеквизитыШапки;

	ЭтоСчетФактураНаАванс = Настройки.Свойство("ЭтоСчетФактураНаАванс")
	И Настройки.ЭтоСчетФактураНаАванс;

	Если ЭтоСчетФактураНаАванс Тогда
		ВидСчетаФактуры = "Авансовый";
	Иначе
		ВидСчетаФактуры = "Реализация";
	КонецЕсли;

	ОбстоятельстваФормированияСФ = "1";
	ВариантВыбытияМаркируемойПродукции = Неопределено;
	ВидОборота = "";

	Если Настройки.Функция <> "СЧФ" Тогда
		ОбстоятельстваФормированияСФ = "";
		Если ТипЗнч(ДанныеШапки.Ссылка) = Тип("ДокументСсылка.СчетФактура") Тогда
			Для Каждого ДокументОснование Из ДанныеДляФормированияЭД.ДокументыОснования Цикл

				Если ЗначениеЗаполнено(ДокументОснование) Тогда
					ДокументОснованиеВидОперации = Неопределено;
					Если ДокументОснование.Метаданные().Реквизиты.Найти("ВидОперации") <> Неопределено Тогда
						ДокументОснованиеВидОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "ВидОперации");
					КонецЕсли;
					Если ДокументОснование.Метаданные().Реквизиты.Найти("ВариантВыбытияМаркируемойПродукции") <> Неопределено Тогда
						ВариантВыбытияМаркируемойПродукции = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "ВариантВыбытияМаркируемойПродукции");
					КонецЕсли;
					Если ДокументОснованиеВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ВозвратПоставщику Тогда
						ОбстоятельстваФормированияСФ = ""; // Возврат
						Прервать;
					ИначеЕсли ДокументОснованиеВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ПередачаНаКомиссию Тогда
						ОбстоятельстваФормированияСФ = "4"; // Комиссия
						Прервать;
					ИначеЕсли ДокументОснованиеВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ВозвратКомитенту Тогда
						ОбстоятельстваФормированияСФ = "5";
						Прервать;
					ИначеЕсли ДокументОснованиеВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю Тогда
						ЕстьТоварыОСУ = ЕстьТоварыОСУ(ДокументОснование);
						Если ЕстьТоварыОСУ Тогда
							НомерПробитогоЧекаККМ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "НомерЧекаККМ");
							Если ЗначениеЗаполнено(НомерПробитогоЧекаККМ) Тогда
								ВидОборота = "10";
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Если ДанныеШапки.Ссылка.Метаданные().Реквизиты.Найти("ВариантВыбытияМаркируемойПродукции") <> Неопределено Тогда
				ВариантВыбытияМаркируемойПродукции = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеШапки.Ссылка, "ВариантВыбытияМаркируемойПродукции");
			КонецЕсли;
			Если ДанныеШапки.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ВозвратПоставщику Тогда
				ОбстоятельстваФормированияСФ = ""; // Возврат
			ИначеЕсли ДанныеШапки.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ПередачаНаКомиссию Тогда
				ОбстоятельстваФормированияСФ = "4"; // Комиссия
			ИначеЕсли ДанныеШапки.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ВозвратКомитенту Тогда
				ОбстоятельстваФормированияСФ = "5";
			ИначеЕсли ДанныеШапки.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю Тогда
				ЕстьТоварыОСУ = ЕстьТоварыОСУ(ДанныеШапки.Ссылка);
				Если ЕстьТоварыОСУ Тогда
					НомерПробитогоЧекаККМ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеШапки.Ссылка, "НомерЧекаККМ");
					Если ЗначениеЗаполнено(НомерПробитогоЧекаККМ) Тогда
						ВидОборота = "10";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ВидОборота) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОборота", ВидОборота);
	КонецЕсли;

	Если ЭтоСчетФактураНаАванс Тогда
		ОбстоятельстваФормированияСФ = "2";
	КонецЕсли;

	Если ОбстоятельстваФормированияСФ = "4"
		ИЛИ ОбстоятельстваФормированияСФ = "5" Тогда
		Если Не Настройки.Свойство("ВидОперацииЭД") Тогда
			Настройки.Вставить("ВидОперацииЭД", Перечисления.ВидыОперацийЭД.Комиссия);
		КонецЕсли;
	КонецЕсли;

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры", ВидСчетаФактуры);

	Если ЗначениеЗаполнено(ОбстоятельстваФормированияСФ) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДополнительныеСведенияОбУчастниках.ОбстоятельстваФормированияСФ", ОбстоятельстваФормированияСФ);
	КонецЕсли;

	ВнестиСведенияОВыбытииМаркированныхТоваровВДеревоУПДУКД(ДеревоДанных, ВариантВыбытияМаркируемойПродукции);

	ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаСчетаФактуры", ДанныеШапки.Ссылка);

	НомерДокумента = ПечатьДокументовУНФ.ПолучитьНомерНаПечатьСУчетомДатыДокумента(ДанныеШапки.Дата, ДанныеШапки.Номер, ДанныеШапки.Организация.Префикс);

	Если ЗначениеЗаполнено(ДанныеШапки.Организация.ГоловнаяОрганизация)
		И ЗначениеЗаполнено(ДанныеШапки.Организация.ЦифровойИндексОбособленногоПодразделения) Тогда
		НомерДокумента = НомерДокумента + "/" + СокрЛП(ДанныеШапки.Организация.ЦифровойИндексОбособленногоПодразделения);
	ИначеЕсли ДанныеДляФормированияЭД.Свойство("ТаблицаДанныхДокумента") И ДанныеДляФормированияЭД.ТаблицаДанныхДокумента <> Неопределено Тогда
		Если ДанныеДляФормированияЭД.ТаблицаДанныхДокумента.Количество() > 0 Тогда
			ЦифровойИндексОбособленногоПодразделения = ДанныеДляФормированияЭД.ТаблицаДанныхДокумента[0].ЦифровойИндексОбособленногоПодразделения;
			Если ЗначениеЗаполнено(ЦифровойИндексОбособленногоПодразделения) Тогда
				НомерДокумента = НомерДокумента + "/" + СокрЛП(ЦифровойИндексОбособленногоПодразделения);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", НомерДокумента);
	ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",  ДанныеШапки.Дата);

	Если ТипЗнч(ДанныеШапки.Ссылка) = Тип("ДокументСсылка.ЗаказПокупателя") 
		И ДанныеШапки.ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд Тогда

		ДатаФиниша = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеШапки.Ссылка, "Финиш");
		Если ЗначениеЗаполнено(ДатаФиниша) Тогда
			ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента", ДатаФиниша);
		КонецЕсли;
	КонецЕсли;	

	Если ДанныеШапки.Исправление = Истина
		ИЛИ ТипЗнч(ДанныеШапки.Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации") И ЗначениеЗаполнено(ДанныеШапки.НомерИсправления) Тогда

		ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления", ДанныеШапки.НомерИсправления);
		ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления",  ДанныеШапки.ДатаИсправления);

		Если ДанныеДляФормированияЭД.Свойство("ТаблицаДанныхДокумента") И ДанныеДляФормированияЭД.ТаблицаДанныхДокумента <> Неопределено Тогда

			Если ДанныеДляФормированияЭД.ТаблицаДанныхДокумента.Количество() > 0 Тогда

				НомерДокумента = ПечатьДокументовУНФ.ПолучитьНомерНаПечатьСУчетомДатыДокумента(
				ДанныеДляФормированияЭД.ТаблицаДанныхДокумента[0].ДатаДокумента, ДанныеДляФормированияЭД.ТаблицаДанныхДокумента[0].Номер, ДанныеШапки.Организация.Префикс);

				ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", НомерДокумента);
				ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",  ДанныеДляФормированияЭД.ТаблицаДанныхДокумента[0].ДатаДокумента);
				ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления", ДанныеДляФормированияЭД.ТаблицаДанныхДокумента[0].НомерИсправления);
				ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления",  ДанныеДляФормированияЭД.ТаблицаДанныхДокумента[0].ДатаИсправления);

			КонецЕсли;

		ИначеЕсли ЗначениеЗаполнено(ДанныеШапки.ДокументОснование) Тогда
			РеквизитыОснованияКорректировки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеШапки.ДокументОснование, "Номер,Дата", Истина);
			НомерДокумента = ПечатьДокументовУНФ.ПолучитьНомерНаПечатьСУчетомДатыДокумента(РеквизитыОснованияКорректировки.Дата, РеквизитыОснованияКорректировки.Номер, ДанныеШапки.Организация.Префикс);

			ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", НомерДокумента);
			ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",  РеквизитыОснованияКорректировки.Дата);
		КонецЕсли;

	КонецЕсли;

	Если ДанныеШапки.ВидОперации = Перечисления.ВидыОперацийСчетФактура.Аванс
		ИЛИ ДанныеШапки.ВидОперации = Перечисления.ВидыОперацийСчетФактура.НаАвансКомитента Тогда
		ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры", "Авансовый");
	Иначе
		ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры", "Реализация");
	КонецЕсли;

	Если ЗначениеЗаполнено(ДанныеШапки.Покупатель.ГоловнойКонтрагент) Тогда
		СведенияОПокупателе = ПолучитьДанныеЮрФизЛица(ДанныеШапки.Покупатель.ГоловнойКонтрагент, ДанныеШапки.Дата);
	Иначе
		СведенияОПокупателе = ПолучитьДанныеЮрФизЛица(ДанныеШапки.Покупатель, ДанныеШапки.Дата);
	КонецЕсли;

	СведенияОПоставщике  = ПолучитьДанныеЮрФизЛица(ДанныеШапки.Поставщик, ДанныеШапки.Дата);
	СведенияОПокупателе.ИНН = ДанныеШапки.ИННпокупателя;
	СведенияОПокупателе.КПП = ДанныеШапки.КППпокупателя;
	СведенияОПоставщике.ИНН = ДанныеШапки.ИННпоставщика;
	СведенияОПоставщике.КПП = ДанныеШапки.КППпоставщика;

	Если ДанныеДляФормированияЭД.Свойство("ТаблицаДанныхДокумента") 
		И ДанныеДляФормированияЭД.ТаблицаДанныхДокумента <> Неопределено
		И ДанныеДляФормированияЭД.ТаблицаДанныхДокумента.Количество() > 0 Тогда

		Грузоотправитель = ДанныеДляФормированияЭД.ТаблицаДанныхДокумента[0].Грузоотправитель;
		Грузополучатель = ДанныеДляФормированияЭД.ТаблицаДанныхДокумента[0].Грузополучатель;
	Иначе
