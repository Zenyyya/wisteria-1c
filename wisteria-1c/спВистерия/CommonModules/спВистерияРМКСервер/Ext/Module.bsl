//<<<--- Tnext Козык К.А. 16.06.2026 - перенос доработки из формы ФормаРМК обработки РабочееМестоКассира после обновления на релиз 3.0.13.357
Функция спНайтиБрендНоменклатуры(Номенклатура, КодАртикул) Экспорт
	
	Бренд 					= Неопределено;
	ЗаголовокБренд 			= ""; 
	ПредставлениеБренд      = "";
	ПредставлениеКодАртикул = "";
	
    Бренд = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "спБренд"); 
	
	Если ЗначениеЗаполнено(Бренд) Тогда  
		Если ЗначениеЗаполнено(КодАртикул) Тогда 
			ЗаголовокБренд = НСтр("ru = ', Бренд: '");               
			ПредставлениеБренд          = Строка(Бренд);
		Иначе 
			ЗаголовокБренд = НСтр("ru = 'Бренд: '");
			ПредставлениеБренд          = Строка(Бренд);
		КонецЕсли;
	Иначе
		ЗаголовокБренд 			= ""; 
		ПредставлениеБренд      = "";
	КонецЕсли;
		
	Представление = "%1%2%3";

	ПредставлениеКодАртикул = СтрШаблон(Представление, КодАртикул, ЗаголовокБренд, ПредставлениеБренд);
	
	Возврат ПредставлениеКодАртикул;
	
КонецФункции  //--->>> Tnext Козык К.А. 16.06.2026

//<<<--- Tnext Козык К.А. 27.08.2026
// Возвращает серию подарочного сертификата по номеру, считанному сканером.
// Серия возвращается только при однозначном соответствии номенклатуре.
Функция спНайтиСериюПодарочногоСертификатаПоНомеру(
	Номенклатура,
	НомерСертификата) Экспорт
	
	ПустаяСерия =
		Справочники.СерииНоменклатуры.ПустаяСсылка();
	
	Если Не ЗначениеЗаполнено(Номенклатура)
		Или ПустаяСтрока(НомерСертификата) Тогда
		
		Возврат ПустаяСерия;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	СерииНоменклатуры.Ссылка КАК Серия
		|ИЗ
		|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
		|ГДЕ
		|	СерииНоменклатуры.Владелец = &Номенклатура
		|	И СерииНоменклатуры.Наименование = &НомерСертификата
		|	И НЕ СерииНоменклатуры.ПометкаУдаления";
	
	Запрос.УстановитьПараметр(
		"Номенклатура",
		Номенклатура);
	Запрос.УстановитьПараметр(
		"НомерСертификата",
		НомерСертификата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Возврат ПустаяСерия;
	КонецЕсли;
	
	НайденнаяСерия = Выборка.Серия;
	
	// При неоднозначном соответствии ничего автоматически не подставляем.
	Если Выборка.Следующий() Тогда
		Возврат ПустаяСерия;
	КонецЕсли;
	
	Возврат НайденнаяСерия;
	
КонецФункции
//--->>> Tnext Козык К.А. 27.08.2026