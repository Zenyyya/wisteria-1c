		ПараметрыЭД.Контрагент  = Источник.Контрагент;
		ПараметрыЭД.ДоговорКонтрагента = Источник.Договор;

	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ДополнительныеРасходы") 
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ДополнительныеРасходы") Тогда

		ПараметрыЭД.Тип = Перечисления.ТипыДокументовЭДО.АктВыполненныхРабот;
		ПараметрыЭД.Направление = НаправленияДокументов.Входящий;
		ПараметрыЭД.Организация = Источник.Организация;
		ПараметрыЭД.Контрагент  = Источник.Контрагент;
		ПараметрыЭД.ДоговорКонтрагента = Источник.Договор;

	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ПередачаТоваровМеждуОрганизациями")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ПередачаТоваровМеждуОрганизациями") Тогда

		Если УправлениеНебольшойФирмойЭлектронныеДокументыСервер.СчетФактураНеТребуется(Источник.Ссылка)
			ИЛИ НЕ УправлениеНебольшойФирмойЭлектронныеДокументыСервер.ЕстьСчетФактура(Источник.Ссылка) Тогда
			ПараметрыЭД.ФормированиеУниверсальногоДокумента = 
			ОбменСКонтрагентами.ВариантыФормированияУниверсальныхДокументов().Запрещено;
		КонецЕсли;			

		ПараметрыЭД.Тип = Перечисления.ТипыДокументовЭДО.ТоварнаяНакладная;
		ПараметрыЭД.Направление = НаправленияДокументов.Исходящий;
		ПараметрыЭД.Организация = Источник.Организация;
		ПараметрыЭД.Контрагент  = Источник.КонтрагентПолучатель;
		ПараметрыЭД.ДоговорКонтрагента = Источник.Договор;

	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.АктОРасхождениях")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.АктОРасхождениях") Тогда

		ПараметрыЭД.Тип = Перечисления.ТипыДокументовЭДО.АктОРасхождениях;
		ПараметрыЭД.Направление = НаправленияДокументов.Исходящий;
		ПараметрыЭД.Организация = Источник.Организация;
		ПараметрыЭД.Контрагент  = Источник.Контрагент;
		ПараметрыЭД.ДоговорКонтрагента = Источник.Договор;

	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.АктОРасхожденияхПолученный")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.АктОРасхожденияхПолученный") Тогда

		ПараметрыЭД.Тип = Перечисления.ТипыДокументовЭДО.АктОРасхождениях;
		ПараметрыЭД.Направление = НаправленияДокументов.Входящий;
		ПараметрыЭД.Организация = Источник.Организация;
		ПараметрыЭД.Контрагент  = Источник.Контрагент;
		ПараметрыЭД.ДоговорКонтрагента = Источник.Договор;

	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ОтчетОПереработке") 
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ОтчетОПереработке") Тогда

		ПараметрыЭД.Тип = Перечисления.ТипыДокументовЭДО.ТоварнаяНакладная;

		Если УправлениеНебольшойФирмойЭлектронныеДокументыСервер.СчетФактураНеТребуется(Источник.Ссылка)
			ИЛИ НЕ УправлениеНебольшойФирмойЭлектронныеДокументыСервер.ЕстьСчетФактура(Источник.Ссылка) Тогда
			ПараметрыЭД.ФормированиеУниверсальногоДокумента = 
			ОбменСКонтрагентами.ВариантыФормированияУниверсальныхДокументов().Запрещено;
		КонецЕсли;

		ПараметрыЭД.Направление = НаправленияДокументов.Исходящий;
		ПараметрыЭД.Организация = Источник.Организация;
		ПараметрыЭД.Контрагент  = Источник.Контрагент;
		ПараметрыЭД.ДоговорКонтрагента = Источник.Договор;

	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ОтчетПереработчика")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ОтчетПереработчика") Тогда

		ПараметрыЭД.Тип = Перечисления.ТипыДокументовЭДО.ТоварнаяНакладная;
		ПараметрыЭД.Направление = НаправленияДокументов.Входящий;
		ПараметрыЭД.Организация = Источник.Организация;
		ПараметрыЭД.Контрагент  = Источник.Контрагент;
		ПараметрыЭД.ДоговорКонтрагента = Источник.Договор;

	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.СверкаВзаиморасчетов") Тогда

		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Источник,
		"Организация, Контрагент");

		ПараметрыЭД.Тип                = Перечисления.ТипыДокументовЭДО.АктСверкиВзаиморасчетов;
		ПараметрыЭД.Направление        = НаправленияДокументов.Исходящий;
		ПараметрыЭД.Организация        = ЗначенияРеквизитов.Организация;
		ПараметрыЭД.Контрагент         = ЗначенияРеквизитов.Контрагент;

		Если Источник.ДанныеОрганизации.Количество() > 0 Тогда
			ПараметрыЭД.ДоговорКонтрагента = Источник.ДанныеОрганизации[0].Договор;
		КонецЕсли;

	ИначеЕсли ТипИсточника = Тип("ДокументОбъект.СверкаВзаиморасчетов") Тогда

		ПараметрыЭД.Тип                = Перечисления.ТипыДокументовЭДО.АктСверкиВзаиморасчетов;
		ПараметрыЭД.Направление        = НаправленияДокументов.Исходящий;
		ПараметрыЭД.Организация        = Источник.Организация;
		ПараметрыЭД.Контрагент         = Источник.Контрагент;

		Если Источник.ДанныеОрганизации.Количество() > 0 Тогда
			ПараметрыЭД.ДоговорКонтрагента = Источник.ДанныеОрганизации[0].Договор;
		КонецЕсли; 

	ИначеЕсли ТипИсточника = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда

		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Источник, 
		"Организация, Владелец, Ссылка");

		ПараметрыЭД.Тип = Перечисления.ТипыДокументовЭДО.ДоговорныйДокумент;
		ПараметрыЭД.Направление = НаправленияДокументов.Исходящий;
		ПараметрыЭД.Организация = ЗначенияРеквизитов.Организация;
		ПараметрыЭД.Контрагент  = ЗначенияРеквизитов.Владелец;
		ПараметрыЭД.ДоговорКонтрагента = ЗначенияРеквизитов.Ссылка;

	ИначеЕсли ТипИсточника = Тип("СправочникОбъект.ДоговорыКонтрагентов") Тогда

		ПараметрыЭД.Тип = Перечисления.ТипыДокументовЭДО.ДоговорныйДокумент;
		ПараметрыЭД.Направление = НаправленияДокументов.Исходящий;
		ПараметрыЭД.Организация = Источник.Организация;
		ПараметрыЭД.Контрагент  = Источник.Владелец;
		ПараметрыЭД.ДоговорКонтрагента = Источник.Ссылка;

	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ПеремещениеМеждуМОДИСМП")
		Или ТипИсточника = Тип("ДокументОбъект.ПеремещениеМеждуМОДИСМП") Тогда

		Реквизиты = "Организация";

		Если ТипИсточника = Тип("ДокументСсылка.ПеремещениеМеждуМОДИСМП") Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;

		ПараметрыЭД.Тип         = Перечисления.ТипыДокументовЭДО.ТоварнаяНакладная;
		ПараметрыЭД.Направление = НаправленияДокументов.Исходящий;
		ПараметрыЭД.Организация = ЗначенияРеквизитов.Организация;
		ПараметрыЭД.Контрагент  = ЗначенияРеквизитов.Организация;
		ПараметрыЭД.ДоговорКонтрагента = ОбщегоНазначенияИС.ПустоеЗначениеОпределяемогоТипа(Метаданные.ОпределяемыеТипы.ДоговорКонтрагентаИС);

	ИначеЕсли ТипИсточника = Тип("Структура") Тогда

		// Бизнес-сеть.
		ЗаполнитьЗначенияСвойств(ПараметрыЭД, Источник);

	КонецЕсли;

КонецПроцедуры

// Возвращает идентификаторы способов отражения в учете, доступных при загрузке электронного документа.
//
// Параметры:
//  ТипДокумента   - см. ОбменСКонтрагентами.ТипыДокументов   - тип элекронного документа.
//  СпособыОтраженияВУчете - СписокЗначений - список способов отражения в учете. В качестве значения задается строковый
//                           идентификатор, который будет передан в переопределяемый методы создания учетных документов
//                           по данным электронных. В качестве представления - представление способа отражения, которое
//                           может быть отображено пользователю.
//                           Выходной параметр.
//
&ИзменениеИКонтроль("СпособыОтраженияВУчетеТипаЭлектронногоДокумента")
Процедура T_СпособыОтраженияВУчетеТипаЭлектронногоДокумента(ТипДокумента, СпособыОтраженияВУчете) Экспорт

	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	Если ТипДокумента = ТипыДокументов.АктВыполненныхРабот  Тогда

		СпособыОтраженияВУчете.Добавить("ПриходнаяНакладная", НСтр("ru = 'Приходная накладная'"), Истина);
		СпособыОтраженияВУчете.Добавить("ДополнительныеРасходы", НСтр("ru = 'Дополнительные расходы'"), Ложь);
		СпособыОтраженияВУчете.Добавить("ПоступлениеИзПереработки", НСтр("ru = 'Отчет переработчика'"), Ложь);

	ИначеЕсли ТипДокумента = ТипыДокументов.ТоварнаяНакладная Тогда

		СпособыОтраженияВУчете.Добавить("ПриходнаяНакладная", НСтр("ru = 'Приходная накладная'"), Истина);
        #Вставка
		СпособыОтраженияВУчете.Добавить("ПеремещениеЗапасов", НСтр("ru = 'Перемещение запасов'"), Истина);
		#КонецВставки
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СоглашениеОбИзмененииСтоимости Тогда

		СпособыОтраженияВУчете.Добавить("ОпределяетсяПрограммой", НСтр("ru = 'Определяется программой'"), Истина);
		СпособыОтраженияВУчете.Добавить("КорректировкаПоступления", НСтр("ru = 'Корректировка поступления'"), Истина);

	ИначеЕсли ТипДокумента = ТипыДокументов.АктНаПередачуПрав Тогда

		СпособыОтраженияВУчете.Добавить("ПриходнаяНакладная", НСтр("ru = 'Приходная накладная'"), Истина);

	ИначеЕсли ТипДокумента = ТипыДокументов.КаталогТоваров Тогда

		СпособыОтраженияВУчете.Добавить("НоменклатураПоставщиков", НСтр("ru = 'Номенклатура поставщиков'"), Истина);

	ИначеЕсли ТипДокумента = ТипыДокументов.ПрайсЛист Тогда
	ИначеЕсли ТипДокумента = ТипыДокументов.ОтветНаЗаказ Тогда

		СпособыОтраженияВУчете.Добавить("ЗаказПоставщику", НСтр("ru = 'Заказ поставщику'"), Истина);

	ИначеЕсли ТипДокумента = ТипыДокументов.ПередачаТоваровМеждуОрганизациями Тогда	

	ИначеЕсли ТипДокумента = ТипыДокументов.ЗаказТовара Тогда

		СпособыОтраженияВУчете.Добавить("ЗаказПокупателя", НСтр("ru = 'Заказ покупателя'"),Истина);

	ИначеЕсли ТипДокумента = ТипыДокументов.КорректировочныйСчетФактура Тогда

		СпособыОтраженияВУчете.Добавить("СчетФактураПолученный", НСтр("ru = 'Счет-фактура (полученный)'"),Истина);

	ИначеЕсли ТипДокумента = ТипыДокументов.СчетФактура Тогда

		СпособыОтраженияВУчете.Добавить("СчетФактураПолученный", НСтр("ru = 'Счет-фактура (полученный)'"), Истина);

	ИначеЕсли ТипДокумента = ТипыДокументов.СчетНаОплату Тогда

		СпособыОтраженияВУчете.Добавить("СчетНаОплатуПоставщика", НСтр("ru = 'Счет на оплату (полученный)'"), Истина);

	ИначеЕсли ТипДокумента = ТипыДокументов.ОтчетОПродажахКомиссионногоТовара Тогда
	ИначеЕсли ТипДокумента = ТипыДокументов.ТоварнаяНакладная Тогда

		СпособыОтраженияВУчете.Добавить("ПриходнаяНакладная", НСтр("ru = 'Приходная накладная'"), Истина);

	ИначеЕсли ТипДокумента = ТипыДокументов.АктОРасхождениях Тогда

		СпособыОтраженияВУчете.Добавить("АктОРасхожденияхПолученный", НСтр("ru = 'Акт о расхождениях (полученный)'"), Истина);

	ИначеЕсли ТипДокумента = ТипыДокументов.АктСверкиВзаиморасчетов Тогда

		СпособыОтраженияВУчете.Добавить("АктСверкиВзаиморасчетов", НСтр("ru = 'Акт сверки взаиморасчетов'"), Истина);

	КонецЕсли;

КонецПроцедуры

&ИзменениеИКонтроль("ЗаполнитьДанныеПередачаТоваров_ИнформацияПродавца")
Процедура спЗаполнитьДанныеПередачаТоваров_ИнформацияПродавца(Знач Основание, Знач Настройки, Данные, Описание, Отказ)  // { Разумов А.А. (TNEXT) 30.08.2025 Задача № 3950 Передача документов на склад Простор
    
    #Удаление
	УправлениеНебольшойФирмойЭлектронныеДокументыСервер.ЗаполнитьДанныеПередачаТоваров_ИнформацияПродавца(Основание, Настройки, Данные, Описание, Отказ);
    #КонецУдаления
	#Вставка	
	Если НЕ (ТипЗнч(Основание) = Тип("ДокументСсылка.ПриходнаяНакладная")
			И Основание.ВидОперации = Перечисления.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика) Тогда
		УправлениеНебольшойФирмойЭлектронныеДокументыСервер.ЗаполнитьДанныеПередачаТоваров_ИнформацияПродавца(Основание, Настройки, Данные, Описание, Отказ);
		Возврат;	
	КонецЕсли;	
	НачатьТранзакцию();
	
	Попытка
		
		// Создаем на основании Приходной Расходную
		РасходнаяНакладная = Документы.РасходнаяНакладная.СоздатьДокумент();
		
		// Заполняем Расходную
		//РасходнаяНакладная.Заполнить(СсылкаНаОбъект); 
		УправлениеНебольшойФирмойЭлектронныеДокументыСервер.Т_ЗаполнитьОбязательныеРеквизиты(РасходнаяНакладная, Основание);
		РасходнаяНакладная.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю;
		РасходнаяНакладная.ОснованиеПечати = "Договор № ПФС-012/2024 от 18.09.2024";
		// При эмуляции учет остатков не нужен.	Возврат контроля произойдет при отмене транзации.
		Константы.КонтролироватьОстаткиПриПроведении.Установить(Ложь);
		
		// Записываем Расходную накладную
		РасходнаяНакладная.Записать(РежимЗаписиДокумента.Проведение); 
		
