Процедура Документ_ПеремещениеЗапасов_Форма_ФормаДокумента_ВыболнитьКоманду_ПриемТоваров(Форма)
	
	Объект = Форма.Объект;
	
	Если Форма.Модифицированность Или Объект.Ссылка = ПредопределенноеЗначение("Документ.ПеремещениеЗапасов.ПустаяСсылка") Тогда
		
		Форма.Записать();
		
	КонецЕсли;
	
	Если ЕстьАктОРасхожденияхПриПеремещении(Объект.ЗаказНаПеремещение) Тогда
		
		Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеОкончания", ЭтотОбъект, Форма);
		ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
		ОткрытьФорму("Обработка.спПриемкаТоваровПриПеремещенииЗапасов.Форма.Форма", ПараметрыФормы,,
			Истина,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе	
        
		Текст = НСтр("ru = 'На заказ на перемещение создан Акт  о расхождениях при перемещении'");
	    ОбщегоНазначенияКлиент.СообщитьПользователю(Текст);
	
	КонецЕсли;

