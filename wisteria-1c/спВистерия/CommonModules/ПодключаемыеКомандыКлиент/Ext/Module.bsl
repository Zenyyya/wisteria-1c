Процедура Документ_ЗаказНаПеремещение_Форма_ФормаДокумента_ВыболнитьКоманду_ОтправитьСообщение(Форма) 
	Объект = Форма.Объект;
	Если Форма.ИмяФормы = "Документ.ЗаказНаПеремещение.Форма.ФормаДокумента" Тогда
		
		ОшибкаОтправкиСообщения = Ложь;
		СтруктурнаяЕдиницаРезерв = спОбщегоНазначенияВызовСервера.ПолучитьЗначениеКонстанты("спОтправлятьСообщениеДляПодсортировкиМагазина");
		
		Если Объект.Проведен И ЗначениеЗаполнено(СтруктурнаяЕдиницаРезерв) И Объект.СтруктурнаяЕдиницаРезерв = СтруктурнаяЕдиницаРезерв Тогда 
			
			ОтправкаДокументов = Новый Массив;
			ОтправкаДокументов.Добавить(Объект.Ссылка);  
			РезультатОтправки = спСервисИнтеграцииВызовСервера.ОтправитьСообщениеДокументовПоSOAP(ОтправкаДокументов);
			
			Если ТипЗнч(РезультатОтправки) = Тип("Структура") Тогда
				
				Если Не РезультатОтправки.Результат И РезультатОтправки.Свойство("СостояниеДанных") Тогда
					
					ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатОтправки.СостояниеДанных);
					
					Если РезультатОтправки.КодОшибки <> 699 Тогда 
						ОшибкаОтправкиСообщения = Истина; 
					ИначеЕсли РезультатОтправки.КодОшибки = 699 И Не ПроверитьСообщениеНаОтправкуВебСерверу(Объект) Тогда 
						ОшибкаОтправкиСообщения = Истина; 
					КонецЕсли;   
					
				ИначеЕсли Не РезультатОтправки.Результат И РезультатОтправки.Свойство("ОшибкаДанных") Тогда 
					
					ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатОтправки.ОшибкаДанных); 
					
					ОшибкаОтправкиСообщения = Истина;					
				ИначеЕсли РезультатОтправки.Результат И РезультатОтправки.Свойство("СостояниеДанных") Тогда 
					
					ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатОтправки.СостояниеДанных);
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли;  
		
		ОбновитьСостояниеСообщенияДокументЗаказНаПеремещения(Форма, Объект); 
	ИначеЕсли Форма.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда 
		Форма.Прочитать();
		
	КонецЕсли;

КонецПроцедуры 
// -- Терлецкий АВ 25.02.18  

Процедура Документ_ЗаказНаПеремещение_Форма_ФормаДокумента_УстановитьИнтервал(Форма)
	
	Элементы = Форма.Элементы;
	ИмяФормы = Форма.ИмяФормы;
	Интервал = Форма["спИнтервал"];
	
	Элементы.Список.Автообновление = Интервал <> 0;
	Элементы.Список.ПериодАвтообновления = Интервал;
	Элементы.Список.Обновить();
	
	спПодключаемыеКомандыВызовСервера.СохранитьИнтервалОбновленияСписка(ИмяФормы, Интервал);

КонецПроцедуры

