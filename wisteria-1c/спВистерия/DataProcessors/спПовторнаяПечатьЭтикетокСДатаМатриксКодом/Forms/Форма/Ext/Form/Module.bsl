&НаКлиенте
&Вместо("Печать")
Процедура сп_Печать(Команда)
	
	ОчиститьСообщения();
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ПомеченныеСтроки = ШтрихкодыУпаковок.НайтиСтроки(Новый Структура("Пометка", Истина));
	
	Если ПомеченныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет данных для печати кодов маркировки'"));
		Возврат;
	КонецЕсли;
	
	ПараметрКоманды = Новый Массив;
	ПараметрКоманды.Добавить(ПредопределенноеЗначение("Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка"));
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("КоличествоЭкземпеляров", 1);
	ПараметрыПечати.Вставить("СтруктураДанных", ДанныеПечатиСЗаполненнымШаблоном());
	ПараметрыПечати.Вставить("АдресВХранилище", "");
	ПараметрыПечати.Вставить("КаждаяЭтикеткаНаНовомЛисте", Истина);
	ПараметрыПечати.Вставить("СразуНаПринтер", СразуНаПринтер);
	ПараметрыПечати.Вставить("РежимПечати", "ЭтикеткаКодМаркировкиИСМП");
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
		"Обработка.ПечатьЭтикетокИЦенников",
		"ЭтикеткаКодМаркировкиИСМП",
		ПараметрКоманды,
		ВладелецФормы,
		ПараметрыПечати);
	
	сп_ОчиститьОчередьПечатиПослеПечати();
	
	Если ЗакрыватьПослеПечати Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура сп_ОчиститьОчередьПечатиПослеПечати()
	
	ШтрихкодыУпаковок.Очистить();
	
	Если Элементы.Найти("ШтрихкодыУпаковок") <> Неопределено Тогда
		Элементы.ШтрихкодыУпаковок.Видимость = Ложь;
	КонецЕсли;
	
	Если Элементы.Найти("ФормаПечать") <> Неопределено Тогда
		Элементы.ФормаПечать.Заголовок = СтрШаблон(НСтр("ru = 'Печать (%1)'"), 0);
	КонецЕсли;
	
КонецПроцедуры //--->>> Tnext Козык К.А. - Вистерия - 25.06.2026