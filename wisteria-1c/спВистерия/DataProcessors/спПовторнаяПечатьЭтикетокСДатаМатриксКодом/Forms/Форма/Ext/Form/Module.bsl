			Неопределено,
			ЭтотОбъект);

	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
&После("ПриЗакрытии")
Процедура сп_ПриЗакрытииПосле(ЗавершениеРаботы)

	Попытка

		МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(
			Неопределено,
			ЭтотОбъект);

	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
&Вместо("ОбработкаОповещения")
Процедура сп_ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ScanData" Тогда

		Штрихкод = сп_ШтрихкодИзПараметраСканера(Параметр);

		Если Не ПустаяСтрока(Штрихкод) Тогда
			сп_ОбработатьШтрихкодТСД(Штрихкод);
			Возврат;
		КонецЕсли;

		ДанныеСканера = Неопределено;

		Попытка

			Если ТипЗнч(Параметр) <> Тип("Массив") Тогда
				Параметр = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Параметр);
			КонецЕсли;

			ДанныеСканера = МенеджерОборудованияУНФКлиент.ПреобразоватьДанныеСоСканераВМассив(Параметр);

		Исключение

			ДанныеСканера = Неопределено;

		КонецПопытки;

		Если ДанныеСканера <> Неопределено
			И ДанныеСканера.Количество() > 0 Тогда

			ПолученШтрихкод(ДанныеСканера);
			Возврат;

		КонецЕсли;

		Возврат;

	КонецЕсли;

	Попытка

		МенеджерОборудованияКлиент.ОбработатьСобытиеОтУстройства(
			Новый Структура(
				"Источник,Событие,Данные",
				Источник,
				ИмяСобытия,
				Параметр));

	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОборудованиеШтрихкодПолучен(Штрихкод, ДополнительныеПараметры) Экспорт

	сп_ОбработатьШтрихкодТСД(Штрихкод);

КонецПроцедуры

&НаКлиенте
Процедура сп_ОбработатьШтрихкодТСД(Штрихкод)

	Штрихкод = сп_НормализоватьШтрихкодСканера(Штрихкод);

	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат;
	КонецЕсли;

	ОчиститьСообщения();

	ДанныеШтрихкода = Новый Структура("Штрихкод, Количество", Штрихкод, 1);

	ПолученШтрихкод(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеШтрихкода));

КонецПроцедуры

&НаКлиенте
Функция сп_ШтрихкодИзПараметраСканера(Параметр)

	Штрихкод = "";
	ДанныеСканера = Неопределено;

	Если ТипЗнч(Параметр) = Тип("Массив") Тогда

		Если Параметр.Количество() = 0 Тогда
			Возврат "";
		КонецЕсли;

		ДанныеСканера = Параметр[0];

	Иначе

		ДанныеСканера = Параметр;

	КонецЕсли;

	Если ДанныеСканера = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(ДанныеСканера) = Тип("Структура") Тогда

		Если ДанныеСканера.Свойство("Штрихкод") Тогда
			Штрихкод = Строка(ДанныеСканера.Штрихкод);
		ИначеЕсли ДанныеСканера.Свойство("ШтрихКод") Тогда
			Штрихкод = Строка(ДанныеСканера.ШтрихКод);
		ИначеЕсли ДанныеСканера.Свойство("Barcode") Тогда
			Штрихкод = Строка(ДанныеСканера.Barcode);
		ИначеЕсли ДанныеСканера.Свойство("Data") Тогда
			Штрихкод = Строка(ДанныеСканера.Data);
		ИначеЕсли ДанныеСканера.Свойство("Данные") Тогда
			Штрихкод = Строка(ДанныеСканера.Данные);
		ИначеЕсли ДанныеСканера.Свойство("Code") Тогда
			Штрихкод = Строка(ДанныеСканера.Code);
		ИначеЕсли ДанныеСканера.Свойство("Value") Тогда
			Штрихкод = Строка(ДанныеСканера.Value);
		КонецЕсли;

	Иначе

		Штрихкод = Строка(ДанныеСканера);

	КонецЕсли;

	Возврат сп_НормализоватьШтрихкодСканера(Штрихкод);

КонецФункции

&НаКлиенте
Функция сп_НормализоватьШтрихкодСканера(Штрихкод)

	Штрихкод = СокрЛП(Строка(Штрихкод));

	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат "";
	КонецЕсли;

	Для каждого Префикс Из СтрРазделить("]d2,]C1,]Q3,]e0", ",") Цикл

		Если Лев(Штрихкод, СтрДлина(Префикс)) = Префикс Тогда
			Штрихкод = Сред(Штрихкод, СтрДлина(Префикс) + 1);
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Штрихкод;

КонецФункции  //--->>> Tnext Козык К.А. 24.06.2026

