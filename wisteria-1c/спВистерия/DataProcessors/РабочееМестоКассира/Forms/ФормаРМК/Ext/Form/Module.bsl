
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура спПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	НовыйЭлментСписка = Элементы.Вставить("Бренд", тип("ПолеФормы"), Элементы.СписокТоваров, Элементы.СписокТоваров.ПодчиненныеЭлементы["СписокТоваровНаименование"]);
	НовыйЭлментСписка.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлментСписка.ПутьКДанным = "СписокТоваров.Бренд";
	НовыйЭлментСписка.Заголовок = "Бренд";
	НовыйЭлментСписка.ШрифтЗаголовка = Новый Шрифт(ШрифтыСтиля.КрупныйШрифтТекста); 
	
	КомандыОткрытьОтчет = ЭтотОбъект.Команды.Найти("спКомандаОткрытьОтчет");
	
	Если КомандыОткрытьОтчет = Неопределено Тогда
		
		ИмяКоманды  = "спКомандаОткрытьОтчет";
		ИмяЭлемента = "спЭлементОткрытьОтчет";
		
		НоваяКоманда = ЭтотОбъект.Команды.Добавить(ИмяКоманды);
		НоваяКоманда.Действие  = ИмяКоманды;
		НоваяКоманда.Заголовок = "Открыть отчет";
		
		НовыйЭлемент = ЭтотОбъект.Элементы.Добавить(ИмяЭлемента, Тип("КнопкаФормы"), ЭтотОбъект.Элементы.ПодгруппаОперации2);
		НовыйЭлемент.ИмяКоманды = ИмяКоманды;
		
	КонецЕсли;
	
	// { Иванов С.С. (TNext) - 25.03.2025 - Задача №1168 
	// команда "Опрос"
	ИмяКоманды = "спОпросКлиента";
	ЗаголовокКоманды = НСтр("ru = 'Опрос'");
	
	КомандаОпрос = Команды.Добавить(ИмяКоманды);
	КомандаОпрос.Действие = "спОпросКлиента";
	КомандаОпрос.Заголовок = ЗаголовокКоманды;
	КомандаОпрос.Картинка = БиблиотекаКартинок.ВосклицательныйЗнакКрасный;
	
	Родитель = Элементы.Найти("ГруппаСводныеДанныеЧека");
	ЭлементПеред = Элементы.Найти("ГруппаСуммаСкидки");
	КнопкаОпрос = Элементы.Вставить(ИмяКоманды, Тип("КнопкаФормы"), Родитель, ЭлементПеред);
	КнопкаОпрос.ИмяКоманды = ИмяКоманды;
	// }
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиКоманд

&НаКлиенте
Процедура спКомандаОткрытьОтчет(Команда)

	Перем ФормаОтчёта, КомпоновщикНастроек, Период, ПараметрыФормы;
	
	ФормаОтчёта = ПолучитьФорму("Отчет.спПродажиКасса.Форма");
	КомпоновщикНастроек = ФормаОтчёта.Отчет.КомпоновщикНастроек; 
	
	ПередЗагрузкойПользовательскихНастроекНаСервере(КомпоновщикНастроек.ПользовательскиеНастройки);
	
	Период = Новый СтандартныйПериод();
	Период = Новый СтандартныйПериод(ВариантСтандартногоПериода.Сегодня);
	
	УстановитьПользовательскийПараметрСКД(КомпоновщикНастроек, "Период", Период);
	УстановитьПользовательскийОтборСКД(КомпоновщикНастроек, "Организация", ПредопределенноеЗначение("Справочник.Организации.ОсновнаяОрганизация"));
	// { Иванов С.С. (TNext) - 24.06.2025 - Задача №2862 
	УстановитьПользовательскийПараметрСКД(КомпоновщикНастроек, "ТолькоЧеки", Истина);
	УстановитьПользовательскийОтборСКД(КомпоновщикНастроек, "Склад", Объект.ТорговыйОбъект);
	УстановитьПользовательскийОтборСКД(КомпоновщикНастроек, "ЗаказПокупателя", ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка"));
	// }	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	//ПараметрыФормы.Вставить("Отбор", Новый Структура("Склад", Объект.ТорговыйОбъект));
	ПараметрыФормы.Вставить("ПользовательскиеНастройки", КомпоновщикНастроек.ПользовательскиеНастройки); 
	
	ОткрытьФорму("Отчет.спПродажиКасса.Форма", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры  
// -- Терлецкий АВ 25.02.18

&НаКлиенте
Процедура спОпросКлиента(Команда)
	
	Контрагент = ?(ЗначениеЗаполнено(Объект.Контрагент), Объект.Контрагент, спВладелецДисконтнойКарты(Объект.ДисконтнаяКарта));
	
	ПараметрФормы = Новый Структура("Контрагент", Контрагент);
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("спПослеОпросаКлиента", ЭтотОбъект);
		
	ОткрытьФорму("ОбщаяФорма.спФормаОпросаКлиентаРМК", ПараметрФормы, 
		ЭтотОбъект,,,,ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

 #Область СлужебныеПроцедурыИФункции

// -- Терлецкий АВ 25.02.18 
 &НаКлиенте
Процедура ПередЗагрузкойПользовательскихНастроекНаСервере(Настройки)
        Для каждого Настройка Из Настройки.Элементы Цикл
            Если ТипЗнч(Настройка) = Тип("ОтборКомпоновкиДанных") Тогда
                Настройка.Элементы.Очистить();
            КонецЕсли;
        КонецЦикла; 
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПользовательскийПараметрСКД(КомпоновщикНастроек, ИмяПараметра, Значение)
	
	Перем ПараметрДанных, Настройки, ПользовательскиеНастройки, ПользовательскийПараметр;
	
	Настройки = КомпоновщикНастроек.Настройки;
	
	ПараметрДанных = Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	
	Если ЗначениеЗаполнено(ПараметрДанных.ИдентификаторПользовательскойНастройки) Тогда
		
		ПользовательскиеНастройки = КомпоновщикНастроек.ПользовательскиеНастройки;
		ПользовательскийПараметр = ПользовательскиеНастройки.Элементы.Найти(ПараметрДанных.ИдентификаторПользовательскойНастройки);
		ПользовательскийПараметр.Использование = Истина;
		ПользовательскийПараметр.Значение = Значение;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьПользовательскийОтборСКД(КомпоновщикНастроек, ИмяОтбора, Значение, ВидСравнения = Неопределено)
	
	Перем	ПолеКД, Элем, ЭлементОтбора, Настройки, 
			ПользовательскиеНастройки, ПользовательскийОтбор;
	
	Настройки = КомпоновщикНастроек.Настройки;
	
	ПолеКД = Новый ПолеКомпоновкиДанных(ИмяОтбора);
	
	Для Каждого Элем Из Настройки.Отбор.Элементы Цикл
		
		Если Элем.ЛевоеЗначение = ПолеКД Тогда
			ЭлементОтбора = Элем;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЭлементОтбора = Неопределено Тогда
		Возврат;		
	КонецЕсли;		
	
	Если ЗначениеЗаполнено(ЭлементОтбора.ИдентификаторПользовательскойНастройки) Тогда
		
		ПользовательскиеНастройки = КомпоновщикНастроек.ПользовательскиеНастройки;
 		ПользовательскийОтбор = ПользовательскиеНастройки.Элементы.Найти(ЭлементОтбора.ИдентификаторПользовательскойНастройки);
		ПользовательскийОтбор.Использование = (Значение <> Неопределено);
		ПользовательскийОтбор.ВидСравнения = ?(ВидСравнения <> Неопределено, ВидСравнения, ВидСравненияКомпоновкиДанных.Равно); 
		ПользовательскийОтбор.ПравоеЗначение  = Значение;
	КонецЕсли;

КонецПроцедуры //  УстановитьПользовательскийОтборСКД

