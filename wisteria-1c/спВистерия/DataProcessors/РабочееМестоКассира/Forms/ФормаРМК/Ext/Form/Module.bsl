&НаКлиенте
Функция спОбновитьДоступностьОпросаКлиента() Экспорт
	
	Контрагент 			= ?(ЗначениеЗаполнено(Объект.ДисконтнаяКарта), спВладелецДисконтнойКарты(Объект.ДисконтнаяКарта), Объект.Контрагент);
	спИсточникРекламы 	= спИсточникРекламыВистерия(Контрагент);
		
	Если ЗначениеЗаполнено(Контрагент) И ЗначениеЗаполнено(спИсточникРекламы) Тогда
		
		Элементы.спОпросКлиента.Доступность = Ложь;
		Элементы.спОпросКлиента.Отображение = ОтображениеКнопки.Текст;
		
	Иначе
		
		Элементы.спОпросКлиента.Доступность = Истина;
		Элементы.спОпросКлиента.Отображение = ОтображениеКнопки.КартинкаИТекст;
		
	КонецЕсли;
	
	Возврат Элементы.спОпросКлиента.Доступность;
	
КонецФункции

&НаКлиенте
Процедура спПослеОпросаКлиента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КомментарийКЧеку = СтрШаблон("%1", Результат);
	
	спОбновитьДоступностьОпросаКлиента();
	
КонецПроцедуры

