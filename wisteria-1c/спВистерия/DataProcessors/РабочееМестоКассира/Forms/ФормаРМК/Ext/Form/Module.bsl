//<<<--- Tnext Козык К.А. 27.08.2026
// После штатного добавления подарочного сертификата в корзину
// восстанавливаем серию по считанному номеру сертификата.
&НаСервере
&После("ЗаполнитьДанныеПоШтрихкоду")
Процедура спЗаполнитьДанныеПоШтрихкодуПосле(
	СтрокаРезультата,
	ПараметрыДляОбработкиШтрихкода,
	РезультатКонтроляПродаж)
	
	Если СтрокаРезультата = Неопределено
		Или ПараметрыДляОбработкиШтрихкода = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	// Доработка нужна только в сценарии, когда штатный механизм
	// уже добавил новую строку товара по считанному штрихкоду.
	Если Не ПараметрыДляОбработкиШтрихкода.Свойство(
		"СтрокаТовараДобавлена") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	// При возврате и иных операциях автоматическую привязку серии
	// нового подарочного сертификата не выполняем.
	Если Не ОбщегоНазначенияРМК.ЭтоВидОперацииПродажа(
		Объект.ВидОперации) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	НомерСертификата = "";
	
	Если Не ПараметрыДляОбработкиШтрихкода.Свойство(
		"Штрихкод",
		НомерСертификата)
		Или ПустаяСтрока(НомерСертификата) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ИдентификаторСтроки = Неопределено;
	
	Если Не ПараметрыДляОбработкиШтрихкода.Свойство(
		"ИдентификаторСтроки",
		ИдентификаторСтроки)
		Или Не ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОтборСтроки =
		Новый Структура(
			"ИдентификаторСтроки",
			ИдентификаторСтроки);
	
	СтрокиТоваров =
		Объект.Товары.НайтиСтроки(ОтборСтроки);
	
	Если СтрокиТоваров.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТовара = СтрокиТоваров[0];
	
	Если Не ОбщегоНазначенияРМК.
		ЭтоТипНоменклатурыПодарочныйСертификат(
			СтрокаТовара.ТипНоменклатуры) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если СерииНеВыгружаются Тогда
		
		Если ЗначениеЗаполнено(
			СтрокаТовара.ИдентификаторСерий) Тогда
			
			Возврат;
			
		КонецЕсли;
		
	Иначе
		
		Если ЗначениеЗаполнено(СтрокаТовара.Серия) Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	СерияПодарочногоСертификата =
		спВистерияРМКСервер.
			спНайтиСериюПодарочногоСертификатаПоНомеру(
				СтрокаТовара.Номенклатура,
				НомерСертификата);
	
	Если Не ЗначениеЗаполнено(
		СерияПодарочногоСертификата) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если СерииНеВыгружаются Тогда
		
		СтрокаТовара.ИдентификаторСерий =
			Строка(
				СерияПодарочногоСертификата.
					УникальныйИдентификатор());
		
	Иначе
		
		СтрокаТовара.Серия =
			СерияПодарочногоСертификата;
		
	КонецЕсли;
	
	СтрокаТовара.СерияПредставление =
		Строка(СерияПодарочногоСертификата);
	
	// Используем отдельный флаг, а не штатный "СерияВведена".
	// Это позволяет штатно завершить первоначальное добавление товара,
	// а затем выполнить стандартную обработку выбранной серии.
	ПараметрыДляОбработкиШтрихкода.Вставить(
		"спСерияПодарочногоСертификатаЗаполнена",
		Истина);
	
КонецПроцедуры
//--->>> Tnext Козык К.А. 27.08.2026

//<<<--- Tnext Козык К.А. 27.08.2026
// После штатного завершения добавления товара выполняем стандартную
// обработку серии подарочного сертификата.
&НаКлиенте
&После("ЗавершитьВводШтрихкода")
Процедура спЗавершитьВводШтрихкодаПосле(
	ПараметрыДляОбработкиШтрихкода)
	
	Если ПараметрыДляОбработкиШтрихкода = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СерияПодарочногоСертификатаЗаполнена = Ложь;
	
	Если Не ПараметрыДляОбработкиШтрихкода.Свойство(
		"спСерияПодарочногоСертификатаЗаполнена",
		СерияПодарочногоСертификатаЗаполнена)
		Или Не СерияПодарочногоСертификатаЗаполнена Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОбработатьВыборСерии();
	
КонецПроцедуры
//--->>> Tnext Козык К.А. 27.08.2026

#КонецОбласти 
