#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	сп_ИнициализироватьПериод();
	сп_НастроитьИнтерфейсСписка();
	ЗаполнитьСписокЗаказовНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)

	ЗаполнитьСписокЗаказовНаСервере();

	Попытка
		Элементы.Данные.Обновить();
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)

	ЗаполнитьСписокЗаказовНаСервере();

	Попытка
		Элементы.Данные.Обновить();
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ДанныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ТекущиеДанные = Элементы.Данные.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не сп_СтрокаЗаказаВРаботеКлиент(ТекущиеДанные) Тогда
		ТекущиеДанные.Выбрано = Ложь;
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заказ недоступен для отгрузки. Заказ выполнен или завершен.");
		Возврат;
	КонецЕсли;

	ТекущиеДанные.Выбрано = НЕ ТекущиеДанные.Выбрано;

КонецПроцедуры

&НаКлиенте
Процедура ДанныеВыбраноПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Данные.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не сп_СтрокаЗаказаВРаботеКлиент(ТекущиеДанные) Тогда

		ТекущиеДанные.Выбрано = Ложь;
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заказ недоступен для отгрузки. Заказ выполнен или завершен.");

		Попытка
			Элементы.Данные.Обновить();
		Исключение
		КонецПопытки;

		Возврат;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДанныеПередУдалением(Элемент, Отказ)

	Отказ = Истина;

	ТекущиеДанные = Элементы.Данные.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Заказ) Тогда
		Возврат;
	КонецЕсли;

	Результат = сп_ПометитьЗаказНаУдалениеНаСервере(ТекущиеДанные.Заказ);

	Если ЗначениеЗаполнено(Результат) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат);
	КонецЕсли;

	ЗаполнитьСписокЗаказовНаСервере();

	Попытка
		Элементы.Данные.Обновить();
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура ОбновитьСписок(Команда)

	ЗаполнитьСписокЗаказовНаСервере();

	Попытка
		Элементы.Данные.Обновить();
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОтгрузку(Команда)

	ЗаказыДляПередачи = сп_ПолучитьВыбранныеЗаказыСериализованныеНаСервере();

	Если Не ЗначениеЗаполнено(ЗаказыДляПередачи) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите хотя бы один доступный заказ на перемещение.");
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗаказыСериализованные", ЗаказыДляПередачи);
	ПараметрыФормы.Вставить("Заказы", сп_ПолучитьВыбранныеЗаказыСпискомЗначенийНаСервере());

	ОткрытьФорму(
		"Обработка.спАРМРаботникаСклада.Форма.спОтгрузкаСклады",
		ПараметрыФормы,
		ЭтаФорма);

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДанных

&НаСервере
Процедура ЗаполнитьСписокЗаказовНаСервере()

	сп_ИнициализироватьПериод();

	ВыбранныеЗаказы = сп_ПолучитьВыбранныеЗаказыМассивомНаСервере();

	Данные.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|   ЗаказЗапасы.Ссылка КАК Заказ,
	|   СУММА(ЗаказЗапасы.Количество) КАК КоличествоПлан
	|ПОМЕСТИТЬ ВТ_План
	|ИЗ
	|   Документ.ЗаказНаПеремещение.Запасы КАК ЗаказЗапасы
	|ГДЕ
	|   ЗаказЗапасы.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|   И НЕ ЗаказЗапасы.Ссылка.ПометкаУдаления
	|   И ЗаказЗапасы.Ссылка.Организация.ИНН = &ИННОрганизацииВистерия
	|
	|СГРУППИРОВАТЬ ПО
	|   ЗаказЗапасы.Ссылка
	|;
	|
	|ВЫБРАТЬ
	|   Перемещение.ДокументОснование КАК Заказ,
	|   СУММА(ПеремещениеЗапасы.Количество) КАК КоличествоФакт
	|ПОМЕСТИТЬ ВТ_Факт
	|ИЗ
	|   Документ.ПеремещениеЗапасов.Запасы КАК ПеремещениеЗапасы
	|       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПеремещениеЗапасов КАК Перемещение
	|       ПО ПеремещениеЗапасы.Ссылка = Перемещение.Ссылка
	|ГДЕ
	|   НЕ Перемещение.ПометкаУдаления
	|   И Перемещение.ДокументОснование В
	|       (ВЫБРАТЬ
	|           ВТ_План.Заказ
	|       ИЗ
	|           ВТ_План КАК ВТ_План)
	|
	|СГРУППИРОВАТЬ ПО
	|   Перемещение.ДокументОснование
	|;
	|
	|ВЫБРАТЬ
	|   ДокЗаказ.Ссылка КАК Заказ,
	|   ДокЗаказ.Дата КАК Дата,
	|   ДокЗаказ.Номер КАК Номер,
	|   ДокЗаказ.СостояниеЗаказа КАК СостояниеЗаказа,
	|   ВЫБОР
	|       КОГДА ДокЗаказ.СостояниеЗаказа = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовНаПеремещение.Завершен)
	|           ТОГДА ЛОЖЬ
	|       ИНАЧЕ ИСТИНА
	|   КОНЕЦ КАК ЗаказВРаботе,
	|   ВЫБОР
	|       КОГДА ДокЗаказ.СостояниеЗаказа = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовНаПеремещение.Завершен)
	|           ТОГДА 1
	|       ИНАЧЕ 0
	|   КОНЕЦ КАК ПорядокСтатуса,
	|   ДокЗаказ.СтруктурнаяЕдиницаРезерв КАК Склад,
	|   ДокЗаказ.СтруктурнаяЕдиницаПолучатель КАК СкладПолучатель,
	|   ЕСТЬNULL(ВТ_План.КоличествоПлан, 0) КАК КоличествоПлан,
	|   ЕСТЬNULL(ВТ_Факт.КоличествоФакт, 0) КАК КоличествоФакт
	|ИЗ
	|   Документ.ЗаказНаПеремещение КАК ДокЗаказ
	|       ЛЕВОЕ СОЕДИНЕНИЕ ВТ_План КАК ВТ_План
	|       ПО ДокЗаказ.Ссылка = ВТ_План.Заказ
	|       ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Факт КАК ВТ_Факт
	|       ПО ДокЗаказ.Ссылка = ВТ_Факт.Заказ
	|ГДЕ
	|   НЕ ДокЗаказ.ПометкаУдаления
	|   И ДокЗаказ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|   И ДокЗаказ.Организация.ИНН = &ИННОрганизацииВистерия
	|
	|УПОРЯДОЧИТЬ ПО
	|   ДокЗаказ.Дата,
	|   ДокЗаказ.Номер";

	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ИННОрганизацииВистерия", "9728121825");

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Отклонение = Выборка.КоличествоПлан - Выборка.КоличествоФакт;

		Если Отклонение < 0 Тогда
			Отклонение = 0;
		КонецЕсли;

		СтрокаСписка = Данные.Добавить();

		Если Выборка.ЗаказВРаботе Тогда
			СтрокаСписка.Выбрано = ВыбранныеЗаказы.Найти(Выборка.Заказ) <> Неопределено;
		Иначе
			СтрокаСписка.Выбрано = Ложь;
		КонецЕсли;

		СтрокаСписка.Заказ = Выборка.Заказ;
		СтрокаСписка.Дата = Выборка.Дата;
		СтрокаСписка.Номер = Выборка.Номер;
		СтрокаСписка.Склад = Выборка.Склад;
		СтрокаСписка.СкладПолучатель = Выборка.СкладПолучатель;
		СтрокаСписка.Наименование = Строка(Выборка.Заказ);

		Попытка
			СтрокаСписка.СостояниеЗаказа = Выборка.СостояниеЗаказа;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаСписка.ЗаказВРаботе = Выборка.ЗаказВРаботе;
		Исключение
		КонецПопытки;


		Попытка
			СтрокаСписка.ПорядокСтатуса = Выборка.ПорядокСтатуса;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаСписка.ДатаСортировки = Выборка.Дата;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаСписка.НомерСортировки = СокрЛП(Строка(Выборка.Номер));
		Исключение
		КонецПопытки;

		Попытка
			СтрокаСписка.КоличествоПлан = Выборка.КоличествоПлан;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаСписка.КоличествоФакт = Выборка.КоличествоФакт;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаСписка.Отклонение = Отклонение;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаСписка.СтатусСканирования = Строка(Выборка.КоличествоФакт) + " из " + Строка(Выборка.КоличествоПлан) + " отсканировано";
		Исключение
		КонецПопытки;

		НомерЗаказа = СокрЛП(Строка(Выборка.Номер));

		Если ЗначениеЗаполнено(НомерЗаказа) Тогда
			ПредставлениеЗаказа = "№" + НомерЗаказа + " от " + Формат(Выборка.Дата, "ДФ=dd.MM.yyyy");
		Иначе
			ПредставлениеЗаказа = Строка(Выборка.Заказ);
		КонецЕсли;

		СтрокаСписка.Представление = ПредставлениеЗаказа;

	КонецЦикла;

	Попытка
		Данные.Сортировать("ПорядокСтатуса, ДатаСортировки Убыв, НомерСортировки Убыв");
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область РаботаСВыбором

&НаСервере
Функция сп_ПолучитьВыбранныеЗаказыСпискомЗначенийНаСервере()

	СписокЗаказов = Новый СписокЗначений;

	Для каждого СтрокаСписка Из Данные Цикл

		Если СтрокаСписка.Выбрано
			И сп_СтрокаЗаказаВРаботеНаСервере(СтрокаСписка)
			И ЗначениеЗаполнено(СтрокаСписка.Заказ) Тогда

			Если СписокЗаказов.НайтиПоЗначению(СтрокаСписка.Заказ) = Неопределено Тогда
				СписокЗаказов.Добавить(СтрокаСписка.Заказ, Строка(СтрокаСписка.Заказ));
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Возврат СписокЗаказов;

КонецФункции

&НаСервере
Функция сп_ПолучитьВыбранныеЗаказыСериализованныеНаСервере()

	СписокЗаказов = сп_ПолучитьВыбранныеЗаказыСпискомЗначенийНаСервере();

	Если СписокЗаказов.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат ЗначениеВСтрокуВнутр(СписокЗаказов);

КонецФункции

&НаСервере
Функция сп_ПолучитьВыбранныеЗаказыМассивомНаСервере()

	Результат = Новый Массив;

	Для каждого СтрокаСписка Из Данные Цикл

		Если СтрокаСписка.Выбрано
			И сп_СтрокаЗаказаВРаботеНаСервере(СтрокаСписка)
			И ЗначениеЗаполнено(СтрокаСписка.Заказ) Тогда

			Результат.Добавить(СтрокаСписка.Заказ);

		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область УдалениеЗаказов

&НаСервере
Функция сп_ПометитьЗаказНаУдалениеНаСервере(Заказ)

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат "Не удалось определить заказ для удаления.";
	КонецЕсли;

	Если сп_ЕстьПеремещенияПоЗаказуНаСервере(Заказ) Тогда
		Возврат "По заказу уже есть перемещения. Заказ не удален.";
	КонецЕсли;

	Попытка
		ОбъектЗаказа = Заказ.ПолучитьОбъект();
		ОбъектЗаказа.УстановитьПометкуУдаления(Истина);
		Возврат "Заказ помечен на удаление: " + Строка(Заказ);
	Исключение
		Возврат "Не удалось пометить заказ на удаление: " + ОписаниеОшибки();
	КонецПопытки;

КонецФункции

&НаСервере
Функция сп_ЕстьПеремещенияПоЗаказуНаСервере(Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|   Перемещение.Ссылка КАК Ссылка
	|ИЗ
	|   Документ.ПеремещениеЗапасов КАК Перемещение
	|ГДЕ
	|   НЕ Перемещение.ПометкаУдаления
	|   И Перемещение.ДокументОснование = &Заказ";

	Запрос.УстановитьПараметр("Заказ", Заказ);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Возврат Выборка.Следующий();
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура сп_ИнициализироватьПериод()

	Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура сп_НастроитьИнтерфейсСписка()

	Попытка
		Элементы.Данные.ВысотаСтроки = 95;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеВыбрано.Заголовок = "Выбрано";
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеПредставление.Заголовок = "Заказ";
		Элементы.ДанныеПредставление.МногострочныйРежим = Истина;
		Элементы.ДанныеПредставление.АвтоПереносСтрок = Истина;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеНаименование.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеЗаказ.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеДата.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеНомер.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеСклад.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеСкладПолучатель.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеКоличествоПлан.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеКоличествоФакт.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеОтклонение.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеСтатусСканирования.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеВыполнен.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеСостояниеЗаказа.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеЗаказВРаботе.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеПорядокСтатуса.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеДатаСортировки.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеНомерСортировки.Видимость = Ложь;
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсеПриИзменении(Элемент)

	Для каждого СтрокаСписка Из Данные Цикл

		Если сп_СтрокаЗаказаВРаботеКлиент(СтрокаСписка) Тогда
			СтрокаСписка.Выбрано = ВыбратьВсе;
		Иначе
			СтрокаСписка.Выбрано = Ложь;
		КонецЕсли;

	КонецЦикла;

	Попытка
		Элементы.Данные.Обновить();
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция сп_СтрокаЗаказаВРаботеКлиент(СтрокаСписка)

	Попытка
		Возврат СтрокаСписка.ЗаказВРаботе;
	Исключение
	КонецПопытки;

	Возврат Ложь;

КонецФункции

&НаСервере
Функция сп_СтрокаЗаказаВРаботеНаСервере(СтрокаСписка)

	Попытка
		Возврат СтрокаСписка.ЗаказВРаботе;
	Исключение
	КонецПопытки;

	Если ЗначениеЗаполнено(СтрокаСписка.Заказ) Тогда
		Попытка
			Возврат СтрокаСписка.Заказ.СостояниеЗаказа <> Справочники.СостоянияЗаказовНаПеремещение.Завершен;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

#КонецОбласти
