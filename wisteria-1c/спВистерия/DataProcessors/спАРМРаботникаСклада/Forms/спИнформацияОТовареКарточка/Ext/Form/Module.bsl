#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	сп_ИнициализироватьПараметрыФормы();
	сп_НастроитьИнтерфейс();
	ЗаполнитьКарточкуТовараНаСервере();

КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура ПредыдущаяКартинка(Команда)

	сп_ПереключитьКартинкуНаСервере(-1);

КонецПроцедуры

&НаКлиенте
Процедура СледующаяКартинка(Команда)

	сп_ПереключитьКартинкуНаСервере(1);

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеФормы

&НаСервере
Процедура ЗаполнитьКарточкуТовараНаСервере()

	Если Не ЗначениеЗаполнено(ТекущаяНоменклатура) Тогда
		Возврат;
	КонецЕсли;

	РеквизитыТовара = сп_РеквизитыТовараДляОтображения(ТекущаяНоменклатура);

	Наименование = РеквизитыТовара.Наименование;
	Артикул = РеквизитыТовара.Артикул;
	Бренд = РеквизитыТовара.Бренд;
	Цвет = РеквизитыТовара.Цвет;
	Размер = РеквизитыТовара.Размер;
	Сезон = РеквизитыТовара.Сезон;

	РозничнаяЦена = сп_ПредставлениеЦеныНоменклатуры(ТекущаяНоменклатура, "%рознич%");
	АкционнаяЦена = сп_ПредставлениеЦеныНоменклатуры(ТекущаяНоменклатура, "%акцион%");

	//<<<--- Tnext Козык К.А. 16.07.2026
	сп_ЗаполнитьОстаткиТовараНаСервере();
	//--->>> Tnext Козык К.А. 16.07.2026

	сп_ЗаполнитьИзображенияТовараНаСервере();

	ИндексКартинки = 0;
	сп_УстановитьТекущуюКартинкуНаСервере();
	сп_ОбновитьВидимостьЛистанияНаСервере();

КонецПроцедуры

#КонецОбласти

#Область Остатки

//<<<--- Tnext Козык К.А. 29.07.2026
&НаСервере
Процедура сп_ЗаполнитьОстаткиТовараНаСервере()

	Если Не ЗначениеЗаполнено(ТекущаяНоменклатура) Тогда
		Остатки.Очистить();
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиЗапасов.СтруктурнаяЕдиница КАК Склад,
	|	ЕСТЬNULL(
	|		ОстаткиЗапасов.Ячейка,
	|		ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) КАК Ячейка,
	|	СУММА(ОстаткиЗапасов.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.ЗапасыНаСкладах.Остатки(
	|		&МоментПолученияОстатков,
	|		Номенклатура = &Номенклатура) КАК ОстаткиЗапасов
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиЗапасов.СтруктурнаяЕдиница,
	|	ЕСТЬNULL(
	|		ОстаткиЗапасов.Ячейка,
	|		ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка))
	|
	|ИМЕЮЩИЕ
	|	СУММА(ОстаткиЗапасов.КоличествоОстаток) > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склад,
	|	Ячейка";

	Запрос.УстановитьПараметр(
		"МоментПолученияОстатков",
		ТекущаяДатаСеанса());

	Запрос.УстановитьПараметр(
		"Номенклатура",
		ТекущаяНоменклатура);

	РезультатЗапроса = Запрос.Выполнить();

	ЗначениеВРеквизитФормы(
		РезультатЗапроса.Выгрузить(),
		"Остатки");

КонецПроцедуры
//--->>> Tnext Козык К.А. 29.07.2026

#КонецОбласти

#Область Картинки

&НаСервере
Процедура сп_ПереключитьКартинкуНаСервере(Смещение)

	Если Изображения.Количество() = 0 Тогда
		АдресКартинкиТекущий = "";
		СчетчикИзображений = "";
		Возврат;
	КонецЕсли;

	ИндексКартинки = ИндексКартинки + Смещение;

	Если ИндексКартинки < 0 Тогда
		ИндексКартинки = Изображения.Количество() - 1;
	КонецЕсли;

	Если ИндексКартинки >= Изображения.Количество() Тогда
		ИндексКартинки = 0;
	КонецЕсли;

	сп_УстановитьТекущуюКартинкуНаСервере();

КонецПроцедуры

&НаСервере
Процедура сп_УстановитьТекущуюКартинкуНаСервере()

	Если Изображения.Количество() = 0 Тогда
		АдресКартинкиТекущий = "";
		СчетчикИзображений = "";
		Возврат;
	КонецЕсли;

	Если ИндексКартинки < 0 Тогда
		ИндексКартинки = 0;
	КонецЕсли;

	Если ИндексКартинки >= Изображения.Количество() Тогда
		ИндексКартинки = Изображения.Количество() - 1;
	КонецЕсли;

	АдресКартинкиТекущий = Изображения[ИндексКартинки].Адрес;
	СчетчикИзображений = Строка(ИндексКартинки + 1) + " из " + Строка(Изображения.Количество());

КонецПроцедуры

&НаСервере
Процедура сп_ОбновитьВидимостьЛистанияНаСервере()

	ЕстьНесколькоКартинок = Изображения.Количество() > 1;

	Попытка
		Элементы.ПредыдущаяКартинка.Видимость = ЕстьНесколькоКартинок;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.СледующаяКартинка.Видимость = ЕстьНесколькоКартинок;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.СчетчикИзображений.Видимость = ЕстьНесколькоКартинок;
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура сп_ЗаполнитьИзображенияТовараНаСервере()

	Изображения.Очистить();

	сп_ДобавитьКартинкиИзВнешнегоРегистраНаСервере();
	сп_ДобавитьКартинкуФайлаКартинкиНоменклатурыНаСервере();
	сп_ДобавитьКартинкиИзПрисоединенныхФайловНаСервере();

КонецПроцедуры

&НаСервере
Процедура сп_ДобавитьКартинкуВАльбом(АдресКартинки)

	Если Не ЗначениеЗаполнено(АдресКартинки) Тогда
		Возврат;
	КонецЕсли;

	НоваяСтрока = Изображения.Добавить();
	НоваяСтрока.Адрес = АдресКартинки;
	НоваяСтрока.Ссылка = ТекущаяНоменклатура;

КонецПроцедуры

&НаСервере
Процедура сп_ДобавитьКартинкиИзВнешнегоРегистраНаСервере()

	АртикулПоставщика = сп_АртикулПоставщикаНоменклатуры(ТекущаяНоменклатура);

	Если Не ЗначениеЗаполнено(АртикулПоставщика) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|    Картинки.ВнешняяСсылка КАК ВнешняяСсылка
	|ИЗ
	|    РегистрСведений.спВнешниеКартинкиТовара КАК Картинки
	|ГДЕ
	|    Картинки.АртикулПоставщика = &АртикулПоставщика
	|    И Картинки.ВнешняяСсылка <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|    Картинки.ВнешняяСсылка";

	Запрос.УстановитьПараметр("АртикулПоставщика", АртикулПоставщика);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		сп_ДобавитьКартинкуВАльбом(сп_АдресКартинкиПоВнешнейСсылке(Выборка.ВнешняяСсылка));
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура сп_ДобавитьКартинкуФайлаКартинкиНоменклатурыНаСервере()

	ФайлКартинки = сп_ЗначениеРеквизитаОбъектаЕслиЕсть(ТекущаяНоменклатура, "ФайлКартинки");

	Если ЗначениеЗаполнено(ФайлКартинки) Тогда
		сп_ДобавитьКартинкуВАльбом(сп_АдресДвоичныхДанныхФайлаКартинки(ФайлКартинки));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура сп_ДобавитьКартинкиИзПрисоединенныхФайловНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    Файлы.Ссылка КАК Файл
	|ИЗ
	|    Справочник.НоменклатураПрисоединенныеФайлы КАК Файлы
	|ГДЕ
	|    Файлы.ВладелецФайла = &ВладелецФайла
	|    И НЕ Файлы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|    Файлы.Наименование";

	Запрос.УстановитьПараметр("ВладелецФайла", ТекущаяНоменклатура);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		сп_ДобавитьКартинкуВАльбом(сп_АдресДвоичныхДанныхФайлаКартинки(Выборка.Файл));
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция сп_АдресДвоичныхДанныхФайлаКартинки(ФайлКартинки)

	Если Не ЗначениеЗаполнено(ФайлКартинки) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		АдресКартинкиТекущий = РаботаСФайламиУНФ.СсылкаНаДвоичныеДанныеФайла(ФайлКартинки, УникальныйИдентификатор);
		Если ЗначениеЗаполнено(АдресКартинкиТекущий) Тогда
			Возврат АдресКартинкиТекущий;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(ФайлКартинки);
		Если ДанныеФайла <> Неопределено
			И ДанныеФайла.Свойство("СсылкаНаДвоичныеДанныеФайла")
			И ЗначениеЗаполнено(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла) Тогда
			Возврат ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат "";

КонецФункции

&НаСервере
Функция сп_АдресКартинкиПоВнешнейСсылке(ВнешняяСсылка)

	Если Не ЗначениеЗаполнено(ВнешняяСсылка) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		АдресКартинкиТекущий = спМодификацияКонфигурацииПереопределяемый.сп_СсылкаНаДвоичныеДанныеКартинки(
			ВнешняяСсылка,
			УникальныйИдентификатор);
		Если ЗначениеЗаполнено(АдресКартинкиТекущий) Тогда
			Возврат АдресКартинкиТекущий;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат "";

КонецФункции

#КонецОбласти

#Область ТоварЦены

&НаСервере
Функция сп_РеквизитыТовараДляОтображения(Номенклатура)

	Результат = Новый Структура;
	Результат.Вставить("Наименование", "");
	Результат.Вставить("Артикул", "");
	Результат.Вставить("Бренд", "");
	Результат.Вставить("Цвет", "");
	Результат.Вставить("Размер", "");
	Результат.Вставить("Сезон", "");

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Наименование = Строка(Номенклатура);

	Артикул = сп_ЗначениеРеквизитаОбъектаЕслиЕсть(Номенклатура, "Артикул");
	АртикулПоставщика = сп_ЗначениеРеквизитаОбъектаЕслиЕсть(Номенклатура, "спАртикулПоставщика");

	Если ЗначениеЗаполнено(АртикулПоставщика) Тогда
		Результат.Артикул = Строка(АртикулПоставщика);
	ИначеЕсли ЗначениеЗаполнено(Артикул) Тогда
		Результат.Артикул = Строка(Артикул);
	КонецЕсли;

	Бренд = сп_ЗначениеРеквизитаОбъектаЕслиЕсть(Номенклатура, "спБренд");
	Если ЗначениеЗаполнено(Бренд) Тогда
		Результат.Бренд = Строка(Бренд);
	КонецЕсли;

	Цвет = сп_ЗначениеРеквизитаОбъектаЕслиЕсть(Номенклатура, "спЦвет");
	Если ЗначениеЗаполнено(Цвет) Тогда
		Результат.Цвет = Строка(Цвет);
	КонецЕсли;

	Размер = сп_ЗначениеРеквизитаОбъектаЕслиЕсть(Номенклатура, "спРазмер");
	Если ЗначениеЗаполнено(Размер) Тогда
		Результат.Размер = Строка(Размер);
	КонецЕсли;

	Сезон = сп_ЗначениеПервогоЗаполненногоРеквизита(Номенклатура, "спСезон,Сезон,СезонКоллекции,Коллекция,Сезонность");
	Если ЗначениеЗаполнено(Сезон) Тогда
		Результат.Сезон = Строка(Сезон);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция сп_АртикулПоставщикаНоменклатуры(Номенклатура)

	АртикулПоставщика = сп_ЗначениеРеквизитаОбъектаЕслиЕсть(Номенклатура, "спАртикулПоставщика");

	Если ЗначениеЗаполнено(АртикулПоставщика) Тогда
		Возврат СокрЛП(Строка(АртикулПоставщика));
	КонецЕсли;

	Артикул = сп_ЗначениеРеквизитаОбъектаЕслиЕсть(Номенклатура, "Артикул");

	Если ЗначениеЗаполнено(Артикул) Тогда
		Возврат СокрЛП(Строка(Артикул));
	КонецЕсли;

	Возврат "";

КонецФункции

&НаСервере
Функция сп_ЗначениеПервогоЗаполненногоРеквизита(ОбъектСсылка, ИменаРеквизитовСтрокой)

	Для каждого ИмяРеквизита Из СтрРазделить(ИменаРеквизитовСтрокой, ",") Цикл
		ИмяРеквизита = СокрЛП(ИмяРеквизита);
		ЗначениеРеквизита = сп_ЗначениеРеквизитаОбъектаЕслиЕсть(ОбъектСсылка, ИмяРеквизита);
		Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			Возврат ЗначениеРеквизита;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция сп_ЗначениеРеквизитаОбъектаЕслиЕсть(ОбъектСсылка, ИмяРеквизита)

	Если Не ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		МетаданныеОбъекта = ОбъектСсылка.Метаданные();
		Если МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектСсылка, ИмяРеквизита);
		ЗначениеРеквизита = Неопределено;
		Если Реквизиты.Свойство(ИмяРеквизита, ЗначениеРеквизита) Тогда
			Возврат ЗначениеРеквизита;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция сп_ПредставлениеЦеныНоменклатуры(Номенклатура, ШаблонВидаЦены)

	Цена = сп_ЦенаНоменклатурыПоШаблону(Номенклатура, ШаблонВидаЦены);

	Если Цена = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(Цена, "ЧДЦ=2");

КонецФункции

&НаСервере
Функция сп_ЦенаНоменклатурыПоШаблону(Номенклатура, ШаблонВидаЦены)

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|    Цены.Цена КАК Цена
	|ИЗ
	|    РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|        &Дата,
	|        Номенклатура = &Номенклатура) КАК Цены
	|ГДЕ
	|    Цены.Цена <> 0
	|    И НРег(Цены.ВидЦен.Наименование) ПОДОБНО &ШаблонВидаЦены
	|
	|УПОРЯДОЧИТЬ ПО
	|    Цены.ВидЦен.Наименование";

	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ШаблонВидаЦены", ШаблонВидаЦены);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;

	Возврат Неопределено;

