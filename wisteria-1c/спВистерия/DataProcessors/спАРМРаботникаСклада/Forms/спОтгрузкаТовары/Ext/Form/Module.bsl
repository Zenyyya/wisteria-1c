		Попытка
			ОбрабатываемаяКартинка = Новый ОбрабатываемаяКартинка(Картинка);
			ОбрабатываемаяКартинка.УстановитьРазмер(260, );
			Картинка = ОбрабатываемаяКартинка.ПолучитьКартинку();
		Исключение
		КонецПопытки;
		Возврат ПоместитьВоВременноеХранилище(Картинка, УникальныйИдентификатор);

