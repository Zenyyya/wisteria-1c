&НаКлиенте
Процедура СканироватьТовар(Команда)

	ОчиститьСообщения();

	#Если МобильныйКлиент Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нажмите аппаратную кнопку сканирования на ТСД.");
	#Иначе
		ТекШтрихкод = "";
		Оповещение = Новый ОписаниеОповещения(
			"СканироватьТоварЗавершение",
			ЭтотОбъект,
			Новый Структура("ТекШтрихкод", ТекШтрихкод));

		ПоказатьВводЗначения(Оповещение, ТекШтрихкод, "Введите штрихкод");
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура СканироватьТоварЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ТекШтрихкод = ?(
		Результат = Неопределено,
		СокрЛП(ДополнительныеПараметры.ТекШтрихкод),
		СокрЛП(Результат));

	Если ПустаяСтрока(ТекШтрихкод) Тогда
		Возврат;
	КонецЕсли;

	ДанныеШтрихкода = Новый Структура("Штрихкод, Количество", ТекШтрихкод, 1);
	ДанныеПоШтрихКодам = ПолучитьДанныеПоШтрихкодамВМассиве(ДанныеШтрихкода);
	МассивДанных = ДанныеПоШтрихкодам.Получить(ТекШтрихкод);

	Если МассивДанных = Неопределено Или МассивДанных.Количество() = 0 Тогда

		ДанныеМаркировки = сп_ДанныеПоШтрихкодуИлиКодуМаркировкиНаСервере(ТекШтрихкод);

		Если ДанныеМаркировки = Неопределено Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Штрихкод/код маркировки не найден: " + ТекШтрихкод);
			Возврат;
		КонецЕсли;

		МассивДанных = Новый Массив;
		МассивДанных.Добавить(ДанныеМаркировки);

	КонецЕсли;

	РезультатСканирования = сп_ВыполнитьСканированиеДанныхШтрихкодаОтгрузкиНаСервере(МассивДанных[0]);

	Если ЗначениеЗаполнено(РезультатСканирования) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатСканирования);
	КонецЕсли;

	ЗаполнитьТоварыНаСервере();

	Попытка
		Элементы.Данные.Обновить();
	Исключение
	КонецПопытки;

	Оповестить("спАРМОбновитьИнтерфейс", Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеПриСканировании(ДанныеТовара)

	Если ДанныеТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;

	РезультатСканирования = сп_ВыполнитьСканированиеДанныхШтрихкодаОтгрузкиНаСервере(ДанныеТовара);

	Если ЗначениеЗаполнено(РезультатСканирования) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатСканирования);
	КонецЕсли;

	ЗаполнитьТоварыНаСервере();

	Попытка
		Элементы.Данные.Обновить();
	Исключение
	КонецПопытки;

	Оповестить("спАРМОбновитьИнтерфейс", Неопределено);

КонецПроцедуры

&НаСервере
Функция сп_ВыполнитьСканированиеДанныхШтрихкодаОтгрузкиНаСервере(ДанныеТовара)

	сп_ИнициализироватьПараметрыФормы();

	Номенклатура = Неопределено;
	ЕдиницаИзмерения = Неопределено;

	Если ТипЗнч(ДанныеТовара) = Тип("Структура") Тогда

		ДанныеТовара.Свойство("Номенклатура", Номенклатура);
		ДанныеТовара.Свойство("ЕдиницаИзмерения", ЕдиницаИзмерения);

	Иначе

		Номенклатура = ДанныеТовара;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "Не определен товар по отсканированному штрихкоду.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийСклад) Тогда
		Возврат "Не определен склад для сканирования.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийКлючЯчейки) Тогда
		ТекущийКлючЯчейки = сп_КлючЯчейки(ТекущаяЯчейка);
	КонецЕсли;

	СтрокаЗапасов = сп_НайтиСтрокуЗапасовДляСканированияОтгрузки(Номенклатура, ЕдиницаИзмерения);

	Если СтрокаЗапасов = Неопределено Тогда
		Возврат "Отсканированный товар не найден в текущей ячейке или уже полностью отсканирован: " + Строка(Номенклатура);
	КонецЕсли;

	СсылкаПеремещения = сп_НайтиИлиСоздатьПеремещениеОтгрузки(СтрокаЗапасов);

	Если Не ЗначениеЗаполнено(СсылкаПеремещения) Тогда
		Возврат "Не удалось создать или найти документ Перемещение запасов.";
	КонецЕсли;

	ПеремещениеОбъект = СсылкаПеремещения.ПолучитьОбъект();

	СтрокаДокумента = сп_НайтиСтрокуПеремещения(ПеремещениеОбъект, СтрокаЗапасов);

	Если СтрокаДокумента = Неопределено Тогда

		СтрокаДокумента = ПеремещениеОбъект.Запасы.Добавить();

		сп_ЗаполнитьСтрокуПеремещенияИзСтрокиЗапасов(
			СтрокаДокумента,
			СтрокаЗапасов,
			Истина);

		СтрокаДокумента.Количество = 1;

	Иначе

		СтрокаДокумента.Количество = СтрокаДокумента.Количество + 1;

	КонецЕсли;

	Попытка
		ПеремещениеОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Возврат "Ошибка записи перемещения: " + ОписаниеОшибки();
	КонецПопытки;

	СообщениеПроведения = сп_ПровестиПеремещенияСкладаЕслиВсеОтсканированоНаСервере(СтрокаЗапасов.Склад);

	ТекстЯчейки = "";

	Если ЗначениеЗаполнено(СтрокаЗапасов.Ячейка) Тогда
		ТекстЯчейки = ", ячейка: " + Строка(СтрокаЗапасов.Ячейка);
	Иначе
		ТекстЯчейки = ", без ячейки";
	КонецЕсли;

	Результат = "Товар отсканирован: "
		+ Строка(Номенклатура)
		+ Символы.ПС
		+ "Склад: "
		+ Строка(СтрокаЗапасов.Склад)
		+ ТекстЯчейки;

	Если ЗначениеЗаполнено(СообщениеПроведения) Тогда
		Результат = Результат + Символы.ПС + СообщениеПроведения;
	КонецЕсли;

	Возврат Результат;
		
КонецФункции

&НаСервере
Функция сп_ПровестиПеремещенияСкладаЕслиВсеОтсканированоНаСервере(Склад)

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат "";
	КонецЕсли;

	Если Не сп_СкладПолностьюОтсканированНаСервере(Склад) Тогда
		Возврат "";
	КонецЕсли;

	Возврат сп_ПровестиПеремещенияСкладаНаСервере(Склад, Ложь);

КонецФункции

&НаСервере
Функция сп_СкладПолностьюОтсканированНаСервере(Склад)

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат Ложь;
	КонецЕсли;

	ТаблицаЗапасов = сп_ПолучитьТаблицуЗапасовОтгрузкиНаСервере();

	Для каждого Стр Из ТаблицаЗапасов Цикл

		Если Стр.Склад = Склад
			И Стр.Отклонение > 0 Тогда

			Возврат Ложь;

		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

&НаСервере
Функция сп_ПровестиПеремещенияСкладаНаСервере(СкладИсточник, СообщатьЕслиНет)

	сп_ИнициализироватьПараметрыФормы();

	Если Не ЗначениеЗаполнено(СкладИсточник) Тогда
		Возврат "";
	КонецЕсли;

	МассивЗаказов = сп_МассивЗаказовНаСервере();

	Если МассивЗаказов.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;


	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Перемещение.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПеремещениеЗапасов КАК Перемещение
	|ГДЕ
	|	Перемещение.ДокументОснование В (&Заказы)
	|	И Перемещение.СтруктурнаяЕдиница = &СкладИсточник
	|	И НЕ Перемещение.ПометкаУдаления
	|	И НЕ Перемещение.Проведен";

	Запрос.УстановитьПараметр("Заказы", МассивЗаказов);
	Запрос.УстановитьПараметр("СкладИсточник", СкладИсточник);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат "Ошибка поиска перемещений для проведения: " + ОписаниеОшибки();
	КонецПопытки;

	КоличествоПроведено = 0;

	Пока Выборка.Следующий() Цикл

		Попытка

			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КоличествоПроведено = КоличествоПроведено + 1;

		Исключение

			Возврат "Не удалось провести перемещение "
				+ Строка(Выборка.Ссылка)
				+ ": "
				+ ОписаниеОшибки();

		КонецПопытки;

	КонецЦикла;

	Если КоличествоПроведено = 0 Тогда

		Если СообщатьЕслиНет Тогда
			Возврат "Нет непроведенных перемещений по текущему складу.";
		Иначе
			Возврат "";
		КонецЕсли;

	КонецЕсли;

	Возврат "Склад полностью отсканирован. Перемещения проведены: "
		+ Строка(КоличествоПроведено)
		+ ".";

КонецФункции

&НаСервере
Функция сп_ПровестиПеремещенияТекущегоСкладаНаСервере()

	сп_ИнициализироватьПараметрыФормы();

	Если Не ЗначениеЗаполнено(ТекущийСклад) Тогда
		Возврат "Не определен склад для проведения перемещений.";
	КонецЕсли;

	МассивЗаказов = сп_МассивЗаказовНаСервере();

	Если МассивЗаказов.Количество() = 0 Тогда
		Возврат "Не переданы заказы для проведения перемещений.";
	КонецЕсли;


	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|   Перемещение.Ссылка КАК Ссылка
	|ИЗ
	|   Документ.ПеремещениеЗапасов КАК Перемещение
	|ГДЕ
	|   Перемещение.ДокументОснование В (&Заказы)
	|   И Перемещение.СтруктурнаяЕдиница = &СкладИсточник
	|   И НЕ Перемещение.ПометкаУдаления
	|   И НЕ Перемещение.Проведен";

	Запрос.УстановитьПараметр("Заказы", МассивЗаказов);
	Запрос.УстановитьПараметр("СкладИсточник", ТекущийСклад);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат "Ошибка поиска перемещений для проведения: " + ОписаниеОшибки();
	КонецПопытки;

	КоличествоПроведено = 0;

	Пока Выборка.Следующий() Цикл

		Попытка
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КоличествоПроведено = КоличествоПроведено + 1;
		Исключение
			Возврат "Не удалось провести перемещение "
				+ Строка(Выборка.Ссылка)
				+ ": "
				+ ОписаниеОшибки();
		КонецПопытки;

	КонецЦикла;

	Если КоличествоПроведено = 0 Тогда
		Возврат "Нет непроведенных перемещений по текущему складу.";
	КонецЕсли;

	Возврат "Перемещения по текущему складу проведены: " + Строка(КоличествоПроведено) + ".";

КонецФункции

&НаСервере
Функция сп_НайтиСтрокуЗапасовДляСканированияОтгрузки(Номенклатура, ЕдиницаИзмерения = Неопределено)

	ТаблицаЗапасов = сп_ПолучитьТаблицуЗапасовОтгрузкиНаСервере();

	Для каждого Стр Из ТаблицаЗапасов Цикл

		Если Стр.Номенклатура <> Номенклатура Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(ЕдиницаИзмерения)
			И Стр.ЕдиницаИзмерения <> ЕдиницаИзмерения Тогда
			Продолжить;
		КонецЕсли;

		Если Стр.Отклонение <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Если Стр.КоличествоНаСкладе <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Возврат Стр;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция сп_НайтиИлиСоздатьПеремещениеОтгрузки(СтрокаЗапасов)

	Заказ = СтрокаЗапасов.Заказ;
	СкладИсточник = СтрокаЗапасов.Склад;
	СкладПолучатель = сп_СкладПолучательЗаказаНаСервере(Заказ);

	Если сп_ЗаказИзТорговогоЗалаНаСервере(Заказ) Тогда
		СкладИсточник = сп_СкладОтправительЗаказаНаСервере(Заказ);
		СтрокаЗапасов.Склад = СкладИсточник;
		СтрокаЗапасов.Ячейка = Справочники.Ячейки.ПустаяСсылка();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СкладПолучатель) Тогда
		СкладПолучатель = сп_СкладТорговыйЗалНаСервере();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СкладИсточник) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СкладПолучатель) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не найден склад-получатель.");
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Перемещение.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПеремещениеЗапасов КАК Перемещение
	|ГДЕ
	|	Перемещение.ДокументОснование = &Заказ
	|	И Перемещение.СтруктурнаяЕдиница = &СкладИсточник
	|	И Перемещение.СтруктурнаяЕдиницаПолучатель = &СкладПолучатель
	|	И НЕ Перемещение.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Перемещение.Дата УБЫВ";

	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("СкладИсточник", СкладИсточник);
	Запрос.УстановитьПараметр("СкладПолучатель", СкладПолучатель);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	НовыйДокумент = Документы.ПеремещениеЗапасов.СоздатьДокумент();
	НовыйДокумент.Дата = ТекущаяДатаСеанса();

	Попытка
		НовыйДокумент.Заполнить(Заказ);
	Исключение
	КонецПопытки;

	НовыйДокумент.Запасы.Очистить();

	НовыйДокумент.ДокументОснование = Заказ;
	НовыйДокумент.СтруктурнаяЕдиница = СкладИсточник;
	НовыйДокумент.СтруктурнаяЕдиницаПолучатель = СкладПолучатель;

	Попытка
		НовыйДокумент.ЗаказНаПеремещение = Документы.ЗаказНаПеремещение.ПустаяСсылка();
	Исключение
	КонецПопытки;

	Попытка
		НовыйДокумент.Комментарий =
			"Создано АРМ кладовщика. Отгрузка. "
			+ "Склад отправитель: " + Строка(СкладИсточник)
			+ ". Склад получатель: " + Строка(СкладПолучатель)
			+ ". Основание: " + Строка(Заказ);
	Исключение
	КонецПопытки;

	НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);

	Возврат НовыйДокумент.Ссылка;

