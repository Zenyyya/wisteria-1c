#Область ОписаниеПеременных

Перем м_Заказы;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	сп_ИнициализироватьПараметрыФормы();

	сп_ПодключитьСканерШтрихкодаНаСервере();


	ПоказыватьОтсканированные = Ложь;

	сп_НастроитьИнтерфейсТоваров();

	ЗаполнитьТоварыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	сп_ПодключитьСканерШтрихкодаНаКлиенте();

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	сп_ОтключитьСканерШтрихкодаНаКлиенте();

КонецПроцедуры


#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ДанныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьВыбранныйТовар();

КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьОтсканированныеПриИзменении(Элемент)

	ЗаполнитьТоварыНаСервере();

	Попытка
		Элементы.Данные.Обновить();
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура ОткрытьСписокПеремещений(Команда)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗаказыСериализованные", ЗаказыСериализованные);
	ПараметрыФормы.Вставить("Заказы", сп_ПолучитьЗаказыДляПередачиНаСервере());

	ОткрытьФорму(
		"Обработка.спАРМРаботникаСклада.Форма.спСписокПеремещений",
		ПараметрыФормы,
		ЭтаФорма);

КонецПроцедуры


&НаКлиенте
Процедура ЗавершитьСклад(Команда)

	Результат = сп_ПровестиПеремещенияТекущегоСкладаНаСервере();

	Если ЗначениеЗаполнено(Результат) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат);
	КонецЕсли;

	ЗаполнитьТоварыНаСервере();

	Попытка
		Элементы.Данные.Обновить();
	Исключение
	КонецПопытки;

	Оповестить("спАРМОбновитьИнтерфейс", Неопределено);

КонецПроцедуры

#КонецОбласти

#Область Навигация

&НаКлиенте
Процедура ОткрытьВыбранныйТовар()

	ТекущиеДанные = Элементы.Данные.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось определить товар.");
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗаказыСериализованные", ЗаказыСериализованные);
	ПараметрыФормы.Вставить("Заказы", сп_ПолучитьЗаказыДляПередачиНаСервере());
	ПараметрыФормы.Вставить("Склад", ТекущийСклад);
	ПараметрыФормы.Вставить("Ячейка", ТекущаяЯчейка);
	ПараметрыФормы.Вставить("КлючЯчейки", ТекущийКлючЯчейки);
	ПараметрыФормы.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);

	Попытка
		ПараметрыФормы.Вставить("ЕдиницаИзмерения", ТекущиеДанные.ЕдиницаИзмерения);
	Исключение
		ПараметрыФормы.Вставить("ЕдиницаИзмерения", Неопределено);
	КонецПопытки;

	ОткрытьФорму(
		"Обработка.спАРМРаботникаСклада.Форма.спОтгрузкаТоварыДетализация",
		ПараметрыФормы,
		ЭтаФорма);

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДанныхФормы

&НаСервере
Процедура ЗаполнитьТоварыНаСервере()

	сп_ИнициализироватьПараметрыФормы();

	Данные.Очистить();

	Если Не ЗначениеЗаполнено(ТекущийСклад) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не определен склад для отбора товаров.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийКлючЯчейки) Тогда
		ТекущийКлючЯчейки = сп_КлючЯчейки(ТекущаяЯчейка);
	КонецЕсли;

	ТаблицаЗапасов = сп_ПолучитьТаблицуЗапасовОтгрузкиНаСервере();

	Группы = Новый Соответствие;

	Для каждого Стр Из ТаблицаЗапасов Цикл

		Если Стр.Склад <> ТекущийСклад Тогда
			Продолжить;
		КонецЕсли;

		КлючЯчейкиСтроки = сп_КлючЯчейки(Стр.Ячейка);

		Если КлючЯчейкиСтроки <> ТекущийКлючЯчейки Тогда
			Продолжить;
		КонецЕсли;

		КлючТовара = сп_КлючТовара(
			Стр.Номенклатура,
			Стр.Характеристика,
			Стр.Партия,
			Стр.СерииНоменклатуры,
			Стр.ЕдиницаИзмерения);
	
		Группа = Группы.Получить(КлючТовара);

		Если Группа = Неопределено Тогда

			Группа = Данные.Добавить();

			Группа.Номенклатура = Стр.Номенклатура;
			Группа.ЕдиницаИзмерения = Стр.ЕдиницаИзмерения;

			РеквизитыТовара = сп_РеквизитыТовараДляОтображения(Стр.Номенклатура);

			Группа.Артикул = РеквизитыТовара.Артикул;
			Группа.Бренд = РеквизитыТовара.Бренд;

			Попытка
				Группа.Цвет = РеквизитыТовара.Цвет;
			Исключение
			КонецПопытки;

			Попытка
				Группа.Размер = РеквизитыТовара.Размер;
			Исключение
			КонецПопытки;

			Группа.Наименование = сп_НаименованиеТовараДляСписка(РеквизитыТовара);
			Группа.Представление = "";
			Группа.Картинка = сп_КартинкаНоменклатуры(Стр.Номенклатура);

			Группа.КоличествоПлан = 0;
			Группа.КоличествоФакт = 0;
			Группа.Отклонение = 0;

			Группа.КоличествоПланПредставление = "0 шт";
			Группа.КоличествоФактПредставление = "0 шт";
			Группа.ОтклонениеПредставление = "0 шт";

			Группы.Вставить(КлючТовара, Группа);

		КонецЕсли;

		Группа.КоличествоПлан = Группа.КоличествоПлан + Стр.КоличествоПлан;
		Группа.КоличествоФакт = Группа.КоличествоФакт + Стр.КоличествоФакт;
		Группа.Отклонение = Группа.Отклонение + Стр.Отклонение;

	КонецЦикла;

	Если Не ПоказыватьОтсканированные Тогда

		Индекс = Данные.Количество() - 1;

		Пока Индекс >= 0 Цикл

			СтрокаТовара = Данные[Индекс];

			Если СтрокаТовара.Отклонение <= 0 Тогда
				Данные.Удалить(СтрокаТовара);
			КонецЕсли;

			Индекс = Индекс - 1;

		КонецЦикла;

	КонецЕсли;

	Для каждого СтрокаТовара Из Данные Цикл

		СтрокаТовара.КоличествоПланПредставление =
			сп_КоличествоШтПредставление(СтрокаТовара.КоличествоПлан);

		СтрокаТовара.КоличествоФактПредставление =
			сп_КоличествоШтПредставление(СтрокаТовара.КоличествоФакт);

		СтрокаТовара.ОтклонениеПредставление =
			сп_КоличествоШтПредставление(СтрокаТовара.Отклонение);

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция сп_КлючЯчейки(Ячейка)

	Если Ячейка = Неопределено Тогда
		Возврат "<БезЯчейки>";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Ячейка) Тогда
		Возврат "<БезЯчейки>";
	КонецЕсли;

	Попытка
		Возврат Строка(Ячейка.УникальныйИдентификатор());
	Исключение
	КонецПопытки;

	Возврат Строка(Ячейка);

КонецФункции

&НаСервере
Функция сп_КлючЗначенияАРМ(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Возврат Строка(Значение.УникальныйИдентификатор());
	Исключение
	КонецПопытки;
	
	Возврат Строка(Значение);
	
КонецФункции

&НаСервере
Функция сп_КлючТовара(Номенклатура, Характеристика, Партия, СерииНоменклатуры, ЕдиницаИзмерения)
	
	Возврат 
		сп_КлючЗначенияАРМ(Номенклатура) + "|"
		+ сп_КлючЗначенияАРМ(Характеристика) + "|"
		+ сп_КлючЗначенияАРМ(Партия) + "|"
		+ сп_КлючЗначенияАРМ(СерииНоменклатуры) + "|"
		+ сп_КлючЗначенияАРМ(ЕдиницаИзмерения);
	
КонецФункции

&НаСервере
Функция сп_КлючЗаказТовар(Заказ, Номенклатура, Характеристика, Партия, СерииНоменклатуры, ЕдиницаИзмерения)
	
	Возврат 
		сп_КлючЗначенияАРМ(Заказ) + "|"
		+ сп_КлючТовара(Номенклатура, Характеристика, Партия, СерииНоменклатуры, ЕдиницаИзмерения);
	
КонецФункции

#КонецОбласти

#Область ПолучениеЗапасов

&НаСервере
Функция сп_ПолучитьТаблицуЗапасовОтгрузкиНаСервере()

	Результат = Новый ТаблицаЗначений;

	Результат.Колонки.Добавить("Заказ");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Характеристика");
	Результат.Колонки.Добавить("Партия");
	Результат.Колонки.Добавить("СерииНоменклатуры");
	Результат.Колонки.Добавить("ЕдиницаИзмерения");
	Результат.Колонки.Добавить("Склад");
	Результат.Колонки.Добавить("Ячейка");
	Результат.Колонки.Добавить("КоличествоПлан");
	Результат.Колонки.Добавить("КоличествоФакт");
	Результат.Колонки.Добавить("Отклонение");
	Результат.Колонки.Добавить("КоличествоНаСкладе");

	МассивЗаказов = сп_МассивЗаказовНаСервере();

	Если МассивЗаказов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказЗапасы.Ссылка КАК Заказ,
	|	ЗаказЗапасы.Ссылка.Организация КАК Организация,
	|	ЗаказЗапасы.Номенклатура КАК Номенклатура,
	|	ЗаказЗапасы.Характеристика КАК Характеристика,
	|	ЗаказЗапасы.Партия КАК Партия,
	|	ЗаказЗапасы.СерииНоменклатуры КАК СерииНоменклатуры,
	|	ЗаказЗапасы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СУММА(ЗаказЗапасы.Количество) КАК КоличествоПлан
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	Документ.ЗаказНаПеремещение.Запасы КАК ЗаказЗапасы
	|ГДЕ
	|	ЗаказЗапасы.Ссылка В (&Заказы)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказЗапасы.Ссылка,
	|	ЗаказЗапасы.Ссылка.Организация,
	|	ЗаказЗапасы.Номенклатура,
	|	ЗаказЗапасы.Характеристика,
	|	ЗаказЗапасы.Партия,
	|	ЗаказЗапасы.СерииНоменклатуры,
	|	ЗаказЗапасы.ЕдиницаИзмерения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Перемещение.ДокументОснование КАК Заказ,
	|	Перемещение.СтруктурнаяЕдиница КАК Склад,
	|	ЕСТЬNULL(ПеремещениеЗапасы.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) КАК Ячейка,
	|	ПеремещениеЗапасы.Номенклатура КАК Номенклатура,
	|	ПеремещениеЗапасы.Характеристика КАК Характеристика,
	|	ПеремещениеЗапасы.Партия КАК Партия,
	|	ПеремещениеЗапасы.СерииНоменклатуры КАК СерииНоменклатуры,
	|	ПеремещениеЗапасы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СУММА(ПеремещениеЗапасы.Количество) КАК КоличествоФакт
	|ПОМЕСТИТЬ ВТ_ФактПоЯчейкам
	|ИЗ
	|	Документ.ПеремещениеЗапасов.Запасы КАК ПеремещениеЗапасы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПеремещениеЗапасов КАК Перемещение
	|		ПО ПеремещениеЗапасы.Ссылка = Перемещение.Ссылка
	|ГДЕ
	|	Перемещение.ДокументОснование В (&Заказы)
	|	И НЕ Перемещение.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	Перемещение.ДокументОснование,
	|	Перемещение.СтруктурнаяЕдиница,
	|	ЕСТЬNULL(ПеремещениеЗапасы.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)),
	|	ПеремещениеЗапасы.Номенклатура,
	|	ПеремещениеЗапасы.Характеристика,
	|	ПеремещениеЗапасы.Партия,
	|	ПеремещениеЗапасы.СерииНоменклатуры,
	|	ПеремещениеЗапасы.ЕдиницаИзмерения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ФактПоЯчейкам.Заказ КАК Заказ,
	|	ВТ_ФактПоЯчейкам.Номенклатура КАК Номенклатура,
	|	ВТ_ФактПоЯчейкам.Характеристика КАК Характеристика,
	|	ВТ_ФактПоЯчейкам.Партия КАК Партия,
	|	ВТ_ФактПоЯчейкам.СерииНоменклатуры КАК СерииНоменклатуры,
	|	ВТ_ФактПоЯчейкам.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СУММА(ВТ_ФактПоЯчейкам.КоличествоФакт) КАК КоличествоФактВсего
	|ПОМЕСТИТЬ ВТ_ФактВсего
	|ИЗ
	|	ВТ_ФактПоЯчейкам КАК ВТ_ФактПоЯчейкам
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ФактПоЯчейкам.Заказ,
	|	ВТ_ФактПоЯчейкам.Номенклатура,
	|	ВТ_ФактПоЯчейкам.Характеристика,
	|	ВТ_ФактПоЯчейкам.Партия,
	|	ВТ_ФактПоЯчейкам.СерииНоменклатуры,
	|	ВТ_ФактПоЯчейкам.ЕдиницаИзмерения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗапасыНаСкладахОстатки.Организация КАК Организация,
	|	ЗапасыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ЗапасыНаСкладахОстатки.Характеристика КАК Характеристика,
	|	ЗапасыНаСкладахОстатки.Партия КАК Партия,
	|	ЗапасыНаСкладахОстатки.СтруктурнаяЕдиница КАК Склад,
	|	ЕСТЬNULL(ЗапасыНаСкладахОстатки.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) КАК Ячейка,
	|	СУММА(ЗапасыНаСкладахОстатки.КоличествоОстаток) КАК КоличествоНаСкладе
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.ЗапасыНаСкладах.Остатки(
	|		&ДатаОстатков,
	|		(Организация, Номенклатура, Характеристика, Партия) В
	|			(ВЫБРАТЬ
	|				ВТ_Заказы.Организация,
	|				ВТ_Заказы.Номенклатура,
	|				ВТ_Заказы.Характеристика,
	|				ВТ_Заказы.Партия
	|			ИЗ
	|				ВТ_Заказы КАК ВТ_Заказы)) КАК ЗапасыНаСкладахОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗапасыНаСкладахОстатки.Организация,
	|	ЗапасыНаСкладахОстатки.Номенклатура,
	|	ЗапасыНаСкладахОстатки.Характеристика,
	|	ЗапасыНаСкладахОстатки.Партия,
	|	ЗапасыНаСкладахОстатки.СтруктурнаяЕдиница,
	|	ЕСТЬNULL(ЗапасыНаСкладахОстатки.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заказы.Заказ КАК Заказ,
	|	ВТ_Заказы.Организация КАК Организация,
	|	ВТ_Заказы.Номенклатура КАК Номенклатура,
	|	ВТ_Заказы.Характеристика КАК Характеристика,
	|	ВТ_Заказы.Партия КАК Партия,
	|	ВТ_Заказы.СерииНоменклатуры КАК СерииНоменклатуры,
	|	ВТ_Заказы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_Заказы.КоличествоПлан КАК КоличествоПланВсего,
	|	ЕСТЬNULL(ВТ_ФактВсего.КоличествоФактВсего, 0) КАК КоличествоФактВсего,
	|	ЕСТЬNULL(ВТ_Остатки.Склад, ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)) КАК Склад,
	|	ЕСТЬNULL(ВТ_Остатки.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) КАК Ячейка,
	|	ЕСТЬNULL(ВТ_Остатки.КоличествоНаСкладе, 0) КАК КоличествоНаСкладе,
	|	ЕСТЬNULL(ВТ_ФактПоЯчейкам.КоличествоФакт, 0) КАК КоличествоФактЯчейки,
	|	ВЫБОР
	|		КОГДА ВТ_Остатки.Склад = &СкладТорговыйЗал
	|			ТОГДА 999999999
	|		ИНАЧЕ ЕСТЬNULL(ЕСТЬNULL(МаршрутЯчейки.ПорядокСклада, МаршрутСклада.ПорядокСклада), 999999)
	|	КОНЕЦ КАК ПорядокСклада,
	|	ЕСТЬNULL(МаршрутЯчейки.ПорядокЯчейки, 999999) КАК ПорядокЯчейки,
	|	ЕСТЬNULL(ВТ_Остатки.Ячейка.Наименование, """") КАК ЯчейкаНаименование
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ФактВсего КАК ВТ_ФактВсего
	|		ПО ВТ_Заказы.Заказ = ВТ_ФактВсего.Заказ
	|			И ВТ_Заказы.Номенклатура = ВТ_ФактВсего.Номенклатура
	|			И ВТ_Заказы.Характеристика = ВТ_ФактВсего.Характеристика
	|			И ВТ_Заказы.Партия = ВТ_ФактВсего.Партия
	|			И ВТ_Заказы.СерииНоменклатуры = ВТ_ФактВсего.СерииНоменклатуры
	|			И ВТ_Заказы.ЕдиницаИзмерения = ВТ_ФактВсего.ЕдиницаИзмерения
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ВТ_Заказы.Организация = ВТ_Остатки.Организация
	|			И ВТ_Заказы.Номенклатура = ВТ_Остатки.Номенклатура
	|			И ВТ_Заказы.Характеристика = ВТ_Остатки.Характеристика
	|			И ВТ_Заказы.Партия = ВТ_Остатки.Партия
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ФактПоЯчейкам КАК ВТ_ФактПоЯчейкам
	|		ПО ВТ_Заказы.Заказ = ВТ_ФактПоЯчейкам.Заказ
	|			И ВТ_Заказы.Номенклатура = ВТ_ФактПоЯчейкам.Номенклатура
	|			И ВТ_Заказы.Характеристика = ВТ_ФактПоЯчейкам.Характеристика
	|			И ВТ_Заказы.Партия = ВТ_ФактПоЯчейкам.Партия
	|			И ВТ_Заказы.СерииНоменклатуры = ВТ_ФактПоЯчейкам.СерииНоменклатуры
	|			И ВТ_Заказы.ЕдиницаИзмерения = ВТ_ФактПоЯчейкам.ЕдиницаИзмерения
	|			И ВТ_Остатки.Склад = ВТ_ФактПоЯчейкам.Склад
	|			И ВТ_Остатки.Ячейка = ВТ_ФактПоЯчейкам.Ячейка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.спМаршрутКладовщика КАК МаршрутЯчейки
	|		ПО ВТ_Остатки.Склад = МаршрутЯчейки.Склад
	|			И ВТ_Остатки.Ячейка = МаршрутЯчейки.Ячейка
	|			И МаршрутЯчейки.Ячейка <> ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.спМаршрутКладовщика КАК МаршрутСклада
	|		ПО ВТ_Остатки.Склад = МаршрутСклада.Склад
	|			И МаршрутСклада.Ячейка = ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)	
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядокСклада,
	|	Склад,
	|	ПорядокЯчейки,
	|	ЯчейкаНаименование,
	|	Ячейка,
	|	Заказ,
	|	Номенклатура,
	|	Характеристика,
	|	Партия,
	|	СерииНоменклатуры,
	|	ЕдиницаИзмерения";

	Запрос.УстановитьПараметр("Заказы", МассивЗаказов);
	Запрос.УстановитьПараметр("ДатаОстатков", ТекущаяДатаСеанса());

	СкладТорговыйЗал = сп_СкладТорговыйЗалНаСервере();
	Запрос.УстановитьПараметр("СкладТорговыйЗал", СкладТорговыйЗал);

	Таблица = Запрос.Выполнить().Выгрузить();

	ТекущийКлюч = "";
	ОсталосьРаспределить = 0;

	Для каждого Стр Из Таблица Цикл

		СкладОтправительЗаказа = сп_СкладОтправительЗаказаНаСервере(Стр.Заказ);
		ЗаказИзТорговогоЗала = сп_ЭтоТорговыйЗалНаСервере(СкладОтправительЗаказа);

		Если ЗаказИзТорговогоЗала Тогда

			Если Стр.Склад <> СкладОтправительЗаказа Тогда
				Продолжить;
			КонецЕсли;

		ИначеЕсли ЗначениеЗаполнено(СкладТорговыйЗал)
			И Стр.Склад = СкладТорговыйЗал Тогда
			Продолжить;
		КонецЕсли;

		Ключ = сп_КлючЗаказТовар(
			Стр.Заказ,
			Стр.Номенклатура,
			Стр.Характеристика,
			Стр.Партия,
			Стр.СерииНоменклатуры,
			Стр.ЕдиницаИзмерения);
		Если Ключ <> ТекущийКлюч Тогда
			ТекущийКлюч = Ключ;
			ОсталосьРаспределить = Стр.КоличествоПланВсего - Стр.КоличествоФактВсего;
		КонецЕсли;

		КоличествоФактЯчейки = Стр.КоличествоФактЯчейки;
		ДоступноДляДосканирования = Стр.КоличествоНаСкладе - КоличествоФактЯчейки;

		Если ДоступноДляДосканирования < 0 Тогда
			ДоступноДляДосканирования = 0;
		КонецЕсли;

		КоличествоКДосканированию = Мин(ОсталосьРаспределить, ДоступноДляДосканирования);

		Если КоличествоКДосканированию < 0 Тогда
			КоличествоКДосканированию = 0;
		КонецЕсли;

		Если КоличествоКДосканированию = 0
			И КоличествоФактЯчейки = 0
			И Стр.КоличествоНаСкладе = 0
			И ОсталосьРаспределить > 0 Тогда

			КоличествоПланСтроки = ОсталосьРаспределить;
			ОтклонениеСтроки = ОсталосьРаспределить;
			ОсталосьРаспределить = 0;

		Иначе

			КоличествоПланСтроки = КоличествоФактЯчейки + КоличествоКДосканированию;
			ОтклонениеСтроки = КоличествоПланСтроки - КоличествоФактЯчейки;
			ОсталосьРаспределить = ОсталосьРаспределить - КоличествоКДосканированию;

		КонецЕсли;

		Если КоличествоПланСтроки <= 0 И КоличествоФактЯчейки <= 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();

		НоваяСтрока.Заказ = Стр.Заказ;
		НоваяСтрока.Номенклатура = Стр.Номенклатура;
		НоваяСтрока.Характеристика = Стр.Характеристика;
		НоваяСтрока.Партия = Стр.Партия;
		НоваяСтрока.СерииНоменклатуры = Стр.СерииНоменклатуры;
		НоваяСтрока.ЕдиницаИзмерения = Стр.ЕдиницаИзмерения;
		Если ЗаказИзТорговогоЗала Тогда
			НоваяСтрока.Склад = СкладОтправительЗаказа;
			НоваяСтрока.Ячейка = Справочники.Ячейки.ПустаяСсылка();
		Иначе
			НоваяСтрока.Склад = Стр.Склад;
			НоваяСтрока.Ячейка = Стр.Ячейка;
		КонецЕсли;
		НоваяСтрока.КоличествоПлан = КоличествоПланСтроки;
		НоваяСтрока.КоличествоФакт = КоличествоФактЯчейки;
		НоваяСтрока.Отклонение = ОтклонениеСтроки;
		НоваяСтрока.КоличествоНаСкладе = Стр.КоличествоНаСкладе;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область РаботаСКартинкамиИТоварами

&НаСервере
Функция сп_КоличествоШтПредставление(Количество)

	Если Количество = Неопределено Тогда
		Количество = 0;
	КонецЕсли;

	Если ТипЗнч(Количество) <> Тип("Число") Тогда
		Попытка
			Количество = Число(Количество);
		Исключение
			Количество = 0;
		КонецПопытки;
	КонецЕсли;

	Если Количество = 0 Тогда
		Возврат "0 шт";
	КонецЕсли;

	Возврат Формат(Количество, "ЧДЦ=0") + " шт";

КонецФункции

&НаСервере
Функция сп_РеквизитыТовараДляОтображения(Номенклатура)

	Результат = Новый Структура;
	Результат.Вставить("Наименование", "");
	Результат.Вставить("Артикул", "");
	Результат.Вставить("Бренд", "");
	Результат.Вставить("Цвет", "");
	Результат.Вставить("Размер", "");

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Наименование = Строка(Номенклатура);

	Попытка

		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Номенклатура,
			"Артикул, спАртикулПоставщика, спБренд, спЦвет, спРазмер");

		Если Реквизиты <> Неопределено Тогда

			Если Реквизиты.Свойство("Артикул")
				И ЗначениеЗаполнено(Реквизиты.Артикул) Тогда

				Результат.Артикул = Строка(Реквизиты.Артикул);

			ИначеЕсли Реквизиты.Свойство("спАртикулПоставщика")
				И ЗначениеЗаполнено(Реквизиты.спАртикулПоставщика) Тогда

				Результат.Артикул = Строка(Реквизиты.спАртикулПоставщика);

			КонецЕсли;

			Если Реквизиты.Свойство("спБренд")
				И ЗначениеЗаполнено(Реквизиты.спБренд) Тогда
				Результат.Бренд = Строка(Реквизиты.спБренд);
			КонецЕсли;

			Если Реквизиты.Свойство("спЦвет")
				И ЗначениеЗаполнено(Реквизиты.спЦвет) Тогда
				Результат.Цвет = Строка(Реквизиты.спЦвет);
			КонецЕсли;

			Если Реквизиты.Свойство("спРазмер")
				И ЗначениеЗаполнено(Реквизиты.спРазмер) Тогда
				Результат.Размер = Строка(Реквизиты.спРазмер);
			КонецЕсли;

		КонецЕсли;

	Исключение
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервере
Функция сп_НаименованиеТовараДляСписка(РеквизитыТовара)

	Результат = РеквизитыТовара.Наименование;

	СтрокаСвойств = "";

	Если ЗначениеЗаполнено(РеквизитыТовара.Цвет) Тогда

		Если ЗначениеЗаполнено(СтрокаСвойств) Тогда
			СтрокаСвойств = СтрокаСвойств + "; ";
		КонецЕсли;

		СтрокаСвойств = СтрокаСвойств + "Цвет: " + РеквизитыТовара.Цвет;

	КонецЕсли;

	Если ЗначениеЗаполнено(СтрокаСвойств) Тогда
		Результат = Результат + Символы.ПС + СтрокаСвойств;
	КонецЕсли;

	Если ЗначениеЗаполнено(РеквизитыТовара.Размер) Тогда
		Результат = Результат + Символы.ПС + "Размер: " + РеквизитыТовара.Размер;
	КонецЕсли;

	Возврат Результат;

КонецФункции  

&НаСервере
Функция сп_КартинкаНоменклатуры(Номенклатура)

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;

	//+++ Tnext Козык К.А. - Вистерия - 24.06.2026
	// Возвращаем нетиповой механизм Вистерии: основной источник картинок —
	// РегистрСведений.спВнешниеКартинкиТовара. Картинку сервером не скачиваем,
	// в АРМ передаем прямой URL, как работало до обновления.
	АдресКартинки = сп_КартинкаИзВнешнегоРегистраПоАртикулу(Номенклатура);

	Если ЗначениеЗаполнено(АдресКартинки) Тогда
		Возврат АдресКартинки;
	КонецЕсли;

	АдресКартинки = сп_КартинкаИзФайлаКартинкиНоменклатуры(Номенклатура);

	Если ЗначениеЗаполнено(АдресКартинки) Тогда
		Возврат АдресКартинки;
	КонецЕсли;

	АдресКартинки = сп_КартинкаИзПрисоединенногоФайлаНоменклатуры(Номенклатура);

	Если ЗначениеЗаполнено(АдресКартинки) Тогда
		Возврат АдресКартинки;
	КонецЕсли;

	Возврат "";
	//--- Tnext Козык К.А. - Вистерия - 24.06.2026

КонецФункции

&НаСервере
Функция сп_КартинкаИзФайлаКартинкиНоменклатуры(Номенклатура)

	ФайлКартинки = Неопределено;

	Попытка

		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Номенклатура,
			"ФайлКартинки");

		Если Реквизиты <> Неопределено
			И Реквизиты.Свойство("ФайлКартинки")
			И ЗначениеЗаполнено(Реквизиты.ФайлКартинки) Тогда

			ФайлКартинки = Реквизиты.ФайлКартинки;

		КонецЕсли;

	Исключение
		Возврат "";
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ФайлКартинки) Тогда
		Возврат "";
	КонецЕсли;

	Попытка

		Возврат РаботаСФайламиУНФ.СсылкаНаДвоичныеДанныеФайла(
			ФайлКартинки,
			Новый УникальныйИдентификатор);

	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

//+++ Tnext Козык К.А. - Вистерия - 24.06.2026
&НаСервере
Функция сп_КартинкаИзПрисоединенногоФайлаНоменклатуры(Номенклатура)

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;

	ФайлКартинки = Неопределено;

	// В УНФ картинки номенклатуры могут храниться как присоединенные файлы.
	// Запрос намеренно простой: без отбора по необязательным полям "Основной",
	// "ДатаМодификации" и т.п., чтобы не падать на отличиях релизов.
	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|   Файлы.Ссылка КАК Файл
		|ИЗ
		|   Справочник.НоменклатураПрисоединенныеФайлы КАК Файлы
		|ГДЕ
		|   Файлы.ВладелецФайла = &ВладелецФайла
		|   И НЕ Файлы.ПометкаУдаления";

		Запрос.УстановитьПараметр("ВладелецФайла", Номенклатура);

		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			ФайлКартинки = Выборка.Файл;
		КонецЕсли;

	Исключение
		ФайлКартинки = Неопределено;
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ФайлКартинки) Тогда
		Возврат "";
	КонецЕсли;

	Возврат сп_АдресДвоичныхДанныхФайлаКартинки(ФайлКартинки);

КонецФункции

&НаСервере
Функция сп_АдресДвоичныхДанныхФайлаКартинки(ФайлКартинки)

	Если Не ЗначениеЗаполнено(ФайлКартинки) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		АдресКартинки = РаботаСФайламиУНФ.СсылкаНаДвоичныеДанныеФайла(
			ФайлКартинки,
			Новый УникальныйИдентификатор);

		Если ЗначениеЗаполнено(АдресКартинки) Тогда
			Возврат АдресКартинки;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(ФайлКартинки);
		Если ДанныеФайла <> Неопределено
			И ДанныеФайла.Свойство("СсылкаНаДвоичныеДанныеФайла")
			И ЗначениеЗаполнено(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла) Тогда
			Возврат ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат "";

КонецФункции
