&НаКлиенте
Процедура сп_ОбработатьШтрихкодТСД(Штрихкод)

	Штрихкод = СокрЛП(Строка(Штрихкод));

	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат;
	КонецЕсли;

	Штрихкод = сп_ИзвлечьШтрихкодИзDataMatrixНаКлиенте(Штрихкод);

	СканироватьТоварЗавершение(Штрихкод, Неопределено);

КонецПроцедуры

&НаКлиенте
Функция сп_ШтрихкодИзПараметраСканера(Параметр)

	Штрихкод = "";
	ДанныеСканера = Неопределено;

	Если ТипЗнч(Параметр) = Тип("Массив") Тогда

		Если Параметр.Количество() = 0 Тогда
			Возврат "";
		КонецЕсли;

		ДанныеСканера = Параметр[0];

	Иначе

		ДанныеСканера = Параметр;

	КонецЕсли;

	Если ДанныеСканера = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(ДанныеСканера) = Тип("Структура") Тогда

		Если ДанныеСканера.Свойство("Штрихкод") Тогда
			Штрихкод = СокрЛП(Строка(ДанныеСканера.Штрихкод));
		ИначеЕсли ДанныеСканера.Свойство("Barcode") Тогда
			Штрихкод = СокрЛП(Строка(ДанныеСканера.Barcode));
		ИначеЕсли ДанныеСканера.Свойство("ШтрихКод") Тогда
			Штрихкод = СокрЛП(Строка(ДанныеСканера.ШтрихКод));
		ИначеЕсли ДанныеСканера.Свойство("Data") Тогда
			Штрихкод = СокрЛП(Строка(ДанныеСканера.Data));
		ИначеЕсли ДанныеСканера.Свойство("Данные") Тогда
			Штрихкод = СокрЛП(Строка(ДанныеСканера.Данные));
		КонецЕсли;

	Иначе

		Штрихкод = СокрЛП(Строка(ДанныеСканера));

	КонецЕсли;

	Возврат Штрихкод;

КонецФункции

&НаКлиенте
Функция сп_ИзвлечьШтрихкодИзDataMatrixНаКлиенте(СтрокаСканера)

	РабочаяСтрока = СокрЛП(Строка(СтрокаСканера));

	Для каждого Префикс Из СтрРазделить("]d2,]C1,]Q3,]e0", ",") Цикл
		Если Лев(РабочаяСтрока, СтрДлина(Префикс)) = Префикс Тогда
			РабочаяСтрока = Сред(РабочаяСтрока, СтрДлина(Префикс) + 1);
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Лев(РабочаяСтрока, 2) = "01"
		И СтрДлина(РабочаяСтрока) >= 16 Тогда

		GTIN14 = Сред(РабочаяСтрока, 3, 14);
		ЭтоЦифры = Истина;

		Для ИндексСимвола = 1 По СтрДлина(GTIN14) Цикл
			Если Найти("0123456789", Сред(GTIN14, ИндексСимвола, 1)) = 0 Тогда
				ЭтоЦифры = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ЭтоЦифры Тогда
			Если Лев(GTIN14, 1) = "0" Тогда
				Возврат Сред(GTIN14, 2);
			Иначе
				Возврат GTIN14;
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

	Возврат СтрокаСканера;

КонецФункции


