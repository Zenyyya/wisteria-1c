&НаСервере
Функция сп_АртикулПоставщикаНоменклатуры(Номенклатура)

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;

	АртикулПоставщика = "";

	Попытка

		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Номенклатура,
			"спАртикулПоставщика, Артикул");

		Если Реквизиты <> Неопределено Тогда

			Если Реквизиты.Свойство("спАртикулПоставщика")
				И ЗначениеЗаполнено(Реквизиты.спАртикулПоставщика) Тогда

				АртикулПоставщика = СокрЛП(Строка(Реквизиты.спАртикулПоставщика));

			ИначеЕсли Реквизиты.Свойство("Артикул")
				И ЗначениеЗаполнено(Реквизиты.Артикул) Тогда

				АртикулПоставщика = СокрЛП(Строка(Реквизиты.Артикул));

			КонецЕсли;

		КонецЕсли;

	Исключение
		АртикулПоставщика = "";
	КонецПопытки;

	Возврат АртикулПоставщика;

