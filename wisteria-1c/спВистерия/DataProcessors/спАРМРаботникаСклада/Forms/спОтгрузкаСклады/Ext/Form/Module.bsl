Функция сп_СкладТорговыйЗалНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|   Склады.Ссылка КАК Ссылка
	|ИЗ
	|   Справочник.СтруктурныеЕдиницы КАК Склады
	|ГДЕ
	|   НЕ Склады.ПометкаУдаления
	|   И НРег(Склады.Наименование) = &НаименованиеТорговыйЗал
	|
	|УПОРЯДОЧИТЬ ПО
	|   Склады.Наименование";

	Запрос.УстановитьПараметр("НаименованиеТорговыйЗал", НРег("Торговый зал Wisteria"));

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|   Склады.Ссылка КАК Ссылка
	|ИЗ
	|   Справочник.СтруктурныеЕдиницы КАК Склады
	|ГДЕ
	|   НЕ Склады.ПометкаУдаления
	|   И НРег(Склады.Наименование) ПОДОБНО &НаименованиеТорговыйЗал
	|
	|УПОРЯДОЧИТЬ ПО
	|   Склады.Наименование";

	Запрос.УстановитьПараметр("НаименованиеТорговыйЗал", "%торговый%зал%");

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Справочники.СтруктурныеЕдиницы.ПустаяСсылка();

КонецФункции

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура сп_ИнициализироватьЗаказыИзПараметров()

	Если ЗначениеЗаполнено(ЗаказыСериализованные) Тогда
		м_Заказы = сп_ПолучитьЗаказыДляПередачиНаСервере();
		Возврат;
	КонецЕсли;

	СписокЗаказов = Новый СписокЗначений;

	ЗаказыСериализованныеПараметр = "";

	Если Параметры.Свойство("ЗаказыСериализованные", ЗаказыСериализованныеПараметр)
		И ЗначениеЗаполнено(ЗаказыСериализованныеПараметр) Тогда

		Попытка
			СписокЗаказовИзПараметра = ЗначениеИзСтрокиВнутр(ЗаказыСериализованныеПараметр);
		Исключение
			СписокЗаказовИзПараметра = Новый СписокЗначений;
		КонецПопытки;

		СписокЗаказов = сп_НормализоватьСписокЗаказовНаСервере(СписокЗаказовИзПараметра);

	КонецЕсли;

	Если СписокЗаказов.Количество() = 0 Тогда

		ЗаказыПараметр = Неопределено;

		Если Параметры.Свойство("Заказы", ЗаказыПараметр) Тогда
			СписокЗаказов = сп_НормализоватьСписокЗаказовНаСервере(ЗаказыПараметр);
		КонецЕсли;

	КонецЕсли;

	Если СписокЗаказов.Количество() > 0 Тогда
		ЗаказыСериализованные = ЗначениеВСтрокуВнутр(СписокЗаказов);
	КонецЕсли;

	м_Заказы = СписокЗаказов;

КонецПроцедуры


&НаСервере
Функция сп_НормализоватьСписокЗаказовНаСервере(ЗначениеЗаказов)

	Результат = Новый СписокЗначений;

	Если ЗначениеЗаказов = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(ЗначениеЗаказов) = Тип("СписокЗначений") Тогда

		Для каждого ЭлементСписка Из ЗначениеЗаказов Цикл

			Если ЗначениеЗаполнено(ЭлементСписка.Значение)
				И Результат.НайтиПоЗначению(ЭлементСписка.Значение) = Неопределено Тогда

				Результат.Добавить(
					ЭлементСписка.Значение,
					Строка(ЭлементСписка.Значение));

			КонецЕсли;

		КонецЦикла;

	ИначеЕсли ТипЗнч(ЗначениеЗаказов) = Тип("Массив") Тогда

		Для каждого Заказ Из ЗначениеЗаказов Цикл

			Если ЗначениеЗаполнено(Заказ)
				И Результат.НайтиПоЗначению(Заказ) = Неопределено Тогда

				Результат.Добавить(Заказ, Строка(Заказ));

			КонецЕсли;

		КонецЦикла;

	ИначеЕсли ТипЗнч(ЗначениеЗаказов) = Тип("Строка") Тогда

		Если ЗначениеЗаполнено(ЗначениеЗаказов) Тогда

			Попытка
				СписокИзСтроки = ЗначениеИзСтрокиВнутр(ЗначениеЗаказов);
				Результат = сп_НормализоватьСписокЗаказовНаСервере(СписокИзСтроки);
			Исключение
			КонецПопытки;

		КонецЕсли;

	ИначеЕсли ЗначениеЗаполнено(ЗначениеЗаказов) Тогда

		Результат.Добавить(ЗначениеЗаказов, Строка(ЗначениеЗаказов));

	КонецЕсли;

	Возврат Результат;

КонецФункции


&НаСервере
Функция сп_ПолучитьЗаказыДляПередачиНаСервере()

	Если м_Заказы <> Неопределено
		И ТипЗнч(м_Заказы) = Тип("СписокЗначений")
		И м_Заказы.Количество() > 0 Тогда

		Возврат м_Заказы;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ЗаказыСериализованные) Тогда

		ЗаказыСериализованныеПараметр = "";

		Если Параметры.Свойство("ЗаказыСериализованные", ЗаказыСериализованныеПараметр)
			И ЗначениеЗаполнено(ЗаказыСериализованныеПараметр) Тогда

			ЗаказыСериализованные = ЗаказыСериализованныеПараметр;

		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ЗаказыСериализованные) Тогда
		Возврат Новый СписокЗначений;
	КонецЕсли;

	Попытка
		Результат = ЗначениеИзСтрокиВнутр(ЗаказыСериализованные);
	Исключение
		Результат = Новый СписокЗначений;
	КонецПопытки;

	Результат = сп_НормализоватьСписокЗаказовНаСервере(Результат);

	м_Заказы = Результат;

	Возврат Результат;

КонецФункции


&НаСервере
Функция сп_МассивЗаказовНаСервере()

	СписокЗаказов = сп_ПолучитьЗаказыДляПередачиНаСервере();

	Результат = Новый Массив;

	Для каждого ЭлементСписка Из СписокЗаказов Цикл

		Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
			Результат.Добавить(ЭлементСписка.Значение);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции


&НаСервере
Функция сп_ПолучитьСкладПоНаименованиюНаСервере(НаименованиеСклада)

	Если Не ЗначениеЗаполнено(НаименованиеСклада) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТаблицаЗапасов = сп_ПолучитьТаблицуЗапасовОтгрузкиНаСервере();

	Для каждого Стр Из ТаблицаЗапасов Цикл

		Если ЗначениеЗаполнено(Стр.Склад)
			И Строка(Стр.Склад) = НаименованиеСклада Тогда

			Возврат Стр.Склад;

		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции


&НаСервере
Функция сп_ФорматКоличествоСловом(Количество, Форма1, Форма2, Форма5)

	КоличествоЦелое = Цел(Количество);
	Остаток100 = КоличествоЦелое % 100;
	Остаток10 = КоличествоЦелое % 10;

	Если Остаток100 >= 11 И Остаток100 <= 19 Тогда
		Форма = Форма5;
	ИначеЕсли Остаток10 = 1 Тогда
		Форма = Форма1;
	ИначеЕсли Остаток10 >= 2 И Остаток10 <= 4 Тогда
		Форма = Форма2;
	Иначе
		Форма = Форма5;
	КонецЕсли;

	Возврат Строка(КоличествоЦелое) + " " + Форма;

КонецФункции


&НаКлиенте
Процедура ПоказыватьОтсканированныеПриИзменении(Элемент)
	
	ЗаполнитьСкладыНаСервере();

	Попытка
		Элементы.Данные.Обновить();
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция сп_КлючЗначенияАРМ(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Возврат Строка(Значение.УникальныйИдентификатор());
	Исключение
	КонецПопытки;
	
	Возврат Строка(Значение);
	
КонецФункции

&НаСервере
Функция сп_КлючТовара(Номенклатура, Характеристика, Партия, СерииНоменклатуры, ЕдиницаИзмерения)
	
	Возврат 
		сп_КлючЗначенияАРМ(Номенклатура) + "|"
		+ сп_КлючЗначенияАРМ(Характеристика) + "|"
		+ сп_КлючЗначенияАРМ(Партия) + "|"
		+ сп_КлючЗначенияАРМ(СерииНоменклатуры) + "|"
		+ сп_КлючЗначенияАРМ(ЕдиницаИзмерения);
	
КонецФункции

&НаСервере
Функция сп_КлючЗаказТовар(Заказ, Номенклатура, Характеристика, Партия, СерииНоменклатуры, ЕдиницаИзмерения)
	
	Возврат 
		сп_КлючЗначенияАРМ(Заказ) + "|"
		+ сп_КлючТовара(Номенклатура, Характеристика, Партия, СерииНоменклатуры, ЕдиницаИзмерения);
	
КонецФункции

#КонецОбласти