#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	сп_ИнициализироватьПараметрыФормы();

	ЗаполнитьСписокПеремещенийНаСервере();

	Попытка
		Элементы.ЗаказыСериализованные.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеЗаказОснование.Видимость = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеПредставление.МногострочныйРежим = Истина;
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ДанныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьВыбранноеПеремещение();

КонецПроцедуры

#КонецОбласти

#Область Навигация

&НаКлиенте
Процедура ОткрытьВыбранноеПеремещение()

	ТекущиеДанные = Элементы.Данные.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущиеДанные.Перемещение) Тогда
		Возврат;
	КонецЕсли;

	ОткрытьЗначение(ТекущиеДанные.Перемещение);

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДанныхФормы

&НаСервере
Процедура ЗаполнитьСписокПеремещенийНаСервере()

	сп_ИнициализироватьПараметрыФормы();

	Данные.Очистить();

	МассивЗаказов = сп_МассивЗаказовНаСервере();

	Если МассивЗаказов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Перемещение.Ссылка КАК Перемещение,
	|	Перемещение.Дата КАК Дата,
	|	Перемещение.Номер КАК Номер,
	|	Перемещение.Проведен КАК Проведен,
	|	Перемещение.СтруктурнаяЕдиница КАК СкладОтправитель,
	|	Перемещение.СтруктурнаяЕдиницаПолучатель КАК СкладПолучатель,
	|	Перемещение.ДокументОснование КАК ЗаказОснование
	|ИЗ
	|	Документ.ПеремещениеЗапасов КАК Перемещение
	|ГДЕ
	|	НЕ Перемещение.ПометкаУдаления
	|	И Перемещение.ДокументОснование В (&Заказы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Перемещение.Дата УБЫВ,
	|	Перемещение.Номер УБЫВ";

	Запрос.УстановитьПараметр("Заказы", МассивЗаказов);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		СтрокаСписка = Данные.Добавить();

		СтрокаСписка.Перемещение = Выборка.Перемещение;
		СтрокаСписка.Дата = Выборка.Дата;
		СтрокаСписка.Номер = Выборка.Номер;
		СтрокаСписка.СкладОтправитель = Выборка.СкладОтправитель;
		СтрокаСписка.СкладПолучатель = Выборка.СкладПолучатель;
		СтрокаСписка.ЗаказОснование = Выборка.ЗаказОснование;

		Если Выборка.Проведен Тогда
			СтрокаСписка.Статус = "Проведен";
		Иначе
			СтрокаСписка.Статус = "Не проведен";
		КонецЕсли;

		СтрокаСписка.Представление =
			Строка(Выборка.Перемещение)
			+ Символы.ПС
			+ "Склад отправитель: " + Строка(Выборка.СкладОтправитель)
			+ Символы.ПС
			+ "Склад получатель: " + Строка(Выборка.СкладПолучатель)
			+ Символы.ПС
			+ "Основание: " + Строка(Выборка.ЗаказОснование)
			+ Символы.ПС
			+ "Статус: " + СтрокаСписка.Статус;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура сп_ИнициализироватьПараметрыФормы()

	Если Не ЗначениеЗаполнено(ЗаказыСериализованные) Тогда

		ЗаказыСтрокойПараметр = "";

		Если Параметры.Свойство("ЗаказыСериализованные", ЗаказыСтрокойПараметр)
			И ЗначениеЗаполнено(ЗаказыСтрокойПараметр) Тогда

			ЗаказыСериализованные = ЗаказыСтрокойПараметр;

		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ЗаказыСериализованные) Тогда

		ЗаказыПараметр = Неопределено;

		Если Параметры.Свойство("Заказы", ЗаказыПараметр) Тогда
			ЗаказыСериализованные = ЗначениеВСтрокуВнутр(сп_СписокЗаказовИзЗначения(ЗаказыПараметр));
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция сп_СписокЗаказовИзЗначения(ЗначениеЗаказов)

	Результат = Новый СписокЗначений;

	Если ЗначениеЗаказов = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(ЗначениеЗаказов) = Тип("СписокЗначений") Тогда

		Для каждого ЭлементСписка Из ЗначениеЗаказов Цикл

			Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
				сп_ДобавитьЗаказВCписокЕслиЕгоЕщеНет(Результат, ЭлементСписка.Значение);
			КонецЕсли;

		КонецЦикла;

	ИначеЕсли ТипЗнч(ЗначениеЗаказов) = Тип("Массив") Тогда

		Для каждого Заказ Из ЗначениеЗаказов Цикл

			Если ЗначениеЗаполнено(Заказ) Тогда
				сп_ДобавитьЗаказВCписокЕслиЕгоЕщеНет(Результат, Заказ);
			КонецЕсли;

		КонецЦикла;

	ИначеЕсли ЗначениеЗаполнено(ЗначениеЗаказов) Тогда

		сп_ДобавитьЗаказВCписокЕслиЕгоЕщеНет(Результат, ЗначениеЗаказов);

	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура сп_ДобавитьЗаказВCписокЕслиЕгоЕщеНет(СписокЗаказов, Заказ)

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;

	Для каждого ЭлементСписка Из СписокЗаказов Цикл

		Если ЭлементСписка.Значение = Заказ Тогда
			Возврат;
		КонецЕсли;

	КонецЦикла;

	СписокЗаказов.Добавить(Заказ, Строка(Заказ));

КонецПроцедуры

&НаСервере
Функция сп_СписокЗаказовНаСервере()

	сп_ИнициализироватьПараметрыФормы();

	Если Не ЗначениеЗаполнено(ЗаказыСериализованные) Тогда
		Возврат Новый СписокЗначений;
	КонецЕсли;

	Попытка
		Результат = ЗначениеИзСтрокиВнутр(ЗаказыСериализованные);
	Исключение
		Результат = Новый СписокЗначений;
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервере
Функция сп_МассивЗаказовНаСервере()

	СписокЗаказов = сп_СписокЗаказовНаСервере();

	Результат = Новый Массив;

	Для каждого ЭлементСписка Из СписокЗаказов Цикл

		Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
			Результат.Добавить(ЭлементСписка.Значение);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти