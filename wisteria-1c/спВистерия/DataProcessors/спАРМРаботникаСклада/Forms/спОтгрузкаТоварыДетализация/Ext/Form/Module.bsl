#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура сп_ИнициализироватьПараметрыФормы()

	Если Не ЗначениеЗаполнено(ЗаказыСериализованные) Тогда

		ЗаказыСтрокойПараметр = "";

		Если Параметры.Свойство("ЗаказыСериализованные", ЗаказыСтрокойПараметр) Тогда
			ЗаказыСериализованные = ЗаказыСтрокойПараметр;
		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ЗаказыСериализованные) Тогда

		ЗаказыПараметр = Неопределено;

		Если Параметры.Свойство("Заказы", ЗаказыПараметр) Тогда

			СписокЗаказов = сп_НормализоватьСписокЗаказовНаСервере(ЗаказыПараметр);

			Если СписокЗаказов.Количество() > 0 Тогда
				ЗаказыСериализованные = ЗначениеВСтрокуВнутр(СписокЗаказов);
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийСклад) Тогда

		СкладПараметр = Неопределено;

		Если Параметры.Свойство("Склад", СкладПараметр) Тогда
			ТекущийСклад = СкладПараметр;
		КонецЕсли;

	КонецЕсли;

	ЯчейкаПараметр = Неопределено;

	Если Параметры.Свойство("Ячейка", ЯчейкаПараметр) Тогда
		ТекущаяЯчейка = ЯчейкаПараметр;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущаяНоменклатура) Тогда

		НоменклатураПараметр = Неопределено;

		Если Параметры.Свойство("Номенклатура", НоменклатураПараметр) Тогда
			ТекущаяНоменклатура = НоменклатураПараметр;
		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущаяЕдиницаИзмерения) Тогда

		ЕдиницаПараметр = Неопределено;

		Если Параметры.Свойство("ЕдиницаИзмерения", ЕдиницаПараметр) Тогда
			ТекущаяЕдиницаИзмерения = ЕдиницаПараметр;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция сп_НормализоватьСписокЗаказовНаСервере(ЗначениеЗаказов)

	Результат = Новый СписокЗначений;

	Если ЗначениеЗаказов = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(ЗначениеЗаказов) = Тип("СписокЗначений") Тогда

		Для каждого ЭлементСписка Из ЗначениеЗаказов Цикл

			Если ЗначениеЗаполнено(ЭлементСписка.Значение)
				И Результат.НайтиПоЗначению(ЭлементСписка.Значение) = Неопределено Тогда

				Результат.Добавить(ЭлементСписка.Значение, Строка(ЭлементСписка.Значение));

			КонецЕсли;

		КонецЦикла;

	ИначеЕсли ТипЗнч(ЗначениеЗаказов) = Тип("Массив") Тогда

		Для каждого Заказ Из ЗначениеЗаказов Цикл

			Если ЗначениеЗаполнено(Заказ)
				И Результат.НайтиПоЗначению(Заказ) = Неопределено Тогда

				Результат.Добавить(Заказ, Строка(Заказ));

			КонецЕсли;

		КонецЦикла;

	ИначеЕсли ЗначениеЗаполнено(ЗначениеЗаказов) Тогда

		Результат.Добавить(ЗначениеЗаказов, Строка(ЗначениеЗаказов));

	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция сп_МассивЗаказовНаСервере()

	Результат = Новый Массив;

	Если Не ЗначениеЗаполнено(ЗаказыСериализованные) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		СписокЗаказов = ЗначениеИзСтрокиВнутр(ЗаказыСериализованные);
	Исключение
		Возврат Результат;
	КонецПопытки;

	СписокЗаказов = сп_НормализоватьСписокЗаказовНаСервере(СписокЗаказов);

	Для каждого ЭлементСписка Из СписокЗаказов Цикл

		Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
			Результат.Добавить(ЭлементСписка.Значение);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция сп_ЭтоВозвратИзТорговогоЗалаНаСервере()

	Если сп_ЭтоТорговыйЗал(ТекущийСклад) Тогда
		Возврат Истина;
	КонецЕсли;

	МассивЗаказов = сп_МассивЗаказовНаСервере();

	Если МассивЗаказов.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заказ.СтруктурнаяЕдиницаРезерв КАК СкладОтправитель,
	|	Заказ.СтруктурнаяЕдиницаПолучатель КАК СкладПолучатель
	|ИЗ
	|	Документ.ЗаказНаПеремещение КАК Заказ
	|ГДЕ
	|	Заказ.Ссылка В (&Заказы)";

	Запрос.УстановитьПараметр("Заказы", МассивЗаказов);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл

		Если сп_ЭтоТорговыйЗал(Выборка.СкладОтправитель)
			И Не сп_ЭтоТорговыйЗал(Выборка.СкладПолучатель) Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервере
Функция сп_ЭтоТорговыйЗал(Склад)

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПредставлениеСклада = НРег(Строка(Склад));

	Возврат СтрНайти(ПредставлениеСклада, "торгов") > 0
		И СтрНайти(ПредставлениеСклада, "зал") > 0;

