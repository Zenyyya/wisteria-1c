Функция сп_СкачатьКартинкуПоURLВоВременноеХранилище(АдресURL)

	Если Не ЗначениеЗаполнено(АдресURL) Тогда
		Возврат "";
	КонецЕсли;

	Попытка

		ДвоичныеДанные = сп_ПолучитьДвоичныеДанныеПоURL(АдресURL);

		Если ДвоичныеДанные = Неопределено Тогда
			Возврат "";
		КонецЕсли;

		Картинка = Новый Картинка(ДвоичныеДанные);

		Попытка
			ОбрабатываемаяКартинка = Новый ОбрабатываемаяКартинка(Картинка);
			ОбрабатываемаяКартинка.УстановитьРазмер(320, );
			Картинка = ОбрабатываемаяКартинка.ПолучитьКартинку();
		Исключение
		КонецПопытки;

		Возврат ПоместитьВоВременноеХранилище(Картинка, УникальныйИдентификатор);

	Исключение
		Возврат "";
	КонецПопытки;

