#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	сп_ИнициализироватьПараметрыФормы();

	сп_НастроитьИнтерфейс();

	ЗаполнитьДетализациюНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеФормы

&НаСервере
Процедура ЗаполнитьДетализациюНаСервере()

	сп_ИнициализироватьПараметрыФормы();

	Аналоги.Очистить();

	Если Не ЗначениеЗаполнено(ТекущаяНоменклатура) Тогда
		Возврат;
	КонецЕсли;

	РеквизитыТовара = сп_РеквизитыТовараДляОтображения(ТекущаяНоменклатура);

	Наименование = РеквизитыТовара.Наименование;
	Артикул = РеквизитыТовара.Артикул;
	Бренд = РеквизитыТовара.Бренд;
	Цвет = РеквизитыТовара.Цвет;
	Размер = РеквизитыТовара.Размер;

	АдресКартинки = сп_КартинкаНоменклатуры(ТекущаяНоменклатура);

	Изображения.Очистить();

	Если ЗначениеЗаполнено(АдресКартинки) Тогда

		СтрокаИзображения = Изображения.Добавить();
		СтрокаИзображения.Адрес = АдресКартинки;
		СтрокаИзображения.Ссылка = ТекущаяНоменклатура;

	КонецЕсли;

	ДанныеКоличеств = сп_ПолучитьПланФактТекущегоТовараНаСервере();

	КоличествоПлан = ДанныеКоличеств.План;
	КоличествоФакт = ДанныеКоличеств.Факт;
	Отклонение = КоличествоПлан - КоличествоФакт;

	Если Отклонение < 0 Тогда
		Отклонение = 0;
	КонецЕсли;

	КоличествоПланПредставление = сп_КоличествоШтПредставление(КоличествоПлан);
	КоличествоФактПредставление = сп_КоличествоШтПредставление(КоличествоФакт);
	ОтклонениеПредставление = сп_КоличествоШтПредставление(Отклонение);

	СтатусВидимость = Отклонение <= 0;

	ЗаполнитьАналогиНаСервере();

	ПодсказкаВидимость = Аналоги.Количество() > 0;

	Попытка
		Элементы.ГруппаАналоги.Видимость = ПодсказкаВидимость;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ТекстСтатуса.Видимость = СтатусВидимость;
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьАналогиНаСервере()

	Аналоги.Очистить();

	АртикулПоставщика = сп_АртикулПоставщикаНоменклатуры(ТекущаяНоменклатура);

	Если Не ЗначениеЗаполнено(АртикулПоставщика) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущаяЯчейка) Тогда
		ЯчейкаДляИсключения = ТекущаяЯчейка;
	Иначе
		ЯчейкаДляИсключения = Справочники.Ячейки.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.СтруктурнаяЕдиница КАК Склад,
	|	ЕСТЬNULL(Остатки.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) КАК Ячейка,
	|	ЕСТЬNULL(Остатки.Ячейка.Наименование, """") КАК ЯчейкаНаименование,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество,
	|	ЕСТЬNULL(Маршрут.ПорядокСклада, 999999) КАК ПорядокСклада,
	|	ЕСТЬNULL(Маршрут.ПорядокЯчейки, 999999) КАК ПорядокЯчейки
	|ИЗ
	|	РегистрНакопления.ЗапасыНаСкладах.Остатки(&ДатаОстатков) КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.спМаршрутКладовщика КАК Маршрут
	|		ПО Остатки.СтруктурнаяЕдиница = Маршрут.Склад
	|			И ЕСТЬNULL(Остатки.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) = Маршрут.Ячейка
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|	И Остатки.СтруктурнаяЕдиница <> &СкладТорговыйЗал
	|	И (
	|			НРег(Остатки.Номенклатура.спАртикулПоставщика) = &АртикулПоставщика
	|			ИЛИ НРег(Остатки.Номенклатура.Артикул) = &АртикулПоставщика
	|			ИЛИ НРег(Остатки.Номенклатура.Артикул) ПОДОБНО &АртикулПоставщикаШаблон
	|		)
	|	И НЕ (
	|			Остатки.СтруктурнаяЕдиница = &ТекущийСклад
	|			И ЕСТЬNULL(Остатки.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) = &ТекущаяЯчейка
	|		)
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.СтруктурнаяЕдиница,
	|	ЕСТЬNULL(Остатки.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)),
	|	ЕСТЬNULL(Остатки.Ячейка.Наименование, """"),
	|	ЕСТЬNULL(Маршрут.ПорядокСклада, 999999),
	|	ЕСТЬNULL(Маршрут.ПорядокЯчейки, 999999)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядокСклада,
	|	Склад,
	|	ПорядокЯчейки,
	|	ЯчейкаНаименование,
	|	Ячейка";

	Запрос.УстановитьПараметр("ДатаОстатков", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("СкладТорговыйЗал", сп_СкладТорговыйЗалНаСервере());
	Запрос.УстановитьПараметр("АртикулПоставщика", НРег(СокрЛП(АртикулПоставщика)));
	Запрос.УстановитьПараметр("АртикулПоставщикаШаблон", НРег(СокрЛП(АртикулПоставщика)) + "%");
	Запрос.УстановитьПараметр("ТекущийСклад", ТекущийСклад);
	Запрос.УстановитьПараметр("ТекущаяЯчейка", ЯчейкаДляИсключения);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл

		СтрокаАналога = Аналоги.Добавить();

		СтрокаАналога.Склад = Выборка.Склад;
		СтрокаАналога.Ячейка = Выборка.Ячейка;
		СтрокаАналога.Количество = Выборка.Количество;
		СтрокаАналога.КоличествоПредставление = сп_КоличествоШтПредставление(Выборка.Количество);

		Если ЗначениеЗаполнено(Выборка.Ячейка) Тогда
			СтрокаАналога.ЯчейкаПредставление = Строка(Выборка.Ячейка);
		Иначе
			СтрокаАналога.ЯчейкаПредставление = "Пустая";
		КонецЕсли;

		СтрокаАналога.Представление =
			Строка(Выборка.Склад)
			+ Символы.ПС
			+ СтрокаАналога.ЯчейкаПредставление
			+ " — "
			+ СтрокаАналога.КоличествоПредставление;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область РасчетПланаФакта

&НаСервере
Функция сп_ПолучитьПланФактТекущегоТовараНаСервере()

	Результат = Новый Структура;
	Результат.Вставить("План", 0);
	Результат.Вставить("Факт", 0);

	МассивЗаказов = сп_МассивЗаказовНаСервере();

	Если МассивЗаказов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийСклад) Тогда
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущаяНоменклатура) Тогда
		Возврат Результат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущаяЯчейка) Тогда
		ЯчейкаДляЗапроса = ТекущаяЯчейка;
	Иначе
		ЯчейкаДляЗапроса = Справочники.Ячейки.ПустаяСсылка();
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущаяЕдиницаИзмерения) Тогда
		ЕдиницаДляЗапроса = ТекущаяЕдиницаИзмерения;
	Иначе
		ЕдиницаДляЗапроса = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(ЗаказЗапасы.Количество) КАК План
	|ИЗ
	|	Документ.ЗаказНаПеремещение.Запасы КАК ЗаказЗапасы
	|ГДЕ
	|	ЗаказЗапасы.Ссылка В (&Заказы)
	|	И ЗаказЗапасы.Номенклатура = &Номенклатура
	|	И (&ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|		ИЛИ ЗаказЗапасы.ЕдиницаИзмерения = &ЕдиницаИзмерения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ПеремещениеЗапасы.Количество) КАК Факт
	|ИЗ
	|	Документ.ПеремещениеЗапасов.Запасы КАК ПеремещениеЗапасы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПеремещениеЗапасов КАК Перемещение
	|		ПО ПеремещениеЗапасы.Ссылка = Перемещение.Ссылка
	|ГДЕ
	|	НЕ Перемещение.ПометкаУдаления
	|	И Перемещение.ДокументОснование В (&Заказы)
	|	И Перемещение.СтруктурнаяЕдиница = &Склад
	|	И ЕСТЬNULL(ПеремещениеЗапасы.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) = &Ячейка
	|	И ПеремещениеЗапасы.Номенклатура = &Номенклатура
	|	И (&ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|		ИЛИ ПеремещениеЗапасы.ЕдиницаИзмерения = &ЕдиницаИзмерения)";

	Запрос.УстановитьПараметр("Заказы", МассивЗаказов);
	Запрос.УстановитьПараметр("Склад", ТекущийСклад);
	Запрос.УстановитьПараметр("Ячейка", ЯчейкаДляЗапроса);
	Запрос.УстановитьПараметр("Номенклатура", ТекущаяНоменклатура);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", ЕдиницаДляЗапроса);

	Попытка
		Результаты = Запрос.ВыполнитьПакет();
	Исключение
		Возврат Результат;
	КонецПопытки;

	Если Результаты.Количество() >= 1 Тогда

		ВыборкаПлан = Результаты[0].Выбрать();

		Если ВыборкаПлан.Следующий()
			И ЗначениеЗаполнено(ВыборкаПлан.План) Тогда

			Результат.План = ВыборкаПлан.План;

		КонецЕсли;

	КонецЕсли;

	Если Результаты.Количество() >= 2 Тогда

		ВыборкаФакт = Результаты[1].Выбрать();

		Если ВыборкаФакт.Следующий()
			И ЗначениеЗаполнено(ВыборкаФакт.Факт) Тогда

			Результат.Факт = ВыборкаФакт.Факт;

		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область КартинкиИТовар

&НаСервере
Функция сп_КоличествоШтПредставление(Количество)

	Если Количество = Неопределено Тогда
		Количество = 0;
	КонецЕсли;

	Если ТипЗнч(Количество) <> Тип("Число") Тогда

		Попытка
			Количество = Число(Количество);
		Исключение
			Количество = 0;
		КонецПопытки;

	КонецЕсли;

	Если Количество = 0 Тогда
		Возврат "0 шт";
	КонецЕсли;

	Возврат Формат(Количество, "ЧДЦ=0") + " шт";

КонецФункции

&НаСервере
Функция сп_РеквизитыТовараДляОтображения(Номенклатура)

	Результат = Новый Структура;
	Результат.Вставить("Наименование", "");
	Результат.Вставить("Артикул", "");
	Результат.Вставить("Бренд", "");
	Результат.Вставить("Цвет", "");
	Результат.Вставить("Размер", "");

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Наименование = Строка(Номенклатура);

	Попытка

		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Номенклатура,
			"Артикул, спАртикулПоставщика, спБренд, спЦвет, спРазмер");

		Если Реквизиты <> Неопределено Тогда

			Если Реквизиты.Свойство("Артикул")
				И ЗначениеЗаполнено(Реквизиты.Артикул) Тогда

				Результат.Артикул = Строка(Реквизиты.Артикул);

			ИначеЕсли Реквизиты.Свойство("спАртикулПоставщика")
				И ЗначениеЗаполнено(Реквизиты.спАртикулПоставщика) Тогда

				Результат.Артикул = Строка(Реквизиты.спАртикулПоставщика);

			КонецЕсли;

			Если Реквизиты.Свойство("спБренд")
				И ЗначениеЗаполнено(Реквизиты.спБренд) Тогда

				Результат.Бренд = Строка(Реквизиты.спБренд);

			КонецЕсли;

			Если Реквизиты.Свойство("спЦвет")
				И ЗначениеЗаполнено(Реквизиты.спЦвет) Тогда

				Результат.Цвет = Строка(Реквизиты.спЦвет);

			КонецЕсли;

			Если Реквизиты.Свойство("спРазмер")
				И ЗначениеЗаполнено(Реквизиты.спРазмер) Тогда

				Результат.Размер = Строка(Реквизиты.спРазмер);

			КонецЕсли;

		КонецЕсли;

	Исключение
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервере
Функция сп_КартинкаНоменклатуры(Номенклатура)

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;

	//+++ Tnext Козык К.А. - Вистерия - 24.06.2026
	// Возвращаем нетиповой механизм Вистерии: основной источник картинок —
	// РегистрСведений.спВнешниеКартинкиТовара. Картинку сервером не скачиваем,
	// в АРМ передаем прямой URL, как работало до обновления.
	АдресКартинки = сп_КартинкаИзВнешнегоРегистраПоАртикулу(Номенклатура);

	Если ЗначениеЗаполнено(АдресКартинки) Тогда
		Возврат АдресКартинки;
	КонецЕсли;

	АдресКартинки = сп_КартинкаИзФайлаКартинкиНоменклатуры(Номенклатура);

	Если ЗначениеЗаполнено(АдресКартинки) Тогда
		Возврат АдресКартинки;
	КонецЕсли;

	АдресКартинки = сп_КартинкаИзПрисоединенногоФайлаНоменклатуры(Номенклатура);

	Если ЗначениеЗаполнено(АдресКартинки) Тогда
		Возврат АдресКартинки;
	КонецЕсли;

	Возврат "";
	//--- Tnext Козык К.А. - Вистерия - 24.06.2026

КонецФункции

&НаСервере
Функция сп_КартинкаИзФайлаКартинкиНоменклатуры(Номенклатура)

	ФайлКартинки = Неопределено;

	Попытка

		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Номенклатура,
			"ФайлКартинки");

		Если Реквизиты <> Неопределено
			И Реквизиты.Свойство("ФайлКартинки")
			И ЗначениеЗаполнено(Реквизиты.ФайлКартинки) Тогда

			ФайлКартинки = Реквизиты.ФайлКартинки;

		КонецЕсли;

	Исключение
		Возврат "";
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ФайлКартинки) Тогда
		Возврат "";
	КонецЕсли;

	Попытка

		Возврат РаботаСФайламиУНФ.СсылкаНаДвоичныеДанныеФайла(
			ФайлКартинки,
			Новый УникальныйИдентификатор);

	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

//+++ Tnext Козык К.А. - Вистерия - 24.06.2026
&НаСервере
Функция сп_КартинкаИзПрисоединенногоФайлаНоменклатуры(Номенклатура)

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;

	ФайлКартинки = Неопределено;

	// В УНФ картинки номенклатуры могут храниться как присоединенные файлы.
	// Запрос намеренно простой: без отбора по необязательным полям "Основной",
	// "ДатаМодификации" и т.п., чтобы не падать на отличиях релизов.
	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|   Файлы.Ссылка КАК Файл
		|ИЗ
		|   Справочник.НоменклатураПрисоединенныеФайлы КАК Файлы
		|ГДЕ
		|   Файлы.ВладелецФайла = &ВладелецФайла
		|   И НЕ Файлы.ПометкаУдаления";

		Запрос.УстановитьПараметр("ВладелецФайла", Номенклатура);

		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			ФайлКартинки = Выборка.Файл;
		КонецЕсли;

	Исключение
		ФайлКартинки = Неопределено;
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ФайлКартинки) Тогда
		Возврат "";
	КонецЕсли;

	Возврат сп_АдресДвоичныхДанныхФайлаКартинки(ФайлКартинки);

КонецФункции

