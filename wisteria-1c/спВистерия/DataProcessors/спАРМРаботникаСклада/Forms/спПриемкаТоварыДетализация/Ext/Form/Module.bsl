#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	сп_ИнициализироватьПараметрыФормы();

	сп_НастроитьИнтерфейс();

	ЗаполнитьДетализациюНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеФормы

&НаСервере
Процедура ЗаполнитьДетализациюНаСервере()

	сп_ИнициализироватьПараметрыФормы();

	Если Не ЗначениеЗаполнено(ТекущаяНоменклатура) Тогда
		Возврат;
	КонецЕсли;

	РеквизитыТовара = сп_РеквизитыТовараДляОтображения(ТекущаяНоменклатура);

	Наименование = РеквизитыТовара.Наименование;
	Артикул = РеквизитыТовара.Артикул;
	Бренд = РеквизитыТовара.Бренд;
	Цвет = РеквизитыТовара.Цвет;
	Размер = РеквизитыТовара.Размер;

	АдресКартинкиТовара = АдресКартинки;

	Если Не ЗначениеЗаполнено(АдресКартинкиТовара) Тогда
		АдресКартинкиТовара = сп_КартинкаНоменклатуры(ТекущаяНоменклатура);
	КонецЕсли;

	Изображения.Очистить();

	Если ЗначениеЗаполнено(АдресКартинкиТовара) Тогда

		СтрокаИзображения = Изображения.Добавить();
		СтрокаИзображения.Адрес = АдресКартинкиТовара;
		СтрокаИзображения.Ссылка = ТекущаяНоменклатура;

	КонецЕсли;

	ДанныеКоличеств = сп_ПолучитьПланФактТекущегоТовараНаСервере();

	КоличествоПлан = ДанныеКоличеств.План;
	КоличествоФакт = ДанныеКоличеств.Факт;
	Отклонение = КоличествоПлан - КоличествоФакт;

	Если Отклонение < 0 Тогда
		Отклонение = 0;
	КонецЕсли;

	КоличествоПланПредставление = сп_КоличествоШтПредставление(КоличествоПлан);
	КоличествоФактПредставление = сп_КоличествоШтПредставление(КоличествоФакт);
	ОтклонениеПредставление = сп_КоличествоШтПредставление(Отклонение);

	СтатусВидимость = Отклонение <= 0;

	Если СтатусВидимость Тогда
		ТекстСтатуса = "✓ Товар отсканирован";
	Иначе
		ТекстСтатуса = "";
	КонецЕсли;

	Попытка
		Элементы.ТекстСтатуса.Видимость = СтатусВидимость;
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область РасчетПланаФакта

&НаСервере
Функция сп_ПолучитьПланФактТекущегоТовараНаСервере()

	Результат = Новый Структура;
	Результат.Вставить("План", 0);
	Результат.Вставить("Факт", 0);

	Если Не ЗначениеЗаполнено(ТекущийЗаказ)
		Или Не ЗначениеЗаполнено(ТекущаяНоменклатура) Тогда

		Возврат Результат;

	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущаяЕдиницаИзмерения) Тогда
		ЕдиницаДляЗапроса = ТекущаяЕдиницаИзмерения;
	Иначе
		ЕдиницаДляЗапроса = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| СУММА(ЗаказЗапасы.Количество) КАК План
	|ИЗ
	| Документ.ЗаказНаПеремещение.Запасы КАК ЗаказЗапасы
	|ГДЕ
	| ЗаказЗапасы.Ссылка = &Заказ
	| И ЗаказЗапасы.Номенклатура = &Номенклатура
	| И (&ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|  ИЛИ ЗаказЗапасы.ЕдиницаИзмерения = &ЕдиницаИзмерения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	| СУММА(ПеремещениеЗапасы.Количество) КАК Факт
	|ИЗ
	| Документ.ПеремещениеЗапасов.Запасы КАК ПеремещениеЗапасы
	|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПеремещениеЗапасов КАК Перемещение
	|  ПО ПеремещениеЗапасы.Ссылка = Перемещение.Ссылка
	|ГДЕ
	| НЕ Перемещение.ПометкаУдаления
	| И Перемещение.ДокументОснование = &Заказ
	| И ПеремещениеЗапасы.Номенклатура = &Номенклатура
	| И (&ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|  ИЛИ ПеремещениеЗапасы.ЕдиницаИзмерения = &ЕдиницаИзмерения)";

	Запрос.УстановитьПараметр("Заказ", ТекущийЗаказ);
	Запрос.УстановитьПараметр("Номенклатура", ТекущаяНоменклатура);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", ЕдиницаДляЗапроса);

	Попытка
		Результаты = Запрос.ВыполнитьПакет();
	Исключение
		Возврат Результат;
	КонецПопытки;

	Если Результаты.Количество() >= 1 Тогда

		ВыборкаПлан = Результаты[0].Выбрать();

		Если ВыборкаПлан.Следующий()
			И ЗначениеЗаполнено(ВыборкаПлан.План) Тогда

			Результат.План = ВыборкаПлан.План;

		КонецЕсли;

	КонецЕсли;

	Если Результаты.Количество() >= 2 Тогда

		ВыборкаФакт = Результаты[1].Выбрать();

		Если ВыборкаФакт.Следующий()
			И ЗначениеЗаполнено(ВыборкаФакт.Факт) Тогда

			Результат.Факт = ВыборкаФакт.Факт;

		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область КартинкиИТовар

&НаСервере
Функция сп_КоличествоШтПредставление(Количество)

	Если Количество = Неопределено Тогда
		Количество = 0;
	КонецЕсли;

	Если ТипЗнч(Количество) <> Тип("Число") Тогда
		Попытка
			Количество = Число(Количество);
		Исключение
			Количество = 0;
		КонецПопытки;
	КонецЕсли;

	Если Количество = 0 Тогда
		Возврат "0 шт";
	КонецЕсли;

	Возврат Формат(Количество, "ЧДЦ=0") + " шт";

КонецФункции

&НаСервере
Функция сп_РеквизитыТовараДляОтображения(Номенклатура)

	Результат = Новый Структура;
	Результат.Вставить("Наименование", "");
	Результат.Вставить("Артикул", "");
	Результат.Вставить("Бренд", "");
	Результат.Вставить("Цвет", "");
	Результат.Вставить("Размер", "");

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Наименование = Строка(Номенклатура);

	Попытка

		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Номенклатура,
			"Артикул, спАртикулПоставщика, спБренд, спЦвет, спРазмер");

		Если Реквизиты <> Неопределено Тогда

			Если Реквизиты.Свойство("Артикул")
				И ЗначениеЗаполнено(Реквизиты.Артикул) Тогда

				Результат.Артикул = Строка(Реквизиты.Артикул);

			ИначеЕсли Реквизиты.Свойство("спАртикулПоставщика")
				И ЗначениеЗаполнено(Реквизиты.спАртикулПоставщика) Тогда

				Результат.Артикул = Строка(Реквизиты.спАртикулПоставщика);

			КонецЕсли;

			Если Реквизиты.Свойство("спБренд")
				И ЗначениеЗаполнено(Реквизиты.спБренд) Тогда

				Результат.Бренд = Строка(Реквизиты.спБренд);

			КонецЕсли;

			Если Реквизиты.Свойство("спЦвет")
				И ЗначениеЗаполнено(Реквизиты.спЦвет) Тогда

				Результат.Цвет = Строка(Реквизиты.спЦвет);

			КонецЕсли;

			Если Реквизиты.Свойство("спРазмер")
				И ЗначениеЗаполнено(Реквизиты.спРазмер) Тогда

				Результат.Размер = Строка(Реквизиты.спРазмер);

			КонецЕсли;

		КонецЕсли;

	Исключение
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервере
Функция сп_КартинкаНоменклатуры(Номенклатура)

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;

	//+++ Tnext Козык К.А. - Вистерия - 24.06.2026
	// Возвращаем нетиповой механизм Вистерии: основной источник картинок —
	// РегистрСведений.спВнешниеКартинкиТовара. Картинку сервером не скачиваем,
	// в АРМ передаем прямой URL, как работало до обновления.
	АдресКартинки = сп_КартинкаИзВнешнегоРегистраПоАртикулу(Номенклатура);

	Если ЗначениеЗаполнено(АдресКартинки) Тогда
		Возврат АдресКартинки;
	КонецЕсли;

	АдресКартинки = сп_КартинкаИзФайлаКартинкиНоменклатуры(Номенклатура);

	Если ЗначениеЗаполнено(АдресКартинки) Тогда
		Возврат АдресКартинки;
	КонецЕсли;

	АдресКартинки = сп_КартинкаИзПрисоединенногоФайлаНоменклатуры(Номенклатура);

	Если ЗначениеЗаполнено(АдресКартинки) Тогда
		Возврат АдресКартинки;
	КонецЕсли;

	Возврат "";
	//--- Tnext Козык К.А. - Вистерия - 24.06.2026

КонецФункции

&НаСервере
Функция сп_КартинкаИзФайлаКартинкиНоменклатуры(Номенклатура)

	ФайлКартинки = Неопределено;

	Попытка

		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Номенклатура,
			"ФайлКартинки");

		Если Реквизиты <> Неопределено
			И Реквизиты.Свойство("ФайлКартинки")
			И ЗначениеЗаполнено(Реквизиты.ФайлКартинки) Тогда

			ФайлКартинки = Реквизиты.ФайлКартинки;

		КонецЕсли;

	Исключение
		Возврат "";
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ФайлКартинки) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат РаботаСФайламиУНФ.СсылкаНаДвоичныеДанныеФайла(
			ФайлКартинки,
			Новый УникальныйИдентификатор);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

//+++ Tnext Козык К.А. - Вистерия - 24.06.2026
&НаСервере
Функция сп_КартинкаИзПрисоединенногоФайлаНоменклатуры(Номенклатура)

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;

	ФайлКартинки = Неопределено;

	// В УНФ картинки номенклатуры могут храниться как присоединенные файлы.
	// Запрос намеренно простой: без отбора по необязательным полям "Основной",
	// "ДатаМодификации" и т.п., чтобы не падать на отличиях релизов.
	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|   Файлы.Ссылка КАК Файл
		|ИЗ
		|   Справочник.НоменклатураПрисоединенныеФайлы КАК Файлы
		|ГДЕ
		|   Файлы.ВладелецФайла = &ВладелецФайла
		|   И НЕ Файлы.ПометкаУдаления";

		Запрос.УстановитьПараметр("ВладелецФайла", Номенклатура);

		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			ФайлКартинки = Выборка.Файл;
		КонецЕсли;

	Исключение
		ФайлКартинки = Неопределено;
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ФайлКартинки) Тогда
		Возврат "";
	КонецЕсли;

	Возврат сп_АдресДвоичныхДанныхФайлаКартинки(ФайлКартинки);

КонецФункции

&НаСервере
Функция сп_АдресДвоичныхДанныхФайлаКартинки(ФайлКартинки)

	Если Не ЗначениеЗаполнено(ФайлКартинки) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		АдресКартинки = РаботаСФайламиУНФ.СсылкаНаДвоичныеДанныеФайла(
			ФайлКартинки,
			Новый УникальныйИдентификатор);

		Если ЗначениеЗаполнено(АдресКартинки) Тогда
			Возврат АдресКартинки;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(ФайлКартинки);
		Если ДанныеФайла <> Неопределено
			И ДанныеФайла.Свойство("СсылкаНаДвоичныеДанныеФайла")
			И ЗначениеЗаполнено(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла) Тогда
			Возврат ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат "";

КонецФункции
//--- Tnext Козык К.А. - Вистерия - 24.06.2026


&НаСервере
Функция сп_КартинкаИзВнешнегоРегистраПоАртикулу(Номенклатура)

	АртикулПоставщика = сп_АртикулПоставщикаНоменклатуры(Номенклатура);

	Если Не ЗначениеЗаполнено(АртикулПоставщика) Тогда
		Возврат "";
	КонецЕсли;

	ВнешняяСсылка = сп_ВнешняяСсылкаКартинкиПоАртикулу(АртикулПоставщика);

	Если Не ЗначениеЗаполнено(ВнешняяСсылка) Тогда
		Возврат "";
	КонецЕсли;

	Возврат сп_АдресКартинкиПоВнешнейСсылке(ВнешняяСсылка);

КонецФункции

&НаСервере
Функция сп_АртикулПоставщикаНоменклатуры(Номенклатура)

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;

	АртикулПоставщика = "";

	Попытка

		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Номенклатура,
			"спАртикулПоставщика, Артикул");

		Если Реквизиты <> Неопределено Тогда

			Если Реквизиты.Свойство("спАртикулПоставщика")
				И ЗначениеЗаполнено(Реквизиты.спАртикулПоставщика) Тогда

				АртикулПоставщика = СокрЛП(Строка(Реквизиты.спАртикулПоставщика));

			ИначеЕсли Реквизиты.Свойство("Артикул")
				И ЗначениеЗаполнено(Реквизиты.Артикул) Тогда

				АртикулПоставщика = СокрЛП(Строка(Реквизиты.Артикул));

			КонецЕсли;

		КонецЕсли;

	Исключение
		АртикулПоставщика = "";
	КонецПопытки;

	Возврат АртикулПоставщика;

КонецФункции

&НаСервере
Функция сп_ВнешняяСсылкаКартинкиПоАртикулу(АртикулПоставщика)

	Если Не ЗначениеЗаполнено(АртикулПоставщика) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	| Картинки.ВнешняяСсылка КАК ВнешняяСсылка
	|ИЗ
	| РегистрСведений.спВнешниеКартинкиТовара КАК Картинки
	|ГДЕ
	| Картинки.АртикулПоставщика = &АртикулПоставщика
	| И Картинки.ВнешняяСсылка <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	| Картинки.ВнешняяСсылка";

	Запрос.УстановитьПараметр("АртикулПоставщика", АртикулПоставщика);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			Возврат Выборка.ВнешняяСсылка;
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат "";

КонецФункции

&НаСервере
Функция сп_АдресКартинкиПоВнешнейСсылке(ВнешняяСсылка)

	Если Не ЗначениеЗаполнено(ВнешняяСсылка) Тогда
		Возврат "";
	КонецЕсли;

	//+++ Tnext Козык К.А. - Вистерия - 24.06.2026
	// Для PictureField нужен адрес картинки во временном хранилище, а не внешний URL строкой.
	// Картинку загружаем по старому механизму, но сначала нормализуем api.wisteriakids.ru -> wisteriakids.ru.
	Попытка
		АдресКартинки = спМодификацияКонфигурацииПереопределяемый.сп_СсылкаНаДвоичныеДанныеКартинки(
			ВнешняяСсылка,
			УникальныйИдентификатор);
		
		Если ЗначениеЗаполнено(АдресКартинки) Тогда
			Возврат АдресКартинки;
		КонецЕсли;
	Исключение
	КонецПопытки;
	//--- Tnext Козык К.А. - Вистерия - 24.06.2026

	Возврат "";

КонецФункции

&НаСервере
Функция сп_СкачатьКартинкуПоURLВоВременноеХранилище(АдресURL)

	Если Не ЗначениеЗаполнено(АдресURL) Тогда
		Возврат "";
	КонецЕсли;

	Попытка

		ДвоичныеДанные = сп_ПолучитьДвоичныеДанныеПоURL(АдресURL);

		Если ДвоичныеДанные = Неопределено Тогда
			Возврат "";
		КонецЕсли;

		Картинка = Новый Картинка(ДвоичныеДанные);

		Попытка
			ОбрабатываемаяКартинка = Новый ОбрабатываемаяКартинка(Картинка);
			ОбрабатываемаяКартинка.УстановитьРазмер(320, );
			Картинка = ОбрабатываемаяКартинка.ПолучитьКартинку();
		Исключение
		КонецПопытки;

		Возврат ПоместитьВоВременноеХранилище(Картинка, УникальныйИдентификатор);

	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

&НаСервере
Функция сп_ПолучитьДвоичныеДанныеПоURL(АдресURL)

	АдресURL = СокрЛП(АдресURL);

	Если ПустаяСтрока(АдресURL) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЭтоHTTPS = Лев(НРег(АдресURL), 8) = "https://";
	ЭтоHTTP = Лев(НРег(АдресURL), 7) = "http://";

	Если Не ЭтоHTTPS И Не ЭтоHTTP Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ЭтоHTTPS Тогда
		АдресБезПротокола = Сред(АдресURL, 9);
		Порт = 443;
	Иначе
		АдресБезПротокола = Сред(АдресURL, 8);
		Порт = 80;
	КонецЕсли;

	ПозицияСлеша = Найти(АдресБезПротокола, "/");

	Если ПозицияСлеша = 0 Тогда
		Хост = АдресБезПротокола;
		Путь = "/";
	Иначе
		Хост = Лев(АдресБезПротокола, ПозицияСлеша - 1);
		Путь = Сред(АдресБезПротокола, ПозицияСлеша);
	КонецЕсли;

	Попытка

		Если ЭтоHTTPS Тогда
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
			Соединение = Новый HTTPСоединение(Хост, Порт, , , , 30, ЗащищенноеСоединение);
		Иначе
			Соединение = Новый HTTPСоединение(Хост, Порт, , , , 30);
		КонецЕсли;

		HTTPЗапрос = Новый HTTPЗапрос(Путь);
		HTTPЗапрос.Заголовки.Вставить("User-Agent", "1C:Enterprise");
		HTTPЗапрос.Заголовки.Вставить("Accept", "image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8");

		HTTPОтвет = Соединение.Получить(HTTPЗапрос);

		Если HTTPОтвет.КодСостояния <> 200 Тогда
			Возврат Неопределено;
		КонецЕсли;

		Возврат HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();

	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура сп_ИнициализироватьПараметрыФормы()

	Если Не ЗначениеЗаполнено(ЗаказыСериализованные) Тогда

		ЗаказыСтрокойПараметр = "";

		Если Параметры.Свойство("ЗаказыСериализованные", ЗаказыСтрокойПараметр) Тогда
			ЗаказыСериализованные = ЗаказыСтрокойПараметр;
		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийЗаказ) Тогда

		ЗаказПараметр = Неопределено;

		Если Параметры.Свойство("Заказ", ЗаказПараметр) Тогда
			ТекущийЗаказ = ЗаказПараметр;
		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущаяНоменклатура) Тогда

		НоменклатураПараметр = Неопределено;

		Если Параметры.Свойство("Номенклатура", НоменклатураПараметр) Тогда
			ТекущаяНоменклатура = НоменклатураПараметр;
		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущаяЕдиницаИзмерения) Тогда

		ЕдиницаПараметр = Неопределено;

		Если Параметры.Свойство("ЕдиницаИзмерения", ЕдиницаПараметр) Тогда
			ТекущаяЕдиницаИзмерения = ЕдиницаПараметр;
		КонецЕсли;

	КонецЕсли; 
	
		Если Не ЗначениеЗаполнено(АдресКартинки) Тогда

		АдресКартинкиПараметр = "";

		Если Параметры.Свойство("АдресКартинки", АдресКартинкиПараметр) Тогда
			АдресКартинки = АдресКартинкиПараметр;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура сп_НастроитьИнтерфейс()

	Попытка
		Элементы.Картинка.Вид = ВидПоляФормы.ПолеКартинки;
		Элементы.Картинка.ПутьКДанным = "Изображения[0].Адрес";
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ПолеКартинка.Вид = ВидПоляФормы.ПолеКартинки;
		Элементы.ПолеКартинка.ПутьКДанным = "Изображения[0].Адрес";
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ТекстСтатуса.Видимость = Ложь;
	Исключение
	КонецПопытки;

КонецПроцедуры

