#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	сп_ИнициализироватьПериодНаСервере();
	ЗаполнитьЗаказыНаСервере(ДатаНачала, ДатаОкончания);

КонецПроцедуры

#КонецОбласти

#Область Обработуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ДанныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьПеремещенияЗаказа();

КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)

	сп_ОбновитьСписокПоПериоду();

КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)

	сп_ОбновитьСписокПоПериоду();

КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура Назад(Команда)

	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)

	сп_ОбновитьСписокПоПериоду();

КонецПроцедуры

#КонецОбласти

#Область Навигация

&НаКлиенте
Процедура ОткрытьПеремещенияЗаказа()

	ТекущиеДанные = Элементы.Данные.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Не выбрана строка заказа.'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущиеДанные.Заказ) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'В выбранной строке не указан заказ покупателя.'"));
		Возврат;
	КонецЕсли;

	//<<<--- Tnext Козык К.А. 29.07.2026
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить(
		"ЗаказПокупателя",
		ТекущиеДанные.Заказ);

	ОткрытьФорму(
		"Обработка.спАРМРаботникаСклада.Форма.спПеремещенияЗаказаПокупателя",
		ПараметрыФормы,
		ЭтаФорма,
		ТекущиеДанные.Заказ,
		,
		,
		,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	//--->>> Tnext Козык К.А. 29.07.2026

КонецПроцедуры

#КонецОбласти

#Область ОбновлениеСписка

&НаКлиенте
Процедура сп_ОбновитьСписокПоПериоду()

	ЗаполнитьЗаказыНаСервере(ДатаНачала, ДатаОкончания);

	Попытка
		Элементы.Данные.Обновить();
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДанныхФормы

&НаСервере
Процедура сп_ИнициализироватьПериодНаСервере()

	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = НачалоДня(ДобавитьМесяц(ТекущаяДатаСеанса(), -1));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗаказыНаСервере(ДатаНачалаПериода = Неопределено, ДатаОкончанияПериода = Неопределено)

	Если ЗначениеЗаполнено(ДатаНачалаПериода) Тогда
		ДатаНачала = ДатаНачалаПериода;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДатаОкончанияПериода) Тогда
		ДатаОкончания = ДатаОкончанияПериода;
	КонецЕсли;

	сп_ИнициализироватьПериодНаСервере();

	Данные.Очистить();

	ДатаНачалаОтбора = НачалоДня(ДатаНачала);
	ДатаОкончанияОтбора = КонецДня(ДатаОкончания);

	лСостоянияЗаказов = Новый Массив;
	лСостоянияЗаказов.Добавить("Новый");
	лСостоянияЗаказов.Добавить("Оплачен");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка КАК Заказ,
	|	ЗаказПокупателя.Дата КАК Дата,
	|	ЗаказПокупателя.Номер КАК Номер,
	|	ЗаказПокупателя.Контрагент КАК Контрагент,
	|	ЗаказПокупателя.СостояниеЗаказа КАК Состояние,
	|	ЗаказПокупателя.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	НЕ ЗаказПокупателя.ПометкаУдаления
	|	И ЗаказПокупателя.Дата >= &ДатаНачала
	|	И ЗаказПокупателя.Дата <= &ДатаОкончания
	|	И ЗаказПокупателя.СостояниеЗаказа.Наименование В (&СостоянияЗаказов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПокупателя.Дата УБЫВ,
	|	ЗаказПокупателя.Номер УБЫВ";

	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаОтбора);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончанияОтбора);
	Запрос.УстановитьПараметр("СостоянияЗаказов", лСостоянияЗаказов);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		СтрокаСписка = Данные.Добавить();

		СтрокаСписка.Заказ = Выборка.Заказ;
		СтрокаСписка.Дата = Выборка.Дата;
		СтрокаСписка.Номер = Выборка.Номер;
		СтрокаСписка.Контрагент = Выборка.Контрагент;
		СтрокаСписка.Состояние = Выборка.Состояние;

		Попытка
			СтрокаСписка.СуммаДокумента = Выборка.СуммаДокумента;
		Исключение
		КонецПопытки;

		СтрокаСписка.Представление =
			Строка(Выборка.Заказ)
			+ Символы.ПС
			+ "Покупатель: " + Строка(Выборка.Контрагент)
			+ Символы.ПС
			+ "Статус: " + Строка(Выборка.Состояние);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти