КонецФункции

#Область СканированиеИзЯчейки

&НаСервере
Функция сп_ВыполнитьСканированиеШтрихкодаИзТекущейЯчейкиНаСервере(Штрихкод, Ячейка, КлючЯчейки)

	сп_ИнициализироватьПараметрыФормы();

	ДанныеТовара = сп_ДанныеПоШтрихкодуИлиКодуМаркировкиНаСервере(Штрихкод);

	Если ДанныеТовара = Неопределено Тогда
		Возврат "Штрихкод/код маркировки не найден: " + Строка(Штрихкод);
	КонецЕсли;

	Номенклатура = Неопределено;
	ЕдиницаИзмерения = Неопределено;

	ДанныеТовара.Свойство("Номенклатура", Номенклатура);
	ДанныеТовара.Свойство("ЕдиницаИзмерения", ЕдиницаИзмерения);

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "Не определен товар по отсканированному штрихкоду.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийСклад) Тогда
		Возврат "Не определен склад для сканирования.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(КлючЯчейки) Тогда
		КлючЯчейки = сп_КлючЯчейки(Ячейка);
	КонецЕсли;

	СтрокаЗапасов = сп_НайтиСтрокуЗапасовДляСканированияИзЯчейки(Номенклатура, ЕдиницаИзмерения, КлючЯчейки);

	Если СтрокаЗапасов = Неопределено Тогда
		Возврат "Товар не найден в выбранной ячейке или уже полностью отсканирован: " + Строка(Номенклатура);
	КонецЕсли;

	СсылкаПеремещения = сп_НайтиИлиСоздатьПеремещениеОтгрузки(СтрокаЗапасов);

	Если Не ЗначениеЗаполнено(СсылкаПеремещения) Тогда
		Возврат "Не удалось создать или найти документ Перемещение запасов.";
	КонецЕсли;

	ПеремещениеОбъект = СсылкаПеремещения.ПолучитьОбъект();
	СтрокаДокумента = сп_НайтиСтрокуПеремещения(ПеремещениеОбъект, СтрокаЗапасов);

	Если СтрокаДокумента = Неопределено Тогда
		СтрокаДокумента = ПеремещениеОбъект.Запасы.Добавить();
		сп_ЗаполнитьСтрокуПеремещенияИзСтрокиЗапасов(СтрокаДокумента, СтрокаЗапасов, Истина);
		СтрокаДокумента.Количество = 1;
	Иначе
		СтрокаДокумента.Количество = СтрокаДокумента.Количество + 1;
	КонецЕсли;

	Попытка
		ПеремещениеОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Возврат "Ошибка записи перемещения: " + ОписаниеОшибки();
	КонецПопытки;

	СообщениеПроведения = сп_ПровестиПеремещенияСкладаЕслиВсеОтсканированоНаСервере(СтрокаЗапасов.Склад);

	ТекстЯчейки = ?(ЗначениеЗаполнено(СтрокаЗапасов.Ячейка), Строка(СтрокаЗапасов.Ячейка), "без ячейки");

	Результат = "Товар отсканирован из ячейки: "
		+ Строка(Номенклатура)
		+ Символы.ПС
		+ "Склад: " + Строка(СтрокаЗапасов.Склад)
		+ Символы.ПС
		+ "Ячейка: " + ТекстЯчейки;

	Если ЗначениеЗаполнено(СообщениеПроведения) Тогда
		Результат = Результат + Символы.ПС + СообщениеПроведения;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция сп_НайтиСтрокуЗапасовДляСканированияИзЯчейки(Номенклатура, ЕдиницаИзмерения, КлючЯчейки)

	ТаблицаЗапасов = сп_ПолучитьТаблицуЗапасовОтгрузкиНаСервере();

	Для каждого Стр Из ТаблицаЗапасов Цикл

		Если Стр.Склад <> ТекущийСклад Тогда
			Продолжить;
		КонецЕсли;

		Если сп_КлючЯчейки(Стр.Ячейка) <> КлючЯчейки Тогда
			Продолжить;
		КонецЕсли;

		Если Стр.Номенклатура <> Номенклатура Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(ЕдиницаИзмерения)
			И Стр.ЕдиницаИзмерения <> ЕдиницаИзмерения Тогда
			Продолжить;
		КонецЕсли;

		Если Стр.Отклонение <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Если Стр.КоличествоНаСкладе <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Возврат Стр;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция сп_НайтиИлиСоздатьПеремещениеОтгрузки(СтрокаЗапасов)

	Заказ = СтрокаЗапасов.Заказ;
	СкладИсточник = СтрокаЗапасов.Склад;
	СкладПолучатель = сп_СкладПолучательЗаказаНаСервере(Заказ);

	Если сп_ЗаказИзТорговогоЗалаНаСервере(Заказ) Тогда
		СкладИсточник = сп_СкладОтправительЗаказаНаСервере(Заказ);
		СтрокаЗапасов.Склад = СкладИсточник;
		СтрокаЗапасов.Ячейка = Справочники.Ячейки.ПустаяСсылка();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СкладПолучатель) Тогда
		СкладПолучатель = сп_СкладТорговыйЗалНаСервере();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СкладИсточник) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СкладПолучатель) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не найден склад-получатель.");
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Перемещение.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПеремещениеЗапасов КАК Перемещение
	|ГДЕ
	|	Перемещение.ДокументОснование = &Заказ
	|	И Перемещение.СтруктурнаяЕдиница = &СкладИсточник
	|	И Перемещение.СтруктурнаяЕдиницаПолучатель = &СкладПолучатель
	|	И НЕ Перемещение.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Перемещение.Дата УБЫВ";

	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("СкладИсточник", СкладИсточник);
	Запрос.УстановитьПараметр("СкладПолучатель", СкладПолучатель);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	НовыйДокумент = Документы.ПеремещениеЗапасов.СоздатьДокумент();
	НовыйДокумент.Дата = ТекущаяДатаСеанса();

	Попытка
		НовыйДокумент.Заполнить(Заказ);
	Исключение
	КонецПопытки;

	НовыйДокумент.Запасы.Очистить();

	НовыйДокумент.ДокументОснование = Заказ;
	НовыйДокумент.СтруктурнаяЕдиница = СкладИсточник;
	НовыйДокумент.СтруктурнаяЕдиницаПолучатель = СкладПолучатель;

	Попытка
		НовыйДокумент.ЗаказНаПеремещение = Документы.ЗаказНаПеремещение.ПустаяСсылка();
	Исключение
	КонецПопытки;

	Попытка
		НовыйДокумент.Комментарий =
			"Создано АРМ кладовщика. Отгрузка. "
			+ "Склад отправитель: " + Строка(СкладИсточник)
			+ ". Склад получатель: " + Строка(СкладПолучатель)
			+ ". Основание: " + Строка(Заказ);
	Исключение
	КонецПопытки;

	НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);

	Возврат НовыйДокумент.Ссылка;

КонецФункции

&НаСервере
Функция сп_НайтиСтрокуПеремещения(ПеремещениеОбъект, СтрокаЗапасов)

	Для каждого СтрокаДокумента Из ПеремещениеОбъект.Запасы Цикл

		Если СтрокаДокумента.Номенклатура <> СтрокаЗапасов.Номенклатура Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Если СтрокаДокумента.ЕдиницаИзмерения <> СтрокаЗапасов.ЕдиницаИзмерения Тогда
				Продолжить;
			КонецЕсли;
		Исключение
		КонецПопытки;

		Попытка
			Если СтрокаДокумента.Ячейка <> СтрокаЗапасов.Ячейка Тогда
				Продолжить;
			КонецЕсли;
		Исключение
		КонецПопытки;

		Возврат СтрокаДокумента;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервере
Процедура сп_ЗаполнитьСтрокуПеремещенияИзСтрокиЗапасов(СтрокаДокумента, СтрокаЗапасов, ЗаполнятьЯчейкуОтправителя)

	СтрокаДокумента.Номенклатура = СтрокаЗапасов.Номенклатура;

	Попытка
		СтрокаДокумента.Характеристика = СтрокаЗапасов.Характеристика;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаДокумента.Партия = СтрокаЗапасов.Партия;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаДокумента.СерииНоменклатуры = СтрокаЗапасов.СерииНоменклатуры;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаДокумента.ЕдиницаИзмерения = СтрокаЗапасов.ЕдиницаИзмерения;
	Исключение
	КонецПопытки;

	Если ЗаполнятьЯчейкуОтправителя
		И НЕ сп_ЗаказИзТорговогоЗалаНаСервере(СтрокаЗапасов.Заказ) Тогда
		Попытка
			СтрокаДокумента.Ячейка = СтрокаЗапасов.Ячейка;
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция сп_ДанныеПоШтрихкодуИлиКодуМаркировкиНаСервере(Штрихкод)

	Кандидаты = сп_КандидатыШтрихкодаИзМаркировкиНаСервере(Штрихкод);

	Если Кандидаты.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|   Штрихкоды.Номенклатура КАК Номенклатура,
	|   Штрихкоды.Характеристика КАК Характеристика,
	|   Штрихкоды.Партия КАК Партия,
	|   Штрихкоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|   Штрихкоды.Штрихкод КАК Штрихкод
	|ИЗ
	|   РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|   Штрихкоды.Штрихкод В (&Кандидаты)";

	Запрос.УстановитьПараметр("Кандидаты", Кандидаты);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Номенклатура", Выборка.Номенклатура);
	Результат.Вставить("Характеристика", Выборка.Характеристика);
	Результат.Вставить("Партия", Выборка.Партия);
	Результат.Вставить("ЕдиницаИзмерения", Выборка.ЕдиницаИзмерения);
	Результат.Вставить("Штрихкод", Выборка.Штрихкод);
	Результат.Вставить("КодМаркировки", Штрихкод);

	Возврат Результат;

КонецФункции

&НаСервере
Функция сп_КандидатыШтрихкодаИзМаркировкиНаСервере(Штрихкод)

	Результат = Новый Массив;
	Штрихкод = СокрЛП(Строка(Штрихкод));

	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат Результат;
	КонецЕсли;

	сп_ДобавитьШтрихкодКандидат(Результат, Штрихкод);

	Позиция01 = Найти(Штрихкод, "01");
	Если Позиция01 > 0 И СтрДлина(Штрихкод) >= Позиция01 + 15 Тогда
		GTIN = Сред(Штрихкод, Позиция01 + 2, 14);
		Если сп_СтрокаТолькоЦифры(GTIN) Тогда
			сп_ДобавитьШтрихкодКандидат(Результат, GTIN);
			Если Лев(GTIN, 1) = "0" Тогда
				сп_ДобавитьШтрихкодКандидат(Результат, Сред(GTIN, 2));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура сп_ДобавитьШтрихкодКандидат(МассивКандидатов, Штрихкод)

	Штрихкод = СокрЛП(Строка(Штрихкод));

	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат;
	КонецЕсли;

	Если МассивКандидатов.Найти(Штрихкод) = Неопределено Тогда
		МассивКандидатов.Добавить(Штрихкод);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция сп_СтрокаТолькоЦифры(ЗначениеСтроки)

	ЗначениеСтроки = Строка(ЗначениеСтроки);

	Если ПустаяСтрока(ЗначениеСтроки) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для НомерСимвола = 1 По СтрДлина(ЗначениеСтроки) Цикл
		Символ = Сред(ЗначениеСтроки, НомерСимвола, 1);
		Если Найти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

&НаСервере
Функция сп_ПровестиПеремещенияТекущегоСкладаНаСервере()

	сп_ИнициализироватьПараметрыФормы();

	Если Не ЗначениеЗаполнено(ТекущийСклад) Тогда
		Возврат "Не определен склад для проведения перемещений.";
	КонецЕсли;

	МассивЗаказов = сп_МассивЗаказовНаСервере();
	Если МассивЗаказов.Количество() = 0 Тогда
		Возврат "Не переданы заказы для проведения перемещений.";
	КонецЕсли;


	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|   Перемещение.Ссылка КАК Ссылка
	|ИЗ
	|   Документ.ПеремещениеЗапасов КАК Перемещение
	|ГДЕ
	|   Перемещение.ДокументОснование В (&Заказы)
	|   И Перемещение.СтруктурнаяЕдиница = &СкладИсточник
	|   И НЕ Перемещение.ПометкаУдаления
	|   И НЕ Перемещение.Проведен";

	Запрос.УстановитьПараметр("Заказы", МассивЗаказов);
	Запрос.УстановитьПараметр("СкладИсточник", ТекущийСклад);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат "Ошибка поиска перемещений для проведения: " + ОписаниеОшибки();
	КонецПопытки;

	КоличествоПроведено = 0;
	Пока Выборка.Следующий() Цикл
		Попытка
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КоличествоПроведено = КоличествоПроведено + 1;
		Исключение
			Возврат "Не удалось провести перемещение " + Строка(Выборка.Ссылка) + ": " + ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;

	Если КоличествоПроведено = 0 Тогда
		Возврат "Нет непроведенных перемещений по текущему складу.";
	КонецЕсли;

	Возврат "Перемещения по текущему складу проведены: " + Строка(КоличествоПроведено) + ".";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура сп_ИнициализироватьПараметрыФормы()

	Если Не ЗначениеЗаполнено(ЗаказыСериализованные) Тогда

		ЗаказыСтрокойПараметр = "";

		Если Параметры.Свойство("ЗаказыСериализованные", ЗаказыСтрокойПараметр) Тогда
			ЗаказыСериализованные = ЗаказыСтрокойПараметр;
		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ЗаказыСериализованные) Тогда

		ЗаказыПараметр = Неопределено;

		Если Параметры.Свойство("Заказы", ЗаказыПараметр) Тогда

			СписокЗаказов = сп_НормализоватьСписокЗаказовНаСервере(ЗаказыПараметр);

			Если СписокЗаказов.Количество() > 0 Тогда
				ЗаказыСериализованные = ЗначениеВСтрокуВнутр(СписокЗаказов);
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийСклад) Тогда

		СкладПараметр = Неопределено;

		Если Параметры.Свойство("Склад", СкладПараметр) Тогда
			ТекущийСклад = СкладПараметр;
		КонецЕсли;

	КонецЕсли;

	м_Заказы = сп_ПолучитьЗаказыДляПередачиНаСервере();
	м_Склад = ТекущийСклад;

КонецПроцедуры

&НаСервере
Функция сп_НормализоватьСписокЗаказовНаСервере(ЗначениеЗаказов)

	Результат = Новый СписокЗначений;

	Если ЗначениеЗаказов = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(ЗначениеЗаказов) = Тип("СписокЗначений") Тогда

		Для каждого ЭлементСписка Из ЗначениеЗаказов Цикл

			Если ЗначениеЗаполнено(ЭлементСписка.Значение)
				И Результат.НайтиПоЗначению(ЭлементСписка.Значение) = Неопределено Тогда

				Результат.Добавить(ЭлементСписка.Значение, Строка(ЭлементСписка.Значение));

			КонецЕсли;

		КонецЦикла;

	ИначеЕсли ТипЗнч(ЗначениеЗаказов) = Тип("Массив") Тогда

		Для каждого Заказ Из ЗначениеЗаказов Цикл

			Если ЗначениеЗаполнено(Заказ)
				И Результат.НайтиПоЗначению(Заказ) = Неопределено Тогда

				Результат.Добавить(Заказ, Строка(Заказ));

			КонецЕсли;

		КонецЦикла;

	ИначеЕсли ЗначениеЗаполнено(ЗначениеЗаказов) Тогда

		Результат.Добавить(ЗначениеЗаказов, Строка(ЗначениеЗаказов));

	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция сп_ПолучитьЗаказыДляПередачиНаСервере()

	Если ЗначениеЗаполнено(ЗаказыСериализованные) Тогда

		Попытка
			Результат = ЗначениеИзСтрокиВнутр(ЗаказыСериализованные);
		Исключение
			Результат = Новый СписокЗначений;
		КонецПопытки;

		Возврат сп_НормализоватьСписокЗаказовНаСервере(Результат);

	КонецЕсли;

	Возврат Новый СписокЗначений;

КонецФункции

&НаСервере
Функция сп_МассивЗаказовНаСервере()

	СписокЗаказов = сп_ПолучитьЗаказыДляПередачиНаСервере();

	Результат = Новый Массив;

	Для каждого ЭлементСписка Из СписокЗаказов Цикл

		Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
			Результат.Добавить(ЭлементСписка.Значение);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция сп_ПолучитьТекущийСкладНаСервере()

	сп_ИнициализироватьПараметрыФормы();

	Возврат ТекущийСклад;

КонецФункции

&НаСервере
Функция сп_ФорматКоличествоСловом(Количество, Форма1, Форма2, Форма5)

	КоличествоЦелое = Цел(Количество);

	Остаток100 = КоличествоЦелое - Цел(КоличествоЦелое / 100) * 100;
	Остаток10 = КоличествоЦелое - Цел(КоличествоЦелое / 10) * 10;

	Если Остаток100 >= 11 И Остаток100 <= 19 Тогда
		Форма = Форма5;
	ИначеЕсли Остаток10 = 1 Тогда
		Форма = Форма1;
	ИначеЕсли Остаток10 >= 2 И Остаток10 <= 4 Тогда
		Форма = Форма2;
	Иначе
		Форма = Форма5;
	КонецЕсли;

	Возврат Строка(КоличествоЦелое) + " " + Форма;

КонецФункции

#КонецОбласти

#Область Оповещения

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ScanData" Тогда

		Штрихкод = сп_ШтрихкодИзПараметраСканера(Параметр);

		Если Не ПустаяСтрока(Штрихкод) Тогда
			сп_ОбработатьШтрихкодТСД(Штрихкод);
		КонецЕсли;

		Возврат;

	КонецЕсли;

	Если ИмяСобытия = "спАРМОбновитьИнтерфейс" Тогда

		ЗаполнитьЯчейкиНаСервере();

		Попытка
			Элементы.Данные.Обновить();
		Исключение
		КонецПопытки;

		Возврат;

	КонецЕсли;

	Попытка
		МенеджерОборудованияКлиент.ОбработатьСобытиеОтУстройства(
			Новый Структура("Источник,Событие,Данные", Источник, ИмяСобытия, Параметр));
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОборудованиеШтрихкодПолучен(Штрихкод, ДополнительныеПараметры) Экспорт

	сп_ОбработатьШтрихкодТСД(Штрихкод);

КонецПроцедуры

&НаКлиенте
Процедура сп_ОбработатьШтрихкодТСД(Штрихкод)

	Штрихкод = СокрЛП(Строка(Штрихкод));

	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат;
	КонецЕсли;

	Штрихкод = сп_ИзвлечьШтрихкодИзDataMatrixНаКлиенте(Штрихкод);

	СканироватьТоварЗавершение(Штрихкод, Неопределено);

КонецПроцедуры

&НаКлиенте
Функция сп_ШтрихкодИзПараметраСканера(Параметр)

	Штрихкод = "";
	ДанныеСканера = Неопределено;

	Если ТипЗнч(Параметр) = Тип("Массив") Тогда

		Если Параметр.Количество() = 0 Тогда
			Возврат "";
		КонецЕсли;

		ДанныеСканера = Параметр[0];

	Иначе

		ДанныеСканера = Параметр;

	КонецЕсли;

	Если ДанныеСканера = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(ДанныеСканера) = Тип("Структура") Тогда

		Если ДанныеСканера.Свойство("Штрихкод") Тогда
			Штрихкод = СокрЛП(Строка(ДанныеСканера.Штрихкод));
		ИначеЕсли ДанныеСканера.Свойство("Barcode") Тогда
			Штрихкод = СокрЛП(Строка(ДанныеСканера.Barcode));
		ИначеЕсли ДанныеСканера.Свойство("ШтрихКод") Тогда
			Штрихкод = СокрЛП(Строка(ДанныеСканера.ШтрихКод));
		ИначеЕсли ДанныеСканера.Свойство("Data") Тогда
			Штрихкод = СокрЛП(Строка(ДанныеСканера.Data));
		ИначеЕсли ДанныеСканера.Свойство("Данные") Тогда
			Штрихкод = СокрЛП(Строка(ДанныеСканера.Данные));
		КонецЕсли;

	Иначе

		Штрихкод = СокрЛП(Строка(ДанныеСканера));

	КонецЕсли;

	Возврат Штрихкод;

КонецФункции

&НаКлиенте
Функция сп_ИзвлечьШтрихкодИзDataMatrixНаКлиенте(СтрокаСканера)

	РабочаяСтрока = СокрЛП(Строка(СтрокаСканера));

	Для каждого Префикс Из СтрРазделить("]d2,]C1,]Q3,]e0", ",") Цикл
		Если Лев(РабочаяСтрока, СтрДлина(Префикс)) = Префикс Тогда
			РабочаяСтрока = Сред(РабочаяСтрока, СтрДлина(Префикс) + 1);
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Лев(РабочаяСтрока, 2) = "01"
		И СтрДлина(РабочаяСтрока) >= 16 Тогда

		GTIN14 = Сред(РабочаяСтрока, 3, 14);
		ЭтоЦифры = Истина;

		Для ИндексСимвола = 1 По СтрДлина(GTIN14) Цикл
			Если Найти("0123456789", Сред(GTIN14, ИндексСимвола, 1)) = 0 Тогда
				ЭтоЦифры = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ЭтоЦифры Тогда
			Если Лев(GTIN14, 1) = "0" Тогда
				Возврат Сред(GTIN14, 2);
			Иначе
				Возврат GTIN14;
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

	Возврат СтрокаСканера;

КонецФункции

&НаСервере
Процедура сп_ПодключитьСканерШтрихкодаНаСервере()

	Попытка

		Если УправлениеНебольшойФирмойПовтИсп.ИспользоватьПодключаемоеОборудование() Тогда

			ТипыОборудования = МенеджерОборудованияКлиентСервер.ПараметрыТипыОборудования();
			ТипыОборудования.СканерШтрихкода = Истина;

			МенеджерОборудования.ПриСозданииНаСервере(ЭтотОбъект, ТипыОборудования);

		КонецЕсли;

	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура сп_ПодключитьСканерШтрихкодаНаКлиенте()

	Попытка
		МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(
			Неопределено,
			ЭтотОбъект);
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура сп_ОтключитьСканерШтрихкодаНаКлиенте()

	Попытка
		МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(
			Неопределено,
			ЭтотОбъект);
