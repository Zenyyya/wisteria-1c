#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не сп_ИнициализироватьПараметрыФормы() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	сп_ЗаполнитьПеремещенияНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ДанныеВыбор(
		Элемент,
		ВыбраннаяСтрока,
		Поле,
		СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если Поле = Элементы.ДанныеАртикул Тогда
		сп_ОткрытьКарточкуТовара();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура Назад(Команда)

	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)

	сп_ЗаполнитьПеремещенияНаСервере();

КонецПроцедуры

#КонецОбласти

#Область Навигация

//<<<--- Tnext Козык К.А. 29.07.2026

&НаКлиенте
Процедура сп_ОткрытьКарточкуТовара()

	ТекущиеДанные = Элементы.Данные.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр(
				"ru = 'Не удалось определить товар для выбранного артикула.'"));
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура(
		"Номенклатура",
		ТекущиеДанные.Номенклатура);

	ОткрытьФорму(
		"Обработка.спАРМРаботникаСклада.Форма.спИнформацияОТовареКарточка",
		ПараметрыФормы,
		ЭтаФорма,
		ТекущиеДанные.Номенклатура,
		,
		,
		,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

//--->>> Tnext Козык К.А. 29.07.2026

&НаКлиенте
Процедура сп_ОткрытьПеремещение()

	ТекущиеДанные = Элементы.Данные.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущиеДанные.Перемещение) Тогда
		Возврат;
	КонецЕсли;

	ОткрытьЗначение(ТекущиеДанные.Перемещение);

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДанныхФормы

&НаСервере
Функция сп_ИнициализироватьПараметрыФормы()

	ЗаказПокупателя = Неопределено;

	ПараметрЗаказПокупателя = Неопределено;

	Если Параметры.Свойство(
			"ЗаказПокупателя",
			ПараметрЗаказПокупателя)
		И ЗначениеЗаполнено(ПараметрЗаказПокупателя) Тогда

		ЗаказПокупателя = ПараметрЗаказПокупателя;
		Возврат Истина;

	КонецЕсли;

	СообщениеПользователю = Новый СообщениеПользователю;
	СообщениеПользователю.Текст = НСтр(
		"ru = 'Форма перемещений не может быть открыта: "
		+ "не указан заказ покупателя.'");
	СообщениеПользователю.Сообщить();

	Возврат Ложь;

КонецФункции

&НаСервере
Процедура сп_ЗаполнитьПеремещенияНаСервере()

	Если Не ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		Данные.Очистить();
		Возврат;
	КонецЕсли;

	//<<<--- Tnext Козык К.А. 29.07.2026
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Перемещения.Ссылка КАК Перемещение,
	|	Перемещения.СтруктурнаяЕдиница КАК Склад,
	|	ЗапасыПеремещений.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ЗапасыПеремещений.Номенклатура.спАртикулПоставщика <> """"
	|			ТОГДА ЗапасыПеремещений.Номенклатура.спАртикулПоставщика
	|		ИНАЧЕ ЗапасыПеремещений.Номенклатура.Артикул
	|	КОНЕЦ КАК Артикул,
	|	ЕСТЬNULL(
	|		ЗапасыПеремещений.Ячейка,
	|		ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) КАК Ячейка,
	|	СУММА(ЗапасыПеремещений.Количество) КАК Количество
	|ИЗ
	|	Документ.ПеремещениеЗапасов.Запасы КАК ЗапасыПеремещений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|			Документ.ПеремещениеЗапасов КАК Перемещения
	|		ПО ЗапасыПеремещений.Ссылка = Перемещения.Ссылка
	|ГДЕ
	|	НЕ Перемещения.ПометкаУдаления
	|	И Перемещения.ДокументОснование = &ЗаказПокупателя
	|
	|СГРУППИРОВАТЬ ПО
	|	Перемещения.Ссылка,
	|	Перемещения.СтруктурнаяЕдиница,
	|	ЗапасыПеремещений.Номенклатура,
	|	ВЫБОР
	|		КОГДА ЗапасыПеремещений.Номенклатура.спАртикулПоставщика <> """"
	|			ТОГДА ЗапасыПеремещений.Номенклатура.спАртикулПоставщика
	|		ИНАЧЕ ЗапасыПеремещений.Номенклатура.Артикул
	|	КОНЕЦ,
	|	ЕСТЬNULL(
	|		ЗапасыПеремещений.Ячейка,
	|		ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склад,
	|	Артикул,
	|	Ячейка";

	Запрос.УстановитьПараметр(
		"ЗаказПокупателя",
		ЗаказПокупателя);

	РезультатЗапроса = Запрос.Выполнить();

	ЗначениеВРеквизитФормы(
		РезультатЗапроса.Выгрузить(),
		"Данные");
	//--->>> Tnext Козык К.А. 29.07.2026

КонецПроцедуры

#КонецОбласти