	Запрос.УстановитьПараметр("АртикулПоставщика", АртикулПоставщика);

	Попытка

		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			Возврат Выборка.ВнешняяСсылка;
		КонецЕсли;

	Исключение
		Возврат "";
	КонецПопытки;

	Возврат "";

