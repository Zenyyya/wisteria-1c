#Область СканированиеТовара

&НаКлиенте
Процедура СканироватьТовар(Команда)

	ОчиститьСообщения();

	#Если МобильныйКлиент Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нажмите аппаратную кнопку сканирования на ТСД.");
	#Иначе
		ТекШтрихкод = "";
		Оповещение = Новый ОписаниеОповещения(
			"СканироватьТоварЗавершение",
			ЭтотОбъект,
			Новый Структура("ТекШтрихкод", ТекШтрихкод));

		ПоказатьВводЗначения(Оповещение, ТекШтрихкод, "Введите штрихкод");
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура СканироватьТоварЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ТекШтрихкод = ?(
		Результат = Неопределено,
		СокрЛП(ДополнительныеПараметры.ТекШтрихкод),
		СокрЛП(Результат));

	Если ПустаяСтрока(ТекШтрихкод) Тогда
		Возврат;
	КонецЕсли;

	ДанныеШтрихкода = Новый Структура("Штрихкод, Количество", ТекШтрихкод, 1);
	ДанныеПоШтрихКодам = ПолучитьДанныеПоШтрихкодамВМассиве(ДанныеШтрихкода);
	МассивДанных = ДанныеПоШтрихкодам.Получить(ТекШтрихкод);

	Если МассивДанных = Неопределено Или МассивДанных.Количество() = 0 Тогда

		ДанныеМаркировки = сп_ДанныеПоШтрихкодуИлиКодуМаркировкиНаСервере(ТекШтрихкод);

		Если ДанныеМаркировки = Неопределено Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Штрихкод/код маркировки не найден: " + ТекШтрихкод);
			Возврат;
		КонецЕсли;

		МассивДанных = Новый Массив;
		МассивДанных.Добавить(ДанныеМаркировки);

	КонецЕсли;

	РезультатСканирования = сп_ВыполнитьСканированиеДанныхШтрихкодаПриемкиНаСервере(МассивДанных[0]);

	Если ЗначениеЗаполнено(РезультатСканирования) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатСканирования);
	КонецЕсли;

	ЗаполнитьТоварыНаСервере();

	Попытка
		Элементы.Данные.Обновить();
	Исключение
	КонецПопытки;

	Оповестить("спАРМОбновитьИнтерфейс", Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеПриСканировании(ДанныеТовара)

	Если ДанныеТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;

	РезультатСканирования = сп_ВыполнитьСканированиеДанныхШтрихкодаПриемкиНаСервере(ДанныеТовара);

	Если ЗначениеЗаполнено(РезультатСканирования) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатСканирования);
	КонецЕсли;

	ЗаполнитьТоварыНаСервере();

	Попытка
		Элементы.Данные.Обновить();
	Исключение
	КонецПопытки;

	Оповестить("спАРМОбновитьИнтерфейс", Неопределено);

КонецПроцедуры

&НаСервере
Функция сп_ВыполнитьСканированиеДанныхШтрихкодаПриемкиНаСервере(ДанныеТовара)

	сп_ИнициализироватьПараметрыФормы();

	Номенклатура = Неопределено;
	ЕдиницаИзмерения = Неопределено;

	Если ТипЗнч(ДанныеТовара) = Тип("Структура") Тогда

		ДанныеТовара.Свойство("Номенклатура", Номенклатура);
		ДанныеТовара.Свойство("ЕдиницаИзмерения", ЕдиницаИзмерения);

	Иначе

		Номенклатура = ДанныеТовара;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "Не определен товар по отсканированному штрихкоду.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийЗаказ) Тогда
		Возврат "Не определен заказ для приемки.";
	КонецЕсли;

	СтрокаЗапасов = сп_НайтиСтрокуЗапасовДляСканированияПриемки(Номенклатура, ЕдиницаИзмерения);

	Если СтрокаЗапасов = Неопределено Тогда
		Возврат "Отсканированный товар не найден в текущем заказе приемки или уже полностью принят: " + Строка(Номенклатура);
	КонецЕсли;

	СсылкаПеремещения = сп_НайтиИлиСоздатьПеремещениеПриемки(СтрокаЗапасов.Заказ);

	Если Не ЗначениеЗаполнено(СсылкаПеремещения) Тогда
		Возврат "Не удалось создать или найти документ Перемещение запасов.";
	КонецЕсли;

	ПеремещениеОбъект = СсылкаПеремещения.ПолучитьОбъект();

	СтрокаДокумента = сп_НайтиСтрокуПеремещения(ПеремещениеОбъект, СтрокаЗапасов);

	Если СтрокаДокумента = Неопределено Тогда

		СтрокаДокумента = ПеремещениеОбъект.Запасы.Добавить();
		сп_ЗаполнитьСтрокуПеремещенияИзСтрокиЗапасов(СтрокаДокумента, СтрокаЗапасов);
		СтрокаДокумента.Количество = 1;

	Иначе

		СтрокаДокумента.Количество = СтрокаДокумента.Количество + 1;

	КонецЕсли;

	Попытка
		ПеремещениеОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Возврат "Ошибка записи перемещения: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат "Товар принят: "
		+ Строка(Номенклатура)
		+ Символы.ПС
		+ "Заказ: "
		+ Строка(СтрокаЗапасов.Заказ);
	КонецФункции

&НаСервере
Функция сп_НайтиСтрокуЗапасовДляСканированияПриемки(Номенклатура, ЕдиницаИзмерения = Неопределено)

	ТаблицаЗапасов = сп_ПолучитьТаблицуЗапасовПриемкиНаСервере();

	Для каждого Стр Из ТаблицаЗапасов Цикл

		Если ЗначениеЗаполнено(ТекущийЗаказ)
			И Стр.Заказ <> ТекущийЗаказ Тогда
			Продолжить;
		КонецЕсли;

		Если Стр.Номенклатура <> Номенклатура Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(ЕдиницаИзмерения)
			И Стр.ЕдиницаИзмерения <> ЕдиницаИзмерения Тогда
			Продолжить;
		КонецЕсли;

		Если Стр.Отклонение <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Возврат Стр;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция сп_НайтиИлиСоздатьПеремещениеПриемки(Заказ)

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Заказ,
			"СтруктурнаяЕдиницаРезерв, СтруктурнаяЕдиницаПолучатель");
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	СкладИсточник = РеквизитыЗаказа.СтруктурнаяЕдиницаРезерв;
	СкладПолучатель = РеквизитыЗаказа.СтруктурнаяЕдиницаПолучатель;

	Если Не ЗначениеЗаполнено(СкладИсточник) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СкладПолучатель) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Перемещение.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПеремещениеЗапасов КАК Перемещение
	|ГДЕ
	|	Перемещение.ДокументОснование = &Заказ
	|	И НЕ Перемещение.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Перемещение.Дата УБЫВ";

	Запрос.УстановитьПараметр("Заказ", Заказ);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	НовыйДокумент = Документы.ПеремещениеЗапасов.СоздатьДокумент();
	НовыйДокумент.Дата = ТекущаяДатаСеанса();

	Попытка
		НовыйДокумент.Заполнить(Заказ);
	Исключение
	КонецПопытки;

	Попытка
		НовыйДокумент.Запасы.Очистить();
	Исключение
	КонецПопытки;

	НовыйДокумент.ДокументОснование = Заказ;
	НовыйДокумент.СтруктурнаяЕдиница = СкладИсточник;
	НовыйДокумент.СтруктурнаяЕдиницаПолучатель = СкладПолучатель;

	Попытка
		НовыйДокумент.ЗаказНаПеремещение = Документы.ЗаказНаПеремещение.ПустаяСсылка();
	Исключение
	КонецПопытки;

	Попытка
		НовыйДокумент.Комментарий =
			"Создано АРМ кладовщика. Приемка. Основание: "
			+ Строка(Заказ);
	Исключение
	КонецПопытки;

	Попытка
		НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат НовыйДокумент.Ссылка;

КонецФункции

#КонецОбласти

#Область ОбщиеФункцииСканирования

&НаСервере
Функция сп_ДанныеПоШтрихкодуИлиКодуМаркировкиНаСервере(Штрихкод)

	Кандидаты = сп_КандидатыШтрихкодаИзМаркировкиНаСервере(Штрихкод);

	Если Кандидаты.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|   Штрихкоды.Номенклатура КАК Номенклатура,
	|   Штрихкоды.Характеристика КАК Характеристика,
	|   Штрихкоды.Партия КАК Партия,
	|   Штрихкоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|   Штрихкоды.Штрихкод КАК Штрихкод
	|ИЗ
	|   РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|   Штрихкоды.Штрихкод В (&Кандидаты)";

	Запрос.УстановитьПараметр("Кандидаты", Кандидаты);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Номенклатура", Выборка.Номенклатура);
	Результат.Вставить("Характеристика", Выборка.Характеристика);
	Результат.Вставить("Партия", Выборка.Партия);
	Результат.Вставить("ЕдиницаИзмерения", Выборка.ЕдиницаИзмерения);
	Результат.Вставить("Штрихкод", Выборка.Штрихкод);
	Результат.Вставить("КодМаркировки", Штрихкод);

	Возврат Результат;

КонецФункции

&НаСервере
Функция сп_КандидатыШтрихкодаИзМаркировкиНаСервере(Штрихкод)

	Результат = Новый Массив;
	Штрихкод = СокрЛП(Строка(Штрихкод));

	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат Результат;
	КонецЕсли;

	сп_ДобавитьШтрихкодКандидат(Результат, Штрихкод);

	Позиция01 = Найти(Штрихкод, "01");

	Если Позиция01 > 0 И СтрДлина(Штрихкод) >= Позиция01 + 15 Тогда

		GTIN = Сред(Штрихкод, Позиция01 + 2, 14);

		Если сп_СтрокаТолькоЦифры(GTIN) Тогда

			сп_ДобавитьШтрихкодКандидат(Результат, GTIN);

			Если Лев(GTIN, 1) = "0" Тогда
				сп_ДобавитьШтрихкодКандидат(Результат, Сред(GTIN, 2));
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура сп_ДобавитьШтрихкодКандидат(МассивКандидатов, Штрихкод)

	Штрихкод = СокрЛП(Строка(Штрихкод));

	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат;
	КонецЕсли;

	Если МассивКандидатов.Найти(Штрихкод) = Неопределено Тогда
		МассивКандидатов.Добавить(Штрихкод);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция сп_СтрокаТолькоЦифры(ЗначениеСтроки)

	ЗначениеСтроки = Строка(ЗначениеСтроки);

	Если ПустаяСтрока(ЗначениеСтроки) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для НомерСимвола = 1 По СтрДлина(ЗначениеСтроки) Цикл
		Символ = Сред(ЗначениеСтроки, НомерСимвола, 1);
		Если Найти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

&НаСервере
Функция сп_НоменклатураПоШтрихкодуНаСервере(Штрихкод)

	Штрихкод = СокрЛП(Штрихкод);

	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|   Штрихкоды.Номенклатура КАК Номенклатура
	|ИЗ
	|   РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|   Штрихкоды.Штрихкод = &Штрихкод";

	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);

	Попытка

		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			Возврат Выборка.Номенклатура;
		КонецЕсли;

	Исключение
	КонецПопытки;

	Возврат Справочники.Номенклатура.ПустаяСсылка();

КонецФункции

&НаСервере
Функция сп_НайтиСтрокуПеремещения(ПеремещениеОбъект, СтрокаЗапасов)

	Для каждого СтрокаДокумента Из ПеремещениеОбъект.Запасы Цикл

		Если СтрокаДокумента.Номенклатура <> СтрокаЗапасов.Номенклатура Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Если СтрокаДокумента.ЕдиницаИзмерения <> СтрокаЗапасов.ЕдиницаИзмерения Тогда
				Продолжить;
			КонецЕсли;
		Исключение
		КонецПопытки;

		Возврат СтрокаДокумента;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервере
Процедура сп_ЗаполнитьСтрокуПеремещенияИзСтрокиЗапасов(СтрокаДокумента, СтрокаЗапасов)

	СтрокаДокумента.Номенклатура = СтрокаЗапасов.Номенклатура;

	Попытка
		СтрокаДокумента.ЕдиницаИзмерения = СтрокаЗапасов.ЕдиницаИзмерения;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаДокумента.Коэффициент = 1;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаДокумента.КоличествоУпаковок = 1;
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеПоШтрихкодамВМассиве(ДанныеШтрихкода, СтруктурнаяЕдиница = Неопределено)

	РегистрыСведений.ШтрихкодыНоменклатуры.ПреобразоватьВесовойШтрихкод(ДанныеШтрихкода);

	Штрихкоды = Новый Массив;
	Штрихкоды.Добавить(ДанныеШтрихкода);

	ДанныеПоШтрихкодам = Новый Соответствие;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|   Рег.Штрихкод КАК Штрихкод,
	|   Рег.Номенклатура КАК Номенклатура,
	|   Рег.Характеристика КАК Характеристика,
	|   Рег.Партия КАК Партия,
	|   Рег.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|   ЕСТЬNULL(СерииНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)) КАК Серия
	|ИЗ
	|   РегистрСведений.ШтрихкодыНоменклатуры КАК Рег
	|       ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|       ПО (&СерииНоменклатурыИспользуются)
	|           И Рег.Номенклатура = СерииНоменклатуры.Владелец
	|           И (Рег.Номенклатура.ИспользоватьСерииНоменклатуры)
	|           И Рег.Штрихкод = СерииНоменклатуры.Наименование
	|ГДЕ
	|   Рег.Штрихкод В(&МассивШтрихкодов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|   ТЗДанныеОВесовомТоваре.КодВесовогоТовара КАК КодВесовогоТовара,
	|   ТЗДанныеОВесовомТоваре.ПрефиксВесовогоТовара КАК ПрефиксВесовогоТовара,
	|   ТЗДанныеОВесовомТоваре.ШтрихКод КАК ШтрихКод
	|ПОМЕСТИТЬ ВременнаяТаблицаВесовойТовар
	|ИЗ
	|   &ТЗДанныеОВесовомТоваре КАК ТЗДанныеОВесовомТоваре
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|   КодыТоваровSKU.Номенклатура КАК Номенклатура,
	|   КодыТоваровSKU.Характеристика КАК Характеристика,
	|   КодыТоваровSKU.Партия КАК Партия,
	|   КодыТоваровSKU.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|   ВременнаяТаблицаВесовойТовар.ШтрихКод КАК ШтрихКод,
	|   ВременнаяТаблицаВесовойТовар.КодВесовогоТовара КАК КодВесовогоТовара,
	|   ВременнаяТаблицаВесовойТовар.ПрефиксВесовогоТовара КАК ПрефиксВесовогоТовара,
	|   ЕСТЬNULL(СерииНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)) КАК Серия,
	|   ЕСТЬNULL(КодыТоваровSKU.Номенклатура.ВидАлкогольнойПродукции.Маркируемый, ЛОЖЬ)
	|       ИЛИ КодыТоваровSKU.Номенклатура.УдалитьТабачнаяПродукция КАК МаркируемаяПродукция
	|ИЗ
	|   РегистрСведений.КодыТоваровSKU КАК КодыТоваровSKU
	|       ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВременнаяТаблицаВесовойТовар КАК ВременнаяТаблицаВесовойТовар
	|       ПО КодыТоваровSKU.SKU = ВременнаяТаблицаВесовойТовар.КодВесовогоТовара
	|       ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|       ПО (&СерииНоменклатурыИспользуются)
	|           И КодыТоваровSKU.Номенклатура = СерииНоменклатуры.Владелец
	|           И (КодыТоваровSKU.Номенклатура.ИспользоватьСерииНоменклатуры)
	|           И (ВременнаяТаблицаВесовойТовар.ШтрихКод = СерииНоменклатуры.Наименование)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|   ВременнаяТаблицаВесовойТовар.КодВесовогоТовара КАК КодВесовогоТовара,
	|   ВременнаяТаблицаВесовойТовар.ПрефиксВесовогоТовара КАК ПрефиксВесовогоТовара,
	|   ВременнаяТаблицаВесовойТовар.ШтрихКод КАК ШтрихКод
	|ИЗ
	|   ВременнаяТаблицаВесовойТовар КАК ВременнаяТаблицаВесовойТовар");

	МассивШтрихкодов = Новый Массив;

	ТЗДанныеОВесовомТоваре = Новый ТаблицаЗначений;
	ТЗДанныеОВесовомТоваре.Колонки.Добавить("КодВесовогоТовара", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 0, ДопустимыйЗнак.Неотрицательный)));
	ТЗДанныеОВесовомТоваре.Колонки.Добавить("ПрефиксВесовогоТовара", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(1, 0, ДопустимыйЗнак.Неотрицательный)));
	ТЗДанныеОВесовомТоваре.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(200)));

	Для каждого ТекШтрихкод Из Штрихкоды Цикл

		МассивШтрихкодов.Добавить(ТекШтрихкод.ШтрихКод);
		ДанныеПоШтрихкодам.Вставить(ТекШтрихкод.ШтрихКод, Новый Массив);

		Если ТекШтрихкод.Свойство("КодВесовогоТовара") Тогда

			НоваяСтрокаОВесовомТоваре = ТЗДанныеОВесовомТоваре.Добавить();
			НоваяСтрокаОВесовомТоваре.КодВесовогоТовара = ТекШтрихкод.КодВесовогоТовара;
			НоваяСтрокаОВесовомТоваре.ПрефиксВесовогоТовара = ТекШтрихкод.ПрефиксВесовогоТовара;
			НоваяСтрокаОВесовомТоваре.Штрихкод = ТекШтрихкод.Штрихкод;

		КонецЕсли;

	КонецЦикла;

	Запрос.УстановитьПараметр("МассивШтрихкодов", МассивШтрихкодов);

	ИспользоватьСерииНоменклатуры = СерииНоменклатурыУНФ.ИспользоватьСерииНоменклатурыОстатки();

	Если ИспользоватьСерииНоменклатуры <> Неопределено Тогда
		Запрос.УстановитьПараметр("СерииНоменклатурыИспользуются", Истина);
	Иначе
		Запрос.УстановитьПараметр("СерииНоменклатурыИспользуются", Ложь);
	КонецЕсли;

	Запрос.УстановитьПараметр("ТЗДанныеОВесовомТоваре", ТЗДанныеОВесовомТоваре);
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", СтруктурнаяЕдиница);

	МассивРезультатов = Запрос.ВыполнитьПакет();

	Выборка = МассивРезультатов[2].Выбрать();

	Пока Выборка.Следующий() Цикл

		МассивДанныхПоШтрихкоду = ДанныеПоШтрихкодам[Выборка.Штрихкод];

		ТекДанные = Новый Структура;
		МассивДанныхПоШтрихкоду.Добавить(ТекДанные);

		ТекДанные.Вставить("Номенклатура", Выборка.Номенклатура);
		ТекДанные.Вставить("Характеристика", Выборка.Характеристика);
		ТекДанные.Вставить("Партия", Выборка.Партия);
		ТекДанные.Вставить("ЕдиницаИзмерения", Выборка.ЕдиницаИзмерения);
		ТекДанные.Вставить("КодВесовогоТовара", Выборка.КодВесовогоТовара);
		ТекДанные.Вставить("ПрефиксВесовогоТовара", Выборка.ПрефиксВесовогоТовара);
		ТекДанные.Вставить("МаркируемаяПродукция", Выборка.МаркируемаяПродукция);
		ТекДанные.Вставить("НоменклатураПоставщика", Неопределено);

		Если ИспользоватьСерииНоменклатуры <> Неопределено Тогда
			ТекДанные.Вставить("Серия", Выборка.Серия);
		КонецЕсли;

	КонецЦикла;

	Выборка = МассивРезультатов[0].Выбрать();

	Пока Выборка.Следующий() Цикл

		МассивДанныхПоШтрихкоду = ДанныеПоШтрихкодам[Выборка.Штрихкод];

		ТекДанные = Новый Структура;
		МассивДанныхПоШтрихкоду.Добавить(ТекДанные);

		ТекДанные.Вставить("Номенклатура", Выборка.Номенклатура);
		ТекДанные.Вставить("Характеристика", Выборка.Характеристика);
		ТекДанные.Вставить("Партия", Выборка.Партия);
		ТекДанные.Вставить("ЕдиницаИзмерения", Выборка.ЕдиницаИзмерения);
		ТекДанные.Вставить("НоменклатураПоставщика", Неопределено);

		Если ИспользоватьСерииНоменклатуры <> Неопределено Тогда
			ТекДанные.Вставить("Серия", Выборка.Серия);
		КонецЕсли;

	КонецЦикла;

	Возврат ДанныеПоШтрихкодам;

КонецФункции

#КонецОбласти
