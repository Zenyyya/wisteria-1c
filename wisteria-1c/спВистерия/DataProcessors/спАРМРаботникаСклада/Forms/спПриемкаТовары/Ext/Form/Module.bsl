&НаСервере
Процедура сп_ИнициализироватьПараметрыФормы()

	Если Не ЗначениеЗаполнено(ЗаказыСериализованные) Тогда

		ЗаказыСтрокойПараметр = "";

		Если Параметры.Свойство("ЗаказыСериализованные", ЗаказыСтрокойПараметр) Тогда
			ЗаказыСериализованные = ЗаказыСтрокойПараметр;
		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийЗаказ) Тогда

		ЗаказПараметр = Неопределено;

		Если Параметры.Свойство("Заказ", ЗаказПараметр) Тогда
			ТекущийЗаказ = ЗаказПараметр;
		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийЗаказ)
		И ЗначениеЗаполнено(ЗаказыСериализованные) Тогда

		Попытка

			СписокЗаказов = ЗначениеИзСтрокиВнутр(ЗаказыСериализованные);
			ТекущийЗаказ = сп_ПервыйЗаказПоМаршрутуНаСервере(СписокЗаказов);

		Исключение
		КонецПопытки;

	КонецЕсли;

КонецПроцедуры 

&НаСервере
Функция сп_ПервыйЗаказПоМаршрутуНаСервере(СписокЗаказов)

	МассивЗаказов = Новый Массив;

	Если СписокЗаказов = Неопределено Тогда
		Возврат Документы.ЗаказНаПеремещение.ПустаяСсылка();
	КонецЕсли;

	Для каждого ЭлементСписка Из СписокЗаказов Цикл

		Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
			МассивЗаказов.Добавить(ЭлементСписка.Значение);
		КонецЕсли;

	КонецЦикла;

	Если МассивЗаказов.Количество() = 0 Тогда
		Возврат Документы.ЗаказНаПеремещение.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заказы.Ссылка КАК Заказ
	|ИЗ
	|	Документ.ЗаказНаПеремещение КАК Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.спМаршрутКладовщика КАК МаршрутСклада
	|		ПО Заказы.СтруктурнаяЕдиницаПолучатель = МаршрутСклада.Склад
	|			И МаршрутСклада.Ячейка = ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)
	|ГДЕ
	|	Заказы.Ссылка В (&Заказы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕСТЬNULL(МаршрутСклада.ПорядокСклада, 999999),
	|	Заказы.СтруктурнаяЕдиницаПолучатель,
	|	Заказы.Дата,
	|	Заказы.Номер";

	Запрос.УстановитьПараметр("Заказы", МассивЗаказов);

	Попытка

		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			Возврат Выборка.Заказ;
		КонецЕсли;

	Исключение
	КонецПопытки;

	Возврат МассивЗаказов[0];

КонецФункции

