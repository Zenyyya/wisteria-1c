#Область Оповещения

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ScanData" Тогда

		Штрихкод = сп_ШтрихкодИзПараметраСканера(Параметр);

		Если Не ПустаяСтрока(Штрихкод) Тогда
			сп_ОбработатьШтрихкодТСД(Штрихкод);
		КонецЕсли;

		Возврат;

	КонецЕсли;

	Если ИмяСобытия = "спАРМОбновитьИнтерфейс" Тогда

		ЗаполнитьТоварыНаСервере();

		Попытка
			Элементы.Данные.Обновить();
		Исключение
		КонецПопытки;

		Возврат;

	КонецЕсли;

	Попытка
		МенеджерОборудованияКлиент.ОбработатьСобытиеОтУстройства(
			Новый Структура("Источник,Событие,Данные", Источник, ИмяСобытия, Параметр));
	Исключение
	КонецПопытки;

КонецПроцедуры


