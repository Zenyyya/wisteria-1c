#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	сп_ИнициализироватьПараметрыФормы();
	ПоказыватьОтсканированные = Ложь;
	сп_НастроитьИнтерфейс();
	ЗаполнитьЗаказыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ДанныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ТекущиеДанные = Элементы.Данные.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не сп_СтрокаЗаказаВРаботеКлиент(ТекущиеДанные) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заказ недоступен для приемки. Состояние заказа ""Завершен"".");
		Возврат;
	КонецЕсли;

	ОткрытьВыбранныйЗаказ();

КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьОтсканированныеПриИзменении(Элемент)

	ЗаполнитьЗаказыНаСервере();

	Попытка
		Элементы.Данные.Обновить();
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура ОткрытьСписокПеремещений(Команда)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗаказыСериализованные", ЗаказыСериализованные);

	ОткрытьФорму(
		"Обработка.спАРМРаботникаСклада.Форма.спСписокПеремещений",
		ПараметрыФормы,
		ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПриемку(Команда)

	ТекущиеДанные = Элементы.Данные.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Заказ) Тогда

		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите заказ для завершения приемки.");
		Возврат;

	КонецЕсли;

	Если Не сп_СтрокаЗаказаВРаботеКлиент(ТекущиеДанные) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заказ недоступен для приемки. Состояние заказа ""Завершен"".");
		Возврат;
	КонецЕсли;

	Результат = сп_ЗавершитьПриемкуЗаказаНаСервере(ТекущиеДанные.Заказ);

	Если ЗначениеЗаполнено(Результат) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат);
	КонецЕсли;

	ЗаполнитьЗаказыНаСервере();

	Попытка
		Элементы.Данные.Обновить();
	Исключение
	КонецПопытки;

	Оповестить("спАРМОбновитьИнтерфейс");

КонецПроцедуры

#КонецОбласти

#Область Навигация

&НаКлиенте
Процедура ОткрытьВыбранныйЗаказ()

	ТекущиеДанные = Элементы.Данные.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущиеДанные.Заказ) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось определить заказ.");
		Возврат;
	КонецЕсли;

	Если Не сп_СтрокаЗаказаВРаботеКлиент(ТекущиеДанные) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заказ недоступен для приемки. Состояние заказа ""Завершен"".");
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗаказыСериализованные", ЗаказыСериализованные);
	ПараметрыФормы.Вставить("Заказ", ТекущиеДанные.Заказ);

	ОткрытьФорму(
		"Обработка.спАРМРаботникаСклада.Форма.спПриемкаТовары",
		ПараметрыФормы,
		ЭтаФорма);

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДанныхФормы

&НаСервере
Процедура ЗаполнитьЗаказыНаСервере()

	сп_ИнициализироватьПараметрыФормы();

	Данные.Очистить();

	МассивЗаказов = сп_МассивЗаказовНаСервере();

	Если МассивЗаказов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|   ЗаказЗапасы.Ссылка КАК Заказ,
	|   СУММА(ЗаказЗапасы.Количество) КАК КоличествоПлан
	|ПОМЕСТИТЬ ВТ_План
	|ИЗ
	|   Документ.ЗаказНаПеремещение.Запасы КАК ЗаказЗапасы
	|ГДЕ
	|   ЗаказЗапасы.Ссылка В (&Заказы)
	|
	|СГРУППИРОВАТЬ ПО
	|   ЗаказЗапасы.Ссылка
	|;
	|
	|ВЫБРАТЬ
	|   Перемещение.ДокументОснование КАК Заказ,
	|   СУММА(ПеремещениеЗапасы.Количество) КАК КоличествоФакт
	|ПОМЕСТИТЬ ВТ_Факт
	|ИЗ
	|   Документ.ПеремещениеЗапасов.Запасы КАК ПеремещениеЗапасы
	|       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПеремещениеЗапасов КАК Перемещение
	|       ПО ПеремещениеЗапасы.Ссылка = Перемещение.Ссылка
	|ГДЕ
	|   НЕ Перемещение.ПометкаУдаления
	|   И Перемещение.ДокументОснование В (&Заказы)
	|
	|СГРУППИРОВАТЬ ПО
	|   Перемещение.ДокументОснование
	|;
	|
	|ВЫБРАТЬ
	|   ВТ_План.Заказ КАК Заказ,
	|   ВТ_План.Заказ.Дата КАК Дата,
	|   ВТ_План.Заказ.Номер КАК Номер,
	|   ВТ_План.Заказ.СостояниеЗаказа КАК СостояниеЗаказа,
	|   ВЫБОР
	|       КОГДА ВТ_План.Заказ.СостояниеЗаказа = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовНаПеремещение.Завершен)
	|           ТОГДА ЛОЖЬ
	|       ИНАЧЕ ИСТИНА
	|   КОНЕЦ КАК ЗаказВРаботе,
	|   ВЫБОР
	|       КОГДА ВТ_План.Заказ.СостояниеЗаказа = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовНаПеремещение.Завершен)
	|           ТОГДА 1
	|       ИНАЧЕ 0
	|   КОНЕЦ КАК ПорядокСтатуса,
	|   ВТ_План.КоличествоПлан КАК КоличествоПлан,
	|   ЕСТЬNULL(ВТ_Факт.КоличествоФакт, 0) КАК КоличествоФакт
	|ИЗ
	|   ВТ_План КАК ВТ_План
	|       ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Факт КАК ВТ_Факт
	|       ПО ВТ_План.Заказ = ВТ_Факт.Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|   Дата,
	|   Номер";

	Запрос.УстановитьПараметр("Заказы", МассивЗаказов);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Отклонение = Выборка.КоличествоПлан - Выборка.КоличествоФакт;

		Если Отклонение < 0 Тогда
			Отклонение = 0;
		КонецЕсли;

		Если Не ПоказыватьОтсканированные
			И Не Выборка.ЗаказВРаботе Тогда
			Продолжить;
		КонецЕсли;

		СтрокаСписка = Данные.Добавить();

		СтрокаСписка.Заказ = Выборка.Заказ;
		СтрокаСписка.Наименование = Строка(Выборка.Заказ);
		СтрокаСписка.КоличествоПлан = Выборка.КоличествоПлан;
		СтрокаСписка.КоличествоФакт = Выборка.КоличествоФакт;
		СтрокаСписка.Отклонение = Отклонение;

		Попытка
			СтрокаСписка.СостояниеЗаказа = Выборка.СостояниеЗаказа;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаСписка.ЗаказВРаботе = Выборка.ЗаказВРаботе;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаСписка.ПорядокСтатуса = Выборка.ПорядокСтатуса;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаСписка.ДатаСортировки = Выборка.Дата;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаСписка.НомерСортировки = СокрЛП(Строка(Выборка.Номер));
		Исключение
		КонецПопытки;

		СтрокаСписка.КоличествоПланПредставление = сп_КоличествоШтПредставление(СтрокаСписка.КоличествоПлан);
		СтрокаСписка.КоличествоФактПредставление = сп_КоличествоШтПредставление(СтрокаСписка.КоличествоФакт);
		СтрокаСписка.ОтклонениеПредставление = сп_КоличествоШтПредставление(СтрокаСписка.Отклонение);

		СтрокаСписка.СтатусСканирования = Строка(СтрокаСписка.КоличествоФакт) + " из " + Строка(СтрокаСписка.КоличествоПлан) + " принято";

		НомерЗаказа = СокрЛП(Строка(Выборка.Номер));

		Если ЗначениеЗаполнено(НомерЗаказа) Тогда
			СтрокаСписка.Представление = "№" + НомерЗаказа + " от " + Формат(Выборка.Дата, "ДФ=dd.MM.yyyy") + Символы.ПС + СтрокаСписка.СтатусСканирования;
		Иначе
			СтрокаСписка.Представление = СтрокаСписка.Наименование + Символы.ПС + СтрокаСписка.СтатусСканирования;
		КонецЕсли;

	КонецЦикла;

	Попытка
		Данные.Сортировать("ПорядокСтатуса, ДатаСортировки Убыв, НомерСортировки Убыв");
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ЗавершениеПриемки

&НаКлиенте
Функция сп_СтрокаЗаказаВРаботеКлиент(СтрокаСписка)

	Попытка
		Возврат СтрокаСписка.ЗаказВРаботе;
	Исключение
	КонецПопытки;

	Возврат Ложь;

КонецФункции

&НаСервере
Функция сп_ЗавершитьПриемкуЗаказаНаСервере(Заказ)

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат "Не удалось определить заказ для завершения приемки.";
	КонецЕсли;

	ПланФакт = сп_ПланФактЗаказаНаСервере(Заказ);

	Если ПланФакт.План > ПланФакт.Факт Тогда

		Возврат "Заказ принят не полностью. План: "
			+ сп_КоличествоШтПредставление(ПланФакт.План)
			+ ", факт: "
			+ сп_КоличествоШтПредставление(ПланФакт.Факт)
			+ ".";

	КонецЕсли;

	РезультатПроведения = сп_ПровестиПеремещениеЗаказаНаСервере(Заказ);

	Если ЗначениеЗаполнено(РезультатПроведения) Тогда
		Возврат РезультатПроведения;
	КонецЕсли;

	Возврат "Приемка завершена. Перемещение проведено.";

КонецФункции

&НаСервере
Функция сп_ПланФактЗаказаНаСервере(Заказ)

	Результат = Новый Структура;
	Результат.Вставить("План", 0);
	Результат.Вставить("Факт", 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|   СУММА(ЗаказЗапасы.Количество) КАК План
	|ИЗ
	|   Документ.ЗаказНаПеремещение.Запасы КАК ЗаказЗапасы
	|ГДЕ
	|   ЗаказЗапасы.Ссылка = &Заказ
	|;
	|
	|ВЫБРАТЬ
	|   СУММА(ПеремещениеЗапасы.Количество) КАК Факт
	|ИЗ
	|   Документ.ПеремещениеЗапасов.Запасы КАК ПеремещениеЗапасы
	|       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПеремещениеЗапасов КАК Перемещение
	|       ПО ПеремещениеЗапасы.Ссылка = Перемещение.Ссылка
	|ГДЕ
	|   НЕ Перемещение.ПометкаУдаления
	|   И Перемещение.ДокументОснование = &Заказ";

	Запрос.УстановитьПараметр("Заказ", Заказ);

	Попытка
		Результаты = Запрос.ВыполнитьПакет();
	Исключение
		Возврат Результат;
	КонецПопытки;

	Если Результаты.Количество() >= 1 Тогда
		ВыборкаПлан = Результаты[0].Выбрать();
		Если ВыборкаПлан.Следующий() И ЗначениеЗаполнено(ВыборкаПлан.План) Тогда
			Результат.План = ВыборкаПлан.План;
		КонецЕсли;
	КонецЕсли;

	Если Результаты.Количество() >= 2 Тогда
		ВыборкаФакт = Результаты[1].Выбрать();
		Если ВыборкаФакт.Следующий() И ЗначениеЗаполнено(ВыборкаФакт.Факт) Тогда
			Результат.Факт = ВыборкаФакт.Факт;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция сп_НайтиПеремещениеПриемкиНаСервере(Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|   Перемещение.Ссылка КАК Ссылка
	|ИЗ
	|   Документ.ПеремещениеЗапасов КАК Перемещение
	|ГДЕ
	|   НЕ Перемещение.ПометкаУдаления
	|   И Перемещение.ДокументОснование = &Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|   Перемещение.Дата УБЫВ";

	Запрос.УстановитьПараметр("Заказ", Заказ);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция сп_ПровестиПеремещениеЗаказаНаСервере(Заказ)

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат "Не определен заказ для проведения перемещения.";
	КонецЕсли;

	Перемещение = сп_НайтиПеремещениеПриемкиНаСервере(Заказ);

	Если Не ЗначениеЗаполнено(Перемещение) Тогда
		Возврат "Не найдено перемещение запасов по выбранному заказу.";
	КонецЕсли;

	Попытка

		ОбъектПеремещения = Перемещение.ПолучитьОбъект();

		Если Не ОбъектПеремещения.Проведен Тогда
			ОбъектПеремещения.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;

		Возврат "";

	Исключение

		Возврат "Ошибка проведения перемещения: " + ОписаниеОшибки();

	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура сп_ИнициализироватьПараметрыФормы()

	Если Не ЗначениеЗаполнено(ЗаказыСериализованные) Тогда

		ЗаказыСтрокойПараметр = "";

		Если Параметры.Свойство("ЗаказыСериализованные", ЗаказыСтрокойПараметр) Тогда
			ЗаказыСериализованные = ЗаказыСтрокойПараметр;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция сп_МассивЗаказовНаСервере()

	Результат = Новый Массив;

	Если Не ЗначениеЗаполнено(ЗаказыСериализованные) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		СписокЗаказов = ЗначениеИзСтрокиВнутр(ЗаказыСериализованные);
	Исключение
		Возврат Результат;
	КонецПопытки;

	Для каждого ЭлементСписка Из СписокЗаказов Цикл
		Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
			Результат.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция сп_КоличествоШтПредставление(Количество)

	Если Количество = Неопределено Тогда
		Количество = 0;
	КонецЕсли;

	Если ТипЗнч(Количество) <> Тип("Число") Тогда
		Попытка
			Количество = Число(Количество);
		Исключение
			Количество = 0;
		КонецПопытки;
	КонецЕсли;

	Возврат Формат(Количество, "ЧДЦ=0") + " шт";

КонецФункции

&НаСервере
Процедура сп_НастроитьИнтерфейс()

	Попытка
		Элементы.Данные.ВысотаСтроки = 90;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеПредставление.Заголовок = "Заказ";
		Элементы.ДанныеПредставление.МногострочныйРежим = Истина;
		Элементы.ДанныеПредставление.АвтоПереносСтрок = Истина;
	Исключение
	КонецПопытки;

	Попытка
		Элементы.ДанныеКоличествоПланПредставление.Заголовок = "План";
	Исключение
	КонецПопытки;

	Попытка
