#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	сп_ПодключитьСканерШтрихкодаНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	сп_ПодключитьСканерШтрихкодаНаКлиенте();

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	сп_ОтключитьСканерШтрихкодаНаКлиенте();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ScanData" Тогда

		Штрихкод = сп_ШтрихкодИзПараметраСканера(Параметр);

		Если Не ПустаяСтрока(Штрихкод) Тогда
			сп_ОбработатьШтрихкодТСД(Штрихкод);
		КонецЕсли;

		Возврат;

	КонецЕсли;

	Попытка
		МенеджерОборудованияКлиент.ОбработатьСобытиеОтУстройства(
			Новый Структура("Источник,Событие,Данные", Источник, ИмяСобытия, Параметр));
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОборудованиеШтрихкодПолучен(Штрихкод, ДополнительныеПараметры) Экспорт

	сп_ОбработатьШтрихкодТСД(Штрихкод);

КонецПроцедуры

#КонецОбласти

#Область Сканирование

&НаКлиенте
Процедура сп_ОбработатьШтрихкодТСД(Штрихкод)

	Штрихкод = сп_НормализоватьШтрихкодСканера(Штрихкод);

	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат;
	КонецЕсли;

	ОчиститьСообщения();

	РезультатПоиска = сп_НайтиТоварПоШтрихкодуНаСервере(Штрихкод);

	Если РезультатПоиска = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Товар по штрихкоду/коду маркировки не найден: " + Штрихкод);
		Возврат;
	КонецЕсли;

	Номенклатура = Неопределено;
	ЕдиницаИзмерения = Неопределено;

	РезультатПоиска.Свойство("Номенклатура", Номенклатура);
	РезультатПоиска.Свойство("ЕдиницаИзмерения", ЕдиницаИзмерения);

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось определить номенклатуру по штрихкоду/коду маркировки.");
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Номенклатура", Номенклатура);
	ПараметрыФормы.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения);

	ОткрытьФорму(
		"Обработка.спАРМРаботникаСклада.Форма.спИнформацияОТовареКарточка",
		ПараметрыФормы,
		ЭтаФорма,
		,
		,
		,
		,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Функция сп_ШтрихкодИзПараметраСканера(Параметр)

	Штрихкод = "";
	ДанныеСканера = Неопределено;

	Если ТипЗнч(Параметр) = Тип("Массив") Тогда

		Если Параметр.Количество() = 0 Тогда
			Возврат "";
		КонецЕсли;

		ДанныеСканера = Параметр[0];

	Иначе

		ДанныеСканера = Параметр;

	КонецЕсли;

	Если ДанныеСканера = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(ДанныеСканера) = Тип("Структура") Тогда

		Если ДанныеСканера.Свойство("Штрихкод") Тогда
			Штрихкод = Строка(ДанныеСканера.Штрихкод);
		ИначеЕсли ДанныеСканера.Свойство("ШтрихКод") Тогда
			Штрихкод = Строка(ДанныеСканера.ШтрихКод);
		ИначеЕсли ДанныеСканера.Свойство("Barcode") Тогда
			Штрихкод = Строка(ДанныеСканера.Barcode);
		ИначеЕсли ДанныеСканера.Свойство("Data") Тогда
			Штрихкод = Строка(ДанныеСканера.Data);
		ИначеЕсли ДанныеСканера.Свойство("Данные") Тогда
			Штрихкод = Строка(ДанныеСканера.Данные);
		ИначеЕсли ДанныеСканера.Свойство("Code") Тогда
			Штрихкод = Строка(ДанныеСканера.Code);
		ИначеЕсли ДанныеСканера.Свойство("Value") Тогда
			Штрихкод = Строка(ДанныеСканера.Value);
		КонецЕсли;

	Иначе

		Штрихкод = Строка(ДанныеСканера);

	КонецЕсли;

	Возврат сп_НормализоватьШтрихкодСканера(Штрихкод);

КонецФункции

&НаКлиенте
Функция сп_НормализоватьШтрихкодСканера(Штрихкод)

	Штрихкод = СокрЛП(Строка(Штрихкод));

	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат "";
	КонецЕсли;

	Для каждого Префикс Из СтрРазделить("]d2,]C1,]Q3,]e0", ",") Цикл

		Если Лев(Штрихкод, СтрДлина(Префикс)) = Префикс Тогда
			Штрихкод = Сред(Штрихкод, СтрДлина(Префикс) + 1);
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Штрихкод;

КонецФункции

#КонецОбласти

#Область ПоискТовара

&НаСервере
Функция сп_НайтиТоварПоШтрихкодуНаСервере(Штрихкод)

	Кандидаты = сп_КандидатыШтрихкодаИзМаркировкиНаСервере(Штрихкод);

	Если Кандидаты.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|    Штрихкоды.Номенклатура КАК Номенклатура,
	|    Штрихкоды.Характеристика КАК Характеристика,
	|    Штрихкоды.Партия КАК Партия,
	|    Штрихкоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|    Штрихкоды.Штрихкод КАК Штрихкод
	|ИЗ
	|    РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|    Штрихкоды.Штрихкод В (&Кандидаты)";

	Запрос.УстановитьПараметр("Кандидаты", Кандидаты);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Номенклатура", Выборка.Номенклатура);
	Результат.Вставить("Характеристика", Выборка.Характеристика);
	Результат.Вставить("Партия", Выборка.Партия);
	Результат.Вставить("ЕдиницаИзмерения", Выборка.ЕдиницаИзмерения);
	Результат.Вставить("Штрихкод", Выборка.Штрихкод);
	Результат.Вставить("КодМаркировки", Штрихкод);

	Возврат Результат;

КонецФункции

&НаСервере
Функция сп_КандидатыШтрихкодаИзМаркировкиНаСервере(Штрихкод)

	Результат = Новый Массив;
	Штрихкод = СокрЛП(Строка(Штрихкод));

	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат Результат;
	КонецЕсли;

	сп_ДобавитьШтрихкодКандидат(Результат, Штрихкод);

	Позиция01 = Найти(Штрихкод, "01");

	Если Позиция01 > 0 И СтрДлина(Штрихкод) >= Позиция01 + 15 Тогда

		GTIN = Сред(Штрихкод, Позиция01 + 2, 14);

		Если сп_СтрокаТолькоЦифры(GTIN) Тогда

			сп_ДобавитьШтрихкодКандидат(Результат, GTIN);

			Если Лев(GTIN, 1) = "0" Тогда
				сп_ДобавитьШтрихкодКандидат(Результат, Сред(GTIN, 2));
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура сп_ДобавитьШтрихкодКандидат(МассивКандидатов, Штрихкод)

	Штрихкод = СокрЛП(Строка(Штрихкод));

	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат;
	КонецЕсли;

	Если МассивКандидатов.Найти(Штрихкод) = Неопределено Тогда
		МассивКандидатов.Добавить(Штрихкод);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция сп_СтрокаТолькоЦифры(ЗначениеСтроки)

	ЗначениеСтроки = Строка(ЗначениеСтроки);

	Если ПустаяСтрока(ЗначениеСтроки) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для НомерСимвола = 1 По СтрДлина(ЗначениеСтроки) Цикл
		Символ = Сред(ЗначениеСтроки, НомерСимвола, 1);
		Если Найти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область ПодключаемоеОборудование

&НаСервере
Процедура сп_ПодключитьСканерШтрихкодаНаСервере()

	Попытка

		Если УправлениеНебольшойФирмойПовтИсп.ИспользоватьПодключаемоеОборудование() Тогда

			ТипыОборудования = МенеджерОборудованияКлиентСервер.ПараметрыТипыОборудования();
			ТипыОборудования.СканерШтрихкода = Истина;

			МенеджерОборудования.ПриСозданииНаСервере(ЭтотОбъект, ТипыОборудования);

		КонецЕсли;

	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура сп_ПодключитьСканерШтрихкодаНаКлиенте()

	Попытка
		МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(
			Неопределено,
			ЭтотОбъект);
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура сп_ОтключитьСканерШтрихкодаНаКлиенте()

	Попытка
		МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(
			Неопределено,
			ЭтотОбъект);
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

