&После("ОбработкаПолученияПредставления")
Процедура спОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	Если Не Данные.Ссылка.ЭтоГруппа Тогда
		СтандартнаяОбработка = Ложь;
		Шаблон = "%1, Артикул: %2, Бренд: %3";
		Представление = СтрШаблон(Шаблон, Данные.Наименование, Данные.Ссылка.Артикул, Данные.Ссылка.спБренд);
	КонецЕсли;

КонецПроцедуры 


