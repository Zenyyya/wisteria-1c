//++доработка спАРМРаботникаСклада

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)

	ПроверитьПорядокСкладов(Отказ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПорядокСкладов(Отказ)

	ПроверитьЕдиныйПорядокВТекущемНаборе(Отказ);

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ПроверитьУникальностьПорядковВТекущемНаборе(Отказ);

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ПроверитьПорядкиПоСуществующимЗаписям(Отказ);

КонецПроцедуры

Процедура ПроверитьЕдиныйПорядокВТекущемНаборе(Отказ)

	ПорядкиПоСкладам = Новый Соответствие;

	Для каждого ЗаписьРегистра Из ЭтотОбъект Цикл

		Если Не ЗначениеЗаполнено(ЗаписьРегистра.Склад) Тогда
			Продолжить;
		КонецЕсли;

		СуществующийПорядок = ПорядкиПоСкладам.Получить(ЗаписьРегистра.Склад);

		Если СуществующийПорядок = Неопределено Тогда

			ПорядкиПоСкладам.Вставить(ЗаписьРегистра.Склад, ЗаписьРегистра.ПорядокСклада);

		ИначеЕсли СуществующийПорядок <> ЗаписьРегистра.ПорядокСклада Тогда

			Отказ = Истина;

			ВызватьИсключение
				"Для склада """ + Строка(ЗаписьРегистра.Склад)
				+ """ указан разный ПорядокСклада. "
				+ "Изменяйте порядок склада через команду ""Установить порядок склада"".";

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьУникальностьПорядковВТекущемНаборе(Отказ)

	СкладыПоПорядкам = Новый Соответствие;

	Для каждого ЗаписьРегистра Из ЭтотОбъект Цикл

		Если Не ЗначениеЗаполнено(ЗаписьРегистра.Склад) Тогда
			Продолжить;
		КонецЕсли;

		КлючПорядка = Строка(ЗаписьРегистра.ПорядокСклада);
		СкладСПорядком = СкладыПоПорядкам.Получить(КлючПорядка);

		Если СкладСПорядком = Неопределено Тогда

			СкладыПоПорядкам.Вставить(КлючПорядка, ЗаписьРегистра.Склад);

		ИначеЕсли СкладСПорядком <> ЗаписьРегистра.Склад Тогда

			Отказ = Истина;

			ВызватьИсключение
				"ПорядокСклада """ + Строка(ЗаписьРегистра.ПорядокСклада)
				+ """ указан для нескольких складов: """
				+ Строка(СкладСПорядком) + """ и """
				+ Строка(ЗаписьРегистра.Склад)
				+ """. Для разных складов порядок должен быть уникальным.";

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПорядкиПоСуществующимЗаписям(Отказ)

	ТЗТекущиеЗаписи = Новый ТаблицаЗначений;
	ТЗТекущиеЗаписи.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.СтруктурныеЕдиницы"));
	ТЗТекущиеЗаписи.Колонки.Добавить("Ячейка", Новый ОписаниеТипов("СправочникСсылка.Ячейки"));
	ТЗТекущиеЗаписи.Колонки.Добавить("ПорядокСклада", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));

	Для каждого ЗаписьРегистра Из ЭтотОбъект Цикл

		Если Не ЗначениеЗаполнено(ЗаписьРегистра.Склад) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТЗТекущиеЗаписи.Добавить();
		НоваяСтрока.Склад = ЗаписьРегистра.Склад;
		НоваяСтрока.Ячейка = ЗаписьРегистра.Ячейка;
		НоваяСтрока.ПорядокСклада = ЗаписьРегистра.ПорядокСклада;

	КонецЦикла;

	Если ТЗТекущиеЗаписи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Текущие.Склад КАК Склад,
	|	Текущие.Ячейка КАК Ячейка,
	|	Текущие.ПорядокСклада КАК ПорядокСклада
	|ПОМЕСТИТЬ ВТ_Текущие
	|ИЗ
	|	&ТЗТекущиеЗаписи КАК Текущие
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Маршрут.Склад КАК Склад,
	|	Маршрут.Ячейка КАК Ячейка,
	|	Маршрут.ПорядокСклада КАК СуществующийПорядокСклада,
	|	ВТ_Текущие.ПорядокСклада КАК НовыйПорядокСклада
	|ИЗ
	|	РегистрСведений.спМаршрутКладовщика КАК Маршрут
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Текущие КАК ВТ_Текущие
	|		ПО Маршрут.Склад = ВТ_Текущие.Склад
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Текущие КАК ВТ_ТекущиеКлючи
	|		ПО Маршрут.Склад = ВТ_ТекущиеКлючи.Склад
	|			И Маршрут.Ячейка = ВТ_ТекущиеКлючи.Ячейка
	|ГДЕ
	|	ВТ_ТекущиеКлючи.Склад ЕСТЬ NULL
	|	И Маршрут.ПорядокСклада <> ВТ_Текущие.ПорядокСклада
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Маршрут.Склад КАК Склад,
	|	Маршрут.ПорядокСклада КАК ПорядокСклада,
	|	ВТ_Текущие.Склад КАК НовыйСклад
	|ИЗ
	|	РегистрСведений.спМаршрутКладовщика КАК Маршрут
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Текущие КАК ВТ_Текущие
	|		ПО Маршрут.ПорядокСклада = ВТ_Текущие.ПорядокСклада
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Текущие КАК ВТ_ТекущиеКлючи
	|		ПО Маршрут.Склад = ВТ_ТекущиеКлючи.Склад
	|			И Маршрут.Ячейка = ВТ_ТекущиеКлючи.Ячейка
	|ГДЕ
	|	Маршрут.Склад <> ВТ_Текущие.Склад
	|	И ВТ_ТекущиеКлючи.Склад ЕСТЬ NULL";

	Запрос.УстановитьПараметр("ТЗТекущиеЗаписи", ТЗТекущиеЗаписи);

	Результаты = Запрос.ВыполнитьПакет();

	ВыборкаРазныйПорядокТогоЖеСклада = Результаты[1].Выбрать();

	Если ВыборкаРазныйПорядокТогоЖеСклада.Следующий() Тогда

		Отказ = Истина;

		ВызватьИсключение
			"Для склада """ + Строка(ВыборкаРазныйПорядокТогоЖеСклада.Склад)
			+ """ уже есть строки с другим ПорядокСклада: "
			+ Строка(ВыборкаРазныйПорядокТогоЖеСклада.СуществующийПорядокСклада)
			+ ". Новый порядок: "
			+ Строка(ВыборкаРазныйПорядокТогоЖеСклада.НовыйПорядокСклада)
			+ ". Используйте команду ""Установить порядок склада"".";

	КонецЕсли;

	ВыборкаДублиПорядка = Результаты[2].Выбрать();

	Если ВыборкаДублиПорядка.Следующий() Тогда

		Отказ = Истина;

		ВызватьИсключение
			"ПорядокСклада """ + Строка(ВыборкаДублиПорядка.ПорядокСклада)
			+ """ уже используется для склада """ + Строка(ВыборкаДублиПорядка.Склад)
			+ """. Его нельзя использовать для склада """
			+ Строка(ВыборкаДублиПорядка.НовыйСклад)
			+ """.";

	КонецЕсли;

КонецПроцедуры
#КонецОбласти

//--доработка спАРМРаботникаСклада