//++доработка спАРМРаботникаСклада

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура УстановитьПорядокСклада(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите строку маршрута.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущиеДанные.Склад) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Сначала выберите склад.");
		Возврат;
	КонецЕсли;

	ТекущийПорядок = ТекущиеДанные.ПорядокСклада;

	Ответ = Ждать ВвестиЗначениеАсинх(
		ТекущийПорядок,
		"Введите порядок склада",
		Тип("Число"));

	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НовыйПорядок = Ответ;

	Установлено = УстановитьПорядокСкладаНаСервере(ТекущиеДанные.Склад, НовыйПорядок);

	// Если строка еще новая и не записана в регистр, сервер не найдет записей.
	// Тогда хотя бы текущей строке проставляем значение на форме.
	Если Не Установлено Тогда
		ТекущиеДанные.ПорядокСклада = НовыйПорядок;
	Иначе
		Элементы.Список.Обновить();
	КонецЕсли;

	ОбщегоНазначенияКлиент.СообщитьПользователю(
		"Порядок склада """ + Строка(ТекущиеДанные.Склад) + """ установлен: " + Строка(НовыйПорядок));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура СкладПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущиеДанные.Склад) Тогда
		ТекущиеДанные.Ячейка = Неопределено;
		ТекущиеДанные.ПорядокСклада = 0;
		Возврат;
	КонецЕсли;

	СуществующийПорядок = ПолучитьПорядокСкладаНаСервере(ТекущиеДанные.Склад);

	Если СуществующийПорядок <> Неопределено Тогда
		ТекущиеДанные.ПорядокСклада = СуществующийПорядок;
	КонецЕсли;

	ТекущиеДанные.Ячейка = Неопределено;

КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	// Пока ничего не делаем.
	// Оставлено на случай, если потом понадобится обновлять параметры выбора ячейки.

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьПорядокСкладаНаСервере(Склад)

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Маршрут.ПорядокСклада КАК ПорядокСклада
	|ИЗ
	|	РегистрСведений.спМаршрутКладовщика КАК Маршрут
	|ГДЕ
	|	Маршрут.Склад = &Склад";

	Запрос.УстановитьПараметр("Склад", Склад);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПорядокСклада;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция УстановитьПорядокСкладаНаСервере(Склад, НовыйПорядокСклада)

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПроверитьУникальностьПорядкаСкладаДляДругихСкладов(Склад, НовыйПорядокСклада);

	НаборЗаписей = РегистрыСведений.спМаршрутКладовщика.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Склад.Установить(Склад);
	НаборЗаписей.Прочитать();

	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для каждого ЗаписьРегистра Из НаборЗаписей Цикл
		ЗаписьРегистра.ПорядокСклада = НовыйПорядокСклада;
	КонецЦикла;

	НаборЗаписей.Записать();

	Возврат Истина;

КонецФункции

&НаСервере
Процедура ПроверитьУникальностьПорядкаСкладаДляДругихСкладов(Склад, НовыйПорядокСклада)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Маршрут.Склад КАК Склад,
	|	Маршрут.ПорядокСклада КАК ПорядокСклада
	|ИЗ
	|	РегистрСведений.спМаршрутКладовщика КАК Маршрут
	|ГДЕ
	|	Маршрут.Склад <> &Склад
	|	И Маршрут.ПорядокСклада = &ПорядокСклада";

	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ПорядокСклада", НовыйПорядокСклада);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда

		ВызватьИсключение
			"Порядок склада """ + Строка(НовыйПорядокСклада)
			+ """ уже используется для склада """ + Строка(Выборка.Склад)
			+ """. Для разных складов порядок должен быть уникальным.";

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

