#Область ОбработчикиСобытийФормы

&НаСервере
Процедура спПриСозданииНаСервереПеред(Отказ, СтандартнаяОбработка)
	
	// { Иванов С.С. (TNext) - 04.03.2025 - Задача №1000    
	Если спРаботаСЯчейкамиВызовСервера.ЕстьЯчейки(Объект.СтруктурнаяЕдиница) Тогда
		
		Объект.ПоложениеЯчейкиОтправителя = Перечисления.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти;
		УстановитьВидимостьЯчейки();
		
	КонецЕсли;
		
	Если спРаботаСЯчейкамиВызовСервера.ЕстьЯчейки(Объект.СтруктурнаяЕдиницаПолучатель) Тогда
		
		Объект.ПоложениеЯчейкиПолучателя = Перечисления.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти;
		УстановитьВидимостьЯчейкиПолучатель();
		
	КонецЕсли;
	// }
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовШапкиФормы

&НаКлиенте
Процедура спСтруктурнаяЕдиницаПриИзмененииПосле(Элемент)
	
	спВидимостьКнопкиПриемки();
	// { Иванов С.С. (TNext) - 04.03.2025 - Задача №1000
	
	//<<<--- Tnext Козык К.А. 01.07.2026
	Если НЕ спРаботаСЯчейкамиВызовСервера.ЕстьЯчейки(Объект.СтруктурнаяЕдиница) Тогда
		спОчиститьЯчейкиОтправителя();
		Возврат;
	КонецЕсли;
	//--->>> Tnext Козык К.А. 01.07.2026
	
	спЗаполнитьЯчейкиПриИзмененииЭлемента();
	Если спРаботаСЯчейкамиВызовСервера.ЕстьЯчейки(Объект.СтруктурнаяЕдиница) Тогда
		
		Объект.ПоложениеЯчейкиОтправителя = ПредопределенноеЗначение("Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти");
		УстановитьВидимостьЯчейки();
		
	КонецЕсли;;
	// }
	
КонецПроцедуры

