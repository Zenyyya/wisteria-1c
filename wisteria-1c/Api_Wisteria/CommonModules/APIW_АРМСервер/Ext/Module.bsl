//
Функция ОтветОшибкаНастройки(ТекстОшибки)

	Возврат ОтветJSON(500, Новый Структура("ok, retry, error", Ложь, Истина, ТекстОшибки));

КонецФункции

#КонецОбласти

#Область Прочее

Функция КлючАртикула(Артикул)

	Возврат ВРег(СокрЛП(Артикул));

КонецФункции

Функция УИДСтрокой(Ссылка)

	Возврат Строка(Ссылка.УникальныйИдентификатор());

КонецФункции

Функция СсылкаПоУИД(Менеджер, ТекстУИД)

	Если ТипЗнч(ТекстУИД) <> Тип("Строка") Или ПустаяСтрока(ТекстУИД) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		УИД = Новый УникальныйИдентификатор(СокрЛП(ТекстУИД));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Ссылка = Менеджер.ПолучитьСсылку(УИД);
	Если Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

Функция ЗначениеСвойства(Структура, ИмяСвойства, ЗначениеПоУмолчанию)

	Значение = Неопределено;
	Если Структура.Свойство(ИмяСвойства, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// «IL24512 р.104 молочный» - для текста ошибки продавцу.
//
Функция ПредставлениеТовара(Номенклатура)

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура,
		"Наименование, спАртикулПоставщика, спРазмер, спЦвет");

	Части = Новый Массив;
	Части.Добавить(?(ЗначениеЗаполнено(Реквизиты.спАртикулПоставщика),
		СокрЛП(Реквизиты.спАртикулПоставщика), СокрЛП(Реквизиты.Наименование)));
	Если ЗначениеЗаполнено(Реквизиты.спРазмер) Тогда
		Части.Добавить("р." + СокрЛП(Строка(Реквизиты.спРазмер)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Реквизиты.спЦвет) Тогда
		Части.Добавить(СокрЛП(Строка(Реквизиты.спЦвет)));
	КонецЕсли;

	Возврат СтрСоединить(Части, " ");

КонецФункции

// Сообщения, накопленные при проведении (типовые проверки), + краткий текст исключения.
//
Функция ТекстСообщенийИОшибки(ИнформацияОбОшибке)

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Если Не ПустаяСтрока(Сообщение.Текст) Тогда
			Тексты.Добавить(СокрЛП(Сообщение.Текст));
		КонецЕсли;
	КонецЦикла;
	Тексты.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке));

	Возврат СтрСоединить(Тексты, "; ");

КонецФункции

// Конфликт блокировок, таймаут, обрыв соединения с СУБД - повтор может помочь.
//
Функция ЭтоВременнаяОшибка(ТекстОшибки)

	Текст = НРег(ТекстОшибки);
	Возврат СтрНайти(Текст, "блокиров") > 0
		Или СтрНайти(Текст, "deadlock") > 0
		Или СтрНайти(Текст, "таймаут") > 0
		Или СтрНайти(Текст, "timeout") > 0
		Или СтрНайти(Текст, "соединени") > 0;

КонецФункции

#КонецОбласти

#КонецОбласти
