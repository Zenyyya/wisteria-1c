Функция ОтветУспех(ИдентификаторЗапроса, Номера, Повтор)

	Данные = Новый Структура;
	Данные.Вставить("ok", Истина);
	Данные.Вставить("requestId", ИдентификаторЗапроса);
	Данные.Вставить("documents", Номера);
	Данные.Вставить("duplicate", Повтор);

	Возврат ОтветJSON(200, Данные);

