// HTTP-сервис APIW_Arm (/hs/arm/v1/...) для Android-приложения «АРМ работника зала».
// Контракт: docs/API_1C.md проекта приложения.
// Модель: вариант = элемент номенклатуры (размер/цвет - реквизиты спРазмер/спЦвет),
// модель = артикул поставщика (Номенклатура.спАртикулПоставщика).
// Остаток - свободный (РС ОстаткиТоваров.Количество, типовая хранит там остаток за вычетом резерва).

#Область ПрограммныйИнтерфейс

// GET /v1/catalog - склады, модели с вариантами, ценами, штрихкодами и картинками.
// В каталог попадают модели, у которых хотя бы один вариант есть в наличии на складах АРМ.
//
Функция Каталог() Экспорт

	Настройки = НастройкиАРМ();
	Если ЗначениеЗаполнено(Настройки.Ошибка) Тогда
		Возврат ОтветОшибкаНастройки(Настройки.Ошибка);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗаполнитьВременныеТаблицыТоваровИОстатков(Запрос, Настройки);

	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.АртикулПоставщика КАК АртикулПоставщика
	|ПОМЕСТИТЬ ВТ_Модели
	|ИЗ
	|	ВТ_Товары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Остатки КАК Остатки
	|		ПО Товары.Номенклатура = Остатки.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	АртикулПоставщика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_Варианты
	|ИЗ
	|	ВТ_Товары КАК Товары
	|ГДЕ
	|	Товары.АртикулПоставщика В
	|			(ВЫБРАТЬ
	|				Модели.АртикулПоставщика
	|			ИЗ
	|				ВТ_Модели КАК Модели)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.АртикулПоставщика КАК АртикулПоставщика,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Ном.Наименование КАК Наименование,
	|	ЕСТЬNULL(Ном.спБренд.Наименование, """") КАК Бренд,
	|	ЕСТЬNULL(Ном.Родитель.Наименование, """") КАК Категория,
	|	ЕСТЬNULL(Ном.спРазмер.Наименование, """") КАК Размер,
	|	ЕСТЬNULL(Ном.спЦвет.Наименование, """") КАК Цвет,
	|	ЕСТЬNULL(Ном.спРазмер.Рост, 0) КАК РазмерРост,
	|	ЕСТЬNULL(Ном.спРазмер.Код, """") КАК РазмерКод,
	|	ЕСТЬNULL(ЦеныРозничные.Цена, 0) КАК ЦенаРозничная,
	|	ЕСТЬNULL(ЦеныАкционные.Цена, 0) КАК ЦенаАкционная
	|ИЗ
	|	ВТ_Товары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Варианты КАК Варианты
	|		ПО Товары.Номенклатура = Варианты.Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Ном
	|		ПО Товары.Номенклатура = Ном.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				&ТекущаяДата,
	|				ВидЦен = &ВидЦеныРозничная
	|					И Номенклатура В
	|						(ВЫБРАТЬ
	|							Вар.Номенклатура
	|						ИЗ
	|							ВТ_Варианты КАК Вар)) КАК ЦеныРозничные
	|		ПО Товары.Номенклатура = ЦеныРозничные.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				&ТекущаяДата,
	|				ВидЦен = &ВидЦеныАкционная
	|					И Номенклатура В
	|						(ВЫБРАТЬ
	|							Вар.Номенклатура
	|						ИЗ
	|							ВТ_Варианты КАК Вар)) КАК ЦеныАкционные
	|		ПО Товары.Номенклатура = ЦеныАкционные.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	АртикулПоставщика,
	|	РазмерРост,
	|	РазмерКод,
	|	Размер,
	|	Цвет,
	|	Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Штрихкоды.Номенклатура КАК Номенклатура,
	|	Штрихкоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Варианты КАК Варианты
	|		ПО Штрихкоды.Номенклатура = Варианты.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Штрихкод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Картинки.АртикулПоставщика КАК АртикулПоставщика,
	|	Картинки.ВнешняяСсылка КАК ВнешняяСсылка
	|ИЗ
	|	РегистрСведений.спВнешниеКартинкиТовара КАК Картинки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Модели КАК Модели
	|		ПО Картинки.АртикулПоставщика = Модели.АртикулПоставщика
	|ГДЕ
	|	Картинки.ВнешняяСсылка <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	АртикулПоставщика,
	|	ВнешняяСсылка";

	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ВидЦеныРозничная", Настройки.ВидЦеныРозничная);
	Запрос.УстановитьПараметр("ВидЦеныАкционная", Настройки.ВидЦеныАкционная);

	Результаты = Запрос.ВыполнитьПакет();
	ВыборкаВариантов  = Результаты[2].Выбрать();
	ВыборкаШтрихкодов = Результаты[3].Выбрать();
	ВыборкаКартинок   = Результаты[4].Выбрать();

	ШтрихкодыПоНоменклатуре = Новый Соответствие;
	Пока ВыборкаШтрихкодов.Следующий() Цикл
		Список = ШтрихкодыПоНоменклатуре.Получить(ВыборкаШтрихкодов.Номенклатура);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ШтрихкодыПоНоменклатуре.Вставить(ВыборкаШтрихкодов.Номенклатура, Список);
		КонецЕсли;
		Список.Добавить(СокрЛП(ВыборкаШтрихкодов.Штрихкод));
	КонецЦикла;

	КартинкиПоАртикулу = Новый Соответствие;
	Пока ВыборкаКартинок.Следующий() Цикл
		КлючМодели = КлючАртикула(ВыборкаКартинок.АртикулПоставщика);
		Список = КартинкиПоАртикулу.Получить(КлючМодели);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			КартинкиПоАртикулу.Вставить(КлючМодели, Список);
		КонецЕсли;
		Ссылка = СокрЛП(ВыборкаКартинок.ВнешняяСсылка);
		Если Список.Найти(Ссылка) = Неопределено Тогда
			Список.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;

	// Артикулы, отличающиеся только регистром/пробелами, - одна модель (СУБД их тоже не различает).
	Модели = Новый Массив;
	МоделиПоКлючу = Новый Соответствие;

	Пока ВыборкаВариантов.Следующий() Цикл

		КлючМодели = КлючАртикула(ВыборкаВариантов.АртикулПоставщика);
		ТекущаяМодель = МоделиПоКлючу.Получить(КлючМодели);
		Если ТекущаяМодель = Неопределено Тогда
			Картинки = КартинкиПоАртикулу.Получить(КлючМодели);
			ТекущаяМодель = Новый Структура;
			ТекущаяМодель.Вставить("id",       СокрЛП(ВыборкаВариантов.АртикулПоставщика));
			ТекущаяМодель.Вставить("article",  СокрЛП(ВыборкаВариантов.АртикулПоставщика));
			ТекущаяМодель.Вставить("name",     СокрЛП(ВыборкаВариантов.Наименование));
			ТекущаяМодель.Вставить("brand",    СокрЛП(ВыборкаВариантов.Бренд));
			ТекущаяМодель.Вставить("category", СокрЛП(ВыборкаВариантов.Категория));
			ТекущаяМодель.Вставить("images",   ?(Картинки = Неопределено, Новый Массив, Картинки));
			ТекущаяМодель.Вставить("variants", Новый Массив);
			Модели.Добавить(ТекущаяМодель);
			МоделиПоКлючу.Вставить(КлючМодели, ТекущаяМодель);
		КонецЕсли;

		ЦенаРозничная = ВыборкаВариантов.ЦенаРозничная;
		ЦенаАкционная = ВыборкаВариантов.ЦенаАкционная;
		Если ЦенаАкционная <= 0 Или (ЦенаРозничная > 0 И ЦенаАкционная >= ЦенаРозничная) Тогда
			ЦенаАкционная = Неопределено; // в JSON - null
		КонецЕсли;

		Штрихкоды = ШтрихкодыПоНоменклатуре.Получить(ВыборкаВариантов.Номенклатура);

		Вариант = Новый Структура;
		Вариант.Вставить("id",          УИДСтрокой(ВыборкаВариантов.Номенклатура));
		Вариант.Вставить("size",        СокрЛП(ВыборкаВариантов.Размер));
		Вариант.Вставить("color",       СокрЛП(ВыборкаВариантов.Цвет));
		Вариант.Вставить("sort",        ТекущаяМодель.variants.Количество());
		Вариант.Вставить("retailPrice", ЦенаРозничная);
		Вариант.Вставить("promoPrice",  ЦенаАкционная);
		Вариант.Вставить("barcodes",    ?(Штрихкоды = Неопределено, Новый Массив, Штрихкоды));
		ТекущаяМодель.variants.Добавить(Вариант);

	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("warehouses", СкладыДляОтвета(Настройки));
	Данные.Вставить("models", Модели);

	Возврат ОтветJSON(200, Данные);

КонецФункции

// GET /v1/stock - свободные остатки по складам АРМ, только ненулевые.
//
Функция Остатки() Экспорт

	Настройки = НастройкиАРМ();
	Если ЗначениеЗаполнено(Настройки.Ошибка) Тогда
		Возврат ОтветОшибкаНастройки(Настройки.Ошибка);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗаполнитьВременныеТаблицыТоваровИОстатков(Запрос, Настройки);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Склад КАК Склад,
	|	Остатки.Количество КАК Количество
	|ИЗ
	|	ВТ_Остатки КАК Остатки";

	Выборка = Запрос.Выполнить().Выбрать();

	Строки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		СтрокаОстатка = Новый Структура;
		СтрокаОстатка.Вставить("variantId",   УИДСтрокой(Выборка.Номенклатура));
		СтрокаОстатка.Вставить("warehouseId", УИДСтрокой(Выборка.Склад));
		СтрокаОстатка.Вставить("qty",         Выборка.Количество);
		Строки.Добавить(СтрокаОстатка);
	КонецЦикла;

	Возврат ОтветJSON(200, Новый Структура("stock", Строки));

КонецФункции

// POST /v1/transfer-orders - заказы на перемещение в торговый зал, по одному на склад-источник.
// Повтор с тем же requestId возвращает уже созданные документы (duplicate: true).
// 422 (retry: false) - ошибка в данных, повтор не поможет; 500 - временная ошибка, приложение повторит.
//
Функция СоздатьЗаказыНаПеремещение(ТелоЗапроса) Экспорт

	Настройки = НастройкиАРМ();
	Если ЗначениеЗаполнено(Настройки.Ошибка) Тогда
		Возврат ОтветОшибкаНастройки(Настройки.Ошибка);
	КонецЕсли;

	// 1. Разбор и проверка формата
	Данные = Неопределено;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
	Исключение
		Возврат ОтветОтказ("Некорректный JSON в теле запроса");
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ОтветОтказ("Некорректный JSON в теле запроса");
	КонецЕсли;

	ИдентификаторЗапроса = СокрЛП(Строка(ЗначениеСвойства(Данные, "requestId", "")));
	Если ПустаяСтрока(ИдентификаторЗапроса) Или СтрДлина(ИдентификаторЗапроса) > 36 Тогда
		Возврат ОтветОтказ("Не указан или слишком длинный requestId");
	КонецЕсли;

	// 2. Повтор того же запроса - вернуть уже созданное (даже если настройки с тех пор поменялись)
	Номера = НомераПоЗапросу(ИдентификаторЗапроса);
	Если Номера <> Неопределено Тогда
		Возврат ОтветУспех(ИдентификаторЗапроса, Номера, Истина);
	КонецЕсли;

	ИдентификаторУстройства = Лев(СокрЛП(Строка(ЗначениеСвойства(Данные, "deviceId", ""))), 36);

	Позиции = ЗначениеСвойства(Данные, "items", Неопределено);
	Если ТипЗнч(Позиции) <> Тип("Массив") Или Позиции.Количество() = 0 Тогда
		Возврат ОтветОтказ("В заказе нет позиций");
	КонецЕсли;

	СкладПолучатель = СсылкаПоУИД(Справочники.СтруктурныеЕдиницы, ЗначениеСвойства(Данные, "toWarehouseId", ""));
	Если СкладПолучатель <> Настройки.СкладТорговогоЗала Тогда
		Возврат ОтветОтказ("Склад-получатель должен быть торговым залом: " + СокрЛП(Настройки.СкладТорговогоЗала.Наименование));
	КонецЕсли;

	// 3. Позиции -> таблица (Склад, Номенклатура, Количество) с проверкой ссылок
	Ошибки = Новый Массив;
	ТаблицаПозиций = ПозицииЗаказа(Позиции, Настройки, Ошибки);
	Если Ошибки.Количество() > 0 Тогда
		Возврат ОтветОтказ(СтрСоединить(Ошибки, Символы.ПС));
	КонецЕсли;

	// 4. Создание документов в одной транзакции под блокировкой requestId
	ОшибкаВДанных = Ложь;
	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.APIW_ЗапросыАРМ");
		ЭлементБлокировки.УстановитьЗначение("RequestId", ИдентификаторЗапроса);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		Номера = НомераПоЗапросу(ИдентификаторЗапроса);
		Если Номера <> Неопределено Тогда
			ЗафиксироватьТранзакцию();
			Возврат ОтветУспех(ИдентификаторЗапроса, Номера, Истина);
		КонецЕсли;

		ПроверитьСвободныеОстатки(ТаблицаПозиций, Настройки, Ошибки);
		Если Ошибки.Количество() > 0 Тогда
			ОтменитьТранзакцию();
			Возврат ОтветОтказ(СтрСоединить(Ошибки, Символы.ПС));
		КонецЕсли;

		Номера = Новый Массив;
		СкладыИсточники = ТаблицаПозиций.Скопировать(, "Склад");
		СкладыИсточники.Свернуть("Склад");

		Для Каждого СтрокаСклада Из СкладыИсточники Цикл
			СтрокиСклада = ТаблицаПозиций.НайтиСтроки(Новый Структура("Склад", СтрокаСклада.Склад));
			ОшибкаВДанных = Истина; // ошибка проведения - в данных, повтор не поможет
			Номера.Добавить(СоздатьЗаказНаПеремещение(СтрокаСклада.Склад, СтрокиСклада, Настройки,
				ИдентификаторЗапроса, ИдентификаторУстройства));
			ОшибкаВДанных = Ложь;
		КонецЦикла;

		МенеджерЗаписи = РегистрыСведений.APIW_ЗапросыАРМ.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.RequestId  = ИдентификаторЗапроса;
		МенеджерЗаписи.Документы  = СтрСоединить(Номера, ",");
		МенеджерЗаписи.Дата       = ТекущаяДатаСеанса();
		МенеджерЗаписи.Устройство = ИдентификаторУстройства;
		МенеджерЗаписи.Записать(Истина);

		ЗафиксироватьТранзакцию();

	Исключение

		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;

		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации("APIW.АРМ.ЗаказНаПеремещение", УровеньЖурналаРегистрации.Ошибка, , ,
			"requestId " + ИдентификаторЗапроса + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));

		ТекстОшибки = ТекстСообщенийИОшибки(ИнформацияОбОшибке);
		Если ОшибкаВДанных И Не ЭтоВременнаяОшибка(ТекстОшибки) Тогда
			Возврат ОтветОтказ("Заказ не проведён: " + ТекстОшибки);
		КонецЕсли;

		Возврат ОтветJSON(500, Новый Структура("ok, retry, error", Ложь, Истина,
			"Временная ошибка 1С, заказ будет отправлен повторно: " + ТекстОшибки));

	КонецПопытки;

	Возврат ОтветУспех(ИдентификаторЗапроса, Номера, Ложь);

КонецФункции

// Ответ 500 для обработчиков сервиса при непредвиденной ошибке.
//
Функция ОтветВнутренняяОшибка(ИмяМетода, ИнформацияОбОшибке) Экспорт

	ЗаписьЖурналаРегистрации("APIW.АРМ." + ИмяМетода, УровеньЖурналаРегистрации.Ошибка, , ,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));

	Возврат ОтветJSON(500, Новый Структура("ok, retry, error", Ложь, Истина,
		"Ошибка 1С: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке)));

КонецФункции

#КонецОбласти

