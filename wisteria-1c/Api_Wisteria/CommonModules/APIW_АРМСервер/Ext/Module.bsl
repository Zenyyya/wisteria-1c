#Область Настройки

// Настройки АРМ - справочник APIW_НастройкиАРМ.Основные («Подключение АРМ работника зала»);
// организация и виды цен - общие с сайтом, из APIW_НастройкиОбменаAPI.ОсновныеНастройки.
// Склады - склад ТЗ (первым) и склады-источники из ТЧ СкладыИсточники.
//
Функция НастройкиАРМ()

	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("СкладТорговогоЗала", Справочники.СтруктурныеЕдиницы.ПустаяСсылка());
	Результат.Вставить("СкладыИсточники", Новый Массив);
	Результат.Вставить("Склады", Новый Массив);
	Результат.Вставить("СостояниеЗаказа", Неопределено);
	Результат.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Результат.Вставить("ВидЦеныРозничная", Неопределено);
	Результат.Вставить("ВидЦеныАкционная", Неопределено);

	НастройкиАРМ    = Справочники.APIW_НастройкиАРМ.Основные;
	НастройкиОбмена = Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки;

	Результат.СкладТорговогоЗала = НастройкиАРМ.СкладТорговогоЗала;
	Результат.СостояниеЗаказа    = НастройкиАРМ.СостояниеЗаказа;
	Результат.Организация        = НастройкиОбмена.ОрганизацияДляОтбора;
	Результат.ВидЦеныРозничная   = НастройкиОбмена.ВидЦеныРозничная;
	Результат.ВидЦеныАкционная   = НастройкиОбмена.ВидЦеныАкционная;

	Если Не ЗначениеЗаполнено(Результат.СкладТорговогоЗала) Тогда
		Результат.Ошибка = "АРМ не настроен: в «Подключение АРМ работника зала» не указан склад торгового зала";
		Возврат Результат;
	КонецЕсли;

	Результат.Склады.Добавить(Результат.СкладТорговогоЗала);
	Для Каждого СтрокаСклада Из НастройкиАРМ.СкладыИсточники Цикл
		Если ЗначениеЗаполнено(СтрокаСклада.Склад)
			И Результат.Склады.Найти(СтрокаСклада.Склад) = Неопределено Тогда
			Результат.Склады.Добавить(СтрокаСклада.Склад);
			Результат.СкладыИсточники.Добавить(СтрокаСклада.Склад);
		КонецЕсли;
	КонецЦикла;

	Если Результат.СкладыИсточники.Количество() = 0 Тогда
		Результат.Ошибка = "АРМ не настроен: в «Подключение АРМ работника зала» не указаны склады-источники";
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СкладыДляОтвета(Настройки)

	Склады = Новый Массив;
	Для Каждого Склад Из Настройки.Склады Цикл
		ОписаниеСклада = Новый Структура;
		ОписаниеСклада.Вставить("id",           УИДСтрокой(Склад));
		ОписаниеСклада.Вставить("name",         СокрЛП(Склад.Наименование));
		ОписаниеСклада.Вставить("isSalesFloor", Склад = Настройки.СкладТорговогоЗала);
		ОписаниеСклада.Вставить("sort",         Склады.Количество());
		Склады.Добавить(ОписаниеСклада);
	КонецЦикла;

	Возврат Склады;

КонецФункции

#КонецОбласти

#Область Запросы

// ВТ_Товары (Номенклатура, АртикулПоставщика) - товары с артикулом поставщика;
// ВТ_Остатки (Номенклатура, Склад, Количество) - свободный остаток > 0 на складах АРМ.
//
Процедура ЗаполнитьВременныеТаблицыТоваровИОстатков(Запрос, Настройки)

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ном.Ссылка КАК Номенклатура,
	|	ВЫРАЗИТЬ(Ном.спАртикулПоставщика КАК СТРОКА(100)) КАК АртикулПоставщика
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	Справочник.Номенклатура КАК Ном
	|ГДЕ
	|	НЕ Ном.ЭтоГруппа
	|	И НЕ Ном.ПометкаУдаления
	|	И Ном.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|	И ВЫРАЗИТЬ(Ном.спАртикулПоставщика КАК СТРОКА(100)) <> """"
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиТоваров.Номенклатура КАК Номенклатура,
	|	ОстаткиТоваров.СтруктурнаяЕдиница КАК Склад,
	|	СУММА(ОстаткиТоваров.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров
	|ГДЕ
	|	ОстаткиТоваров.СтруктурнаяЕдиница В (&Склады)
	|	И ОстаткиТоваров.Номенклатура В
	|			(ВЫБРАТЬ
	|				Т.Номенклатура
	|			ИЗ
	|				ВТ_Товары КАК Т)
	|	И (&ВсеОрганизации
	|			ИЛИ ОстаткиТоваров.Организация = &Организация)
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиТоваров.Номенклатура,
	|	ОстаткиТоваров.СтруктурнаяЕдиница
	|
	|ИМЕЮЩИЕ
	|	СУММА(ОстаткиТоваров.Количество) > 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура";

	Запрос.УстановитьПараметр("Склады", Настройки.Склады);
	Запрос.УстановитьПараметр("Организация", Настройки.Организация);
	Запрос.УстановитьПараметр("ВсеОрганизации", Не ЗначениеЗаполнено(Настройки.Организация));

	Запрос.Выполнить();

КонецПроцедуры

#КонецОбласти

#Область ЗаказНаПеремещение

Функция НомераПоЗапросу(ИдентификаторЗапроса)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Запросы.Документы КАК Документы
	|ИЗ
	|	РегистрСведений.APIW_ЗапросыАРМ КАК Запросы
	|ГДЕ
	|	Запросы.RequestId = &RequestId";
	Запрос.УстановитьПараметр("RequestId", ИдентификаторЗапроса);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СтрРазделить(Выборка.Документы, ",", Ложь);

КонецФункции

// Позиции из JSON -> ТаблицаЗначений (Склад, Номенклатура, Количество), одинаковые строки свёрнуты.
// Ошибки (неизвестный товар/склад, неверное количество) - в массив Ошибки.
//
Функция ПозицииЗаказа(Позиции, Настройки, Ошибки)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.СтруктурныеЕдиницы"));
	Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));

	Для Каждого Позиция Из Позиции Цикл

		Если ТипЗнч(Позиция) <> Тип("Структура") Тогда
			Ошибки.Добавить("Некорректная позиция заказа");
			Продолжить;
		КонецЕсли;

		ИдТовара = ЗначениеСвойства(Позиция, "variantId", "");
		ИдСклада = ЗначениеСвойства(Позиция, "fromWarehouseId", "");
		Количество = ЗначениеСвойства(Позиция, "qty", 0);

		Номенклатура = СсылкаПоУИД(Справочники.Номенклатура, ИдТовара);
		Если Номенклатура = Неопределено Тогда
			Ошибки.Добавить("Товар не найден в базе (id " + ИдТовара + ")");
			Продолжить;
		КонецЕсли;

		Склад = СсылкаПоУИД(Справочники.СтруктурныеЕдиницы, ИдСклада);
		Если Склад = Неопределено Или Настройки.СкладыИсточники.Найти(Склад) = Неопределено Тогда
			Ошибки.Добавить(ПредставлениеТовара(Номенклатура) + ": склад-источник не найден или не используется в АРМ");
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(Количество) <> Тип("Число") Или Количество <= 0 Или Количество <> Цел(Количество) Тогда
			Ошибки.Добавить(ПредставлениеТовара(Номенклатура) + ": количество должно быть целым больше нуля");
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Склад        = Склад;
		НоваяСтрока.Номенклатура = Номенклатура;
		НоваяСтрока.Количество   = Количество;

	КонецЦикла;

	Таблица.Свернуть("Склад, Номенклатура", "Количество");

	Если Таблица.Количество() = 0 И Ошибки.Количество() = 0 Тогда
		Ошибки.Добавить("В заказе нет позиций");
	КонецЕсли;

	Возврат Таблица;

КонецФункции

// Свободный остаток на складе-источнике должен покрывать заказанное.
//
Процедура ПроверитьСвободныеОстатки(ТаблицаПозиций, Настройки, Ошибки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Позиции.Склад КАК Склад,
	|	Позиции.Номенклатура КАК Номенклатура,
	|	Позиции.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_Позиции
	|ИЗ
	|	&Позиции КАК Позиции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Позиции.Склад КАК Склад,
	|	Позиции.Номенклатура КАК Номенклатура,
	|	Позиции.Количество КАК Количество,
	|	ЕСТЬNULL(Остатки.Количество, 0) КАК Свободно
	|ИЗ
	|	ВТ_Позиции КАК Позиции
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ОстаткиТоваров.СтруктурнаяЕдиница КАК Склад,
	|			ОстаткиТоваров.Номенклатура КАК Номенклатура,
	|			СУММА(ОстаткиТоваров.Количество) КАК Количество
	|		ИЗ
	|			РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров
	|		ГДЕ
	|			(ОстаткиТоваров.СтруктурнаяЕдиница, ОстаткиТоваров.Номенклатура) В
	|					(ВЫБРАТЬ
	|						П.Склад,
	|						П.Номенклатура
	|					ИЗ
	|						ВТ_Позиции КАК П)
	|			И (&ВсеОрганизации
	|					ИЛИ ОстаткиТоваров.Организация = &Организация)
	|
	|		СГРУППИРОВАТЬ ПО
	|			ОстаткиТоваров.СтруктурнаяЕдиница,
	|			ОстаткиТоваров.Номенклатура) КАК Остатки
	|		ПО Позиции.Склад = Остатки.Склад
	|			И Позиции.Номенклатура = Остатки.Номенклатура
	|ГДЕ
	|	ЕСТЬNULL(Остатки.Количество, 0) < Позиции.Количество";

	Запрос.УстановитьПараметр("Позиции", ТаблицаПозиций);
	Запрос.УстановитьПараметр("Организация", Настройки.Организация);
	Запрос.УстановитьПараметр("ВсеОрганизации", Не ЗначениеЗаполнено(Настройки.Организация));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ошибки.Добавить(СтрШаблон("Не хватает: %1 на складе «%2» - заказано %3, свободно %4",
			ПредставлениеТовара(Выборка.Номенклатура), СокрЛП(Выборка.Склад.Наименование),
			Формат(Выборка.Количество, "ЧГ=0; ЧН=0"), Формат(Выборка.Свободно, "ЧГ=0; ЧН=0")));
	КонецЦикла;

КонецПроцедуры

// Создаёт и проводит заказ на перемещение со склада-источника в торговый зал. Возвращает номер.
//
Функция СоздатьЗаказНаПеремещение(СкладИсточник, СтрокиПозиций, Настройки, ИдентификаторЗапроса, ИдентификаторУстройства)

	Документ = Документы.ЗаказНаПеремещение.СоздатьДокумент();
	Документ.Заполнить(Неопределено);

	Документ.Дата                         = ТекущаяДатаСеанса();
	Документ.ДатаПеремещения              = НачалоДня(ТекущаяДатаСеанса());
	Документ.Организация                  = ?(ЗначениеЗаполнено(Настройки.Организация), Настройки.Организация,
		?(ЗначениеЗаполнено(Документ.Организация), Документ.Организация, Справочники.Организации.ОрганизацияПоУмолчанию()));
	Документ.СтруктурнаяЕдиницаРезерв     = СкладИсточник;
	Документ.СтруктурнаяЕдиницаПолучатель = Настройки.СкладТорговогоЗала;
	Если ЗначениеЗаполнено(Настройки.СостояниеЗаказа) Тогда
		Документ.СостояниеЗаказа = Настройки.СостояниеЗаказа;
	КонецЕсли;
	Документ.Комментарий = СтрШаблон("АРМ работника зала, устройство %1, запрос %2",
		ИдентификаторУстройства, ИдентификаторЗапроса);

	Документ.Запасы.Очистить();
	Для Каждого Позиция Из СтрокиПозиций Цикл
		НоваяСтрока = Документ.Запасы.Добавить();
		НоваяСтрока.Номенклатура     = Позиция.Номенклатура;
		НоваяСтрока.Количество       = Позиция.Количество;
		НоваяСтрока.ЕдиницаИзмерения = Позиция.Номенклатура.ЕдиницаИзмерения;
	КонецЦикла;

	Документ.Записать(РежимЗаписиДокумента.Проведение);

	Возврат СокрЛП(Документ.Номер);

КонецФункции

