// Имя базы в сообщениях. В каждой базе своё значение: "ВИСТЕРИЯ" или "АННА-ЛЕОН".
// -----------------------------------------------------------------------------
Функция ПолучитьИмяБазы()
	
	Возврат "ВИСТЕРИЯ";
	
КонецФункции

// Управление отправкой сообщений: Истина - отправлять, Ложь - не отправлять.
// Отдельно для POST и GET. Контекст запроса и замер времени работают всегда.
// -----------------------------------------------------------------------------
Функция ПолучитьПараметрыУведомлений()
	
	POST = Новый Структура;
	POST.Вставить("ЗапросПоступил", Истина);   // сообщение 1
	POST.Вставить("ЗапросОтданСайту", Истина); // сообщение 2
	POST.Вставить("Ошибка", Истина);           // сообщение 3
	
	GET = Новый Структура;
	GET.Вставить("ЗапросПоступил", Истина);    // сообщение 1
	GET.Вставить("ЗапросОтданСайту", Истина);  // сообщение 2
	GET.Вставить("Ошибка", Истина);            // сообщение 3
	
	Возврат Новый Структура("POST, GET", POST, GET);
	
КонецФункции

// Включена ли отправка сообщения данного вида для метода запроса
// -----------------------------------------------------------------------------
Функция УведомлениеВключено(Контекст, ВидСообщения)
	
	Параметры = ПолучитьПараметрыУведомлений();
	Флаги     = ?(Контекст.Метод = "GET", Параметры.GET, Параметры.POST);
	
	Возврат Флаги[ВидСообщения];
	
КонецФункции

// Названия сообщений и признак успешного ответа по смыслу запроса.
// Для запросов, которых здесь нет (GET), используются общие названия.
// -----------------------------------------------------------------------------
Функция ПолучитьОписаниеОперации(ИмяОперации)
	
	Описание = Новый Структура("Поступил, Завершен, Замечание, Ошибка, ПризнакУспеха, ЕстьНомерЗаказа");
	
	Если ИмяОперации = "Заказ с сайта" Тогда
		
		Описание.Поступил        = " Заказ поступил";
		Описание.Завершен        = "✅ Заказ создан";
		Описание.Замечание       = "⚠️ Заказ не создан";
		Описание.Ошибка          = "❌ Заказ не создан (ошибка)";
		Описание.ПризнакУспеха   = "Заказ успешно создан";
		Описание.ЕстьНомерЗаказа = Истина;
		
	ИначеЕсли ИмяОперации = "Трек-номер заказа" Тогда
		
		Описание.Поступил        = " Трек-номер поступил";
		Описание.Завершен        = "✅ Трек-номер записан";
		Описание.Замечание       = "⚠️ Трек-номер не записан";
		Описание.Ошибка          = "❌ Трек-номер не записан (ошибка)";
		Описание.ПризнакУспеха   = "Даные успешно записаны в заказ";
		Описание.ЕстьНомерЗаказа = Истина;
		
	ИначеЕсли ИмяОперации = "Оплата заказа" Тогда
		
		Описание.Поступил        = " Оплата поступила";
		Описание.Завершен        = "✅ Оплата оформлена";
		Описание.Замечание       = "⚠️ Оплата не оформлена";
		Описание.Ошибка          = "❌ Оплата не оформлена (ошибка)";
		Описание.ПризнакУспеха   = "Данные успешно обновлены";
		Описание.ЕстьНомерЗаказа = Истина;
		
	ИначеЕсли ИмяОперации = "Данные клиента" Тогда
		
		Описание.Поступил        = " Данные клиента поступили";
		Описание.Завершен        = "✅ Данные клиента обновлены";
		Описание.Замечание       = "⚠️ Данные клиента не обновлены";
		Описание.Ошибка          = "❌ Данные клиента не обновлены (ошибка)";
		Описание.ПризнакУспеха   = "Данные успешно обновлены";
		Описание.ЕстьНомерЗаказа = Ложь;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

// Сообщение 1: запрос поступил. Возвращает контекст для сообщений о результате.
// ТелоЗапроса - тело запроса строкой (для POST; для GET не передаётся).
// -----------------------------------------------------------------------------
Функция УведомитьОНачалеЗапроса(Запрос, ИмяОперации, ТелоЗапроса = Неопределено) Экспорт
	
	Попытка
		
		Контекст = Новый Структура;
		Контекст.Вставить("Операция", ИмяОперации);
		Контекст.Вставить("Метод", Запрос.HTTPМетод);
		Контекст.Вставить("Адрес", Запрос.HTTPМетод + " " + Запрос.ОтносительныйURL);
		Контекст.Вставить("Параметры", ПолучитьПараметрыЗапросаТекстом(Запрос));
		Контекст.Вставить("Тело", ?(ТелоЗапроса = Неопределено, "", ТелоЗапроса));
		Контекст.Вставить("Начало", ТекущаяУниверсальнаяДатаВМиллисекундах());
		Контекст.Вставить("Описание", ПолучитьОписаниеОперации(ИмяОперации));
		Контекст.Вставить("НомераЗаказов", "");
		
		Если Контекст.Описание <> Неопределено И Контекст.Описание.ЕстьНомерЗаказа Тогда
			Контекст.НомераЗаказов = ПолучитьНомераЗаказовИзТела(Контекст.Тело);
		КонецЕсли;
		
		Если УведомлениеВключено(Контекст, "ЗапросПоступил") Тогда
			
			Если Контекст.Описание = Неопределено Тогда
				Заголовок = " Запрос поступил";
			Иначе
				Заголовок = Контекст.Описание.Поступил;
			КонецЕсли;
			
			Текст = ПолучитьЗаголовокУведомления(Заголовок, Контекст);
			
			Если Не ПустаяСтрока(Контекст.Тело) Тогда
				Текст = Текст + Символы.ПС + "Тело запроса: " + СтрДлина(Контекст.Тело) + " симв.";
			КонецЕсли;
			
			ОтправитьВТелеграм(Текст);
			
		КонецЕсли;
		
		Возврат Контекст;
		
	Исключение
		Возврат Новый Структура("Выключено", Истина);
	КонецПопытки;
	
КонецФункции

// Сообщение 2: запрос отдан сайту, с временем выполнения.
// Если ответ не совпадает с признаком успеха - заголовок с замечанием.
// Результат - ответ для POST или размер ответа для GET.
// -----------------------------------------------------------------------------
Процедура УведомитьОбУспешномЗапросе(Контекст, Результат = "") Экспорт
	
	Попытка
		
		Если Контекст.Свойство("Выключено") Тогда
			Возврат;
		КонецЕсли;
		
		Если Не УведомлениеВключено(Контекст, "ЗапросОтданСайту") Тогда
			Возврат;
		КонецЕсли;
		
		Если Контекст.Описание = Неопределено Тогда
			Заголовок = "✅ Запрос отдан сайту";
		ИначеЕсли СтрНачинаетсяС(Строка(Результат), Контекст.Описание.ПризнакУспеха) Тогда
			Заголовок = Контекст.Описание.Завершен;
		Иначе
			Заголовок = Контекст.Описание.Замечание;
		КонецЕсли;
		
		Текст = ПолучитьЗаголовокУведомления(Заголовок, Контекст) + Символы.ПС
			+ "Время выполнения: " + ПолучитьВремяВыполнения(Контекст);
		
		Если Не ПустаяСтрока(Результат) Тогда
			Текст = Текст + Символы.ПС + "Результат: " + ЭкранироватьHTML(ОбрезатьТекст(Результат, 500));
		КонецЕсли;
		
		ОтправитьВТелеграм(Текст);
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры

// Сообщение 3 (вместо сообщения 2): запрос не отдан, ошибка.
// Передаёт запрос, входящие данные (тело для POST) и текст ошибки.
// ТекстОшибки - ОписаниеОшибки() из блока Исключение.
// -----------------------------------------------------------------------------
Процедура УведомитьОбОшибкеЗапроса(Контекст, ТекстОшибки) Экспорт
	
	Попытка
		
		Если Контекст.Свойство("Выключено") Тогда
			Возврат;
		КонецЕсли;
		
		Если Не УведомлениеВключено(Контекст, "Ошибка") Тогда
			Возврат;
		КонецЕсли;
		
		Если Контекст.Описание = Неопределено Тогда
			Заголовок = "❌ Ошибка, запрос не отдан сайту";
		Иначе
			Заголовок = Контекст.Описание.Ошибка;
		КонецЕсли;
		
		Текст = ПолучитьЗаголовокУведомления(Заголовок, Контекст) + Символы.ПС
			+ "Время до ошибки: " + ПолучитьВремяВыполнения(Контекст) + Символы.ПС
			+ "Ошибка:" + Символы.ПС
			+ "<pre>" + ЭкранироватьHTML(ОбрезатьТекст(ТекстОшибки, 1000)) + "</pre>";
		
		Если Не ПустаяСтрока(Контекст.Тело) Тогда
			Текст = Текст + Символы.ПС + "Входящие данные:" + Символы.ПС
				+ "<pre>" + ЭкранироватьHTML(ОбрезатьТекст(Контекст.Тело, 1800)) + "</pre>";
		КонецЕсли;
		
		ОтправитьВТелеграм(Текст);
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры

// Общая шапка сообщения: база, операция, запрос, номер заказа, параметры, время
// -----------------------------------------------------------------------------
Функция ПолучитьЗаголовокУведомления(Заголовок, Контекст)
	
	Текст = "<b>[" + ЭкранироватьHTML(ПолучитьИмяБазы()) + "]</b> " + Заголовок + Символы.ПС
		+ "Операция: <b>" + ЭкранироватьHTML(Контекст.Операция) + "</b>" + Символы.ПС
		+ "Запрос: <code>" + ЭкранироватьHTML(Контекст.Адрес) + "</code>";
	
	Если Не ПустаяСтрока(Контекст.НомераЗаказов) Тогда
		Текст = Текст + Символы.ПС + "Номер заказа: <b>" + ЭкранироватьHTML(Контекст.НомераЗаказов) + "</b>";
	КонецЕсли;
	
	Если Не ПустаяСтрока(Контекст.Параметры) Тогда
		Текст = Текст + Символы.ПС + "Параметры:" + Символы.ПС
			+ "<pre>" + ЭкранироватьHTML(ОбрезатьТекст(Контекст.Параметры, 600)) + "</pre>";
	КонецЕсли;
	
	Возврат Текст + Символы.ПС + "Время: " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy ЧЧ:мм:сс");
	
КонецФункции

// Номера заказов (поле number) из тела POST-запроса: через запятую,
// первые 10, остальные - "и ещё N". Пустая строка, если не удалось прочитать.
// -----------------------------------------------------------------------------
Функция ПолучитьНомераЗаказовИзТела(ТелоЗапроса)
	
	Если ПустаяСтрока(ТелоЗапроса) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		
		Если ТипЗнч(Данные) = Тип("Массив") Тогда
			Элементы = Данные;
		Иначе
			Элементы = Новый Массив;
			Элементы.Добавить(Данные);
		КонецЕсли;
		
		Номера = Новый Массив;
		Для каждого Элемент Из Элементы Цикл
			Номер = Неопределено;
			Если ТипЗнч(Элемент) = Тип("Структура") Тогда
				Если Элемент.Свойство("number", Номер) И Номер <> Неопределено Тогда
					Номера.Добавить(Строка(Номер));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Лишних = Номера.Количество() - 10;
		Если Лишних > 0 Тогда
			Для Сч = 1 По Лишних Цикл
				Номера.Удалить(10);
			КонецЦикла;
			Возврат СтрСоединить(Номера, ", ") + " и ещё " + Лишних;
		КонецЕсли;
		
		Возврат СтрСоединить(Номера, ", ");
		
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции
// Параметры запроса отдельными строками "ключ = значение"
// -----------------------------------------------------------------------------
Функция ПолучитьПараметрыЗапросаТекстом(Запрос)
	
	Результат = "";
	
	Для каждого КлючИЗначение Из Запрос.ПараметрыURL Цикл
		Результат = Результат + ?(Результат = "", "", Символы.ПС) + КлючИЗначение.Ключ + " = " + Строка(КлючИЗначение.Значение);
	КонецЦикла;
	
	Для каждого КлючИЗначение Из Запрос.ПараметрыЗапроса Цикл
		Результат = Результат + ?(Результат = "", "", Символы.ПС) + КлючИЗначение.Ключ + " = " + Строка(КлючИЗначение.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Время от получения запроса до текущего момента, секунды
// -----------------------------------------------------------------------------
Функция ПолучитьВремяВыполнения(Контекст)
	
	Возврат Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - Контекст.Начало) / 1000, "ЧДЦ=2; ЧН=0; ЧГ=0") + " с";
	
КонецФункции

// Отправка текста в Telegram. Сразу, таймаут 5 секунд.
// Ошибки отправки подавляются: уведомление не должно мешать обработке запроса.
// -----------------------------------------------------------------------------
Процедура ОтправитьВТелеграм(Текст)
	
	ТокенБота         = "8815391951:AAFN9cyEd6Krlnsxqmbhk-uUlSOo3lPKwtY";  // бот wisteria_apiw_bot
	ИдентификаторЧата = "-5593431148";        // чат "Мониторинг обмена api"
	
	Попытка
		
		Тело = Новый Структура;
		Тело.Вставить("chat_id", ИдентификаторЧата);
		
		// Слишком длинное сообщение отправляем простым текстом без разметки
		Если СтрДлина(Текст) > 4000 Тогда
			Тело.Вставить("text", Лев(Текст, 4000));
		Иначе
			Тело.Вставить("text", Текст);
			Тело.Вставить("parse_mode", "HTML");
		КонецЕсли;
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Тело);
		ТелоЗапроса = ЗаписьJSON.Закрыть();
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json");
		
		Соединение = Новый HTTPСоединение("api.telegram.org", , , , , 5, Новый ЗащищенноеСоединениеOpenSSL());
		Запрос     = Новый HTTPЗапрос("/bot" + ТокенБота + "/sendMessage", Заголовки);
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		
		Соединение.ОтправитьДляОбработки(Запрос);
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры

// Экранирует символы, которые Telegram считает разметкой HTML
Функция ЭкранироватьHTML(Знач Текст)
	
	Результат = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	
	Возврат Результат;
	
КонецФункции

Функция ОбрезатьТекст(Знач Текст, Длина)
	
	Текст = Строка(Текст);
	
	Если СтрДлина(Текст) <= Длина Тогда
		Возврат Текст;
	КонецЕсли;
	
	Возврат Лев(Текст, Длина) + "... (обрезано, всего " + СтрДлина(Текст) + " симв.)";
	
КонецФункции

#КонецОбласти
