Функция ПостроитьУзел(СтрокаГруппы, ДетиПоРодителю)
  
  Узел = Новый Соответствие;
  Узел.Вставить("Наименование", СтрокаГруппы.Наименование);
  Узел.Вставить("УИД",          Строка(СтрокаГруппы.Ссылка.УникальныйИдентификатор()));
  
  // Рекурсивно собираем детей
  МассивДетей = Новый Массив;
  ПрямыеДети  = ДетиПоРодителю.Получить(СтрокаГруппы.Ссылка);
  
  Если ПрямыеДети <> Неопределено Тогда
    Для Каждого Ребёнок Из ПрямыеДети Цикл
      МассивДетей.Добавить(ПостроитьУзел(Ребёнок, ДетиПоРодителю));
    КонецЦикла;
  КонецЕсли;
  
  Узел.Вставить("ДочерниеКатегории", МассивДетей);
  
  Возврат Узел;
  
