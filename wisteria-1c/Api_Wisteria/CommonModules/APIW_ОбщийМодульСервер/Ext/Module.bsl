Функция СоздатьЗаказПокупателя(СтруктураДанных, КонтрагентСсылка)
    
    ОрганизацияДляДок = Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.ОрганизацияДляОтбора;
    
    НовыйДокумент = Документы.ЗаказПокупателя.СоздатьДокумент();  
    НовыйДокумент.Номер             	    = СтруктураДанных.number;
	НовыйДокумент.СтруктурнаяЕдиницаРезерв  = ПолучитьСкладИнтернетМагазина(); 
    НовыйДокумент.АдресДоставки     	    = СтруктураДанных.counterparty_index + 
	"," + СтруктураДанных.counterparty_country + ", " + СтруктураДанных.counterparty_region + ", " + 
	СтруктураДанных.counterparty_city + ", " + СтруктураДанных.counterparty_street + ", " + 
	СтруктураДанных.counterparty_house_number + ", " + СтруктураДанных.counterparty_building;
    НовыйДокумент.СпособДоставки    		= ПолучитьПеречислениеСпособыДоставки(СтруктураДанных.delivery_method);
    НовыйДокумент.СлужбаДоставки    		= ?(Не СтруктураДанных.delivery_services = "", Справочники.СлужбыДоставки.НайтиПоНаименованию(СтруктураДанных.delivery_services), Справочники.СлужбыДоставки.ПустаяСсылка());
    НовыйДокумент.СтоимостьДоставки 		= Число(СтруктураДанных.cost_delivery);
    НовыйДокумент.ВремяДоставкиС    		= Дата(СтруктураДанных.time_delivery_s);
    НовыйДокумент.ВремяДоставкиПо  	 		= Дата(СтруктураДанных.time_delivery_po);
    НовыйДокумент.Комментарий       		= "Загружен автоматически с сайта " + ТекущаяДата() + Символы.ПС + СтруктураДанных.comment;
    НовыйДокумент.Контрагент       	 		= КонтрагентСсылка;
    НовыйДокумент.Дата             	 		= ТекущаяДата();
    НовыйДокумент.Организация       		= ОрганизацияДляДок; 
    НовыйДокумент.ДатаОтгрузки      		= ТекущаяДата();
    НовыйДокумент.СостояниеЗаказа   		= Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.СостояниеНовогоЗаказа; 
	НовыйДокумент.НоменклатураДоставки  	= Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.НоменклатураДоставки; 
	НовыйДокумент.ОжидаемаяДатаВручения 	= СтруктураДанных.expected_delivery_date;
    НовыйДокумент.Заполнить(Неопределено);
    
	СтавкаДоставки = ПолучитьСтавкуНДС(НовыйДокумент.НоменклатураДоставки.ВидСтавкиНДС);
	
	НовыйДокумент.СтавкаНДСДоставки = СтавкаДоставки.Ссылка;
	НовыйДокумент.СуммаНДСДоставки  = УчетНДСКлиентСервер.РассчитатьСуммуНДС(НовыйДокумент.СтоимостьДоставки, Истина, СтавкаДоставки.Ставка);
    
	Для каждого Строка Из СтруктураДанных.tovar Цикл
		
		Попытка
        	СсылкаНаТовар = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.product_id));
		Исключение
			Возврат  "Не корректный УИД товара: " + Строка.product_id;
		КонецПопытки;
		
        СтавкаНДС     = ПолучитьСтавкуНДС(СсылкаНаТовар.ВидСтавкиНДС);
        
        Сумма = Строка.quantity * Строка.price - Строка.discount_amount;
        
        ТоварыДок                       = НовыйДокумент.Запасы.Добавить();
		ТоварыДок.ТипНоменклатурыЗапас  = Истина;
        ТоварыДок.Номенклатура          = СсылкаНаТовар;  
        ТоварыДок.Количество            = Строка.quantity;
        ТоварыДок.Цена                  = Строка.price;
        ТоварыДок.ЕдиницаИзмерения      = СсылкаНаТовар.ЕдиницаИзмерения;
        ТоварыДок.Сумма                 = Сумма;
        ТоварыДок.СтавкаНДС             = СтавкаНДС.Ссылка;
        ТоварыДок.СуммаСкидкиНаценки    = Строка.discount_amount;
		ТоварыДок.ПроцентСкидкиНаценки  = Строка.discount_amount / (Строка.quantity * Строка.price) * 100;
        ТоварыДок.СуммаНДС              = УчетНДСКлиентСервер.РассчитатьСуммуНДС(Сумма, Истина, СтавкаНДС.Ставка);
		ТоварыДок.Всего                 = Сумма; 
		ТоварыДок.Резерв                = Строка.quantity;
		
    КонецЦикла; 
    
    // === Пересчёт итогов по документу ===
    НовыйДокумент.СуммаДокумента = НовыйДокумент.Запасы.Итог("Сумма") + НовыйДокумент.СтоимостьДоставки;
    Попытка
        НовыйДокумент.Записать();
    Исключение  
        Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
	
	Возврат НовыйДокумент.Ссылка;
	
КонецФункции

Функция ПолучитьСтавкуНДС(ВидСтавкиНДС)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтавкиНДС.Ссылка КАК Ссылка,
		|	СтавкиНДС.ВерсияДанных КАК ВерсияДанных,
		|	СтавкиНДС.ПометкаУдаления КАК ПометкаУдаления,
		|	СтавкиНДС.Наименование КАК Наименование,
		|	СтавкиНДС.Ставка КАК Ставка,
		|	СтавкиНДС.НеОблагается КАК НеОблагается,
		|	СтавкиНДС.Расчетная КАК Расчетная,
		|	СтавкиНДС.ВидСтавкиНДС КАК ВидСтавкиНДС,
		|	СтавкиНДС.ПеречислениеСтавкаНДС КАК ПеречислениеСтавкаНДС,
		|	СтавкиНДС.Предопределенный КАК Предопределенный,
		|	СтавкиНДС.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
		|	СтавкиНДС.Представление КАК Представление
		|ИЗ
		|	Справочник.СтавкиНДС КАК СтавкиНДС
		|ГДЕ
		|	СтавкиНДС.ВидСтавкиНДС = &ВидСтавкиНДС
		|	И (НЕ &ВидСтавкиНДС В (ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.Общая), ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.ОбщаяРасчетная))
		|			ИЛИ СтавкиНДС.Ставка = ВЫБОР
		|				КОГДА &ТекущаяДата >= ДАТАВРЕМЯ(2026, 1, 1)
		|					ТОГДА 22
		|				КОГДА &ТекущаяДата >= ДАТАВРЕМЯ(2019, 1, 1)
		|					ТОГДА 20
		|				ИНАЧЕ 18
		|			КОНЕЦ)";
	
	Запрос.УстановитьПараметр("ВидСтавкиНДС", ВидСтавкиНДС);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		Стр = Новый Структура;
		Стр.Вставить("Ставка", ВыборкаДетальныеЗаписи.Ставка);
		Стр.Вставить("Ссылка", ВыборкаДетальныеЗаписи.Ссылка);
		Возврат Стр; 
	КонецЦикла;
	
КонецФункции 

Функция ПолучитьПеречислениеСпособыДоставки(СпособДоставки)

	Если СпособДоставки = "Самовывоз" Тогда
		Пер = Перечисления.СпособыДоставки.Самовывоз;
	ИначеЕсли СпособДоставки = "Пункт выдачи" Тогда
		Пер = Перечисления.СпособыДоставки.ПунктВыдачи;
	ИначеЕсли СпособДоставки = "Курьер" Тогда
		Пер = Перечисления.СпособыДоставки.Курьер;
	ИначеЕсли СпособДоставки = "Почта" Тогда
		Пер = Перечисления.СпособыДоставки.Почта;
	КонецЕсли;
	
	Возврат Пер;
	
КонецФункции 

