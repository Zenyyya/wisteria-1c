Функция ОбновитьДанныеКлиента(СтруктураДанных) Экспорт 
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(СтруктураДанных);
	МассивJSON = ПрочитатьJSON(ЧтениеJSON);
	
	Для каждого Строка Из МассивJSON Цикл
	
		Результат = НайтиПокупателя(Строка.counterparty_pfone);
		Если Не Результат = Ложь Тогда
        	СсылкаПокупатель = СоздатьОбновитьПокупателя(Строка, Ложь);
			ДобавитьКонтактыКонтрагенту(Строка, СсылкаПокупатель);
		Иначе 
			Возврат "Не найден покупатель по номеру: " + Строка.counterparty_pfone;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "Данные успешно обновлены";
	
КонецФункции 

Функция ДобавитьДокументОплаты(СтруктураДанных) Экспорт
	
	Если Не Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.СоздаватьДокументОплаты Тогда
		Возврат "Создание документов оплаты отключено в настройках";
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(СтруктураДанных);
	МассивJSON = ПрочитатьJSON(ЧтениеJSON);

	Для каждого Строка Из МассивJSON Цикл
		СсылкаЗаказ = НайтиЗаказ(Строка.number);	
		Если Не СсылкаЗаказ = Ложь Тогда   
			ЗначениеIdPay = Неопределено;
			ЕстьСвойство = Строка.Свойство("idpay", ЗначениеIdPay);
			Если ЕстьСвойство И Не ЗначениеIdPay = Неопределено И Не ЗначениеIdPay =  "" Тогда
				СоздатьОперациюПоПлатежнымКартам(СсылкаЗаказ, Строка.idpay);
			Иначе
				СоздатьОперациюПоПлатежнымКартам(СсылкаЗаказ, Ложь);
			КонецЕсли;				
		КонецЕсли;
	КонецЦикла;
	
	Возврат "Данные успешно обновлены";

КонецФункции



