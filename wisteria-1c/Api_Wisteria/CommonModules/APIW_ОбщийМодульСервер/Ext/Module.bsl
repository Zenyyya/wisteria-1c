Функция ЗагрузитьЗаказJSON(СтрокаJSON) Экспорт 
	
	Если Не Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.ЗагружатьЗаказы Тогда
		Возврат "Загрузка заказов отключена в настройках";
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);

	НоменклатураМассив = ПрочитатьJSON(ЧтениеJSON);
	Для Каждого СтрокаМассива Из НоменклатураМассив Цикл
		НайтиДок = НайтиЗаказ(СтрокаМассива.Number);
		Если НайтиДок = Ложь Тогда //СоздатьНовыйДок
			ЕстьКлиент = ПроверитьПокупателя(СтрокаМассива.counterparty_pfone); 
			Если ЕстьКлиент = Ложь Тогда //Создать нового клиента 
				ЕстьКлиент = СоздатьОбновитьПокупателя(СтрокаМассива, Истина);
			Иначе
				КлиентДляДокумента = ЕстьКлиент;
				ДобавитьКонтактыКонтрагенту(СтрокаМассива, ЕстьКлиент);
			КонецЕсли;
			СсылкаНаНовыйЗаказ = СоздатьЗаказПокупателя(СтрокаМассива, ЕстьКлиент);

			ПодготовитьРезервТоваров(СсылкаНаНовыйЗаказ); 
			
			Возврат "Заказ успешно создан в 1С";	
		Иначе 
			Возврат "Заказ уже создан в 1С";
		КонецЕсли;	 		
	КонецЦикла;

КонецФункции 

Функция ДобавитьТрекНомерВЗаказ(ТрекНомерJSON) Экспорт 
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ТрекНомерJSON);
	МассивJSON = ПрочитатьJSON(ЧтениеJSON);
	
	Для каждого Строка Из МассивJSON Цикл
		
		ЗаказНайден = НайтиЗаказ(Строка.number);
		Если Не ЗаказНайден = Ложь Тогда
			ОбъектЗаказ = ЗаказНайден.ПолучитьОбъект();
			ОбъектЗаказ.ТрекНомер = Строка.trak_number; 
						
			Попытка
				ОбъектЗаказ.Записать();
			Исключение
				Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			
		Иначе
			Возврат "Заказ: " + Строка.number + " не найден в 1С";
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат "Даные успешно записаны в заказ: " + Строка.number; 
	
КонецФункции 

