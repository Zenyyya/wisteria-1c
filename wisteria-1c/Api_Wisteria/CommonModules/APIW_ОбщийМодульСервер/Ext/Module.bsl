Функция ПолучитьНоменклатуруБезДоп() Экспорт
    
    
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(СпрНоменклатура.Ссылка) КАК ТоварИД,
        |	СпрНоменклатура.Наименование КАК Наименование,
        |	СпрНоменклатура.Артикул КАК Артикул,
        |	СпрНоменклатура.Код КАК Код,
        |	СпрНоменклатура.Штрихкод КАК Штрихкод,
        |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(СпрНоменклатура.Родитель) КАК Категория,
        |	СпрНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
        |	СпрНоменклатура.Комментарий КАК Комментарий,
        |	СпрНоменклатура.СтранаПроисхождения КАК СтранаПроисхождения,
        |	СпрНоменклатура.Вес КАК Вес,
        |	СпрНоменклатура.Высота КАК Высота,
        |	СпрНоменклатура.ГарантийныйСрок КАК ГарантийныйСрок,
        |	СпрНоменклатура.ДатаИзменения КАК ДатаИзменения,
        |	СпрНоменклатура.Длина КАК Длина,
        |	СпрНоменклатура.НаименованиеПолное КАК НаименованиеПолное,
        |	СпрНоменклатура.Поставщик КАК Поставщик,
        |	СпрНоменклатура.Производитель КАК Производитель,
        |	СпрНоменклатура.Склад КАК Склад,
        |	СпрНоменклатура.Ячейка КАК Ячейка,
        |	СпрНоменклатура.Ширина КАК Ширина,
        |	СпрНоменклатура.спРазмер КАК спРазмер,
        |	СпрНоменклатура.спЦвет КАК спЦвет,
        |	СпрНоменклатура.спБренд КАК спБренд,
        |	ЕСТЬNULL(ЦеныРозничные.Цена, 0) КАК РозничнаяЦена,
        |	ЕСТЬNULL(ЦеныАкционные.Цена, 0) КАК АкционнаяЦена,
        |	ЕСТЬNULL(СтавкиНДС.Ставка, 0) КАК СтавкаНДС
        |ИЗ
        |	Справочник.Номенклатура КАК СпрНоменклатура
        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ТекущаяДата, ВидЦен = &ВидЦеныРозничная) КАК ЦеныРозничные
        |		ПО СпрНоменклатура.Ссылка = ЦеныРозничные.Номенклатура
        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ТекущаяДата, ВидЦен = &ВидЦеныАкционная) КАК ЦеныАкционные
        |		ПО СпрНоменклатура.Ссылка = ЦеныАкционные.Номенклатура
        |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтавкиНДС КАК СтавкиНДС
        |		ПО СпрНоменклатура.ВидСтавкиНДС = СтавкиНДС.ВидСтавкиНДС
        |			И (НЕ СпрНоменклатура.ВидСтавкиНДС В (ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.Общая), ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.ОбщаяРасчетная))
        |				ИЛИ СтавкиНДС.Ставка = ВЫБОР
        |					КОГДА &ТекущаяДата >= ДАТАВРЕМЯ(2026, 1, 1)
        |						ТОГДА 22
        |					КОГДА &ТекущаяДата >= ДАТАВРЕМЯ(2019, 1, 1)
        |						ТОГДА 20
        |					ИНАЧЕ 18
        |				КОНЕЦ)
        |ГДЕ
        |	НЕ СпрНоменклатура.ПометкаУдаления";
    
    Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата()); 
	Запрос.УстановитьПараметр("ВидЦеныАкционная", Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.ВидЦеныАкционная);
	Запрос.УстановитьПараметр("ВидЦеныРозничная", Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.ВидЦеныРозничная);
     
    РезультатЗапроса = Запрос.Выполнить();
    ТаблицаНом = РезультатЗапроса.Выгрузить();
    ОтветМассив = Новый Массив;
    Для каждого СтрокаТаблицы из ТаблицаНом Цикл
        СтруктураЗначВСтроку = Новый Структура;
        Для каждого Колонка из ТаблицаНом.Колонки Цикл
            СтруктураЗначВСтроку.Вставить(Колонка.Имя, Строка(СтрокаТаблицы[Колонка.Имя]));
        КонецЦикла;
        ОтветМассив.Добавить(СтруктураЗначВСтроку);
    КонецЦикла;
    ОтветJSON = Новый ЗаписьJSON;
    ОтветJSON.УстановитьСтроку();
    ЗаписатьJSON(ОтветJSON, ОтветМассив);
    
    Возврат ОтветJSON.Закрыть();
    
КонецФункции

Функция ПолучитьНоменклатуруCДоп() Экспорт
  
  Запрос = Новый Запрос;
  Запрос.Текст =
    "ВЫБРАТЬ
    |  УНИКАЛЬНЫЙИДЕНТИФИКАТОР(НоменклатураДополнительныеРеквизиты.Ссылка) КАК ТоварИД,
    |  НоменклатураДополнительныеРеквизиты.Свойство.Наименование КАК СвойствоНаименование,
    |  НоменклатураДополнительныеРеквизиты.Значение КАК Значение
    |ИЗ
    |  Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
    |УПОРЯДОЧИТЬ ПО
    |  ТоварИД";
  
  ТаблицаНом = Запрос.Выполнить().Выгрузить();
  
  // Группируем реквизиты по товарам: ТоварУИД -> Соответствие(Свойство -> Значение)
  СоотвПоТоварам = Новый Соответствие;
  
  Для Каждого СтрокаТаблицы Из ТаблицаНом Цикл
    
    ТоварИД = Строка(СтрокаТаблицы.ТоварИД);
    
    РеквизитыТовара = СоотвПоТоварам.Получить(ТоварИД);
    Если РеквизитыТовара = Неопределено Тогда
      РеквизитыТовара = Новый Соответствие;
      РеквизитыТовара.Вставить("ТоварИД", ТоварИД);
      СоотвПоТоварам.Вставить(ТоварИД, РеквизитыТовара);
    КонецЕсли;
    
    РеквизитыТовара.Вставить(СтрокаТаблицы.СвойствоНаименование, Строка(СтрокаТаблицы.Значение));
    
  КонецЦикла;
  
  // Перекладываем в массив для JSON
  ОтветМассив = Новый Массив;
  Для Каждого КЗ Из СоотвПоТоварам Цикл
    ОтветМассив.Добавить(КЗ.Значение);
  КонецЦикла;
  
  ОтветJSON = Новый ЗаписьJSON;
  ОтветJSON.УстановитьСтроку();
  ЗаписатьJSON(ОтветJSON, ОтветМассив);
  
  Возврат ОтветJSON.Закрыть();
  
КонецФункции

Функция ПостроитьДеревоКатегорий() Экспорт
  
  // Выгружаем все группы одним запросом
  Запрос = Новый Запрос;
  Запрос.Текст =
    "ВЫБРАТЬ
    |  Номенклатура.Ссылка КАК Ссылка,
    |  Номенклатура.Родитель КАК Родитель,
    |  Номенклатура.Наименование КАК Наименование
    |ИЗ
    |  Справочник.Номенклатура КАК Номенклатура
    |ГДЕ
    |  Номенклатура.ЭтоГруппа
    |УПОРЯДОЧИТЬ ПО
    |  Номенклатура.Наименование";
  
  Таблица = Запрос.Выполнить().Выгрузить();
  
  // Собираем группировку: Родитель -> Массив его прямых детей
  ДетиПоРодителю = Новый Соответствие;
  
  Для Каждого Стр Из Таблица Цикл
    
    СписокДетей = ДетиПоРодителю.Получить(Стр.Родитель);
    Если СписокДетей = Неопределено Тогда
      СписокДетей = Новый Массив;
      ДетиПоРодителю.Вставить(Стр.Родитель, СписокДетей);
    КонецЕсли;
    
    СписокДетей.Добавить(Стр);
    
  КонецЦикла;
  
  // Строим дерево, начиная с корневых элементов (у них Родитель пустой)
  ПустаяСсылка = Справочники.Номенклатура.ПустаяСсылка();
  КорневыеЭлементы = ДетиПоРодителю.Получить(ПустаяСсылка);
  
  Дерево = Новый Массив;
  Если КорневыеЭлементы <> Неопределено Тогда
    Для Каждого Корень Из КорневыеЭлементы Цикл
      Дерево.Добавить(ПостроитьУзел(Корень, ДетиПоРодителю));
    КонецЦикла;
  КонецЕсли;
  
  ОтветJSON = Новый ЗаписьJSON;
  ОтветJSON.УстановитьСтроку();
  ЗаписатьJSON(ОтветJSON, Дерево);
  
  Возврат ОтветJSON.Закрыть();
  
КонецФункции

Функция ПолучитьВсеЗаказы(Отбор, ОписаниеПараметров) Экспорт

	Запрос = Новый Запрос;
	Если ОписаниеПараметров = "ПоНомеру" Тогда		
		ТекстУсловия = "
		|	И ЗаказПокупателяЗапасы.Ссылка.Номер = &Номер";
		
		Запрос.УстановитьПараметр("Номер", Отбор);
	Иначе
		ТекстУсловия = "";
	КонецЕсли; 
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПокупателяЗапасы.Ссылка КАК Ссылка,
		|	ЗаказПокупателяЗапасы.Ссылка.ПометкаУдаления КАК ПометкаУдаления,
		|	ЗаказПокупателяЗапасы.Ссылка.Номер КАК Номер,
		|	ЗаказПокупателяЗапасы.Ссылка.Дата КАК Дата,
		|	ЗаказПокупателяЗапасы.Ссылка.Проведен КАК Проведен,
		|	ЗаказПокупателяЗапасы.Ссылка.СостояниеЗаказа КАК СостояниеЗаказа,
		|	ЗаказПокупателяЗапасы.Ссылка.ВариантЗавершения КАК ВариантЗавершения,
		|	ЗаказПокупателяЗапасы.Ссылка.АдресДоставки КАК АдресДоставки,
		|	ЗаказПокупателяЗапасы.Ссылка.СпособДоставки КАК СпособДоставки,
		|	ЗаказПокупателяЗапасы.Ссылка.СлужбаДоставки КАК СлужбаДоставки,
		|	ЗаказПокупателяЗапасы.Ссылка.СтоимостьДоставки КАК СтоимостьДоставки,
		|	ЗаказПокупателяЗапасы.Ссылка.ВидОперации КАК ВидОперации,
		|	ЗаказПокупателяЗапасы.Ссылка.ВремяДоставкиС КАК ВремяДоставкиС,
		|	ЗаказПокупателяЗапасы.Ссылка.ВремяДоставкиПо КАК ВремяДоставкиПо,
		|	ЗаказПокупателяЗапасы.Ссылка.ДатаОтгрузки КАК ДатаОтгрузки,
		|	ЗаказПокупателяЗапасы.Ссылка.Комментарий КАК Комментарий,
		|	ЗаказПокупателяЗапасы.Ссылка.Контрагент КАК Контрагент,
		|	ЗаказПокупателяЗапасы.Ссылка.Контрагент.Наименование КАК КонтрагентНаименование,
		|	ЗаказПокупателяЗапасы.Ссылка.Контрагент.ПометкаУдаления КАК КонтрагентПометкаУдаления,
		|	ЗаказПокупателяЗапасы.Ссылка.Контрагент.ВидКонтрагента КАК КонтрагентВидКонтрагента,
		|	ЗаказПокупателяЗапасы.Ссылка.Контрагент.Комментарий КАК КонтрагентКомментарий,
		|	ЗаказПокупателяЗапасы.Ссылка.Контрагент.НомерТелефонаДляПоиска КАК КонтрагентНомерТелефонаДляПоиска,
		|	ЗаказПокупателяЗапасы.Ссылка.Контрагент.Покупатель КАК КонтрагентПокупатель,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЗаказПокупателяЗапасы.Номенклатура.Ссылка) КАК ТоварИД,
		|	ЗаказПокупателяЗапасы.Количество КАК Количество,
		|	ЗаказПокупателяЗапасы.Сумма КАК Сумма,
		|	ЗаказПокупателяЗапасы.Номенклатура.Наименование КАК НоменклатураНаименование,
		|	ЗаказПокупателяЗапасы.Номенклатура.Артикул КАК НоменклатураАртикул,
		|	ЗаказПокупателяЗапасы.Цена КАК Цена
		|ИЗ
		|	Документ.ЗаказПокупателя.Запасы КАК ЗаказПокупателяЗапасы
		|ГДЕ
		|	ЗаказПокупателяЗапасы.Ссылка.Организация = &Организация" 
		+ ТекстУсловия + "
		|	И ЗаказПокупателяЗапасы.Ссылка.Контрагент.Покупатель
		|	И ЗаказПокупателяЗапасы.Ссылка.Номер ПОДОБНО ""%WK%""
		|ИТОГИ ПО
		|	Ссылка";
	
	Запрос.УстановитьПараметр("Организация", Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.ОрганизацияДляОтбора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЗаказ = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МассивЗаказов = Новый Массив;
	
	Пока ВыборкаЗаказ.Следующий() Цикл
		
		ЗаказСоответствие = Новый Соответствие;
		ЗаказСоответствие.Вставить("number", Строка(ВыборкаЗаказ.Номер));                                		
		ЗаказСоответствие.Вставить("deletion", Строка(ВыборкаЗаказ.ПометкаУдаления));
		ЗаказСоответствие.Вставить("date", Строка(ВыборкаЗаказ.Дата));
		ЗаказСоответствие.Вставить("carried", Строка(ВыборкаЗаказ.Проведен));
		ЗаказСоответствие.Вставить("order_status", Строка(ВыборкаЗаказ.СостояниеЗаказа));
		ЗаказСоответствие.Вставить("completion_option", Строка(ВыборкаЗаказ.ВариантЗавершения));
		ЗаказСоответствие.Вставить("delivery_address", Строка(ВыборкаЗаказ.АдресДоставки));
		ЗаказСоответствие.Вставить("delivery_method", Строка(ВыборкаЗаказ.СпособДоставки));
		ЗаказСоответствие.Вставить("delivery_service", Строка(ВыборкаЗаказ.СлужбаДоставки));                                		
		ЗаказСоответствие.Вставить("delivery_cost", Строка(ВыборкаЗаказ.СтоимостьДоставки));
		ЗаказСоответствие.Вставить("type_operation", Строка(ВыборкаЗаказ.ВидОперации));
		ЗаказСоответствие.Вставить("time_delivery_s", Строка(ВыборкаЗаказ.ВремяДоставкиС));
		ЗаказСоответствие.Вставить("time_delivery_po", Строка(ВыборкаЗаказ.ВремяДоставкиПо));
		ЗаказСоответствие.Вставить("shipping_date", Строка(ВыборкаЗаказ.ДатаОтгрузки)); 
		ЗаказСоответствие.Вставить("comment", Строка(ВыборкаЗаказ.Комментарий));                                		
		ЗаказСоответствие.Вставить("counterparty", Строка(ВыборкаЗаказ.КонтрагентНаименование));
		ЗаказСоответствие.Вставить("counterparty_pfone", Строка(ВыборкаЗаказ.КонтрагентНомерТелефонаДляПоиска));  
				                   		
		Выборка = ВыборкаЗаказ.Выбрать();
		
		МассивТоваров = Новый Массив;
		
		Пока Выборка.Следующий() Цикл 
			ЗаказТоварыСоответствие = Новый Соответствие;
			ЗаказТоварыСоответствие.Вставить("product_id", Строка(Выборка.ТоварИД)); 
			ЗаказТоварыСоответствие.Вставить("price", Строка(Выборка.Цена));
			ЗаказТоварыСоответствие.Вставить("quantity", Строка(Выборка.Количество)); 
			ЗаказТоварыСоответствие.Вставить("amount", Строка(Выборка.Сумма));
			
            МассивТоваров.Добавить(ЗаказТоварыСоответствие);
		КонецЦикла;
		
		ЗаказСоответствие.Вставить("tovar", МассивТоваров);
		МассивЗаказов.Добавить(ЗаказСоответствие);
	КонецЦикла;
	
	ОтветJSON = Новый ЗаписьJSON;
	ОтветJSON.УстановитьСтроку();
	ЗаписатьJSON(ОтветJSON, МассивЗаказов);

	Возврат ОтветJSON.Закрыть();
	
КонецФункции 

Функция ПолучитьОстаткиТоваров(Отбор, ОписаниеПараметров) Экспорт
	
	
	Запрос = Новый Запрос;
	
	// Склады и дополнительные условия по номенклатуре из настроек (пусто = без ограничений)
	Условия = ПолучитьУсловияВыгрузкиОстатков();
	УстановитьПараметрыОтбораОстатков(Запрос, Условия);
	
	УсловияОстатки = ПолучитьМассивУсловийОтбора(Условия, "ЗапасыНаСкладахОстатки");
	УсловияИтог    = ПолучитьМассивУсловийОтбора(Условия, "ОстаткиТоваров");
	
	Если ОписаниеПараметров = "Артикул" Тогда
		УсловияОстатки.Добавить("ЗапасыНаСкладахОстатки.Номенклатура.Артикул = &Артикул");
		Запрос.УстановитьПараметр("Артикул", Отбор);
	КонецЕсли;
	
	ТекстУсловия = ?(УсловияОстатки.Количество() > 0, "
	|ГДЕ
	|	" + СтрСоединить(УсловияОстатки, "
	|	И "), "");
	
	ТекстУсловияИтог = ?(УсловияИтог.Количество() > 0, "
	|ГДЕ
	|	" + СтрСоединить(УсловияИтог, "
	|	И "), "");
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗапасыНаСкладахОстатки.Организация КАК Организация,
		|	ЗапасыНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ЗапасыНаСкладахОстатки.Характеристика КАК Характеристика,
		|	ЗапасыНаСкладахОстатки.Партия КАК Партия,
		|	ЗапасыНаСкладахОстатки.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
		|	ЗапасыНаСкладахОстатки.Ячейка КАК Ячейка,
		|	ЗапасыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ ВТ_Остатки
		|ИЗ
		|	РегистрНакопления.ЗапасыНаСкладах.Остатки(, ) КАК ЗапасыНаСкладахОстатки"
        + ТекстУсловия + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиТоваров.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
		|	ВТ_Остатки.Номенклатура КАК Номенклатура,
		|	ОстаткиТоваров.Характеристика КАК Характеристика,
		|	ОстаткиТоваров.Партия КАК Партия,
		|	ОстаткиТоваров.Резерв КАК Резерв,
		|	ЕСТЬNULL(ВТ_Остатки.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) КАК Ячейка,
		|	ЕСТЬNULL(ВТ_Остатки.КоличествоОстаток, ОстаткиТоваров.Количество) КАК Остаток
		|ПОМЕСТИТЬ ВТ_Итог
		|ИЗ
		|	РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
		|		ПО ОстаткиТоваров.Организация = ВТ_Остатки.Организация
		|			И ОстаткиТоваров.СтруктурнаяЕдиница = ВТ_Остатки.СтруктурнаяЕдиница
		|			И ОстаткиТоваров.Номенклатура = ВТ_Остатки.Номенклатура
		|			И ОстаткиТоваров.Характеристика = ВТ_Остатки.Характеристика
		|			И ОстаткиТоваров.Партия = ВТ_Остатки.Партия" + ТекстУсловияИтог + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Итог.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТ_Итог.СтруктурнаяЕдиница) КАК СтруктурнаяЕдиницаИД,
		|	ВТ_Итог.Номенклатура КАК Номенклатура,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТ_Итог.Номенклатура) КАК НоменклатураИД,
		|	ВТ_Итог.Резерв КАК Резерв,
		|	СУММА(ВТ_Итог.Остаток) КАК Остаток
		|ИЗ
		|	ВТ_Итог КАК ВТ_Итог
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Итог.СтруктурнаяЕдиница,
		|	ВТ_Итог.Номенклатура,
		|	ВТ_Итог.Резерв
		|ИТОГИ ПО
		|	Номенклатура";

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНоменклатура = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МассивОстатков = Новый Массив;
	
	Пока ВыборкаНоменклатура.Следующий() Цикл
		СоответствиеНомен = Новый Соответствие;
		СоответствиеНомен.Вставить("tovar", Строка(ВыборкаНоменклатура.Номенклатура)); 
		СоответствиеНомен.Вставить("tovar_id", Строка(ВыборкаНоменклатура.НоменклатураИД));
		
		МассивСкладов = Новый Массив;
		
		Выборка = ВыборкаНоменклатура.Выбрать();
	
		Пока Выборка.Следующий() Цикл
			ОстаткиСкладовСоответствие = Новый Соответствие;
			ОстаткиСкладовСоответствие.Вставить("unit", Строка(Выборка.СтруктурнаяЕдиница)); 
			ОстаткиСкладовСоответствие.Вставить("unit_id", Строка(Выборка.СтруктурнаяЕдиницаИД));
			ОстаткиСкладовСоответствие.Вставить("reserve", Строка(Выборка.Резерв)); 
			ОстаткиСкладовСоответствие.Вставить("amount", Строка(Выборка.Остаток));
			
            МассивСкладов.Добавить(ОстаткиСкладовСоответствие);
		КонецЦикла;
		
		СоответствиеНомен.Вставить("warehouses", МассивСкладов);
		МассивОстатков.Добавить(СоответствиеНомен);
	КонецЦикла;
	
    ОтветJSON = Новый ЗаписьJSON;
	ОтветJSON.УстановитьСтроку();
	ЗаписатьJSON(ОтветJSON, МассивОстатков);

	Возврат ОтветJSON.Закрыть();


КонецФункции 

Функция ПолучитьОстаткиТоваровПакет(НомерСтраницы, ВсегоСтраниц) Экспорт
	
	// Склады и дополнительные условия по номенклатуре из настроек (пусто = без ограничений)
	Условия = ПолучитьУсловияВыгрузкиОстатков();
	
	УсловияКлючей = ПолучитьМассивУсловийОтбора(Условия, "ОстаткиТоваров");
	ТекстУсловийКлючей = ?(УсловияКлючей.Количество() > 0, "
	|ГДЕ
	|	" + СтрСоединить(УсловияКлючей, "
	|	И "), "");
	
	УсловиеСкладовОстатки = ?(Условия.Склады.Количество() > 0, "
	|	И ЗапасыНаСкладахОстатки.СтруктурнаяЕдиница В (&СкладыОтбора)", "");
	УсловиеСкладовИтог = ?(Условия.Склады.Количество() > 0, "
	|	И ОстаткиТоваров.СтруктурнаяЕдиница В (&СкладыОтбора)", "");
	
	// ШАГ 1: Получаем только список номенклатуры (легкий запрос)
	ЗапросКлючей = Новый Запрос;
	ЗапросКлючей.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОстаткиТоваров.Номенклатура КАК Номенклатура
		|ИЗ
		|	РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров" + ТекстУсловийКлючей + "
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура";
	
	УстановитьПараметрыОтбораОстатков(ЗапросКлючей, Условия);
	
	РезультатКлючей = ЗапросКлючей.Выполнить();
	ВыборкаКлючей   = РезультатКлючей.Выбрать();
	
	МассивВсейНоменклатуры = Новый Массив;
	Пока ВыборкаКлючей.Следующий() Цикл
		МассивВсейНоменклатуры.Добавить(ВыборкаКлючей.Номенклатура);
	КонецЦикла;
	
	// ШАГ 2: Вычисляем границы пакета
	ВсегоЗаписей = МассивВсейНоменклатуры.Количество();
	РазмерПакета = Цел(ВсегоЗаписей / ВсегоСтраниц);
	Остаток      = ВсегоЗаписей % ВсегоСтраниц;
	
	НачалоПакета = (НомерСтраницы - 1) * РазмерПакета + Мин(НомерСтраницы - 1, Остаток);
	КонецПакета  = НачалоПакета + РазмерПакета + ?(НомерСтраницы <= Остаток, 1, 0);
	
	// ШАГ 3: Формируем список номенклатуры только для текущего пакета
	СписокНоменклатуры = Новый СписокЗначений;
	Для Инд = НачалоПакета По КонецПакета - 1 Цикл
		СписокНоменклатуры.Добавить(МассивВсейНоменклатуры[Инд]);
	КонецЦикла;
	
	// ШАГ 4: Основной запрос ТОЛЬКО по нужной номенклатуре
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокНоменклатуры", СписокНоменклатуры);
	Запрос.УстановитьПараметр("СкладыОтбора", Условия.Склады);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗапасыНаСкладахОстатки.Организация КАК Организация,
		|	ЗапасыНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ЗапасыНаСкладахОстатки.Характеристика КАК Характеристика,
		|	ЗапасыНаСкладахОстатки.Партия КАК Партия,
		|	ЗапасыНаСкладахОстатки.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
		|	ЗапасыНаСкладахОстатки.Ячейка КАК Ячейка,
		|	ЗапасыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ ВТ_Остатки
		|ИЗ
		|	РегистрНакопления.ЗапасыНаСкладах.Остатки(, ) КАК ЗапасыНаСкладахОстатки
		|ГДЕ
		|	ЗапасыНаСкладахОстатки.Номенклатура В(&СписокНоменклатуры)" + УсловиеСкладовОстатки + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиТоваров.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
		|	ВТ_Остатки.Номенклатура КАК Номенклатура,
		|	ОстаткиТоваров.Характеристика КАК Характеристика,
		|	ОстаткиТоваров.Партия КАК Партия,
		|	ОстаткиТоваров.Резерв КАК Резерв,
		|	ЕСТЬNULL(ВТ_Остатки.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) КАК Ячейка,
		|	ЕСТЬNULL(ВТ_Остатки.КоличествоОстаток, ОстаткиТоваров.Количество) КАК Остаток
		|ПОМЕСТИТЬ ВТ_Итог
		|ИЗ
		|	РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
		|		ПО ОстаткиТоваров.Организация = ВТ_Остатки.Организация
		|			И ОстаткиТоваров.СтруктурнаяЕдиница = ВТ_Остатки.СтруктурнаяЕдиница
		|			И ОстаткиТоваров.Номенклатура = ВТ_Остатки.Номенклатура
		|			И ОстаткиТоваров.Характеристика = ВТ_Остатки.Характеристика
		|			И ОстаткиТоваров.Партия = ВТ_Остатки.Партия
		|ГДЕ
		|	ОстаткиТоваров.Номенклатура В(&СписокНоменклатуры)" + УсловиеСкладовИтог + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Итог.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТ_Итог.СтруктурнаяЕдиница) КАК СтруктурнаяЕдиницаИД,
		|	ВТ_Итог.Номенклатура КАК Номенклатура,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТ_Итог.Номенклатура) КАК НоменклатураИД,
		|	ВТ_Итог.Резерв КАК Резерв,
		|	СУММА(ВТ_Итог.Остаток) КАК Остаток
		|ИЗ
		|	ВТ_Итог КАК ВТ_Итог
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Итог.СтруктурнаяЕдиница,
		|	ВТ_Итог.Номенклатура,
		|	ВТ_Итог.Резерв
		|ИТОГИ ПО
		|	Номенклатура";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаНоменклатура = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МассивПакета = Новый Массив;
	
	Пока ВыборкаНоменклатура.Следующий() Цикл
		СоответствиеНомен = Новый Соответствие;
		СоответствиеНомен.Вставить("tovar",    Строка(ВыборкаНоменклатура.Номенклатура)); 
		СоответствиеНомен.Вставить("tovar_id", Строка(ВыборкаНоменклатура.НоменклатураИД));
		
		МассивСкладов = Новый Массив;
		Выборка = ВыборкаНоменклатура.Выбрать();
		Пока Выборка.Следующий() Цикл
			ОстаткиСкладовСоответствие = Новый Соответствие;
			ОстаткиСкладовСоответствие.Вставить("unit",     Строка(Выборка.СтруктурнаяЕдиница)); 
			ОстаткиСкладовСоответствие.Вставить("unit_id",  Строка(Выборка.СтруктурнаяЕдиницаИД));
			ОстаткиСкладовСоответствие.Вставить("reserve",  Строка(Выборка.Резерв)); 
			ОстаткиСкладовСоответствие.Вставить("amount",   Строка(Выборка.Остаток));
			МассивСкладов.Добавить(ОстаткиСкладовСоответствие);
		КонецЦикла;
		
		СоответствиеНомен.Вставить("warehouses", МассивСкладов);
		МассивПакета.Добавить(СоответствиеНомен);
	КонецЦикла;
	
	// Формируем ответ с мета-информацией
	ОбёртываОтвет = Новый Соответствие;
	ОбёртываОтвет.Вставить("page",        НомерСтраницы);
	ОбёртываОтвет.Вставить("total_pages", ВсегоСтраниц);
	ОбёртываОтвет.Вставить("total_items", ВсегоЗаписей);
	ОбёртываОтвет.Вставить("items",       МассивПакета);
	
	ОтветJSON = Новый ЗаписьJSON;
	ОтветJSON.УстановитьСтроку();
	ЗаписатьJSON(ОтветJSON, ОбёртываОтвет);

	Возврат ОтветJSON.Закрыть();

