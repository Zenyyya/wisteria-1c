//#Вставка
// Убирает "+", пробелы, скобки, дефисы — оставляет только цифры.
// Нужна, потому что НомерТелефонаДляПоиска хранится без "+",
// а входящий телефон из JSON иногда приходит с "+".
Функция НормализоватьТелефон(Телефон)
	
	Рез = СокрЛП(Телефон);
	Рез = СтрЗаменить(Рез, "+", "");
	Рез = СтрЗаменить(Рез, " ", "");
	Рез = СтрЗаменить(Рез, "-", "");
	Рез = СтрЗаменить(Рез, "(", "");
	Рез = СтрЗаменить(Рез, ")", "");
	
	Возврат Рез;
	
КонецФункции
