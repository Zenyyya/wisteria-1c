КонецФункции 

// Начало Резервирование

Функция ПроверитьОстаткиТовароЗаказ(Ссылка, УчитыватьПартии = Ложь)
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗапасыНаСкладахОстатки.Организация КАК Организация,
	|	ЗапасыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ЗапасыНаСкладахОстатки.Характеристика КАК Характеристика,
	|	ЗапасыНаСкладахОстатки.Партия КАК Партия,
	|	ЗапасыНаСкладахОстатки.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ЗапасыНаСкладахОстатки.Ячейка КАК Ячейка,
	|	ЗапасыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.ЗапасыНаСкладах.Остатки(, ) КАК ЗапасыНаСкладахОстатки
	|ГДЕ
	|	ЗапасыНаСкладахОстатки.Номенклатура = &Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиТоваров.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ВТ_Остатки.Номенклатура КАК Номенклатура,
	|	ОстаткиТоваров.Характеристика КАК Характеристика,
	|	ОстаткиТоваров.Партия КАК Партия,
	|	ОстаткиТоваров.Резерв КАК Резерв,
	|	ЕСТЬNULL(ВТ_Остатки.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) КАК Ячейка,
	|	ЕСТЬNULL(ВТ_Остатки.КоличествоОстаток, ОстаткиТоваров.Количество) КАК Остаток
	|ПОМЕСТИТЬ ВТ_Итог
	|ИЗ
	|	РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ОстаткиТоваров.Организация = ВТ_Остатки.Организация
	|			И ОстаткиТоваров.СтруктурнаяЕдиница = ВТ_Остатки.СтруктурнаяЕдиница
	|			И ОстаткиТоваров.Номенклатура = ВТ_Остатки.Номенклатура
	|			И ОстаткиТоваров.Характеристика = ВТ_Остатки.Характеристика
	|			И ОстаткиТоваров.Партия = ВТ_Остатки.Партия
	|ГДЕ
	|	ВТ_Остатки.СтруктурнаяЕдиница В (&СписокСкладов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Итог.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ВТ_Итог.Номенклатура КАК Номенклатура,
	|	ВТ_Итог.Резерв КАК Резерв,
	|	ВТ_Итог.Ячейка КАК Ячейка,
	|	СУММА(ВТ_Итог.Остаток) КАК Остаток,
	|	ВТ_Итог.Номенклатура.ЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
	|	ВТ_Итог.Партия КАК Партия
	|ИЗ
	|	ВТ_Итог КАК ВТ_Итог
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Итог.СтруктурнаяЕдиница,
	|	ВТ_Итог.Номенклатура,
	|	ВТ_Итог.Резерв,
	|	ВТ_Итог.Ячейка,
	|	ВТ_Итог.Номенклатура.ЕдиницаИзмерения,
	|	ВТ_Итог.Партия";
	
	СписокСкладов = Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.СкладыДляПроверкиОстатков.Выгрузить().ВыгрузитьКолонку("Склад");
	
	Запрос.УстановитьПараметр("СписокСкладов", СписокСкладов);
	Запрос.УстановитьПараметр("Номенклатура", Ссылка); 
		
	ТаблицаРезультатов = Запрос.Выполнить().Выгрузить(); 
	
	// Приоритет списания = порядковый номер склада в табличной части настроек
	ПриоритетыСкладов = Новый Соответствие;
	Индекс = 0;
	Для каждого СтрокаНастройки Из Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.СкладыДляПроверкиОстатков Цикл
		ПриоритетыСкладов.Вставить(СтрокаНастройки.Склад, Индекс);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	ТаблицаРезультатов.Колонки.Добавить("Приоритет");
	Для каждого СтрокаРезультата Из ТаблицаРезультатов Цикл
		СтрокаРезультата.Приоритет = ПриоритетыСкладов[СтрокаРезультата.СтруктурнаяЕдиница];
	КонецЦикла;
	
	Если УчитыватьПартии Тогда
		
		// Внутри склада партии идут по FIFO: раньше пришла — раньше списывается
		ДатыПартий = ПолучитьДатыПартий(Ссылка, ТаблицаРезультатов.ВыгрузитьКолонку("Партия"));
		МаксДата   = Дата(3999, 12, 31);
		
		ТаблицаРезультатов.Колонки.Добавить("ДатаПартии");
		Для каждого СтрокаРезультата Из ТаблицаРезультатов Цикл
			ДатаПартии = ДатыПартий[СтрокаРезультата.Партия];
			СтрокаРезультата.ДатаПартии = ?(ДатаПартии = Неопределено, МаксДата, ДатаПартии);
		КонецЦикла;
		
		ТаблицаРезультатов.Сортировать("Приоритет Возр, ДатаПартии Возр");
		
	Иначе
		ТаблицаРезультатов.Сортировать("Приоритет Возр");
	КонецЕсли;
	
	Возврат ТаблицаРезультатов;
	
КонецФункции

// Возвращает Соответствие "Партия -> дата первого прихода" по регистру ЗапасыНаСкладах.
// Берётся минимальный период прихода по всем складам, поэтому перемещение
// партии на другой склад не сдвигает её "возраст".
// -----------------------------------------------------------------------------
Функция ПолучитьДатыПартий(Номенклатура, Партии)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗапасыНаСкладах.Партия КАК Партия,
	|	МИНИМУМ(ЗапасыНаСкладах.Период) КАК ДатаПартии
	|ИЗ
	|	РегистрНакопления.ЗапасыНаСкладах КАК ЗапасыНаСкладах
	|ГДЕ
	|	ЗапасыНаСкладах.Номенклатура = &Номенклатура
	|	И ЗапасыНаСкладах.Партия В (&Партии)
	|	И ЗапасыНаСкладах.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗапасыНаСкладах.Партия";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Партии", Партии);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Партия, Выборка.ДатаПартии);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает условия выгрузки остатков на сайт из настроек:
//   Склады       - массив складов (пустой массив = без отбора по складам);
//   Номенклатура - массив номенклатуры, подходящей под дополнительные условия
//                  (Неопределено = дополнительных условий нет).
// -----------------------------------------------------------------------------
Функция ПолучитьУсловияВыгрузкиОстатков()
	
	Настройки = Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки;
	
	Результат = Новый Структура;
	Результат.Вставить("Склады", Настройки.СкладыДляВыгрузкиОстатков.Выгрузить().ВыгрузитьКолонку("Склад"));
	Результат.Вставить("Номенклатура", ПолучитьНоменклатуруПоДополнительнымУсловиям(Настройки));
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив номенклатуры по дополнительным условиям из настроек
// или Неопределено, если активных условий нет.
// -----------------------------------------------------------------------------
Функция ПолучитьНоменклатуруПоДополнительнымУсловиям(Настройки)
	
	НастройкиОтбора = Настройки.ДополнительныеУсловияОстатков.Получить();
	
	Если НастройкиОтбора = Неопределено Или Не ЕстьАктивныеЭлементыОтбора(НастройкиОтбора.Отбор.Элементы) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СхемаКД = Справочники.APIW_НастройкиОбменаAPI.ПолучитьМакет("СхемаОтбораНоменклатуры");
	
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКД));
	Компоновщик.ЗагрузитьНастройки(СхемаКД.НастройкиПоУмолчанию);
	
	НастройкиКД = Компоновщик.Настройки;
	НастройкиКД.Структура.Очистить();
	НастройкиКД.Выбор.Элементы.Очистить();
	
	// Детальные записи с одним полем - ссылкой на номенклатуру
	Группировка = НастройкиКД.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ВыбранноеПоле = Группировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("Номенклатура");
	
	СкопироватьЭлементыОтбора(НастройкиКД.Отбор.Элементы, НастройкиОтбора.Отбор.Элементы);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКД = КомпоновщикМакета.Выполнить(СхемаКД, НастройкиКД, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКД = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКД.Инициализировать(МакетКД);
	
	ТаблицаНоменклатуры = Новый ТаблицаЗначений;
	ВыводКД = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ВыводКД.УстановитьОбъект(ТаблицаНоменклатуры);
	ВыводКД.Вывести(ПроцессорКД);
	
	Возврат ТаблицаНоменклатуры.ВыгрузитьКолонку("Номенклатура");
	
КонецФункции

// Есть ли в отборе включённые условия (с учётом вложенных групп)
// -----------------------------------------------------------------------------
Функция ЕстьАктивныеЭлементыОтбора(Элементы)
	
	Для каждого Элемент Из Элементы Цикл
		
		Если Не Элемент.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Если ЕстьАктивныеЭлементыОтбора(Элемент.Элементы) Тогда
				Возврат Истина;
			КонецЕсли;
		Иначе
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Копирует элементы отбора (включая вложенные группы)
// -----------------------------------------------------------------------------
Процедура СкопироватьЭлементыОтбора(Приемник, Источник)
	
	Для каждого ЭлементИсточник Из Источник Цикл
		
		ЭлементПриемник = Приемник.Добавить(ТипЗнч(ЭлементИсточник));
		ЗаполнитьЗначенияСвойств(ЭлементПриемник, ЭлементИсточник);
		
		Если ТипЗнч(ЭлементИсточник) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			СкопироватьЭлементыОтбора(ЭлементПриемник.Элементы, ЭлементИсточник.Элементы);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает массив текстов условий запроса по складам и номенклатуре.
// Псевдоним - имя таблицы в запросе, к полям которой применяются условия.
// -----------------------------------------------------------------------------
Функция ПолучитьМассивУсловийОтбора(Условия, Псевдоним)
	
	Результат = Новый Массив;
	
	Если Условия.Склады.Количество() > 0 Тогда
		Результат.Добавить(Псевдоним + ".СтруктурнаяЕдиница В (&СкладыОтбора)");
	КонецЕсли;
	
	Если Условия.Номенклатура <> Неопределено Тогда
		Результат.Добавить(Псевдоним + ".Номенклатура В (&НоменклатураОтбора)");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Устанавливает в запрос параметры отбора остатков
// -----------------------------------------------------------------------------
Процедура УстановитьПараметрыОтбораОстатков(Запрос, Условия)
	
	Если Условия.Склады.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("СкладыОтбора", Условия.Склады);
	КонецЕсли;
	
	Если Условия.Номенклатура <> Неопределено Тогда
		Запрос.УстановитьПараметр("НоменклатураОтбора", Условия.Номенклатура);
	КонецЕсли;
	
КонецПроцедуры
// Возвращает ссылку на "Склад Интернет-магазина"
// -----------------------------------------------------------------------------
Функция ПолучитьСкладИнтернетМагазина()
	
	Возврат Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.СкладИнтернетМагазина;
	
КонецФункции

// Создаёт один документ ПеремещениеЗапасов для одного склада-источника.
// ТаблицаСтрок — строки заказа, которые надо переместить с этого склада.
// -----------------------------------------------------------------------------
Процедура СоздатьПеремещениеСоСклада(СкладИсточник, СкладПолучатель, ТаблицаСтрок, ОбъектЗаказ)
	
	Если ТаблицаСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НовоеПеремещение = Документы.ПеремещениеЗапасов.СоздатьДокумент();
	НовоеПеремещение.Дата          = ТекущаяДата();
	НовоеПеремещение.Организация   = ОбъектЗаказ.Организация;        
	НовоеПеремещение.СтруктурнаяЕдиница = СкладИсточник;
	НовоеПеремещение.СтруктурнаяЕдиницаПолучатель  = СкладПолучатель;
	НовоеПеремещение.ДокументОснование	= ОбъектЗаказ.Ссылка; 
	НовоеПеремещение.ВидОперации = Перечисления.ВидыОперацийПеремещениеЗапасов.Перемещение;
	НовоеПеремещение.Комментарий = "Интернет заказ. Взять в работу складу после согласования";
	
	
	Для каждого СтрокаЗаказа Из ТаблицаСтрок Цикл
		
		НоваяСтрока = НовоеПеремещение.Запасы.Добавить();
		НоваяСтрока.Номенклатура     = СтрокаЗаказа.Номенклатура;
		НоваяСтрока.Характеристика   = СтрокаЗаказа.Характеристика;
		НоваяСтрока.Количество       = СтрокаЗаказа.КоличествоКПеремещению;
		НоваяСтрока.ЕдиницаИзмерения = СтрокаЗаказа.НоменклатураЕдиницаИзмерения;
		НоваяСтрока.Ячейка 			 = СтрокаЗаказа.Ячейка; 
		НоваяСтрока.Партия 			 = СтрокаЗаказа.Партия;
		
	КонецЦикла;
	
	
	НовоеПеремещение.Записать();
	НовоеПеремещение.Записать(РежимЗаписиДокумента.Проведение); 
	
КонецПроцедуры

// Добавляет количество к партии в списке партий строки (партия не повторяется)
// -----------------------------------------------------------------------------
Процедура ДобавитьКоличествоПартии(ПартииСтроки, Партия, Количество)
	
	Для каждого ПартияСтроки Из ПартииСтроки Цикл
		Если ПартияСтроки.Партия = Партия Тогда
			ПартияСтроки.Количество = ПартияСтроки.Количество + Количество;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ПартииСтроки.Добавить(Новый Структура("Партия, Количество", Партия, Количество));
	
КонецПроцедуры

// Проставляет партии в строке заказа. Если количество строки приходится на
// несколько партий — строка делится: суммы распределяются пропорционально
// количеству, остаток округления уходит в последнюю часть.
// Остаток — количество, под которое не нашлось остатков: остаётся без партии.
// -----------------------------------------------------------------------------
Процедура УстановитьПартииВСтрокеЗаказа(ОбъектЗаказ, Индекс, Распределение, Остаток)
	
	ПартииСтроки = Новый Массив;
	Для каждого Элемент Из Распределение Цикл
		ДобавитьКоличествоПартии(ПартииСтроки, Элемент.Партия, Элемент.Количество);
	КонецЦикла;
	
	Если Остаток > 0 Тогда
		ДобавитьКоличествоПартии(ПартииСтроки, Справочники.ПартииНоменклатуры.ПустаяСсылка(), Остаток);
	КонецЕсли;
	
	Если ПартииСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаОбъекта = ОбъектЗаказ.Запасы[Индекс];
	
	Если ПартииСтроки.Количество() = 1 Тогда
		СтрокаОбъекта.Партия = ПартииСтроки[0].Партия;
		Возврат;
	КонецЕсли;
	
	// Исходные значения строки, от которых считаются части
	ИсходноеКоличество = СтрокаОбъекта.Количество;
	ИсходнаяСумма      = СтрокаОбъекта.Сумма;
	ИсходнаяСкидка     = СтрокаОбъекта.СуммаСкидкиНаценки;
	ИсходныйНДС        = СтрокаОбъекта.СуммаНДС;
	Цена               = СтрокаОбъекта.Цена;
	
	ОстатокСкидки = ИсходнаяСкидка;
	ОстатокНДС    = ИсходныйНДС;
	
	ПоследняяЧасть = ПартииСтроки.Количество() - 1;
	
	Для НомерЧасти = 0 По ПоследняяЧасть Цикл
		
		Часть = ПартииСтроки[НомерЧасти];
		
		Если НомерЧасти = 0 Тогда
			СтрокаЧасти = СтрокаОбъекта;
		Иначе
			СтрокаЧасти = ОбъектЗаказ.Запасы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаЧасти, СтрокаОбъекта);
		КонецЕсли;
		
		Если НомерЧасти = ПоследняяЧасть Тогда
			СкидкаЧасти = ОстатокСкидки;
			НДСЧасти    = ОстатокНДС;
			СуммаЧасти  = Часть.Количество * Цена - СкидкаЧасти;
		Иначе
			СкидкаЧасти = Окр(ИсходнаяСкидка * Часть.Количество / ИсходноеКоличество, 2);
			СуммаЧасти  = Часть.Количество * Цена - СкидкаЧасти;
			НДСЧасти    = ?(ИсходнаяСумма = 0, 0, Окр(ИсходныйНДС * СуммаЧасти / ИсходнаяСумма, 2));
		КонецЕсли;
		
		СтрокаЧасти.Партия             = Часть.Партия;
		СтрокаЧасти.Количество         = Часть.Количество;
		СтрокаЧасти.Резерв             = Часть.Количество;
		СтрокаЧасти.СуммаСкидкиНаценки = СкидкаЧасти;
		СтрокаЧасти.Сумма              = СуммаЧасти;
		СтрокаЧасти.СуммаНДС           = НДСЧасти;
		СтрокаЧасти.Всего              = СуммаЧасти;
		
		ОстатокСкидки = ОстатокСкидки - СкидкаЧасти;
		ОстатокНДС    = ОстатокНДС - НДСЧасти;
		
	КонецЦикла;
	
КонецПроцедуры

// Основная функция: для каждого товара заказа распределяет количество по остаткам:
// сначала свободный остаток склада интернет-магазина, затем склады-источники
// в порядке приоритета (порядок строк СкладыДляПроверкиОстатков), внутри склада —
// по FIFO партий. С прочих складов создаёт ПеремещениеЗапасов.
// При включённой настройке ЗаполнятьПартии партия берётся из той же строки остатков,
// что и склад, и проставляется в строки заказа и перемещений.
// -----------------------------------------------------------------------------
Функция ПодготовитьРезервТоваров(СсылкаНаНовыйЗаказ)
	
	ЗаполнятьПартии = Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.ЗаполнятьПартии;
	
	ОбъектЗаказ      = СсылкаНаНовыйЗаказ.ПолучитьОбъект();
	СкладПолучатель  = ПолучитьСкладИнтернетМагазина();
	ПустаяПартия     = Справочники.ПартииНоменклатуры.ПустаяСсылка();
	
	// ТаблицаПеремещений: ключ — СкладИсточник,
	// значение — таблица строк для будущего документа перемещения.
	ТаблицаПеремещений = Новый Соответствие;
	
	ТаблицаТоваров = ОбъектЗаказ.Запасы.Выгрузить();
	
	Для Индекс = 0 По ТаблицаТоваров.Количество() - 1 Цикл
		
		СтрокаЗаказа = ТаблицаТоваров[Индекс];
		
		// Остатки номенклатуры по складам из настроек, уже отсортированные по приоритету
		ТаблицаОстатков = ПроверитьОстаткиТовароЗаказ(СтрокаЗаказа.Номенклатура, ЗаполнятьПартии);
		
		Нужно         = СтрокаЗаказа.Количество;
		Распределение = Новый Массив;
		
		// 1. Свободный остаток склада интернет-магазина — перемещение не нужно
		Для каждого СтрОстатка Из ТаблицаОстатков.НайтиСтроки(Новый Структура("СтруктурнаяЕдиница", СкладПолучатель)) Цикл
			
			Если Нужно <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			Свободно = Макс(СтрОстатка.Остаток - СтрОстатка.Резерв, 0);
			Если Свободно <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			КоличествоЧасти = Мин(Свободно, Нужно);
			Нужно           = Нужно - КоличествоЧасти;
			
			Элемент = Новый Структура;
			Элемент.Вставить("Склад", СтрОстатка.СтруктурнаяЕдиница);
			Элемент.Вставить("Партия", ?(ЗаполнятьПартии, СтрОстатка.Партия, ПустаяПартия));
			Элемент.Вставить("Ячейка", СтрОстатка.Ячейка);
			Элемент.Вставить("Количество", КоличествоЧасти);
			Элемент.Вставить("ЕдиницаИзмерения", СтрОстатка.НоменклатураЕдиницаИзмерения);
			Элемент.Вставить("Перемещать", Ложь);
			Распределение.Добавить(Элемент);
			
		КонецЦикла;
		
		// 2. Недостающее количество — со складов-источников в порядке приоритета
		Для каждого СтрОстатка Из ТаблицаОстатков Цикл
			
			// Пропускаем сам склад-получатель
			Если СтрОстатка.СтруктурнаяЕдиница = СкладПолучатель Тогда
				Продолжить;
			КонецЕсли;
			
			Если Нужно <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			Свободно = Макс(СтрОстатка.Остаток - СтрОстатка.Резерв, 0);
			Если Свободно <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			КоличествоЧасти = Мин(Свободно, Нужно);
			Нужно           = Нужно - КоличествоЧасти;
			
			Элемент = Новый Структура;
			Элемент.Вставить("Склад", СтрОстатка.СтруктурнаяЕдиница);
			Элемент.Вставить("Партия", ?(ЗаполнятьПартии, СтрОстатка.Партия, ПустаяПартия));
			Элемент.Вставить("Ячейка", СтрОстатка.Ячейка);
			Элемент.Вставить("Количество", КоличествоЧасти);
			Элемент.Вставить("ЕдиницаИзмерения", СтрОстатка.НоменклатураЕдиницаИзмерения);
			Элемент.Вставить("Перемещать", Истина);
			Распределение.Добавить(Элемент);
			
		КонецЦикла;
		
		// Информируем, если товар так и не нашёлся в нужном количестве
		Если Нужно > 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(
				"Недостаточно остатков для «%1»: не хватает %2 ед. ни на одном складе.",
				СтрокаЗаказа.Номенклатура,
				Нужно);
			Сообщение.Сообщить();
		КонецЕсли;
		
		// Партии в строках заказа (при необходимости строка делится)
		Если ЗаполнятьПартии Тогда
			УстановитьПартииВСтрокеЗаказа(ОбъектЗаказ, Индекс, Распределение, Нужно);
		КонецЕсли;
		
		// Строки перемещений — только для остатков с прочих складов
		Для каждого Элемент Из Распределение Цикл
			
			Если Не Элемент.Перемещать Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТаблицаПеремещений[Элемент.Склад] = Неопределено Тогда
				
				НТС = Новый ТаблицаЗначений;
				НТС.Колонки.Добавить("Номенклатура");
				НТС.Колонки.Добавить("Характеристика");
				НТС.Колонки.Добавить("КоличествоКПеремещению");
				НТС.Колонки.Добавить("Ячейка");
				НТС.Колонки.Добавить("НоменклатураЕдиницаИзмерения");
				НТС.Колонки.Добавить("Партия");
				ТаблицаПеремещений.Вставить(Элемент.Склад, НТС);
				
			КонецЕсли;
			
			НоваяСтрока = ТаблицаПеремещений[Элемент.Склад].Добавить();
			НоваяСтрока.Номенклатура                 = СтрокаЗаказа.Номенклатура;
			НоваяСтрока.Характеристика               = СтрокаЗаказа.Характеристика;
			НоваяСтрока.Партия                       = Элемент.Партия;
			НоваяСтрока.КоличествоКПеремещению       = Элемент.Количество;
			НоваяСтрока.Ячейка                       = Элемент.Ячейка;
			НоваяСтрока.НоменклатураЕдиницаИзмерения = Элемент.ЕдиницаИзмерения;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Создаём по одному документу ПеремещениеЗапасов на каждый склад-источник
	Для каждого Элемент Из ТаблицаПеремещений Цикл
		СоздатьПеремещениеСоСклада(Элемент.Ключ, СкладПолучатель, Элемент.Значение, ОбъектЗаказ);
	КонецЦикла;
	
	ОбъектЗаказ.Записать(РежимЗаписиДокумента.Проведение);
	
КонецФункции

// Конец Резервирование

#КонецОбласти

#Область ОтправкаНаСайт

Процедура ДанныеПриИзмененииЗаказаПокупателя(ТекущийОбъект)  Экспорт
	 
	ОтборЗак = СтрНайти(ТекущийОбъект.Номер, "WK"); 
	 
	Если Не ОтборЗак = 0 Тогда
		ДанныеЗаказаJson = ПолучитьВсеЗаказы(ТекущийОбъект.Номер, "ПоНомеру");	
		
	 	МенеджерЗаписи = РегистрыСведений.APIW_СоответствиеОбъектовСайт.СоздатьМенеджерЗаписи(); 

		МенеджерЗаписи.Дата = ТекущаяДата();
		МенеджерЗаписи.Номер				= ТекущийОбъект.Номер; 
		МенеджерЗаписи.ИД					= ТекущийОбъект.Ссылка.УникальныйИдентификатор(); 
		МенеджерЗаписи.Статус				= Перечисления.APIW_СтатусыЗагрузкиЗаказов.Новый; 
		МенеджерЗаписи.ТипДанных 			= Перечисления.APIW_ТипыЗагружаемыхДанных.ЗаказПолупателя;
		МенеджерЗаписи.ОбъектСсылка			= ТекущийОбъект.Ссылка;
		МенеджерЗаписи.ДанныеJSON			= ДанныеЗаказаJson; 
		МенеджерЗаписи.НаправлениеОбмена	= Перечисления.APIW_НаправлениеОбмена.НаСайт;
		
		МенеджерЗаписи.Записать(); 
	КонецЕсли;
	
КонецПроцедуры 


Функция ПолучитьДанныеПоЗаказам() Экспорт 
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	APIW_СоответствиеОбъектовСайт.ДанныеJSON КАК ДанныеJSON,
        |	APIW_СоответствиеОбъектовСайт.Номер КАК Номер
        |ИЗ
        |	РегистрСведений.APIW_СоответствиеОбъектовСайт КАК APIW_СоответствиеОбъектовСайт
        |ГДЕ
        |	APIW_СоответствиеОбъектовСайт.Статус = ЗНАЧЕНИЕ(Перечисление.APIW_СтатусыЗагрузкиЗаказов.Новый)
        |	И APIW_СоответствиеОбъектовСайт.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.APIW_НаправлениеОбмена.НаСайт)";
    
    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();
    
    МассивДанных = Новый Массив;
    
    Пока Выборка.Следующий() Цикл
        
        ЧтениеJSON = Новый ЧтениеJSON();
        ЧтениеJSON.УстановитьСтроку(Выборка.ДанныеJSON);
        Ответ = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        
        // Добавляем каждый элемент массива Ответ в МассивДанных
        Если ТипЗнч(Ответ) = Тип("Массив") Тогда
            Для Каждого ЭлементОтвета Из Ответ Цикл
                МассивДанных.Добавить(ЭлементОтвета);
            КонецЦикла;
        Иначе
            МассивДанных.Добавить(Ответ);
        КонецЕсли;
		
		
		НаборЗаписей = РегистрыСведений.APIW_СоответствиеОбъектовСайт.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Номер.Установить(Выборка.Номер);
		НаборЗаписей.Прочитать();
		
		Для каждого Строка Из НаборЗаписей Цикл
			Строка.Статус = Перечисления.APIW_СтатусыЗагрузкиЗаказов.Загружен;
		КонецЦикла;
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
    ОтветJSON = Новый ЗаписьJSON;
    ОтветJSON.УстановитьСтроку();
    ЗаписатьJSON(ОтветJSON, МассивДанных);
    Возврат ОтветJSON.Закрыть();
    
КонецФункции


 
