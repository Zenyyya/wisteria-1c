Функция ОбновитьДанныеКлиента(СтруктураДанных) Экспорт 
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(СтруктураДанных);
	МассивJSON = ПрочитатьJSON(ЧтениеJSON);
	
	Для каждого Строка Из МассивJSON Цикл
	
		Результат = НайтиПокупателя(Строка.counterparty_pfone);
		Если Не Результат = Ложь Тогда
        	СсылкаПокупатель = СоздатьОбновитьПокупателя(Строка, Ложь);
			ДобавитьКонтактыКонтрагенту(Строка, СсылкаПокупатель);
		Иначе 
			Возврат "Не найден покупатель по номеру: " + Строка.counterparty_pfone;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "Данные успешно обновлены";
	
КонецФункции 

// Оплата заказа с сайта. Без pay[] (старый формат, Анна-Леон) - эквайринг ЮKassa на весь заказ.
// pay[] разбирается только при включённой настройке «Получать оплату подарочной картой».
Функция ДобавитьДокументОплаты(СтруктураДанных) Экспорт
	
	Если Не Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.СоздаватьДокументОплаты Тогда
		Возврат "Создание документов оплаты отключено в настройках";
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(СтруктураДанных);
	МассивJSON = ПрочитатьJSON(ЧтениеJSON);
	
	ПолучатьОплатуКартами = ПолучатьОплатуПодарочнымиКартами();
	
	Итоги = Новый Массив;
	Итоги.Добавить("Данные успешно обновлены");
	
	Для каждого Строка Из МассивJSON Цикл
		
		СсылкаЗаказ = НайтиЗаказ(Строка.number);
		Если СсылкаЗаказ = Ложь Тогда
			Итоги.Добавить("Заказ " + Строка.number + " не найден");
			Продолжить;
		КонецЕсли;
		
		ЗначениеIdPay = Неопределено;
		Строка.Свойство("idpay", ЗначениеIdPay);
		
		СтрокиОплаты = Неопределено;
		ЕстьСтрокиОплаты = Строка.Свойство("pay", СтрокиОплаты)
			И ТипЗнч(СтрокиОплаты) = Тип("Массив")
			И СтрокиОплаты.Количество() > 0;
		
		Если ЕстьСтрокиОплаты И ПолучатьОплатуКартами Тогда
			Итоги.Добавить(Строка.number + ": " + ДобавитьОплатуПоСтрокам(СсылкаЗаказ, СтрокиОплаты, ЗначениеIdPay));
			Продолжить;
		КонецЕсли;
		
		// Как раньше: эквайринг на весь заказ.
		Итоги.Добавить(Строка.number + ": " + СоздатьОперациюПоПлатежнымКартам(СсылкаЗаказ,
			?(ЗначениеЗаполнено(ЗначениеIdPay), ЗначениеIdPay, Ложь)));
		
		Если ЕстьСтрокиОплаты И ЕстьОплатаПодарочнойКартой(СтрокиОплаты) Тогда
			Итоги.Добавить("Внимание: " + Строка.number + " - оплата подарочной картой не принята, "
				+ "выключена настройка «Получать оплату подарочной картой». Эквайринг создан на всю сумму заказа");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрСоединить(Итоги, Символы.ПС);
	
КонецФункции



