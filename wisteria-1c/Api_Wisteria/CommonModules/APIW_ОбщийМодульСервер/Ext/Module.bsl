//#Вставка
// Убирает "+", пробелы, скобки, дефисы — оставляет только цифры.
// Нужна, потому что НомерТелефонаДляПоиска хранится без "+",
// а входящий телефон из JSON иногда приходит с "+".
Функция НормализоватьТелефон(Телефон)
	
	Рез = СокрЛП(Телефон);
	Рез = СтрЗаменить(Рез, "+", "");
	Рез = СтрЗаменить(Рез, " ", "");
	Рез = СтрЗаменить(Рез, Символы.НПП, "");
	Рез = СтрЗаменить(Рез, "-", "");
	Рез = СтрЗаменить(Рез, "(", "");
	Рез = СтрЗаменить(Рез, ")", "");
	
	Возврат Рез;
	
КонецФункции
//#КонецВставки

// =============================================================================
// Проверка заказа с сайта до создания (08.11.2026).
// Возвращает массив текстов ошибок; пустой - заказ можно создавать.
// Предупреждения (заказ создаётся) добавляются в переданный массив.
// =============================================================================
Функция ПроверитьДанныеЗаказа(Данные, Предупреждения)
	
	Ошибки = Новый Массив;
	Настройки = Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки;
	ГдеНастройка = " в настройках обмена API (Основные настройки)";
	
	// --- Настройки обмена ---
	Если Не ЗначениеЗаполнено(Настройки.ОрганизацияДляОтбора) Тогда
		Ошибки.Добавить("Не заполнена организация" + ГдеНастройка);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Настройки.СкладИнтернетМагазина) Тогда
		Ошибки.Добавить("Не заполнен склад интернет-магазина" + ГдеНастройка);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Настройки.СостояниеНовогоЗаказа) Тогда
		Ошибки.Добавить("Не заполнено состояние нового заказа" + ГдеНастройка);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Настройки.НоменклатураДоставки) Тогда
		Ошибки.Добавить("Не заполнена номенклатура доставки" + ГдеНастройка);
	Иначе
		ПроверитьНоменклатуруЗаказа(Настройки.НоменклатураДоставки, Ошибки, ", номенклатура доставки из настроек обмена API");
	КонецЕсли;
	
	// --- Поля, без которых нельзя создать покупателя и заказ ---
	// Адрес: поле должно быть, значение может быть пустым или null.
	ПоляАдреса = "counterparty_index, counterparty_country, counterparty_region, counterparty_city, "
		+ "counterparty_street, counterparty_house_number, counterparty_building";
	Для каждого Поле Из СтрРазделить(ПоляАдреса, ", ", Ложь) Цикл
		Если Не Данные.Свойство(Поле) Тогда
			Ошибки.Добавить("В данных заказа нет поля «" + Поле + "»");
		КонецЕсли;
	КонецЦикла;
	Для каждого Поле Из СтрРазделить("counterparty_pfone, tovar", ", ", Ложь) Цикл
		Если Не Данные.Свойство(Поле) Тогда
			Ошибки.Добавить("В данных заказа нет поля «" + Поле + "»");
		ИначеЕсли Данные[Поле] = Неопределено Тогда
			Ошибки.Добавить("В данных заказа поле «" + Поле + "» пустое (null)");
		КонецЕсли;
	КонецЦикла;
	Если Ошибки.Количество() > 0 Тогда
		Возврат Ошибки; // без этих полей остальные проверки не имеют смысла
	КонецЕсли;
	
	// --- Покупатель ---
	Телефон = НормализоватьТелефон(ТекстЗначенияJSON(Данные.counterparty_pfone));
	Если ПустаяСтрока(Телефон) Тогда
		Ошибки.Добавить("Не указан телефон покупателя (counterparty_pfone)");
	ИначеЕсли НайтиПокупателя(Телефон) = Ложь
		И ПустаяСтрока(ЗначениеПоляJSON(Данные, "counterparty_naming", "")) Тогда
		Ошибки.Добавить("Покупатель с телефоном " + Телефон + " не найден в 1С, а имя для нового покупателя (counterparty_naming) не указано");
	КонецЕсли;
	
	// --- Доставка ---
	СпособДоставки = СокрЛП(ТекстЗначенияJSON(ЗначениеПоляJSON(Данные, "delivery_method", "")));
	Если СпособыДоставкиСайта().Получить(СпособДоставки) = Неопределено Тогда
		Допустимые = Новый Массив;
		Для каждого КлючЗначение Из СпособыДоставкиСайта() Цикл
			Допустимые.Добавить(КлючЗначение.Ключ);
		КонецЦикла;
		Предупреждения.Добавить("способ доставки «" + СпособДоставки + "» (delivery_method) неизвестен, в заказе не заполнен. Допустимые: "
			+ СтрСоединить(Допустимые, ", "));
	КонецЕсли;
	
	ПроверитьЧислоJSON(Данные, "cost_delivery", "Стоимость доставки", Ложь, Ошибки);
	ПроверитьДатуJSON(Данные, "time_delivery_s", "время доставки с", Предупреждения);
	ПроверитьДатуJSON(Данные, "time_delivery_po", "время доставки по", Предупреждения);
	ПроверитьДатуJSON(Данные, "expected_delivery_date", "ожидаемая дата вручения", Предупреждения);
	
	// --- Товары ---
	Если ТипЗнч(Данные.tovar) <> Тип("Массив") Или Данные.tovar.Количество() = 0 Тогда
		Ошибки.Добавить("В заказе нет товаров (tovar)");
		Возврат Ошибки;
	КонецЕсли;
	
	НомерСтроки = 0;
	Для каждого СтрокаТовара Из Данные.tovar Цикл
		
		НомерСтроки = НомерСтроки + 1;
		ГдеСтрока = "Товар " + НомерСтроки + ": ";
		
		Если ТипЗнч(СтрокаТовара) <> Тип("Структура") Тогда
			Ошибки.Добавить(ГдеСтрока + "строка товара не в формате объекта JSON");
			Продолжить;
		КонецЕсли;
		
		УИД = СокрЛП(ТекстЗначенияJSON(ЗначениеПоляJSON(СтрокаТовара, "product_id", "")));
		Попытка
			СсылкаНаТовар = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
		Исключение
			Ошибки.Добавить(ГдеСтрока + "некорректный УИД товара (product_id) «" + УИД + "»");
			Продолжить;
		КонецПопытки;
		
		Если Не ОбщегоНазначения.СсылкаСуществует(СсылкаНаТовар) Тогда
			Ошибки.Добавить(ГдеСтрока + "номенклатура с УИД " + УИД + " не найдена в 1С");
		Иначе
			ПроверитьНоменклатуруЗаказа(СсылкаНаТовар, Ошибки);
		КонецЕсли;
		
		ПредставлениеСтроки = ГдеСтрока + "(УИД " + УИД + ") ";
		ПроверитьЧислоJSON(СтрокаТовара, "quantity", ПредставлениеСтроки + "количество", Истина, Ошибки, Истина);
		ПроверитьЧислоJSON(СтрокаТовара, "price", ПредставлениеСтроки + "цена", Истина, Ошибки);
		ПроверитьЧислоJSON(СтрокаТовара, "discount_amount", ПредставлениеСтроки + "скидка", Ложь, Ошибки);
		
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции

// Номенклатура строки заказа (или доставки): не группа, не помечена на удаление,
// заполнены единица измерения и ставка НДС, ставка есть в справочнике «Ставки НДС».
Процедура ПроверитьНоменклатуруЗаказа(Номенклатура, Ошибки, Пояснение = "")
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура,
		"Наименование, Артикул, ВидСтавкиНДС, ЕдиницаИзмерения, ПометкаУдаления, ЭтоГруппа");
	
	Наименование = ?(Реквизиты.Наименование = Null, "", СокрЛП(Реквизиты.Наименование));
	Артикул      = ?(Реквизиты.Артикул = Null, "", СокрЛП(Реквизиты.Артикул));
	Представление = "«" + Наименование + "»" + ?(ПустаяСтрока(Артикул), "", " (артикул " + Артикул + ")") + Пояснение;
	
	Если Реквизиты.ЭтоГруппа = Истина Тогда
		Ошибки.Добавить("Номенклатура " + Представление + " - это группа, а не товар");
		Возврат;
	КонецЕсли;
	Если Реквизиты.ПометкаУдаления = Истина Тогда
		Ошибки.Добавить("Номенклатура " + Представление + " помечена на удаление");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Реквизиты.ЕдиницаИзмерения) Тогда
		Ошибки.Добавить("В номенклатуре " + Представление + " не заполнена единица измерения");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Реквизиты.ВидСтавкиНДС) Тогда
		Ошибки.Добавить("В номенклатуре " + Представление + " не заполнена ставка НДС");
	ИначеЕсли ПолучитьСтавкуНДС(Реквизиты.ВидСтавкиНДС) = Неопределено Тогда
		Ошибки.Добавить("Для номенклатуры " + Представление + " не найдена ставка НДС вида «"
			+ Реквизиты.ВидСтавкиНДС + "» в справочнике «Ставки НДС»");
	КонецЕсли;
	
КонецПроцедуры

// Значение поля структуры из JSON; если поля нет или оно null - ПоУмолчанию.
Функция ЗначениеПоляJSON(Данные, ИмяПоля, ПоУмолчанию = Неопределено)
	
	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство(ИмяПоля, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат ПоУмолчанию;
	
КонецФункции

// Число из поля JSON: число или строка ("8900", "8900.50", "8900,50"). Пусто - 0.
// Неверное значение - Неопределено.
Функция ЧислоИзЗначенияJSON(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Текст = СтрЗаменить(СокрЛП(ТекстЗначенияJSON(Значение)), ",", ".");
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат Неопределено; // не число
	КонецПопытки;
	
КонецФункции

Функция ЧислоПоляJSON(Данные, ИмяПоля)
	
	Результат = ЧислоИзЗначенияJSON(ЗначениеПоляJSON(Данные, ИмяПоля, ""));
	Возврат ?(Результат = Неопределено, 0, Результат);
	
КонецФункции

Процедура ПроверитьЧислоJSON(Данные, ИмяПоля, Представление, Обязательное, Ошибки, БольшеНуля = Ложь)
	
	Значение = ЗначениеПоляJSON(Данные, ИмяПоля, "");
	Если Обязательное И ПустаяСтрока(ТекстЗначенияJSON(Значение)) Тогда
		Ошибки.Добавить(Представление + ": не указано значение (" + ИмяПоля + ")");
		Возврат;
	КонецЕсли;
	
	Число = ЧислоИзЗначенияJSON(Значение);
	Если Число = Неопределено Тогда
		Ошибки.Добавить(Представление + ": «" + Значение + "» не число (" + ИмяПоля + ")");
	ИначеЕсли Число < 0 Или (БольшеНуля И Число = 0) Тогда
		Ошибки.Добавить(Представление + ": недопустимое значение " + Значение + " (" + ИмяПоля + ")");
	КонецЕсли;
	
КонецПроцедуры

// Дата из поля JSON в формате ГГГГММДДччммсс (как присылает сайт). Пусто или не дата - пустая дата.
Функция ДатаПоляJSON(Данные, ИмяПоля)
	
	Текст = СокрЛП(ТекстЗначенияJSON(ЗначениеПоляJSON(Данные, ИмяПоля, "")));
	Если ПустаяСтрока(Текст) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Попытка
		Возврат Дата(Текст);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
	
КонецФункции

// Неверная дата - не ошибка: заказ создаётся с пустой датой, в ответ и Telegram - «Внимание».
Процедура ПроверитьДатуJSON(Данные, ИмяПоля, Представление, Предупреждения)
	
	Текст = СокрЛП(ТекстЗначенияJSON(ЗначениеПоляJSON(Данные, ИмяПоля, "")));
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ПроверочнаяДата = Дата(Текст);
	Исключение
		Предупреждения.Добавить(Представление + " «" + Текст + "» (" + ИмяПоля
			+ ") не распознано, ожидается ГГГГММДДччммсс - в заказе не заполнено");
	КонецПопытки;
	
КонецПроцедуры

// Значение из JSON текстом: число - без разделителей разрядов (Строка(12345) дала бы «12 345»).
Функция ТекстЗначенияJSON(Значение)
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧН=0; ЧГ=0");
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции

// Текст ошибки записи/проведения вместе с сообщениями 1С (почему не провелось).
Функция ТекстОшибкиЗаписи(Информация)
	
	Части = Новый Массив;
	Части.Добавить(КраткоеПредставлениеОшибки(Информация));
	
	Для каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		ТекстСообщения = СокрЛП(Сообщение.Текст);
		Если Не ПустаяСтрока(ТекстСообщения) И Части.Найти(ТекстСообщения) = Неопределено Тогда
			Части.Добавить(ТекстСообщения);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(Части, "; ");
	
КонецФункции

// Данные заказа уже проверены в ПроверитьДанныеЗаказа. Ошибки записи - исключением с понятным текстом.
Функция СоздатьЗаказПокупателя(СтруктураДанных, КонтрагентСсылка, Предупреждения = Неопределено)
    
    ОрганизацияДляДок = Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.ОрганизацияДляОтбора;
    
    НовыйДокумент = Документы.ЗаказПокупателя.СоздатьДокумент();  
    НовыйДокумент.Номер             	    = СтруктураДанных.number;
	НовыйДокумент.СтруктурнаяЕдиницаРезерв  = ПолучитьСкладИнтернетМагазина(); 
    НовыйДокумент.АдресДоставки     	    = ТекстЗначенияJSON(СтруктураДанных.counterparty_index) + 
	"," + СтруктураДанных.counterparty_country + ", " + СтруктураДанных.counterparty_region + ", " + 
	СтруктураДанных.counterparty_city + ", " + СтруктураДанных.counterparty_street + ", " + 
	СтруктураДанных.counterparty_house_number + ", " + СтруктураДанных.counterparty_building;
    НовыйДокумент.СпособДоставки    		= ПолучитьПеречислениеСпособыДоставки(ЗначениеПоляJSON(СтруктураДанных, "delivery_method", ""));
	
	СлужбаДоставки = СокрЛП(ЗначениеПоляJSON(СтруктураДанных, "delivery_services", ""));
	Если ЗначениеЗаполнено(СлужбаДоставки) Тогда
		НовыйДокумент.СлужбаДоставки = Справочники.СлужбыДоставки.НайтиПоНаименованию(СлужбаДоставки);
		Если Не ЗначениеЗаполнено(НовыйДокумент.СлужбаДоставки) И Предупреждения <> Неопределено Тогда
			Предупреждения.Добавить("служба доставки «" + СлужбаДоставки
				+ "» не найдена в справочнике «Службы доставки», в заказе не заполнена");
		КонецЕсли;
	КонецЕсли;
	
    НовыйДокумент.СтоимостьДоставки 		= ЧислоПоляJSON(СтруктураДанных, "cost_delivery");
    НовыйДокумент.ВремяДоставкиС    		= ДатаПоляJSON(СтруктураДанных, "time_delivery_s");
    НовыйДокумент.ВремяДоставкиПо  	 		= ДатаПоляJSON(СтруктураДанных, "time_delivery_po");
    НовыйДокумент.Комментарий       		= "Загружен автоматически с сайта " + ТекущаяДата() + Символы.ПС + ЗначениеПоляJSON(СтруктураДанных, "comment", "");
    НовыйДокумент.Контрагент       	 		= КонтрагентСсылка;
    НовыйДокумент.Дата             	 		= ТекущаяДата();
    НовыйДокумент.Организация       		= ОрганизацияДляДок; 
    НовыйДокумент.ДатаОтгрузки      		= ТекущаяДата();
    НовыйДокумент.СостояниеЗаказа   		= Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.СостояниеНовогоЗаказа; 
	НовыйДокумент.НоменклатураДоставки  	= Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.НоменклатураДоставки; 
	НовыйДокумент.ОжидаемаяДатаВручения 	= ДатаПоляJSON(СтруктураДанных, "expected_delivery_date");
    НовыйДокумент.Заполнить(Неопределено);
    
	СтавкаДоставки = ПолучитьСтавкуНДС(НовыйДокумент.НоменклатураДоставки.ВидСтавкиНДС);
	
	НовыйДокумент.СтавкаНДСДоставки = СтавкаДоставки.Ссылка;
	НовыйДокумент.СуммаНДСДоставки  = УчетНДСКлиентСервер.РассчитатьСуммуНДС(НовыйДокумент.СтоимостьДоставки, Истина, СтавкаДоставки.Ставка);
    
	Для каждого Строка Из СтруктураДанных.tovar Цикл
		
        СсылкаНаТовар = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.product_id));
        СтавкаНДС     = ПолучитьСтавкуНДС(СсылкаНаТовар.ВидСтавкиНДС);
        
		Количество = ЧислоПоляJSON(Строка, "quantity");
		Цена       = ЧислоПоляJSON(Строка, "price");
		Скидка     = ЧислоПоляJSON(Строка, "discount_amount");
        Сумма      = Количество * Цена - Скидка;
        
        ТоварыДок                       = НовыйДокумент.Запасы.Добавить();
		ТоварыДок.ТипНоменклатурыЗапас  = Истина;
        ТоварыДок.Номенклатура          = СсылкаНаТовар;  
        ТоварыДок.Количество            = Количество;
        ТоварыДок.Цена                  = Цена;
        ТоварыДок.ЕдиницаИзмерения      = СсылкаНаТовар.ЕдиницаИзмерения;
        ТоварыДок.Сумма                 = Сумма;
        ТоварыДок.СтавкаНДС             = СтавкаНДС.Ссылка;
        ТоварыДок.СуммаСкидкиНаценки    = Скидка;
		ТоварыДок.ПроцентСкидкиНаценки  = ?(Количество * Цена = 0, 0, Скидка / (Количество * Цена) * 100);
        ТоварыДок.СуммаНДС              = УчетНДСКлиентСервер.РассчитатьСуммуНДС(Сумма, Истина, СтавкаНДС.Ставка);
		ТоварыДок.Всего                 = Сумма; 
		ТоварыДок.Резерв                = Количество;
		
    КонецЦикла; 
    
    // === Пересчёт итогов по документу ===
    НовыйДокумент.СуммаДокумента = НовыйДокумент.Запасы.Итог("Сумма") + НовыйДокумент.СтоимостьДоставки;
    Попытка
        НовыйДокумент.Записать();
    Исключение  
		ВызватьИсключение "Не удалось записать заказ покупателя: " + ТекстОшибкиЗаписи(ИнформацияОбОшибке());
    КонецПопытки;
	
	Возврат НовыйДокумент.Ссылка;
	
КонецФункции

Функция ПолучитьСтавкуНДС(ВидСтавкиНДС)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтавкиНДС.Ссылка КАК Ссылка,
		|	СтавкиНДС.ВерсияДанных КАК ВерсияДанных,
		|	СтавкиНДС.ПометкаУдаления КАК ПометкаУдаления,
		|	СтавкиНДС.Наименование КАК Наименование,
		|	СтавкиНДС.Ставка КАК Ставка,
		|	СтавкиНДС.НеОблагается КАК НеОблагается,
		|	СтавкиНДС.Расчетная КАК Расчетная,
		|	СтавкиНДС.ВидСтавкиНДС КАК ВидСтавкиНДС,
		|	СтавкиНДС.ПеречислениеСтавкаНДС КАК ПеречислениеСтавкаНДС,
		|	СтавкиНДС.Предопределенный КАК Предопределенный,
		|	СтавкиНДС.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
		|	СтавкиНДС.Представление КАК Представление
		|ИЗ
		|	Справочник.СтавкиНДС КАК СтавкиНДС
		|ГДЕ
		|	СтавкиНДС.ВидСтавкиНДС = &ВидСтавкиНДС
		|	И (НЕ &ВидСтавкиНДС В (ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.Общая), ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.ОбщаяРасчетная))
		|			ИЛИ СтавкиНДС.Ставка = ВЫБОР
		|				КОГДА &ТекущаяДата >= ДАТАВРЕМЯ(2026, 1, 1)
		|					ТОГДА 22
		|				КОГДА &ТекущаяДата >= ДАТАВРЕМЯ(2019, 1, 1)
		|					ТОГДА 20
		|				ИНАЧЕ 18
		|			КОНЕЦ)";
	
	Запрос.УстановитьПараметр("ВидСтавкиНДС", ВидСтавкиНДС);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		Стр = Новый Структура;
		Стр.Вставить("Ставка", ВыборкаДетальныеЗаписи.Ставка);
		Стр.Вставить("Ссылка", ВыборкаДетальныеЗаписи.Ссылка);
		Возврат Стр; 
	КонецЦикла;
	
КонецФункции 

Функция ПолучитьПеречислениеСпособыДоставки(СпособДоставки)

	Возврат СпособыДоставкиСайта().Получить(СокрЛП(ТекстЗначенияJSON(СпособДоставки)));
	
