Функция ЗагрузитьЗаказJSON(СтрокаJSON) Экспорт 
	
	Если Не Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.ЗагружатьЗаказы Тогда
		Возврат "Загрузка заказов отключена в настройках";
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);

	НоменклатураМассив = ПрочитатьJSON(ЧтениеJSON);
	Для Каждого СтрокаМассива Из НоменклатураМассив Цикл
		
		НомерЗаказа = СокрЛП(ТекстЗначенияJSON(ЗначениеПоляJSON(СтрокаМассива, "number", "")));
		Если ПустаяСтрока(НомерЗаказа) Тогда
			ВызватьИсключение "Заказ не может быть создан: в данных нет номера заказа (поле number)";
		КонецЕсли;
		
		НайтиДок = НайтиЗаказ(НомерЗаказа);
		Если НайтиДок <> Ложь Тогда
			Возврат "Заказ уже создан в 1С";
		КонецЕсли;
		
		// 1. Проверка всех данных до создания чего-либо: все ошибки одним текстом (сайт - ответ 500, Telegram).
		Предупреждения = Новый Массив;
		Ошибки = ПроверитьДанныеЗаказа(СтрокаМассива, Предупреждения);
		Если Ошибки.Количество() > 0 Тогда
			ВызватьИсключение "Заказ " + НомерЗаказа + " не может быть создан:" + Символы.ПС
				+ "- " + СтрСоединить(Ошибки, Символы.ПС + "- ");
		КонецЕсли;
		
		// 2. Создание - всё или ничего: при ошибке в базе не остаётся ни покупателя, ни заказа, ни перемещений.
		//    Заказ здесь записывается без проведения, проводится после фиксации (шаг 3).
		НачатьТранзакцию();
		Попытка
			
			ЕстьКлиент = ПроверитьПокупателя(СтрокаМассива.counterparty_pfone); 
			Если ЕстьКлиент = Ложь Тогда //Создать нового клиента 
				ЕстьКлиент = СоздатьОбновитьПокупателя(СтрокаМассива, Истина);
			Иначе
				ДобавитьКонтактыКонтрагенту(СтрокаМассива, ЕстьКлиент);
			КонецЕсли;
			
			СсылкаНаНовыйЗаказ = СоздатьЗаказПокупателя(СтрокаМассива, ЕстьКлиент, Предупреждения);
			
			ПодготовитьРезервТоваров(СсылкаНаНовыйЗаказ, Предупреждения);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			ВызватьИсключение "Заказ " + НомерЗаказа + " не создан, в 1С ничего не записано:" + Символы.ПС
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		// 3. Проведение заказа. Если не провёлся (например, не хватает остатков под резерв) -
		//    заказ остаётся в 1С непроведённым, как раньше, причина - в «Внимание».
		Попытка
			ОбъектЗаказ = СсылкаНаНовыйЗаказ.ПолучитьОбъект();
			ОбъектЗаказ.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Предупреждения.Добавить("заказ записан, но НЕ ПРОВЕДЁН: " + ТекстОшибкиЗаписи(ИнформацияОбОшибке()));
		КонецПопытки;
		
		Результат = "Заказ успешно создан в 1С";
		Для каждого Предупреждение Из Предупреждения Цикл
			Результат = Результат + Символы.ПС + "Внимание: " + Предупреждение;
		КонецЦикла;
		
		Возврат Результат;
		
	КонецЦикла;

КонецФункции 

Функция ДобавитьТрекНомерВЗаказ(ТрекНомерJSON) Экспорт 
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ТрекНомерJSON);
	МассивJSON = ПрочитатьJSON(ЧтениеJSON);
	
	Для каждого Строка Из МассивJSON Цикл
		
		ЗаказНайден = НайтиЗаказ(Строка.number);
		Если Не ЗаказНайден = Ложь Тогда
			ОбъектЗаказ = ЗаказНайден.ПолучитьОбъект();
			ОбъектЗаказ.ТрекНомер = Строка.trak_number; 
						
			Попытка
				ОбъектЗаказ.Записать();
			Исключение
				Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			
		Иначе
			Возврат "Заказ: " + Строка.number + " не найден в 1С";
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат "Даные успешно записаны в заказ: " + Строка.number; 
	
КонецФункции 

