Функция СоздатьОбновитьПокупателя(СтруктураКонтрагента, НовыйПокупатель)
	
	Если НовыйПокупатель = Истина Тогда
		Контрагент  = Справочники.Контрагенты.СоздатьЭлемент();
	Иначе
		НайденПокупатель = НайтиПокупателя(СтруктураКонтрагента.counterparty_pfone);
		Если Не НайденПокупатель = Ложь Тогда
			Контрагент = НайденПокупатель.Ссылка.ПолучитьОбъект();
		КонецЕсли;	
	КонецЕсли;
	
	Контрагент.Наименование			 	= СтруктураКонтрагента.counterparty_naming; 
	Контрагент.ВидКонтрагента			= Перечисления.ВидыКонтрагентов.ФизическоеЛицо;
	Контрагент.Покупатель				= Истина;
	//#Вставка
	Контрагент.НомерТелефонаДляПоиска	= НормализоватьТелефон(СтруктураКонтрагента.counterparty_pfone);
	//#КонецВставки
	Контрагент.Комментарий				= "Загружен автоматически с сайта " + ТекущаяДата();
	Контрагент.ВестиРасчетыПоДокументам = Истина;
	Контрагент.ВестиРасчетыПоЗаказам    = Истина;
	Контрагент.ВестиУчетОплатыПоСчетам  = Истина;  
	
	Попытка
        Контрагент.Записать();
    Исключение  
        Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
	
	ДобавитьКонтактыКонтрагенту(СтруктураКонтрагента, Контрагент.Ссылка);
	
	Возврат Контрагент.Ссылка;
	
КонецФункции

Процедура ДобавитьКонтактыКонтрагенту(СтруктураКонтрагента, СсылкаКонтрагент)
		
    Объект = СсылкаКонтрагент.ПолучитьОбъект();
	
	// --- Телефон: удаляем старые записи и добавляем актуальный ---
	СтрокиНаУдаление = Новый Массив;
    //#Вставка
    Для каждого Строка Из Объект.КонтактнаяИнформация Цикл
        Если Строка.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
            СтрокиНаУдаление.Добавить(Строка);
        КонецЕсли;
    КонецЦикла;
    //#КонецВставки
    Для каждого Строка Из СтрокиНаУдаление Цикл
        Объект.КонтактнаяИнформация.Удалить(Строка);
    КонецЦикла;
	

    // --- Телефон ---
    СтрокаТелефон = Объект.КонтактнаяИнформация.Добавить();
    СтрокаТелефон.Вид           = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
    СтрокаТелефон.Тип           = Перечисления.ТипыКонтактнойИнформации.Телефон;
    //#Вставка
    СтрокаТелефон.Представление = НормализоватьТелефон(СтруктураКонтрагента.counterparty_pfone);
    //#КонецВставки
    
    ЗначенияТелефона = Новый Структура;
    //#Вставка
    ЗначенияТелефона.Вставить("НомерТелефона", НормализоватьТелефон(СтруктураКонтрагента.counterparty_pfone));
    //#КонецВставки
    СтрокаТелефон.ЗначенияПолей = УправлениеКонтактнойИнформациейСлужебный.СтруктураВСтрокуJSON(
        ЗначенияТелефона);
    
    //#Вставка
    // --- Адрес: не удаляем старые, ищем совпадение и добавляем только если такого ещё нет ---
    ВидДоставка = Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Доставка");
    
    НовыйАдресТекст = СокрЛП(СтруктураКонтрагента.counterparty_index) + 
	"," + СокрЛП(СтруктураКонтрагента.counterparty_country) + ", " + СокрЛП(СтруктураКонтрагента.counterparty_region) + ", " + 
	СокрЛП(СтруктураКонтрагента.counterparty_city) + ", " + СокрЛП(СтруктураКонтрагента.counterparty_street) + ", " + 
	СокрЛП(СтруктураКонтрагента.counterparty_house_number) + ", " + СокрЛП(СтруктураКонтрагента.counterparty_building);
    
    АдресНайден = Ложь;
    Для каждого СтрокаКИ Из Объект.КонтактнаяИнформация Цикл
        Если СтрокаКИ.Вид = ВидДоставка 
            И СтрСравнить(СокрЛП(СтрокаКИ.Представление), СокрЛП(НовыйАдресТекст)) = 0 Тогда
            АдресНайден = Истина;
            Прервать;
        КонецЕсли;
    КонецЦикла;
    
    Если Не АдресНайден Тогда
        
        СтрокаАдрес = Объект.КонтактнаяИнформация.Добавить();
        СтрокаАдрес.Вид           = ВидДоставка;
        СтрокаАдрес.Тип           = Перечисления.ТипыКонтактнойИнформации.Адрес;
        СтрокаАдрес.Представление = НовыйАдресТекст;
        
        ЗначенияАдреса = Новый Структура;
        ЗначенияАдреса.Вставить("КонтрагентИндекс", СтруктураКонтрагента.counterparty_index);
        ЗначенияАдреса.Вставить("Страна",           СтруктураКонтрагента.counterparty_country);
        ЗначенияАдреса.Вставить("Регион",           СтруктураКонтрагента.counterparty_region);
        ЗначенияАдреса.Вставить("Город",            СтруктураКонтрагента.counterparty_city);   
	    ЗначенияАдреса.Вставить("Улица",			 СтруктураКонтрагента.counterparty_street);
        ЗначенияАдреса.Вставить("Дом",    			 СтруктураКонтрагента.counterparty_house_number);
        ЗначенияАдреса.Вставить("Корпус", 			 СтруктураКонтрагента.counterparty_building);  
	
        СтрокаАдрес.ЗначенияПолей = УправлениеКонтактнойИнформациейСлужебный.СтруктураВСтрокуJSON(
            ЗначенияАдреса);
        
    КонецЕсли;
    //#КонецВставки
    
    Объект.Записать();
    
КонецПроцедуры

Функция СоздатьОперациюПоПлатежнымКартам(СсылкаЗаказ, УИДЭквайринг)
	
	ОбъектЗаказ = СсылкаЗаказ.ПолучитьОбъект();
	
	// --- Проверка на уже созданные документы оплаты ---
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|   ОперацияПоПлатежнымКартам.Ссылка КАК Ссылка
	|ИЗ
	|   Документ.ОперацияПоПлатежнымКартам КАК ОперацияПоПлатежнымКартам
	|ГДЕ
	|   ОперацияПоПлатежнымКартам.ДокументОснование = &ЗаказПокупателя
	|   И ОперацияПоПлатежнымКартам.Проведен = ИСТИНА
	|   И ОперацияПоПлатежнымКартам.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", СсылкаЗаказ);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаСтрока = РезультатЗапроса.Выбрать();
		ВыборкаСтрока.Следующий();
		Возврат "Оплата по заказу уже создана: " + ВыборкаСтрока.Ссылка;
	КонецЕсли;
	
	// --- Создаём новый документ ---
	НовыйДокумент = Документы.ОперацияПоПлатежнымКартам.СоздатьДокумент();
	
	// --- Шапка документа ---
	НовыйДокумент.Дата                   = ТекущаяДата();
	НовыйДокумент.Организация            = ОбъектЗаказ.Организация;
	НовыйДокумент.Контрагент             = ОбъектЗаказ.Контрагент;
	НовыйДокумент.ВалютаДенежныхСредств  = ОбъектЗаказ.ВалютаДокумента;
	НовыйДокумент.СуммаДокумента         = ОбъектЗаказ.СуммаДокумента;
	НовыйДокумент.ВидОперации            = Перечисления.ВидыОперацийЭквайринга.ПоступлениеОплатыОтПокупателя;
	НовыйДокумент.ДокументОснование      = СсылкаЗаказ;
	НовыйДокумент.Статья                 = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Оплата от покупателей");
		
	Если УИДЭквайринг = Ложь Тогда
		НовыйДокумент.ЭквайринговыйТерминал = Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.ЭквайринговыйТерминал;
	Иначе
		СсылкаЭквайринг = Неопределено;
		Попытка
			СсылкаЭквайринг = Справочники.СпособыОплаты.ПолучитьСсылку(Новый УникальныйИдентификатор(УИДЭквайринг));
		Исключение
			СсылкаЭквайринг = Неопределено;
		КонецПопытки;
		
		Если СсылкаЭквайринг = Неопределено Тогда
			НовыйДокумент.ЭквайринговыйТерминал = Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.ЭквайринговыйТерминал;
		Иначе
			НовыйДокумент.ЭквайринговыйТерминал = СсылкаЭквайринг;
		КонецЕсли;
	КонецЕсли;	
	
	
	НовыйДокумент.ВидПлатежнойКарты      = "ЮKassa"; 
	НовыйДокумент.НалогообложениеНДС     = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
	НовыйДокумент.СпособОплаты           = Перечисления.СпособыОплатыЭквайринг.ОплатаОнлайн;  
	НовыйДокумент.Комментарий			 = "Загружен автоматически с сайта " + ТекущаяДата();
	
	// --- Банковский счёт: если не заполнен, берём счёт организации по умолчанию ---
	Если Не ЗначениеЗаполнено(НовыйДокумент.БанковскийСчет) Тогда
		НовыйДокумент.БанковскийСчет = НовыйДокумент.Организация.БанковскийСчетПоУмолчанию;
	КонецЕсли;
	
	// --- Группировка сумм по ставкам НДС ---
	СуммыПоСтавкамНДС = Новый Соответствие;
	
	Для каждого СтрокаЗаказа Из ОбъектЗаказ.Запасы Цикл
		
		СтавкаНДС = СтрокаЗаказа.СтавкаНДС;
		
		Если СуммыПоСтавкамНДС[СтавкаНДС] = Неопределено Тогда
			НоваяГруппа = Новый Структура;
			НоваяГруппа.Вставить("Сумма",    0);
			НоваяГруппа.Вставить("СуммаНДС", 0);
			СуммыПоСтавкамНДС.Вставить(СтавкаНДС, НоваяГруппа);
		КонецЕсли;
		
		СуммыПоСтавкамНДС[СтавкаНДС].Сумма    = СуммыПоСтавкамНДС[СтавкаНДС].Сумма    + СтрокаЗаказа.Сумма;
		СуммыПоСтавкамНДС[СтавкаНДС].СуммаНДС = СуммыПоСтавкамНДС[СтавкаНДС].СуммаНДС + СтрокаЗаказа.СуммаНДС;
		
	КонецЦикла;
	
	// --- Распределение стоимости доставки по ставкам НДС ---
	СтоимостьДоставки = ОбъектЗаказ.СтоимостьДоставки;
	
	Если СтоимостьДоставки <> 0 Тогда
		
		ОбщаяСуммаЗапасов = 0;
		Для каждого КлючЗначение Из СуммыПоСтавкамНДС Цикл
			ОбщаяСуммаЗапасов = ОбщаяСуммаЗапасов + КлючЗначение.Значение.Сумма;
		КонецЦикла;
		
		Если ОбщаяСуммаЗапасов <> 0 Тогда
			
			ОстатокДоставки = СтоимостьДоставки;
			Счетчик         = 0;
			КоличествоГрупп = СуммыПоСтавкамНДС.Количество();
			
			Для каждого КлючЗначение Из СуммыПоСтавкамНДС Цикл
				
				Счетчик    = Счетчик + 1;
				ГруппаСумм = КлючЗначение.Значение;
				
				Если Счетчик = КоличествоГрупп Тогда
					// В последнюю группу — остаток, чтобы избежать копеечной ошибки округления
					ДоляДоставки = ОстатокДоставки;
				Иначе
					ДоляДоставки    = Окр(СтоимостьДоставки * ГруппаСумм.Сумма / ОбщаяСуммаЗапасов, 2);
					ОстатокДоставки = ОстатокДоставки - ДоляДоставки;
				КонецЕсли;
				
				// НДС с доставки считаем по доле НДС внутри группы (та же ставка)
				Если ГруппаСумм.Сумма <> 0 Тогда
					ДоляНДСДоставки = Окр(ДоляДоставки * ГруппаСумм.СуммаНДС / ГруппаСумм.Сумма, 2);
				Иначе
					ДоляНДСДоставки = 0;
				КонецЕсли;
				
				ГруппаСумм.Сумма    = ГруппаСумм.Сумма    + ДоляДоставки;
				ГруппаСумм.СуммаНДС = ГруппаСумм.СуммаНДС + ДоляНДСДоставки;
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	// --- Заполнение табличной части Платежи по каждой ставке НДС ---
	Для каждого КлючЗначение Из СуммыПоСтавкамНДС Цикл
		
		СтавкаНДС  = КлючЗначение.Ключ;
		ГруппаСумм = КлючЗначение.Значение;
		
		НоваяСтрока                  = НовыйДокумент.РасшифровкаПлатежа.Добавить();
		НоваяСтрока.Заказ            = СсылкаЗаказ;
		НоваяСтрока.ПризнакАванса    = Истина;
		НоваяСтрока.СтавкаНДС        = СтавкаНДС;
		НоваяСтрока.СуммаПлатежа     = ГруппаСумм.Сумма;
		НоваяСтрока.СуммаНДС         = ГруппаСумм.СуммаНДС;
		НоваяСтрока.СуммаРасчетов    = ГруппаСумм.Сумма;
		НоваяСтрока.Курс             = 1;
		НоваяСтрока.Кратность        = 1;
		
	КонецЦикла;
	
	// --- Запись и проведение документа ---
	НовыйДокумент.УстановитьНовыйНомер();
	НовыйДокумент.Записать();
	
	Попытка
		НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Возврат ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	ОбъектЗаказ.СостояниеЗаказа = Справочники.APIW_НастройкиОбменаAPI.ОсновныеНастройки.СостояниеОплаченногоЗаказа;
	ОбъектЗаказ.Записать();
	
	Возврат "Данные успешно добавлены";
	
КонецФункции


Функция НайтиПокупателя(Телефон)
	
	//#Вставка
	Телефон = НормализоватьТелефон(Телефон);
	//#КонецВставки
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.НомерТелефонаДляПоиска = &НомерТелефонаДляПоиска";
	
	Запрос.УстановитьПараметр("НомерТелефонаДляПоиска", Телефон);
	
	РезультатЗапроса = Запрос.Выполнить();
	
    Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе	
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Возврат	Выборка.Ссылка;
		КонецЦикла;
	КонецЕсли;
	
КонецФункции  

Функция ПроверитьПокупателя(Телефон)
	
	Возврат НайтиПокупателя(Телефон);    

КонецФункции  

