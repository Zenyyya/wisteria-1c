
#Область РеквизитыФормы

// Реквизиты ОБЪЕКТА обработки (обращение через Объект.ПКВ_..., не напрямую):
//   ПКВ_ТипКарты            — Строка(20)   "electronic" | "plastic"
//   ПКВ_Сценарий             — Строка(10)   "self" | "gift"
//   ПКВ_Номинал              — Число(15,2)
//   ПКВ_ТелефонОтправителя   — Строка(20)
//   ПКВ_ТелефонПолучателя    — Строка(20)
//   ПКВ_Поздравление         — Строка(500)
//   ПКВ_НомерФизКарты        — Строка(50) — для пластика хранит уже
//                               РАЗРЕШЁННЫЙ card_number (после /by-qr),
//                               не сырой штрихкод/хэш с физической карты
//   ПКВ_МаскаТелефона        — Строка(30)   кэш маски РМК
//
// Реквизиты САМОЙ ФОРМЫ (без Объект.):
//   ПКВ_НоминалМинимумКэш   — Число(15,2)  кэш константы ПКВ_НоминалМинимум
//   ПКВ_НоминалМаксимумКэш  — Число(15,2)  кэш константы ПКВ_НоминалМаксимум
//
// Границы номинала — настройка администратора (константы конфигурации),
// не редактируемые кассиром поля формы. Если константы не созданы —
// форма работает без ограничений (0 = не задано).

#КонецОбласти


#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.ПКВ_ТипКарты            = "electronic";
	Объект.ПКВ_Сценарий             = "self";
	Объект.ПКВ_Номинал              = 0;
	Объект.ПКВ_ТелефонОтправителя   = "";
	Объект.ПКВ_ТелефонПолучателя    = "";
	Объект.ПКВ_Поздравление         = "";
	Объект.ПКВ_НомерФизКарты        = "";
	
	Попытка
		ПКВ_НоминалМинимумКэш  = Константы.ПКВ_НоминалМинимум.Получить();
		ПКВ_НоминалМаксимумКэш = Константы.ПКВ_НоминалМаксимум.Получить();
	Исключение
		ПКВ_НоминалМинимумКэш  = 0;
		ПКВ_НоминалМаксимумКэш = 0;
	КонецПопытки;
	
	Объект.ПКВ_МаскаТелефона = ИнтерфейсРМКСлужебныйКлиентСервер.МаскаВводаТелефона();
	Элементы.ПКВ_ТелефонОтправителя.Маска = Объект.ПКВ_МаскаТелефона;
	Элементы.ПКВ_ТелефонПолучателя.Маска  = Объект.ПКВ_МаскаТелефона;
	
	Элементы.ПКВ_НомерФизКарты.Видимость        = (Объект.ПКВ_ТипКарты = "plastic");
	Элементы.ПКВ_ТелефонОтправителя.Видимость   = Истина;
	Элементы.ПКВ_ТелефонПолучателя.Видимость    = (Объект.ПКВ_Сценарий = "gift");
	Элементы.ПКВ_КнопкаТелефонПолучателя.Видимость = (Объект.ПКВ_Сценарий = "gift");
	Элементы.ПКВ_Поздравление.Видимость          = (Объект.ПКВ_Сценарий = "gift");
	
КонецПроцедуры

#КонецОбласти


#Область ПереключениеТипаИСценария

&НаКлиенте
Процедура ПКВ_ТипКартыПриИзменении(Элемент)
	ПКВ_ОбновитьВидимостьПолей();
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_СценарийПриИзменении(Элемент)
	ПКВ_ОбновитьВидимостьПолей();
КонецПроцедуры

// Управляет ВИДИМОСТЬЮ (не обязательностью) полей — оба телефона видимы
// всегда, обязательность зависит от сценария (см. ПКВ_ПроверитьВсеПоля).
&НаКлиенте
Процедура ПКВ_ОбновитьВидимостьПолей()
	
	ЭтоПластик  = (Объект.ПКВ_ТипКарты = "plastic");
	ЭтоПодарок  = (Объект.ПКВ_Сценарий = "gift");
	
	Элементы.ПКВ_НомерФизКарты.Видимость = ЭтоПластик;
	Если НЕ ЭтоПластик Тогда
		Объект.ПКВ_НомерФизКарты = "";
	КонецЕсли;
	
	Элементы.ПКВ_ТелефонОтправителя.Видимость = Истина;
	Элементы.ПКВ_ТелефонПолучателя.Видимость  = ЭтоПодарок;
	Элементы.ПКВ_КнопкаТелефонПолучателя.Видимость = ЭтоПодарок;
	Элементы.ПКВ_Поздравление.Видимость        = ЭтоПодарок;
	
	Если НЕ ЭтоПодарок Тогда
		Объект.ПКВ_ТелефонПолучателя = "";
		Объект.ПКВ_Поздравление       = "";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область РегистрацияКарты

// Форма НИКУДА не пишет и не обращается к API сама (кроме проверки QR
// пластиковой карты при сканировании, см. ниже) — только собирает и
// валидирует данные, результат отдаёт форме-владельцу (ФормаРМК) через
// Закрыть(Структура). Дальше ФормаРМК добавляет строку в чек и кладёт
// данные в буфер ПКВ_ОжидающиеКарты до успешного пробития чека.
&НаКлиенте
Процедура ПКВ_Зарегистрировать(Команда)
	
	Если НЕ ПКВ_ПроверитьВсеПоля() Тогда
		Возврат;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ТипКарты",           Объект.ПКВ_ТипКарты);
	Результат.Вставить("Сценарий",            Объект.ПКВ_Сценарий);
	Результат.Вставить("Номинал",             Объект.ПКВ_Номинал);
	Результат.Вставить("ТелефонОтправителя",  Объект.ПКВ_ТелефонОтправителя);
	Результат.Вставить("ТелефонПолучателя",   Объект.ПКВ_ТелефонПолучателя);
	Результат.Вставить("Поздравление",        Объект.ПКВ_Поздравление);
	Результат.Вставить("НомерФизКарты",       Объект.ПКВ_НомерФизКарты);
	
	Закрыть(Результат);
	
КонецПроцедуры

// Телефон отправителя обязателен ВСЕГДА; телефон получателя — только при
// "в подарок". Оба поля видимы всегда (см. ПКВ_ОбновитьВидимостьПолей).
&НаКлиенте
Функция ПКВ_ПроверитьВсеПоля()
	
	Если НЕ ПКВ_ПроверитьНоминал() Тогда
		ТекущийЭлемент = Элементы.ПКВ_Номинал;
		Возврат Ложь;
	КонецЕсли;
	
	ПриведённыйОтправитель = ПКВ_ПривестиИПроверитьТелефон(Объект.ПКВ_ТелефонОтправителя);
	Если ПриведённыйОтправитель = Неопределено Тогда
		ТекущийЭлемент = Элементы.ПКВ_ТелефонОтправителя;
		Возврат Ложь;
	КонецЕсли;
	Объект.ПКВ_ТелефонОтправителя = ПриведённыйОтправитель;
	
	Если Объект.ПКВ_Сценарий = "gift" Тогда
		ПриведённыйПолучатель = ПКВ_ПривестиИПроверитьТелефон(Объект.ПКВ_ТелефонПолучателя);
		Если ПриведённыйПолучатель = Неопределено Тогда
			ТекущийЭлемент = Элементы.ПКВ_ТелефонПолучателя;
			Возврат Ложь;
		КонецЕсли;
		Объект.ПКВ_ТелефонПолучателя = ПриведённыйПолучатель;
	КонецЕсли;
	
	Если Объект.ПКВ_ТипКарты = "plastic" Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.ПКВ_НомерФизКарты) Тогда
			ПоказатьПредупреждение(, "Отсканируйте QR на физической карте.", , "Внимание");
			ТекущийЭлемент = Элементы.ПКВ_НомерФизКарты;
			Возврат Ложь;
		КонецЕсли;
		
		РезультатПроверки = ПКВ_ПроверитьЧтоКартаНеПроданаНаСервере(Объект.ПКВ_НомерФизКарты);
		
		Если Не РезультатПроверки.Успех Тогда
			ПоказатьПредупреждение(, РезультатПроверки.ТекстОш, , "Ошибка");
			ТекущийЭлемент = Элементы.ПКВ_НомерФизКарты;
			Возврат Ложь;
		КонецЕсли;
		
		Если РезультатПроверки.УжеПродана Тогда
			ПоказатьПредупреждение(, "Эта карта уже продана. Отсканируйте другую карту.", , "Внимание");
			Объект.ПКВ_НомерФизКарты = "";
			ТекущийЭлемент = Элементы.ПКВ_НомерФизКарты;
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПКВ_ПроверитьЧтоКартаНеПроданаНаСервере(НомерКарты)
	
	Возврат ПКВ_ПодарочныеКартыAPI.ПроверитьЧтоКартаНеПродана(НомерКарты);
	
КонецФункции

&НаКлиенте
Функция ПКВ_ПроверитьНоминал()
	
	Если Объект.ПКВ_Номинал <= 0 Тогда
		ПоказатьПредупреждение(, "Укажите номинал карты (больше 0 ₽).", , "Внимание");
		Возврат Ложь;
	КонецЕсли;
	
	Если ПКВ_НоминалМинимумКэш > 0 И Объект.ПКВ_Номинал < ПКВ_НоминалМинимумКэш Тогда
		ПоказатьПредупреждение(, СтрШаблон(
			"Минимальный номинал карты: %1 ₽.",
			Формат(ПКВ_НоминалМинимумКэш, "ЧЦ=10; ЧДЦ=2")), , "Внимание");
		Возврат Ложь;
	КонецЕсли;
	
	Если ПКВ_НоминалМаксимумКэш > 0 И Объект.ПКВ_Номинал > ПКВ_НоминалМаксимумКэш Тогда
		ПоказатьПредупреждение(, СтрШаблон(
			"Максимальный номинал карты: %1 ₽.",
			Формат(ПКВ_НоминалМаксимумКэш, "ЧЦ=10; ЧДЦ=2")), , "Внимание");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Валидация телефона: приведение к маске РМК, затем проверка количества
// цифр (11 для российского номера). Ничего не пишет сама — только
// возвращает приведённый номер либо Неопределено при ошибке (запись в
// нужный реквизит делает вызывающий код, ПКВ_ПроверитьВсеПоля).
&НаКлиенте
Функция ПКВ_ПривестиИПроверитьТелефон(Знач Телефон)
	
	Если НЕ ЗначениеЗаполнено(Телефон) Тогда
		ПоказатьПредупреждение(, "Укажите номер телефона.", , "Внимание");
		Возврат Неопределено;
	КонецЕсли;
	
	ПриведённыйНомер = ИнтерфейсРМКСлужебныйКлиентСервер.ПривестиЗначениеКМаскеТелефона(
		Телефон, Объект.ПКВ_МаскаТелефона);
	
	Если НЕ ЗначениеЗаполнено(ПриведённыйНомер) Тогда
		ПоказатьПредупреждение(, "Некорректный формат номера телефона.
			|Ожидается российский номер вида +7 (XXX) XXX-XX-XX.", , "Внимание");
		Возврат Неопределено;
	КонецЕсли;
	
	ТолькоЦифры = "";
	Для й = 1 По СтрДлина(ПриведённыйНомер) Цикл
		Символ = Сред(ПриведённыйНомер, й, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			ТолькоЦифры = ТолькоЦифры + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрДлина(ТолькоЦифры) <> 11 Тогда
		ПоказатьПредупреждение(, "Некорректный номер телефона. Должно быть 11 цифр
			|(код страны + код оператора + номер).", , "Внимание");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПриведённыйНомер;
	
КонецФункции

&НаКлиенте
Процедура ПКВ_Отмена(Команда)
	Закрыть();
КонецПроцедуры

#КонецОбласти


#Область ОбработкаСканераШтрихкодов

// При сканировании QR на пластиковой карте проверяет её существование в
// Directus через /by-qr и кладёт в ПКВ_НомерФизКарты уже РАЗРЕШЁННЫЙ
// card_number (а не сырой штрихкод/хэш). Если карта не найдена/уже
// продана — предупреждение, поле остаётся пустым (кнопка «Зарегистрировать»
// не пройдёт проверку обязательного поля — отдельной блокировки не нужно).
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник <> "ПодключаемоеОборудование" Тогда
		Возврат;
	КонецЕсли;
	
	Штрихкод = "";
	Если ИмяСобытия = "ScanData" Тогда
		Штрихкод = ?(Параметр[1] = Неопределено, Параметр[0], Параметр[1][1]);
	ИначеЕсли ИмяСобытия = "TracksData" Тогда
		Штрихкод = Параметр[0];
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ПКВ_ПодарочныеКартыAPI.ПолучитьНомерКартыПоХэшу(Штрихкод);
	
	Если Не Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Текст, , "Ошибка");
		Возврат;
	КонецЕсли;
	
	Объект.ПКВ_НомерФизКарты = Результат.НомерКарты;
	
	Если Объект.ПКВ_ТипКарты <> "plastic" Тогда
		Объект.ПКВ_ТипКарты = "plastic";
		ПКВ_ОбновитьВидимостьПолей();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ВводТелефона

&НаКлиенте
Процедура ПКВ_ВвестиТелефонОтправителя(Элемент)
	
	ПараметрыПопапа = ПКВ_ПараметрыПопапаВводаТелефона("Телефон отправителя", Объект.ПКВ_ТелефонОтправителя);
	
	ОткрытьФорму(
		"Обработка.РабочееМестоКассира.Форма.ФормаВводаСумм",
		ПараметрыПопапа,
		ЭтотОбъект,
		, , ,
		Новый ОписаниеОповещения("ПКВ_ПослеВводаТелефонаОтправителя", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ПослеВводаТелефонаОтправителя(Результат, ДопПараметры) Экспорт
	
	Если Результат <> Неопределено И Результат.ОперацияПодтверждена Тогда
		Объект.ПКВ_ТелефонОтправителя = Результат.СуммаОперации;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ВвестиТелефонПолучателя(Элемент)
	
	ПараметрыПопапа = ПКВ_ПараметрыПопапаВводаТелефона("Телефон получателя", Объект.ПКВ_ТелефонПолучателя);
	
	ОткрытьФорму(
		"Обработка.РабочееМестоКассира.Форма.ФормаВводаСумм",
		ПараметрыПопапа,
		ЭтотОбъект,
		, , ,
		Новый ОписаниеОповещения("ПКВ_ПослеВводаТелефонаПолучателя", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ПослеВводаТелефонаПолучателя(Результат, ДопПараметры) Экспорт
	
	Если Результат <> Неопределено И Результат.ОперацияПодтверждена Тогда
		Объект.ПКВ_ТелефонПолучателя = Результат.СуммаОперации;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПКВ_ПараметрыПопапаВводаТелефона(Заголовок, ТекущееЗначение)
	
	П = Новый Структура;
	
	П.Вставить("Режим", 6);
	П.Вставить("ЗаголовокЭлемента", Заголовок);
	П.Вставить("ТипЗначения", "Строка");
	П.Вставить("МаскаВвода", Объект.ПКВ_МаскаТелефона);
	П.Вставить("Формат", "");
	П.Вставить("ЗначениеЭлемента", ТекущееЗначение);
	
	// Остальное форма читает безусловно даже в режиме 6 — нейтральные значения
	П.Вставить("РежимКассыСамообслуживания", Ложь);
	П.Вставить("НомерТелефонаПолучателя", "");
	П.Вставить("ШаблонСообщения", Неопределено);
	П.Вставить("ПредставлениеКарты", "");
	П.Вставить("ДоступноБаллов", 0);
	П.Вставить("СуммаИтого", 0);
	П.Вставить("СуммаКОплате", 0);
	П.Вставить("СуммаОплаченоБонусами", 0);
	П.Вставить("ОстатокБаллов", 0);
	П.Вставить("КурсБаллов", 0);
	П.Вставить("ЗапрашиватьСМС", Ложь);
	П.Вставить("СуммаПодтвержденияБонусов", 0);
	П.Вставить("ПодарочныйСертификат", "");
	П.Вставить("БалансСертификата", 0);
	П.Вставить("СуммаСертификата", 0);
	П.Вставить("НомерПодарочногоСертификата", "");
	П.Вставить("ИспользоватьПанельВводаНаличных", Ложь);
	П.Вставить("ТекущаяНастройкаРМК", Неопределено);
	П.Вставить("ИспользоватьЦифровуюКлавиатуру", Истина);
	П.Вставить("ЭтоВнесениеПредоплатыПоЗаказу", Ложь);
	П.Вставить("СуммаОплаченоЗачетАванса", 0);
	П.Вставить("ПриемАванса", Ложь);
	П.Вставить("ИспользоватьДисплейПокупателя", Ложь);
	П.Вставить("ОжидаемоеКоличествоЧеков", 0);
	П.Вставить("ТребуетсяРазделитель", Ложь);
	
	Возврат П;
	
КонецФункции

#КонецОбласти
