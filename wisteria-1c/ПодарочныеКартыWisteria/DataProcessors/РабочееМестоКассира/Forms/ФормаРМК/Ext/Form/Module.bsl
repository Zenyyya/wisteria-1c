&НаКлиенте
Перем ПКВ_ДобавлениеКарты;

#Область КомандыПодарочныхКарт

&НаКлиенте
Процедура ПКВ_КнопкаВыпуск(Команда)

	ОткрытьФорму(
		"Обработка.ПКВ_ПодарочныеКарты.Форма.ФормаРегистрацииКарты",
		Новый Структура,
		ЭтотОбъект,
		, , ,
		Новый ОписаниеОповещения("ПКВ_ПослеРегистрацииКарты", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ПослеРегистрацииКарты(РезультатЗакрытия, ДопПараметры) Экспорт

	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПКВ_ОбработатьРегистрациюКарты(РезультатЗакрытия);

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_КнопкаПросмотр(Команда)

	ОткрытьФорму("ОбщаяФорма.ПКВ_ФормаПросмотрКарты", Новый Структура, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_КнопкаСписание(Команда)

	Если Объект.Товары.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Списание с карты возможно только когда в чеке есть товары.", , "Внимание");
		Возврат;
	КонецЕсли;

	ЗаполнитьТаблицуЧековКПробитию();
	ПересчитатьОбщиеИтоги();

	ПараметрыФормы = Новый Структура("СуммаКОплате", ОбщийОсталосьОплатить);

	ОткрытьФорму("ОбщаяФорма.ПКВ_ФормаСписание", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_КнопкаПривязка(Команда)

	ОткрытьФорму("ОбщаяФорма.ПКВ_ФормаПривязкаВладельца", Новый Структура, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Оповещения от формы списания.
&НаКлиенте
Процедура ПКВ_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник) Экспорт

	Если ИмяСобытия = "ПКВ_СписаниеПодтверждено" Тогда
		ПКВ_ОбработатьПодтверждениеСписания(Параметр);
	ИначеЕсли ИмяСобытия = "ПКВ_СписанияОтменены" Тогда
		ПКВ_ОтменитьСписания(Параметр);
	ИначеЕсли ИмяСобытия = "ПКВ_СписаниеПеренесеноВЧек" Тогда
		ПКВ_ОтразитьСуммуСписанийВОплатеЧека();
	КонецЕсли;

КонецПроцедуры

// Ошибки Directus после пробития чека копятся на сервере в ПКВ_ОшибкиПослеЧека
// (ОбщегоНазначенияРМКПереопределяемый) и показываются кассиру здесь.
&НаКлиенте
&После("ПробитьЧекНаКлиентеЗавершение")
Процедура ПКВ_ПробитьЧекНаКлиентеЗавершениеПосле(РезультатВыполнения, Параметры)

	Если Не ЗначениеЗаполнено(ПКВ_ОшибкиПослеЧека) Тогда
		Возврат;
	КонецЕсли;

	ТекстПредупреждения = ПКВ_ОшибкиПослеЧека + Символы.ПС + Символы.ПС + "Сообщите ответственному.";
	ПКВ_ОшибкиПослеЧека = "";

	ПоказатьПредупреждение(, ТекстПредупреждения, , "Подарочные карты Wisteria");

КонецПроцедуры

// Чек удалён, очищен или пробит последним в наборе: незавершённые списания
// отменяем в Directus, буферы очищаем.
&НаСервере
&После("СоздатьНовыйНабор")
Процедура ПКВ_СоздатьНовыйНаборПосле(ПараметрыЗавершения)

	ПКВ_ОтменитьСписанияНаСервере(Неопределено, "Чек удалён или очищен на кассе");

	ПКВ_ОжидающиеКарты.Очистить();
	ПКВ_ИдентификаторСтрокиСписания = "";

КонецПроцедуры

#КонецОбласти

#Область ЗапретОткладыванияЧека

&НаКлиенте
&Вместо("ОтложитьЧекПроверкаПрав")
Процедура ПКВ_ОтложитьЧекПроверкаПравВместо()

	Если ПКВ_ЕстьПодарочнаяКартаВЧеке() Тогда
		ПоказатьПредупреждение(,
			"Чек с подарочной картой Wisteria или со списанием с карты отложить нельзя.",
			, "Подарочные карты Wisteria");
		Возврат;
	КонецЕсли;

	ПродолжитьВызов();

КонецПроцедуры

&НаКлиенте
&После("НастроитьЭлементыФормы")
Процедура ПКВ_НастроитьЭлементыФормыПосле(ТекущаяСтраница, ДоступностьКоманд)

	ПКВ_ОбновитьДоступностьОтложить();

КонецПроцедуры

&НаКлиенте
&После("ПерейтиНаСтраницуОплата")
Процедура ПКВ_ПерейтиНаСтраницуОплатаПосле()

	ПКВ_ОбновитьДоступностьОтложить();

КонецПроцедуры

&НаКлиенте
&После("НастроитьФормуДляПроверкиЧека")
Процедура ПКВ_НастроитьФормуДляПроверкиЧекаПосле(ЗаблокироватьПродажу)

	ПКВ_ОбновитьДоступностьОтложить();

КонецПроцедуры

// Только выключает кнопку. Включает её обратно типовая форма.
&НаКлиенте
Процедура ПКВ_ОбновитьДоступностьОтложить()

	Если ПКВ_ЕстьПодарочнаяКартаВЧеке() Тогда
		Элементы.ОтложитьЧек.Доступность = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПКВ_ЕстьПодарочнаяКартаВЧеке()

	Если ПКВ_ОжидающиеСписания.Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого ОжидающаяКарта Из ПКВ_ОжидающиеКарты Цикл
		СтрокиКорзины = Объект.Товары.НайтиСтроки(
			Новый Структура("ИдентификаторСтроки", ОжидающаяКарта.ИдентификаторСтроки));
		Если СтрокиКорзины.Количество() > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область Выпуск

&НаКлиенте
Процедура ПКВ_ОбработатьРегистрациюКарты(РезультатЗакрытия)

	Если РезультатЗакрытия.ТипКарты = "plastic" Тогда
		НоменклатураСсылка = ПКВ_ПодарочныеКартыAPI.НоменклатураПластиковаяКарта();
	Иначе
		НоменклатураСсылка = ПКВ_ПодарочныеКартыAPI.НоменклатураЭлектроннаяКарта();
	КонецЕсли;

	// Без записи в регистре штрихкодов типовой поиск по штрихкоду номенклатуру не найдёт.
	ПКВ_ПодарочныеКартыAPI.УбедитьсяЧтоШтрихкодЗарегистрирован(НоменклатураСсылка);

	КодНоменклатуры = ПКВ_ПодарочныеКартыAPI.КодСканированияПоТипуКарты(РезультатЗакрытия.ТипКарты);

	Если Не ЗначениеЗаполнено(КодНоменклатуры) Тогда
		ПоказатьПредупреждение(,
			"Не задана номенклатура подарочной карты в настройках (админка → константы), "
			+ "либо у неё не заполнен Артикул. Строка в чек не добавлена, карта не будет оформлена.",
			, "Ошибка");
		Возврат;
	КонецЕсли;

	ИдентификаторСтроки = ПКВ_ДобавитьКартуВЧек(КодНоменклатуры, РезультатЗакрытия.Номинал);

	Если ИдентификаторСтроки = Неопределено Тогда
		ПоказатьПредупреждение(,
			СтрШаблон("Не удалось добавить карту в чек: номенклатура с артикулом ""%1"" не найдена.", КодНоменклатуры),
			, "Ошибка");
		Возврат;
	КонецЕсли;

	НоваяСтрокаБуфера = ПКВ_ОжидающиеКарты.Добавить();
	НоваяСтрокаБуфера.ИдентификаторСтроки = ИдентификаторСтроки;
	НоваяСтрокаБуфера.ТипКарты            = РезультатЗакрытия.ТипКарты;
	НоваяСтрокаБуфера.Сценарий            = РезультатЗакрытия.Сценарий;
	НоваяСтрокаБуфера.Номинал             = РезультатЗакрытия.Номинал;
	НоваяСтрокаБуфера.ТелефонОтправителя  = РезультатЗакрытия.ТелефонОтправителя;
	НоваяСтрокаБуфера.ТелефонПолучателя   = РезультатЗакрытия.ТелефонПолучателя;
	НоваяСтрокаБуфера.Поздравление        = РезультатЗакрытия.Поздравление;
	НоваяСтрокаБуфера.НомерФизКарты       = РезультатЗакрытия.НомерФизКарты;

	ПКВ_ОбновитьДоступностьОтложить();

КонецПроцедуры

// Добавляет карту отдельной строкой тем же путём, что и скан штрихкода.
// Отдельную строку обеспечивает ПКВ_ДобавитьТоварОтдельнойСтрокойНаКлиентеВместо.
//
// Возвращаемое значение:
//   Строка - ИдентификаторСтроки новой строки, Неопределено - строка не добавлена
&НаКлиенте
Функция ПКВ_ДобавитьКартуВЧек(КодНоменклатуры, Номинал)

	ИдентификаторыДо = Новый Соответствие;
	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		ИдентификаторыДо.Вставить(СтрокаТоваров.ИдентификаторСтроки, Истина);
	КонецЦикла;

	ПКВ_ДобавлениеКарты = Истина;
	Попытка
		ОбработатьШтрихкодКлиент(КодНоменклатуры);
	Исключение
		ПКВ_ДобавлениеКарты = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	ПКВ_ДобавлениеКарты = Ложь;

	НоваяСтрока = Неопределено;
	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		Если ИдентификаторыДо.Получить(СтрокаТоваров.ИдентификаторСтроки) = Неопределено Тогда
			НоваяСтрока = СтрокаТоваров;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НоваяСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПКВ_УстановитьЦенуКартыНаСервере(НоваяСтрока.ИдентификаторСтроки, Номинал);

	// Переустановка текущей строки, чтобы интерфейс перечитал данные.
	// Она же заново берёт цену из карточки, поэтому номинал ставим после.
	Элементы.Товары.ТекущаяСтрока = Неопределено;
	Элементы.Товары.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	ТекущийТоварЦенаИзКарточки = Номинал;

	Возврат НоваяСтрока.ИдентификаторСтроки;

КонецФункции

&НаСервере
Процедура ПКВ_УстановитьЦенуКартыНаСервере(ИдентификаторСтроки, Номинал)

	НайденныеСтроки = Объект.Товары.НайтиСтроки(
		Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));

	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СтрокаТоваров = НайденныеСтроки[0];
	СтрокаТоваров.Количество = 1;

	// Типовой пересчёт заполняет организацию, ставку НДС и скидки,
	// но может сбросить цену в 0, поэтому номинал ставим после него.
	ОбщегоНазначенияРМККлиентСервер.ПересчитатьСуммуВСтроке(ЭтотОбъект, СтрокаТоваров, , ИспользоватьАвтоматическиеСкидки);

	СтрокаТоваров.Цена  = Номинал;
	СтрокаТоваров.Сумма = Номинал;

	ОбщегоНазначенияРМККлиентСервер.РассчитатьСуммуНДС(Объект, СтрокаТоваров);
	ОбщегоНазначенияРМККлиентСервер.СуммаДокумента(Объект);

КонецПроцедуры

&НаКлиенте
&Вместо("ДобавитьТоварОтдельнойСтрокойНаКлиенте")
Функция ПКВ_ДобавитьТоварОтдельнойСтрокойНаКлиентеВместо(СтрокаТовара)

	Если ПКВ_ДобавлениеКарты = Истина Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ПродолжитьВызов(СтрокаТовара);

КонецФункции

#КонецОбласти

#Область КоличествоКарты

// Кнопки "+" и "-" в строке карты.
&НаКлиенте
&Вместо("ПересчитатьДанныеПриИзмененииКоличества")
Процедура ПКВ_ПересчитатьДанныеПриИзмененииКоличестваВместо(УвеличитьКоличество)

	Если ТипЗнч(ТекущийТоварИндексСтроки) = Тип("Число")
		И ТекущийТоварИндексСтроки >= 0
		И ТекущийТоварИндексСтроки < Объект.Товары.Количество() Тогда

		ТекущаяСтрока = Объект.Товары.Получить(ТекущийТоварИндексСтроки);

		Если ПКВ_ЭтоСтрокаКарты(ТекущаяСтрока) Тогда
			ПКВ_ПредупредитьОКоличествеКарты();
			Возврат;
		КонецЕсли;

	КонецЕсли;

	ПродолжитьВызов(УвеличитьКоличество);

КонецПроцедуры

// Ввод количества с клавиатуры или цифровой панели.
&НаКлиенте
&Перед("ОбработатьИзменениеКоличестваТовара")
Процедура ПКВ_ОбработатьИзменениеКоличестваТовараПеред(ТекущаяСтрокаРедактирования)

	Если ТекущаяСтрокаРедактирования = Неопределено Тогда
		ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(ТекущийТоварИдентификатор);
	Иначе
		ТекущаяСтрока = ТекущаяСтрокаРедактирования;
	КонецЕсли;

	Если Не ПКВ_ЭтоСтрокаКарты(ТекущаяСтрока) Тогда
		Возврат;
	КонецЕсли;

	Если ТекущийТоварКоличество <> 1 Тогда
		ТекущийТоварКоличество = 1;
		ПКВ_ПредупредитьОКоличествеКарты();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПКВ_ЭтоСтрокаКарты(СтрокаТоваров)

	Если СтрокаТоваров = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	НайденныеЗаписи = ПКВ_ОжидающиеКарты.НайтиСтроки(
		Новый Структура("ИдентификаторСтроки", СтрокаТоваров.ИдентификаторСтроки));

	Возврат НайденныеЗаписи.Количество() > 0;

КонецФункции

&НаКлиенте
Процедура ПКВ_ПредупредитьОКоличествеКарты()

	ПоказатьПредупреждение(,
		"Каждая подарочная карта - отдельная строка с количеством 1.
		|Чтобы добавить ещё одну карту, нажмите кнопку выпуска карты.
		|Чтобы убрать карту из чека, удалите строку.",
		, "Подарочные карты Wisteria");

КонецПроцедуры

#КонецОбласти

#Область Списание

&НаКлиенте
Процедура ПКВ_ОбработатьПодтверждениеСписания(ЗаписьСписания)

	НоваяСтрокаБуфера = ПКВ_ОжидающиеСписания.Добавить();
	НоваяСтрокаБуфера.HoldId     = ЗаписьСписания.HoldId;
	НоваяСтрокаБуфера.НомерКарты = ЗаписьСписания.НомерКарты;
	НоваяСтрокаБуфера.Сумма      = ЗаписьСписания.Сумма;

	ПКВ_ОбновитьДоступностьОтложить();

КонецПроцедуры

// Списания, подтверждённые в форме списания, но не перенесённые в чек.
//
// Параметры:
//   СписокHold - Массив из Строка
&НаКлиенте
Процедура ПКВ_ОтменитьСписания(СписокHold)

	Если ТипЗнч(СписокHold) <> Тип("Массив") Или СписокHold.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПКВ_ОтменитьСписанияНаСервере(СписокHold, "Кассир закрыл форму списания без переноса в чек");

КонецПроцедуры

// Отменяет заморозки в Directus и убирает их из буфера.
//
// Параметры:
//   СписокHold - Массив из Строка - какие отменить, Неопределено - все
//   Примечание - Строка
&НаСервере
Процедура ПКВ_ОтменитьСписанияНаСервере(СписокHold, Примечание)

	ЗаписиКУдалению = Новый Массив;

	Для Каждого ОжидающееСписание Из ПКВ_ОжидающиеСписания Цикл

		Если СписокHold <> Неопределено И СписокHold.Найти(ОжидающееСписание.HoldId) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЗаписиКУдалению.Добавить(ОжидающееСписание);

		Результат = ПКВ_ПодарочныеКартыAPI.ОтменитьHold(ОжидающееСписание.HoldId, Примечание);

		Если Не Результат.Успех Тогда
			ЗаписьЖурналаРегистрации(
				"ПКВ_ПодарочныеКарты.ОтменаСписания",
				УровеньЖурналаРегистрации.Предупреждение,
				, ,
				СтрШаблон("Не удалось отменить заморозку: %1
					|HoldId: %2, карта: %3, сумма: %4. Заморозка снимется сама через 30 минут.",
					ПКВ_ПодарочныеКартыAPI.ТекстОшибки(Результат),
					ОжидающееСписание.HoldId, ОжидающееСписание.НомерКарты, ОжидающееСписание.Сумма));
		КонецЕсли;

	КонецЦикла;

	Для Каждого ЗаписьКУдалению Из ЗаписиКУдалению Цикл
		ПКВ_ОжидающиеСписания.Удалить(ЗаписьКУдалению);
	КонецЦикла;

КонецПроцедуры

// Отражает в оплате чека всю сумму подтверждённых списаний из буфера одной строкой
// оплаты сертификатом. При повторном переносе старая строка заменяется.
// Типовой сервер лояльности при этом не вызывается: он работает только при
// включённой ИспользоватьСерверЛояльностиПолучательДанных.
&НаКлиенте
Процедура ПКВ_ОтразитьСуммуСписанийВОплатеЧека()

	Сумма = 0;
	НомераКарт = Новый Массив;
	Для Каждого ОжидающееСписание Из ПКВ_ОжидающиеСписания Цикл
		Сумма = Сумма + ОжидающееСписание.Сумма;
		Если НомераКарт.Найти(ОжидающееСписание.НомерКарты) = Неопределено Тогда
			НомераКарт.Добавить(ОжидающееСписание.НомерКарты);
		КонецЕсли;
	КонецЦикла;

	Если Сумма = 0 Тогда
		Возврат;
	КонецЕсли;

	НоменклатураСертификата = ПКВ_ПодарочныеКартыAPI.НоменклатураПластиковаяКарта();

	Если Не ЗначениеЗаполнено(НоменклатураСертификата) Тогда
		ПоказатьПредупреждение(,
			"Не задана номенклатура пластиковой карты в настройках (админка → константы). "
			+ "Списание не отражено в оплате чека.",
			, "Внимание");
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПКВ_ИдентификаторСтрокиСписания) Тогда
		СтарыеСтроки = ТаблицаПодарочныхСертификатов.НайтиСтроки(
			Новый Структура("УникальныйИдентификатор", ПКВ_ИдентификаторСтрокиСписания));
		Для Каждого СтараяСтрока Из СтарыеСтроки Цикл
			ТаблицаПодарочныхСертификатов.Удалить(СтараяСтрока);
		КонецЦикла;
		УдалитьЭлементПодарочногоСертификата(ПКВ_ИдентификаторСтрокиСписания);
	КонецЕсли;

	ЗаполнитьТаблицуЧековКПробитию();
	ПереключитьНаСледующийЧек();

	ПараметрыСертификата = Новый Структура;
	ПараметрыСертификата.Вставить("НомерПодарочногоСертификата", СтрСоединить(НомераКарт, ", "));
	ПараметрыСертификата.Вставить("ПодарочныйСертификат", НоменклатураСертификата);
	ПараметрыСертификата.Вставить("ЭтоСерийныйПодарочныйСертификат", Ложь);
	ПараметрыСертификата.Вставить("БалансСертификата", Сумма);
	ПараметрыСертификата.Вставить("СертификатСгорает", Ложь);

	ПКВ_ИдентификаторСтрокиСписания = ДобавитьПодарочныйСертификатВТаблицу(ПараметрыСертификата, Сумма);

	ДобавленныеСтроки = ТаблицаПодарочныхСертификатов.НайтиСтроки(
		Новый Структура("УникальныйИдентификатор", ПКВ_ИдентификаторСтрокиСписания));
	Для Каждого СтрокаДанныхСертификата Из ДобавленныеСтроки Цикл
		СтрокаДанныхСертификата.РешениеПоОстатку = ДействияСОстаткомПодарочногоСертификата.ПодтвердитьСгорание;
	КонецЦикла;

	ОбновитьУведомленияОСгоранииСертификата();
	ПересчитатьСуммыОплатыПриРедактированииСертификатов();
	ИзменитьКомандуСертификат();
	ПересчитатьОбщиеИтоги();

	ПКВ_ОбновитьДоступностьОтложить();

КонецПроцедуры

#КонецОбласти
