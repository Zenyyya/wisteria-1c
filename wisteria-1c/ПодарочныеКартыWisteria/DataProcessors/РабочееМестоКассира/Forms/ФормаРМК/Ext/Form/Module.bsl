&НаКлиенте
Перем ПКВ_ДобавлениеКарты;

#Область КомандыПодарочныхКарт

&НаКлиенте
Процедура ПКВ_КнопкаВыпуск(Команда)

	ОткрытьФорму(
		"Обработка.ПКВ_ПодарочныеКарты.Форма.ФормаРегистрацииКарты",
		Новый Структура,
		ЭтотОбъект,
		, , ,
		Новый ОписаниеОповещения("ПКВ_ПослеРегистрацииКарты", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ПослеРегистрацииКарты(РезультатЗакрытия, ДопПараметры) Экспорт

	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПКВ_ОбработатьРегистрациюКарты(РезультатЗакрытия);

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_КнопкаПросмотр(Команда)

	ОткрытьФорму("ОбщаяФорма.ПКВ_ФормаПросмотрКарты", Новый Структура, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_КнопкаСписание(Команда)

	Если Объект.Товары.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Списание с карты возможно только когда в чеке есть товары.", , "Внимание");
		Возврат;
	КонецЕсли;

	ЗаполнитьТаблицуЧековКПробитию();
	ПересчитатьОбщиеИтоги();

	ПараметрыФормы = Новый Структура("СуммаКОплате", ОбщийОсталосьОплатить);

	ОткрытьФорму("ОбщаяФорма.ПКВ_ФормаСписание", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_КнопкаПривязка(Команда)

	ОткрытьФорму("ОбщаяФорма.ПКВ_ФормаПривязкаВладельца", Новый Структура, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Оповещения от формы списания.
&НаКлиенте
Процедура ПКВ_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник) Экспорт

	Если ИмяСобытия = "ПКВ_СписаниеПодтверждено" Тогда
		ПКВ_ОбработатьПодтверждениеСписания(Параметр);
	ИначеЕсли ИмяСобытия = "ПКВ_СписанияОтменены" Тогда
		ПКВ_ОтменитьСписания(Параметр);
	ИначеЕсли ИмяСобытия = "ПКВ_СписаниеПеренесеноВЧек" Тогда
		ПКВ_ОтразитьСуммуСписанийВОплатеЧека();
	КонецЕсли;

КонецПроцедуры

// Ошибки Directus после пробития чека копятся на сервере в ПКВ_ОшибкиПослеЧека
// (ОбщегоНазначенияРМКПереопределяемый) и показываются кассиру здесь.
&НаКлиенте
&После("ПробитьЧекНаКлиентеЗавершение")
Процедура ПКВ_ПробитьЧекНаКлиентеЗавершениеПосле(РезультатВыполнения, Параметры)
	
	Части = Новый Массив;
	
	Если ЗначениеЗаполнено(ПКВ_ОшибкиПослеЧека) Тогда
		Части.Добавить(ПКВ_ОшибкиПослеЧека + Символы.ПС + Символы.ПС + "Сообщите ответственному.");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПКВ_СообщенияПослеЧека) Тогда
		Части.Добавить(ПКВ_СообщенияПослеЧека);
	КонецЕсли;
	
	ПКВ_ОшибкиПослеЧека = "";
	ПКВ_СообщенияПослеЧека = "";
	
	Если Части.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьПредупреждение(, СтрСоединить(Части, Символы.ПС + Символы.ПС), , "Подарочные карты Wisteria");
	
КонецПроцедуры

// Чек удалён, очищен или пробит последним в наборе: незавершённые списания
// отменяем в Directus, буферы очищаем.
&НаСервере
&После("СоздатьНовыйНабор")
Процедура ПКВ_СоздатьНовыйНаборПосле(ПараметрыЗавершения)

	ПКВ_ОтменитьСписанияНаСервере(Неопределено, "Чек удалён или очищен на кассе");

	ПКВ_ОжидающиеКарты.Очистить();
	ПКВ_ИдентификаторСтрокиСписания = "";
	
	ПКВ_КартыВозврата.Очистить();
	ПКВ_ПроданныеКарты.Очистить();
	ПКВ_ОжидающиеВозвраты.Очистить();
	ПКВ_ОжидающиеВозвратыКарт.Очистить();
	ПКВ_ПроверятьЛимитыВозврата = Ложь;
	ПКВ_ЛимитНаличных = 0;
	ПКВ_ЛимитНеКартами = 0;
	ПКВ_ОшибкаДанныхВозврата = "";
	
КонецПроцедуры

#КонецОбласти

#Область ЗапретОткладыванияЧека

&НаКлиенте
&Вместо("ОтложитьЧекПроверкаПрав")
Процедура ПКВ_ОтложитьЧекПроверкаПравВместо()

	Если ПКВ_ЕстьПодарочнаяКартаВЧеке() Тогда
		ПоказатьПредупреждение(,
			"Чек с подарочной картой Wisteria или со списанием с карты отложить нельзя.",
			, "Подарочные карты Wisteria");
		Возврат;
	КонецЕсли;

	ПродолжитьВызов();

КонецПроцедуры

&НаКлиенте
&После("НастроитьЭлементыФормы")
Процедура ПКВ_НастроитьЭлементыФормыПосле(ТекущаяСтраница, ДоступностьКоманд)

	ПКВ_ОбновитьДоступностьОтложить();

КонецПроцедуры

&НаКлиенте
&После("ПерейтиНаСтраницуОплата")
Процедура ПКВ_ПерейтиНаСтраницуОплатаПосле()

	ПКВ_ОбновитьДоступностьОтложить();

КонецПроцедуры

&НаКлиенте
&После("НастроитьФормуДляПроверкиЧека")
Процедура ПКВ_НастроитьФормуДляПроверкиЧекаПосле(ЗаблокироватьПродажу)

	ПКВ_ОбновитьДоступностьОтложить();

КонецПроцедуры

// Только выключает кнопку. Включает её обратно типовая форма.
&НаКлиенте
Процедура ПКВ_ОбновитьДоступностьОтложить()

	Если ПКВ_ЕстьПодарочнаяКартаВЧеке() Тогда
		Элементы.ОтложитьЧек.Доступность = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПКВ_ЕстьПодарочнаяКартаВЧеке()

	Если ПКВ_ОжидающиеСписания.Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого ОжидающаяКарта Из ПКВ_ОжидающиеКарты Цикл
		СтрокиКорзины = Объект.Товары.НайтиСтроки(
			Новый Структура("ИдентификаторСтроки", ОжидающаяКарта.ИдентификаторСтроки));
		Если СтрокиКорзины.Количество() > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область Выпуск

&НаКлиенте
Процедура ПКВ_ОбработатьРегистрациюКарты(РезультатЗакрытия)

	Если РезультатЗакрытия.ТипКарты = "plastic" Тогда
		НоменклатураСсылка = ПКВ_ПодарочныеКартыAPI.НоменклатураПластиковаяКарта();
	Иначе
		НоменклатураСсылка = ПКВ_ПодарочныеКартыAPI.НоменклатураЭлектроннаяКарта();
	КонецЕсли;

	// Без записи в регистре штрихкодов типовой поиск по штрихкоду номенклатуру не найдёт.
	ПКВ_ПодарочныеКартыAPI.УбедитьсяЧтоШтрихкодЗарегистрирован(НоменклатураСсылка);

	КодНоменклатуры = ПКВ_ПодарочныеКартыAPI.КодСканированияПоТипуКарты(РезультатЗакрытия.ТипКарты);

	Если Не ЗначениеЗаполнено(КодНоменклатуры) Тогда
		ПоказатьПредупреждение(,
			"Не задана номенклатура подарочной карты в настройках (админка → константы), "
			+ "либо у неё не заполнен Артикул. Строка в чек не добавлена, карта не будет оформлена.",
			, "Ошибка");
		Возврат;
	КонецЕсли;

	ИдентификаторСтроки = ПКВ_ДобавитьКартуВЧек(КодНоменклатуры, РезультатЗакрытия.Номинал);

	Если ИдентификаторСтроки = Неопределено Тогда
		ПоказатьПредупреждение(,
			СтрШаблон("Не удалось добавить карту в чек: номенклатура с артикулом ""%1"" не найдена.", КодНоменклатуры),
			, "Ошибка");
		Возврат;
	КонецЕсли;

	НоваяСтрокаБуфера = ПКВ_ОжидающиеКарты.Добавить();
	НоваяСтрокаБуфера.ИдентификаторСтроки = ИдентификаторСтроки;
	НоваяСтрокаБуфера.ТипКарты            = РезультатЗакрытия.ТипКарты;
	НоваяСтрокаБуфера.Сценарий            = РезультатЗакрытия.Сценарий;
	НоваяСтрокаБуфера.Номинал             = РезультатЗакрытия.Номинал;
	НоваяСтрокаБуфера.ТелефонОтправителя  = РезультатЗакрытия.ТелефонОтправителя;
	НоваяСтрокаБуфера.ТелефонПолучателя   = РезультатЗакрытия.ТелефонПолучателя;
	НоваяСтрокаБуфера.Поздравление        = РезультатЗакрытия.Поздравление;
	НоваяСтрокаБуфера.НомерФизКарты       = РезультатЗакрытия.НомерФизКарты;

	ПКВ_ОбновитьДоступностьОтложить();

КонецПроцедуры

// Добавляет карту отдельной строкой тем же путём, что и скан штрихкода.
// Отдельную строку обеспечивает ПКВ_ДобавитьТоварОтдельнойСтрокойНаКлиентеВместо.
//
// Возвращаемое значение:
//   Строка - ИдентификаторСтроки новой строки, Неопределено - строка не добавлена
&НаКлиенте
Функция ПКВ_ДобавитьКартуВЧек(КодНоменклатуры, Номинал)

	ИдентификаторыДо = Новый Соответствие;
	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		ИдентификаторыДо.Вставить(СтрокаТоваров.ИдентификаторСтроки, Истина);
	КонецЦикла;

	ПКВ_ДобавлениеКарты = Истина;
	Попытка
		ОбработатьШтрихкодКлиент(КодНоменклатуры);
	Исключение
		ПКВ_ДобавлениеКарты = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	ПКВ_ДобавлениеКарты = Ложь;

	НоваяСтрока = Неопределено;
	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		Если ИдентификаторыДо.Получить(СтрокаТоваров.ИдентификаторСтроки) = Неопределено Тогда
			НоваяСтрока = СтрокаТоваров;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НоваяСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПКВ_УстановитьЦенуКартыНаСервере(НоваяСтрока.ИдентификаторСтроки, Номинал);

	// Переустановка текущей строки, чтобы интерфейс перечитал данные.
	// Она же заново берёт цену из карточки, поэтому номинал ставим после.
	Элементы.Товары.ТекущаяСтрока = Неопределено;
	Элементы.Товары.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	ТекущийТоварЦенаИзКарточки = Номинал;
	ПересчитатьИтогиТабличнойЧастиТовары(Ложь);

	Возврат НоваяСтрока.ИдентификаторСтроки;

КонецФункции

&НаСервере
Процедура ПКВ_УстановитьЦенуКартыНаСервере(ИдентификаторСтроки, Номинал)

	НайденныеСтроки = Объект.Товары.НайтиСтроки(
		Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));

	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СтрокаТоваров = НайденныеСтроки[0];
	СтрокаТоваров.Количество = 1;

	// Типовой пересчёт заполняет организацию, ставку НДС и скидки,
	// но может сбросить цену в 0, поэтому номинал ставим после него.
	ОбщегоНазначенияРМККлиентСервер.ПересчитатьСуммуВСтроке(ЭтотОбъект, СтрокаТоваров, , ИспользоватьАвтоматическиеСкидки);

	СтрокаТоваров.Цена  = Номинал;
	СтрокаТоваров.Сумма = Номинал; 
	СтрокаТоваров.СуммаБезСкидки = Номинал;

	ОбщегоНазначенияРМККлиентСервер.РассчитатьСуммуНДС(Объект, СтрокаТоваров);
	ОбщегоНазначенияРМККлиентСервер.СуммаДокумента(Объект);

КонецПроцедуры

&НаКлиенте
&Вместо("ДобавитьТоварОтдельнойСтрокойНаКлиенте")
Функция ПКВ_ДобавитьТоварОтдельнойСтрокойНаКлиентеВместо(СтрокаТовара)

	Если ПКВ_ДобавлениеКарты = Истина Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ПродолжитьВызов(СтрокаТовара);

КонецФункции

#КонецОбласти

#Область КоличествоКарты

// Кнопки "+" и "-" в строке карты.
&НаКлиенте
&Вместо("ПересчитатьДанныеПриИзмененииКоличества")
Процедура ПКВ_ПересчитатьДанныеПриИзмененииКоличестваВместо(УвеличитьКоличество)

	Если ТипЗнч(ТекущийТоварИндексСтроки) = Тип("Число")
		И ТекущийТоварИндексСтроки >= 0
		И ТекущийТоварИндексСтроки < Объект.Товары.Количество() Тогда

		ТекущаяСтрока = Объект.Товары.Получить(ТекущийТоварИндексСтроки);

		Если ПКВ_ЭтоСтрокаКарты(ТекущаяСтрока) Тогда
			ПКВ_ПредупредитьОКоличествеКарты();
			Возврат;
		КонецЕсли;

	КонецЕсли;

	ПродолжитьВызов(УвеличитьКоличество);

КонецПроцедуры

// Ввод количества с клавиатуры или цифровой панели.
&НаКлиенте
&Перед("ОбработатьИзменениеКоличестваТовара")
Процедура ПКВ_ОбработатьИзменениеКоличестваТовараПеред(ТекущаяСтрокаРедактирования)

	Если ТекущаяСтрокаРедактирования = Неопределено Тогда
		ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(ТекущийТоварИдентификатор);
	Иначе
		ТекущаяСтрока = ТекущаяСтрокаРедактирования;
	КонецЕсли;

	Если Не ПКВ_ЭтоСтрокаКарты(ТекущаяСтрока) Тогда
		Возврат;
	КонецЕсли;

	Если ТекущийТоварКоличество <> 1 Тогда
		ТекущийТоварКоличество = 1;
		ПКВ_ПредупредитьОКоличествеКарты();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПКВ_ЭтоСтрокаКарты(СтрокаТоваров)

	Если СтрокаТоваров = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	НайденныеЗаписи = ПКВ_ОжидающиеКарты.НайтиСтроки(
		Новый Структура("ИдентификаторСтроки", СтрокаТоваров.ИдентификаторСтроки));

	Возврат НайденныеЗаписи.Количество() > 0;

КонецФункции

&НаКлиенте
Процедура ПКВ_ПредупредитьОКоличествеКарты()

	ПоказатьПредупреждение(,
		"Каждая подарочная карта - отдельная строка с количеством 1.
		|Чтобы добавить ещё одну карту, нажмите кнопку выпуска карты.
		|Чтобы убрать карту из чека, удалите строку.",
		, "Подарочные карты Wisteria");

КонецПроцедуры

#КонецОбласти

#Область Списание

&НаКлиенте
Процедура ПКВ_ОбработатьПодтверждениеСписания(ЗаписьСписания)

	НоваяСтрокаБуфера = ПКВ_ОжидающиеСписания.Добавить();
	НоваяСтрокаБуфера.HoldId     = ЗаписьСписания.HoldId;
	НоваяСтрокаБуфера.НомерКарты = ЗаписьСписания.НомерКарты;
	НоваяСтрокаБуфера.Сумма      = ЗаписьСписания.Сумма;

	ПКВ_ОбновитьДоступностьОтложить();

КонецПроцедуры

// Списания, подтверждённые в форме списания, но не перенесённые в чек.
//
// Параметры:
//   СписокHold - Массив из Строка
&НаКлиенте
Процедура ПКВ_ОтменитьСписания(СписокHold)

	Если ТипЗнч(СписокHold) <> Тип("Массив") Или СписокHold.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПКВ_ОтменитьСписанияНаСервере(СписокHold, "Кассир закрыл форму списания без переноса в чек");

КонецПроцедуры

// Отменяет заморозки в Directus и убирает их из буфера.
//
// Параметры:
//   СписокHold - Массив из Строка - какие отменить, Неопределено - все
//   Примечание - Строка
&НаСервере
Процедура ПКВ_ОтменитьСписанияНаСервере(СписокHold, Примечание)

	ЗаписиКУдалению = Новый Массив;

	Для Каждого ОжидающееСписание Из ПКВ_ОжидающиеСписания Цикл

		Если СписокHold <> Неопределено И СписокHold.Найти(ОжидающееСписание.HoldId) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЗаписиКУдалению.Добавить(ОжидающееСписание);

		Результат = ПКВ_ПодарочныеКартыAPI.ОтменитьHold(ОжидающееСписание.HoldId, Примечание);

		Если Не Результат.Успех Тогда
			ЗаписьЖурналаРегистрации(
				"ПКВ_ПодарочныеКарты.ОтменаСписания",
				УровеньЖурналаРегистрации.Предупреждение,
				, ,
				СтрШаблон("Не удалось отменить заморозку: %1
					|HoldId: %2, карта: %3, сумма: %4. Заморозка снимется сама через 30 минут.",
					ПКВ_ПодарочныеКартыAPI.ТекстОшибки(Результат),
					ОжидающееСписание.HoldId, ОжидающееСписание.НомерКарты, ОжидающееСписание.Сумма));
		КонецЕсли;

	КонецЦикла;

	Для Каждого ЗаписьКУдалению Из ЗаписиКУдалению Цикл
		ПКВ_ОжидающиеСписания.Удалить(ЗаписьКУдалению);
	КонецЦикла;

КонецПроцедуры

// Отражает в оплате чека всю сумму подтверждённых списаний из буфера.
&НаКлиенте
Процедура ПКВ_ОтразитьСуммуСписанийВОплатеЧека()
	
	Сумма = 0;
	НомераКарт = Новый Массив;
	Для Каждого ОжидающееСписание Из ПКВ_ОжидающиеСписания Цикл
		Сумма = Сумма + ОжидающееСписание.Сумма;
		Если НомераКарт.Найти(ОжидающееСписание.НомерКарты) = Неопределено Тогда
			НомераКарт.Добавить(ОжидающееСписание.НомерКарты);
		КонецЕсли;
	КонецЦикла;
	
	Если Сумма = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПКВ_ОтразитьОплатуКартами(Сумма, НомераКарт);
	
КонецПроцедуры

// Одна строка оплаты сертификатом на всю сумму по нашим картам: при продаже - списания,
// при возврате - возвраты на карты. При повторном вызове старая строка заменяется,
// при Сумма = 0 только удаляется. Типовой сервер лояльности при этом не вызывается:
// он работает только при включённой ИспользоватьСерверЛояльностиПолучательДанных.
&НаКлиенте
Процедура ПКВ_ОтразитьОплатуКартами(Сумма, НомераКарт)
	
	НоменклатураСертификата = ПКВ_ПодарочныеКартыAPI.НоменклатураПластиковаяКарта();
	
	Если Не ЗначениеЗаполнено(НоменклатураСертификата) Тогда
		ПоказатьПредупреждение(,
			"Не задана номенклатура пластиковой карты в настройках (админка → константы). "
			+ "Сумма по подарочным картам не отражена в оплате чека.",
			, "Внимание");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПКВ_ИдентификаторСтрокиСписания) Тогда
		СтарыеСтроки = ТаблицаПодарочныхСертификатов.НайтиСтроки(
			Новый Структура("УникальныйИдентификатор", ПКВ_ИдентификаторСтрокиСписания));
		Для Каждого СтараяСтрока Из СтарыеСтроки Цикл
			ТаблицаПодарочныхСертификатов.Удалить(СтараяСтрока);
		КонецЦикла;
		УдалитьЭлементПодарочногоСертификата(ПКВ_ИдентификаторСтрокиСписания);
		ПКВ_ИдентификаторСтрокиСписания = "";
	КонецЕсли;
	
	ЗаполнитьТаблицуЧековКПробитию();
	ПереключитьНаСледующийЧек();
	
	Если Сумма > 0 Тогда
		
		ПараметрыСертификата = Новый Структура;
		ПараметрыСертификата.Вставить("НомерПодарочногоСертификата", СтрСоединить(НомераКарт, ", "));
		ПараметрыСертификата.Вставить("ПодарочныйСертификат", НоменклатураСертификата);
		ПараметрыСертификата.Вставить("ЭтоСерийныйПодарочныйСертификат", Ложь);
		ПараметрыСертификата.Вставить("БалансСертификата", Сумма);
		ПараметрыСертификата.Вставить("СертификатСгорает", Ложь);
		
		ПКВ_ИдентификаторСтрокиСписания = ДобавитьПодарочныйСертификатВТаблицу(ПараметрыСертификата, Сумма);
		
		ДобавленныеСтроки = ТаблицаПодарочныхСертификатов.НайтиСтроки(
			Новый Структура("УникальныйИдентификатор", ПКВ_ИдентификаторСтрокиСписания));
		Для Каждого СтрокаДанныхСертификата Из ДобавленныеСтроки Цикл
			СтрокаДанныхСертификата.РешениеПоОстатку = ДействияСОстаткомПодарочногоСертификата.ПодтвердитьСгорание;
		КонецЦикла;
		
	КонецЕсли;
	
	ОбновитьУведомленияОСгоранииСертификата();
	ПересчитатьСуммыОплатыПриРедактированииСертификатов();
	ИзменитьКомандуСертификат();
	ПересчитатьОбщиеИтоги();
	
	ПКВ_ОбновитьДоступностьОтложить();
	
КонецПроцедуры

// Сумма строки оплаты нашими картами, которая сейчас есть в чеке.
&НаКлиенте
Функция ПКВ_СуммаОплатыКартамиВЧеке()
	
	Если Не ЗначениеЗаполнено(ПКВ_ИдентификаторСтрокиСписания) Тогда
		Возврат 0;
	КонецЕсли;
	
	Сумма = 0;
	Строки = ТаблицаПодарочныхСертификатов.НайтиСтроки(
		Новый Структура("УникальныйИдентификатор", ПКВ_ИдентификаторСтрокиСписания));
	Для Каждого СтрокаСертификата Из Строки Цикл
		Сумма = Сумма + СтрокаСертификата.СуммаСертификата;
	КонецЦикла;
	
	Возврат Сумма;
	
КонецФункции

#КонецОбласти

#Область ПКВ_Возврат

// Данные карт по чеку продажи загружаются на сервере при заполнении возврата
// (ОбщегоНазначенияРМКПереопределяемый.ПКВ_ЗаполнитьНаОснованииЧекаККМПосле).
// Здесь - сообщение кассиру и сопоставление строк купленных карт с номерами карт.
&НаКлиенте
&После("ВыборЧекаЗавершение")
Процедура ПКВ_ВыборЧекаЗавершениеПосле(Результат, ДополнительныеПараметры)
	
	Если ТипЗнч(Результат) <> Тип("Структура") Или Не Результат.Свойство("ЧекККМ") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПКВ_ОшибкаДанныхВозврата) Тогда
		ПоказатьПредупреждение(,
			"Не удалось получить из Directus данные подарочных карт по чеку продажи:
			|" + ПКВ_ОшибкаДанныхВозврата + "
			|
			|Возврат на подарочные карты и возврат купленных карт сейчас недоступны.",
			, "Подарочные карты Wisteria");
		Возврат;
	КонецЕсли;
	
	ПКВ_СопоставитьКартыВозврата(Новый Массив, Новый Массив);
	
КонецПроцедуры

// Строки купленных карт в чеке возврата получают номер карты: если подходящая карта
// одна, сразу, если несколько - кассир выбирает из списка.
//
// Параметры:
//   Пропущенные    - Массив из Строка - строки, по которым кассир не выбрал карту
//   Предупреждения - Массив из Строка
&НаКлиенте
Процедура ПКВ_СопоставитьКартыВозврата(Пропущенные, Предупреждения)
	
	Шаг = ПКВ_СопоставитьКартыВозвратаНаСервере(Пропущенные);
	
	Для Каждого Текст Из Шаг.Предупреждения Цикл
		Предупреждения.Добавить(Текст);
	КонецЦикла;
	
	Для Каждого Идентификатор Из Шаг.Пропущенные Цикл
		Пропущенные.Добавить(Идентификатор);
	КонецЦикла;
	
	Если Шаг.КВыбору <> Неопределено Тогда
		
		Варианты = Новый СписокЗначений;
		Для Каждого Вариант Из Шаг.КВыбору.Варианты Цикл
			Варианты.Добавить(Вариант.НомерКарты, Вариант.Представление);
		КонецЦикла;
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ИдентификаторСтроки", Шаг.КВыбору.ИдентификаторСтроки);
		ДопПараметры.Вставить("Пропущенные", Пропущенные);
		ДопПараметры.Вставить("Предупреждения", Предупреждения);
		
		Варианты.ПоказатьВыборЭлемента(
			Новый ОписаниеОповещения("ПКВ_ПослеВыбораКартыВозврата", ЭтотОбъект, ДопПараметры),
			СтрШаблон("Какую карту на %1 ₽ возвращает покупатель?", Формат(Шаг.КВыбору.Номинал, "ЧДЦ=2; ЧГ=0")));
		
		Возврат;
		
	КонецЕсли;
	
	Если Шаг.ЕстьИзменения Тогда
		ПересчитатьИтогиТабличнойЧастиТовары(Ложь);
		РассчитатьСуммыОплаты();
	КонецЕсли;
	
	Если Предупреждения.Количество() > 0 Тогда
		ПоказатьПредупреждение(, СтрСоединить(Предупреждения, Символы.ПС + Символы.ПС), , "Подарочные карты Wisteria");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ПослеВыбораКартыВозврата(ВыбранныйЭлемент, ДопПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		ДопПараметры.Пропущенные.Добавить(ДопПараметры.ИдентификаторСтроки);
		ДопПараметры.Предупреждения.Добавить(
			"Для строки подарочной карты номер карты не выбран. Выберите карту заново (повторите возврат по чеку) или удалите строку.");
	Иначе
		ПКВ_НазначитьКартуСтрокеНаСервере(ДопПараметры.ИдентификаторСтроки, ВыбранныйЭлемент.Значение);
		ПересчитатьИтогиТабличнойЧастиТовары(Ложь);
		РассчитатьСуммыОплаты();
	КонецЕсли;
	
	ПКВ_СопоставитьКартыВозврата(ДопПараметры.Пропущенные, ДопПараметры.Предупреждения);
	
КонецПроцедуры

// Проходит по строкам купленных карт без номера: одну подходящую карту назначает сразу,
// на первой строке с несколькими вариантами останавливается.
//
// Возвращаемое значение:
//   Структура - КВыбору (Структура: ИдентификаторСтроки, Варианты), Предупреждения, Пропущенные (Массив),
//               ЕстьИзменения (Булево)
&НаСервере
Функция ПКВ_СопоставитьКартыВозвратаНаСервере(Пропущенные)
	
	Итог = Новый Структура("КВыбору, Предупреждения, Пропущенные, ЕстьИзменения",
		Неопределено, Новый Массив, Новый Массив, Ложь);
	
	НоменклатураЭлектронная = ПКВ_ПодарочныеКартыAPI.НоменклатураЭлектроннаяКарта();
	НоменклатураПластиковая = ПКВ_ПодарочныеКартыAPI.НоменклатураПластиковаяКарта();
	
	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		
		Если ЗначениеЗаполнено(НоменклатураЭлектронная) И СтрокаТоваров.Номенклатура = НоменклатураЭлектронная Тогда
			ТипКарты = "electronic";
		ИначеЕсли ЗначениеЗаполнено(НоменклатураПластиковая) И СтрокаТоваров.Номенклатура = НоменклатураПластиковая Тогда
			ТипКарты = "plastic";
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если Пропущенные.Найти(СтрокаТоваров.ИдентификаторСтроки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПКВ_ОжидающиеВозвратыКарт.НайтиСтроки(
			Новый Структура("ИдентификаторСтроки", СтрокаТоваров.ИдентификаторСтроки)).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТоваров.Количество <> 1 Тогда
			Итог.Предупреждения.Добавить(СтрШаблон(
				"Строка подарочной карты на %1 ₽ с количеством %2: такой чек оформлен до доработки, "
				+ "вернуть эти карты в кассе нельзя. Удалите строку и обратитесь к ответственному.",
				Формат(СтрокаТоваров.Цена, "ЧДЦ=2; ЧГ=0"), СтрокаТоваров.Количество));
			Итог.Пропущенные.Добавить(СтрокаТоваров.ИдентификаторСтроки);
			Продолжить;
		КонецЕсли;
		
		Варианты = Новый Массив;
		Причины = Новый Массив;
		Для Каждого Карта Из ПКВ_ПроданныеКарты Цикл
			
			Если Карта.ТипКарты <> ТипКарты Или Карта.Номинал <> СтрокаТоваров.Цена Тогда
				Продолжить;
			КонецЕсли;
			
			Если ПКВ_ОжидающиеВозвратыКарт.НайтиСтроки(Новый Структура("НомерКарты", Карта.НомерКарты)).Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не Карта.МожноВернуть Тогда
				Причины.Добавить(СтрШаблон("карта %1: закрыта или по ней есть незавершённое списание", Карта.НомерКарты));
				Продолжить;
			КонецЕсли;
			
			Если Карта.Баланс <= 0 Тогда
				Причины.Добавить(СтрШаблон("карта %1: остаток 0, возвращать нечего", Карта.НомерКарты));
				Продолжить;
			КонецЕсли;
			
			Варианты.Добавить(Новый Структура("НомерКарты, Представление", Карта.НомерКарты,
				СтрШаблон("Карта %1, остаток %2 ₽", Карта.НомерКарты, Формат(Карта.Баланс, "ЧДЦ=2; ЧГ=0"))));
			
		КонецЦикла;
		
		Если Варианты.Количество() = 0 Тогда
			Текст = СтрШаблон("Для строки подарочной карты на %1 ₽ нет карты, которую можно вернуть",
				Формат(СтрокаТоваров.Цена, "ЧДЦ=2; ЧГ=0"));
			Если Причины.Количество() > 0 Тогда
				Текст = Текст + ": " + СтрСоединить(Причины, "; ");
			КонецЕсли;
			Итог.Предупреждения.Добавить(Текст + ". Удалите строку из чека возврата.");
			Итог.Пропущенные.Добавить(СтрокаТоваров.ИдентификаторСтроки);
			Продолжить;
		КонецЕсли;
		
		Если Варианты.Количество() = 1 Тогда
			ПКВ_НазначитьКартуСтроке(СтрокаТоваров, Варианты[0].НомерКарты);
			Итог.ЕстьИзменения = Истина;
			Продолжить;
		КонецЕсли;
		
		Итог.КВыбору = Новый Структура("ИдентификаторСтроки, Номинал, Варианты",
			СтрокаТоваров.ИдентификаторСтроки, СтрокаТоваров.Цена, Варианты);
		Прервать;
		
	КонецЦикла;
	
	Возврат Итог;
	
КонецФункции

&НаСервере
Процедура ПКВ_НазначитьКартуСтрокеНаСервере(ИдентификаторСтроки, НомерКарты)
	
	Строки = Объект.Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	
	Если Строки.Количество() > 0 Тогда
		ПКВ_НазначитьКартуСтроке(Строки[0], НомерКарты);
	КонецЕсли;
	
КонецПроцедуры

// Строка купленной карты в чеке возврата: сумма строки = остаток баланса карты,
// после пробития чека возврата карта закрывается (/refund-card).
&НаСервере
Процедура ПКВ_НазначитьКартуСтроке(СтрокаТоваров, НомерКарты)
	
	Карты = ПКВ_ПроданныеКарты.НайтиСтроки(Новый Структура("НомерКарты", НомерКарты));
	Если Карты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Карта = Карты[0];
	
	НоваяЗапись = ПКВ_ОжидающиеВозвратыКарт.Добавить();
	НоваяЗапись.ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
	НоваяЗапись.НомерКарты          = Карта.НомерКарты;
	НоваяЗапись.ТипКарты            = Карта.ТипКарты;
	НоваяЗапись.Сумма               = Карта.Баланс;
	НоваяЗапись.RequestId           = Строка(Новый УникальныйИдентификатор);
	
	Если СтрокаТоваров.Цена = Карта.Баланс Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТоваров.Количество = 1;
	СтрокаТоваров.Цена = Карта.Баланс;
	
	ОбщегоНазначенияРМККлиентСервер.ПересчитатьСуммуВСтроке(ЭтотОбъект, СтрокаТоваров, , Ложь);
	
	СтрокаТоваров.Цена  = Карта.Баланс;
	СтрокаТоваров.Сумма = Карта.Баланс; 
	СтрокаТоваров.СуммаБезСкидки = Карта.Баланс;
	
	ОбщегоНазначенияРМККлиентСервер.РассчитатьСуммуНДС(Объект, СтрокаТоваров);
	ОбщегоНазначенияРМККлиентСервер.СуммаДокумента(Объект);
	
КонецПроцедуры

// Кнопка «Оплатить сертификатом» в возврате доступна, если по чеку продажи списывали с наших карт.
&НаКлиенте
&После("НастроитьЭлементыВРежимеВозврат")
Процедура ПКВ_НастроитьЭлементыВРежимеВозвратПосле()
	
	Если ПКВ_КартыВозврата.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаВидОплатыСертификатом.Видимость = Истина;
	Элементы.ГруппаВидОплатыСертификатом.Доступность = Истина;
	Элементы.ОплатаСертификатом.Доступность = Истина;
	
КонецПроцедуры

&НаКлиенте
&Вместо("ДобавитьСертификат")
Процедура ПКВ_ДобавитьСертификатВместо(Команда)
	
	Если ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации)
		И ПКВ_КартыВозврата.Количество() > 0 Тогда
		ПКВ_ОткрытьВозвратНаКарты();
		Возврат;
	КонецЕсли;
	
	ПродолжитьВызов(Команда);
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ОткрытьВозвратНаКарты()
	
	ЗаполнитьТаблицуЧековКПробитию();
	ПересчитатьОбщиеИтоги();
	
	СуммаВЧеке = ПКВ_СуммаОплатыКартамиВЧеке();
	Если СуммаВЧеке = 0 Тогда
		ПКВ_ОжидающиеВозвраты.Очистить();
	КонецЕсли;
	
	Карты = Новый Массив;
	Для Каждого Карта Из ПКВ_КартыВозврата Цикл
		
		ДанныеКарты = Новый Структура("НомерКарты, ТипКарты, Статус, Баланс, Списано, Возвращено, МожноВернуть, ПринимаетВозврат");
		ЗаполнитьЗначенияСвойств(ДанныеКарты, Карта);
		ДанныеКарты.Вставить("Сумма", 0);
		ДанныеКарты.Вставить("НоваяКарта", "");
		
		Записи = ПКВ_ОжидающиеВозвраты.НайтиСтроки(Новый Структура("НомерКарты", Карта.НомерКарты));
		Если Записи.Количество() > 0 Тогда
			ДанныеКарты.Сумма = Записи[0].Сумма;
			ДанныеКарты.НоваяКарта = Записи[0].НоваяКарта;
		КонецЕсли;
		
		Карты.Добавить(ДанныеКарты);
		
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Карты", Карты);
	ПараметрыФормы.Вставить("СуммаКВозврату", ОбщийОсталосьОплатить + СуммаВЧеке);
	
	ОткрытьФорму(
		"ОбщаяФорма.ПКВ_ФормаВозвратНаКарты",
		ПараметрыФормы,
		ЭтотОбъект,
		, , ,
		Новый ОписаниеОповещения("ПКВ_ПослеВозвратаНаКарты", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ПослеВозвратаНаКарты(Результат, ДопПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Или Не Результат.Свойство("Возвраты") Тогда
		Возврат;
	КонецЕсли;
	
	ПКВ_ОжидающиеВозвраты.Очистить();
	
	Сумма = 0;
	НомераКарт = Новый Массив;
	
	Для Каждого ВозвратНаКарту Из Результат.Возвраты Цикл
		
		НоваяЗапись = ПКВ_ОжидающиеВозвраты.Добавить();
		НоваяЗапись.RequestId  = Строка(Новый УникальныйИдентификатор);
		НоваяЗапись.НомерКарты = ВозвратНаКарту.НомерКарты;
		НоваяЗапись.ТипКарты   = ВозвратНаКарту.ТипКарты;
		НоваяЗапись.Сумма      = ВозвратНаКарту.Сумма;
		НоваяЗапись.Замена     = ВозвратНаКарту.Замена;
		НоваяЗапись.НоваяКарта = ВозвратНаКарту.НоваяКарта;
		
		Сумма = Сумма + ВозвратНаКарту.Сумма;
		НомераКарт.Добавить(ВозвратНаКарту.НомерКарты);
		
	КонецЦикла;
	
	ПКВ_ОтразитьОплатуКартами(Сумма, НомераКарт);
	
КонецПроцедуры

// Перед пробитием чека возврата по чеку с нашими картами: у строк купленных карт есть
// номер карты, наличными и не на карты возвращается не больше, чем так платили.
&НаКлиенте
&Вместо("ПробитьЧекКлиент")
Процедура ПКВ_ПробитьЧекКлиентВместо()
	
	Если Не ПКВ_ВозвратМожноПробить() Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьВызов();
	
КонецПроцедуры

&НаКлиенте
Функция ПКВ_ВозвратМожноПробить()
	
	Если Не ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Ошибки = ПКВ_ПроверитьСтрокиКартВозвратаНаСервере();
	
	СуммаНаКарты = ПКВ_СуммаОплатыКартамиВЧеке();
	Если СуммаНаКарты = 0 Тогда
		ПКВ_ОжидающиеВозвраты.Очистить();
	КонецЕсли;
	
	Если ПКВ_ПроверятьЛимитыВозврата Тогда
		
		РассчитатьСуммыОплаты();
		
		Наличными = СуммаОплаченоНал - Сдача;
		НеНаКарты = ОбщийСуммаИтого - СуммаНаКарты;
		
		Если Наличными > ПКВ_ЛимитНаличных Тогда
			Ошибки.Добавить(СтрШаблон(
				"Наличными можно вернуть не больше %1 ₽: столько по чеку продажи платили наличными (с учётом прошлых возвратов). "
				+ "Остаток верните на подарочную карту кнопкой «Оплатить сертификатом».",
				Формат(ПКВ_ЛимитНаличных, "ЧДЦ=2; ЧН=0; ЧГ=0")));
		КонецЕсли;
		
		Если НеНаКарты > ПКВ_ЛимитНеКартами Тогда
			Ошибки.Добавить(СтрШаблон(
				"Не на подарочные карты можно вернуть не больше %1 ₽: остальное по чеку продажи оплачено картами Wisteria "
				+ "и возвращается только на карты, кнопкой «Оплатить сертификатом».",
				Формат(ПКВ_ЛимитНеКартами, "ЧДЦ=2; ЧН=0; ЧГ=0")));
		КонецЕсли;
		
	КонецЕсли;
	
	Если Ошибки.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПоказатьПредупреждение(, СтрСоединить(Ошибки, Символы.ПС + Символы.ПС), , "Подарочные карты Wisteria");
	Возврат Ложь;
	
КонецФункции

// Строки наших карт в чеке возврата, для которых не назначен номер карты.
&НаСервере
Функция ПКВ_ПроверитьСтрокиКартВозвратаНаСервере()
	
	Ошибки = Новый Массив;
	
	Если Не ЗначениеЗаполнено(ЧекККМПродажа) Или Не ПКВ_ПодарочныеКартыAPI.ИспользоватьОбмен() Тогда
		Возврат Ошибки;
	КонецЕсли;
	
	НоменклатураКарт = Новый Массив;
	НоменклатураКарт.Добавить(ПКВ_ПодарочныеКартыAPI.НоменклатураЭлектроннаяКарта());
	НоменклатураКарт.Добавить(ПКВ_ПодарочныеКартыAPI.НоменклатураПластиковаяКарта());
	
	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТоваров.Номенклатура)
			Или НоменклатураКарт.Найти(СтрокаТоваров.Номенклатура) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПКВ_ОжидающиеВозвратыКарт.НайтиСтроки(
			Новый Структура("ИдентификаторСтроки", СтрокаТоваров.ИдентификаторСтроки)).Количество() = 0 Тогда
			Ошибки.Добавить(СтрШаблон(
				"В чеке возврата есть строка подарочной карты на %1 ₽ без номера карты. Удалите её или повторите возврат по чеку.",
				Формат(СтрокаТоваров.Сумма, "ЧДЦ=2; ЧГ=0")));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции

#КонецОбласти
