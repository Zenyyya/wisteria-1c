
&НаКлиенте
Процедура ПКВ_КнопкаВыпуск(Команда)
	
	ОткрытьФорму(
		"Обработка.ПКВ_ПодарочныеКарты.Форма.ФормаРегистрацииКарты",
		Новый Структура,
		ЭтотОбъект,
		, , ,
		Новый ОписаниеОповещения("ПКВ_ПослеРегистрацииКарты", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ПослеРегистрацииКарты(РезультатЗакрытия, ДопПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат; // кассир нажал "Отмена"
	КонецЕсли;
	
	ПКВ_ОбработатьРегистрациюКарты(РезультатЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_КнопкаПросмотр(Команда)
	
	ОткрытьФорму("ОбщаяФорма.ПКВ_ФормаПросмотрКарты", Новый Структура, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_КнопкаСписание(Команда)
	
	Если Объект.Товары.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Списание с карты возможно только когда в чеке есть товары.", , "Внимание");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицуЧековКПробитию();
	ПересчитатьОбщиеИтоги();
	
	ПараметрыФормы = Новый Структура("СуммаКОплате", ОбщийОсталосьОплатить);
	
	ОткрытьФорму("ОбщаяФорма.ПКВ_ФормаСписание", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_КнопкаПривязка(Команда)
	
	ОткрытьФорму("ОбщаяФорма.ПКВ_ФормаПривязкаВладельца", Новый Структура, ЭтотОбъект);
	
КонецПроцедуры

// =============================================================================


#Область РеквизитыФормы

// ПКВ_ОжидающиеКарты — Таблица значений. Колонки: ИдентификаторСтроки,
// ТипКарты, Сценарий, Номинал, ТелефонОтправителя, ТелефонПолучателя,
// Поздравление, НомерФизКарты.
//
// ПКВ_ОжидающиеСписания — Таблица значений. Колонки: HoldId, НомерКарты, Сумма.
//
// ПКВ_ИдентификаторСтрокиСписания — Строка(50). Запоминает
// УникальныйИдентификатор строки в ТаблицаПодарочныхСертификатов между
// нажатиями кнопки "Перенести в чек" — чтобы повторный перенос (если
// кассир добавил ещё списаний и нажал кнопку снова) обновлял ТУ ЖЕ
// строку, а не плодил новую (в чеке сумма оплаты сертификатом может
// быть только одна).

#КонецОбласти


#Область ПодарочныеКартыWisteria

// Стандартный клиентский обработчик глобальных оповещений 1С (событие
// формы NotificationProcessing) — ловит события от форм панели кассира
// (Списание, Привязка владельца), которые открыты отдельно и не имеют
// прямой ссылки на эту форму.
&НаКлиенте
Процедура ПКВ_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник) Экспорт
	
	Если ИмяСобытия = "ПКВ_КартаЗарегистрирована" Тогда
		ПКВ_ОбработатьРегистрациюКарты(Параметр);
	ИначеЕсли ИмяСобытия = "ПКВ_СписаниеПодтверждено" Тогда
		ПКВ_ОбработатьПодтверждениеСписания(Параметр);
	ИначеЕсли ИмяСобытия = "ПКВ_СписаниеПеренесеноВЧек" Тогда
		ПКВ_ОтразитьСуммуСписанияВОплатеЧека(Параметр.Сумма, Параметр.НомераКарт);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область Выпуск

&НаКлиенте
Процедура ПКВ_ОбработатьРегистрациюКарты(РезультатЗакрытия)
	
	Если РезультатЗакрытия.ТипКарты = "plastic" Тогда
		НоменклатураСсылка = ПКВ_ПодарочныеКартыAPI.НоменклатураПластиковаяКарта();
	Иначе
		НоменклатураСсылка = ПКВ_ПодарочныеКартыAPI.НоменклатураЭлектроннаяКарта();
	КонецЕсли;
	
	// Артикул и штрихкод — разные регистры данных в этой конфигурации;
	// без явной регистрации штрихкода типовой поиск (ОбработатьШтрихкодКлиент)
	// номенклатуру не найдёт, даже если у неё заполнен Артикул. Идемпотентно —
	// безопасно вызывать при каждом выпуске карты.
	ПКВ_ПодарочныеКартыAPI.УбедитьсяЧтоШтрихкодЗарегистрирован(НоменклатураСсылка);
	
	Если РезультатЗакрытия.ТипКарты = "plastic" Тогда
		КодНоменклатуры = ПКВ_ПодарочныеКартыAPI.КодСканированияПоТипуКарты("plastic");
	Иначе
		КодНоменклатуры = ПКВ_ПодарочныеКартыAPI.КодСканированияПоТипуКарты("electronic");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КодНоменклатуры) Тогда
		ПоказатьПредупреждение(,
			"Не задана номенклатура подарочной карты в настройках (админка → константы), "
			+ "либо у неё не заполнен Артикул. Строка в чек НЕ добавлена, карта НЕ будет создана в Directus.",
			, "Ошибка");
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтроки = ПКВ_ДобавитьКартуВЧек(КодНоменклатуры, РезультатЗакрытия.Номинал);
	
	Если ИдентификаторСтроки = Неопределено Тогда
		ПоказатьПредупреждение(,
			СтрШаблон("Не удалось добавить карту в чек — номенклатура с артикулом ""%1"" не найдена.", КодНоменклатуры),
			, "Ошибка");
		Возврат;
	КонецЕсли;
	
	// ПКВ_ОжидающиеКарты — реквизит формы типа "Таблица значений" (тип
	// "Произвольный" с Массивом внутри платформа в данные формы не пускает —
	// "Тип 'Массив' не может использоваться в данных формы").
	НоваяСтрокаБуфера = ПКВ_ОжидающиеКарты.Добавить();
	НоваяСтрокаБуфера.ИдентификаторСтроки     = ИдентификаторСтроки;
	НоваяСтрокаБуфера.ТипКарты                = РезультатЗакрытия.ТипКарты;
	НоваяСтрокаБуфера.Сценарий                 = РезультатЗакрытия.Сценарий;
	НоваяСтрокаБуфера.Номинал                  = РезультатЗакрытия.Номинал;
	НоваяСтрокаБуфера.ТелефонОтправителя       = РезультатЗакрытия.ТелефонОтправителя;
	НоваяСтрокаБуфера.ТелефонПолучателя        = РезультатЗакрытия.ТелефонПолучателя;
	НоваяСтрокаБуфера.Поздравление             = РезультатЗакрытия.Поздравление;
	НоваяСтрокаБуфера.НомерФизКарты            = РезультатЗакрытия.НомерФизКарты;
	
КонецПроцедуры

// Добавляет строку в чек программно тем же способом, что и обычный скан
// штрихкода (переиспользует всю типовую логику расчёта налогов, скидок,
// организации и т.д. — см. предупреждение в шапке файла). Код для скана
// берётся из Артикула номенклатуры, выбранной в админке для данного типа
// карты — см. ПКВ_ПодарочныеКартыAPI.КодСканированияПоТипуКарты.
&НаКлиенте
Функция ПКВ_ДобавитьКартуВЧек(КодНоменклатуры, Номинал)
	
	СтрокДоДобавления = Объект.Товары.Количество();
	
	ОбработатьШтрихкодКлиент(КодНоменклатуры);
	
	Если Объект.Товары.Количество() <= СтрокДоДобавления Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НоваяСтрока = Объект.Товары[Объект.Товары.Количество() - 1];
	
	ПКВ_УстановитьЦенуКартыНаСервере(НоваяСтрока.ИдентификаторСтроки, Номинал);
	
	// Переустановка строки — чтобы интерфейс перечитал данные ...
	Элементы.Товары.ТекущаяСтрока = Неопределено;
	Элементы.Товары.ТекущаяСтрока = НоваяСтрока.ИдентификаторСтроки;
	
	// ... но сама переустановка, похоже, заново тянет цену из карточки
	// номенклатуры в ТекущийТоварЦенаИзКарточки — принудительно проставляем
	// номинал СРАЗУ ПОСЛЕ, чтобы он не потерялся.
	ТекущийТоварЦенаИзКарточки = Номинал;
	
	Возврат НоваяСтрока.ИдентификаторСтроки;
	
КонецФункции

&НаСервере
Процедура ПКВ_УстановитьЦенуКартыНаСервере(ИдентификаторСтроки, Номинал)
	
	НайденныеСтроки = Объект.Товары.НайтиСтроки(
		Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Строка = НайденныеСтроки[0];
	Строка.Количество = 1;
	
	// Сначала стандартный пересчёт (нужен для организации/ставки НДС/скидок
	// и прочих полей строки, которые сама типовая логика заполняет верно) —
	// но он же может сбросить цену в 0, если в прайс-листе для этой
	// номенклатуры цены не задано.
	ОбщегоНазначенияРМККлиентСервер.ПересчитатьСуммуВСтроке(ЭтотОбъект, Строка, , ИспользоватьАвтоматическиеСкидки);
	
	// Теперь принудительно проставляем номинал — после пересчёта, чтобы
	// он не был перезатёрт логикой прайс-листа.
	Строка.Цена  = Номинал;
	Строка.Сумма = Номинал;
	
	ОбщегоНазначенияРМККлиентСервер.РассчитатьСуммуНДС(Объект, Строка);
	ОбщегоНазначенияРМККлиентСервер.СуммаДокумента(Объект);
	
КонецПроцедуры

#КонецОбласти


#Область Списание

// Буфер ПКВ_ОжидающиеСписания копит подтверждённые holds для автосписания
// в Directus после оплаты чека (через хук ПробитьЧекЗавершение). Отражение
// суммы В САМОЙ ОПЛАТЕ чека теперь НЕ происходит здесь автоматически —
// кассир делает это явно кнопкой "Перенести в чек" на ПКВ_ФормаСписание,
// см. ПКВ_ОтразитьСуммуСписанияВОплатеЧека ниже.
&НаКлиенте
Процедура ПКВ_ОбработатьПодтверждениеСписания(ЗаписьСписания)
	
	// ПКВ_ОжидающиеСписания — реквизит формы типа "Таблица значений" (тип
	// "Произвольный" с Массивом внутри платформа в данные формы не пускает).
	НоваяСтрокаБуфера = ПКВ_ОжидающиеСписания.Добавить();
	НоваяСтрокаБуфера.HoldId     = ЗаписьСписания.HoldId;
	НоваяСтрокаБуфера.НомерКарты = ЗаписьСписания.НомерКарты;
	НоваяСтрокаБуфера.Сумма      = ЗаписьСписания.Сумма;
	
КонецПроцедуры

// Отражает ОБЩУЮ сумму подтверждённых списаний в оплате чека — вызывается
// ОДИН РАЗ по кнопке "Перенести в чек" на ПКВ_ФормаСписание (после того как
// кассир подтвердил, возможно, несколько карт подряд), а не по каждой карте
// отдельно. В чеке сумма оплаты сертификатом может быть только одна —
// строка обновляется, а не дублируется при повторном переносе.
//
// Номенклатура для строки сертификата — та же ПКВ_НоменклатураПластиковаяКарта,
// что и при выпуске пластиковой карты (она уже настроена с типом
// "Подарочный сертификат" — используется и на продаже, и на оплате,
// отдельная константа для оплаты не нужна).
//
// Безопасно: настоящее обращение к "серверу лояльности" типовой РМК
// (СписатьПодарочныйСертификат) срабатывает только если включена типовая
// интеграция ИспользоватьСерверЛояльностиПолучательДанных — у нас она не
// используется (свой Directus), поэтому наши строки её не спровоцируют.
&НаКлиенте
Процедура ПКВ_ОтразитьСуммуСписанияВОплатеЧека(Сумма, НомераКарт)
	
	НоменклатураСертификата = ПКВ_ПодарочныеКартыAPI.НоменклатураПластиковаяКарта();
	
	Если Не ЗначениеЗаполнено(НоменклатураСертификата) Тогда
		ПоказатьПредупреждение(,
			"Не задана номенклатура пластиковой карты в настройках (админка → константы). "
			+ "Списание НЕ отражено в оплате чека — суммы всё равно спишутся в Directus после "
			+ "пробития, но кассиру нужно самостоятельно учесть эту сумму в оплате чека.",
			, "Внимание");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПКВ_ИдентификаторСтрокиСписания) Тогда
		СтарыеСтроки = ТаблицаПодарочныхСертификатов.НайтиСтроки(
			Новый Структура("УникальныйИдентификатор", ПКВ_ИдентификаторСтрокиСписания));
		Для Каждого СтараяСтрока Из СтарыеСтроки Цикл
			ТаблицаПодарочныхСертификатов.Удалить(СтараяСтрока);
		КонецЦикла;
		УдалитьЭлементПодарочногоСертификата(ПКВ_ИдентификаторСтрокиСписания);
	КонецЕсли;
	
	ЗаполнитьТаблицуЧековКПробитию();
	ПереключитьНаСледующийЧек();
	
	ПараметрыСертификата = Новый Структура;
	ПараметрыСертификата.Вставить("НомерПодарочногоСертификата", НомераКарт);
	ПараметрыСертификата.Вставить("ПодарочныйСертификат", НоменклатураСертификата);
	ПараметрыСертификата.Вставить("ЭтоСерийныйПодарочныйСертификат", Ложь);
	ПараметрыСертификата.Вставить("БалансСертификата", Сумма);
	ПараметрыСертификата.Вставить("СертификатСгорает", Ложь);
	
	ПКВ_ИдентификаторСтрокиСписания = ДобавитьПодарочныйСертификатВТаблицу(ПараметрыСертификата, Сумма);
	
	Отбор = Новый Структура("УникальныйИдентификатор", ПКВ_ИдентификаторСтрокиСписания);
	ДобавленныеСтроки = ТаблицаПодарочныхСертификатов.НайтиСтроки(Отбор);
	Для Каждого СтрокаДанныхСертификата Из ДобавленныеСтроки Цикл
		СтрокаДанныхСертификата.РешениеПоОстатку = ДействияСОстаткомПодарочногоСертификата.ПодтвердитьСгорание;
	КонецЦикла;
	
	ОбновитьУведомленияОСгоранииСертификата();
	ПересчитатьСуммыОплатыПриРедактированииСертификатов();
	ИзменитьКомандуСертификат();
	ПересчитатьОбщиеИтоги();
	
КонецПроцедуры


#КонецОбласти
