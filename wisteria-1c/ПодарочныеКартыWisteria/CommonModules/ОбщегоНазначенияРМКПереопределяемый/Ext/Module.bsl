
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Расширяет типовую (пустую) процедуру — выполняется ПОСЛЕ неё, строго
// после успешного пробития чека (проверено базовой процедурой ДО вызова
// этого расширения). Обрабатывает ОБА буфера ФормаРМК:
//   1. ПКВ_ОжидающиеКарты      — создаёт карты в Directus (выпуск)
//   2. ПКВ_ОжидающиеСписания   — списывает holds в Directus (оплата картой)
//
// Параметры:
//   ВходящиеДанные - Структура - содержит ЧекККМСсылка
//   Форма          - УправляемаяФорма - ФормаРМК, с реквизитами-буферами
//
&ИзменениеИКонтроль("ПробитьЧекЗавершение")
Процедура ПКВ_ПробитьЧекЗавершение(ВходящиеДанные, Форма) Экспорт
	
	ОбщегоНазначенияРМКУНФ.ПробитьЧекЗавершение(ВходящиеДанные, Форма);
	
	#Вставка
	НомерЧека = "";
	ПредставлениеДокумента = "";
	Попытка
		Если ВходящиеДанные.Свойство("ЧекККМСсылка")
		    И ЗначениеЗаполнено(ВходящиеДанные.ЧекККМСсылка) Тогда
		    НомерЧека = Строка(ВходящиеДанные.ЧекККМСсылка.Номер);
		    ПредставлениеДокумента = Строка(ВходящиеДанные.ЧекККМСсылка);
		КонецЕсли;
	Исключение
		НомерЧека = "";
		ПредставлениеДокумента = "";
	КонецПопытки;
	
	ПКВ_ОбработатьВыпускКарт(Форма, НомерЧека, ПредставлениеДокумента);
	ПКВ_ОбработатьСписания(Форма, НомерЧека);
	#КонецВставки
	
КонецПроцедуры

Процедура ПКВ_ОбработатьВыпускКарт(Форма, НомерЧека, ПредставлениеДокумента)
	
	Попытка
		ОжидающиеКарты = Форма.ПКВ_ОжидающиеКарты;
	Исключение
		Возврат;
	КонецПопытки;
	
	Если ОжидающиеКарты = Неопределено ИЛИ ОжидающиеКарты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ОжидающаяКарта Из ОжидающиеКарты Цикл
		
		Результат = ПКВ_ПодарочныеКартыAPI.СоздатьКарту(ОжидающаяКарта, НомерЧека, ПредставлениеДокумента);
		
		Если Не Результат.Успех Тогда
			ЗаписьЖурналаРегистрации(
				"ПКВ_ПодарочныеКарты.ВыпускПослеЧека",
				УровеньЖурналаРегистрации.Ошибка,
				,,
				СтрШаблон(
					"Чек №%1 пробит успешно, но карта НЕ оформлена в Directus: %2
					|Тип: %3, Сценарий: %4, Номинал: %5",
					НомерЧека, Результат.ТекстОш,
					ОжидающаяКарта.ТипКарты, ОжидающаяКарта.Сценарий, ОжидающаяКарта.Номинал));
		КонецЕсли;
		
	КонецЦикла;
	
	Форма.ПКВ_ОжидающиеКарты.Очистить();
	
КонецПроцедуры

// Обрабатывает буфер ПКВ_ОжидающиеСписания — списывает holds в Directus
// (POST /debit/commit через ПКВ_ПодарочныеКартыAPI.СписатьHold). Кассир НЕ
// может списать эти деньги вручную — только через этот хук (регламент §3
// ТЗ v3.0).
Процедура ПКВ_ОбработатьСписания(Форма, НомерЧека)
	
	Попытка
		ОжидающиеСписания = Форма.ПКВ_ОжидающиеСписания;
	Исключение
		Возврат; // ФормаРМК ещё не содержит буфер списаний
	КонецПопытки;
	
	Если ОжидающиеСписания = Неопределено ИЛИ ОжидающиеСписания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ОжидающееСписание Из ОжидающиеСписания Цикл
		
		Результат = ПКВ_ПодарочныеКартыAPI.СписатьHold(ОжидающееСписание.HoldId, НомерЧека);
		
		Если Не Результат.Успех Тогда
			// Чек уже пробит — списание придётся довести вручную через
			// ПКВ_ФормаКассираАдмин (там остались ручные кнопки commit/release)
			// по HoldId из этого сообщения.
			ЗаписьЖурналаРегистрации(
				"ПКВ_ПодарочныеКарты.СписаниеПослеЧека",
				УровеньЖурналаРегистрации.Ошибка,
				,,
				СтрШаблон(
					"Чек №%1 пробит успешно, но списание НЕ подтверждено в Directus: %2
					|HoldId: %3, Карта: %4, Сумма: %5",
					НомерЧека, Результат.ТекстОш,
					ОжидающееСписание.HoldId, ОжидающееСписание.НомерКарты, ОжидающееСписание.Сумма));
		КонецЕсли;
		
	КонецЦикла;
	
	Форма.ПКВ_ОжидающиеСписания.Очистить();
	
КонецПроцедуры

#КонецЕсли
