#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&ИзменениеИКонтроль("ПробитьЧекЗавершение")
Процедура ПКВ_ПробитьЧекЗавершение(ВходящиеДанные, Форма) Экспорт

	ОбщегоНазначенияРМКУНФ.ПробитьЧекЗавершение(ВходящиеДанные, Форма);

	#Вставка
	ПКВ_ОбработатьПробитыйЧек(ВходящиеДанные, Форма);
	#КонецВставки

КонецПроцедуры

#Область ПКВ_ПодарочныеКартыWisteria

Процедура ПКВ_ОбработатьПробитыйЧек(ВходящиеДанные, Форма)

	Если Не ПКВ_ЧекПродажиПробитУспешно(ВходящиеДанные) Тогда
		Возврат;
	КонецЕсли;

	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ПКВ_ОжидающиеКарты") Тогда
		Возврат;
	КонецЕсли;

	Если Форма.ПКВ_ОжидающиеКарты.Количество() = 0
		И Форма.ПКВ_ОжидающиеСписания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЧекККМ = ВходящиеДанные.ЧекККМСсылка;
	ДанныеЧека = ПКВ_ДанныеЧека(ЧекККМ);

	ПКВ_ОбработатьВыпускКарт(Форма, ЧекККМ, ДанныеЧека);
	ПКВ_ОбработатьСписания(Форма, ЧекККМ, ДанныеЧека);

КонецПроцедуры

// Истина, если успешно пробит чек продажи (не возврат).
// Условие успеха то же, что в типовой ОбщегоНазначенияРМКУНФ.ПробитьЧекЗавершение.
Функция ПКВ_ЧекПродажиПробитУспешно(ВходящиеДанные)

	Если Не ВходящиеДанные.Свойство("ЧекККМСсылка")
		Или ТипЗнч(ВходящиеДанные.ЧекККМСсылка) <> Тип("ДокументСсылка.ЧекККМ")
		Или Не ЗначениеЗаполнено(ВходящиеДанные.ЧекККМСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не ВходящиеДанные.Свойство("Результат") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ВходящиеДанные.Результат = Истина Тогда
		Возврат Истина;
	КонецЕсли;

	Если ВходящиеДанные.Результат = Ложь
		И ВходящиеДанные.Свойство("РезультатПакетнойОперации")
		И ЗначениеЗаполнено(ВходящиеДанные.РезультатПакетнойОперации)
		И ВходящиеДанные.РезультатПакетнойОперации.Свойство("РезультатФискализацииЧека")
		И ЗначениеЗаполнено(ВходящиеДанные.РезультатПакетнойОперации.РезультатФискализацииЧека)
		И ВходящиеДанные.РезультатПакетнойОперации.РезультатФискализацииЧека.Свойство("Результат") Тогда

		Возврат ВходящиеДанные.РезультатПакетнойОперации.РезультатФискализацииЧека.Результат = Истина;

	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Строки карт и сумма оплаты нашими картами в пробитом чеке.
Функция ПКВ_ДанныеЧека(ЧекККМ)

	НоменклатураЭлектронная = ПКВ_ПодарочныеКартыAPI.НоменклатураЭлектроннаяКарта();
	НоменклатураПластиковая = ПКВ_ПодарочныеКартыAPI.НоменклатураПластиковаяКарта();

	НоменклатураКарт = Новый Массив;
	Если ЗначениеЗаполнено(НоменклатураЭлектронная) Тогда
		НоменклатураКарт.Добавить(НоменклатураЭлектронная);
	КонецЕсли;
	Если ЗначениеЗаполнено(НоменклатураПластиковая) Тогда
		НоменклатураКарт.Добавить(НоменклатураПластиковая);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Запасы.Номенклатура КАК Номенклатура,
	|	Запасы.Цена КАК Цена,
	|	СУММА(Запасы.Количество) КАК Количество
	|ИЗ
	|	Документ.ЧекККМ.Запасы КАК Запасы
	|ГДЕ
	|	Запасы.Ссылка = &ЧекККМ
	|	И Запасы.Номенклатура В (&НоменклатураКарт)
	|
	|СГРУППИРОВАТЬ ПО
	|	Запасы.Номенклатура,
	|	Запасы.Цена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Оплата.Сумма), 0) КАК Сумма
	|ИЗ
	|	Документ.ЧекККМ.БезналичнаяОплата КАК Оплата
	|ГДЕ
	|	Оплата.Ссылка = &ЧекККМ
	|	И Оплата.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ВидыБезналичныхОплат.ПодарочныйСертификат)
	|	И Оплата.ПодарочныйСертификат = &НоменклатураСертификата";

	Запрос.УстановитьПараметр("ЧекККМ", ЧекККМ);
	Запрос.УстановитьПараметр("НоменклатураКарт", НоменклатураКарт);
	Запрос.УстановитьПараметр("НоменклатураСертификата", НоменклатураПластиковая);

	Результаты = Запрос.ВыполнитьПакет();

	ВыборкаОплаты = Результаты[1].Выбрать();
	ВыборкаОплаты.Следующий();

	ДанныеЧека = Новый Структура;
	ДанныеЧека.Вставить("Чек", ПКВ_ПодарочныеКартыAPI.ДанныеЧека(ЧекККМ));
	ДанныеЧека.Вставить("Карты", Результаты[0].Выгрузить());
	ДанныеЧека.Вставить("СуммаОплатыКартами", ВыборкаОплаты.Сумма);
	ДанныеЧека.Вставить("НоменклатураЭлектронная", НоменклатураЭлектронная);
	ДанныеЧека.Вставить("НоменклатураПластиковая", НоменклатураПластиковая);

	Возврат ДанныеЧека;

КонецФункции

// Карта оформляется, только если её строка ещё есть в корзине и в пробитом
// чеке есть строка карты с ценой, равной номиналу.
// Если строки в корзине нет (удалили из чека), запись убирается из буфера.
// Если строка в корзине есть, а в этом чеке её нет, запись ждёт следующего чека набора.
Процедура ПКВ_ОбработатьВыпускКарт(Форма, ЧекККМ, ДанныеЧека)

	ОжидающиеКарты = Форма.ПКВ_ОжидающиеКарты;

	Если ОжидающиеКарты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	НомерЧека = ДанныеЧека.Чек.number;
	ЗаписиКУдалению = Новый Массив;

	Для Каждого ОжидающаяКарта Из ОжидающиеКарты Цикл

		СтрокиКорзины = Форма.Объект.Товары.НайтиСтроки(
			Новый Структура("ИдентификаторСтроки", ОжидающаяКарта.ИдентификаторСтроки));

		Если СтрокиКорзины.Количество() = 0 Тогда
			ЗаписиКУдалению.Добавить(ОжидающаяКарта);
			Продолжить;
		КонецЕсли;

		Если ОжидающаяКарта.ТипКарты = "plastic" Тогда
			Номенклатура = ДанныеЧека.НоменклатураПластиковая;
		Иначе
			Номенклатура = ДанныеЧека.НоменклатураЭлектронная;
		КонецЕсли;

		СтрокиЧека = ДанныеЧека.Карты.НайтиСтроки(
			Новый Структура("Номенклатура, Цена", Номенклатура, ОжидающаяКарта.Номинал));

		Если СтрокиЧека.Количество() = 0 Или СтрокиЧека[0].Количество < 1 Тогда
			Продолжить;
		КонецЕсли;

		СтрокиЧека[0].Количество = СтрокиЧека[0].Количество - 1;
		ЗаписиКУдалению.Добавить(ОжидающаяКарта);

		Результат = ПКВ_ПодарочныеКартыAPI.СоздатьКарту(ОжидающаяКарта, ДанныеЧека.Чек);

		Если Не Результат.Успех Тогда

			ЗаписьЖурналаРегистрации(
				"ПКВ_ПодарочныеКарты.ВыпускПослеЧека",
				УровеньЖурналаРегистрации.Ошибка,
				,
				ЧекККМ,
				СтрШаблон(
					"Чек №%1 пробит, но карта не оформлена в Directus: %2
					|Тип: %3, сценарий: %4, номинал: %5, номер пластиковой карты: %6,
					|телефон отправителя: %7, телефон получателя: %8",
					НомерЧека, Результат.ТекстОш,
					ОжидающаяКарта.ТипКарты, ОжидающаяКарта.Сценарий, ОжидающаяКарта.Номинал,
					ОжидающаяКарта.НомерФизКарты, ОжидающаяКарта.ТелефонОтправителя,
					ОжидающаяКарта.ТелефонПолучателя));

			Сохранено = ПКВ_НезавершённыеОперацииСервер.Добавить(
				"Выпуск карты", ЧекККМ, Результат.Запрос, Результат.Запрос.Описание, Результат.ТекстОш);
			
			ПКВ_ДобавитьОшибкуДляКассира(Форма, СтрШаблон(
				"Чек №%1: не оформлена %2 карта на %3 ₽.
				|%4",
				НомерЧека,
				ПКВ_ПредставлениеТипаКарты(ОжидающаяКарта.ТипКарты),
				Формат(ОжидающаяКарта.Номинал, "ЧДЦ=2; ЧГ=0"),
				Результат.ТекстОш), Сохранено);

		КонецЕсли;

	КонецЦикла;

	Для Каждого ЗаписьКУдалению Из ЗаписиКУдалению Цикл
		ОжидающиеКарты.Удалить(ЗаписьКУдалению);
	КонецЦикла;

КонецПроцедуры

// Списания проводятся, только если в пробитом чеке есть оплата нашими картами
// и её сумма равна сумме подтверждённых списаний. При расхождении ничего не
// списывается: в журнал пишутся HoldId для ручного проведения через
// ПКВ_ФормаКассираАдмин.
// Если в чеке нет оплаты картами, буфер ждёт следующего чека набора.
Процедура ПКВ_ОбработатьСписания(Форма, ЧекККМ, ДанныеЧека)

	ОжидающиеСписания = Форма.ПКВ_ОжидающиеСписания;

	Если ОжидающиеСписания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ДанныеЧека.СуммаОплатыКартами = 0 Тогда
		Возврат;
	КонецЕсли;

	НомерЧека = ДанныеЧека.Чек.number;

	СуммаСписаний = 0;
	СписокHold = Новый Массив;
	Для Каждого ОжидающееСписание Из ОжидающиеСписания Цикл
		СуммаСписаний = СуммаСписаний + ОжидающееСписание.Сумма;
		СписокHold.Добавить(СтрШаблон("HoldId: %1, карта: %2, сумма: %3",
			ОжидающееСписание.HoldId, ОжидающееСписание.НомерКарты, ОжидающееСписание.Сумма));
	КонецЦикла;

	Если СуммаСписаний <> ДанныеЧека.СуммаОплатыКартами Тогда

		ЗаписьЖурналаРегистрации(
			"ПКВ_ПодарочныеКарты.СписаниеПослеЧека",
			УровеньЖурналаРегистрации.Ошибка,
			,
			ЧекККМ,
			СтрШаблон(
				"Чек №%1 пробит, но списания не проведены: оплата картами в чеке %2, подтверждено списаний %3.
				|uid чека: %4
				|%5",
				НомерЧека, ДанныеЧека.СуммаОплатыКартами, СуммаСписаний,
				ДанныеЧека.Чек.uid,
				СтрСоединить(СписокHold, Символы.ПС)));

		ТекстОшибки = СтрШаблон(
			"Сумма оплаты картами в чеке (%1 ₽) не совпадает с подтверждёнными списаниями (%2 ₽). "
			+ "Повторяйте, только если списание с этой карты верное.",
			ДанныеЧека.СуммаОплатыКартами, СуммаСписаний);
		
		Сохранено = Истина;
		Для Каждого ОжидающееСписание Из ОжидающиеСписания Цикл
			Сохранено = ПКВ_СохранитьСписание(ЧекККМ, ДанныеЧека.Чек, ОжидающееСписание, ТекстОшибки) И Сохранено;
		КонецЦикла;
		
		ПКВ_ДобавитьОшибкуДляКассира(Форма, СтрШаблон(
			"Чек №%1: списание с подарочных карт не проведено, сумма оплаты картами в чеке не совпадает с подтверждёнными списаниями.",
			НомерЧека), Сохранено);

	Иначе

		Для Каждого ОжидающееСписание Из ОжидающиеСписания Цикл

			Результат = ПКВ_ПодарочныеКартыAPI.СписатьHold(ОжидающееСписание.HoldId, ДанныеЧека.Чек);

			Если Не Результат.Успех Тогда

				ТекстОшибки = ПКВ_ПодарочныеКартыAPI.ТекстОшибки(Результат);

				ЗаписьЖурналаРегистрации(
					"ПКВ_ПодарочныеКарты.СписаниеПослеЧека",
					УровеньЖурналаРегистрации.Ошибка,
					,
					ЧекККМ,
					СтрШаблон(
						"Чек №%1 пробит, но списание не подтверждено в Directus: %2
						|HoldId: %3, карта: %4, сумма: %5, uid чека: %6",
						НомерЧека, ТекстОшибки,
						ОжидающееСписание.HoldId, ОжидающееСписание.НомерКарты, ОжидающееСписание.Сумма,
						ДанныеЧека.Чек.uid));

				Сохранено = ПКВ_СохранитьСписание(ЧекККМ, ДанныеЧека.Чек, ОжидающееСписание, ТекстОшибки);
				
				ПКВ_ДобавитьОшибкуДляКассира(Форма, СтрШаблон(
					"Чек №%1: не проведено списание %2 ₽ с карты %3.
					|%4",
					НомерЧека,
					Формат(ОжидающееСписание.Сумма, "ЧДЦ=2; ЧГ=0"),
					ОжидающееСписание.НомерКарты,
					ТекстОшибки), Сохранено);

			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	ОжидающиеСписания.Очистить();
	Форма.ПКВ_ИдентификаторСтрокиСписания = "";

КонецПроцедуры

// Hold живёт 30 минут: повторить списание можно только в это время.
Функция ПКВ_СохранитьСписание(ЧекККМ, Чек, ОжидающееСписание, ТекстОшибки)
	
	Запрос = ПКВ_ПодарочныеКартыAPI.ЗапросСписания(ОжидающееСписание.HoldId, Чек);
	
	Описание = СтрШаблон("Списание %1 ₽ с карты %2 (HoldId %3). Повторить можно в течение 30 минут после подтверждения кода.",
		ОжидающееСписание.Сумма, ОжидающееСписание.НомерКарты, ОжидающееСписание.HoldId);
	
	Возврат ПКВ_НезавершённыеОперацииСервер.Добавить("Списание с карты", ЧекККМ, Запрос, Описание, ТекстОшибки);
	
КонецФункции

Процедура ПКВ_ДобавитьОшибкуДляКассира(Форма, Знач Текст, Сохранено = Ложь)
	
	Если Сохранено Тогда
		Текст = Текст + Символы.ПС + "Операция сохранена, управляющий может повторить её в разделе «Незавершённые операции».";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Форма.ПКВ_ОшибкиПослеЧека) Тогда
		Форма.ПКВ_ОшибкиПослеЧека = Форма.ПКВ_ОшибкиПослеЧека + Символы.ПС + Символы.ПС + Текст;
	Иначе
		Форма.ПКВ_ОшибкиПослеЧека = Текст;
	КонецЕсли;

КонецПроцедуры

Функция ПКВ_ПредставлениеТипаКарты(ТипКарты)

	Если ТипКарты = "plastic" Тогда
		Возврат "пластиковая";
	КонецЕсли;

	Возврат "электронная";

КонецФункции

#КонецОбласти

#КонецЕсли
