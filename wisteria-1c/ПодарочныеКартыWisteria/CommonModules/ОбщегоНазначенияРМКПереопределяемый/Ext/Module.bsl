#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&ИзменениеИКонтроль("ПробитьЧекЗавершение")
Процедура ПКВ_ПробитьЧекЗавершение(ВходящиеДанные, Форма) Экспорт

	ОбщегоНазначенияРМКУНФ.ПробитьЧекЗавершение(ВходящиеДанные, Форма);

	#Вставка
	ПКВ_ОбработатьПробитыйЧек(ВходящиеДанные, Форма);
	#КонецВставки

КонецПроцедуры

#Область ПКВ_ПодарочныеКартыWisteria

Процедура ПКВ_ОбработатьПробитыйЧек(ВходящиеДанные, Форма)
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ПКВ_ОжидающиеКарты") Тогда
		Возврат;
	КонецЕсли;
	
	Если ПКВ_ЧекПробитУспешно(ВходящиеДанные, Тип("ДокументСсылка.ЧекККМ")) Тогда
		ПКВ_ОбработатьЧекПродажи(ВходящиеДанные.ЧекККМСсылка, Форма);
	ИначеЕсли ПКВ_ЧекПробитУспешно(ВходящиеДанные, Тип("ДокументСсылка.ЧекККМВозврат")) Тогда
		ПКВ_ОбработатьЧекВозврата(ВходящиеДанные.ЧекККМСсылка, Форма);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПКВ_ОбработатьЧекПродажи(ЧекККМ, Форма)
	
	Если Форма.ПКВ_ОжидающиеКарты.Количество() = 0
		И Форма.ПКВ_ОжидающиеСписания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЧека = ПКВ_ДанныеЧека(ЧекККМ);
	
	ПКВ_ОбработатьВыпускКарт(Форма, ЧекККМ, ДанныеЧека);
	ПКВ_ОбработатьСписания(Форма, ЧекККМ, ДанныеЧека);
	
КонецПроцедуры

// Истина, если успешно пробит чек указанного типа.
// Условие успеха то же, что в типовой ОбщегоНазначенияРМКУНФ.ПробитьЧекЗавершение.
Функция ПКВ_ЧекПробитУспешно(ВходящиеДанные, ТипЧека)
	
	Если Не ВходящиеДанные.Свойство("ЧекККМСсылка")
		Или ТипЗнч(ВходящиеДанные.ЧекККМСсылка) <> ТипЧека
		Или Не ЗначениеЗаполнено(ВходящиеДанные.ЧекККМСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не ВходящиеДанные.Свойство("Результат") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ВходящиеДанные.Результат = Истина Тогда
		Возврат Истина;
	КонецЕсли;

	Если ВходящиеДанные.Результат = Ложь
		И ВходящиеДанные.Свойство("РезультатПакетнойОперации")
		И ЗначениеЗаполнено(ВходящиеДанные.РезультатПакетнойОперации)
		И ВходящиеДанные.РезультатПакетнойОперации.Свойство("РезультатФискализацииЧека")
		И ЗначениеЗаполнено(ВходящиеДанные.РезультатПакетнойОперации.РезультатФискализацииЧека)
		И ВходящиеДанные.РезультатПакетнойОперации.РезультатФискализацииЧека.Свойство("Результат") Тогда

		Возврат ВходящиеДанные.РезультатПакетнойОперации.РезультатФискализацииЧека.Результат = Истина;

	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Строки карт и сумма оплаты нашими картами в пробитом чеке.
Функция ПКВ_ДанныеЧека(ЧекККМ)

	НоменклатураЭлектронная = ПКВ_ПодарочныеКартыAPI.НоменклатураЭлектроннаяКарта();
	НоменклатураПластиковая = ПКВ_ПодарочныеКартыAPI.НоменклатураПластиковаяКарта();

	НоменклатураКарт = Новый Массив;
	Если ЗначениеЗаполнено(НоменклатураЭлектронная) Тогда
		НоменклатураКарт.Добавить(НоменклатураЭлектронная);
	КонецЕсли;
	Если ЗначениеЗаполнено(НоменклатураПластиковая) Тогда
		НоменклатураКарт.Добавить(НоменклатураПластиковая);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Запасы.Номенклатура КАК Номенклатура,
	|	Запасы.Цена КАК Цена,
	|	СУММА(Запасы.Количество) КАК Количество
	|ИЗ
	|	Документ.ЧекККМ.Запасы КАК Запасы
	|ГДЕ
	|	Запасы.Ссылка = &ЧекККМ
	|	И Запасы.Номенклатура В (&НоменклатураКарт)
	|
	|СГРУППИРОВАТЬ ПО
	|	Запасы.Номенклатура,
	|	Запасы.Цена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Оплата.Сумма), 0) КАК Сумма
	|ИЗ
	|	Документ.ЧекККМ.БезналичнаяОплата КАК Оплата
	|ГДЕ
	|	Оплата.Ссылка = &ЧекККМ
	|	И Оплата.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ВидыБезналичныхОплат.ПодарочныйСертификат)
	|	И Оплата.ПодарочныйСертификат = &НоменклатураСертификата";

	Запрос.УстановитьПараметр("ЧекККМ", ЧекККМ);
	Запрос.УстановитьПараметр("НоменклатураКарт", НоменклатураКарт);
	Запрос.УстановитьПараметр("НоменклатураСертификата", НоменклатураПластиковая);

	Результаты = Запрос.ВыполнитьПакет();

	ВыборкаОплаты = Результаты[1].Выбрать();
	ВыборкаОплаты.Следующий();

	ДанныеЧека = Новый Структура;
	ДанныеЧека.Вставить("Чек", ПКВ_ПодарочныеКартыAPI.ДанныеЧека(ЧекККМ));
	ДанныеЧека.Вставить("Карты", Результаты[0].Выгрузить());
	ДанныеЧека.Вставить("СуммаОплатыКартами", ВыборкаОплаты.Сумма);
	ДанныеЧека.Вставить("НоменклатураЭлектронная", НоменклатураЭлектронная);
	ДанныеЧека.Вставить("НоменклатураПластиковая", НоменклатураПластиковая);

	Возврат ДанныеЧека;

КонецФункции

// Карта оформляется, только если её строка ещё есть в корзине и в пробитом
// чеке есть строка карты с ценой, равной номиналу.
// Если строки в корзине нет (удалили из чека), запись убирается из буфера.
// Если строка в корзине есть, а в этом чеке её нет, запись ждёт следующего чека набора.
Процедура ПКВ_ОбработатьВыпускКарт(Форма, ЧекККМ, ДанныеЧека)

	ОжидающиеКарты = Форма.ПКВ_ОжидающиеКарты;

	Если ОжидающиеКарты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	НомерЧека = ДанныеЧека.Чек.number;
	ЗаписиКУдалению = Новый Массив;

	Для Каждого ОжидающаяКарта Из ОжидающиеКарты Цикл

		СтрокиКорзины = Форма.Объект.Товары.НайтиСтроки(
			Новый Структура("ИдентификаторСтроки", ОжидающаяКарта.ИдентификаторСтроки));

		Если СтрокиКорзины.Количество() = 0 Тогда
			ЗаписиКУдалению.Добавить(ОжидающаяКарта);
			Продолжить;
		КонецЕсли;

		Если ОжидающаяКарта.ТипКарты = "plastic" Тогда
			Номенклатура = ДанныеЧека.НоменклатураПластиковая;
		Иначе
			Номенклатура = ДанныеЧека.НоменклатураЭлектронная;
		КонецЕсли;

		СтрокиЧека = ДанныеЧека.Карты.НайтиСтроки(
			Новый Структура("Номенклатура, Цена", Номенклатура, ОжидающаяКарта.Номинал));

		Если СтрокиЧека.Количество() = 0 Или СтрокиЧека[0].Количество < 1 Тогда
			Продолжить;
		КонецЕсли;

		СтрокиЧека[0].Количество = СтрокиЧека[0].Количество - 1;
		ЗаписиКУдалению.Добавить(ОжидающаяКарта);

		Результат = ПКВ_ПодарочныеКартыAPI.СоздатьКарту(ОжидающаяКарта, ДанныеЧека.Чек);

		Если Не Результат.Успех Тогда

			ЗаписьЖурналаРегистрации(
				"ПКВ_ПодарочныеКарты.ВыпускПослеЧека",
				УровеньЖурналаРегистрации.Ошибка,
				,
				ЧекККМ,
				СтрШаблон(
					"Чек №%1 пробит, но карта не оформлена в Directus: %2
					|Тип: %3, сценарий: %4, номинал: %5, номер пластиковой карты: %6,
					|телефон отправителя: %7, телефон получателя: %8",
					НомерЧека, Результат.ТекстОш,
					ОжидающаяКарта.ТипКарты, ОжидающаяКарта.Сценарий, ОжидающаяКарта.Номинал,
					ОжидающаяКарта.НомерФизКарты, ОжидающаяКарта.ТелефонОтправителя,
					ОжидающаяКарта.ТелефонПолучателя));

			Сохранено = ПКВ_НезавершённыеОперацииСервер.Добавить(
				"Выпуск карты", ЧекККМ, Результат.Запрос, Результат.Запрос.Описание, Результат.ТекстОш);
			
			ПКВ_ДобавитьОшибкуДляКассира(Форма, СтрШаблон(
				"Чек №%1: не оформлена %2 карта на %3 ₽.
				|%4",
				НомерЧека,
				ПКВ_ПредставлениеТипаКарты(ОжидающаяКарта.ТипКарты),
				Формат(ОжидающаяКарта.Номинал, "ЧДЦ=2; ЧГ=0"),
				Результат.ТекстОш), Сохранено);

		КонецЕсли;

	КонецЦикла;

	Для Каждого ЗаписьКУдалению Из ЗаписиКУдалению Цикл
		ОжидающиеКарты.Удалить(ЗаписьКУдалению);
	КонецЦикла;

КонецПроцедуры

// Списания проводятся, только если в пробитом чеке есть оплата нашими картами
// и её сумма равна сумме подтверждённых списаний. При расхождении ничего не
// списывается: в журнал пишутся HoldId для ручного проведения через
// ПКВ_ФормаКассираАдмин.
// Если в чеке нет оплаты картами, буфер ждёт следующего чека набора.
Процедура ПКВ_ОбработатьСписания(Форма, ЧекККМ, ДанныеЧека)

	ОжидающиеСписания = Форма.ПКВ_ОжидающиеСписания;

	Если ОжидающиеСписания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ДанныеЧека.СуммаОплатыКартами = 0 Тогда
		Возврат;
	КонецЕсли;

	НомерЧека = ДанныеЧека.Чек.number;

	СуммаСписаний = 0;
	СписокHold = Новый Массив;
	Для Каждого ОжидающееСписание Из ОжидающиеСписания Цикл
		СуммаСписаний = СуммаСписаний + ОжидающееСписание.Сумма;
		СписокHold.Добавить(СтрШаблон("HoldId: %1, карта: %2, сумма: %3",
			ОжидающееСписание.HoldId, ОжидающееСписание.НомерКарты, ОжидающееСписание.Сумма));
	КонецЦикла;

	Если СуммаСписаний <> ДанныеЧека.СуммаОплатыКартами Тогда

		ЗаписьЖурналаРегистрации(
			"ПКВ_ПодарочныеКарты.СписаниеПослеЧека",
			УровеньЖурналаРегистрации.Ошибка,
			,
			ЧекККМ,
			СтрШаблон(
				"Чек №%1 пробит, но списания не проведены: оплата картами в чеке %2, подтверждено списаний %3.
				|uid чека: %4
				|%5",
				НомерЧека, ДанныеЧека.СуммаОплатыКартами, СуммаСписаний,
				ДанныеЧека.Чек.uid,
				СтрСоединить(СписокHold, Символы.ПС)));

		ТекстОшибки = СтрШаблон(
			"Сумма оплаты картами в чеке (%1 ₽) не совпадает с подтверждёнными списаниями (%2 ₽). "
			+ "Повторяйте, только если списание с этой карты верное.",
			ДанныеЧека.СуммаОплатыКартами, СуммаСписаний);
		
		Сохранено = Истина;
		Для Каждого ОжидающееСписание Из ОжидающиеСписания Цикл
			Сохранено = ПКВ_СохранитьСписание(ЧекККМ, ДанныеЧека.Чек, ОжидающееСписание, ТекстОшибки) И Сохранено;
		КонецЦикла;
		
		ПКВ_ДобавитьОшибкуДляКассира(Форма, СтрШаблон(
			"Чек №%1: списание с подарочных карт не проведено, сумма оплаты картами в чеке не совпадает с подтверждёнными списаниями.",
			НомерЧека), Сохранено);

	Иначе

		Для Каждого ОжидающееСписание Из ОжидающиеСписания Цикл

			Результат = ПКВ_ПодарочныеКартыAPI.СписатьHold(ОжидающееСписание.HoldId, ДанныеЧека.Чек);

			Если Не Результат.Успех Тогда

				ТекстОшибки = ПКВ_ПодарочныеКартыAPI.ТекстОшибки(Результат);

				ЗаписьЖурналаРегистрации(
					"ПКВ_ПодарочныеКарты.СписаниеПослеЧека",
					УровеньЖурналаРегистрации.Ошибка,
					,
					ЧекККМ,
					СтрШаблон(
						"Чек №%1 пробит, но списание не подтверждено в Directus: %2
						|HoldId: %3, карта: %4, сумма: %5, uid чека: %6",
						НомерЧека, ТекстОшибки,
						ОжидающееСписание.HoldId, ОжидающееСписание.НомерКарты, ОжидающееСписание.Сумма,
						ДанныеЧека.Чек.uid));

				Сохранено = ПКВ_СохранитьСписание(ЧекККМ, ДанныеЧека.Чек, ОжидающееСписание, ТекстОшибки);
				
				ПКВ_ДобавитьОшибкуДляКассира(Форма, СтрШаблон(
					"Чек №%1: не проведено списание %2 ₽ с карты %3.
					|%4",
					НомерЧека,
					Формат(ОжидающееСписание.Сумма, "ЧДЦ=2; ЧГ=0"),
					ОжидающееСписание.НомерКарты,
					ТекстОшибки), Сохранено);

			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	ОжидающиеСписания.Очистить();
	Форма.ПКВ_ИдентификаторСтрокиСписания = "";

КонецПроцедуры

// Hold живёт 30 минут: повторить списание можно только в это время.
Функция ПКВ_СохранитьСписание(ЧекККМ, Чек, ОжидающееСписание, ТекстОшибки)
	
	Запрос = ПКВ_ПодарочныеКартыAPI.ЗапросСписания(ОжидающееСписание.HoldId, Чек);
	
	Описание = СтрШаблон("Списание %1 ₽ с карты %2 (HoldId %3). Повторить можно в течение 30 минут после подтверждения кода.",
		ОжидающееСписание.Сумма, ОжидающееСписание.НомерКарты, ОжидающееСписание.HoldId);
	
	Возврат ПКВ_НезавершённыеОперацииСервер.Добавить("Списание с карты", ЧекККМ, Запрос, Описание, ТекстОшибки);
	
КонецФункции

Процедура ПКВ_ДобавитьОшибкуДляКассира(Форма, Знач Текст, Сохранено = Ложь)
	
	Если Сохранено Тогда
		Текст = Текст + Символы.ПС + "Операция сохранена, управляющий может повторить её в разделе «Незавершённые операции».";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Форма.ПКВ_ОшибкиПослеЧека) Тогда
		Форма.ПКВ_ОшибкиПослеЧека = Форма.ПКВ_ОшибкиПослеЧека + Символы.ПС + Символы.ПС + Текст;
	Иначе
		Форма.ПКВ_ОшибкиПослеЧека = Текст;
	КонецЕсли;

КонецПроцедуры

Функция ПКВ_ПредставлениеТипаКарты(ТипКарты)

	Если ТипКарты = "plastic" Тогда
		Возврат "пластиковая";
	КонецЕсли;

	Возврат "электронная";

КонецФункции

Процедура ПКВ_ДобавитьСообщениеДляКассира(Форма, Текст)
	
	Если ЗначениеЗаполнено(Форма.ПКВ_СообщенияПослеЧека) Тогда
		Форма.ПКВ_СообщенияПослеЧека = Форма.ПКВ_СообщенияПослеЧека + Символы.ПС + Текст;
	Иначе
		Форма.ПКВ_СообщенияПослеЧека = Текст;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПКВ_ЧекВозврата

Процедура ПКВ_ОбработатьЧекВозврата(ЧекВозврата, Форма)
	
	Если Форма.ПКВ_ОжидающиеВозвраты.Количество() = 0
		И Форма.ПКВ_ОжидающиеВозвратыКарт.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеВозврата = ПКВ_ДанныеЧекаВозврата(ЧекВозврата);
	
	Если ДанныеВозврата.ИсходныйЧек = Неопределено Тогда
		ЗаписьЖурналаРегистрации(
			"ПКВ_ПодарочныеКарты.ВозвратПослеЧека",
			УровеньЖурналаРегистрации.Ошибка,
			,
			ЧекВозврата,
			"Чек возврата пробит без чека продажи, возвраты по подарочным картам не отправлены.");
		ПКВ_ДобавитьОшибкуДляКассира(Форма, СтрШаблон(
			"Чек возврата №%1 пробит без чека продажи: возврат по подарочным картам не оформлен.",
			ДанныеВозврата.Чек.number));
		Форма.ПКВ_ОжидающиеВозвраты.Очистить();
		Форма.ПКВ_ОжидающиеВозвратыКарт.Очистить();
		Возврат;
	КонецЕсли;
	
	ПКВ_ОбработатьВозвратыКупленныхКарт(Форма, ЧекВозврата, ДанныеВозврата);
	ПКВ_ОбработатьВозвратыНаКарты(Форма, ЧекВозврата, ДанныеВозврата);
	
КонецПроцедуры

// Строки карт и сумма возврата на наши карты в пробитом чеке возврата.
Функция ПКВ_ДанныеЧекаВозврата(ЧекВозврата)
	
	НоменклатураЭлектронная = ПКВ_ПодарочныеКартыAPI.НоменклатураЭлектроннаяКарта();
	НоменклатураПластиковая = ПКВ_ПодарочныеКартыAPI.НоменклатураПластиковаяКарта();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Запасы.Номенклатура КАК Номенклатура,
	|	Запасы.Цена КАК Цена,
	|	СУММА(Запасы.Количество) КАК Количество
	|ИЗ
	|	Документ.ЧекККМВозврат.Запасы КАК Запасы
	|ГДЕ
	|	Запасы.Ссылка = &Чек
	|	И Запасы.Номенклатура В (&НоменклатураКарт)
	|
	|СГРУППИРОВАТЬ ПО
	|	Запасы.Номенклатура,
	|	Запасы.Цена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Оплата.Сумма), 0) КАК Сумма
	|ИЗ
	|	Документ.ЧекККМВозврат.БезналичнаяОплата КАК Оплата
	|ГДЕ
	|	Оплата.Ссылка = &Чек
	|	И Оплата.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ВидыБезналичныхОплат.ПодарочныйСертификат)
	|	И Оплата.ПодарочныйСертификат = &НоменклатураСертификата";
	
	Запрос.УстановитьПараметр("Чек", ЧекВозврата);
	Запрос.УстановитьПараметр("НоменклатураКарт", ПКВ_МассивНоменклатурыКарт());
	Запрос.УстановитьПараметр("НоменклатураСертификата", НоменклатураПластиковая);
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ВыборкаОплаты = Результаты[1].Выбрать();
	ВыборкаОплаты.Следующий();
	
	ЧекПродажи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЧекВозврата, "ЧекККМ");
	
	ИсходныйЧек = Неопределено;
	Если ТипЗнч(ЧекПродажи) = Тип("ДокументСсылка.ЧекККМ") И ЗначениеЗаполнено(ЧекПродажи) Тогда
		ИсходныйЧек = ПКВ_ПодарочныеКартыAPI.ДанныеЧека(ЧекПродажи);
	КонецЕсли;
	
	ДанныеВозврата = Новый Структура;
	ДанныеВозврата.Вставить("Чек", ПКВ_ПодарочныеКартыAPI.ДанныеЧека(ЧекВозврата));
	ДанныеВозврата.Вставить("ИсходныйЧек", ИсходныйЧек);
	ДанныеВозврата.Вставить("Карты", Результаты[0].Выгрузить());
	ДанныеВозврата.Вставить("СуммаНаКарты", ВыборкаОплаты.Сумма);
	ДанныеВозврата.Вставить("НоменклатураЭлектронная", НоменклатураЭлектронная);
	ДанныеВозврата.Вставить("НоменклатураПластиковая", НоменклатураПластиковая);
	
	Возврат ДанныеВозврата;
	
КонецФункции

// Возврат купленной карты отправляется, только если её строка ещё есть в корзине и в
// пробитом чеке возврата есть строка карты с ценой, равной остатку баланса.
Процедура ПКВ_ОбработатьВозвратыКупленныхКарт(Форма, ЧекВозврата, ДанныеВозврата)
	
	ОжидающиеВозвраты = Форма.ПКВ_ОжидающиеВозвратыКарт;
	
	Если ОжидающиеВозвраты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НомерЧека = ДанныеВозврата.Чек.number;
	ЗаписиКУдалению = Новый Массив;
	
	Для Каждого ОжидающийВозврат Из ОжидающиеВозвраты Цикл
		
		СтрокиКорзины = Форма.Объект.Товары.НайтиСтроки(
			Новый Структура("ИдентификаторСтроки", ОжидающийВозврат.ИдентификаторСтроки));
		
		Если СтрокиКорзины.Количество() = 0 Тогда
			ЗаписиКУдалению.Добавить(ОжидающийВозврат);
			Продолжить;
		КонецЕсли;
		
		Если ОжидающийВозврат.ТипКарты = "plastic" Тогда
			Номенклатура = ДанныеВозврата.НоменклатураПластиковая;
		Иначе
			Номенклатура = ДанныеВозврата.НоменклатураЭлектронная;
		КонецЕсли;
		
		СтрокиЧека = ДанныеВозврата.Карты.НайтиСтроки(
			Новый Структура("Номенклатура, Цена", Номенклатура, ОжидающийВозврат.Сумма));
		
		Если СтрокиЧека.Количество() = 0 Или СтрокиЧека[0].Количество < 1 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиЧека[0].Количество = СтрокиЧека[0].Количество - 1;
		ЗаписиКУдалению.Добавить(ОжидающийВозврат);
		
		Запрос = ПКВ_ПодарочныеКартыAPI.ЗапросВозвратаКупленнойКарты(
			ОжидающийВозврат.НомерКарты, ДанныеВозврата.ИсходныйЧек, ДанныеВозврата.Чек, ОжидающийВозврат.RequestId);
		
		Результат = ПКВ_ПодарочныеКартыAPI.ВыполнитьЗапрос1С(Запрос);
		
		Если Результат.Успех Тогда
			
			Возвращено = Неопределено;
			Если Результат.Данные <> Неопределено Тогда
				Результат.Данные.Свойство("refunded_amount", Возвращено);
			КонецЕсли;
			
			Если Возвращено <> Неопределено И Возвращено <> ОжидающийВозврат.Сумма Тогда
				
				ЗаписьЖурналаРегистрации(
					"ПКВ_ПодарочныеКарты.ВозвратПослеЧека",
					УровеньЖурналаРегистрации.Ошибка,
					,
					ЧекВозврата,
					СтрШаблон("Чек возврата №%1: по карте %2 в чеке возвращено %3 ₽, а Directus закрыл карту с остатком %4 ₽.",
						НомерЧека, ОжидающийВозврат.НомерКарты, ОжидающийВозврат.Сумма, Возвращено));
				
				ПКВ_ДобавитьОшибкуДляКассира(Форма, СтрШаблон(
					"Чек возврата №%1: карта %2 закрыта, но остаток на ней был %3 ₽, а в чеке возвращено %4 ₽.",
					НомерЧека, ОжидающийВозврат.НомерКарты,
					Формат(Возвращено, "ЧДЦ=2; ЧГ=0"), Формат(ОжидающийВозврат.Сумма, "ЧДЦ=2; ЧГ=0")));
				
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		ПКВ_СохранитьОшибкуВозврата(Форма, ЧекВозврата, "Возврат купленной карты", Запрос,
			ПКВ_ПодарочныеКартыAPI.ТекстОшибки(Результат),
			СтрШаблон("Чек возврата №%1: карта %2 не закрыта в Directus.", НомерЧека, ОжидающийВозврат.НомерКарты));
		
	КонецЦикла;
	
	Для Каждого ЗаписьКУдалению Из ЗаписиКУдалению Цикл
		ОжидающиеВозвраты.Удалить(ЗаписьКУдалению);
	КонецЦикла;
	
КонецПроцедуры

// Возвраты на карты проводятся, только если в пробитом чеке возврата есть оплата
// нашими картами и её сумма равна сумме возвратов, выбранных кассиром. При расхождении
// ничего не отправляется: операции сохраняются в незавершённые.
// Если оплаты картами в чеке нет, буфер ждёт следующего чека набора.
Процедура ПКВ_ОбработатьВозвратыНаКарты(Форма, ЧекВозврата, ДанныеВозврата)
	
	ОжидающиеВозвраты = Форма.ПКВ_ОжидающиеВозвраты;
	
	Если ОжидающиеВозвраты.Количество() = 0 Или ДанныеВозврата.СуммаНаКарты = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НомерЧека = ДанныеВозврата.Чек.number;
	
	СуммаВозвратов = 0;
	Для Каждого ОжидающийВозврат Из ОжидающиеВозвраты Цикл
		СуммаВозвратов = СуммаВозвратов + ОжидающийВозврат.Сумма;
	КонецЦикла;
	
	Расхождение = (СуммаВозвратов <> ДанныеВозврата.СуммаНаКарты);
	ТекстРасхождения = СтрШаблон(
		"Сумма возврата на карты в чеке (%1 ₽) не совпадает с суммой, выбранной кассиром (%2 ₽). "
		+ "Повторяйте, только если возврат на эту карту верный.",
		ДанныеВозврата.СуммаНаКарты, СуммаВозвратов);
	
	Для Каждого ОжидающийВозврат Из ОжидающиеВозвраты Цикл
		
		Если ОжидающийВозврат.Замена Тогда
			Запрос = ПКВ_ПодарочныеКартыAPI.ЗапросЗаменыКарты(
				ОжидающийВозврат.НомерКарты, ОжидающийВозврат.Сумма, ОжидающийВозврат.НоваяКарта,
				ОжидающийВозврат.ТипКарты, ДанныеВозврата.ИсходныйЧек, ДанныеВозврата.Чек, ОжидающийВозврат.RequestId);
			ВидОперации = "Замена карты";
		Иначе
			Запрос = ПКВ_ПодарочныеКартыAPI.ЗапросВозвратаНаКарту(
				ОжидающийВозврат.НомерКарты, ОжидающийВозврат.Сумма,
				ДанныеВозврата.ИсходныйЧек, ДанныеВозврата.Чек, ОжидающийВозврат.RequestId);
			ВидОперации = "Возврат на карту";
		КонецЕсли;
		
		ТекстДляКассира = СтрШаблон("Чек возврата №%1: не проведён возврат %2 ₽ на карту %3.",
			НомерЧека, Формат(ОжидающийВозврат.Сумма, "ЧДЦ=2; ЧГ=0"), ОжидающийВозврат.НомерКарты);
		
		Если Расхождение Тогда
			ПКВ_СохранитьОшибкуВозврата(Форма, ЧекВозврата, ВидОперации, Запрос, ТекстРасхождения, ТекстДляКассира);
			Продолжить;
		КонецЕсли;
		
		Результат = ПКВ_ПодарочныеКартыAPI.ВыполнитьЗапрос1С(Запрос);
		
		Если Не Результат.Успех Тогда
			ПКВ_СохранитьОшибкуВозврата(Форма, ЧекВозврата, ВидОперации, Запрос,
				ПКВ_ПодарочныеКартыAPI.ТекстОшибки(Результат), ТекстДляКассира);
			Продолжить;
		КонецЕсли;
		
		Если ОжидающийВозврат.Замена Тогда
			ПКВ_СообщитьОНовойКарте(Форма, ОжидающийВозврат, Результат.Данные);
		КонецЕсли;
		
	КонецЦикла;
	
	ОжидающиеВозвраты.Очистить();
	
КонецПроцедуры

Процедура ПКВ_СообщитьОНовойКарте(Форма, ОжидающийВозврат, Данные)
	
	НомерНовой = ОжидающийВозврат.НоваяКарта;
	Баланс = "";
	
	Если Данные <> Неопределено И Данные.Свойство("new_card") Тогда
		Данные.new_card.Свойство("card_number", НомерНовой);
		Если Данные.new_card.Свойство("balance") Тогда
			Баланс = Формат(Данные.new_card.balance, "ЧДЦ=2; ЧГ=0");
		КонецЕсли;
	КонецЕсли;
	
	Текст = СтрШаблон("Карта %1 закрыта и заменена картой %2", ОжидающийВозврат.НомерКарты, НомерНовой);
	Если ЗначениеЗаполнено(Баланс) Тогда
		Текст = Текст + СтрШаблон(", на новой карте %1 ₽", Баланс);
	КонецЕсли;
	Если ОжидающийВозврат.ТипКарты = "electronic" Тогда
		Текст = Текст + ". Ссылка на новую карту отправлена владельцу по SMS";
	КонецЕсли;
	
	ПКВ_ДобавитьСообщениеДляКассира(Форма, Текст + ".");
	
КонецПроцедуры

Процедура ПКВ_СохранитьОшибкуВозврата(Форма, ЧекВозврата, ВидОперации, Запрос, ТекстОшибки, ТекстДляКассира)
	
	ЗаписьЖурналаРегистрации(
		"ПКВ_ПодарочныеКарты.ВозвратПослеЧека",
		УровеньЖурналаРегистрации.Ошибка,
		,
		ЧекВозврата,
		СтрШаблон("%1: %2
			|%3", ВидОперации, ТекстОшибки, Запрос.Описание));
	
	Сохранено = ПКВ_НезавершённыеОперацииСервер.Добавить(ВидОперации, ЧекВозврата, Запрос, Запрос.Описание, ТекстОшибки);
	
	ПКВ_ДобавитьОшибкуДляКассира(Форма, ТекстДляКассира + Символы.ПС + ТекстОшибки, Сохранено);
	
КонецПроцедуры

Функция ПКВ_МассивНоменклатурыКарт()
	
	НоменклатураКарт = Новый Массив;
	
	Номенклатура = ПКВ_ПодарочныеКартыAPI.НоменклатураЭлектроннаяКарта();
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		НоменклатураКарт.Добавить(Номенклатура);
	КонецЕсли;
	
	Номенклатура = ПКВ_ПодарочныеКартыAPI.НоменклатураПластиковаяКарта();
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		НоменклатураКарт.Добавить(Номенклатура);
	КонецЕсли;
	
	Возврат НоменклатураКарт;
	
КонецФункции

#КонецОбласти

#Область ПКВ_ЗаполнениеВозврата

// При возврате по чеку продажи: убирает из способов возврата оплату нашими картами
// (типовая переносит её в наличные или строкой сертификата), считает, сколько можно
// вернуть наличными и не на карты, и получает из Directus карты чека (/receipt-info).
&После("ЗаполнитьНаОснованииЧекаККМ")
Процедура ПКВ_ЗаполнитьНаОснованииЧекаККМПосле(Форма, ЧекККМ, ДополнительныеПараметры)
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ПКВ_КартыВозврата") Тогда
		Возврат;
	КонецЕсли;
	
	ПКВ_ОчиститьДанныеВозврата(Форма);
	
	Если ТипЗнч(ЧекККМ) <> Тип("ДокументСсылка.ЧекККМ") Или Не ЗначениеЗаполнено(ЧекККМ) Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.Объект.ВидОперации <> Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПКВ_ПодарочныеКартыAPI.ИспользоватьОбмен() Тогда
		Возврат;
	КонецЕсли;
	
	Оплата = ПКВ_ОплатаЧекаПродажи(ЧекККМ);
	
	Если Оплата.НашимиКартами = 0 И Не Оплата.ЕстьКартыВТоварах Тогда
		Возврат;
	КонецЕсли;
	
	Если Оплата.НашимиКартами > 0 Тогда
		ПКВ_УбратьОплатуКартамиИзВозврата(Форма, Оплата.НашимиКартами);
		Форма.ПКВ_ПроверятьЛимитыВозврата = Истина;
		Форма.ПКВ_ЛимитНаличных  = Макс(0, Оплата.Наличными - Оплата.ВозвращеноНаличными);
		Форма.ПКВ_ЛимитНеКартами = Макс(0, Оплата.НеКартами - Оплата.ВозвращеноНеКартами);
	КонецЕсли;
	
	Результат = ПКВ_ПодарочныеКартыAPI.ПолучитьДанныеЧека(ПКВ_ПодарочныеКартыAPI.ДанныеЧека(ЧекККМ));
	
	Если Не Результат.Успех Тогда
		Если Результат.КодСостояния <> 404 Тогда
			Форма.ПКВ_ОшибкаДанныхВозврата = ПКВ_ПодарочныеКартыAPI.ТекстОшибки(Результат);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Результат.Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Данные.Свойство("debits") Тогда
		Для Каждого Карта Из Результат.Данные.debits Цикл
			НоваяСтрока = Форма.ПКВ_КартыВозврата.Добавить();
			НоваяСтрока.НомерКарты       = ПКВ_ПолеКарты(Карта, "card_number", "");
			НоваяСтрока.ТипКарты         = ПКВ_ПолеКарты(Карта, "type", "");
			НоваяСтрока.Статус           = ПКВ_ПолеКарты(Карта, "status", "");
			НоваяСтрока.Баланс           = ПКВ_ПолеКарты(Карта, "balance", 0);
			НоваяСтрока.Списано          = ПКВ_ПолеКарты(Карта, "debited", 0);
			НоваяСтрока.Возвращено       = ПКВ_ПолеКарты(Карта, "refunded", 0);
			НоваяСтрока.МожноВернуть     = ПКВ_ПолеКарты(Карта, "refundable", 0);
			НоваяСтрока.ПринимаетВозврат = ПКВ_ПолеКарты(Карта, "can_receive", Ложь);
		КонецЦикла;
	КонецЕсли;
	
	Если Результат.Данные.Свойство("sold_cards") Тогда
		Для Каждого Карта Из Результат.Данные.sold_cards Цикл
			НоваяСтрока = Форма.ПКВ_ПроданныеКарты.Добавить();
			НоваяСтрока.НомерКарты   = ПКВ_ПолеКарты(Карта, "card_number", "");
			НоваяСтрока.ТипКарты     = ПКВ_ПолеКарты(Карта, "type", "");
			НоваяСтрока.Статус       = ПКВ_ПолеКарты(Карта, "status", "");
			НоваяСтрока.Номинал      = ПКВ_ПолеКарты(Карта, "nominal", 0);
			НоваяСтрока.Баланс       = ПКВ_ПолеКарты(Карта, "balance", 0);
			НоваяСтрока.МожноВернуть = ПКВ_ПолеКарты(Карта, "can_return", Ложь);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПКВ_ОчиститьДанныеВозврата(Форма)
	
	Форма.ПКВ_КартыВозврата.Очистить();
	Форма.ПКВ_ПроданныеКарты.Очистить();
	Форма.ПКВ_ОжидающиеВозвраты.Очистить();
	Форма.ПКВ_ОжидающиеВозвратыКарт.Очистить();
	Форма.ПКВ_ПроверятьЛимитыВозврата = Ложь;
	Форма.ПКВ_ЛимитНаличных = 0;
	Форма.ПКВ_ЛимитНеКартами = 0;
	Форма.ПКВ_ОшибкаДанныхВозврата = "";
	
КонецПроцедуры

// Как оплачен чек продажи и сколько по нему уже вернули в прошлых чеках возврата.
//
// Возвращаемое значение:
//   Структура - НашимиКартами, Наличными, НеКартами, ВозвращеноНаличными, ВозвращеноНеКартами (Число),
//               ЕстьКартыВТоварах (Булево)
Функция ПКВ_ОплатаЧекаПродажи(ЧекККМ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Чек.СуммаДокумента КАК СуммаДокумента,
	|	ЕСТЬNULL(Оплата.Безналичными, 0) КАК Безналичными,
	|	ЕСТЬNULL(Оплата.НашимиКартами, 0) КАК НашимиКартами
	|ИЗ
	|	Документ.ЧекККМ КАК Чек
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СУММА(БезналичнаяОплата.Сумма) КАК Безналичными,
	|			СУММА(ВЫБОР
	|					КОГДА БезналичнаяОплата.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ВидыБезналичныхОплат.ПодарочныйСертификат)
	|							И БезналичнаяОплата.ПодарочныйСертификат = &НоменклатураСертификата
	|						ТОГДА БезналичнаяОплата.Сумма
	|					ИНАЧЕ 0
	|				КОНЕЦ) КАК НашимиКартами
	|		ИЗ
	|			Документ.ЧекККМ.БезналичнаяОплата КАК БезналичнаяОплата
	|		ГДЕ
	|			БезналичнаяОплата.Ссылка = &Чек) КАК Оплата
	|		ПО (ИСТИНА)
	|ГДЕ
	|	Чек.Ссылка = &Чек
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Возвраты.СуммаДокумента), 0) КАК СуммаДокументов
	|ИЗ
	|	Документ.ЧекККМВозврат КАК Возвраты
	|ГДЕ
	|	Возвраты.ЧекККМ = &Чек
	|	И Возвраты.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(БезналичнаяОплата.Сумма), 0) КАК Безналичными,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА БезналичнаяОплата.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ВидыБезналичныхОплат.ПодарочныйСертификат)
	|						И БезналичнаяОплата.ПодарочныйСертификат = &НоменклатураСертификата
	|					ТОГДА БезналичнаяОплата.Сумма
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0) КАК НашимиКартами
	|ИЗ
	|	Документ.ЧекККМВозврат.БезналичнаяОплата КАК БезналичнаяОплата
	|ГДЕ
	|	БезналичнаяОплата.Ссылка.ЧекККМ = &Чек
	|	И БезналичнаяОплата.Ссылка.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Запасы.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ЧекККМ.Запасы КАК Запасы
	|ГДЕ
	|	Запасы.Ссылка = &Чек
	|	И Запасы.Номенклатура В (&НоменклатураКарт)";
	
	Запрос.УстановитьПараметр("Чек", ЧекККМ);
	Запрос.УстановитьПараметр("НоменклатураСертификата", ПКВ_ПодарочныеКартыAPI.НоменклатураПластиковаяКарта());
	Запрос.УстановитьПараметр("НоменклатураКарт", ПКВ_МассивНоменклатурыКарт());
	
	Результаты = Запрос.ВыполнитьПакет();
	
	Продажа = Результаты[0].Выбрать();
	Продажа.Следующий();
	
	Возвраты = Результаты[1].Выбрать();
	Возвраты.Следующий();
	
	ОплатаВозвратов = Результаты[2].Выбрать();
	ОплатаВозвратов.Следующий();
	
	Итог = Новый Структура;
	Итог.Вставить("НашимиКартами", Продажа.НашимиКартами);
	Итог.Вставить("Наличными", Продажа.СуммаДокумента - Продажа.Безналичными);
	Итог.Вставить("НеКартами", Продажа.СуммаДокумента - Продажа.НашимиКартами);
	Итог.Вставить("ВозвращеноНаличными", Возвраты.СуммаДокументов - ОплатаВозвратов.Безналичными);
	Итог.Вставить("ВозвращеноНеКартами", Возвраты.СуммаДокументов - ОплатаВозвратов.НашимиКартами);
	Итог.Вставить("ЕстьКартыВТоварах", Не Результаты[3].Пустой());
	
	Возврат Итог;
	
КонецФункции

// Типовая переносит оплату сертификатом из чека продажи в возврат наличными
// (если на кассе есть наличные) или строкой сертификата. Для наших карт это убираем:
// эта часть возвращается только на подарочные карты, через нашу форму.
Процедура ПКВ_УбратьОплатуКартамиИзВозврата(Форма, СуммаНашимиКартами)
	
	НоменклатураСертификата = ПКВ_ПодарочныеКартыAPI.НоменклатураПластиковаяКарта();
	Оплата = Форма.Объект.Оплата;
	Остаток = СуммаНашимиКартами;
	
	СтрокиКУдалению = Новый Массив;
	Для Каждого СтрокаОплаты Из Оплата Цикл
		Если СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.ПодарочныйСертификат
			И СтрокаОплаты.ПодарочныйСертификат = НоменклатураСертификата Тогда
			Остаток = Остаток - СтрокаОплаты.Сумма;
			СтрокиКУдалению.Добавить(СтрокаОплаты);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаОплаты Из СтрокиКУдалению Цикл
		Оплата.Удалить(СтрокаОплаты);
	КонецЦикла;
	
	Если Остаток <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаОплаты Из Оплата Цикл
		
		Если СтрокаОплаты.ВидОплаты <> "Наличные" Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаОплаты.Сумма = Макс(0, СтрокаОплаты.Сумма - Остаток);
		
		Если СтрокаОплаты.Сумма = 0 Тогда
			Оплата.Удалить(СтрокаОплаты);
			Форма.СуммаОплаченоНал = 0;
		Иначе
			Форма.СуммаОплаченоНал = СтрокаОплаты.Сумма;
		КонецЕсли;
		
		Прервать;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПКВ_ПолеКарты(Карта, ИмяПоля, ЗначениеПоУмолчанию)
	
	Если Карта.Свойство(ИмяПоля) И Карта[ИмяПоля] <> Неопределено Тогда
		Возврат Карта[ИмяПоля];
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

#КонецОбласти

#КонецЕсли
