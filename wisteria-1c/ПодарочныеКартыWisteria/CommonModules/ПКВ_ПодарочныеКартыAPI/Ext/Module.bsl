#КонецОбласти

// Проверяет, что предсозданная пластиковая карта ещё не продана —
// используется при регистрации карты (ФормаРегистрацииКарты), раз номер
// карты может быть введён вручную, а не только сканированием.
//
// Возвращаемое значение:
//   Структура - Успех (Булево), УжеПродана (Булево), ТекстОш (Строка)
Функция ПроверитьЧтоКартаНеПродана(НомерКарты) Экспорт
	
	Результат = ПолучитьИнформациюОКарте(НомерКарты, Ложь);
	
	Если Не Результат.Успех Тогда
		Текст = ИзвлечьТекстОшибкиAPI(Результат.ТелоОтвета);
		Если Не ЗначениеЗаполнено(Текст) Тогда
			Текст = ФорматТекстРезультата(Результат);
		КонецЕсли;
		Возврат Новый Структура("Успех, УжеПродана, ТекстОш", Ложь, Ложь, Текст);
	КонецЕсли;
	
	Если Результат.Данные = Неопределено ИЛИ Не Результат.Данные.Свойство("card") Тогда
		Возврат Новый Структура("Успех, УжеПродана, ТекстОш", Ложь, Ложь, "Ответ сервера не содержит данные карты.");
	КонецЕсли;
	
	Карта = Результат.Данные.card;
	Баланс = 0;
	Если Карта.Свойство("balance") И Карта.balance <> Неопределено Тогда
		Баланс = Карта.balance;
	КонецЕсли;
	
	Возврат Новый Структура("Успех, УжеПродана, ТекстОш", Истина, (Баланс > 0), "");
	
КонецФункции

// Оформляет карту в Directus после успешно пробитого чека — вызывается
// ТОЛЬКО из ОбщегоНазначенияРМКПереопределяемый.ПробитьЧекЗавершение,
// см. буфер ПКВ_ОжидающиеКарты на форме ФормаРМК.
//
// Электронная карта — создаётся с нуля (POST /create). Пластиковая —
// карта предсоздана партией в Directus заранее (без баланса и владельца),
// 1С её только находит по QR (/by-qr, уже сделано при регистрации) и
// продаёт через POST /sell — новая карта НЕ создаётся.
//
// Параметры:
//   ОжидающаяКарта - Структура - ТипКарты, Сценарий, Номинал, ТелефонОтправителя,
//                     ТелефонПолучателя, Поздравление, НомерФизКарты (для
//                     пластика — это уже разрешённый card_number, не сырой ШК)
//   НомерЧека      - Строка   - видимый номер пробитого чека ККМ
//   ПредставлениеДокумента - Строка - полное представление документа ЧекККМ
//
// Возвращаемое значение:
//   Структура - Успех (Булево), ТекстОш (Строка)
Функция СоздатьКарту(ОжидающаяКарта, НомерЧека, ПредставлениеДокумента = "") Экспорт
	
	Если ОжидающаяКарта.ТипКарты = "plastic" Тогда
		
		Если Не ЗначениеЗаполнено(ОжидающаяКарта.НомерФизКарты) Тогда
			Возврат Новый Структура("Успех, ТекстОш", Ложь,
				"Не задан разрешённый номер карты — QR не был отсканирован/распознан при регистрации.");
		КонецЕсли;
		
		РезультатПродажи = Продать(
			ОжидающаяКарта.НомерФизКарты,
			ОжидающаяКарта.Номинал,
			ОжидающаяКарта.Сценарий,
			ОжидающаяКарта.ТелефонОтправителя,
			ОжидающаяКарта.ТелефонПолучателя,
			Неопределено,
			ОжидающаяКарта.Поздравление,
			НомерЧека,
			ПредставлениеДокумента);
		
		Если Не РезультатПродажи.Успех Тогда
			Возврат Новый Структура("Успех, ТекстОш", Ложь,
				"Ошибка продажи пластиковой карты (POST /sell): " + РезультатПродажи.ТекстОш
				+ ". Ответ сервера: " + РезультатПродажи.ТелоОтвета);
		КонецЕсли;
		
		Возврат Новый Структура("Успех, ТекстОш", Истина, "");
		
	КонецЕсли;
	
	// Электронная карта — создаётся с нуля
	Тело = Новый Структура;
	Тело.Вставить("type",     ОжидающаяКарта.ТипКарты);
	Тело.Вставить("nominal",  ОжидающаяКарта.Номинал);
	Тело.Вставить("scenario", ОжидающаяКарта.Сценарий);
	
	Если ОжидающаяКарта.Сценарий = "gift" Тогда
		Тело.Вставить("recipient_phone", ОжидающаяКарта.ТелефонПолучателя);
		Тело.Вставить("sender_phone",    ОжидающаяКарта.ТелефонОтправителя);
		Если ЗначениеЗаполнено(ОжидающаяКарта.Поздравление) Тогда
			Тело.Вставить("message", ОжидающаяКарта.Поздравление);
		КонецЕсли;
	Иначе
		Тело.Вставить("sender_phone", ОжидающаяКарта.ТелефонОтправителя);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерЧека) Тогда
		Тело.Вставить("receipt_number", НомерЧека);
		Тело.Вставить("receipt_source", "1c");
	КонецЕсли;
	
	РезультатСоздания = ВыполнитьЗапрос("POST", "/create", ПКВ_КоннекторHTTP.ОбъектВJson(Тело));
	
	Если Не РезультатСоздания.Успех Тогда
		Возврат Новый Структура("Успех, ТекстОш", Ложь,
			"Ошибка создания карты (POST /create): " + РезультатСоздания.ТекстОш
			+ ". Ответ сервера: " + РезультатСоздания.ТелоОтвета);
	КонецЕсли;
	
	Возврат Новый Структура("Успех, ТекстОш", Истина, "");
	
КонецФункции

// Универсальный вызов тестового контура gc_*. Используется как внутренними
// методами этого модуля, так и напрямую из тестовой консоли админки.
//
// Параметры:
//   Метод        - Строка - "GET" | "POST"
//   Путь         - Строка - путь ресурса, например "/designs"
//   ТелоЗапроса  - Строка - JSON-тело запроса, актуально только для POST
//   ДопЗаголовки - Структура - дополнительные HTTP-заголовки
//
// Возвращаемое значение:
//   Структура - Успех (Булево), КодСостояния (Число), ТелоОтвета (Строка), ТекстОш (Строка)
Функция ВыполнитьЗапрос(Метод, Путь, ТелоЗапроса = "", ДопЗаголовки = Неопределено) Экспорт
	
	Итог = Новый Структура("Успех, КодСостояния, ТелоОтвета, ТекстОш", Ложь, 0, "", "");
	
	Если Не ИспользоватьОбмен() Тогда
		Итог.ТекстОш = "Обмен с Directus отключён в настройках (см. «Использовать обмен» в админке подарочных карт).";
		Возврат Итог;
	КонецЕсли;
	
	Адрес = АдресAPI();
	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Итог.ТекстОш = "Не задан адрес API (константа ПКВ_АдресAPI) — заполните его в админке.";
		Возврат Итог;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Путь) Тогда
		Итог.ТекстОш = "Не указан путь метода API.";
		Возврат Итог;
	КонецЕсли;
	
	Если Лев(Путь, 1) <> "/" Тогда
		Путь = "/" + Путь;
	КонецЕсли;
	
	URL = Адрес + Путь;
	МетодВВерхнемРегистре = ВРег(СокрЛП(Метод));
	
	Попытка
		
		ДопПараметры = ПКВ_КоннекторHTTP.НовыеПараметры();
		ДопПараметры.Заголовки.Вставить("Content-Type", "application/json");
		ДопПараметры.Заголовки.Вставить("Accept", "application/json");
		
		Если ДопЗаголовки <> Неопределено Тогда
			Для Каждого Заголовок Из ДопЗаголовки Цикл
				ДопПараметры.Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
			КонецЦикла;
		КонецЕсли;
		
		Если МетодВВерхнемРегистре = "POST" Тогда
			ТелоДляОтправки = ?(ЗначениеЗаполнено(ТелоЗапроса), ТелоЗапроса, "{}");
			Ответ = ПКВ_КоннекторHTTP.Post(URL, ТелоДляОтправки, ДопПараметры);
		ИначеЕсли МетодВВерхнемРегистре = "GET" Тогда
			Ответ = ПКВ_КоннекторHTTP.Get(URL, Неопределено, ДопПараметры);
		Иначе
			Итог.ТекстОш = "Неподдерживаемый метод: " + Метод + " (допустимы только GET и POST)";
			Возврат Итог;
		КонецЕсли;
		
		Итог.КодСостояния = Ответ.КодСостояния;
		Итог.ТелоОтвета    = ПКВ_КоннекторHTTP.КакТекст(Ответ, "UTF-8");
		Итог.Успех         = (Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300);
		
		Если Не Итог.Успех Тогда
			Итог.ТекстОш = "HTTP " + Итог.КодСостояния;
		КонецЕсли;
		
	Исключение
		
		ЗаписьЖурналаРегистрации(
			"ПКВ_ПодарочныеКарты.ОшибкаСоединения",
			УровеньЖурналаРегистрации.Ошибка,
			,,
			СтрШаблон("Ошибка обращения к API (%1 %2): %3", Метод, URL, ОписаниеОшибки()));
		
		Итог.ТекстОш = "Нет соединения с сервисом подарочных карт. Обратитесь к ответственному.";
		
	КонецПопытки;
	
	Возврат Итог;
	
КонецФункции

Функция ФорматТекстРезультата(Результат) Экспорт
	
	Если Результат.Успех Тогда
		Возврат "Успешно." + Символы.ПС + Результат.ТелоОтвета;
	Иначе
		Строки = Новый Массив;
		Строки.Добавить("Ошибка: " + Результат.ТекстОш);
		Если ЗначениеЗаполнено(Результат.ТелоОтвета) Тогда
			Строки.Добавить(Результат.ТелоОтвета);
		КонецЕсли;
		Возврат СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
КонецФункции

Функция ТекстЗапросаSMSПривязки(Данные) Экспорт
	
	Если Данные = Неопределено Тогда
		Возврат "SMS отправлено.";
	КонецЕсли;
	
	Строки = Новый Массив;
	
	Если Данные.Свойство("mode") И Данные.mode = "rebind" Тогда
		Строки.Добавить("Перепривязка карты (у карты уже есть владелец).");
	Иначе
		Строки.Добавить("Первая привязка карты.");
	КонецЕсли;
	
	Если Данные.Свойство("phone") Тогда
		Строки.Добавить("Код отправлен на телефон: " + Данные.phone);
	КонецЕсли;
	
	Если Данные.Свойство("prev_owner_masked") И ЗначениеЗаполнено(Данные.prev_owner_masked) Тогда
		Строки.Добавить("Прежний владелец: " + Данные.prev_owner_masked);
	КонецЕсли;
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

Функция ТекстПодтвержденияПривязки(Данные) Экспорт
	
	Если Данные = Неопределено Тогда
		Возврат "Владелец закреплён.";
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить("Владелец успешно закреплён.");
	
	Если Данные.Свойство("owner_phone") Тогда
		Строки.Добавить("Телефон владельца: " + Данные.owner_phone);
	КонецЕсли;
	
	Если Данные.Свойство("mode") И Данные.mode = "rebind" Тогда
		Если Данные.Свойство("prev_owner_masked") И ЗначениеЗаполнено(Данные.prev_owner_masked) Тогда
			Строки.Добавить("Это перепривязка. Прежний владелец: " + Данные.prev_owner_masked);
		Иначе
			Строки.Добавить("Это перепривязка (у карты уже был другой владелец).");
		КонецЕсли;
	КонецЕсли;
	
	Если Данные.Свойство("activated") И Данные.activated Тогда
		Строки.Добавить("Карта активирована.");
	КонецЕсли;
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции


// =============================================================================
// Универсальный механизм вывода ответа API — общий шаблон для всех форм,
// которые показывают карточку/список полей.
// =============================================================================

// Строит текст вида "Заголовок: Значение" построчно из разобранного
// JSON-объекта по списку описаний полей.
Функция ТекстИзПолей(Данные, ОписанияПолей) Экспорт
	
	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Строки = Новый Массив;
	
	Для Каждого Описание Из ОписанияПолей Цикл
		
		Если Не Данные.Свойство(Описание.ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		
		Значение = Данные[Описание.ИмяПоля];
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстЗначения = ПКВ_ЗначениеПоляВТекст(Значение, Описание.Словарь);
		
		Если ЗначениеЗаполнено(Описание.ВторойИмяПоля) И Данные.Свойство(Описание.ВторойИмяПоля) Тогда
			ВтороеЗначение = Данные[Описание.ВторойИмяПоля];
			Если ВтороеЗначение <> Неопределено Тогда
				ТекстЗначения = ТекстЗначения + " " + Описание.ТекстМеждуЗначениями + " "
					+ ПКВ_ЗначениеПоляВТекст(ВтороеЗначение, Неопределено);
			КонецЕсли;
		КонецЕсли;
		
		Строки.Добавить(Описание.Заголовок + ": " + ТекстЗначения);
		
	КонецЦикла;
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Конструктор одного описания поля для ТекстИзПолей().
Функция ОписаниеПоля(ИмяПоля, Заголовок, Словарь = Неопределено, ВторойИмяПоля = "", ТекстМеждуЗначениями = "") Экспорт
	
	Возврат Новый Структура(
		"ИмяПоля, Заголовок, Словарь, ВторойИмяПоля, ТекстМеждуЗначениями",
		ИмяПоля, Заголовок, Словарь, ВторойИмяПоля, ТекстМеждуЗначениями);
	
КонецФункции

Функция ПКВ_ЗначениеПоляВТекст(Значение, Словарь)
	
	Если Словарь = Неопределено Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		ПереведённыеЭлементы = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Перевод = Словарь[Элемент];
			ПереведённыеЭлементы.Добавить(?(Перевод = Неопределено, Строка(Элемент), Перевод));
		КонецЦикла;
		Возврат СтрСоединить(ПереведённыеЭлементы, "/");
	КонецЕсли;
	
	Перевод = Словарь[Значение];
	Возврат ?(Перевод = Неопределено, Строка(Значение), Перевод);
	
КонецФункции

Функция СловарьСтатусов() Экспорт
	
	Словарь = Новый Соответствие;
	Словарь.Вставить("pending_bind", "Не привязана");
	Словарь.Вставить("active", "Активна");
	Словарь.Вставить("blocked", "Заблокирована");
	
	Возврат Словарь;
	
КонецФункции

Функция СловарьРолей() Экспорт
	
	Словарь = Новый Соответствие;
	Словарь.Вставить("owner", "владелец");
	Словарь.Вставить("past_owner", "бывший владелец");
	Словарь.Вставить("sender", "отправитель");
	Словарь.Вставить("recipient", "получатель");
	
	Возврат Словарь;
	
КонецФункции

Функция ТекстКарточкиДляСписка(Карта) Экспорт
	
	ОписанияПолей = Новый Массив;
	ОписанияПолей.Добавить(ОписаниеПоля("card_number", "Номер"));
	ОписанияПолей.Добавить(ОписаниеПоля("status", "Статус", СловарьСтатусов()));
	ОписанияПолей.Добавить(ОписаниеПоля("balance", "Баланс", Неопределено, "nominal", "из"));
	
	Возврат ТекстИзПолей(Карта, ОписанияПолей);
	
КонецФункции

Функция ТекстЗапросаSMSСписания(Данные) Экспорт
	
	Если Данные = Неопределено Тогда
		Возврат "SMS отправлено.";
	КонецЕсли;
	
	Строки = Новый Массив;
	
	Если Данные.Свойство("amount") Тогда
		Строки.Добавить("Сумма списания: " + Данные.amount + " ₽");
	КонецЕсли;
	
	Если Данные.Свойство("phone") Тогда
		Строки.Добавить("Код отправлен на телефон: " + Данные.phone);
	КонецЕсли;
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

Функция ТекстПодтвержденияСписания(Данные) Экспорт
	
	Если Данные = Неопределено Тогда
		Возврат "Списание подтверждено.";
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить("Списание подтверждено, сумма заморожена.");
	
	Если Данные.Свойство("amount") Тогда
		Строки.Добавить("Сумма: " + Данные.amount + " ₽");
	КонецЕсли;
	
	Если Данные.Свойство("balance") Тогда
		Строки.Добавить("Баланс карты: " + Данные.balance + " ₽");
	КонецЕсли;
	
	Если Данные.Свойство("available") Тогда
		Строки.Добавить("Доступно (после заморозки): " + Данные.available + " ₽");
	КонецЕсли;
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

Функция ПолучитьБаланс(НомерКарты, ТелефонВладельца) Экспорт
	
	Тело = Новый Структура;
	Тело.Вставить("card_number", СокрЛП(НомерКарты));
	Тело.Вставить("owner_phone", СокрЛП(ТелефонВладельца));
	
	Возврат ЗапросJSON("POST", "/balance", Тело);
	
КонецФункции

// Проверяет существование предсозданной карты по QR/хэшу и возвращает её
// полную карточку. POST /by-qr, требует заголовок/поле key = X-GC-Key.
Функция ПолучитьКартуПоХэшу(ОтсканированнаяСтрока) Экспорт
	
	Тело = Новый Структура;
	Тело.Вставить("qr", СокрЛП(ОтсканированнаяСтрока));
	Тело.Вставить("key", Константы.ПКВ_КлючQR.Получить());
	
	Возврат ЗапросJSON("POST", "/by-qr", Тело);
	
КонецФункции

// То же самое, что ПолучитьКартуПоХэшу, но отдаёт только card_number —
// используется формами, которым не нужна вся карточка целиком.
Функция ПолучитьНомерКартыПоХэшу(ОтсканированнаяСтрока) Экспорт
	
	Результат = ПолучитьКартуПоХэшу(ОтсканированнаяСтрока);
	
	Если Не Результат.Успех Тогда
		Текст = ИзвлечьТекстОшибкиAPI(Результат.ТелоОтвета);
		Если Не ЗначениеЗаполнено(Текст) Тогда
			Текст = ФорматТекстРезультата(Результат);
		КонецЕсли;
		Возврат Новый Структура("Успех, Текст, НомерКарты", Ложь, Текст, "");
	КонецЕсли;
	
	Если Результат.Данные = Неопределено ИЛИ Не Результат.Данные.Свойство("card") Тогда
		Возврат Новый Структура("Успех, Текст, НомерКарты", Ложь, "Ответ сервера не содержит данные карты.", "");
	КонецЕсли;
	
	Карта = Результат.Данные.card;
	
	Если Не Карта.Свойство("card_number") Тогда
		Возврат Новый Структура("Успех, Текст, НомерКарты", Ложь, "В ответе нет номера карты.", "");
	КонецЕсли;
	
	Возврат Новый Структура("Успех, Текст, НомерКарты", Истина, "", Карта.card_number);
	
КонецФункции

#КонецОбласти
