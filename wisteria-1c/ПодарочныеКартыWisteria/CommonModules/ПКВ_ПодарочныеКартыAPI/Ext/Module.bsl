
#Область ПрограммныйИнтерфейс

// Признак того, что обмен с Directus включён в настройках администратора.
Функция ИспользоватьОбмен() Экспорт
	Возврат Константы.ПКВ_ИспользоватьОбмен.Получить();
КонецФункции

// Базовый адрес API из настроек, без слэша на конце.
Функция АдресAPI() Экспорт
	
	Адрес = СокрЛП(Константы.ПКВ_АдресAPI.Получить());
	
	Пока СтрДлина(Адрес) > 0 И Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	
	Возврат Адрес;
	
КонецФункции

// Номенклатура для строки в чеке — выбирается администратором в
// ПКВ_АдминкаПодарочныхКарт (константы ПКВ_НоменклатураЭлектроннаяКарта,
// ПКВ_НоменклатураПластиковаяКарта, тип СправочникСсылка.Номенклатура).
Функция НоменклатураЭлектроннаяКарта() Экспорт
	Возврат Константы.ПКВ_НоменклатураЭлектроннаяКарта.Получить();
КонецФункции

Функция НоменклатураПластиковаяКарта() Экспорт
	Возврат Константы.ПКВ_НоменклатураПластиковаяКарта.Получить();
КонецФункции

// Регистрирует штрихкод номенклатуры (= Артикул) в РегистрыСведений.
// ШтрихкодыНоменклатуры, если его там ещё нет — без этого типовой поиск
// по штрихкоду не находит номенклатуру при добавлении строки в чек.
// Идемпотентно.
Функция УбедитьсяЧтоШтрихкодЗарегистрирован(НоменклатураСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Штрихкод = "";
	Попытка
		Штрихкод = СокрЛП(НоменклатураСсылка.Артикул);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Номенклатура.Установить(НоменклатураСсылка);
	НаборЗаписей.Отбор.Штрихкод.Установить(Штрихкод);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.Номенклатура = НоменклатураСсылка;
	НоваяЗапись.Штрихкод     = Штрихкод;
	
	Попытка
		НаборЗаписей.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(
			"ПКВ_ПодарочныеКарты.РегистрацияШтрихкода",
			УровеньЖурналаРегистрации.Ошибка,
			,,
			СтрШаблон("Не удалось зарегистрировать штрихкод ""%1"" для номенклатуры %2: %3",
				Штрихкод, НоменклатураСсылка, ОписаниеОшибки()));
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

// Код для программного добавления строки в чек через ОбработатьШтрихкодКлиент
// (см. ФормаРМК, расширение) — берётся из Артикула выбранной номенклатуры.
//
// Параметры:
//   ТипКарты - Строка - "electronic" | "plastic"
//
// Возвращаемое значение:
//   Строка - код для ОбработатьШтрихкодКлиент, или "" если номенклатура
//            не выбрана в настройках или у неё нет артикула
Функция КодСканированияПоТипуКарты(ТипКарты) Экспорт
	
	Если ТипКарты = "plastic" Тогда
		НоменклатураСсылка = НоменклатураПластиковаяКарта();
	Иначе
		НоменклатураСсылка = НоменклатураЭлектроннаяКарта();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Возврат СокрЛП(НоменклатураСсылка.Артикул);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Список активных дизайнов карт — GET {АдресAPI}/designs.
//
// Возвращаемое значение:
//   Структура - Успех (Булево), Дизайны (Массив из Структура {id, name, code, image}), ТекстОш (Строка)
Функция ПолучитьДизайны() Экспорт
	
	Итог = Новый Структура("Успех, Дизайны, ТекстОш", Ложь, Новый Массив, "");
	
	Результат = ВыполнитьЗапрос("GET", "/designs");
	
	Если Не Результат.Успех Тогда
		Итог.ТекстОш = ?(ЗначениеЗаполнено(Результат.ТекстОш), Результат.ТекстОш, "Не удалось получить дизайны");
		Возврат Итог;
	КонецЕсли;
	
	Попытка
		ПараметрыJSON = Новый Структура("ПрочитатьВСоответствие", Ложь);
		ДанныеОтвета = ПКВ_КоннекторHTTP.JsonВОбъект(Результат.ТелоОтвета, "utf-8", ПараметрыJSON);
	Исключение
		Итог.ТекстОш = "Некорректный JSON в ответе API: " + ОписаниеОшибки();
		Возврат Итог;
	КонецПопытки;
	
	Если ДанныеОтвета = Неопределено ИЛИ Не ДанныеОтвета.Свойство("designs") Тогда
		Итог.ТекстОш = "Ответ API не содержит поле designs";
		Возврат Итог;
	КонецЕсли;
	
	Итог.Успех  = Истина;
	Итог.Дизайны = ДанныеОтвета.designs;
	
	Возврат Итог;
	
КонецФункции

// Универсальный вызов API со структурами вместо сырых JSON-строк.
//
// Параметры:
//   Метод         - Строка    - "GET" | "POST"
//   Путь          - Строка    - например "/info"
//   ТелоСтруктура - Структура - тело запроса, Неопределено для GET без тела
//   ДопЗаголовки  - Структура - дополнительные HTTP-заголовки (например X-GC-Key)
//
// Возвращаемое значение:
//   Структура - Успех (Булево), Данные (Структура/Неопределено — разобранный
//               JSON ответа), КодСостояния (Число), ТекстОш (Строка),
//               ТелоОтвета (Строка, сырое тело)
Функция ЗапросJSON(Метод, Путь, ТелоСтруктура = Неопределено, ДопЗаголовки = Неопределено) Экспорт
	
	Если ТелоСтруктура = Неопределено Тогда
		ТелоJSON = "";
	Иначе
		ТелоJSON = ПКВ_КоннекторHTTP.ОбъектВJson(ТелоСтруктура);
	КонецЕсли;
	
	Результат = ВыполнитьЗапрос(Метод, Путь, ТелоJSON, ДопЗаголовки);
	
	Итог = Новый Структура("Успех, Данные, КодСостояния, ТекстОш, ТелоОтвета",
		Результат.Успех, Неопределено, Результат.КодСостояния, Результат.ТекстОш, Результат.ТелоОтвета);
	
	Если ЗначениеЗаполнено(Результат.ТелоОтвета) Тогда
		Попытка
			ПараметрыJSON = Новый Структура("ПрочитатьВСоответствие", Ложь);
			Итог.Данные = ПКВ_КоннекторHTTP.JsonВОбъект(Результат.ТелоОтвета, "utf-8", ПараметрыJSON);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат Итог;
	
КонецФункции

// Полная информация по карте — POST /info.
//
// Возвращаемое значение:
//   Структура - Успех, Данные {card, operations[]}, ТекстОш, ТелоОтвета
Функция ПолучитьИнформациюОКарте(НомерКарты, СИсторией = Истина) Экспорт
	
	Тело = Новый Структура;
	Тело.Вставить("card_number", СокрЛП(НомерКарты));
	Тело.Вставить("with_ops", СИсторией);
	
	Возврат ЗапросJSON("POST", "/info", Тело);
	
КонецФункции

// Поиск карт по телефону — POST /cards-by-phone.
Функция НайтиКартыПоТелефону(Телефон, СИсторией = Ложь) Экспорт
	
	Тело = Новый Структура;
	Тело.Вставить("phone", СокрЛП(Телефон));
	Если СИсторией Тогда
		Тело.Вставить("with_history", Истина);
	КонецЕсли;
	Тело.Вставить("actor", "rmk");
	
	Возврат ЗапросJSON("POST", "/cards-by-phone", Тело);
	
КонецФункции

// Извлекает текст поля "error" из JSON-тела ответа API. Если разобрать не
// удалось, или поля нет — возвращает пустую строку.
Функция ИзвлечьТекстОшибкиAPI(ТелоОтвета) Экспорт
	
	Если Не ЗначениеЗаполнено(ТелоОтвета) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		ПараметрыJSON = Новый Структура("ПрочитатьВСоответствие", Ложь);
		Данные = ПКВ_КоннекторHTTP.JsonВОбъект(ТелоОтвета, "utf-8", ПараметрыJSON);
	Исключение
		Возврат "";
	КонецПопытки;
	
	Если Данные = Неопределено ИЛИ Не Данные.Свойство("error") Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Данные.error);
	
КонецФункции

#Область СписаниеДвухфазное

// Шаг 1 — запросить SMS-код списания. POST /debit/request-sms.
Функция ЗапроситьSMSСписания(НомерКарты, ТелефонВладельца, Сумма) Экспорт
	
	Тело = Новый Структура;
	Тело.Вставить("card_number", СокрЛП(НомерКарты));
	Тело.Вставить("owner_phone", СокрЛП(ТелефонВладельца));
	Тело.Вставить("amount", Сумма);
	
	Возврат ЗапросJSON("POST", "/debit/request-sms", Тело);
	
КонецФункции

// Шаг 2 — подтвердить код, создать hold (заморозка, TTL 30 мин).
// POST /debit/confirm. Баланс ещё НЕ списывается.
Функция ПодтвердитьСписание(НомерКарты, Код, СсылкаНаЗаказ = "") Экспорт
	
	Тело = Новый Структура;
	Тело.Вставить("card_number", СокрЛП(НомерКарты));
	Тело.Вставить("code", СокрЛП(Код));
	Если ЗначениеЗаполнено(СсылкаНаЗаказ) Тогда
		Тело.Вставить("order_ref", СсылкаНаЗаказ);
	КонецЕсли;
	
	Возврат ЗапросJSON("POST", "/debit/confirm", Тело);
	
КонецФункции

// Шаг 3а — списать замороженную сумму (после успешного чека). POST /debit/commit.
Функция СписатьHold(HoldId, НомерЧека = "") Экспорт
	
	Тело = Новый Структура;
	Тело.Вставить("hold_id", СокрЛП(HoldId));
	Если ЗначениеЗаполнено(НомерЧека) Тогда
		Тело.Вставить("receipt", Новый Структура("number, source", НомерЧека, "1c"));
	КонецЕсли;
	
	Возврат ЗапросJSON("POST", "/debit/commit", Тело);
	
КонецФункции

// Шаг 3б — отменить заморозку (чек/заказ не состоялся). POST /debit/release.
Функция ОтменитьHold(HoldId, Примечание = "") Экспорт
	
	Тело = Новый Структура;
	Тело.Вставить("hold_id", СокрЛП(HoldId));
	Если ЗначениеЗаполнено(Примечание) Тогда
		Тело.Вставить("note", Примечание);
	КонецЕсли;
	
	Возврат ЗапросJSON("POST", "/debit/release", Тело);
	
КонецФункции

// Продажа предсозданной пластиковой карты — POST /sell. Карта к этому
// моменту уже найдена через /by-qr (РазрешённыйНомерКарты — это
// card_number из ответа by-qr, не сырой штрихкод/хэш с карты). Новая
// карта НЕ создаётся — заполняется номиналом, сценарием и телефонами
// уже существующая. Требует заголовок X-GC-Key.
Функция Продать(РазрешённыйНомерКарты, Номинал, Сценарий, ТелефонОтправителя, ТелефонПолучателя, ИмяПолучателя, Поздравление, ВидимыйНомерЧека, ПредставлениеДокумента) Экспорт
	
	Тело = Новый Структура;
	Тело.Вставить("card_number", СокрЛП(РазрешённыйНомерКарты));
	Тело.Вставить("nominal", Номинал);
	Тело.Вставить("scenario", Сценарий);
	
	Если Сценарий = "gift" Тогда
		Тело.Вставить("recipient_phone", ТелефонПолучателя);
		Тело.Вставить("sender_phone", ТелефонОтправителя);
		Если ЗначениеЗаполнено(ИмяПолучателя) Тогда
			Тело.Вставить("recipient_name", ИмяПолучателя);
		КонецЕсли;
		Если ЗначениеЗаполнено(Поздравление) Тогда
			Тело.Вставить("message", Поздравление);
		КонецЕсли;
	Иначе
		Тело.Вставить("sender_phone", ТелефонОтправителя);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидимыйНомерЧека) Тогда
		Тело.Вставить("receipt", Новый Структура("number, doc_number", ВидимыйНомерЧека, ПредставлениеДокумента));
	КонецЕсли;
	
	ДопЗаголовки = Новый Соответствие;
	ДопЗаголовки.Вставить("X-GC-Key", Константы.ПКВ_КлючQR.Получить());
	
	Возврат ЗапросJSON("POST", "/sell", Тело, ДопЗаголовки);
	
КонецФункции

#КонецОбласти


