
Функция ИзвлечьСтрокуСканера(Параметр) Экспорт
	
	Если ТипЗнч(Параметр) <> Тип("Массив") ИЛИ Параметр.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ДанныеСканера = Параметр[0];
	
	Если ТипЗнч(ДанныеСканера) = Тип("Структура") Тогда
		Если ДанныеСканера.Свойство("Штрихкод") Тогда
			Возврат СокрЛП(ДанныеСканера.Штрихкод);
		ИначеЕсли ДанныеСканера.Свойство("Barcode") Тогда
			Возврат СокрЛП(ДанныеСканера.Barcode);
		ИначеЕсли ДанныеСканера.Свойство("ШтрихКод") Тогда
			Возврат СокрЛП(ДанныеСканера.ШтрихКод);
		КонецЕсли;
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(ДанныеСканера));
	
КонецФункции