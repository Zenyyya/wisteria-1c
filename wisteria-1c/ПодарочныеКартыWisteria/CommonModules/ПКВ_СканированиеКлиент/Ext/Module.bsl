// Строка, считанная сканером, из параметров обработчика ОбработкаОповещения.
// Разбор такой же, как в типовой ФормаРМК.
//
// Параметры:
//   ИмяСобытия, Параметр, Источник - параметры ОбработкаОповещения формы
//
// Возвращаемое значение:
//   Строка - считанная строка, "" - событие не от сканера
Функция ИзвлечьСтрокуСканера(ИмяСобытия, Параметр, Источник) Экспорт

	Если Источник <> "ПодключаемоеОборудование" Тогда
		Возврат "";
	КонецЕсли;

	Если ИмяСобытия <> "ScanData" И ИмяСобытия <> "TracksData" Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Параметр) <> Тип("Массив") Или Параметр.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Данные = Параметр[0];

	Если ИмяСобытия = "ScanData"
		И Параметр.Количество() > 1
		И ТипЗнч(Параметр[1]) = Тип("Массив")
		И Параметр[1].Количество() > 1 Тогда
		Данные = Параметр[1][1];
	КонецЕсли;

	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(Данные));

КонецФункции
