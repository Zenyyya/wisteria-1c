#Область ПрограммныйИнтерфейс

// Сохраняет операцию, которая не прошла в Directus после пробития чека.
//
// Параметры:
//   ВидОперации - Строка - "Выпуск карты", "Списание с карты" и т.п.
//   Чек         - ДокументСсылка.ЧекККМ, ДокументСсылка.ЧекККМВозврат
//   Запрос      - Структура - Путь, Тело (Структура), НуженКлюч
//   Описание    - Строка - что за операция, для управляющего
//   ТекстОшибки - Строка
//
// Возвращаемое значение:
//   Булево - запись сохранена
Функция Добавить(ВидОперации, Чек, Запрос, Описание, ТекстОшибки) Экспорт

	Запись = РегистрыСведений.ПКВ_НезавершённыеОперации.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Строка(Новый УникальныйИдентификатор);
	Запись.ВидОперации   = ВидОперации;
	Запись.Чек           = Чек;
	Запись.Описание      = Описание;
	Запись.Путь          = Запрос.Путь;
	Запись.ТелоЗапроса   = ПКВ_КоннекторHTTP.ОбъектВJson(Запрос.Тело);
	Запись.НуженКлюч     = Запрос.НуженКлюч;
	Запись.ТекстОшибки   = ТекстОшибки;
	Запись.ДатаОшибки    = ТекущаяДатаСеанса();
	Запись.Попыток       = 1;

	Попытка
		Запись.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(
			"ПКВ_ПодарочныеКарты.НезавершённыеОперации",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Чек,
			СтрШаблон("Не удалось сохранить незавершённую операцию: %1
				|%2: %3
				|Запрос: %4 %5",
				ОписаниеОшибки(), ВидОперации, Описание, Запрос.Путь, Запись.ТелоЗапроса));
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Повторно отправляет сохранённый запрос. При успехе запись удаляется.
//
// Возвращаемое значение:
//   Структура - Успех (Булево), Текст (Строка) - результат для управляющего
Функция Повторить(Идентификатор) Экспорт

	Итог = Новый Структура("Успех, Текст", Ложь, "");

	Запись = РегистрыСведений.ПКВ_НезавершённыеОперации.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Идентификатор;
	Запись.Прочитать();

	Если Не Запись.Выбран() Тогда
		Итог.Текст = "Операция уже удалена из списка.";
		Возврат Итог;
	КонецЕсли;

	// У /create нет защиты от повтора: если первый запрос дошёл до Directus,
	// а ответ потерялся, повтор создаст вторую карту. Сначала проверяем по чеку.
	Если Запись.Путь = "/create" Тогда

		Проверка = ПКВ_ЭлектроннаяКартаУжеОформлена(Запись);

		Если ЗначениеЗаполнено(Проверка.ТекстОш) Тогда
			ПКВ_ЗаписатьНеудачнуюПопытку(Запись, Проверка.ТекстОш);
			Итог.Текст = "Не удалось проверить, оформлена ли карта: " + Проверка.ТекстОш;
			Возврат Итог;
		КонецЕсли;

		Если Проверка.Оформлена Тогда
			Запись.Удалить();
			Итог.Успех = Истина;
			Итог.Текст = "Карта по этому чеку уже есть в Directus, повтор не нужен. Операция убрана из списка.";
			Возврат Итог;
		КонецЕсли;

	КонецЕсли;

	Результат = ПКВ_ПодарочныеКартыAPI.ВыполнитьЗапросПоОписанию(Запись.Путь, Запись.ТелоЗапроса, Запись.НуженКлюч);

	Если Не Результат.Успех Тогда
		ТекстОшибки = ПКВ_ПодарочныеКартыAPI.ТекстОшибки(Результат);
		ПКВ_ЗаписатьНеудачнуюПопытку(Запись, ТекстОшибки);
		Итог.Текст = "Повтор не прошёл: " + ТекстОшибки;
		Возврат Итог;
	КонецЕсли;

	Запись.Удалить();

	Итог.Успех = Истина;
	Итог.Текст = "Операция выполнена в Directus и убрана из списка.";
	Возврат Итог;

КонецФункции

// Убирает операцию из списка без отправки в Directus.
Процедура Удалить(Идентификатор) Экспорт

	НаборЗаписей = РегистрыСведений.ПКВ_НезавершённыеОперации.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Идентификатор.Установить(Идентификатор);
	НаборЗаписей.Записать();

КонецПроцедуры

// Возвращаемое значение:
//   ТаблицаЗначений - Идентификатор, ДатаОшибки, ВидОперации, Чек, Описание, ТекстОшибки, Попыток
Функция Список() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Операции.Идентификатор КАК Идентификатор,
	|	Операции.ДатаОшибки КАК ДатаОшибки,
	|	Операции.ВидОперации КАК ВидОперации,
	|	Операции.Чек КАК Чек,
	|	Операции.Описание КАК Описание,
	|	Операции.ТекстОшибки КАК ТекстОшибки,
	|	Операции.Попыток КАК Попыток
	|ИЗ
	|	РегистрСведений.ПКВ_НезавершённыеОперации КАК Операции
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОшибки";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПКВ_ЗаписатьНеудачнуюПопытку(Запись, ТекстОшибки)

	Запись.ТекстОшибки = ТекстОшибки;
	Запись.ДатаОшибки  = ТекущаяДатаСеанса();
	Запись.Попыток     = Запись.Попыток + 1;
	Запись.Записать();

КонецПроцедуры

// Сравнивает, сколько электронных карт этого номинала Directus знает по чеку
// (/receipt-info, sold_cards) и сколько их в самом чеке ККМ.
//
// Возвращаемое значение:
//   Структура - Оформлена (Булево), ТекстОш (Строка)
Функция ПКВ_ЭлектроннаяКартаУжеОформлена(Запись)

	Итог = Новый Структура("Оформлена, ТекстОш", Ложь, "");

	Попытка
		ПараметрыJSON = Новый Структура("ПрочитатьВСоответствие", Ложь);
		Тело = ПКВ_КоннекторHTTP.JsonВОбъект(Запись.ТелоЗапроса, "utf-8", ПараметрыJSON);
	Исключение
		Итог.ТекстОш = "Не удалось разобрать сохранённый запрос.";
		Возврат Итог;
	КонецПопытки;

	Если Не Тело.Свойство("receipt") Или Не ЗначениеЗаполнено(Запись.Чек) Тогда
		// Без чека проверить нельзя, остаётся только повторить.
		Возврат Итог;
	КонецЕсли;

	Номинал = Тело.nominal;

	Результат = ПКВ_ПодарочныеКартыAPI.ПолучитьДанныеЧека(Тело.receipt);

	ОформленоВDirectus = 0;

	Если Результат.Успех Тогда

		Если Результат.Данные <> Неопределено И Результат.Данные.Свойство("sold_cards") Тогда
			Для Каждого Карта Из Результат.Данные.sold_cards Цикл
				Если Карта.Свойство("type") И Карта.type = "electronic"
					И Карта.Свойство("nominal") И Карта.nominal = Номинал Тогда
					ОформленоВDirectus = ОформленоВDirectus + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

	ИначеЕсли Результат.КодСостояния <> 404 Тогда

		Итог.ТекстОш = ПКВ_ПодарочныеКартыAPI.ТекстОшибки(Результат);
		Возврат Итог;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Запасы.Количество), 0) КАК Количество
	|ИЗ
	|	Документ.ЧекККМ.Запасы КАК Запасы
	|ГДЕ
	|	Запасы.Ссылка = &Чек
	|	И Запасы.Номенклатура = &Номенклатура
	|	И Запасы.Цена = &Номинал";
	Запрос.УстановитьПараметр("Чек", Запись.Чек);
	Запрос.УстановитьПараметр("Номенклатура", ПКВ_ПодарочныеКартыAPI.НоменклатураЭлектроннаяКарта());
	Запрос.УстановитьПараметр("Номинал", Номинал);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Итог.Оформлена = (Выборка.Количество > 0 И ОформленоВDirectus >= Выборка.Количество);

	Возврат Итог;

КонецФункции

#КонецОбласти
