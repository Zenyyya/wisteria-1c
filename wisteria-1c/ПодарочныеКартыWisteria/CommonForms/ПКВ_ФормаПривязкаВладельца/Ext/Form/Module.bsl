	П.Вставить("ЗначениеЭлемента", ТекущееЗначение);
	
	П.Вставить("РежимКассыСамообслуживания", Ложь);
	П.Вставить("НомерТелефонаПолучателя", "");
	П.Вставить("ШаблонСообщения", Неопределено);
	П.Вставить("ПредставлениеКарты", "");
	П.Вставить("ДоступноБаллов", 0);
	П.Вставить("СуммаИтого", 0);
