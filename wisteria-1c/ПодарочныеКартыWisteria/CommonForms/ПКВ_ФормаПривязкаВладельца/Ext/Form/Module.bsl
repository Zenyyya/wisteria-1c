&НаСервере
Процедура ПКВ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НомерКартыПривязка      = "";
	ТелефонПривязки         = "";
	ИмяПривязки             = "";
	ТекстРезультатаПривязки = "";
	
	ТелефонПоиска           = "";
	ТекстРезультатаПоиска   = "";
	
	МаскаТелефона = ИнтерфейсРМКСлужебныйКлиентСервер.МаскаВводаТелефона();
	Элементы.ТелефонПривязки.Маска = МаскаТелефона;
	Элементы.ТелефонПоиска.Маска    = МаскаТелефона;
	
КонецПроцедуры


#Область ПривязкаВладельца

&НаКлиенте
Процедура ПКВ_ЗапроситьSMSПривязки(Команда)
	
	Если Не ЗначениеЗаполнено(СокрЛП(НомерКартыПривязка)) Тогда
		ПоказатьПредупреждение(, "Укажите номер карты.", , "Внимание");
		ТекущийЭлемент = Элементы.НомерКартыПривязка;
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СокрЛП(ТелефонПривязки)) Тогда
		ПоказатьПредупреждение(, "Укажите телефон владельца.", , "Внимание");
		ТекущийЭлемент = Элементы.ТелефонПривязки;
		Возврат;
	КонецЕсли;
	
	Результат = ПКВ_ЗапроситьSMSПривязкиНаСервере(НомерКартыПривязка, ТелефонПривязки, ИмяПривязки);
	ТекстРезультатаПривязки = Результат.Текст;
	
	Если Результат.Успех Тогда
		ОткрытьФорму(
			"ОбщаяФорма.ПКВ_ФормаВводаКодаSMS",
			Новый Структура("Подсказка", "Привязка владельца к карте " + НомерКартыПривязка + ". Введите код из SMS."),
			ЭтотОбъект,
			, , ,
			Новый ОписаниеОповещения("ПКВ_ПослеВводаКодаПривязки", ЭтотОбъект));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ПослеВводаКодаПривязки(Код, ДопПараметры) Экспорт
	
	Если Код = Неопределено Тогда
		Возврат; // кассир нажал "Отмена" в диалоге
	КонецЕсли;
	
	Результат = ПКВ_ПодтвердитьПривязкуНаСервере(НомерКартыПривязка, Код, ИмяПривязки);
	
	Если Не Результат.Успех Тогда
		
		ТекстКороткий = ?(ЗначениеЗаполнено(Результат.ТекстОшибкиAPI), Результат.ТекстОшибкиAPI, Результат.Текст);
		
		ПоказатьПредупреждение(, ТекстКороткий, , "Ошибка");
		
		ТекстРезультатаПривязки = Результат.Текст;
		
		Подсказка = СтрШаблон(
			"Привязка владельца к карте %1.
			|%2
			|Попробуйте ввести код ещё раз.",
			НомерКартыПривязка, ТекстКороткий);
		
		ОткрытьФорму(
			"ОбщаяФорма.ПКВ_ФормаВводаКодаSMS",
			Новый Структура("Подсказка", Подсказка),
			ЭтотОбъект,
			, , ,
			Новый ОписаниеОповещения("ПКВ_ПослеВводаКодаПривязки", ЭтотОбъект));
		
		Возврат;
	КонецЕсли;
	
	ТекстРезультатаПривязки = Результат.Текст;
	
КонецПроцедуры

&НаСервере
Функция ПКВ_ЗапроситьSMSПривязкиНаСервере(НомерКарты, Телефон, Имя)
	
	Результат = ПКВ_ПодарочныеКартыAPI.ЗапроситьSMSПривязки(НомерКарты, Телефон, Имя);
	
	Если Результат.Успех Тогда
		Текст = ПКВ_ПодарочныеКартыAPI.ТекстЗапросаSMSПривязки(Результат.Данные);
	Иначе
		Текст = ПКВ_ПодарочныеКартыAPI.ИзвлечьТекстОшибкиAPI(Результат.ТелоОтвета);
		Если Не ЗначениеЗаполнено(Текст) Тогда
			Текст = ПКВ_ПодарочныеКартыAPI.ФорматТекстРезультата(Результат);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый Структура("Успех, Текст", Результат.Успех, Текст);
	
КонецФункции

&НаСервере
Функция ПКВ_ПодтвердитьПривязкуНаСервере(НомерКарты, Код, Имя)
	
	Результат = ПКВ_ПодарочныеКартыAPI.ПодтвердитьПривязку(НомерКарты, Код, Имя);
	
	Итог = Новый Структура("Успех, Текст, ТекстОшибкиAPI", Результат.Успех, "", "");
	
	Если Результат.Успех Тогда
		Итог.Текст = ПКВ_ПодарочныеКартыAPI.ТекстПодтвержденияПривязки(Результат.Данные);
	Иначе
		Итог.Текст = ПКВ_ПодарочныеКартыAPI.ФорматТекстРезультата(Результат);
		Итог.ТекстОшибкиAPI = ПКВ_ПодарочныеКартыAPI.ИзвлечьТекстОшибкиAPI(Результат.ТелоОтвета);
	КонецЕсли;
	
	Возврат Итог;
	
КонецФункции

#КонецОбласти


#Область ПоискПоТелефону

&НаКлиенте
Процедура ПКВ_НайтиКартыПоТелефону(Команда)
	
	Если Не ЗначениеЗаполнено(СокрЛП(ТелефонПоиска)) Тогда
		ПоказатьПредупреждение(, "Укажите телефон для поиска.", , "Внимание");
		ТекущийЭлемент = Элементы.ТелефонПоиска;
		Возврат;
	КонецЕсли;
	
	ТекстРезультатаПоиска = ПКВ_НайтиКартыПоТелефонуНаСервере(ТелефонПоиска);
	
КонецПроцедуры

&НаСервере
Функция ПКВ_НайтиКартыПоТелефонуНаСервере(Телефон)
	
	Результат = ПКВ_ПодарочныеКартыAPI.НайтиКартыПоТелефону(Телефон);
	
	Если Не Результат.Успех Тогда
		Возврат ПКВ_ПодарочныеКартыAPI.ФорматТекстРезультата(Результат);
	КонецЕсли;
	
	Если Результат.Данные = Неопределено ИЛИ Не Результат.Данные.Свойство("cards") Тогда
		Возврат "Ответ сервера не удалось разобрать. Сырое тело:" + Символы.ПС + Результат.ТелоОтвета;
	КонецЕсли;
	
	Если Результат.Данные.cards.Количество() = 0 Тогда
		Возврат "Карт не найдено.";
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Найдено карт: %1, общий баланс: %2 ₽",
		Результат.Данные.total, Результат.Данные.total_balance));
	Строки.Добавить("");
	
	БлокиКарт = Новый Массив;
	Для Каждого Карта Из Результат.Данные.cards Цикл
		БлокиКарт.Добавить(ПКВ_ПодарочныеКартыAPI.ТекстКарточкиДляСписка(Карта));
	КонецЦикла;
	
	Разделитель = Символы.ПС + "----------------------------------------" + Символы.ПС;
	Строки.Добавить(СтрСоединить(БлокиКарт, Разделитель));
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

#КонецОбласти


#Область ВводТелефона

&НаКлиенте
Процедура ПКВ_ВвестиТелефонПривязки(Элемент)
	
	ПараметрыПопапа = ПКВ_ПараметрыПопапаВводаТелефона("Телефон владельца", ТелефонПривязки);
	
	ОткрытьФорму(
		"Обработка.РабочееМестоКассира.Форма.ФормаВводаСумм",
		ПараметрыПопапа,
		ЭтотОбъект,
		, , ,
		Новый ОписаниеОповещения("ПКВ_ПослеВводаТелефонаПривязки", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ПослеВводаТелефонаПривязки(Результат, ДопПараметры) Экспорт
	
	Если Результат <> Неопределено И Результат.ОперацияПодтверждена Тогда
		ТелефонПривязки = Результат.СуммаОперации;
	КонецЕсли;
	
КонецПроцедуры

