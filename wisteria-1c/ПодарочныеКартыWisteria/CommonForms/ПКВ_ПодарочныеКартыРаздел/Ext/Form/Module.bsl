// =============================================================================
// ОБЩАЯ ФОРМА: ПКВ_ПодарочныеКартыРаздел
// Расширение конфигурации: ПодарочныеКартыWisteria
//
// НАЗНАЧЕНИЕ:
//   Центральная точка входа в раздел "Подарочные карты" — хаб с кнопками
//   на все текущие и будущие функции модуля. Открывается:
//     • из общей команды ПКВ_КартыWisteria в разделе "Продажи"
//       (команда переключена на ЭТУ форму вместо прямого открытия
//        ФормаРегистрацииКарты — см. изменение в модуле общей команды ниже)
//
//   Кнопка в РМК (команда формы кассы ПКВ_КартыWisteria, отдельная
//   от общей команды раздела) ПРОДОЛЖАЕТ открывать ФормаРегистрацииКарты
//   напрямую — кассиру на кассе промежуточный экран не нужен.
//
// СОСТАВ НА СТАРТЕ (расширяется по мере роста функциональности):
//   • Зарегистрировать карту   → Обработка.ПКВ_ПодарочныеКарты.Форма.ФормаРегистрацииКарты
//   • Журнал операций          → список регистра ПКВ_ПодарочныеКарты
//   • Настройки                → форма констант (мин/макс номинала)
//
// =============================================================================


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПКВ_ЗарегистрироватьКарту(Команда)
	
	ОткрытьФорму(
		"Обработка.ПКВ_ПодарочныеКарты.Форма.ФормаРегистрацииКарты",
		Новый Структура,
		ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_Настройки(Команда)
	
	// Открывает стандартную форму констант.
	ОткрытьФорму(
		"ОбщаяФорма.ПКВ_ФормаКонстантОбщиеНастройки",
		Новый Структура,
		ЭтотОбъект);
	
	КонецПроцедуры
	

&НаКлиенте
Процедура ПКВ_Администрирование(Команда)
	
	// Открывает админку обмена: настройки соединения (флаг ИспользоватьОбмен
	// + адрес API) и тестовую консоль отправки произвольных запросов.
	ОткрытьФорму(
		"ОбщаяФорма.ПКВ_АдминкаПодарочныхКарт",
		Новый Структура,
		ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ОткрытьПанельКассира(Команда)
	
	// Полный функционал — для администратора/поддержки, НЕ для кассира в
	// торговом зале (там — ПКВ_ФормаКассираРМК, открывается из чека РМК).
	ОткрытьФорму(
		"ОбщаяФорма.ПКВ_ФормаКассираАдмин",
		Новый Структура,
		ЭтотОбъект);
	
КонецПроцедуры 
	
	&НаКлиенте
Процедура ПКВ_ФормаКассираРМК(Команда)
	
	// Полный функционал — для администратора/поддержки, НЕ для кассира в
	// торговом зале (там — ПКВ_ФормаКассираРМК, открывается из чека РМК).
	ОткрытьФорму(
		"ОбщаяФорма.ПКВ_ФормаКассираРМК",
		Новый Структура,
		ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти


