// ОБЩАЯ ФОРМА: ПКВ_АдминкаПодарочныхКарт
// =============================================================================


#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПКВ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Реквизиты тестовой консоли — обычные реквизиты формы (НЕ входят в
	// ПКВ_Константы), инициализируем разумными безобидными значениями по
	// умолчанию (GET /designs — без побочных эффектов).
	HTTPМетод    = "GET";
	ПутьЗапроса  = "/Указать запрос";
	ТелоЗапроса  = "";
	ТекстОтвета  = "";   
	
	ПКВ_Константы.ПКВ_ИспользоватьОбмен            = Константы.ПКВ_ИспользоватьОбмен.Получить();
	ПКВ_Константы.ПКВ_АдресAPI                     = Константы.ПКВ_АдресAPI.Получить();
	ПКВ_Константы.ПКВ_НоменклатураЭлектроннаяКарта = Константы.ПКВ_НоменклатураЭлектроннаяКарта.Получить();
	ПКВ_Константы.ПКВ_НоменклатураПластиковаяКарта = Константы.ПКВ_НоменклатураПластиковаяКарта.Получить(); 
	ПКВ_Константы.ПКВ_НоминалМинимум  			   = Константы.ПКВ_НоминалМинимум.Получить();
	ПКВ_Константы.ПКВ_НоминалМаксимум			   = Константы.ПКВ_НоминалМаксимум.Получить();
	ПКВ_Константы.ПКВ_КлючQR = Константы.ПКВ_КлючQR.Получить();
	
	ПКВ_ЗаполнитьСписокМетодовAPI();

	Для Каждого СтрокаМетода Из ПКВ_СписокМетодовAPI Цикл
		Элементы.ПутьЗапроса.СписокВыбора.Добавить(СтрокаМетода.Путь, СтрокаМетода.Наименование);
	КонецЦикла;	
		
КонецПроцедуры 

&НаКлиенте
Процедура ПутьЗапросаПриИзменении(Элемент)
	
	НайденныеСтроки = ПКВ_СписокМетодовAPI.НайтиСтроки(Новый Структура("Путь", ПутьЗапроса));
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	HTTPМетод   = НайденныеСтроки[0].Метод;
	ТелоЗапроса = НайденныеСтроки[0].ПримерТела;
	
КонецПроцедуры

#КонецОбласти


#Область ТестоваяКонсоль

&НаКлиенте
Процедура ПКВ_ОтправитьЗапрос(Команда)
	
	Если Не ЗначениеЗаполнено(СокрЛП(ПутьЗапроса)) Тогда
		ПоказатьПредупреждение(, "Укажите путь метода, например /designs.", , "Внимание");
		ТекущийЭлемент = Элементы.ПутьЗапроса;
		Возврат;
	КонецЕсли;
	
	МетодВВерхнемРегистре = ВРег(СокрЛП(HTTPМетод));
	Если МетодВВерхнемРегистре <> "GET" И МетодВВерхнемРегистре <> "POST" Тогда
		ПоказатьПредупреждение(, "Метод должен быть GET или POST.", , "Внимание");
		ТекущийЭлемент = Элементы.HTTPМетод;
		Возврат;
	КонецЕсли;
	
	ТекстОтвета = ПКВ_ОтправитьЗапросНаСервере(HTTPМетод, ПутьЗапроса, ТелоЗапроса);
	
КонецПроцедуры

&НаСервере
Функция ПКВ_ОтправитьЗапросНаСервере(Метод, Путь, ТелоЗапроса)
	
	Результат = ПКВ_ПодарочныеКартыAPI.ВыполнитьЗапрос(Метод, Путь, ТелоЗапроса);
	
	Если Результат.Успех Тогда
		Возврат СтрШаблон(
			"HTTP %1
			|
			|%2",
			Формат(Результат.КодСостояния, "ЧГ="),
			Результат.ТелоОтвета);
	Иначе
		Строки = Новый Массив;
		Строки.Добавить("Ошибка: " + Результат.ТекстОш);
		Если Результат.КодСостояния > 0 Тогда
			Строки.Добавить("");
			Строки.Добавить("HTTP " + Формат(Результат.КодСостояния, "ЧГ="));
		КонецЕсли;
		Если ЗначениеЗаполнено(Результат.ТелоОтвета) Тогда
			Строки.Добавить("");
			Строки.Добавить(Результат.ТелоОтвета);
		КонецЕсли;
		Возврат СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПКВ_ПроверитьСканированиеКарты(Команда)
	
	Если Не ЗначениеЗаполнено(СокрЛП(ПКВ_ТестСтрокаСканирования)) Тогда
		ПоказатьПредупреждение(, "Вставьте хэш или ссылку из QR-кода.", , "Внимание");
		ТекущийЭлемент = Элементы.ПКВ_ТестСтрокаСканирования;
		Возврат;
	КонецЕсли;
	
	ПКВ_ТекстРезультатаСканирования = ПКВ_ПроверитьСканированиеКартыНаСервере(ПКВ_ТестСтрокаСканирования);
	
КонецПроцедуры

&НаСервере
Функция ПКВ_ПроверитьСканированиеКартыНаСервере(ОтсканированнаяСтрока)
	
	Результат = ПКВ_ПодарочныеКартыAPI.ПолучитьКартуПоХэшу(ОтсканированнаяСтрока);
	
	Если Не Результат.Успех Тогда
		Текст = ПКВ_ПодарочныеКартыAPI.ИзвлечьТекстОшибкиAPI(Результат.ТелоОтвета);
		Если Не ЗначениеЗаполнено(Текст) Тогда
			Текст = ПКВ_ПодарочныеКартыAPI.ФорматТекстРезультата(Результат);
		КонецЕсли;
		Возврат "Ошибка: " + Текст;
	КонецЕсли;
	
	Если Результат.Данные = Неопределено ИЛИ Не Результат.Данные.Свойство("card") Тогда
		Возврат "Ответ сервера не содержит данные карты." + Символы.ПС + Результат.ТелоОтвета;
	КонецЕсли;
	
	ОписанияПолей = Новый Массив;
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("card_number", "Номер карты"));
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("type", "Тип"));
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("status", "Статус", ПКВ_ПодарочныеКартыAPI.СловарьСтатусов()));
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("nominal", "Номинал"));
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("balance", "Баланс"));
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("available", "Доступно к списанию"));
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("owner_phone", "Телефон владельца"));
	
	Возврат ПКВ_ПодарочныеКартыAPI.ТекстИзПолей(Результат.Данные.card, ОписанияПолей);
	
КонецФункции

&НаСервере
Процедура ПКВ_ЗаполнитьСписокМетодовAPI()
	
	ПКВ_СписокМетодовAPI.Очистить();
	
	ПКВ_ДобавитьМетодAPI("Список дизайнов", "GET", "/designs", "");
	
	ПКВ_ДобавитьМетодAPI("Создание карты", "POST", "/create",
		"{""type"": ""electronic"", ""nominal"": 1000, ""scenario"": ""self"", ""sender_phone"": ""<телефон>""}");
	
	ПКВ_ДобавитьМетодAPI("Привязка физической карты", "POST", "/bind-physical",
		"{""card_number"": ""<номер_карты>"", ""physical_card_number"": ""<номер_физкарты>""}");
	
	ПКВ_ДобавитьМетодAPI("Информация о карте", "POST", "/info",
		"{""card_number"": ""<номер_карты>"", ""with_ops"": true}");
	
	ПКВ_ДобавитьМетодAPI("Баланс карты", "POST", "/balance",
		"{""card_number"": ""<номер_карты>"", ""owner_phone"": ""<телефон>""}");
	
	ПКВ_ДобавитьМетодAPI("Списание: запрос SMS", "POST", "/debit/request-sms",
		"{""card_number"": ""<номер_карты>"", ""owner_phone"": ""<телефон>"", ""amount"": 100}");
	
	ПКВ_ДобавитьМетодAPI("Списание: подтверждение", "POST", "/debit/confirm",
		"{""card_number"": ""<номер_карты>"", ""code"": ""<код_из_смс>""}");
	
	ПКВ_ДобавитьМетодAPI("Списание: подтвердить (commit)", "POST", "/debit/commit",
		"{""hold_id"": ""<hold_id>""}");
	
	ПКВ_ДобавитьМетодAPI("Списание: отменить (release)", "POST", "/debit/release",
		"{""hold_id"": ""<hold_id>""}");
	
	ПКВ_ДобавитьМетодAPI("Привязка владельца: запрос SMS", "POST", "/bind-owner/request-sms",
		"{""card_number"": ""<номер_карты>"", ""phone"": ""<телефон>""}");
	
	ПКВ_ДобавитьМетодAPI("Привязка владельца: подтверждение", "POST", "/bind-owner/confirm",
		"{""card_number"": ""<номер_карты>"", ""code"": ""<код_из_смс>""}");
	
	ПКВ_ДобавитьМетодAPI("Поиск карт по телефону", "POST", "/cards-by-phone",
		"{""phone"": ""<телефон>""}");
	
	ПКВ_ДобавитьМетодAPI("Получение карты по QR/хэшу", "POST", "/by-qr",
		"{""hash"": ""<хэш>"", ""key"": ""<ключ>""}");
	
КонецПроцедуры

&НаСервере
Процедура ПКВ_ДобавитьМетодAPI(Наименование, Метод, Путь, ПримерТела)
	
	НоваяСтрока = ПКВ_СписокМетодовAPI.Добавить();
	НоваяСтрока.Наименование = Наименование;
	НоваяСтрока.Метод        = Метод;
	НоваяСтрока.Путь         = Путь;
	НоваяСтрока.ПримерТела   = ПримерТела;
	
КонецПроцедуры

&НаСервере
Функция ПКВ_ОписаниеМетодаAPI(Наименование, Метод, Путь, ПримерТела)
	
	Возврат Новый Структура("Наименование, Метод, Путь, ПримерТела", Наименование, Метод, Путь, ПримерТела);
	
КонецФункции

#КонецОбласти

#Область НастройкиСоединения

// ПКВ_Константы (тип НаборКонстант) НЕ помечен как MainAttribute/SavedData,
// поэтому платформа не сохраняет его автоматически — сохраняем вручную.
&НаКлиенте
Процедура ПКВ_СохранитьНастройки(Команда)
	
	Если ПКВ_Константы.ПКВ_ИспользоватьОбмен И Не ЗначениеЗаполнено(СокрЛП(ПКВ_Константы.ПКВ_АдресAPI)) Тогда
		ПоказатьПредупреждение(, "Укажите адрес API, либо выключите использование обмена.", , "Внимание");
		ТекущийЭлемент = Элементы.ПКВ_КонстантыПКВ_АдресAPI;
		Возврат;
	КонецЕсли;
	
	Если ПКВ_Константы.ПКВ_НоминалМаксимум > 0
	И ПКВ_Константы.ПКВ_НоминалМинимум > ПКВ_Константы.ПКВ_НоминалМаксимум Тогда
		ПоказатьПредупреждение(, "Минимальный номинал не может быть больше максимального.", , "Внимание");
		ТекущийЭлемент = Элементы.ПКВ_КонстантыПКВ_НоминалМинимум;
		Возврат;
	КонецЕсли;

	
	ПКВ_СохранитьНастройкиНаСервере();
	
	ПоказатьПредупреждение(, "Настройки сохранены.", , "Готово");
	
КонецПроцедуры

&НаСервере
Процедура ПКВ_СохранитьНастройкиНаСервере()
		
	Константы.ПКВ_ИспользоватьОбмен.Установить(ПКВ_Константы.ПКВ_ИспользоватьОбмен);
	Константы.ПКВ_АдресAPI.Установить(СокрЛП(ПКВ_Константы.ПКВ_АдресAPI));
	Константы.ПКВ_НоменклатураЭлектроннаяКарта.Установить(ПКВ_Константы.ПКВ_НоменклатураЭлектроннаяКарта);
	Константы.ПКВ_НоменклатураПластиковаяКарта.Установить(ПКВ_Константы.ПКВ_НоменклатураПластиковаяКарта);  
	Константы.ПКВ_НоминалМинимум.Установить(ПКВ_Константы.ПКВ_НоминалМинимум);
	Константы.ПКВ_НоминалМаксимум.Установить(ПКВ_Константы.ПКВ_НоминалМаксимум);
	Константы.ПКВ_КлючQR.Установить(ПКВ_Константы.ПКВ_КлючQR);
	
	
КонецПроцедуры

#КонецОбласти

// =============================================================================
// СПРАВОЧНО: методы тестового контура gc_* для ручной проверки в консоли
// (полный список — см. справочник API, актуально на 13.07.2026)
// =============================================================================
//
//   GET  /designs                  — список активных дизайнов
//   POST /create                   — создать карту {type, nominal, scenario,
//                                     sender_phone, recipient_phone, design, ...}
//   POST /batch/create             — выпуск партии пластика
//   POST /bind-physical            — привязать физическую карту + зачислить номинал
//   POST /info                     — полная информация по карте {card_number}
//   POST /balance                  — баланс {card_number, owner_phone}
//   GET  /by-token?token=<token>   — публичные данные по QR
//   POST /debit/request-sms        — запросить SMS-код списания
//   POST /debit/confirm            — подтвердить код, создать hold
//   POST /debit/commit             — списать hold после чека
//   POST /debit/release            — отменить hold
//   POST /credit                   — зачисление {amount, card_id|token|card_number, source}
//   POST /bind-owner/request-sms   — SMS-код привязки владельца
//   POST /bind-owner/confirm       — подтвердить привязку владельца
//   POST /block                    — блокировка/разблокировка {card_number, action}
//   POST /admin/block · /admin/credit · /admin/debit · /admin/set-owner
//                                   — административные операции по card_id
// =============================================================================
