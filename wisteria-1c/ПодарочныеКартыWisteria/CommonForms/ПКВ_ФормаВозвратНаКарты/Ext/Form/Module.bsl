// Возврат на подарочные карты при возврате товара по чеку продажи.
// Параметры: Карты - Массив из Структура (карты из /receipt-info, debits, с уже выбранными суммами),
//            СуммаКВозврату - Число.
// Результат закрытия: Структура("Возвраты", Массив из Структура: НомерКарты, ТипКарты, Сумма, Замена, НоваяКарта).

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СуммаКВозврату = Параметры.СуммаКВозврату;
	
	СловарьСтатусов = ПКВ_ПодарочныеКартыAPI.СловарьСтатусов();
	
	Для Каждого ДанныеКарты Из Параметры.Карты Цикл
		
		НоваяСтрока = Карты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеКарты);
		
		НоваяСтрока.СтатусПредставление = СловарьСтатусов.Получить(НоваяСтрока.Статус);
		Если Не ЗначениеЗаполнено(НоваяСтрока.СтатусПредставление) Тогда
			НоваяСтрока.СтатусПредставление = НоваяСтрока.Статус;
		КонецЕсли;
		
		// Закрытую карту заменить нельзя, остальные непринимающие меняются на новую.
		НоваяСтрока.Замена = Не НоваяСтрока.ПринимаетВозврат И НоваяСтрока.Статус <> "closed";
		
		Если НоваяСтрока.Замена И НоваяСтрока.ТипКарты = "electronic" Тогда
			НоваяСтрока.НоваяКарта = "";
			НоваяСтрока.СтатусПредставление = НоваяСтрока.СтатусПредставление + ", будет заменена новой электронной";
		ИначеЕсли НоваяСтрока.Замена Тогда
			НоваяСтрока.СтатусПредставление = НоваяСтрока.СтатусПредставление + ", нужна новая карта";
		ИначеЕсли НоваяСтрока.Статус = "closed" Тогда
			НоваяСтрока.СтатусПредставление = НоваяСтрока.СтатусПредставление + ", возврат не принимает";
		КонецЕсли;
		
		Если Не НоваяСтрока.Замена Тогда
			НоваяСтрока.НоваяКарта = "";
		КонецЕсли;
		
	КонецЦикла;
	
	Подсказка = "Укажите, сколько вернуть на каждую карту: не больше, чем можно вернуть по карте, "
		+ "и всего не больше суммы к возврату. Остаток покупатель получит наличными или на банковскую карту, "
		+ "если так платил по чеку продажи.";
	
	Если Карты.НайтиСтроки(Новый Структура("Замена", Истина)).Количество() > 0 Тогда
		Подсказка = Подсказка + Символы.ПС
			+ "Заблокированная карта возврат не принимает: её доля уходит на новую карту. Для пластиковой отсканируйте QR "
			+ "чистой карты из серии или введите её номер в колонке «Новая карта», электронная создастся сама.";
	КонецЕсли;
	
	ПересчитатьИтого();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ОтсканированнаяСтрока = ПКВ_СканированиеКлиент.ИзвлечьСтрокуСканера(ИмяСобытия, Параметр, Источник);
	
	Если Не ЗначениеЗаполнено(ОтсканированнаяСтрока) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаКарты = СтрокаДляНовойПластиковойКарты();
	
	Если СтрокаКарты = Неопределено Тогда
		ПоказатьПредупреждение(, "Новая пластиковая карта нужна только для заблокированной пластиковой карты из списка.", , "Внимание");
		Возврат;
	КонецЕсли;
	
	Результат = ПКВ_ПодарочныеКартыAPI.ПолучитьНомерКартыПоХэшу(ОтсканированнаяСтрока);
	
	Если Не Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Текст, , "Ошибка");
		Возврат;
	КонецЕсли;
	
	УстановитьНовуюКарту(СтрокаКарты, Результат.НомерКарты);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКарты

&НаКлиенте
Процедура КартыСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Карты.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		Если ТекущиеДанные.Сумма < 0 Тогда
			ТекущиеДанные.Сумма = 0;
		КонецЕсли;
		
		Если Не ТекущиеДанные.ПринимаетВозврат И Не ТекущиеДанные.Замена И ТекущиеДанные.Сумма > 0 Тогда
			ТекущиеДанные.Сумма = 0;
			ПоказатьПредупреждение(, "Эта карта закрыта и возврат не принимает. Обратитесь к ответственному.", , "Внимание");
		КонецЕсли;
		
		Если ТекущиеДанные.Сумма > ТекущиеДанные.МожноВернуть Тогда
			ТекущиеДанные.Сумма = ТекущиеДанные.МожноВернуть;
			ПоказатьПредупреждение(, СтрШаблон("На карту %1 по этому чеку можно вернуть не больше %2 ₽.",
				ТекущиеДанные.НомерКарты, Формат(ТекущиеДанные.МожноВернуть, "ЧДЦ=2; ЧГ=0")), , "Внимание");
		КонецЕсли;
		
	КонецЕсли;
	
	ПересчитатьИтого();
	
КонецПроцедуры

&НаКлиенте
Процедура КартыНоваяКартаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Карты.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВведённыйНомер = СокрЛП(ТекущиеДанные.НоваяКарта);
	ТекущиеДанные.НоваяКарта = "";
	
	Если Не ЗначениеЗаполнено(ВведённыйНомер) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не (ТекущиеДанные.Замена И ТекущиеДанные.ТипКарты = "plastic") Тогда
		ПоказатьПредупреждение(, "Новая карта указывается только для заблокированной пластиковой карты.", , "Внимание");
		Возврат;
	КонецЕсли;
	
	УстановитьНовуюКарту(ТекущиеДанные, ВведённыйНомер);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПКВ_ВернутьВсё(Команда)
	
	Остаток = СуммаКВозврату;
	
	// Сначала карты, которые принимают возврат, затем заменяемые.
	Для Каждого СтрокаКарты Из Карты Цикл
		Если СтрокаКарты.ПринимаетВозврат Тогда
			СтрокаКарты.Сумма = Мин(СтрокаКарты.МожноВернуть, Остаток);
			Остаток = Остаток - СтрокаКарты.Сумма;
		Иначе
			СтрокаКарты.Сумма = 0;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаКарты Из Карты Цикл
		Если СтрокаКарты.Замена Тогда
			СтрокаКарты.Сумма = Мин(СтрокаКарты.МожноВернуть, Остаток);
			Остаток = Остаток - СтрокаКарты.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	ПересчитатьИтого();
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ПеренестиВЧек(Команда)
	
	ПересчитатьИтого();
	
	Ошибки = Новый Массив;
	
	Если Итого > СуммаКВозврату Тогда
		Ошибки.Добавить(СтрШаблон("Всего на карты можно вернуть не больше %1 ₽.", Формат(СуммаКВозврату, "ЧДЦ=2; ЧГ=0")));
	КонецЕсли;
	
	НовыеКарты = Новый Массив;
	Возвраты = Новый Массив;
	
	Для Каждого СтрокаКарты Из Карты Цикл
		
		Если СтрокаКарты.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаКарты.Сумма > СтрокаКарты.МожноВернуть Тогда
			Ошибки.Добавить(СтрШаблон("На карту %1 можно вернуть не больше %2 ₽.",
				СтрокаКарты.НомерКарты, Формат(СтрокаКарты.МожноВернуть, "ЧДЦ=2; ЧГ=0")));
		КонецЕсли;
		
		Если Не СтрокаКарты.ПринимаетВозврат И Не СтрокаКарты.Замена Тогда
			Ошибки.Добавить(СтрШаблон("Карта %1 закрыта и возврат не принимает.", СтрокаКарты.НомерКарты));
		КонецЕсли;
		
		Если СтрокаКарты.Замена И СтрокаКарты.ТипКарты = "plastic" Тогда
			Если Не ЗначениеЗаполнено(СтрокаКарты.НоваяКарта) Тогда
				Ошибки.Добавить(СтрШаблон("Для заблокированной карты %1 укажите новую пластиковую карту.", СтрокаКарты.НомерКарты));
			ИначеЕсли НовыеКарты.Найти(СтрокаКарты.НоваяКарта) <> Неопределено Тогда
				Ошибки.Добавить(СтрШаблон("Карта %1 указана новой картой дважды.", СтрокаКарты.НоваяКарта));
			Иначе
				НовыеКарты.Добавить(СтрокаКарты.НоваяКарта);
			КонецЕсли;
		КонецЕсли;
		
		ДанныеВозврата = Новый Структура;
		ДанныеВозврата.Вставить("НомерКарты", СтрокаКарты.НомерКарты);
		ДанныеВозврата.Вставить("ТипКарты", СтрокаКарты.ТипКарты);
		ДанныеВозврата.Вставить("Сумма", СтрокаКарты.Сумма);
		ДанныеВозврата.Вставить("Замена", СтрокаКарты.Замена);
		ДанныеВозврата.Вставить("НоваяКарта", ?(СтрокаКарты.Замена И СтрокаКарты.ТипКарты = "plastic", СтрокаКарты.НоваяКарта, ""));
		Возвраты.Добавить(ДанныеВозврата);
		
	КонецЦикла;
	
	Если Ошибки.Количество() > 0 Тогда
		ПоказатьПредупреждение(, СтрСоединить(Ошибки, Символы.ПС), , "Внимание");
		Возврат;
	КонецЕсли;
	
	Закрыть(Новый Структура("Возвраты", Возвраты));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервере
Процедура ПересчитатьИтого()
	
	Итого = 0;
	Для Каждого СтрокаКарты Из Карты Цикл
		Итого = Итого + СтрокаКарты.Сумма;
	КонецЦикла;
	
КонецПроцедуры

// Текущая строка, если ей нужна новая пластиковая карта, иначе первая такая строка без новой карты.
&НаКлиенте
Функция СтрокаДляНовойПластиковойКарты()
	
	ТекущиеДанные = Элементы.Карты.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Замена И ТекущиеДанные.ТипКарты = "plastic" Тогда
		Возврат ТекущиеДанные;
	КонецЕсли;
	
	Для Каждого СтрокаКарты Из Карты Цикл
		Если СтрокаКарты.Замена И СтрокаКарты.ТипКарты = "plastic" И Не ЗначениеЗаполнено(СтрокаКарты.НоваяКарта) Тогда
			Возврат СтрокаКарты;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура УстановитьНовуюКарту(СтрокаКарты, НомерКарты)
	
	Если Карты.НайтиСтроки(Новый Структура("НомерКарты", НомерКарты)).Количество() > 0 Тогда
		ПоказатьПредупреждение(, "Это карта из чека продажи. Нужна чистая карта из серии.", , "Внимание");
		Возврат;
	КонецЕсли;
	
	Проверка = ПроверитьНовуюКартуНаСервере(НомерКарты);
	
	Если Не Проверка.Успех Тогда
		ПоказатьПредупреждение(, Проверка.ТекстОш, , "Ошибка");
		Возврат;
	КонецЕсли;
	
	Если Проверка.УжеПродана Тогда
		ПоказатьПредупреждение(, Проверка.Причина, , "Внимание");
		Возврат;
	КонецЕсли;
	
	СтрокаКарты.НоваяКарта = НомерКарты;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьНовуюКартуНаСервере(НомерКарты)
	
	Возврат ПКВ_ПодарочныеКартыAPI.ПроверитьЧтоКартаНеПродана(НомерКарты);
	
КонецФункции

#КонецОбласти
