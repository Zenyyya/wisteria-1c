// =============================================================================
// ОБЩАЯ ФОРМА: ПКВ_ФормаКассираАдмин (переименована из ПКВ_ФормаКассира)
// Расширение конфигурации: ПодарочныеКартыWisteria
//
// РОЛЬ (согласно ТЗ v3.0, §3): ПОЛНЫЙ функционал без ограничений — для
// администратора и службы поддержки. НЕ для обычного кассира в торговом
// зале — см. ПКВ_ФормаКассираРМК, где списание регламентировано (commit/
// release только автоматически, через чек, без ручных кнопок).
//
// НАЗНАЧЕНИЕ:
//   4 отдельные страницы (по числу функций):
//     1. Выпуск и регистрация карты  → Обработка.ПКВ_ПодарочныеКарты.Форма.ФормаРегистрацииКарты
//     2. Просмотр карты              → POST /info
//     3. Списание (двухфазное)       → /debit/request-sms → /confirm → /commit|/release
//                                       commit/release — ВРУЧНУЮ по Hold ID, без привязки к чеку
//     4. Привязка владельца          → /bind-owner/request-sms → /confirm
//
// ВАЖНО: QR-код на карте кодирует ТОЛЬКО номер карты — ничего больше.
// Сканер работает как клавиатура, поэтому везде, где нужен номер карты
// (страницы 2, 3, 4), это ПРОСТОЕ текстовое поле "Номер карты".
//
// Все подтверждения (код из SMS) — через ОТДЕЛЬНОЕ переиспользуемое окно
// ПКВ_ФормаВводаКодаSMS — открывается автоматически после успешного
// запроса SMS.
//
// Открывается кнопкой "Панель кассира (админ)" из ПКВ_ПодарочныеКартыРаздел.
// =============================================================================


#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПКВ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаМеню;
	
	ТекстКарточкиКарты      = "";
	ТекстИсторииОпераций    = "";
	ТекстРезультатаСписание = "";
	ТекстРезультатаПривязки = "";
	
КонецПроцедуры

#КонецОбласти


#Область Навигация

&НаКлиенте
Процедура ПКВ_ОткрытьВыпуск(Команда)
	
	// Переиспользуем уже готовую форму регистрации — открывается отдельным
	// окном поверх панели, без переключения страниц здесь.
	ОткрытьФорму(
		"Обработка.ПКВ_ПодарочныеКарты.Форма.ФормаРегистрацииКарты",
		Новый Структура,
		ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ОткрытьПросмотр(Команда)
	
	НомерКартыПоиск      = "";
	ТекстКарточкиКарты   = "";
	ТекстИсторииОпераций = "";
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПросмотрКарты;
	ТекущийЭлемент = Элементы.НомерКартыПоиск;
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ОткрытьСписание(Команда)
	
	НомерКартыСписание       = "";
	ТелефонВладельцаСписание = "";
	СуммаСписания            = 0;
	HoldIdСписание           = "";
	ТекстРезультатаСписание  = "";
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСписание;
	ТекущийЭлемент = Элементы.НомерКартыСписание;
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ОткрытьПривязку(Команда)
	
	НомерКартыПривязка      = "";
	ТелефонПривязки         = "";
	ИмяПривязки             = "";
	ТекстРезультатаПривязки = "";
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПривязка;
	ТекущийЭлемент = Элементы.НомерКартыПривязка;
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_НазадВМеню(Команда)
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаМеню;
	
КонецПроцедуры

#КонецОбласти


#Область ПросмотрКарты

&НаКлиенте
Процедура ПКВ_НайтиКарту(Команда)
	
	Если Не ЗначениеЗаполнено(СокрЛП(НомерКартыПоиск)) Тогда
		ПоказатьПредупреждение(, "Укажите номер карты.", , "Внимание");
		ТекущийЭлемент = Элементы.НомерКартыПоиск;
		Возврат;
	КонецЕсли;
	
	ПКВ_НайтиКартуНаСервере(НомерКартыПоиск);
	
КонецПроцедуры

&НаСервере
Процедура ПКВ_НайтиКартуНаСервере(НомерКарты)
	
	Результат = ПКВ_ПодарочныеКартыAPI.ПолучитьИнформациюОКарте(НомерКарты, Истина);
	
	Если Не Результат.Успех Тогда
		ТекстКарточкиКарты = "Ошибка: " + Результат.ТекстОш;
		Если ЗначениеЗаполнено(Результат.ТелоОтвета) Тогда
			ТекстКарточкиКарты = ТекстКарточкиКарты + Символы.ПС + Результат.ТелоОтвета;
		КонецЕсли;
		ТекстИсторииОпераций = "";
		Возврат;
	КонецЕсли;
	
	Если Результат.Данные = Неопределено ИЛИ Не Результат.Данные.Свойство("card") Тогда
		ТекстКарточкиКарты   = "Ответ сервера не удалось разобрать. Сырое тело:" + Символы.ПС + Результат.ТелоОтвета;
		ТекстИсторииОпераций = "";
		Возврат;
	КонецЕсли;
	
	ТекстКарточкиКарты = ПКВ_СформироватьТекстКарточки(Результат.Данные.card);
	
	Если Результат.Данные.Свойство("operations") Тогда
		ТекстИсторииОпераций = ПКВ_СформироватьТекстИстории(Результат.Данные.operations);
	Иначе
		ТекстИсторииОпераций = "(история не запрошена)";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПКВ_СформироватьТекстКарточки(Карта)
	
	Строки = Новый Массив;
	
	ПКВ_ДобавитьПолеВТекст(Строки, Карта, "card_number",           "Номер карты");
	ПКВ_ДобавитьПолеВТекст(Строки, Карта, "type",                  "Тип");
	ПКВ_ДобавитьПолеВТекст(Строки, Карта, "status",                "Статус");
	ПКВ_ДобавитьПолеВТекст(Строки, Карта, "nominal",                "Номинал");
	ПКВ_ДобавитьПолеВТекст(Строки, Карта, "balance",                "Баланс");
	ПКВ_ДобавитьПолеВТекст(Строки, Карта, "owner_phone",            "Телефон владельца");
	ПКВ_ДобавитьПолеВТекст(Строки, Карта, "owner_name",             "Имя владельца");
	ПКВ_ДобавитьПолеВТекст(Строки, Карта, "physical_card_number",   "Номер физической карты");
	ПКВ_ДобавитьПолеВТекст(Строки, Карта, "date_bound",             "Дата привязки");
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаСервере
Процедура ПКВ_ДобавитьПолеВТекст(Строки, Структура, ИмяПоля, Заголовок)
	
	Если Структура.Свойство(ИмяПоля) Тогда
		Значение = Структура[ИмяПоля];
		Если Значение <> Неопределено Тогда
			Строки.Добавить(Заголовок + ": " + Значение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПКВ_СформироватьТекстИстории(Операции)
	
	Если ТипЗнч(Операции) <> Тип("Массив") ИЛИ Операции.Количество() = 0 Тогда
		Возврат "(операций нет)";
	КонецЕсли;
	
	Строки = Новый Массив;
	Для Каждого Операция Из Операции Цикл
		
		СтрокаОперации = Новый Массив;
		Если Операция.Свойство("date_created") Тогда
			СтрокаОперации.Добавить(Операция.date_created);
		КонецЕсли;
		Если Операция.Свойство("type") Тогда
			СтрокаОперации.Добавить(Операция.type);
		КонецЕсли;
		Если Операция.Свойство("amount_kop") Тогда
			СтрокаОперации.Добавить(Операция.amount_kop);
		КонецЕсли;
		Если Операция.Свойство("note") И ЗначениеЗаполнено(Операция.note) Тогда
			СтрокаОперации.Добавить(Операция.note);
		КонецЕсли;
		
		Строки.Добавить(СтрСоединить(СтрокаОперации, " · "));
		
	КонецЦикла;
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

#КонецОбласти


#Область Списание

// Двухфазное списание: request-sms → confirm (hold) → commit | release.
// Commit/release здесь вызываются вручную по HoldId — тест до появления
// реальной интеграции с пробитием чека в РМК.

&НаКлиенте
Процедура ПКВ_ЗапроситьSMSСписания(Команда)
	
	Если Не ЗначениеЗаполнено(СокрЛП(НомерКартыСписание)) Тогда
		ПоказатьПредупреждение(, "Укажите номер карты.", , "Внимание");
		ТекущийЭлемент = Элементы.НомерКартыСписание;
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СокрЛП(ТелефонВладельцаСписание)) Тогда
		ПоказатьПредупреждение(, "Укажите телефон владельца.", , "Внимание");
		ТекущийЭлемент = Элементы.ТелефонВладельцаСписание;
		Возврат;
	КонецЕсли;
	
	Если СуммаСписания <= 0 Тогда
		ПоказатьПредупреждение(, "Сумма должна быть больше 0.", , "Внимание");
		ТекущийЭлемент = Элементы.СуммаСписания;
		Возврат;
	КонецЕсли;
	
	Результат = ПКВ_ЗапроситьSMSСписанияНаСервере(
		НомерКартыСписание, ТелефонВладельцаСписание, СуммаСписания);
	
	ТекстРезультатаСписание = Результат.Текст;
	
	Если Результат.Успех Тогда
		Подсказка = СтрШаблон(
			"Списание %1 ₽ с карты %2. Введите код из SMS.",
			Формат(СуммаСписания, "ЧДЦ=2"), НомерКартыСписание);
		
		ОткрытьФорму(
			"ОбщаяФорма.ПКВ_ФормаВводаКодаSMS",
			Новый Структура("Подсказка", Подсказка),
			ЭтотОбъект,
			, , ,
			Новый ОписаниеОповещения("ПКВ_ПослеВводаКодаСписания", ЭтотОбъект));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ПослеВводаКодаСписания(Код, ДопПараметры) Экспорт
	
	Если Код = Неопределено Тогда
		Возврат; // кассир нажал "Отмена" в диалоге
	КонецЕсли;
	
	Результат = ПКВ_ПодтвердитьСписаниеНаСервере(НомерКартыСписание, Код);
	ТекстРезультатаСписание = Результат.Текст;
	
	Если ЗначениеЗаполнено(Результат.HoldId) Тогда
		HoldIdСписание = Результат.HoldId;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПКВ_ЗапроситьSMSСписанияНаСервере(НомерКарты, Телефон, Сумма)
	
	Результат = ПКВ_ПодарочныеКартыAPI.ЗапроситьSMSСписания(НомерКарты, Телефон, Сумма);
	Возврат Новый Структура("Успех, Текст", Результат.Успех, ПКВ_ФорматТекстРезультата(Результат));
	
КонецФункции

&НаСервере
Функция ПКВ_ПодтвердитьСписаниеНаСервере(НомерКарты, Код)
	
	Результат = ПКВ_ПодарочныеКартыAPI.ПодтвердитьСписание(НомерКарты, Код);
	
	Итог = Новый Структура("Текст, HoldId", ПКВ_ФорматТекстРезультата(Результат), "");
	
	Если Результат.Успех И Результат.Данные <> Неопределено И Результат.Данные.Свойство("hold_id") Тогда
		Итог.HoldId = Результат.Данные.hold_id;
	КонецЕсли;
	
	Возврат Итог;
	
КонецФункции

&НаКлиенте
Процедура ПКВ_СписатьHold(Команда)
	
	Если Не ЗначениеЗаполнено(СокрЛП(HoldIdСписание)) Тогда
		ПоказатьПредупреждение(, "Нет Hold ID — сначала запросите и подтвердите SMS-код.", , "Внимание");
		ТекущийЭлемент = Элементы.HoldIdСписание;
		Возврат;
	КонецЕсли;
	
	ТекстРезультатаСписание = ПКВ_СписатьHoldНаСервере(HoldIdСписание);
	
КонецПроцедуры

&НаСервере
Функция ПКВ_СписатьHoldНаСервере(HoldId)
	
	Результат = ПКВ_ПодарочныеКартыAPI.СписатьHold(HoldId);
	Возврат ПКВ_ФорматТекстРезультата(Результат);
	
КонецФункции

&НаКлиенте
Процедура ПКВ_ОтменитьHold(Команда)
	
	Если Не ЗначениеЗаполнено(СокрЛП(HoldIdСписание)) Тогда
		ПоказатьПредупреждение(, "Нет Hold ID — сначала запросите и подтвердите SMS-код.", , "Внимание");
		ТекущийЭлемент = Элементы.HoldIdСписание;
		Возврат;
	КонецЕсли;
	
	ТекстРезультатаСписание = ПКВ_ОтменитьHoldНаСервере(HoldIdСписание);
	
КонецПроцедуры

&НаСервере
Функция ПКВ_ОтменитьHoldНаСервере(HoldId)
	
	Результат = ПКВ_ПодарочныеКартыAPI.ОтменитьHold(HoldId);
	Возврат ПКВ_ФорматТекстРезультата(Результат);
	
КонецФункции

#КонецОбласти


#Область ПривязкаВладельца

// request-sms → confirm, номер карты — обычное текстовое поле (сканер
// печатает в него так же, как в любое другое поле формы).

&НаКлиенте
Процедура ПКВ_ЗапроситьSMSПривязки(Команда)
	
	Если Не ЗначениеЗаполнено(СокрЛП(НомерКартыПривязка)) Тогда
		ПоказатьПредупреждение(, "Укажите номер карты.", , "Внимание");
		ТекущийЭлемент = Элементы.НомерКартыПривязка;
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СокрЛП(ТелефонПривязки)) Тогда
		ПоказатьПредупреждение(, "Укажите телефон владельца.", , "Внимание");
		ТекущийЭлемент = Элементы.ТелефонПривязки;
		Возврат;
	КонецЕсли;
	
	Результат = ПКВ_ЗапроситьSMSПривязкиНаСервере(НомерКартыПривязка, ТелефонПривязки, ИмяПривязки);
	ТекстРезультатаПривязки = Результат.Текст;
	
	Если Результат.Успех Тогда
		ОткрытьФорму(
			"ОбщаяФорма.ПКВ_ФормаВводаКодаSMS",
			Новый Структура("Подсказка", "Привязка владельца к карте " + НомерКартыПривязка + ". Введите код из SMS."),
			ЭтотОбъект,
			, , ,
			Новый ОписаниеОповещения("ПКВ_ПослеВводаКодаПривязки", ЭтотОбъект));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ПослеВводаКодаПривязки(Код, ДопПараметры) Экспорт
	
	Если Код = Неопределено Тогда
		Возврат; // кассир нажал "Отмена" в диалоге
	КонецЕсли;
	
	ТекстРезультатаПривязки = ПКВ_ПодтвердитьПривязкуНаСервере(НомерКартыПривязка, Код, ИмяПривязки);
	
КонецПроцедуры

&НаСервере
Функция ПКВ_ЗапроситьSMSПривязкиНаСервере(НомерКарты, Телефон, Имя)
	
	Результат = ПКВ_ПодарочныеКартыAPI.ЗапроситьSMSПривязки(НомерКарты, Телефон, Имя);
	Возврат Новый Структура("Успех, Текст", Результат.Успех, ПКВ_ФорматТекстРезультата(Результат));
	
КонецФункции

&НаСервере
Функция ПКВ_ПодтвердитьПривязкуНаСервере(НомерКарты, Код, Имя)
	
	Результат = ПКВ_ПодарочныеКартыAPI.ПодтвердитьПривязку(НомерКарты, Код, Имя);
	Возврат ПКВ_ФорматТекстРезультата(Результат);
	
КонецФункции

#КонецОбласти


#Область Общее

// Единое форматирование результата ЗапросJSON-обёрток в текст для показа
// пользователю — код состояния/ошибка + сырое тело ответа.
&НаСервере
Функция ПКВ_ФорматТекстРезультата(Результат)
	
	Если Результат.Успех Тогда
		Возврат "Успешно." + Символы.ПС + Результат.ТелоОтвета;
	Иначе
		Строки = Новый Массив;
		Строки.Добавить("Ошибка: " + Результат.ТекстОш);
		Если ЗначениеЗаполнено(Результат.ТелоОтвета) Тогда
			Строки.Добавить(Результат.ТелоОтвета);
		КонецЕсли;
		Возврат СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
КонецФункции

#КонецОбласти
