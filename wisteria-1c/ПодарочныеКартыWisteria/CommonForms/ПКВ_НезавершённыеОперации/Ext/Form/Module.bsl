&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьОперации();

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_Повторить(Команда)

	ТекущиеДанные = Элементы.Операции.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите операцию в списке.", , "Внимание");
		Возврат;
	КонецЕсли;

	Результат = ПовторитьНаСервере(ТекущиеДанные.Идентификатор);

	ПоказатьПредупреждение(, Результат.Текст, , ?(Результат.Успех, "Готово", "Ошибка"));

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ОтметитьРешённой(Команда)

	ТекущиеДанные = Элементы.Операции.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите операцию в списке.", , "Внимание");
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(
		Новый ОписаниеОповещения("ПКВ_ОтметитьРешённойЗавершение", ЭтотОбъект, ТекущиеДанные.Идентификатор),
		"Убрать операцию из списка? В Directus она отправляться не будет.
		|Делайте так, только если операция уже исправлена вручную.",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ОтметитьРешённойЗавершение(Результат, Идентификатор) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	УдалитьНаСервере(Идентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_Обновить(Команда)

	ЗаполнитьОперации();

КонецПроцедуры

&НаСервере
Функция ПовторитьНаСервере(Идентификатор)

	Результат = ПКВ_НезавершённыеОперацииСервер.Повторить(Идентификатор);
	ЗаполнитьОперации();

	Возврат Результат;

КонецФункции

&НаСервере
Процедура УдалитьНаСервере(Идентификатор)

	ПКВ_НезавершённыеОперацииСервер.Удалить(Идентификатор);
	ЗаполнитьОперации();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОперации()

	Операции.Загрузить(ПКВ_НезавершённыеОперацииСервер.Список());

КонецПроцедуры
