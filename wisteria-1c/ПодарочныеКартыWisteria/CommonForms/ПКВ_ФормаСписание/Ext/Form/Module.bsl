&НаКлиенте
Перем ПКВ_ЗакрытиеПодтверждено;

&НаСервере
Процедура ПКВ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НомерКартыСписание         = "";
	ТелефонВладельцаСписание   = "";
	СуммаСписания              = 0;
	ТекстСписокСписаний        = "";
	СписокНомеровКарт          = "";
	ИтогоПодтверждённоСписаний = 0;
	ТекстРезультатаСписание    = "";
	ПКВ_БалансКарты            = 0;
	ДоступноКСписанию          = 0;
	ПКВ_ПодтвержденныеHold.Очистить();

	Если Параметры.Свойство("СуммаКОплате") Тогда
		СуммаКОплате = Параметры.СуммаКОплате;
	Иначе
		СуммаКОплате = 0;
	КонецЕсли;

	ОстатокЧекаКСписанию = СуммаКОплате;

	МаскаТелефона = ИнтерфейсРМКСлужебныйКлиентСервер.МаскаВводаТелефона();
	Элементы.ТелефонВладельцаСписание.Маска = МаскаТелефона;

КонецПроцедуры

// Подтверждённые, но не перенесённые в чек списания при закрытии отменяются.
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы Или ПКВ_ЗакрытиеПодтверждено = Истина Тогда
		Возврат;
	КонецЕсли;

	Если ПКВ_ПодтвержденныеHold.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;

	ПоказатьВопрос(
		Новый ОписаниеОповещения("ПКВ_ПодтверждениеЗакрытияЗавершение", ЭтотОбъект),
		"Есть подтверждённые списания, они не перенесены в чек.
		|Закрыть форму и отменить эти списания?",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ПодтверждениеЗакрытияЗавершение(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Оповестить("ПКВ_СписанияОтменены", ПКВ_ПодтвержденныеHold.ВыгрузитьЗначения());

	ПКВ_ЗакрытиеПодтверждено = Истина;
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ЗапроситьSMSСписания(Команда)

	Если Не ЗначениеЗаполнено(СокрЛП(НомерКартыСписание)) Тогда
		ПоказатьПредупреждение(, "Укажите номер карты.", , "Внимание");
		ТекущийЭлемент = Элементы.НомерКартыСписание;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СокрЛП(ТелефонВладельцаСписание)) Тогда
		ПоказатьПредупреждение(, "Укажите телефон владельца.", , "Внимание");
		ТекущийЭлемент = Элементы.ТелефонВладельцаСписание;
		Возврат;
	КонецЕсли;

	Если СуммаСписания <= 0 Тогда
		ПоказатьПредупреждение(, "Сумма должна быть больше 0.", , "Внимание");
		ТекущийЭлемент = Элементы.СуммаСписания;
		Возврат;
	КонецЕсли;

	Если СуммаСписания > ПКВ_БалансКарты Тогда
		ПоказатьПредупреждение(,
			СтрШаблон("Сумма превышает баланс карты (доступно %1 ₽).", Формат(ПКВ_БалансКарты, "ЧДЦ=2; ЧН=0")),
			, "Внимание");
		ТекущийЭлемент = Элементы.СуммаСписания;
		Возврат;
	КонецЕсли;

	Если (ИтогоПодтверждённоСписаний + СуммаСписания) > СуммаКОплате Тогда
		ПоказатьПредупреждение(,
			СтрШаблон("Сумма превышает остаток к оплате по чеку (%1 ₽ с учётом уже подтверждённых списаний).",
				Формат(СуммаКОплате, "ЧДЦ=2; ЧН=0")),
			, "Внимание");
		ТекущийЭлемент = Элементы.СуммаСписания;
		Возврат;
	КонецЕсли;

	Результат = ПКВ_ЗапроситьSMSСписанияНаСервере(
		НомерКартыСписание, ТелефонВладельцаСписание, СуммаСписания);

	ТекстРезультатаСписание = Результат.Текст;

	Если Результат.Успех Тогда
		Подсказка = СтрШаблон(
			"Списание %1 ₽ с карты %2. Введите код из SMS.",
			Формат(СуммаСписания, "ЧДЦ=2"), НомерКартыСписание);

		ОткрытьФорму(
			"ОбщаяФорма.ПКВ_ФормаВводаКодаSMS",
			Новый Структура("Подсказка", Подсказка),
			ЭтотОбъект,
			, , ,
			Новый ОписаниеОповещения("ПКВ_ПослеВводаКодаСписания", ЭтотОбъект));
	Иначе
		ПоказатьПредупреждение(, Результат.Текст, , "Ошибка");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ПослеВводаКодаСписания(Код, ДопПараметры) Экспорт

	Если Код = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Результат = ПКВ_ПодтвердитьСписаниеНаСервере(НомерКартыСписание, Код);

	Если Не ЗначениеЗаполнено(Результат.HoldId) Тогда

		ПоказатьПредупреждение(, Результат.Текст, , "Ошибка");

		ТекстРезультатаСписание = Результат.Текст;

		Подсказка = СтрШаблон(
			"Списание %1 ₽ с карты %2.
			|%3
			|Попробуйте ввести код ещё раз.",
			Формат(СуммаСписания, "ЧДЦ=2"), НомерКартыСписание, Результат.Текст);

		ОткрытьФорму(
			"ОбщаяФорма.ПКВ_ФормаВводаКодаSMS",
			Новый Структура("Подсказка", Подсказка),
			ЭтотОбъект,
			, , ,
			Новый ОписаниеОповещения("ПКВ_ПослеВводаКодаСписания", ЭтотОбъект));

		Возврат;
	КонецЕсли;

	ЗаписьДляРМК = Новый Структура;
	ЗаписьДляРМК.Вставить("HoldId", Результат.HoldId);
	ЗаписьДляРМК.Вставить("НомерКарты", НомерКартыСписание);
	ЗаписьДляРМК.Вставить("Сумма", СуммаСписания);

	Оповестить("ПКВ_СписаниеПодтверждено", ЗаписьДляРМК);

	ПКВ_ПодтвержденныеHold.Добавить(Результат.HoldId);

	Если ЗначениеЗаполнено(СписокНомеровКарт) Тогда
		СписокНомеровКарт = СписокНомеровКарт + ", " + НомерКартыСписание;
	Иначе
		СписокНомеровКарт = НомерКартыСписание;
	КонецЕсли;

	СтрокаСписка = СтрШаблон("Карта %1 - %2 ₽", НомерКартыСписание, Формат(СуммаСписания, "ЧДЦ=2"));
	Если ЗначениеЗаполнено(ТекстСписокСписаний) Тогда
		ТекстСписокСписаний = ТекстСписокСписаний + Символы.ПС + СтрокаСписка;
	Иначе
		ТекстСписокСписаний = СтрокаСписка;
	КонецЕсли;
	ИтогоПодтверждённоСписаний = ИтогоПодтверждённоСписаний + СуммаСписания;

	ТекстРезультатаСписание = Результат.Текст;

	ПКВ_БалансКарты = ПКВ_БалансКарты - СуммаСписания;

	СуммаСписания         = 0;
	ДоступноКСписанию     = ПКВ_БалансКарты;
	ОстатокЧекаКСписанию  = СуммаКОплате - ИтогоПодтверждённоСписаний;
	ТекущийЭлемент        = Элементы.СуммаСписания;

КонецПроцедуры

&НаСервере
Функция ПКВ_ЗапроситьSMSСписанияНаСервере(НомерКарты, Телефон, Сумма)

	Результат = ПКВ_ПодарочныеКартыAPI.ЗапроситьSMSСписания(НомерКарты, Телефон, Сумма);

	Если Результат.Успех Тогда
		Текст = ПКВ_ПодарочныеКартыAPI.ТекстЗапросаSMSСписания(Результат.Данные);
	Иначе
		Текст = ПКВ_ПодарочныеКартыAPI.ТекстОшибки(Результат);
	КонецЕсли;

	Возврат Новый Структура("Успех, Текст", Результат.Успех, Текст);

КонецФункции

&НаКлиенте
Процедура ПКВ_ПеренестиВЧек(Команда)

	Если ИтогоПодтверждённоСписаний <= 0 Тогда
		ПоказатьПредупреждение(, "Нет подтверждённых списаний для переноса.", , "Внимание");
		Возврат;
	КонецЕсли;

	Оповестить("ПКВ_СписаниеПеренесеноВЧек");

	ПКВ_ЗакрытиеПодтверждено = Истина;
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ЗапроситьБалансКарты(Команда)

	Если Не ЗначениеЗаполнено(СокрЛП(НомерКартыСписание)) Тогда
		ПоказатьПредупреждение(, "Укажите номер карты.", , "Внимание");
		ТекущийЭлемент = Элементы.НомерКартыСписание;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СокрЛП(ТелефонВладельцаСписание)) Тогда
		ПоказатьПредупреждение(, "Укажите телефон владельца.", , "Внимание");
		ТекущийЭлемент = Элементы.ТелефонВладельцаСписание;
		Возврат;
	КонецЕсли;

	ПКВ_ЗапроситьБалансПоТекущимДанным();

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ЗапроситьБалансПоТекущимДанным()

	РезультатБаланса = ПКВ_ПолучитьБалансНаСервере(НомерКартыСписание, ТелефонВладельцаСписание);

	Если Не РезультатБаланса.Успех Тогда
		ПоказатьПредупреждение(, РезультатБаланса.Текст, , "Ошибка");
		ПКВ_БалансКарты   = 0;
		ДоступноКСписанию = 0;
		Возврат;
	КонецЕсли;

	ПКВ_БалансКарты   = РезультатБаланса.Баланс;
	ДоступноКСписанию = ПКВ_БалансКарты - СуммаСписания;

КонецПроцедуры

&НаСервере
Функция ПКВ_ПодтвердитьСписаниеНаСервере(НомерКарты, Код)

	Результат = ПКВ_ПодарочныеКартыAPI.ПодтвердитьСписание(НомерКарты, Код);

	Итог = Новый Структура("Текст, HoldId", "", "");

	Если Результат.Успех И Результат.Данные <> Неопределено И Результат.Данные.Свойство("hold_id") Тогда
		Итог.HoldId = Результат.Данные.hold_id;
		Итог.Текст  = ПКВ_ПодарочныеКартыAPI.ТекстПодтвержденияСписания(Результат.Данные);
	Иначе
		Итог.Текст = ПКВ_ПодарочныеКартыAPI.ТекстОшибки(Результат);
	КонецЕсли;

	Возврат Итог;

КонецФункции

&НаКлиенте
Процедура ПКВ_ВвестиТелефонСписания(Элемент)

	Если Не ЗначениеЗаполнено(СокрЛП(НомерКартыСписание)) Тогда
		ПоказатьПредупреждение(, "Сначала укажите номер карты.", , "Внимание");
		ТекущийЭлемент = Элементы.НомерКартыСписание;
		Возврат;
	КонецЕсли;

	ПараметрыПопапа = ПКВ_ПараметрыПопапаВводаТелефона("Телефон владельца", ТелефонВладельцаСписание);

	ОткрытьФорму(
		"Обработка.РабочееМестоКассира.Форма.ФормаВводаСумм",
		ПараметрыПопапа,
		ЭтотОбъект,
		, , ,
		Новый ОписаниеОповещения("ПКВ_ПослеВводаТелефонаСписания", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ПКВ_ПослеВводаТелефонаСписания(Результат, ДопПараметры) Экспорт

	Если Результат = Неопределено ИЛИ Не Результат.ОперацияПодтверждена Тогда
		Возврат;
	КонецЕсли;

	ТелефонВладельцаСписание = Результат.СуммаОперации;

КонецПроцедуры

&НаСервере
Функция ПКВ_ПолучитьБалансНаСервере(НомерКарты, ТелефонВладельца)

	Результат = ПКВ_ПодарочныеКартыAPI.ПолучитьБаланс(НомерКарты, ТелефонВладельца);

	Если Не Результат.Успех Тогда
		Возврат Новый Структура("Успех, Текст, Баланс", Ложь, ПКВ_ПодарочныеКартыAPI.ТекстОшибки(Результат), 0);
	КонецЕсли;

	Если Результат.Данные = Неопределено ИЛИ Не Результат.Данные.Свойство("balance") Тогда
		Возврат Новый Структура("Успех, Текст, Баланс", Ложь, "Ответ сервера не содержит баланс.", 0);
	КонецЕсли;

	Возврат Новый Структура("Успех, Текст, Баланс", Истина, "", Результат.Данные.balance);

КонецФункции

&НаКлиенте
Функция ПКВ_ПараметрыПопапаВводаТелефона(Заголовок, ТекущееЗначение)

	П = Новый Структура;

	П.Вставить("Режим", 6);
	П.Вставить("ЗаголовокЭлемента", Заголовок);
	П.Вставить("ТипЗначения", "Строка");
	П.Вставить("МаскаВвода", МаскаТелефона);
	П.Вставить("Формат", "");
	П.Вставить("ЗначениеЭлемента", ТекущееЗначение);

	// Остальное форма читает даже в режиме 6 - нейтральные значения
	П.Вставить("РежимКассыСамообслуживания", Ложь);
	П.Вставить("НомерТелефонаПолучателя", "");
	П.Вставить("ШаблонСообщения", Неопределено);
	П.Вставить("ПредставлениеКарты", "");
	П.Вставить("ДоступноБаллов", 0);
	П.Вставить("СуммаИтого", 0);
	П.Вставить("СуммаКОплате", 0);
	П.Вставить("СуммаОплаченоБонусами", 0);
	П.Вставить("ОстатокБаллов", 0);
	П.Вставить("КурсБаллов", 0);
	П.Вставить("ЗапрашиватьСМС", Ложь);
	П.Вставить("СуммаПодтвержденияБонусов", 0);
	П.Вставить("ПодарочныйСертификат", "");
	П.Вставить("БалансСертификата", 0);
	П.Вставить("СуммаСертификата", 0);
	П.Вставить("НомерПодарочногоСертификата", "");
	П.Вставить("ИспользоватьПанельВводаНаличных", Ложь);
	П.Вставить("ТекущаяНастройкаРМК", Неопределено);
	П.Вставить("ИспользоватьЦифровуюКлавиатуру", Истина);
	П.Вставить("ЭтоВнесениеПредоплатыПоЗаказу", Ложь);
	П.Вставить("СуммаОплаченоЗачетАванса", 0);
	П.Вставить("ПриемАванса", Ложь);
	П.Вставить("ИспользоватьДисплейПокупателя", Ложь);
	П.Вставить("ОжидаемоеКоличествоЧеков", 0);
	П.Вставить("ТребуетсяРазделитель", Ложь);

	Возврат П;

КонецФункции

&НаКлиенте
Процедура СуммаСписанияПриИзменении(Элемент)

	ДоступноКСписанию     = ПКВ_БалансКарты - СуммаСписания;
	ОстатокЧекаКСписанию  = СуммаКОплате - ИтогоПодтверждённоСписаний - СуммаСписания;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	ОтсканированнаяСтрока = ПКВ_СканированиеКлиент.ИзвлечьСтрокуСканера(ИмяСобытия, Параметр, Источник);

	Если Не ЗначениеЗаполнено(ОтсканированнаяСтрока) Тогда
		Возврат;
	КонецЕсли;

	Результат = ПКВ_ПодарочныеКартыAPI.ПолучитьНомерКартыПоХэшу(ОтсканированнаяСтрока);

	Если Не Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Текст, , "Ошибка");
		Возврат;
	КонецЕсли;

	НомерКартыСписание = Результат.НомерКарты;
	ТекущийЭлемент     = Элементы.ТелефонВладельцаСписание;

КонецПроцедуры

ПКВ_ЗакрытиеПодтверждено = Ложь;
