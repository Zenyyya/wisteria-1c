// =============================================================================
// ОБЩАЯ ФОРМА: ПКВ_ФормаПросмотрКарты
// Расширение конфигурации: ПодарочныеКартыWisteria
//
// Самостоятельная форма (без меню/навигации) — открывается кнопкой
// "Просмотр карты" из группы "Подарочные карты Wisteria" в чеке РМК.
//
// Ничего не двигает в буферах ФормаРМК — просто справочная информация,
// поэтому обмена через Оповестить() здесь нет.
// =============================================================================

&НаСервере
Процедура ПКВ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НомерКартыПоиск      = "";
	ТекстКарточкиКарты   = "";
	ТекстИсторииОпераций = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ПКВ_НайтиКарту(Команда)
	
	Если Не ЗначениеЗаполнено(СокрЛП(НомерКартыПоиск)) Тогда
		ПоказатьПредупреждение(, "Укажите номер карты.", , "Внимание");
		ТекущийЭлемент = Элементы.НомерКартыПоиск;
		Возврат;
	КонецЕсли;
	
	ПКВ_НайтиКартуНаСервере(НомерКартыПоиск);
	
КонецПроцедуры

&НаСервере
Процедура ПКВ_НайтиКартуНаСервере(НомерКарты)
	
	Результат = ПКВ_ПодарочныеКартыAPI.ПолучитьИнформациюОКарте(НомерКарты, Истина);
	
	Если Не Результат.Успех Тогда
		ТекстКарточкиКарты = "Ошибка: " + Результат.ТекстОш;
		Если ЗначениеЗаполнено(Результат.ТелоОтвета) Тогда
			ТекстКарточкиКарты = ТекстКарточкиКарты + Символы.ПС + Результат.ТелоОтвета;
		КонецЕсли;
		ТекстИсторииОпераций = "";
		Возврат;
	КонецЕсли;
	
	Если Результат.Данные = Неопределено ИЛИ Не Результат.Данные.Свойство("card") Тогда
		ТекстКарточкиКарты   = "Ответ сервера не удалось разобрать. Сырое тело:" + Символы.ПС + Результат.ТелоОтвета;
		ТекстИсторииОпераций = "";
		Возврат;
	КонецЕсли;
	
	ТекстКарточкиКарты = ПКВ_СформироватьТекстКарточки(Результат.Данные.card);
	
	Если Результат.Данные.Свойство("operations") Тогда
		ТекстИсторииОпераций = ПКВ_СформироватьТекстИстории(Результат.Данные.operations);
	Иначе
		ТекстИсторииОпераций = "(история не запрошена)";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПКВ_СформироватьТекстКарточки(Карта)
	
	ОписанияПолей = Новый Массив;
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("card_number", "Номер карты"));
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("type", "Тип", ПКВ_СловарьТиповКарт()));
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("status", "Статус", ПКВ_ПодарочныеКартыAPI.СловарьСтатусов()));
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("nominal", "Номинал"));
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("balance", "Баланс"));
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("owner_phone", "Телефон владельца"));
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("owner_name", "Имя владельца"));
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("physical_card_number", "Номер физической карты"));
	ОписанияПолей.Добавить(ПКВ_ПодарочныеКартыAPI.ОписаниеПоля("date_bound", "Дата привязки"));
	
	Возврат ПКВ_ПодарочныеКартыAPI.ТекстИзПолей(Карта, ОписанияПолей);
	
КонецФункции

&НаСервере
Функция ПКВ_СловарьТиповКарт()
	
	Словарь = Новый Соответствие;
	Словарь.Вставить("electronic", "Электронная");
	Словарь.Вставить("plastic", "Пластиковая");
	
	Возврат Словарь;
	
КонецФункции

&НаСервере
Функция ПКВ_СловарьТиповОпераций()
	
	Словарь = Новый Соответствие;
	Словарь.Вставить("hold", "Заморозка суммы");
	Словарь.Вставить("sms_confirm", "SMS-код подтверждён");
	Словарь.Вставить("sms_request", "Запрос SMS-кода");
	Словарь.Вставить("debit", "Списание по чеку");
	Словарь.Вставить("credit", "Зачисление");
	
	Возврат Словарь;
	
КонецФункции

&НаСервере
Функция ПКВ_ПривестиДатуОперации(ТекстДаты)
	
	Попытка
		ДатаИВремя = XMLЗначение(Тип("Дата"), ТекстДаты);
	Исключение
		Возврат ТекстДаты;
	КонецПопытки;
	
	Возврат Формат(ДатаИВремя, "ДФ='дд.ММ.гггг ЧЧ:мм'");
	
КонецФункции

&НаСервере
Функция ПКВ_КопейкиВРубли(Копейки)
	
	Если Копейки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Возврат Формат(Копейки / 100, "ЧДЦ=2; ЧРД=.; ЧГ=");
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПКВ_СформироватьТекстИстории(Операции)
	
	Если ТипЗнч(Операции) <> Тип("Массив") ИЛИ Операции.Количество() = 0 Тогда
		Возврат "(операций нет)";
	КонецЕсли;
	
	СловарьТипов = ПКВ_СловарьТиповОпераций();
	Строки = Новый Массив;
	
	Для Каждого Операция Из Операции Цикл
		
		Дата = "";
		Если Операция.Свойство("date_created") И ЗначениеЗаполнено(Операция.date_created) Тогда
			Дата = ПКВ_ПривестиДатуОперации(Операция.date_created);
		КонецЕсли;
		
		Тип = "";
		Если Операция.Свойство("type") Тогда
			Перевод = СловарьТипов[Операция.type];
			Тип = ?(Перевод = Неопределено, Операция.type, Перевод);
		КонецЕсли;
		
		Сумма = "";
		Если Операция.Свойство("amount_kop") Тогда
			Сумма = ПКВ_КопейкиВРубли(Операция.amount_kop);
		КонецЕсли;
		
		Баланс = "";
		Если Операция.Свойство("balance_after_kop") Тогда
			Баланс = ПКВ_КопейкиВРубли(Операция.balance_after_kop);
		КонецЕсли;
		
		СтрокаОперации = Дата + " — " + Тип;
		Если ЗначениеЗаполнено(Сумма) Тогда
			СтрокаОперации = СтрокаОперации + ": " + Сумма + " ₽";
		КонецЕсли;
		Если ЗначениеЗаполнено(Баланс) Тогда
			СтрокаОперации = СтрокаОперации + " (баланс после: " + Баланс + " ₽)";
		КонецЕсли;
		
		Строки.Добавить(СтрокаОперации);
		
	КонецЦикла;
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	ОтсканированнаяСтрока = ПКВ_СканированиеКлиент.ИзвлечьСтрокуСканера(ИмяСобытия, Параметр, Источник);

	Если Не ЗначениеЗаполнено(ОтсканированнаяСтрока) Тогда
		Возврат;
	КонецЕсли;

	Результат = ПКВ_ПодарочныеКартыAPI.ПолучитьНомерКартыПоХэшу(ОтсканированнаяСтрока);

	Если Не Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Текст, , "Ошибка");
		Возврат;
	КонецЕсли;

	НомерКартыПоиск = Результат.НомерКарты;

КонецПроцедуры

